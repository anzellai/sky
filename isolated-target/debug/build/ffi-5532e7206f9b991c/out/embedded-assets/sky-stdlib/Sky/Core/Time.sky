-- | Sky.Core.Time — clock + formatting + parsing (Layer 3 Sky source).
--
-- Clock reads (`now`, `unixMillis`) return `Task Error Int` (the
-- value is the milliseconds since the Unix epoch).  Pure helpers
-- (`format*`, `timeString`, `addMillis`, `diffMillis`) work on the
-- integer millisecond value directly.  `every` is the Sky.Live /
-- Sky.Tui subscription helper that emits a `Sub msg` every N ms.
module Sky.Core.Time exposing
    ( now
    , unixMillis
    , sleep
    , timeString
    , format
    , formatHTTP
    , formatISO8601
    , formatRFC3339
    , parse
    , parseISO8601
    , addMillis
    , diffMillis
    , every
    )

import Sky.Ffi as Ffi
import Sky.Core.Error exposing (Error)


-- ─── Clock + sleep ─────────────────────────────────────────────────
now : () -> Task Error Int
now =
    Ffi.kernel "Time_now"


unixMillis : () -> Task Error Int
unixMillis =
    Ffi.kernel "Time_unixMillis"


sleep : Int -> Task Error ()
sleep =
    Ffi.kernel "Time_sleep"


-- ─── Pure formatting ───────────────────────────────────────────────
timeString : Int -> String
timeString =
    Ffi.kernel "Time_timeString"


format : String -> Int -> String
format =
    Ffi.kernel "Time_format"


formatHTTP : Int -> String
formatHTTP =
    Ffi.kernel "Time_formatHTTP"


formatISO8601 : Int -> String
formatISO8601 =
    Ffi.kernel "Time_formatISO8601"


formatRFC3339 : Int -> String
formatRFC3339 =
    Ffi.kernel "Time_formatRFC3339"


-- ─── Pure parsing ──────────────────────────────────────────────────
-- Both parsers are PURE and FALLIBLE — they return `Result`, not
-- `Task`: `rt.Time_parse` returns a bare `Ok`/`Err`, not the `func()
-- any` thunk a `Task` lowers to.  (The Go doc-comments above them say
-- `Result String Int`; the bodies return `ErrDecode`, which is the
-- `Error` ADT, and the signature follows the body.)
-- | `parse layout input` — parse `input` with a Go reference layout
-- (`"2006-01-02"`, `"15:04:05"`), yielding Unix milliseconds.  The
-- layout comes FIRST, mirroring `format`.
--
--     Time.parse "2006-01-02" "2025-01-01" == Ok 1735689600000
parse : String -> String -> Result Error Int
parse =
    Ffi.kernel "Time_parse"


-- | Parse an RFC 3339 / ISO 8601 timestamp (with or without
-- fractional seconds) into Unix milliseconds.
parseISO8601 : String -> Result Error Int
parseISO8601 =
    Ffi.kernel "Time_parseISO8601"


-- ─── Arithmetic ────────────────────────────────────────────────────
addMillis : Int -> Int -> Int
addMillis =
    Ffi.kernel "Time_addMillis"


diffMillis : Int -> Int -> Int
diffMillis =
    Ffi.kernel "Time_diffMillis"


-- ─── Subscriptions ─────────────────────────────────────────────────
-- | `every intervalMillis msg` — Sky.Live / Sky.Tui subscription
-- that emits `msg` every `intervalMillis` milliseconds.
every : Int -> msg -> Sub msg
every =
    Ffi.kernel "Time_every"
