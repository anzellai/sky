# ─────────────────────────────────────────────────────────────
# Sky Language — LOCAL source build
#
# Unlike Dockerfile (which downloads a released binary), this image
# builds sky from the current source tree. Used when a downstream app or
# another consumer needs fixes on an unmerged branch without waiting
# for a release cut.
#
# Usage:
#   docker build -f Dockerfile.local -t anzel/sky:local .
#   docker run --rm -v $(pwd):/app -w /app anzel/sky:local build src/Main.sky
#
# docker-compose:
#   services:
#     app:
#       image: anzel/sky:local
#       volumes: [.:/src]
# ─────────────────────────────────────────────────────────────

# ── Stage 1: build the sky compiler from source (Rust) ──────
FROM rust:1-bookworm AS builder

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

WORKDIR /build

# Copy the full repo: rust/crates/ffi/build.rs embeds sky-stdlib/,
# runtime-go/, tools/sky-ffi-inspect/, templates/, and sky-bundled/ from
# the repo root, so the sibling trees must be present at build time.
# rustup honours rust/rust-toolchain.toml automatically when building
# under rust/.
COPY . ./

# Stamp the version so `sky --version` reports something identifiable
# inside this image. The release CI passes the git tag; for a local build
# we take the branch + short SHA as --build-args (git is excluded from the
# build context via .dockerignore, so we can't read it in-container).
ARG SKY_GIT_BRANCH=unknown
ARG SKY_GIT_SHA=unknown
RUN SKY_BUILD_VERSION="local-${SKY_GIT_BRANCH}-${SKY_GIT_SHA}" \
        cargo build --release --locked --manifest-path rust/Cargo.toml -p sky \
 && mkdir -p /build/bin \
 && cp rust/target/release/sky /build/bin/sky \
 && /build/bin/sky --version


# ── Stage 2: runtime image (matches Dockerfile structure) ────
FROM golang:1.26-bookworm

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

# Go stays in the runtime image: `sky build` and the FFI inspector shell
# out to `go`. The Rust binary is a plain glibc dynamic executable — no
# libgmp/libtinfo/libnuma (those were GHC runtime deps).
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates git \
 && rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/bin/sky /usr/local/bin/sky
RUN chmod +x /usr/local/bin/sky && sky --version

WORKDIR /app
ENTRYPOINT ["sky"]
