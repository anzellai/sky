module Main exposing (main)

-- The STATELESS Sky.Http.Server backend side of the explicit boundary. It
-- encodes a `Widget` with the SHARED `widgetCodec` and serves it as JSON — no
-- session, no SSE, no per-user Model. In a real app the handler re-validates +
-- re-authorizes the request and re-reads authoritative data from its own store
-- (the client is untrusted); here it serves a fixed public value to prove the
-- shared-codec round-trip.

import Sky.Core.Prelude exposing (..)
import Sky.Core.Task as Task
import Sky.Http.Server as Server exposing (Request, Response, Handler)
import Sky.Core.Error as Error exposing (Error)
import Std.Codec as Codec
import Shared exposing (Widget, widgetCodec)


widget : Widget
widget =
    { name = "sprocket", qty = 42, active = True }


getWidget : Handler
getWidget _ =
    Task.succeed (Server.json (Codec.toJson widgetCodec widget))


main : Task Error ()
main =
    Server.listen 8942
        [ Server.get "/api/widget" getWidget ]
