module Main exposing (main)

-- The Sky.Spa CLIENT side of the explicit boundary. It fetches the backend's
-- JSON with `Spa.getJson` and decodes it with the SHARED `widgetCodec` — the
-- exact codec the backend encoded with — handing `update` a `Result Error
-- Widget` directly. The `Widget` type flows across the wire from the single
-- `Shared` module (symlinked into both projects): change it there and this file
-- AND the server stop compiling.

import Sky.Core.Prelude exposing (..)
import Sky.Core.String as String
import Sky.Core.Error as Error exposing (Error)
import Std.Spa as Spa
import Std.Sub as Sub
import Std.Html as Html exposing (Html)
import Std.Html.Attributes as Attr
import Std.Html.Events as Events
import Shared exposing (Widget, widgetCodec)


type Fetch
    = Idle
    | Loading
    | Loaded Widget
    | Failed String


type alias Model =
    { widget : Fetch }


type Msg
    = Load
    | Got (Result Error Widget)


apiBase : String
apiBase =
    "http://localhost:8942"


init : a -> ( Model, Cmd Msg )
init _ =
    ( { widget = Idle }, Cmd.none )


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of
        Load ->
            ( { model | widget = Loading }
            , Spa.getJson widgetCodec (apiBase ++ "/api/widget") Got
            )

        Got (Ok w) ->
            ( { model | widget = Loaded w }, Cmd.none )

        Got (Err e) ->
            ( { model | widget = Failed (Error.toString e) }, Cmd.none )


stateName : Fetch -> String
stateName f =
    case f of
        Idle ->
            "idle"

        Loading ->
            "loading"

        Loaded _ ->
            "loaded"

        Failed _ ->
            "failed"


widgetName : Fetch -> String
widgetName f =
    case f of
        Loaded w ->
            w.name

        _ ->
            ""


widgetQty : Fetch -> String
widgetQty f =
    case f of
        Loaded w ->
            String.fromInt w.qty

        _ ->
            ""


widgetActive : Fetch -> String
widgetActive f =
    case f of
        Loaded w ->
            if w.active then
                "true"

            else
                "false"

        _ ->
            ""


view : Model -> Html Msg
view model =
    Html.div []
        [ Html.p [ Attr.id "state" ] [ Html.text (stateName model.widget) ]
        , Html.p [ Attr.id "name" ] [ Html.text (widgetName model.widget) ]
        , Html.p [ Attr.id "qty" ] [ Html.text (widgetQty model.widget) ]
        , Html.p [ Attr.id "active" ] [ Html.text (widgetActive model.widget) ]
        , Html.button [ Attr.id "load", Events.onClick Load ] [ Html.text "Load" ]
        ]


subscriptions : Model -> Sub Msg
subscriptions _ =
    Sub.none


main : Task Error ()
main =
    Spa.app
        (Spa.config
            { init = init
            , update = update
            , view = view
            , subscriptions = subscriptions
            }
        )
