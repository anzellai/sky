module Main exposing (main)

import Sky.Core.Prelude exposing (..)
import Sky.Core.String as String
import Std.Spa as Spa
import Std.Html as Html exposing (Html)
import Std.Html.Events as Events


type Msg
    = Increment
    | Decrement
    | Reset


init : a -> ( Int, Cmd Msg )
init _ =
    ( 0, Cmd.none )


update : Msg -> Int -> ( Int, Cmd Msg )
update msg count =
    case msg of
        Increment ->
            ( count + 1, Cmd.none )

        Decrement ->
            ( count - 1, Cmd.none )

        Reset ->
            ( 0, Cmd.none )


view : Int -> Html Msg
view count =
    Html.div []
        [ Html.h1 [] [ Html.text "Sky.Spa counter" ]
        , Html.p [] [ Html.text (String.fromInt count) ]
        , Html.div []
            [ Html.button [ Events.onClick Decrement ] [ Html.text "-1" ]
            , Html.button [ Events.onClick Reset ] [ Html.text "Reset" ]
            , Html.button [ Events.onClick Increment ] [ Html.text "+1" ]
            ]
        ]


main : Task Error ()
main =
    Spa.app
        (Spa.config
            { init = init, update = update, view = view }
        )
