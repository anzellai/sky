-- | Sky.Core.Crypto — hash + MAC + signature + symmetric-cipher +
-- entropy helpers (Layer 3 Sky source).
--
-- Pure hash + MAC functions (`sha256` / `sha512` / `sha1` / `md5` /
-- `hmacSha256` / `hmacSha512`) return the hex-encoded digest as a
-- plain `String`. `rsaSha256Sign` / `rsaSha256Verify` cover
-- RSASSA-PKCS1-v1_5 (the `RS256` of JWT and signed-request APIs).
--
-- Symmetric encryption (AEAD — authenticated, so a tampered ciphertext
-- never decrypts): **`xchachaSeal` / `xchachaOpen` (XChaCha20-Poly1305) is
-- the recommended default.** Its 24-byte nonce is drawn at random for every
-- call, and a random nonce that long never repeats in practice, so one key
-- can seal any number of messages. `aesGcmEncrypt` and `chacha20Encrypt` use
-- a 12-byte random nonce: keep them for interoperability, and rotate the key
-- well before 2^32 messages. Every sealed value is
-- `base64(nonce || ciphertext || tag)`.
--
-- Effects: anything that draws randomness — every encrypt/seal, and
-- `randomBytes` / `randomToken` — is a `Task Error a` (v0.27.0: the
-- encrypt functions were `Result` before). Decrypt/open, hashes, MACs and
-- key derivation are pure.
--
-- Signatures, key exchange and HKDF live in `Std.Crypto.Sign` (Ed25519),
-- `Std.Crypto.Kx` (X25519) and `Std.Crypto.Kdf` (HKDF-SHA256).
module Sky.Core.Crypto exposing
    ( sha256
    , sha512
    , sha1
    , md5
    , hmacSha256
    , hmacSha512
    , rsaSha256Sign
    , rsaSha256Verify
    , constantTimeEqual
    , aesGcmEncrypt
    , aesGcmDecrypt
    , chacha20Encrypt
    , chacha20Decrypt
    , xchachaSeal
    , xchachaSealWith
    , xchachaOpen
    , xchachaOpenWith
    , chacha20Poly1305Seal
    , chacha20Poly1305Open
    , xchacha20Poly1305Seal
    , xchacha20Poly1305Open
    , aesKeyFromPassword
    , chachaKeyFromPassword
    , randomBytes
    , randomToken
    )

import Sky.Ffi as Ffi
import Sky.Core.Error exposing (Error)
import Sky.Core.Result exposing (Result(..))
import Sky.Core.Secret exposing (Secret)


-- ─── Hashes ────────────────────────────────────────────────────────
sha256 : String -> String
sha256 =
    Ffi.kernel "Crypto_sha256"


sha512 : String -> String
sha512 =
    Ffi.kernel "Crypto_sha512"


-- SHA-1 — for interop only (git object ids, legacy webhook
-- signatures). Not collision-resistant; never use for new security
-- hashing — reach for `sha256` / `sha512`.
sha1 : String -> String
sha1 =
    Ffi.kernel "Crypto_sha1"


-- MD5 — retained for legacy interoperability only. Not secure.
md5 : String -> String
md5 =
    Ffi.kernel "Crypto_md5"


-- ─── MAC ───────────────────────────────────────────────────────────
-- `hmacSha256 key message` → hex HMAC-SHA256.
hmacSha256 : String -> String -> String
hmacSha256 =
    Ffi.kernel "Crypto_hmacSha256"


-- `hmacSha512 key message` → hex HMAC-SHA512.
hmacSha512 : String -> String -> String
hmacSha512 =
    Ffi.kernel "Crypto_hmacSha512"


-- Constant-time string compare — use when comparing secrets (tokens,
-- MACs, password hashes) so an attacker can't leak bytes via timing.
constantTimeEqual : String -> String -> Bool
constantTimeEqual =
    Ffi.kernel "Crypto_constantTimeEqual"


-- ─── RSA signatures (RSASSA-PKCS1-v1_5 over SHA-256 — "RS256") ──────
-- `rsaSha256Sign pemPrivateKey message` → a standard-base64
-- signature. The PEM may be PKCS#1 or PKCS#8. `Err` on an
-- unparseable key.
rsaSha256Sign : String -> String -> Result Error String
rsaSha256Sign =
    Ffi.kernel "Crypto_rsaSha256Sign"


-- `rsaSha256Verify pemPublicKey message base64Signature` → is the
-- signature valid? `False` on any parse / verification failure.
rsaSha256Verify : String -> String -> String -> Bool
rsaSha256Verify =
    Ffi.kernel "Crypto_rsaSha256Verify"


-- ─── Symmetric encryption (AEAD) ───────────────────────────────────
-- | `xchachaSeal key plaintext` — encrypt under XChaCha20-Poly1305
-- (draft-irtf-cfrg-xchacha). **The recommended default AEAD.** `key` must
-- be exactly 32 bytes (`Crypto.aesKeyFromPassword` for a password, or
-- `Kdf.derive` for key material). A fresh random 24-byte nonce is drawn for
-- every call, which is why this is a `Task`; a 24-byte random nonce is safe
-- to use for any number of messages under one key. Returns
-- `base64(nonce || ciphertext || tag)`.
--
--     Crypto.xchachaSeal key "card ending 4242"
--         |> Task.andThen (\sealed -> Db.exec db "UPDATE …" [ Db.string sealed ])
xchachaSeal : Secret -> String -> Task Error String
xchachaSeal =
    Ffi.kernel "Crypto_xchachaSeal"


-- | `xchachaSealWith key associatedData plaintext` — as `xchachaSeal`, and
-- also authenticates `associatedData` (sent or stored in clear, for example
-- a record id or a header). Opening needs the same associated data.
xchachaSealWith : Secret -> String -> String -> Task Error String
xchachaSealWith =
    Ffi.kernel "Crypto_xchachaSealWith"


-- | `xchachaOpen key sealed` — decrypt the output of `xchachaSeal`. `Err`
-- on a wrong key, a tampered value or bad base64, never garbage. Pure.
xchachaOpen : Secret -> String -> Result Error String
xchachaOpen =
    Ffi.kernel "Crypto_xchachaOpen"


-- | `xchachaOpenWith key associatedData sealed` — decrypt the output of
-- `xchachaSealWith`. `Err` when the associated data differs.
xchachaOpenWith : Secret -> String -> String -> Result Error String
xchachaOpenWith =
    Ffi.kernel "Crypto_xchachaOpenWith"


-- ─── AEAD with a caller-supplied nonce ─────────────────────────────
-- `chacha20Poly1305Seal` / `Open` (RFC 8439, 12-byte nonce) and
-- `xchacha20Poly1305Seal` / `Open` (draft-irtf-cfrg-xchacha, 24-byte nonce)
-- take the nonce and the associated data from the caller. They are pure
-- and deterministic: the same inputs give the same bytes, which is what a
-- protocol with its own nonce schedule, or a published test vector, needs.
--
-- **Never use one nonce twice with the same key.** A repeated nonce reveals
-- the XOR of the two plaintexts and lets an attacker forge tags: both
-- confidentiality and authenticity are lost. If nothing in your protocol
-- fixes the nonce, use the random-nonce `xchachaSeal`, which stays the
-- recommended default.
--
-- Every argument is raw bytes (use `Encoding.hexDecode` /
-- `Encoding.base64Decode` for text forms). The key is 32 bytes. Seal
-- returns `ciphertext || tag` (16-byte tag, no nonce); open takes the same.
-- A key, nonce or input of the wrong length is `Err InvalidInput`, and so
-- is a failed authentication (wrong key, nonce or associated data, or a
-- tampered input).
-- | `chacha20Poly1305Seal key nonce associatedData plaintext` — IETF
-- ChaCha20-Poly1305 (RFC 8439 §2.8) with a 12-byte `nonce`. Returns
-- `ciphertext || tag`. Never seal two messages under one key with the same
-- nonce: it breaks confidentiality and authenticity. Prefer `xchachaSeal`
-- unless a protocol fixes the nonce.
chacha20Poly1305Seal : Secret -> String -> String -> String -> Result Error String
chacha20Poly1305Seal =
    Ffi.kernel "Crypto_chacha20Poly1305Seal"


-- | `chacha20Poly1305Open key nonce associatedData sealed` — the inverse of
-- `chacha20Poly1305Seal`. `Err` unless key, nonce and associated data all
-- match and `sealed` is untouched.
chacha20Poly1305Open : Secret -> String -> String -> String -> Result Error String
chacha20Poly1305Open =
    Ffi.kernel "Crypto_chacha20Poly1305Open"


-- | `xchacha20Poly1305Seal key nonce associatedData plaintext` —
-- XChaCha20-Poly1305 (draft-irtf-cfrg-xchacha) with a 24-byte `nonce`.
-- Returns `ciphertext || tag`. Never seal two messages under one key with
-- the same nonce: it breaks confidentiality and authenticity. Prefer
-- `xchachaSeal` unless a protocol fixes the nonce. `xchachaOpenWith key associatedData
-- (Encoding.base64Encode (nonce ++ sealed))` opens the same bytes.
xchacha20Poly1305Seal : Secret -> String -> String -> String -> Result Error String
xchacha20Poly1305Seal =
    Ffi.kernel "Crypto_xchacha20Poly1305Seal"


-- | `xchacha20Poly1305Open key nonce associatedData sealed` — the inverse of
-- `xchacha20Poly1305Seal`.
xchacha20Poly1305Open : Secret -> String -> String -> String -> Result Error String
xchacha20Poly1305Open =
    Ffi.kernel "Crypto_xchacha20Poly1305Open"


-- | `aesGcmEncrypt key plaintext` — encrypt under AES-256-GCM.
-- `key` must be exactly 32 bytes (use `aesKeyFromPassword` for a
-- password-derived key).  `plaintext` is the raw byte payload (a
-- Sky `String` whose bytes are not constrained to UTF-8 — use the
-- Sky.Core.Bytes helpers when in doubt).  Returns
-- `base64(nonce || ciphertext || tag)` — a single opaque string
-- safe to store / transmit.  A new random 12-byte nonce is drawn for
-- every call (so encrypting the same message twice yields
-- different ciphertexts), which is why this is a `Task` (v0.27.0).
-- Prefer `xchachaSeal` for new code: a 12-byte random nonce limits
-- one key to well under 2^32 messages.
aesGcmEncrypt : Secret -> String -> Task Error String
aesGcmEncrypt =
    Ffi.kernel "Crypto_aesGcmEncrypt"


-- | `aesGcmDecrypt key encoded` — decrypt the output of
-- `aesGcmEncrypt`.  Returns `Err` on any tag-validation failure
-- (so a tampered ciphertext NEVER decrypts to garbage).  Same
-- key length rules as `aesGcmEncrypt`.
aesGcmDecrypt : Secret -> String -> Result Error String
aesGcmDecrypt =
    Ffi.kernel "Crypto_aesGcmDecrypt"


-- | `chacha20Encrypt key plaintext` — encrypt under
-- ChaCha20-Poly1305 (RFC 8439).  Same key length (32 bytes) and
-- output format as `aesGcmEncrypt`.  ChaCha20 is preferred on
-- platforms without AES hardware acceleration — typically smaller
-- mobile / embedded CPUs. A `Task` (v0.27.0): it draws a random
-- nonce. Prefer `xchachaSeal` for new code.
chacha20Encrypt : Secret -> String -> Task Error String
chacha20Encrypt =
    Ffi.kernel "Crypto_chacha20Encrypt"


-- | `chacha20Decrypt key encoded` — decrypt the output of
-- `chacha20Encrypt`.  Same Err-on-tampering guarantee as
-- `aesGcmDecrypt`.
chacha20Decrypt : Secret -> String -> Result Error String
chacha20Decrypt =
    Ffi.kernel "Crypto_chacha20Decrypt"


-- | `aesKeyFromPassword password salt` — derive a 32-byte
-- AES-256 key from a password + salt via PBKDF2-HMAC-SHA256
-- (100 000 iterations — OWASP recommended floor as of 2026).
-- `password` is an opaque `Secret`; the derived key is itself a
-- secret, so it comes back as a `Secret` you pass straight to
-- `aesGcmEncrypt` (which reveals it internally for the cipher).
-- `salt` MUST be unique per user / record
-- (the 32 hex characters of `randomBytes 16` is the standard
-- shape).  NOT for password storage — use `Std.Auth.hashPassword`
-- (bcrypt) for that.
aesKeyFromPassword : Secret -> String -> Secret
aesKeyFromPassword =
    Ffi.kernel "Crypto_aesKeyFromPassword"


-- | `chachaKeyFromPassword password salt` — same as
-- `aesKeyFromPassword` but the derived key is intended for use
-- with `chacha20Encrypt`.  Both ciphers use 32-byte keys, so this
-- is a thin alias for documentation; you can interchange the two
-- safely.
chachaKeyFromPassword : Secret -> String -> Secret
chachaKeyFromPassword =
    Ffi.kernel "Crypto_chachaKeyFromPassword"


-- ─── Entropy (Task — touches the OS RNG) ───────────────────────────
-- | `randomBytes n` — `n` bytes (1..1024) of OS entropy, returned
-- HEX-encoded (so the string is `2 × n` characters).
randomBytes : Int -> Task Error String
randomBytes =
    Ffi.kernel "Crypto_randomBytes"


-- | `randomToken n` — `n` bytes (1..1024) of OS entropy, returned as
-- URL-safe base64 without padding (for cookies, reset links, ids).
randomToken : Int -> Task Error String
randomToken =
    Ffi.kernel "Crypto_randomToken"
