-- | Sky.Core.Regex — RE2 regex helpers (Layer 3 Sky source).
--
-- Patterns use Go's RE2 syntax (no backreferences, linear-time
-- matching).  Pre-Layer-3 these helpers had no kernel-registry HM
-- signatures, so call sites were any-typed; the Sky-source layer
-- adds proper typing on top of the existing runtime kernels.
--
-- Every function is pure, so it runs anywhere: on the server, in a CLI
-- and in a Sky.Spa client. Matching is linear in the length of the
-- input (RE2). An INVALID pattern is not an error here: `match` is
-- False, `find` / `findMatch` are Nothing, `findAll` /
-- `findAllMatches` are [], `replace` / `replaceWith` return the input
-- unchanged and `split` returns [ input ].
module Sky.Core.Regex exposing
    ( Match
    , match
    , find
    , findAll
    , findMatch
    , findAllMatches
    , replace
    , replaceWith
    , split
    )

import Sky.Ffi as Ffi

-- | One match of a pattern (Elm's `Regex.Match`).
--
-- * `match` — the matched text.
-- * `index` — where it starts, in characters (Unicode code points: the
--   unit of `String.slice` and `String.length`, never bytes).
-- * `number` — its 1-based position among all the matches.
-- * `submatches` — one entry per capture group, in order: `Just text`
--   for a group that took part (`Just ""` when it matched nothing),
--   `Nothing` for an optional group that did not take part.
type alias Match =
    { match : String
    , index : Int
    , number : Int
    , submatches : List (Maybe String)
    }


-- | `match pattern s` — does the pattern match anywhere in `s`?
match : String -> String -> Bool
match =
    Ffi.kernel "Regex_match"


-- | `find pattern s` — first match (Nothing if no match). An empty
-- match is a match: `find "x*" "abc" == Just ""`.
find : String -> String -> Maybe String
find =
    Ffi.kernel "Regex_find"


-- | `findAll pattern s` — every non-overlapping match in order.
findAll : String -> String -> List String
findAll =
    Ffi.kernel "Regex_findAll"


-- | `findMatch pattern s` — the first match with its position and its
-- capture groups, or Nothing. Cost: O(n) in the length of `s`.
--
--     Regex.findMatch "(\\w+) = \"([^\"]*)\"" "video = \"abc\""
--         == Just { match = "video = \"abc\"", index = 0, number = 1, submatches = [ Just "video", Just "abc" ] }
findMatch : String -> String -> Maybe Match
findMatch =
    Ffi.kernel "Regex_findMatch"


-- | `findAllMatches pattern s` — every non-overlapping match, left to
-- right, each with its position and capture groups. Cost: O(n) in the
-- length of `s`, plus one record per match.
--
--     Regex.findAllMatches "(\\d+)(px)?" "£4 ─ 10px"
--         |> List.map .index
--         == [ 1, 5 ]
findAllMatches : String -> String -> List Match
findAllMatches =
    Ffi.kernel "Regex_findAllMatches"


-- | `replace pattern replacement s` — replace every match with
-- `replacement`.  `replacement` may reference capture groups via
-- `$1`, `$2`, etc. (RE2 substitution syntax).
replace : String -> String -> String -> String
replace =
    Ffi.kernel "Regex_replace"


-- | `replaceWith pattern f s` — replace every match with `f match`,
-- where `f` sees the whole `Match` (its text, position and groups).
-- Cost: O(n) in the length of `s`, plus one call of `f` per match.
--
--     Regex.replaceWith "\\{\\{(\\w+)\\}\\}"
--         (\m -> String.toUpper (Maybe.withDefault "" (List.head (List.filterMap identity m.submatches))))
--         "Hi {{name}}"
--         == "Hi NAME"
replaceWith : String -> (Match -> String) -> String -> String
replaceWith =
    Ffi.kernel "Regex_replaceWith"


-- | `split pattern s` — split on every match.
split : String -> String -> List String
split =
    Ffi.kernel "Regex_split"
