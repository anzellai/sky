-- | Sky.Core.Secret — a typed, opaque secret handle.
--
-- A `Secret` is a value you pass to a trusted sink (`Auth.signToken`,
-- `Http.withBearer`, `Crypto.hmacSha256`, `Db.connect`, …) but CANNOT
-- accidentally leak. Because the type is opaque:
--
--   * there is no `String` view — you cannot `++` it or `println` it;
--   * there is no auto-codec — `Codec.auto`/`Json.encode` cannot serialise a
--     record that contains one;
--   * its Go representation (`rt.Secret`) redacts itself in EVERY `String` /
--     `%v` / `MarshalJSON` path, so even a reflection-based log or JSON body
--     prints `[REDACTED]` rather than the value.
--
-- The only ways IN are [`fromEnv`] (a configured secret), [`fromString`] (an
-- existing runtime `String`, e.g. a token fetched at runtime), and — via
-- `Sky.Core.Json.Decode` — a `Secret` decoder. The only way OUT is the single,
-- loud, greppable, server-only [`reveal`]. Handle a revealed secret at the last
-- moment, next to the sink that needs the raw bytes.
module Sky.Core.Secret exposing
    ( Secret
    , fromEnv
    , fromString
    , unsafeFromString
    , reveal
    )

import Sky.Ffi as Ffi

-- | An opaque secret. Never constructed or matched directly — use [`fromEnv`] /
-- [`fromString`] to make one and [`reveal`] to read it.
type Secret
    = Secret_OPAQUE


-- | Read a secret from an environment variable — the primary, recommended
-- source. The value never appears in source; the handle is server-side by
-- construction (an env var is a backend concept).
--
--     dbSecret : Secret
--     dbSecret =
--         Secret.fromEnv "DATABASE_PASSWORD"
fromEnv : String -> Secret
fromEnv =
    Ffi.kernel "Secret_fromEnv"


-- | Promote an existing runtime `String` into a `Secret` — for a value you
-- already hold (e.g. an OAuth token decoded from a response body). This is the
-- loud twin of [`reveal`]: the two named crossings of the boundary. A string
-- LITERAL argument is a compile error (secrets must not be committed to source —
-- use [`fromEnv`]); a runtime value is fine.
fromString : String -> Secret
fromString =
    Ffi.kernel "Secret_fromString"


-- | Like [`fromString`] but exempt from the no-literal lint — for TESTS and
-- fixtures ONLY, where a literal secret is deliberate. The name is the warning.
unsafeFromString : String -> Secret
unsafeFromString =
    Ffi.kernel "Secret_fromString"


-- | The one, loud, server-only escape hatch: turn a `Secret` back into its raw
-- `String` at the exact point a trusted sink needs the bytes (building an
-- `Authorization` header, signing a token, opening a connection). Greppable by
-- design — a code reviewer can find every place a secret is revealed.
reveal : Secret -> String
reveal =
    Ffi.kernel "Secret_reveal"
