-- | Sky.Core.String — string combinators (Layer 3 Sky source).
--
-- Every function in this module is declared as a Sky-source binding
-- aliased to a kernel via `Ffi.kernel "String_<name>"`.  The Stage 4
-- compiler primitive (see docs/V1_TYPED_CODEGEN_FINISH.md) rewrites
-- every call site to the existing typed kernel dispatch — so
-- `String.toUpper "hello"` continues to emit
-- `rt.String_toUpperT("hello")` exactly as before, preserving the
-- typed-codegen guarantees that the kernel-direct route already
-- enjoyed.
--
-- The Sky-source layer exists for discoverability + Layer 3
-- conformance + so `sky doc` shows a stable source location for
-- every entry.  The runtime bodies live in `runtime-go/rt/rt.go`
-- (`String_*` helpers).
module Sky.Core.String exposing
    ( fromInt
    , fromFloat
    , length
    , isEmpty
    , join
    , split
    , replace
    , slice
    , dropLeft
    , dropRight
    , toInt
    , toFloat
    , toUpper
    , toLower
    , trim
    , trimStart
    , trimEnd
    , reverse
    , append
    , concat
    , contains
    , startsWith
    , endsWith
    , containsIn
    , startsWithIn
    , endsWithIn
    , casefold
    , equalFold
    , isEmail
    , isUrl
    , words
    , lines
    , fromChar
    , toList
    , fromList
    , repeat
    , padLeft
    , padRight
    , left
    , right
    , truncate
    , ellipsize
    , htmlEscape
    , slugify
    , isValid
    , normalize
    , normalizeNFD
    , graphemes
    , toChar
    , toBytes
    , fromBytes
    )

import Sky.Ffi as Ffi


-- ─── Construction ──────────────────────────────────────────────────
fromInt : Int -> String
fromInt =
    Ffi.kernel "String_fromInt"


fromFloat : Float -> String
fromFloat =
    Ffi.kernel "String_fromFloat"


fromChar : Char -> String
fromChar =
    Ffi.kernel "String_fromChar"


fromList : List Char -> String
fromList =
    Ffi.kernel "String_fromList"


-- ─── Sizes + predicates ────────────────────────────────────────────
length : String -> Int
length =
    Ffi.kernel "String_length"


isEmpty : String -> Bool
isEmpty =
    Ffi.kernel "String_isEmpty"


contains : String -> String -> Bool
contains =
    Ffi.kernel "String_contains"


startsWith : String -> String -> Bool
startsWith =
    Ffi.kernel "String_startsWith"


endsWith : String -> String -> Bool
endsWith =
    Ffi.kernel "String_endsWith"


-- | Haystack-first companion to `contains` — built for pipelines.
--
--     "hello world" |> String.containsIn "world"   -- True
--
-- Equivalent to `\\haystack needle -> contains needle haystack`.
containsIn : String -> String -> Bool
containsIn haystack needle =
    contains needle haystack


-- | Haystack-first companion to `startsWith`.
--
--     "/api/users" |> String.startsWithIn "/api"  -- True
startsWithIn : String -> String -> Bool
startsWithIn haystack prefix =
    startsWith prefix haystack


-- | Haystack-first companion to `endsWith`.
--
--     "image.png" |> String.endsWithIn ".png"  -- True
endsWithIn : String -> String -> Bool
endsWithIn haystack suffix =
    endsWith suffix haystack


isEmail : String -> Bool
isEmail =
    Ffi.kernel "String_isEmail"


isUrl : String -> Bool
isUrl =
    Ffi.kernel "String_isUrl"


equalFold : String -> String -> Bool
equalFold =
    Ffi.kernel "String_equalFold"


-- ─── Parsing ───────────────────────────────────────────────────────
toInt : String -> Maybe Int
toInt =
    Ffi.kernel "String_toInt"


toFloat : String -> Maybe Float
toFloat =
    Ffi.kernel "String_toFloat"


-- ─── Case + whitespace ─────────────────────────────────────────────
toUpper : String -> String
toUpper =
    Ffi.kernel "String_toUpper"


toLower : String -> String
toLower =
    Ffi.kernel "String_toLower"


casefold : String -> String
casefold =
    Ffi.kernel "String_casefold"


trim : String -> String
trim =
    Ffi.kernel "String_trim"


trimStart : String -> String
trimStart =
    Ffi.kernel "String_trimStart"


trimEnd : String -> String
trimEnd =
    Ffi.kernel "String_trimEnd"


-- ─── Slicing + assembly ────────────────────────────────────────────
reverse : String -> String
reverse =
    Ffi.kernel "String_reverse"


append : String -> String -> String
append =
    Ffi.kernel "String_append"


concat : List String -> String
concat =
    Ffi.kernel "String_concat"


join : String -> List String -> String
join =
    Ffi.kernel "String_join"


split : String -> String -> List String
split =
    Ffi.kernel "String_split"


replace : String -> String -> String -> String
replace =
    Ffi.kernel "String_replace"


slice : Int -> Int -> String -> String
slice =
    Ffi.kernel "String_slice"


-- | Drop the first n characters (runes) from s.  Elm semantics:
-- negative n returns s unchanged; n >= length returns "".
dropLeft : Int -> String -> String
dropLeft =
    Ffi.kernel "String_dropLeft"


-- | Drop the last n characters (runes) from s.  Elm semantics:
-- negative n returns s unchanged; n >= length returns "".
dropRight : Int -> String -> String
dropRight =
    Ffi.kernel "String_dropRight"


repeat : Int -> String -> String
repeat =
    Ffi.kernel "String_repeat"


padLeft : Int -> Char -> String -> String
padLeft =
    Ffi.kernel "String_padLeft"


padRight : Int -> Char -> String -> String
padRight =
    Ffi.kernel "String_padRight"


-- ─── Word / line / character views ─────────────────────────────────
words : String -> List String
words =
    Ffi.kernel "String_words"


lines : String -> List String
lines =
    Ffi.kernel "String_lines"


toList : String -> List Char
toList =
    Ffi.kernel "String_toList"


-- ─── Slicing by grapheme / rune count ──────────────────────────────
-- Each of these takes the COUNT first and the subject string second,
-- matching `rt.String_left(n, s)` in `runtime-go/rt/rt.go`.  The
-- signature is what makes `String.left "abc" 2 3` a Sky [E2007] with
-- source context instead of a lowering-stage error with none: a
-- kernel-qualifier reference with no declared signature infers as an
-- unconstrained type variable, and the arity gate cannot fire on a
-- variable.
-- | The first `n` runes of `s` (the whole string when `n` exceeds it,
-- `""` when `n` is negative).
left : Int -> String -> String
left =
    Ffi.kernel "String_left"


-- | The last `n` runes of `s`.
right : Int -> String -> String
right =
    Ffi.kernel "String_right"


-- | The first `n` GRAPHEME CLUSTERS of `s` — never splits a combining
-- sequence or an emoji ZWJ sequence.  `""` when `n <= 0`.
truncate : Int -> String -> String
truncate =
    Ffi.kernel "String_truncate"


-- | `truncate n s` with a trailing `…` when anything was cut.
ellipsize : Int -> String -> String
ellipsize =
    Ffi.kernel "String_ellipsize"


-- ─── Sanitising + normalising ──────────────────────────────────────
-- | HTML-escape `&`, `<`, `>`, `"` and `'`.  `Std.Ui` already escapes
-- everything it renders; reach for this only when building markup by
-- hand.
htmlEscape : String -> String
htmlEscape =
    Ffi.kernel "String_htmlEscape"


-- | Lowercase, alphanumerics kept, runs of space/`-`/`_` collapsed to
-- one `-`, no leading or trailing `-`.
slugify : String -> String
slugify =
    Ffi.kernel "String_slugify"


-- | Is `s` well-formed UTF-8?
isValid : String -> Bool
isValid =
    Ffi.kernel "String_isValid"


-- | Unicode NFC (composed) normalisation.
normalize : String -> String
normalize =
    Ffi.kernel "String_normalize"


-- | Unicode NFD (decomposed) normalisation.
normalizeNFD : String -> String
normalizeNFD =
    Ffi.kernel "String_normalizeNFD"


-- | The number of GRAPHEME CLUSTERS in `s` — `"👨‍👩‍👧"` is 1, while
-- `String.length` counts runes.
--
-- Returns a COUNT, not a list, despite the plural name: the runtime is
-- `uniseg.GraphemeClusterCount` (`runtime-go/rt/stdlib_extra.go`), and
-- the signature follows the runtime.  A `List String` here would be a
-- signature the runtime does not honour.
graphemes : String -> Int
graphemes =
    Ffi.kernel "String_graphemes"


-- | The first `Char` of `s` (the null character when `s` is empty).
toChar : String -> Char
toChar =
    Ffi.kernel "String_toChar"


-- | The UTF-8 bytes of `s`, each as an `Int` in `0..255`.
toBytes : String -> List Int
toBytes =
    Ffi.kernel "String_toBytes"


-- | Rebuild a string from UTF-8 byte values.  Values outside `0..255`
-- are truncated to their low byte by the runtime.
fromBytes : List Int -> String
fromBytes =
    Ffi.kernel "String_fromBytes"
