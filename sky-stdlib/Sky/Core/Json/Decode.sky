-- | Sky.Core.Json.Decode — JSON decoders (Layer 3 Sky source).
--
-- A `Decoder a` describes how to extract a value of type `a` from
-- a JSON string.  Compose with `field` / `at` / `index` / `map` /
-- `andThen`; run via `decodeString`.
module Sky.Core.Json.Decode exposing
    ( string
    , int
    , float
    , bool
    , value
    , decodeString
    , decodeValue
    , field
    , at
    , index
    , list
    , map
    , andThen
    , succeed
    , fail
    , oneOf
    , map2
    , map3
    , map4
    , map5
    )

import Sky.Ffi as Ffi
import Sky.Core.Error exposing (Error)


-- ─── Primitive decoders ────────────────────────────────────────────
string : Decoder String
string =
    Ffi.kernel "JsonDec_string"


int : Decoder Int
int =
    Ffi.kernel "JsonDec_int"


float : Decoder Float
float =
    Ffi.kernel "JsonDec_float"


bool : Decoder Bool
bool =
    Ffi.kernel "JsonDec_bool"


-- | The JSON at this point, unchanged, as a `Value` — the same type
-- `Json.Encode` builds, so it can be stored and written back with
-- `Encode.encode` or nested in `Encode.object` / `Encode.list`. Use it to keep
-- a part of a document you do not model (a free-form `metadata` object, an
-- extension field) and pass it on.
--
-- Numbers keep their exact text: an integer past 2^53 or a long decimal is
-- not rounded on the way through.
--
-- Object key order is NOT kept. `Encode.encode` writes the keys of a decoded
-- object sorted byte-wise (`"B"` before `"a"`), at every depth:
-- `{"b":1,"a":{"d":1,"c":2}}` comes back as `{"a":{"c":2,"d":1},"b":1}`.
-- Whitespace is not kept either. When the exact text matters (a signed
-- payload, a document you pass on unchanged), keep it with `Encode.raw`,
-- which writes the text back as it came.
--
--     Decode.decodeString (Decode.field "meta" Decode.value) input
--         |> Result.map (Encode.encode 0)
value : Decoder Value
value =
    Ffi.kernel "JsonDec_value"


-- ─── Entry point ───────────────────────────────────────────────────
-- | Run a decoder against a JSON string. The string must hold ONE JSON
-- document: whitespace may follow it, other text is an `Err`
-- (`decodeString int "3 x"` is an `Err`, not `Ok 3`).
decodeString : Decoder a -> String -> Result Error a
decodeString =
    Ffi.kernel "JsonDec_decodeString"


-- | Run a decoder against a `Value` that is already in memory: a sub-document
-- kept with [`value`], a tree built with `Json.Encode`, an `Encode.raw`
-- document. Pure, and no text is written or parsed on the way (except for an
-- `Encode.raw` document, which is parsed once).
--
-- The `Value` is read exactly as `decodeString` reads the text
-- `Encode.encode 0` writes for it, so
-- `decodeValue d v == decodeString d (Encode.encode 0 v)`: an `Encode.int` is a
-- number `int` accepts, and a key an `Encode.object` gives twice keeps its
-- last value.
--
--     Decode.decodeString (Decode.field "meta" Decode.value) input
--         |> Result.andThen (Decode.decodeValue (Decode.field "id" Decode.int))
decodeValue : Decoder a -> Value -> Result Error a
decodeValue =
    Ffi.kernel "JsonDec_decodeValue"


-- ─── Field accessors ───────────────────────────────────────────────
-- | `field name decoder` — decode the named object field.
field : String -> Decoder a -> Decoder a
field =
    Ffi.kernel "JsonDec_field"


-- | `at path decoder` — drill into nested fields.
at : List String -> Decoder a -> Decoder a
at =
    Ffi.kernel "JsonDec_at"


-- | `index n decoder` — decode the n-th element of an array.
index : Int -> Decoder a -> Decoder a
index =
    Ffi.kernel "JsonDec_index"


-- ─── Collections ───────────────────────────────────────────────────
list : Decoder a -> Decoder (List a)
list =
    Ffi.kernel "JsonDec_list"


-- ─── Combinators ───────────────────────────────────────────────────
map : (a -> b) -> Decoder a -> Decoder b
map =
    Ffi.kernel "JsonDec_map"


andThen : (a -> Decoder b) -> Decoder a -> Decoder b
andThen =
    Ffi.kernel "JsonDec_andThen"


-- | A decoder that always succeeds with the given value.
succeed : a -> Decoder a
succeed =
    Ffi.kernel "JsonDec_succeed"


-- | A decoder that always fails with the given error message.
fail : String -> Decoder a
fail =
    Ffi.kernel "JsonDec_fail"


-- | Try each decoder in turn; succeed with the first to match.
oneOf : List (Decoder a) -> Decoder a
oneOf =
    Ffi.kernel "JsonDec_oneOf"


-- ─── Map-N (combine multiple decoders) ─────────────────────────────
map2 : (a -> b -> c) -> Decoder a -> Decoder b -> Decoder c
map2 =
    Ffi.kernel "JsonDec_map2"


map3 : (a -> b -> c -> d) -> Decoder a -> Decoder b -> Decoder c -> Decoder d
map3 =
    Ffi.kernel "JsonDec_map3"


map4 : (a -> b -> c -> d -> e) -> Decoder a -> Decoder b -> Decoder c -> Decoder d -> Decoder e
map4 =
    Ffi.kernel "JsonDec_map4"


map5 : (a -> b -> c -> d -> e -> f) -> Decoder a -> Decoder b -> Decoder c -> Decoder d -> Decoder e -> Decoder f
map5 =
    Ffi.kernel "JsonDec_map5"
