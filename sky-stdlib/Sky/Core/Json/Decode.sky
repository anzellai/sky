-- | Sky.Core.Json.Decode — JSON decoders (Layer 3 Sky source).
--
-- A `Decoder a` describes how to extract a value of type `a` from
-- a JSON string.  Compose with `field` / `at` / `index` / `map` /
-- `andThen`; run via `decodeString`.
module Sky.Core.Json.Decode exposing
    ( string
    , int
    , float
    , bool
    , value
    , decodeString
    , decodeValue
    , field
    , at
    , index
    , list
    , keyValuePairs
    , dict
    , lazy
    , map
    , andThen
    , succeed
    , fail
    , oneOf
    , null
    , nullable
    , maybe
    , map2
    , map3
    , map4
    , map5
    )

import Sky.Ffi as Ffi
import Sky.Core.Error exposing (Error)
import Sky.Core.Dict exposing (Dict)


-- ─── Primitive decoders ────────────────────────────────────────────
string : Decoder String
string =
    Ffi.kernel "JsonDec_string"


int : Decoder Int
int =
    Ffi.kernel "JsonDec_int"


float : Decoder Float
float =
    Ffi.kernel "JsonDec_float"


bool : Decoder Bool
bool =
    Ffi.kernel "JsonDec_bool"


-- | The JSON at this point, unchanged, as a `Value` — the same type
-- `Json.Encode` builds, so it can be stored and written back with
-- `Encode.encode` or nested in `Encode.object` / `Encode.list`. Use it to keep
-- a part of a document you do not model (a free-form `metadata` object, an
-- extension field) and pass it on.
--
-- Numbers keep their exact text: an integer past 2^53 or a long decimal is
-- not rounded on the way through.
--
-- Object key order is NOT kept. `Encode.encode` writes the keys of a decoded
-- object sorted byte-wise (`"B"` before `"a"`), at every depth:
-- `{"b":1,"a":{"d":1,"c":2}}` comes back as `{"a":{"c":2,"d":1},"b":1}`.
-- Whitespace is not kept either. When the exact text matters (a signed
-- payload, a document you pass on unchanged), keep it with `Encode.raw`,
-- which writes the text back as it came.
--
--     Decode.decodeString (Decode.field "meta" Decode.value) input
--         |> Result.map (Encode.encode 0)
value : Decoder Value
value =
    Ffi.kernel "JsonDec_value"


-- ─── Entry point ───────────────────────────────────────────────────
-- | Run a decoder against a JSON string. The string must hold ONE JSON
-- document: whitespace may follow it, other text is an `Err`
-- (`decodeString int "3 x"` is an `Err`, not `Ok 3`).
--
-- An object that repeats a key is an `Err` that names the key and the path
-- of its object, at any depth and whatever the decoder reads (since v0.31.0):
-- `{"a":1,"a":2}` is refused, not read as `{"a":2}`. This is the I-JSON rule
-- (RFC 7493). Two keys are the same key when their text is the same after
-- escapes are read, so `"a"` and `"a"` are a repeat. `Std.Codec`, a
-- Sky.Spa message and a `Std.Db.Store` JSON column read JSON through this
-- parser and refuse a repeated key too.
--
--     Decode.decodeString (Decode.field "a" Decode.int) "{\"a\":1,\"a\":2}"
--     -- Err: duplicate key "a" in the top-level object
decodeString : Decoder a -> String -> Result Error a
decodeString =
    Ffi.kernel "JsonDec_decodeString"


-- | Run a decoder against a `Value` that is already in memory: a sub-document
-- kept with [`value`], a tree built with `Json.Encode`, an `Encode.raw`
-- document. Pure, and no text is written or parsed on the way (except for an
-- `Encode.raw` document, which is parsed once).
--
-- The `Value` is read exactly as `decodeString` reads the text
-- `Encode.encode 0` writes for it, so
-- `decodeValue d v == decodeString d (Encode.encode 0 v)`: an `Encode.int` is a
-- number `int` accepts, and a key an `Encode.object` gives twice is an `Err`
-- (since v0.31.0), as `decodeString` refuses the text.
--
--     Decode.decodeString (Decode.field "meta" Decode.value) input
--         |> Result.andThen (Decode.decodeValue (Decode.field "id" Decode.int))
decodeValue : Decoder a -> Value -> Result Error a
decodeValue =
    Ffi.kernel "JsonDec_decodeValue"


-- ─── Field accessors ───────────────────────────────────────────────
-- | `field name decoder` — decode the named object field.
field : String -> Decoder a -> Decoder a
field =
    Ffi.kernel "JsonDec_field"


-- | `at path decoder` — drill into nested fields.
at : List String -> Decoder a -> Decoder a
at =
    Ffi.kernel "JsonDec_at"


-- | `index n decoder` — decode the n-th element of an array.
index : Int -> Decoder a -> Decoder a
index =
    Ffi.kernel "JsonDec_index"


-- ─── Collections ───────────────────────────────────────────────────
list : Decoder a -> Decoder (List a)
list =
    Ffi.kernel "JsonDec_list"


-- | Decode a JSON object whose keys are not known in advance (a map of
-- names to values) into a list of `( key, value )` pairs. Every value must
-- satisfy the decoder.
--
-- The pairs come in byte-wise key order (`"B"` before `"a"`), not in the
-- order of the text. This is the same order contract as `value`: a decoded
-- object keeps no key order.
--
-- A value the decoder refuses is an `Err` that names its key:
-- `at ["b"]: expected Int, got String`. Inside a field the path grows, as for
-- `field`: `at .scores["b"]: expected Int, got String`. A key is always
-- written in quotes, so it never reads as a field name.
--
--     Decode.decodeString (Decode.keyValuePairs Decode.int) "{\"b\":2,\"a\":1}"
--         == Ok [ ( "a", 1 ), ( "b", 2 ) ]
keyValuePairs : Decoder a -> Decoder (List ( String, a ))
keyValuePairs =
    Ffi.kernel "JsonDec_keyValuePairs"


-- | Decode a JSON object into a `Dict` keyed by its member names. Every value
-- must satisfy the decoder. Errors name the key, as for `keyValuePairs`.
--
--     Decode.decodeString (Decode.dict Decode.int) "{\"a\":1,\"b\":2}"
--         == Ok (Dict.fromList [ ( "a", 1 ), ( "b", 2 ) ])
--
-- A JSON object never repeats a key: `decodeString` refuses text that does,
-- so each member is one entry of the Dict.
dict : Decoder a -> Decoder (Dict String a)
dict =
    Ffi.kernel "JsonDec_dict"


-- | A decoder made when it runs. Use it for a recursive structure, where a
-- decoder must name itself: a tree, a comment with replies.
--
--     type Tree = Node Int (List Tree)
--
--     tree : Decoder Tree
--     tree =
--         Decode.map2 Node
--             (Decode.field "value" Decode.int)
--             (Decode.field "children" (Decode.list (Decode.lazy (\_ -> tree))))
--
-- The function is called each time the decoder runs. The recursion is as deep
-- as the JSON, and every decoder reads at most 10000 nested arrays and objects
-- (`decodeString` refuses deeper text, `decodeValue` a deeper Value), so deep
-- input is an `Err`, never a stack overflow.
lazy : (() -> Decoder a) -> Decoder a
lazy =
    Ffi.kernel "JsonDec_lazy"


-- ─── Combinators ───────────────────────────────────────────────────
map : (a -> b) -> Decoder a -> Decoder b
map =
    Ffi.kernel "JsonDec_map"


andThen : (a -> Decoder b) -> Decoder a -> Decoder b
andThen =
    Ffi.kernel "JsonDec_andThen"


-- | A decoder that always succeeds with the given value.
succeed : a -> Decoder a
succeed =
    Ffi.kernel "JsonDec_succeed"


-- | A decoder that always fails with the given error message.
fail : String -> Decoder a
fail =
    Ffi.kernel "JsonDec_fail"


-- | Try each decoder in turn; succeed with the first to match.
oneOf : List (Decoder a) -> Decoder a
oneOf =
    Ffi.kernel "JsonDec_oneOf"


-- | Succeed with the given value when the JSON value is `null`; fail on
-- anything else.
--
--     Decode.decodeString (Decode.null 0) "null" == Ok 0
null : a -> Decoder a
null =
    Ffi.kernel "JsonDec_null"


-- | Decode a value that may be `null`: `null` gives `Nothing`, any other
-- value must satisfy the decoder and gives `Just`. A non-null value the
-- decoder rejects is an `Err`.
--
--     Decode.decodeString (Decode.nullable Decode.int) "null" == Ok Nothing
--     Decode.decodeString (Decode.nullable Decode.int) "3" == Ok (Just 3)
nullable : Decoder a -> Decoder (Maybe a)
nullable =
    Ffi.kernel "JsonDec_nullable"


-- | Run the decoder and never fail: `Just` its value when it succeeds,
-- `Nothing` when it fails for ANY reason (a wrong type included). Prefer
-- `nullable` when only `null` should become `Nothing`.
maybe : Decoder a -> Decoder (Maybe a)
maybe =
    Ffi.kernel "JsonDec_maybe"


-- ─── Map-N (combine multiple decoders) ─────────────────────────────
map2 : (a -> b -> c) -> Decoder a -> Decoder b -> Decoder c
map2 =
    Ffi.kernel "JsonDec_map2"


map3 : (a -> b -> c -> d) -> Decoder a -> Decoder b -> Decoder c -> Decoder d
map3 =
    Ffi.kernel "JsonDec_map3"


map4 : (a -> b -> c -> d -> e) -> Decoder a -> Decoder b -> Decoder c -> Decoder d -> Decoder e
map4 =
    Ffi.kernel "JsonDec_map4"


map5 : (a -> b -> c -> d -> e -> f) -> Decoder a -> Decoder b -> Decoder c -> Decoder d -> Decoder e -> Decoder f
map5 =
    Ffi.kernel "JsonDec_map5"
