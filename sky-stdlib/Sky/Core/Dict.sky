-- | Sky.Core.Dict — string-keyed associative map (Layer 3 Sky source).
--
-- Every function in this module is declared as a Sky-source binding
-- aliased to a kernel via `Ffi.kernel "Dict_<name>"`.  The Stage-4
-- compiler primitive rewrites every call site to the existing typed
-- kernel dispatch — so `Dict.get "k" d` continues to emit
-- `rt.Dict_getT[V]("k", d)` exactly as before, preserving the
-- typed-codegen guarantees the kernel-direct route already enjoyed.
--
-- The Sky-source layer exists for discoverability + Layer 3
-- conformance + so `sky doc` shows a stable source location for
-- every entry.  The runtime bodies live in `runtime-go/rt/rt.go`
-- (`Dict_*` helpers; the typed `Dict_*T[V]` variants live alongside).
--
-- Key-type note: at runtime the underlying map is `map[string]V`,
-- so non-String keys are stringified on `fromList` and re-parsed on
-- `toList`. For `Dict Int v` the round-trip is faithful (Int → "1" →
-- 1); for floating-point keys the round-trip carries decimal-string
-- precision (Float 1.5 → "1.5" → 1.5). When Sky's HM solver infers
-- a typed key like `Dict Int v`, the compiler routes `Dict.toList`
-- through the `Dict_toListIntKey` variant so the returned tuple's
-- first slot is a real Int — closing the long-standing Limitation
-- #10 soundness hole.
module Sky.Core.Dict exposing
    ( empty
    , isEmpty, size
    , insert, get, remove, member
    , keys, values
    , toList, fromList
    , map, foldl, union
    )


import Sky.Ffi as Ffi


-- ─── Construction ──────────────────────────────────────────────────


-- | The empty dictionary.
empty : Dict k v
empty = Ffi.kernel "Dict_empty"


-- ─── Cardinality / queries ─────────────────────────────────────────


-- | `True` when the dictionary contains no entries.
isEmpty : Dict k v -> Bool
isEmpty = Ffi.kernel "Dict_isEmpty"


-- | Number of key/value pairs.
size : Dict k v -> Int
size = Ffi.kernel "Dict_size"


-- | `member k d` — `True` iff `k` is bound in `d`.
member : k -> Dict k v -> Bool
member = Ffi.kernel "Dict_member"


-- | `get k d` — look up `k`; `Nothing` if absent.
get : k -> Dict k v -> Maybe v
get = Ffi.kernel "Dict_get"


-- ─── Mutation (returns new Dict) ───────────────────────────────────


-- | `insert k v d` — bind `k → v`, replacing any prior value.
insert : k -> v -> Dict k v -> Dict k v
insert = Ffi.kernel "Dict_insert"


-- | `remove k d` — drop `k`'s binding; no-op if absent.
remove : k -> Dict k v -> Dict k v
remove = Ffi.kernel "Dict_remove"


-- ─── Conversion ────────────────────────────────────────────────────


-- | All keys in the dictionary (unsorted).
keys : Dict k v -> List k
keys = Ffi.kernel "Dict_keys"


-- | All values in the dictionary (unsorted).
values : Dict k v -> List v
values = Ffi.kernel "Dict_values"


-- | `toList d` — every (key, value) pair as a list of tuples.
--
-- Key-type fidelity: when the inferred Sky type is `Dict Int v`,
-- the compiler routes through a typed kernel variant whose first
-- tuple slot is `Int` (not `String`). Arithmetic on the returned
-- keys works correctly — closes Limitation #10.
toList : Dict k v -> List ( k, v )
toList = Ffi.kernel "Dict_toList"


-- | `fromList pairs` — build a dictionary from a list of tuples.
-- Later pairs overwrite earlier ones with the same key.
fromList : List ( k, v ) -> Dict k v
fromList = Ffi.kernel "Dict_fromList"


-- ─── Higher-order combinators ──────────────────────────────────────


-- | `map fn d` — apply `fn k v` to every entry, building a new
-- dictionary with the transformed values.
map : (k -> v -> w) -> Dict k v -> Dict k w
map = Ffi.kernel "Dict_map"


-- | `foldl fn acc d` — accumulate over every entry.
foldl : (k -> v -> a -> a) -> a -> Dict k v -> a
foldl = Ffi.kernel "Dict_foldl"


-- | `union a b` — merge two dictionaries. `a`'s bindings win on
-- key collision.
union : Dict k v -> Dict k v -> Dict k v
union = Ffi.kernel "Dict_union"
