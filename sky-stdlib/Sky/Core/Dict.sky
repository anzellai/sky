-- | Sky.Core.Dict — associative map, ordered by key (Layer 3 Sky source).
--
-- Every function in this module is declared as a Sky-source binding
-- aliased to a kernel via `Ffi.kernel "Dict_<name>"`. Over a typed
-- dict the compiler calls typed runtime twins instead (`get`, `member`,
-- `insert` and `remove` with an `Int` or `String` key go to
-- `rt.Dict_getIntT[V]` / `rt.Dict_insertStrT[V]` / …). The runtime
-- bodies live in `runtime-go/rt/rt.go` and
-- `runtime-go/rt/dict_persistent.go`.
--
-- A dict is a persistent value (`rt.SkyDict[V]`): a flat array of up
-- to 16 entries, then a 16-way hash array mapped trie. `insert` and
-- `remove` copy one path, O(log n), and the old dict is unchanged and
-- shares the rest, so a fold that builds a dict is O(n log n). Order is
-- not a property of the structure: the operations that list the
-- entries sort them by key, so they cost O(n log n).
--
-- Key-type note: every key is encoded to a string on the way in.
-- Lookup-shaped operations (`get`, `member`, `insert`, `remove`) encode
-- the probe the same way and so agree for any key type. The operations
-- that let the key back OUT — `toList`, `keys`, `values`, `foldl`,
-- `map` — decode it back to the Sky type. The encoded key carries its
-- own kind tag, so the decode needs no type information from the call
-- site: it is just as correct inside a key-polymorphic helper
-- (`f : Dict k v -> …`), where the compiler has erased `k`, as it is
-- at a call site typed `Dict Int v`. `String`, `Int`, `Float`, `Char`
-- and `Bool` keys round-trip; enumeration is ordered by the DECODED
-- key, so a `Dict Int v` visits 9 before 10 rather than in the lexical
-- order of "9" and "10". A `Dict String v` is encoded verbatim — the
-- shape that crosses into JSON objects, `Std.Db` rows and HTTP headers
-- keeps exactly the keys you gave it.
--
-- Composite keys (tuple, list, record, custom type) do NOT round-trip
-- — their stringification is not injective — and are REJECTED AT
-- CHECK TIME with `[E2008]`, naming the offending key type and the
-- five that work. The check resolves through type aliases, so
-- `type alias Coord = ( Int, Int )` is no bypass, and it fires only on
-- a CONCRETE key: a key-polymorphic `Dict k v` is ordinary Sky and
-- stays accepted (it now also decodes correctly — see the kind tag
-- above), while a call site that instantiates its `k` to a composite
-- is rejected at that call site. See `docs/KNOWN_LIMITATIONS.md`.
module Sky.Core.Dict exposing
    ( empty
    , isEmpty
    , size
    , insert
    , get
    , remove
    , member
    , keys
    , values
    , toList
    , fromList
    , map
    , foldl
    , union
    )

import Sky.Ffi as Ffi


-- ─── Construction ──────────────────────────────────────────────────
-- | The empty dictionary.
--
-- Cost: O(1).
empty : Dict k v
empty =
    Ffi.kernel "Dict_empty"


-- ─── Cardinality / queries ─────────────────────────────────────────
-- | `True` when the dictionary contains no entries.
--
-- Cost: O(1).
isEmpty : Dict k v -> Bool
isEmpty =
    Ffi.kernel "Dict_isEmpty"


-- | Number of key/value pairs.
--
-- Cost: O(1).
size : Dict k v -> Int
size =
    Ffi.kernel "Dict_size"


-- | `member k d` — `True` iff `k` is bound in `d`.
--
-- Cost: O(log n): a walk of the persistent hash trie (a scan of at most 16 entries while the dict is small).
member : k -> Dict k v -> Bool
member =
    Ffi.kernel "Dict_member"


-- | `get k d` — look up `k`; `Nothing` if absent.
--
-- Cost: O(log n): a walk of the persistent hash trie (a scan of at most 16 entries while the dict is small).
get : k -> Dict k v -> Maybe v
get =
    Ffi.kernel "Dict_get"


-- ─── Mutation (returns new Dict) ───────────────────────────────────
-- | `insert k v d` — bind `k → v`, replacing any prior value.
--
-- Cost: O(log n): one path of the persistent dict is copied; the old dict is unchanged and shares the rest.
insert : k -> v -> Dict k v -> Dict k v
insert =
    Ffi.kernel "Dict_insert"


-- | `remove k d` — drop `k`'s binding; no-op if absent.
--
-- Cost: O(log n): one path of the persistent dict is copied; the old dict is unchanged and shares the rest.
remove : k -> Dict k v -> Dict k v
remove =
    Ffi.kernel "Dict_remove"


-- ─── Conversion ────────────────────────────────────────────────────
-- | All keys in the dictionary, in ascending key order.
--
-- Cost: O(n log n): the keys are sorted on every call.
keys : Dict k v -> List k
keys =
    Ffi.kernel "Dict_keys"


-- | All values in the dictionary, in ascending order of their KEY.
--
-- Cost: O(n log n): the keys are sorted on every call.
values : Dict k v -> List v
values =
    Ffi.kernel "Dict_values"


-- | `toList d` — every (key, value) pair as a list of tuples, in
-- ascending key order.
--
-- Key-type fidelity: the key comes back as its Sky type, not as the
-- runtime map's stringified form — arithmetic on the keys of a
-- `Dict Int v`, and `Char.toCode` on the keys of a `Dict Char v`,
-- both work. See the key-type note at the top of this module for the
-- two shapes that do not round-trip.
--
-- Cost: O(n log n): the keys are sorted on every call.
toList : Dict k v -> List ( k, v )
toList =
    Ffi.kernel "Dict_toList"


-- | `fromList pairs` — build a dictionary from a list of tuples.
-- Later pairs overwrite earlier ones with the same key.
--
-- Cost: O(n): built in one pass (a later pair with the same key wins).
fromList : List ( k, v ) -> Dict k v
fromList =
    Ffi.kernel "Dict_fromList"


-- ─── Higher-order combinators ──────────────────────────────────────
-- | `map fn d` — apply `fn k v` to every entry, building a new
-- dictionary with the transformed values. The keys are unchanged;
-- `fn` receives each one as its Sky type.
--
-- Cost: O(n log n): the keys are sorted on every call.
map : (k -> v -> w) -> Dict k v -> Dict k w
map =
    Ffi.kernel "Dict_map"


-- | `foldl fn acc d` — accumulate over every entry, in ascending key
-- order. `fn` receives each key as its Sky type.
--
-- Cost: O(n log n): the keys are sorted on every call.
foldl : (k -> v -> a -> a) -> a -> Dict k v -> a
foldl =
    Ffi.kernel "Dict_foldl"


-- | `union a b` — merge two dictionaries. `a`'s bindings win on
-- key collision.
--
-- Cost: O(m log n): the smaller dict is inserted into the larger.
union : Dict k v -> Dict k v -> Dict k v
union =
    Ffi.kernel "Dict_union"
