-- | Sky.Core.List — list combinators (subset).
--
-- v0.13 Layer 3 / Phase B3: Sky source for the non-HOF
-- combinators.  HOFs (`map`, `filter`, `foldl`, `foldr`,
-- `concatMap`, `filterMap`, `indexedMap`, `find`, `any`, `all`,
-- `sortBy`) stay kernel-anchored for now because Sky lambdas
-- always lower to `func(any) any` and cross-module HOF param
-- positions need typed lambda lowering to round-trip cleanly
-- through `splitInferredSigWithReg`'s rendering (Limitation #18 /
-- Gap 4 territory).  Migrating them surfaces "cannot infer T2"
-- at call sites because the recursive body uses fn's any-typed
-- return.
--
-- This phase ships the non-HOF surface: nullable accessors
-- (head, tail), arithmetic predicates (isEmpty, member, length),
-- non-HOF traversals (reverse, take, drop, append, concat, range,
-- zip), and cons.
module Sky.Core.List exposing
    ( isEmpty
    , length
    , head
    , tail
    , cons
    , reverse
    , take
    , drop
    , append
    , concat
    , member
    , range
    , zip
    , map
    , filter
    , any
    , all
    , find
    , foldl
    , foldr
    , concatMap
    , indexedMap
    )


-- | `map fn list` — apply fn to each element.
--
-- v0.17 step-8 (Limitation #8 starter): CPS / accumulator rewrite.
-- Forwards `mapHelp` accumulates `fn x :: acc` (reversed) tail-
-- recursively, then `reverseHelp` flips the result. Both helpers
-- are tail-recursive and auto-TCO'd by `Sky.Build.TailCallOpt` to
-- a `for { ... continue }` loop, so a 1M-element input runs in
-- constant Go stack instead of the old O(N) non-TCO recursion.
map fn list =
    mapHelp fn list []


mapHelp fn list acc =
    case list of

        [] ->
            reverseHelp acc []

        x :: rest ->
            mapHelp fn rest (fn x :: acc)


-- | `filter pred list` — keep only elements satisfying pred.
--
-- v0.17 step-1 (Limitation #8): CPS / accumulator rewrite.
-- Forwards `filterHelp` accumulates `x :: acc` (reversed) for
-- elements satisfying pred, then `reverseHelp` flips the result.
-- Both helpers are tail-recursive and auto-TCO'd by
-- `Sky.Build.TailCallOpt` to a `for { ... continue }` loop, so a
-- 1M-element input runs in constant Go stack instead of the old
-- O(N) non-TCO recursion.
filter pred list =
    filterHelp pred list []


filterHelp pred list acc =
    case list of

        [] ->
            reverseHelp acc []

        x :: rest ->
            filterHelp
                pred
                rest
                (if pred x then
                    x :: acc

                else
                    acc)


any pred list =
    case list of

        [] ->
            False

        x :: rest ->
            if pred x then
                True

            else
                any pred rest


all pred list =
    case list of

        [] ->
            True

        x :: rest ->
            if pred x then
                all pred rest

            else
                False


find pred list =
    case list of

        [] ->
            Nothing

        x :: rest ->
            if pred x then
                Just x

            else
                find pred rest


foldl fn acc list =
    case list of

        [] ->
            acc

        x :: rest ->
            foldl fn (fn x acc) rest


-- CPS rewrite (v0.17 step-2 of the Limitation #8 close).  The
-- legacy `foldr fn x (foldr fn acc rest)` shape recursed in the
-- non-tail position, so the emitted Go ran in O(N) stack — a
-- 1M-element input blew Go's `maxstacksize` (default 1 GiB).
--
-- The rewrite delegates to the already-tail-recursive `foldl`
-- over the pre-reversed list.  Note: this is a DELEGATING
-- binding — the public `foldr` itself contains no `for { }` loop
-- because the auto-TCO loop lives in `foldl`'s emitted Go body.
-- The `\x a -> fn x a` lambda is structurally identical to `fn`
-- but pinned at the application site so the typed lowerer sees a
-- fresh callback shape per instantiation.
foldr fn acc list =
    foldl (\x a -> fn x a) acc (reverseHelp list [])


concatMap fn list =
    case list of

        [] ->
            []

        x :: rest ->
            append (fn x) (concatMap fn rest)


indexedMap fn list =
    indexedMapHelp fn 0 list


indexedMapHelp fn i list =
    case list of

        [] ->
            []

        x :: rest ->
            fn i x :: indexedMapHelp fn (i + 1) rest


isEmpty list =
    case list of

        [] ->
            True

        _ ->
            False


length list =
    case list of

        [] ->
            0

        _ :: rest ->
            1 + length rest


head list =
    case list of

        [] ->
            Nothing

        x :: _ ->
            Just x


tail list =
    case list of

        [] ->
            Nothing

        _ :: rest ->
            Just rest


cons x list =
    x :: list


reverse list =
    reverseHelp list []


reverseHelp list acc =
    case list of

        [] ->
            acc

        x :: rest ->
            reverseHelp rest (x :: acc)


take n list =
    if n <= 0 then
        []

    else
        case list of

            [] ->
                []

            x :: rest ->
                x :: take (n - 1) rest


drop n list =
    if n <= 0 then
        list

    else
        case list of

            [] ->
                []

            _ :: rest ->
                drop (n - 1) rest


append xs ys =
    case xs of

        [] ->
            ys

        x :: rest ->
            x :: append rest ys


-- | `concat lists` — flatten a list of lists.
--
-- v0.17 step-3 (Limitation #8): CPS / accumulator rewrite.
-- `concatHelp lists acc` walks the outer list tail-recursively,
-- using `appendReverseOnto xs acc` to cons each inner list's
-- elements onto `acc` in REVERSE order.  When the outer list is
-- exhausted, `reverseHelp acc []` flips the accumulator once for
-- the final left-to-right result.  Both `concatHelp` and
-- `appendReverseOnto` are tail-recursive and auto-TCO'd by
-- `Sky.Build.TailCallOpt` to a `for { ... continue }` loop, so a
-- 1M-element input runs in constant Go stack instead of the old
-- O(N) non-TCO recursion (the legacy `append xs (concat rest)`
-- shape recursed in the non-tail position).
--
-- NOTE: `concatHelp` uses ONLY the private `appendReverseOnto`,
-- NOT the public `append` — so `concat` is fully independent of
-- whatever step-5 does to `append`'s rewrite.
concat lists =
    concatHelp lists []


concatHelp lists acc =
    case lists of

        [] ->
            reverseHelp acc []

        xs :: rest ->
            concatHelp rest (appendReverseOnto xs acc)


-- | `appendReverseOnto xs acc` — cons each element of `xs` onto
-- `acc` in reverse order.  Tail-recursive so the emitted Go is a
-- `for { ... continue }` loop.  Private helper for `concat`.
appendReverseOnto xs acc =
    case xs of

        [] ->
            acc

        x :: rest ->
            appendReverseOnto rest (x :: acc)


member x list =
    case list of

        [] ->
            False

        y :: rest ->
            if x == y then
                True

            else
                member x rest


range lo hi =
    if lo > hi then
        []

    else
        lo :: range (lo + 1) hi


zip xs ys =
    case xs of

        [] ->
            []

        x :: xRest ->
            case ys of

                [] ->
                    []

                y :: yRest ->
                    ( x, y ) :: zip xRest yRest
