-- | Sky.Core.List — list combinators.
--
-- Sky lists are Go `[]any` slices (see `runtime-go/rt`), so `::`-cons
-- (`rt.List_cons`) is an O(n) immutable prepend — it copies the whole
-- accumulator on every step. That means a pure-Sky CPS/accumulator loop
-- that conses per element (the v0.17 rewrite shape) is O(n) in stack but
-- O(n²) in TIME (conformance finding L1). So every list-BUILDING op is an
-- `Ffi.kernel "List_<name>"` alias backed by an O(n) Go loop that grows the
-- result slice with `append` in forward order (NO per-element cons). This
-- keeps the `[]any` representation (so all FFI / interop / `rt.AsListT`
-- typed-widening is unchanged), stays constant Go stack (a plain loop), and
-- drops the ops to O(n). The runtime bodies live in `runtime-go/rt/rt.go`
-- (`List_*` helpers). Explicit HM signatures are load-bearing on every
-- kernel alias — `Ffi.kernel` has no body for HM to walk, so the signature
-- is the sole type source (same shape as `Sky.Core.Dict`'s HOF kernels,
-- e.g. `Dict.map : (k -> v -> w) -> Dict k v -> Dict k w`).
--
-- The SCALAR-accumulating ops (`foldl` / `length` / `member` / `any` /
-- `all` / `find` / `isEmpty`) stay pure Sky: they are already O(n) — the
-- accumulator is a scalar, not a growing list — and are auto-TCO'd by
-- `Sky.Build.TailCallOpt` to a `for { ... continue }` loop, so they run in
-- constant Go stack. `head` / `tail` / `cons` are O(1) pure Sky.
module Sky.Core.List exposing
    ( isEmpty
    , length
    , head
    , tail
    , cons
    , reverse
    , take
    , drop
    , append
    , concat
    , member
    , range
    , zip
    , map
    , filter
    , any
    , all
    , find
    , foldl
    , foldr
    , concatMap
    , indexedMap
    )

import Sky.Ffi as Ffi


-- ─── List-building ops (O(n) Go kernels) ───────────────────────────
-- | `map fn list` — apply `fn` to each element.
map : (a -> b) -> List a -> List b
map =
    Ffi.kernel "List_map"


-- | `filter pred list` — keep only elements satisfying `pred`.
filter : (a -> Bool) -> List a -> List a
filter =
    Ffi.kernel "List_filter"


-- | `foldr fn acc list` — right fold: `fn a0 (fn a1 (… (fn aN acc)))`.
foldr : (a -> b -> b) -> b -> List a -> b
foldr =
    Ffi.kernel "List_foldr"


-- | `concatMap fn list` — map each element to a list and flatten
-- (left-to-right).
concatMap : (a -> List b) -> List a -> List b
concatMap =
    Ffi.kernel "List_concatMap"


-- | `indexedMap fn list` — apply `fn` to each zero-based `(index, element)`
-- pair.
indexedMap : (Int -> a -> b) -> List a -> List b
indexedMap =
    Ffi.kernel "List_indexedMap"


-- | `reverse list` — the list in reverse order.
reverse : List a -> List a
reverse =
    Ffi.kernel "List_reverse"


-- | `take n list` — first `n` elements (or fewer when `list` is shorter).
-- `take 0` and `take <negative>` return `[]`.
take : Int -> List a -> List a
take =
    Ffi.kernel "List_take"


-- | `drop n list` — `list` without its first `n` elements. `drop 0` and
-- `drop <negative>` return `list`; `drop n` for `n >= length` returns `[]`.
drop : Int -> List a -> List a
drop =
    Ffi.kernel "List_drop"


-- | `append xs ys` — concatenate two lists.
append : List a -> List a -> List a
append =
    Ffi.kernel "List_append"


-- | `concat lists` — flatten a list of lists.
concat : List (List a) -> List a
concat =
    Ffi.kernel "List_concat"


-- | `range lo hi` — `[lo, lo + 1, …, hi]` (inclusive). `lo > hi` gives `[]`.
range : Int -> Int -> List Int
range =
    Ffi.kernel "List_range"


-- | `zip xs ys` — pair-wise zip, truncated to the shorter list's length.
zip : List a -> List b -> List ( a, b )
zip =
    Ffi.kernel "List_zip"


-- ─── Scalar-accumulating / O(1) ops (pure Sky, auto-TCO'd) ──────────
any pred list =
    case list of

        [] ->
            False

        x :: rest ->
            if pred x then
                True

            else
                any pred rest


all pred list =
    case list of

        [] ->
            True

        x :: rest ->
            if pred x then
                all pred rest

            else
                False


find pred list =
    case list of

        [] ->
            Nothing

        x :: rest ->
            if pred x then
                Just x

            else
                find pred rest


foldl fn acc list =
    case list of

        [] ->
            acc

        x :: rest ->
            foldl fn (fn x acc) rest


isEmpty list =
    case list of

        [] ->
            True

        _ ->
            False


-- | `length list` — number of elements. `lengthHelp` carries the running
-- count in tail position so the emitted Go is a `for { ... continue }` loop
-- (constant Go stack).
length list =
    lengthHelp list 0


lengthHelp : List a -> Int -> Int
lengthHelp list n =
    case list of

        [] ->
            n

        _ :: rest ->
            lengthHelp rest (n + 1)


head list =
    case list of

        [] ->
            Nothing

        x :: _ ->
            Just x


tail list =
    case list of

        [] ->
            Nothing

        _ :: rest ->
            Just rest


cons x list =
    x :: list


member x list =
    case list of

        [] ->
            False

        y :: rest ->
            if x == y then
                True

            else
                member x rest
