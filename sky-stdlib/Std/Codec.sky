-- | Std.Codec — one bidirectional codec per type, reused for JSON now and DB
-- later (Layer 3 pure Sky, built on `Sky.Core.Json.Encode`/`Decode`).
--
-- A `Codec a` bundles an encoder + a decoder + a structural `shape` (used by the
-- DB backend to derive columns). Write it once; get JSON encode AND decode — and
-- eventually DB read/write/schema — from the single definition.
--
-- ```elm
-- import Std.Codec as Codec exposing (Codec)
--
-- type alias User = { id : String, age : Int, active : Bool, nick : Maybe String }
--
-- userCodec : Codec User
-- userCodec =
--     Codec.object User
--         |> Codec.field "id" .id Codec.string
--         |> Codec.field "age" .age Codec.int
--         |> Codec.field "active" .active Codec.bool
--         |> Codec.field "nick" .nick (Codec.maybe Codec.string)
--         |> Codec.buildObject
--
-- Codec.toJson userCodec user          -- : String
-- Codec.fromJson userCodec jsonString  -- : Result Error User
-- ```
--
-- Covers records (`object`/`field`), ADTs (`taggedUnion`/`varN`, `enum`),
-- primitives, `Maybe`, `List`, and `map`.
module Std.Codec exposing
    ( Codec
    , ColType(..)
    , Shape(..)
    , ObjectCodec
    , shape
    , zeroJson
    , fieldZeros
    , fieldReadError
    , writeChecks
    , problems
    , JsonSchema
    , schemaFitError
    , schemaValueError
    , jsonSchema
    , toValue
    , toJson
    , fromJson
    , fromJsonSafe
    , toXml
    , fromXml
    , string
    , int
    , float
    , bool
    , decimal
    , moneyIn
    , moneyObject
    , isoCurrency
    , value
    , maybe
    , list
    , result
    , dict
    , error
    , map
    , object
    , field
    , inline
    , buildObject
    , auto
    , autoCamel
    , autoWith
    , Variant
    , taggedUnion
    , var0
    , var1
    , var2
    , var3
    , enum
    )

import Sky.Ffi as Ffi
import Sky.Core.Json.Encode as E exposing (Value)
import Sky.Core.Json.Decode as D exposing (Decoder)
import Sky.Core.Error as Error exposing (Error)
import Sky.Core.Dict as Dict exposing (Dict)
import Sky.Core.List as List
import Sky.Core.String as String
import Std.Xml as Xml exposing (Node)
import Std.Xml.Encode as XE
import Std.Decimal as Dec exposing (Decimal)
import Std.Money as Mon exposing (Money(..), Currency)

-- | The column type a codec maps to on the DB side. `CDecimal` (v0.29.2) is
-- an exact decimal column: `NUMERIC` on PostgreSQL, `TEXT` holding the
-- canonical decimal on SQLite (see `decimal`). `CMoneyIn code` (v0.29.2) is
-- the same column holding the amounts of one currency (`moneyIn`), named by
-- its ISO code, so a conversion of an older column can check the currency.
type ColType
    = CText
    | CInt
    | CReal
    | CBool
    | CBlob
    | CDecimal
    | CMoneyIn String
    | CNull ColType

-- | The structural shape of a codec — a record maps to columns, a scalar to one
-- typed column, anything else (list / nested / ADT) to a JSON TEXT blob.
type Shape
    = SRecord (List ( String, ColType ))
    | SScalar ColType
    | SBlob

-- | A bidirectional codec for `a`: encoder + decoder + shape, and a
-- description of its JSON that `jsonSchema` renders as a JSON Schema.
--
-- The payload is a named record, so a function that matches a `Codec` reads
-- it with one runtime narrowing instead of one per field (doc 14 §4.5, R6).
type Codec a
    = Codec (CodecPayload a)

-- `vck` is the check of a value this codec wrote itself, for a PARTIAL codec
-- (one whose encoder can write a value its own decoder refuses), and `[]` for
-- a total codec (one that reads every value it writes). Partiality is derived
-- from the codec tree, never listed by hand: each leaf states its own (the
-- partial leaves are `decimal`, `moneyIn`, `moneyObject`, `isoCurrency`,
-- `enum`, a `taggedUnion`, whose encoder is the caller's function, and a
-- `Codec.auto` / `autoWith` field of a type that holds a Decimal or a Money),
-- and every container (`maybe`, `list`, `dict`, `result`, `map`, a record, a
-- union variant) is partial exactly when a child is, so a new partial leaf is
-- covered at every depth with no other change. It reads the `Value` in memory. `vcs` is, for a record
-- codec, the `vck` of each field that has one, by JSON key: `Std.Db.Store`
-- runs only these on a write (`writeChecks`). `prb` lists what is wrong with
-- the codec as built (an `autoWith` key that names no field, a `moneyIn` code
-- that is not a currency code); `Std.Db.Store.fromCodec` refuses a store
-- whose codec has one (`problems`).
type alias CodecPayload a =
    { enc : a -> Value
    , dec : Decoder a
    , shp : Shape
    , sch : SchemaNode
    , zro : () -> Maybe Value
    , fzr : () -> List ( String, Value )
    , fck : () -> List ( String, Value -> Maybe String )
    , vck : List (Value -> Maybe String)
    , vcs : List ( String, Value -> Maybe String )
    , prb : List String
    , jsn : a -> Maybe String
    }

-- | The JSON Schema of the JSON a codec reads and writes. `exact` is `True`
-- when the schema pins down every value; it is `False` when a part is the
-- open schema `{}` (a `taggedUnion`, a `result`, a `dict`, a `Json.Value`
-- field, `Codec.error`), which the codec's decoder still checks.
type alias JsonSchema =
    { schema : Value
    , exact : Bool
    }

-- The description a codec carries. It is plain data, so a codec that never
-- asks for its schema pays nothing at run time: `jsonSchema` renders it, and
-- an `auto` codec reads its witness's fields only then.
type SchemaNode
    = SnType String
    | SnNullable SchemaNode
    | SnArray SchemaNode
    | SnEnum (() -> List String)
    | SnObject (List ( String, SchemaNode ))
    | SnAuto (() -> String) (List ( String, SchemaNode ))
    | SnOpen
    | SnUnion (List ( String, List SchemaNode ))
    | SnResult SchemaNode SchemaNode
    | SnDict SchemaNode SchemaNode
    | SnDecimal


-- ── Introspection / run ──────────────────────────────────────────────────────
-- | The JSON Schema of the codec's JSON: `"string"`, `"integer"`, `"number"`
-- and `"boolean"` for the scalars, a nullable value for `maybe`, an array for
-- `list`, the names for `enum`, and a closed object (every field required, no
-- other key) for a record built with `object` / `field` or derived by `auto`.
-- `Std.Ai` sends it as a tool's parameters and as a structured answer's
-- `response_format`, then decodes the model's JSON with the same codec.
--
--     Codec.jsonSchema (Codec.auto { city = "", days = 0 })
--     -- { schema = {"type":"object","properties":{"city":{"type":"string"},
--     --   "days":{"type":"integer"}},"required":["city","days"],
--     --   "additionalProperties":false}, exact = True }
jsonSchema : Codec a -> JsonSchema
jsonSchema (Codec c) =
    renderSchema c.sch


renderSchema : SchemaNode -> JsonSchema
renderSchema node =
    case node of

        SnType t ->
            { schema = E.object [ ( "type", E.string t ) ], exact = True }

        SnNullable inner ->
            let
                r = renderSchema inner
            in
                { schema =
                    E.object
                        [ ( "anyOf"
                          , E.list
                                identity
                                [ r.schema
                                , E.object [ ( "type", E.string "null" ) ]
                                ]
                          )
                        ]
                , exact = r.exact
                }

        SnArray inner ->
            let
                r = renderSchema inner
            in
                { schema =
                    E.object
                        [ ( "type", E.string "array" ), ( "items", r.schema ) ]
                , exact = r.exact
                }

        SnEnum names ->
            { schema =
                E.object
                    [ ( "type", E.string "string" )
                    , ( "enum", E.list identity (stringValues (names ())) )
                    ]
            , exact = True
            }

        SnObject fields ->
            objectSchema (renderFields fields)

        SnAuto fieldsJson overrides ->
            autoSchema (fieldsJson ()) overrides

        SnOpen ->
            { schema = E.object [], exact = False }

        -- A union, a result and a dict are JSON arrays a schema cannot pin
        -- down: open, as before they had nodes of their own (the nodes exist
        -- for `toXml` / `fromXml`).
        SnUnion _ ->
            { schema = E.object [], exact = False }

        SnResult _ _ ->
            { schema = E.object [], exact = False }

        SnDict _ _ ->
            { schema = E.object [], exact = False }

        SnDecimal ->
            { schema =
                E.object
                    [ ( "type", E.string "string" )
                    , ( "pattern", E.string decimalPattern )
                    ]
            , exact = True
            }


-- The text a `decimal` reads: digits with an optional `-` and one `.`, no
-- exponent (at most 1000 characters).
decimalPattern : String
decimalPattern =
    "^-?[0-9]+(\\.[0-9]+)?$"


-- A closed object: every field required, no other key. The lists are
-- walked by typed recursion, not by `List.map` over a lambda, so a read of a
-- field pays no runtime narrowing (doc 14 §4.5).
objectSchema : List ( String, JsonSchema ) -> JsonSchema
objectSchema fields =
    { schema =
        E.object
            [ ( "type", E.string "object" )
            , ( "properties", E.object (fieldSchemaValues fields) )
            , ( "required", E.list identity (fieldNameValues fields) )
            , ( "additionalProperties", E.bool False )
            ]
    , exact = allExact fields
    }


renderFields : List ( String, SchemaNode ) -> List ( String, JsonSchema )
renderFields fields =
    case fields of

        [] ->
            []

        ( n, f ) :: rest ->
            ( n, renderSchema f ) :: renderFields rest


fieldSchemaValues : List ( String, JsonSchema ) -> List ( String, Value )
fieldSchemaValues fields =
    case fields of

        [] ->
            []

        ( n, js ) :: rest ->
            ( n, js.schema ) :: fieldSchemaValues rest


fieldNameValues : List ( String, JsonSchema ) -> List Value
fieldNameValues fields =
    case fields of

        [] ->
            []

        ( n, _ ) :: rest ->
            E.string n :: fieldNameValues rest


allExact : List ( String, JsonSchema ) -> Bool
allExact fields =
    case fields of

        [] ->
            True

        ( _, js ) :: rest ->
            js.exact && allExact rest


stringValues : List String -> List Value
stringValues names =
    case names of

        [] ->
            []

        n :: rest ->
            E.string n :: stringValues rest

type alias AutoField =
    { name : String
    , schema : Value
    , exact : Bool
    }


-- An auto codec's schema: the witness's fields as the runtime reads their
-- types (`Codec_autoSchema`), each replaced by the override codec `autoWith`
-- gives it.
autoSchema : String -> List ( String, SchemaNode ) -> JsonSchema
autoSchema fieldsJson overrides =
    let
        fieldDecoder =
            D.map3
                (\n v x -> { name = n, schema = v, exact = x })
                (D.field "name" D.string)
                (D.field "schema" D.value)
                (D.field "exact" D.bool)
    in
        case D.decodeString
                 (D.field "fields" (D.nullable (D.list fieldDecoder)))
                 fieldsJson of

            Ok (Just fields) ->
                objectSchema
                    (List.map
                        (\f ->
                            case lookupSchema f.name overrides of

                                Just o ->
                                    ( f.name, renderSchema o )

                                Nothing ->
                                    ( f.name
                                    , { schema = f.schema, exact = f.exact }
                                    ))
                        fields)

            _ ->
                renderSchema SnOpen


lookupSchema : String -> List ( String, SchemaNode ) -> Maybe SchemaNode
lookupSchema col overrides =
    case overrides of

        [] ->
            Nothing

        ( c, s ) :: rest ->
            if c == col then
                Just s

            else
                lookupSchema col rest


-- | The codec's structural shape — how the DB backend derives columns (record
-- fields -> columns; nested/list/ADT -> a JSON blob column).
shape : Codec a -> Shape
shape (Codec c) =
    c.shp


-- | The JSON of the codec's zero value, when the codec knows one. For an
-- `auto` / `autoCamel` / `autoWith` codec it is the encoded blank record (the
-- witness). For a `buildObject` codec it is an object of every field's zero:
-- `""`, `0`, `false`, `null` for `maybe`, `[]` for `list` and `dict`, and the
-- first name of an `enum`. A `taggedUnion`, a `result` and `error` know none,
-- and nor does an object with such a field: a partial object would not
-- decode. This is the zero of the WHOLE value, as a nested field needs it.
-- For the zero of each column of a record codec, use `fieldZeros`.
--
--     Codec.zeroJson (Codec.auto { id = "", tags = [ "new" ] })
--     -- Just {"id":"","tags":["new"]}
zeroJson : Codec a -> Maybe Value
zeroJson (Codec c) =
    c.zro ()


-- | The zero of each field of a record codec, keyed by its JSON key (the
-- column name), in field order. For a `buildObject` codec it is each field
-- whose own codec has a zero (see `zeroJson`). A field with no zero (a
-- `taggedUnion`, a `result`, `error`, or an object holding one) is left out,
-- and the other fields keep theirs. For an `auto` / `autoCamel` / `autoWith`
-- codec it is each field of the encoded blank record (the witness). Any other
-- codec gives `[]`. `Std.Db.Store.migrate` and `sky db migrate --gen` use it
-- for the DEFAULT of a required JSON (blob) or enum column added to a table
-- with rows, so the rows that exist decode.
--
--     Codec.fieldZeros
--         (Codec.object Item
--             |> Codec.field "kind" .kind kindUnion
--             |> Codec.field "tags" .tags (Codec.list Codec.string)
--             |> Codec.buildObject)
--     -- [ ( "tags", [] ) ]   (the taggedUnion field "kind" has no zero)
fieldZeros : Codec a -> List ( String, Value )
fieldZeros (Codec c) =
    c.fzr ()


-- | The first field of the JSON object `text` that its field's codec does
-- not read, with the reason, or `Nothing`. Only the keys the object has are
-- read, in the codec's field order. A `buildObject` codec runs each field's
-- own decoder. An `auto` / `autoCamel` / `autoWith` codec decodes its blank
-- record (the witness) with the object's value in place of that field.
-- `Nothing` too when the codec cannot tell (a codec that is not a record).
-- `Std.Db.Store` uses it to name the column a stored row fails on, and to
-- check JSON written into one column.
--
--     Codec.fieldReadError itemCodec "{\"tags\":[1]}"
--     -- Just ( "tags", "Decode: at [0]: expected String, got Number" )
fieldReadError : Codec a -> String -> Maybe ( String, String )
fieldReadError codec text =
    let
        c = payloadOf codec
    in
        case c.fck () of

            [] ->
                swapFields c.dec text (c.fzr ()) (c.fzr ())

            checks ->
                checkFields text checks


-- The first field in `checks` that the object has and that its check
-- refuses. Every read goes through `decodeWith`.
checkFields : String -> List ( String, Value -> Maybe String ) -> Maybe ( String, String )
checkFields text checks =
    case checks of

        [] ->
            Nothing

        ( name, check ) :: rest ->
            case decodeWith (D.field name D.value) text of

                Err _ ->
                    checkFields text rest

                Ok v ->
                    case check v of

                        Just why ->
                            Just ( name, why )

                        Nothing ->
                            checkFields text rest


-- `checkFields` for a codec with no field decoders: each key of `zeros` that
-- the object has, swapped into the zeros (`swapError`).
swapFields : Decoder a -> String -> List ( String, Value ) -> List ( String, Value ) -> Maybe ( String, String )
swapFields dec text zeros keys =
    case keys of

        [] ->
            Nothing

        ( name, _ ) :: rest ->
            case decodeWith (D.field name D.value) text of

                Err _ ->
                    swapFields dec text zeros rest

                Ok v ->
                    case swapError dec name v zeros of

                        Just why ->
                            Just ( name, why )

                        Nothing ->
                            swapFields dec text zeros rest


-- | The write checks of a record codec (v0.29.2): each field whose codec is
-- partial (its encoder can write a value its own decoder refuses), by JSON key
-- (the column), with the check of that value: the field's own reader, run on
-- the encoded `Value` in memory. A field whose codec reads every value it
-- writes has none, so a record of plain fields (`String`, `Int`, `Float`,
-- `Bool`, `Codec.value`, and lists, maybes, dicts and records of them, under
-- `Codec.object` or `Codec.auto`) gives `[]`.
--
-- Partiality is derived from the codec tree: a field is partial when any codec
-- inside it is. The partial leaves are `decimal`, `moneyIn` and `moneyObject`
-- (a computed Decimal written out longer than the 1000 characters a reader
-- takes; a Money in another currency for `moneyIn`), `isoCurrency` (a
-- `CurrencyRaw` code that is not 3 to 10 letters or digits), `enum` (a value
-- not in its pairs), `taggedUnion` (its encoder is the caller's function) and
-- a `Codec.auto` / `autoWith` field whose type holds a `Decimal` or a `Money`.
-- `Std.Db.Store` runs these checks on every write, so a row its own codec
-- would not read back is never written: the write is an `Err` naming the
-- column and the reason. A `Float` that is NaN or infinite is refused by the
-- Store's column binding (JSON has no such number).
--
--     Codec.writeChecks
--         (Codec.object Item
--             |> Codec.field "id" .id Codec.string
--             |> Codec.field "status" .status statusEnum
--             |> Codec.buildObject)
--     -- [ ( "status", <check> ) ]
writeChecks : Codec a -> List ( String, Value -> Maybe String )
writeChecks codec =
    (payloadOf codec).vcs


-- | What is wrong with the codec as built (v0.29.2), `[]` for a sound one: an
-- `autoWith` key that names no field of the record, two `autoWith` keys that
-- name one column, a `moneyIn` currency code that is not a code (see
-- `Money.currencyFromCode`), one JSON key used by two fields of a
-- `buildObject` record, one name given to two values of an `enum`, or one tag
-- given to two variants of a `taggedUnion`. Each is a sentence naming the
-- problem, at any depth. `Std.Db.Store.fromCodec` refuses a store whose codec
-- has one, and an `autoWith` codec with such a key does not decode.
problems : Codec a -> List String
problems codec =
    (payloadOf codec).prb


-- The reason a decoder does not read a value already in memory, or
-- `Nothing`. No text is written or parsed (`D.decodeValue`). One site, so
-- the kernel's result is narrowed once (doc 14, R5).
valueCheck : Decoder f -> Value -> Maybe String
valueCheck dec v =
    case D.decodeValue dec v of

        Ok _ ->
            Nothing

        Err e ->
            Just (Error.toString e)


-- A container's own check: its decoder run on the value in memory, when an
-- inner codec can refuse a value it wrote (`inner`); none otherwise. It takes
-- a Bool, not the inner checks, so no list of functions is rebuilt (doc 14:
-- a mapped list of functions is an adapter site).
hasCheck : List (Value -> Maybe String) -> Bool
hasCheck checks =
    case checks of

        [] ->
            False

        _ ->
            True


checkIf : Bool -> Decoder f -> List (Value -> Maybe String)
checkIf inner dec =
    if inner then
        [ valueCheck dec ]

    else
        []


-- The reason a decoder does not read a value, or `Nothing`.
decodeCheck : Decoder f -> Value -> Maybe String
decodeCheck dec v =
    case decodeWith dec (E.encode 0 v) of

        Ok _ ->
            Nothing

        Err e ->
            Just (Error.toString e)


-- The zeros of a record with `v` in field `name`, decoded: the reason when
-- the zeros decode and the record with `v` does not. A field the zeros do not
-- hold, or zeros that do not decode, cannot be told apart from a bad `v`.
swapError : Decoder a -> String -> Value -> List ( String, Value ) -> Maybe String
swapError dec name v zeros =
    if not (holdsKey name zeros) then
        Nothing

    else
        -- One decode site (`decodeCheck`) for both reads: the kernel's
        -- result is narrowed once (doc 14, R5).
        case decodeCheck dec (E.object zeros) of

            Just _ ->
                Nothing

            Nothing ->
                decodeCheck dec (E.object (swapKey name v zeros))


holdsKey : String -> List ( String, Value ) -> Bool
holdsKey name pairs =
    case pairs of

        [] ->
            False

        ( k, _ ) :: rest ->
            k == name || holdsKey name rest


swapKey : String -> Value -> List ( String, Value ) -> List ( String, Value )
swapKey name v pairs =
    case pairs of

        [] ->
            []

        ( k, old ) :: rest ->
            if k == name then
                ( k, v ) :: rest

            else
                ( k, old ) :: swapKey name v rest


-- | The codec's encoder as a plain function `a -> Value` (a JSON `Value`, the DB
-- backend's write side). Use `toJson` for a JSON string.
toValue : Codec a -> a -> Value
toValue (Codec c) =
    c.enc


-- | Encode to a compact JSON string.
toJson : Codec a -> a -> String
toJson (Codec c) x =
    -- An `auto` codec whose record type has a generated typed codec writes
    -- the text in one pass (`jsn`); every other codec, and a value the
    -- generated codec hands back (a NaN Float), encodes its tree.
    case c.jsn x of

        Just s ->
            s

        Nothing ->
            E.encode 0 (c.enc x)


-- | Decode from a JSON string.
fromJson : Codec a -> String -> Result Error a
fromJson codec s =
    decodeWith (payloadOf codec).dec s


-- A codec's payload. `fromJson` and `fieldReadError` read it here, so the
-- erased payload is narrowed at one site (docs/rust-rewrite/14, R5).
payloadOf : Codec a -> CodecPayload a
payloadOf (Codec c) =
    c


-- The one `D.decodeString` of a codec's decoder: `fromJson`, `fromJsonSafe`
-- and `decodeCheck` share it, so the kernel's result is narrowed at one site
-- (docs/rust-rewrite/14-runtime-narrowing-taxonomy.md, R5).
decodeWith : Decoder a -> String -> Result Error a
decodeWith dec s =
    D.decodeString dec s


-- | Decode from JSON, rejecting input longer than `maxChars` BEFORE parsing —
-- a size guard for UNTRUSTED input (request bodies, webhooks). Parser nesting
-- depth is separately bounded. To avoid mass-assignment, decode into a
-- dedicated input record (only client-settable fields), never straight into a
-- persistence record.
fromJsonSafe : Int -> Codec a -> String -> Result Error a
fromJsonSafe maxChars (Codec c) s =
    if String.length s > maxChars then
        Err (Error.invalidInput "Codec.fromJsonSafe: input exceeds size limit")

    else
        decodeWith c.dec s


-- ── Primitives ───────────────────────────────────────────────────────────────
-- | Codec for a `String` — JSON string; TEXT column.
string : Codec String
string =
    Codec
        { enc = E.string
        , dec = D.string
        , shp = SScalar CText
        , sch = SnType "string"
        , zro = \_ -> Just (E.string "")
        , fzr = \_ -> []
        , fck = \_ -> []
        , vck = []
        , vcs = []
        , jsn = \_ -> Nothing
        , prb = []
        }


-- | Codec for an `Int` — JSON number; INTEGER/BIGINT column.
int : Codec Int
int =
    Codec
        { enc = E.int
        , dec = D.int
        , shp = SScalar CInt
        , sch = SnType "integer"
        , zro = \_ -> Just (E.int 0)
        , fzr = \_ -> []
        , fck = \_ -> []
        , vck = []
        , vcs = []
        , jsn = \_ -> Nothing
        , prb = []
        }


-- | Codec for a `Float` — JSON number; REAL column.
float : Codec Float
float =
    Codec
        { enc = E.float
        , dec = D.float
        , shp = SScalar CReal
        , sch = SnType "number"
        , zro = \_ -> Just (E.float 0.0)
        , fzr = \_ -> []
        , fck = \_ -> []
        , vck = []
        , vcs = []
        , jsn = \_ -> Nothing
        , prb = []
        }


-- | Codec for a `Bool` — JSON boolean; BOOLEAN on Postgres / 0-1 INTEGER on
-- SQLite (a `SqlBool` param binds to either).
bool : Codec Bool
bool =
    Codec
        { enc = E.bool
        , dec = D.bool
        , shp = SScalar CBool
        , sch = SnType "boolean"
        , zro = \_ -> Just (E.bool False)
        , fzr = \_ -> []
        , fck = \_ -> []
        , vck = []
        , vcs = []
        , jsn = \_ -> Nothing
        , prb = []
        }


-- | Codec for a `Std.Decimal` (v0.29.2, opt-in) — an exact decimal column.
--
-- JSON: the canonical string, `"12.5"` (trailing zeros are dropped, so
-- `"12.50"` reads back as `"12.5"`). It reads a string or an exact JSON
-- number under the grammar `-?[0-9]+(\.[0-9]+)?`, at most 1000 characters:
-- an exponent (`"1e3"`), `NaN`, `Infinity`, an empty string and a Float built
-- with `Json.Encode.float` (not exact) are an `Err`.
--
-- Database: a `CDecimal` column, `NUMERIC` on PostgreSQL and `TEXT` holding
-- the canonical text on SQLite, where `Std.Db.Store` orders, compares and
-- sums it exactly (`COLLATE sky_decimal`, `sky_decimal_sum`). Use it through
-- `autoWith`: `Codec.autoWith [ ( "price", Codec.decimal ) ] blank`. A
-- `Codec.auto` Decimal field keeps its JSON-text column in v0.29.
decimal : Codec Decimal
decimal =
    Codec
        { enc = \d -> E.string (Dec.toString d)
        , dec = decimalDecoder
        , shp = SScalar CDecimal
        , sch = SnDecimal
        , zro = \_ -> Just (E.string "0")
        , fzr = \_ -> []
        , fck = \_ -> []
        , vck = [ valueCheck decimalDecoder ]
        , vcs = []
        , jsn = \_ -> Nothing
        , prb = []
        }


decimalFromJsonK : Value -> Result Error Decimal
decimalFromJsonK v =
    Ffi.callPure "Codec_decimalFromJson" [ v ]


moneyFromJsonK : Value -> Result Error Money
moneyFromJsonK v =
    Ffi.callPure "Codec_moneyFromJson" [ v ]


currencyCodeK : String -> Result Error String
currencyCodeK s =
    Ffi.callPure "Codec_currencyCode" [ s ]


decimalDecoder : Decoder Decimal
decimalDecoder =
    D.value
        |> D.andThen
               (\v ->
                   case decimalFromJsonK v of

                       Ok d ->
                           D.succeed d

                       Err e ->
                           D.fail (Error.toString e))


-- | Codec for a `Money` in ONE currency (v0.29.2, opt-in): a decimal column
-- that holds the amount, with the currency fixed by the codec.
--
-- JSON: the amount as a decimal string, `"12.34"`. It also reads the Money
-- object `{"amount": "12.34", "currency": "GBP"}` when its currency is this
-- one. A Money in another currency is never converted, dropped or relabelled:
-- it encodes as the object, a `Std.Db.Store` write refuses it before the
-- statement, and decoding it with this codec is an `Err`.
--
-- Database: a `CDecimal` column (see `decimal`), so a Store sums, orders and
-- compares it: `Codec.autoWith [ ( "price", Codec.moneyIn GBP ) ] blank`.
moneyIn : Currency -> Codec Money
moneyIn cur =
    let
        -- The code is read as `Money.currencyFromCode` reads it: in upper
        -- case, and a code Sky names is its variant, so `CurrencyRaw "gbp"`
        -- is `GBP` and `CurrencyRaw "USDT"` is `USDT` (v0.29.2 fourth Judge).
        given = Mon.currencyCode cur
        canonical = Mon.currencyFromCode given
        code =
            case canonical of

                Just c ->
                    Mon.currencyCode c

                Nothing ->
                    given
        held = Maybe.withDefault cur canonical
        dec = moneyInDecoder held code
    in
        Codec
            { enc =
                \m ->
                    if String.toUpper (Mon.currencyCode (Mon.currency m)) == code then
                        E.string (Dec.toString (Mon.amount m))

                    else
                        moneyObjectValue m
            , dec = dec
            , shp = SScalar (CMoneyIn code)
            , sch = SnDecimal
            , zro = \_ -> Just (E.string "0")
            , fzr = \_ -> []
            , fck = \_ -> []
            , vck = [ valueCheck dec ]
            , vcs = []
            , jsn = \_ -> Nothing
            , prb =
                case canonical of

                    Just _ ->
                        []

                    Nothing ->
                        [ "Codec.moneyIn: \"" ++ given
                              ++ "\" is not a currency code (3 to 10 ASCII letters or digits, as Money.currencyFromCode reads one)"
                        ]
            }


moneyInDecoder : Currency -> String -> Decoder Money
moneyInDecoder cur code =
    D.value
        |> D.andThen
               (\v ->
                   case D.decodeValue (D.field "currency" D.value) v of

                       Ok _ ->
                           case moneyFromJsonK v of

                               Ok m ->
                                   if String.toUpper
                                       (Mon.currencyCode (Mon.currency m))
                                       == code then
                                       D.succeed m

                                   else
                                       D.fail
                                           ("Codec.moneyIn: the value is "
                                               ++ Mon.currencyCode
                                                      (Mon.currency m)
                                               ++ ", and this codec holds "
                                               ++ code)

                               Err e ->
                                   D.fail (Error.toString e)

                       Err _ ->
                           case decimalFromJsonK v of

                               Ok d ->
                                   D.succeed (Money d cur)

                               Err e ->
                                   D.fail (Error.toString e))


moneyObjectValue : Money -> Value
moneyObjectValue m =
    E.object
        [ ( "amount", E.string (Dec.toString (Mon.amount m)) )
        , ( "currency", E.string (Mon.currencyCode (Mon.currency m)) )
        ]


-- | Codec for a `Money` in any currency (v0.29.2): the JSON object
-- `{"amount": "12.34", "currency": "GBP"}`, the same JSON `Codec.auto`
-- writes for a Money field, in a JSON (blob) column. Both keys are required;
-- the currency is read in upper case (`"gbp"` is `GBP`) and the amount is a
-- strict decimal (see `decimal`). The column cannot be summed or ordered: for
-- that, store one currency with `moneyIn`.
moneyObject : Codec Money
moneyObject =
    Codec
        { enc = moneyObjectValue
        , dec = moneyObjectDecoder
        , shp = SBlob
        , sch =
            SnObject
                [ ( "amount", SnDecimal ), ( "currency", SnType "string" ) ]
        , zro = \_ -> Nothing
        , fzr = \_ -> []
        , fck = \_ -> []
        , vck = [ valueCheck moneyObjectDecoder ]
        , vcs = []
        , jsn = \_ -> Nothing
        , prb = []
        }


-- | Codec for a `Currency` (v0.29.2): its ISO code as a JSON string,
-- `"GBP"`, in a text column. It reads a code of 3 to 10 letters or digits in
-- any case (`"gbp"` is `GBP`); a code Sky does not name is `CurrencyRaw`.
isoCurrency : Codec Currency
isoCurrency =
    Codec
        { enc = \c -> E.string (Mon.currencyCode c)
        , dec = isoCurrencyDecoder
        , shp = SScalar CText
        , sch = SnType "string"
        , zro = \_ -> Nothing
        , fzr = \_ -> []
        , fck = \_ -> []
        , vck = [ valueCheck isoCurrencyDecoder ]
        , vcs = []
        , jsn = \_ -> Nothing
        , prb = []
        }


-- The reader of `moneyObject`: one decode site for the codec and its write
-- check.
moneyObjectDecoder : Decoder Money
moneyObjectDecoder =
    D.value
        |> D.andThen
               (\v ->
                   case moneyFromJsonK v of

                       Ok m ->
                           D.succeed m

                       Err e ->
                           D.fail (Error.toString e))


-- The reader of `isoCurrency`, shared by the codec and its write check.
isoCurrencyDecoder : Decoder Currency
isoCurrencyDecoder =
    D.string
        |> D.andThen
               (\s ->
                   case currencyCodeK s of

                       Ok code ->
                           case Mon.currencyFromCode code of

                               Just c ->
                                   D.succeed c

                               Nothing ->
                                   D.fail ("not a currency code: " ++ code)

                       Err e ->
                           D.fail (Error.toString e))


-- | Codec for a raw `Json.Value` (v0.29.2): the JSON as it is, both ways, so
-- a field of `List Json.Value` or `Dict String Json.Value` has a codec
-- without a blank to mark it: `Codec.list Codec.value`,
-- `Codec.dict Codec.string Codec.value`, or an `autoWith` override. Any JSON
-- reads; the value written is the value read. Database: a JSON TEXT column.
-- Its JSON Schema is the open `{}` (not exact). Its zero is `null`.
value : Codec Value
value =
    Codec
        { enc = \v -> v
        , dec = D.value
        , shp = SBlob
        , sch = SnOpen
        , zro = \_ -> Just E.null
        , fzr = \_ -> []
        , fck = \_ -> []
        , vck = []
        , vcs = []
        , jsn = \_ -> Nothing
        , prb = []
        }


-- ── Combinators ──────────────────────────────────────────────────────────────
-- | Optional value. `Nothing` encodes as JSON `null`, and only `null` decodes
-- as `Nothing`. Any other value must decode as the inner value: one that does
-- not is an `Err` naming where it failed (`"x"` for a `Maybe Int`, a name
-- that is not one of an enum's), never a silent `Nothing`. This holds at any
-- depth, so a `List (Maybe a)` with a bad element fails as a whole. A field
-- of a `buildObject` codec must be present in the JSON object even when it is
-- a `maybe` (`null` for `Nothing`). A `Maybe scalar` stays a (nullable) scalar column;
-- anything deeper becomes a nullable blob column, so `Nothing` stores as NULL.
-- A `Maybe (Maybe a)` is the same one nullable column as `Maybe a`. JSON has
-- one `null`, so `Just Nothing` (and `Just Json.Encode.null` of a
-- `maybe value`) has no JSON of its own: `toJson` writes it as `null`, which
-- reads back as `Nothing`, and a `Std.Db.Store` write refuses the row (since
-- v0.29.2) rather than store a value that reads back as another. A stored
-- NULL reads as `Nothing`, as before.
maybe : Codec a -> Codec (Maybe a)
maybe c =
    maybeWith False c


-- `maybe`, and with `lenient` the `Error` details' decoder (`detailsCodec`):
-- there, and only there, a value the inner codec does not read is `Nothing`.
maybeWith : Bool -> Codec a -> Codec (Maybe a)
maybeWith lenient (Codec c) =
    let
        -- The inner codec can write JSON null (a `maybe`, `value`), so
        -- `Just x` can be written as the null `Nothing` is (v0.29.2 sixth
        -- Judge): such a `Just` is written as a value every reader refuses
        -- (`justNullK`, JSON text `null`), and the Store write check refuses
        -- the row. Any other inner codec keeps the plain path.
        nul =
            case c.sch of

                SnNullable _ ->
                    True

                SnOpen ->
                    True

                _ ->
                    False
        inner =
            if nul then
                refuseJustNullK c.dec

            else
                c.dec
    in
        Codec
            { enc =
                \m ->
                    case m of

                        Just x ->
                            if nul then
                                justNullK (c.enc x)

                            else
                                c.enc x

                        Nothing ->
                            E.null
            , dec =
                if lenient then
                    D.oneOf [ D.nullable inner, D.succeed Nothing ]

                else
                    D.nullable inner
            , shp =
                case c.shp of

                    SScalar (CNull t) ->
                        SScalar (CNull t)

                    SScalar t ->
                        SScalar (CNull t)

                    _ ->
                        SScalar (CNull CBlob)
            , sch = SnNullable c.sch
            , zro = \_ -> Just E.null
            , fzr = \_ -> []
            , fck = \_ -> []
            , vck = checkIf (nul || hasCheck c.vck) (D.nullable inner)
            , vcs = []
            , jsn = \_ -> Nothing
            , prb = c.prb
            }


-- | Codec for a `List a` given a codec for `a` — JSON array; stored as a JSON
-- TEXT blob column on the DB side.
list : Codec a -> Codec (List a)
list (Codec c) =
    Codec
        { enc = E.list c.enc
        , dec = D.list c.dec
        , shp = SBlob
        , sch = SnArray c.sch
        , zro = \_ -> Just (E.list identity [])
        , fzr = \_ -> []
        , fck = \_ -> []
        , vck = checkIf (hasCheck c.vck) (D.list c.dec)
        , vcs = []
        , jsn = \_ -> Nothing
        , prb = c.prb
        }


-- | Codec for a `Result e a` given codecs for the error and the value. Encodes
-- as a tagged JSON array — `Ok x` -> `["Ok", <x>]`, `Err e` -> `["Err", <e>]` —
-- symmetric with `taggedUnion`; stored as a JSON TEXT blob on the DB side. This
-- lets a `Result Error String` (a common `Cmd.perform … Sent` message payload)
-- cross a wire with no hand-written codec.
result : Codec e -> Codec a -> Codec (Result e a)
result (Codec ce) (Codec ca) =
    let
        dec =
            D.andThen
                (\tag ->
                    if tag == "Ok" then
                        D.map Ok (D.index 1 ca.dec)

                    else
                        D.map Err (D.index 1 ce.dec))
                (D.index 0 D.string)
    in
        Codec
            { enc =
                \r ->
                    case r of

                        Ok a ->
                            E.list identity [ E.string "Ok", ca.enc a ]

                        Err e ->
                            E.list identity [ E.string "Err", ce.enc e ]
            , dec = dec
            , shp = SBlob
            , sch = SnResult ce.sch ca.sch
            , zro = \_ -> Nothing
            , fzr = \_ -> []
            , fck = \_ -> []
            , vck = checkIf (hasCheck ce.vck || hasCheck ca.vck) dec
            , vcs = []
            , jsn = \_ -> Nothing
            , prb = ce.prb ++ ca.prb
            }


-- | Codec for a `Dict k v` given codecs for the key and the value. Encodes as a
-- JSON array of `[key, value]` pairs in key order, so any comparable key type
-- round-trips (a JSON object could hold only `String` keys); stored as a JSON
-- TEXT blob on the DB side. A Sky.Spa model or message field of type
-- `Dict k v` crosses the wire through it with no hand-written codec.
dict : Codec comparable -> Codec v -> Codec (Dict comparable v)
dict (Codec ck) (Codec cv) =
    Codec
        { enc =
            \d ->
                E.list
                    (\( k, v ) -> E.list identity [ ck.enc k, cv.enc v ])
                    (Dict.toList d)
        , dec =
            D.map
                Dict.fromList
                (D.list
                    (D.map2
                        (\k v -> ( k, v ))
                        (D.index 0 ck.dec)
                        (D.index 1 cv.dec)))
        , shp = SBlob
        , sch = SnDict ck.sch cv.sch
        , zro = \_ -> Just (E.list identity [])
        , fzr = \_ -> []
        , fck = \_ -> []
        , vck =
            checkIf
                (hasCheck ck.vck || hasCheck cv.vck)
                (D.list
                    (D.map2 (\_ _ -> ()) (D.index 0 ck.dec) (D.index 1 cv.dec)))
        , vcs = []
        , jsn = \_ -> Nothing
        , prb = ck.prb ++ cv.prb
        }


-- | The canonical codec for the stdlib `Error` type — the ONE wire contract for
-- an `Error` value, so a `Result Error a` (or any `Error`-carrying message) can
-- serialise across the Sky.Spa RPC boundary out of the box. It is written by
-- hand (not `auto`): `Error` is a data-carrying ADT, and the reflection decoder
-- cannot rebuild a top-level data-carrying ADT, so `auto` would encode but not
-- decode it. The hand-written arms cover every `ErrorKind` tag and every
-- `ErrorDetails` variant, and round-trip losslessly.
--
-- Logging stays a server effect (`Std.Log`), so crossing the wire does not leak
-- handling; an app controls client-side handling via `App.withRpcError`.
error : Codec Error
error =
    taggedUnion
        (\e ->
            case e of

                Error.Error kind info ->
                    ( "Error"
                    , [ toValue errorKindCodec kind
                      , toValue errorInfoCodec info
                      ]
                    ))
        [ var2 "Error" Error.Error errorKindCodec errorInfoCodec ]


errorKindCodec : Codec Error.ErrorKind
errorKindCodec =
    enum
        [ ( Error.Io, "Io" )
        , ( Error.Network, "Network" )
        , ( Error.Ffi, "Ffi" )
        , ( Error.Decode, "Decode" )
        , ( Error.Timeout, "Timeout" )
        , ( Error.NotFound, "NotFound" )
        , ( Error.PermissionDenied, "PermissionDenied" )
        , ( Error.InvalidInput, "InvalidInput" )
        , ( Error.Conflict, "Conflict" )
        , ( Error.Unavailable, "Unavailable" )
        , ( Error.Unexpected, "Unexpected" )
        ]


errorInfoCodec : Codec Error.ErrorInfo
errorInfoCodec =
    object Error.ErrorInfo |> field "message" .message string
        |> field "details" .details detailsCodec
        |> buildObject


-- The `details` of an `Error` on the wire, the one place a value `maybe` does
-- not read is `Nothing` on purpose: details are a diagnostic attachment, and
-- a variant a later release adds (or a payload this release cannot read)
-- reads as no details, so an `Error` from a newer peer keeps its kind and
-- message, which stay strict.
detailsCodec : Codec (Maybe Error.ErrorDetails)
detailsCodec =
    maybeWith True errorDetailsCodec


panicInfoCodec : Codec Error.PanicInfo
panicInfoCodec =
    object Error.PanicInfo |> field "message" .message string
        |> field "stack" .stack (list string)
        |> buildObject


typeInfoCodec : Codec Error.TypeInfo
typeInfoCodec =
    object Error.TypeInfo |> field "expected" .expected string
        |> field "actual" .actual string
        |> buildObject


errorDetailsCodec : Codec Error.ErrorDetails
errorDetailsCodec =
    taggedUnion
        (\d ->
            case d of

                Error.FfiPanic p ->
                    ( "FfiPanic", [ toValue panicInfoCodec p ] )

                Error.TypeMismatch t ->
                    ( "TypeMismatch", [ toValue typeInfoCodec t ] )

                Error.HttpStatus n ->
                    ( "HttpStatus", [ toValue int n ] )

                Error.JsonDecode s ->
                    ( "JsonDecode", [ toValue string s ] )

                Error.Custom s ->
                    ( "Custom", [ toValue string s ] )

                Error.Domain f ->
                    ( "Domain", [ toValue domainFailureCodec f ] ))
        [ var1 "FfiPanic" Error.FfiPanic panicInfoCodec
        , var1 "TypeMismatch" Error.TypeMismatch typeInfoCodec
        , var1 "HttpStatus" Error.HttpStatus int
        , var1 "JsonDecode" Error.JsonDecode string
        , var1 "Custom" Error.Custom string
        , var1 "Domain" Error.Domain domainFailureCodec
        ]


-- | The wire form of a domain failure: one JSON object,
-- `{"domain", "code", "retryable", "retryAfterMs", "attrs": [[k, v], …]}`.
-- Decoding is forward-compatible: `domain` and `code` are required, a missing
-- `retryable` is `false`, a missing or null `retryAfterMs` is no delay, a
-- missing `attrs` is none, and keys a later release adds are ignored. Any
-- domain and any code decode, so a failure from a newer peer survives the wire
-- with its kind, message, code and retry flag.
domainFailureCodec : Codec Error.DomainFailure
domainFailureCodec =
    Codec
        { enc =
            \f ->
                E.object
                    [ ( "domain", E.string (Error.failureDomain f) )
                    , ( "code", E.string (Error.failureCode f) )
                    , ( "retryable", E.bool (Error.failureRetryable f) )
                    , ( "retryAfterMs"
                      , case Error.failureRetryAfter f of

                            Just ms ->
                                E.int ms

                            Nothing ->
                                E.null
                      )
                    , ( "attrs"
                      , E.list
                            (\( k, v ) -> E.list E.string [ k, v ])
                            (Error.failureAttrs f)
                      )
                    ]
        , dec =
            D.map5
                buildDomainFailure
                (D.field "domain" D.string)
                (D.field "code" D.string)
                (D.oneOf [ D.field "retryable" D.bool, D.succeed False ])
                (D.oneOf
                    [ D.map Just (D.field "retryAfterMs" D.int)
                    , D.succeed Nothing
                    ])
                (D.oneOf
                    [ D.field
                          "attrs"
                          (D.list
                              (D.map2
                                  (\k v -> ( k, v ))
                                  (D.index 0 D.string)
                                  (D.index 1 D.string)))
                    , D.succeed []
                    ])
        , shp = SBlob
        , sch = SnOpen
        , zro = \_ -> Nothing
        , fzr = \_ -> []
        , fck = \_ -> []
        , vck = []
        , vcs = []
        , jsn = \_ -> Nothing
        , prb = []
        }


buildDomainFailure : String -> String -> Bool -> Maybe Int -> List ( String, String ) -> Error.DomainFailure
buildDomainFailure dom code retry after attrs =
    let
        base = Error.failure dom code |> Error.withRetryable retry
        timed =
            case after of

                Just ms ->
                    Error.withRetryAfter ms base

                Nothing ->
                    base
    in
        List.foldl (\( k, v ) acc -> Error.withAttr k v acc) timed attrs


-- | Adapt a codec to another type via a bijection (`to` on decode, `from` on
-- encode). Useful for newtype-style wrappers.
map : (a -> b) -> (b -> a) -> Codec a -> Codec b
map to from (Codec c) =
    Codec
        { enc = \b -> c.enc (from b)
        , dec = D.map to c.dec
        , shp = c.shp
        , sch = c.sch
        , zro = c.zro
        , fzr = c.fzr
        , fck = c.fck
        , vck = c.vck
        , vcs = c.vcs
        , jsn = \_ -> Nothing
        , prb = c.prb
        }

-- ── Records (object builder) ─────────────────────────────────────────────────
-- | Intermediate builder for a record codec. `a` is the record type; `b` is the
-- constructor still awaiting fields.
--
-- The payload is a named record, so a function that matches an
-- `ObjectCodec` reads it with one runtime narrowing instead of one per field
-- (doc 14 §4.5, R6), as `CodecPayload` does.
type ObjectCodec a b
    = ObjectCodec (ObjectPayload a b)

type alias ObjectPayload a b =
    { encFields : a -> List ( String, Value )
    , decValue : Decoder b
    , cols : List ( String, ColType )
    , schs : List ( String, SchemaNode )
    , zros : List ( String, () -> Maybe Value )
    , fcks : List ( String, Value -> Maybe String )
    , vcks : List ( String, Value -> Maybe String )
    , oprb : List String
    }


-- Each check paired with the field name, by typed recursion (no lambda over
-- a list of functions, which would be narrowed per element, doc 14).
namedChecks : String -> List (Value -> Maybe String) -> List ( String, Value -> Maybe String )
namedChecks name checks =
    case checks of

        [] ->
            []

        chk :: rest ->
            ( name, chk ) :: namedChecks name rest


-- | Start a record codec from its constructor.
object : b -> ObjectCodec a b
object ctor =
    ObjectCodec
        { encFields = \_ -> []
        , decValue = D.succeed ctor
        , cols = []
        , schs = []
        , zros = []
        , fcks = []
        , vcks = []
        , oprb = []
        }


-- | Add a field: its JSON key, a getter, and the field's codec.
field : String -> (a -> f) -> Codec f -> ObjectCodec a (f -> b) -> ObjectCodec a b
field name getter (Codec fc) (ObjectCodec o) =
    ObjectCodec
        { encFields =
            \rec -> o.encFields rec ++ [ ( name, fc.enc (getter rec) ) ]
        , decValue = codecAndMap (D.field name fc.dec) o.decValue
        , cols = o.cols ++ [ ( name, colTypeOf fc.shp ) ]
        , schs = o.schs ++ [ ( name, fc.sch ) ]
        , zros = o.zros ++ [ ( name, fc.zro ) ]
        , fcks = o.fcks ++ [ ( name, decodeCheck fc.dec ) ]
        , vcks = o.vcks ++ namedChecks name fc.vck
        , oprb = o.oprb ++ fc.prb
        }


-- | Add every field of another record's object builder to this one, flat:
-- the embedded record's JSON keys sit inline, in their order, beside this
-- record's own fields (no nested object). `getter` reads the embedded record.
-- Keys must not repeat across the two records: `buildObject` gives a
-- codec with a repeated key a decoder that fails (see `buildObject`).
--
--     pointFields : ObjectCodec Point Point
--     pointFields =
--         Codec.object Point
--             |> Codec.field "x" .x Codec.int
--             |> Codec.field "y" .y Codec.int
--
--     pinCodec : Codec Pin
--     pinCodec =
--         Codec.object Pin
--             |> Codec.inline .at pointFields
--             |> Codec.field "label" .label Codec.string
--             |> Codec.buildObject
--
--     -- { at = { x = 1, y = 2 }, label = "a" } encodes as {"x":1,"y":2,"label":"a"}
inline : (a -> r) -> ObjectCodec r r -> ObjectCodec a (r -> b) -> ObjectCodec a b
inline getter (ObjectCodec inner) (ObjectCodec o) =
    ObjectCodec
        { encFields = \rec -> o.encFields rec ++ inner.encFields (getter rec)
        , decValue = codecAndMap inner.decValue o.decValue
        , cols = o.cols ++ inner.cols
        , schs = o.schs ++ inner.schs
        , zros = o.zros ++ inner.zros
        , fcks = o.fcks ++ inner.fcks
        , vcks = o.vcks ++ inner.vcks
        , oprb = o.oprb ++ inner.oprb
        }


-- | Finish a record codec.
--
-- Each field needs its own JSON key. When two fields (or an inlined record and
-- the record around it) share a key, decoding cannot tell them apart, so the
-- codec's decoder fails with an `Err` naming the key rather than read one
-- value into both fields. Encoding is unchanged: it writes both pairs. It is
-- also a builder problem (`problems`), so `Std.Db.Store.fromCodec` refuses the
-- store.
buildObject : ObjectCodec a a -> Codec a
buildObject (ObjectCodec o) =
    Codec
        { enc = \rec -> E.object (o.encFields rec)
        , dec = objectDecoder o.cols o.decValue
        , shp = SRecord o.cols
        , sch = SnObject o.schs
        , zro = \_ -> Maybe.map E.object (allZeros o.zros)
        , fzr = \_ -> presentZeros o.zros
        , fck = \_ -> o.fcks
        , vck =
            case o.vcks of

                [] ->
                    []

                _ ->
                    [ valueCheck (objectDecoder o.cols o.decValue) ]
        , vcs = o.vcks
        , jsn = \_ -> Nothing
        , prb =
            o.oprb
                ++ (case repeatedKey o.cols o.cols of

                       Just key ->
                           [ "Codec.buildObject: the JSON key \"" ++ key
                                 ++ "\" is used by two fields of one record codec, so it never decodes; give each field its own key"
                           ]

                       Nothing ->
                           [])
        }


-- Every field's zero value, or `Nothing` when one field has none. A partial
-- object would not decode (`D.field` is strict), so it is never a zero.
allZeros : List ( String, () -> Maybe Value ) -> Maybe (List ( String, Value ))
allZeros zros =
    case zros of

        [] ->
            Just []

        ( name, z ) :: rest ->
            case z () of

                Just v ->
                    Maybe.map (\vs -> ( name, v ) :: vs) (allZeros rest)

                Nothing ->
                    Nothing


-- The zero of each field that has one, in field order. A field with no zero
-- is left out: unlike `allZeros`, one such field does not hide the others.
presentZeros : List ( String, () -> Maybe Value ) -> List ( String, Value )
presentZeros zros =
    case zros of

        [] ->
            []

        ( name, z ) :: rest ->
            case z () of

                Just v ->
                    ( name, v ) :: presentZeros rest

                Nothing ->
                    presentZeros rest


-- Each column's value in the encoded witness of an `auto` codec, in column
-- order. A column the witness does not hold is left out.
witnessZeros : List ( String, String ) -> Value -> List ( String, Value )
witnessZeros cols witness =
    case cols of

        [] ->
            []

        ( name, _ ) :: rest ->
            case D.decodeValue (D.field name D.value) witness of

                Ok v ->
                    -- A blank's `Just Json.Encode.null` (a natural `Maybe
                    -- Json.Value` blank) is a plain null here: the zeros fill
                    -- the other columns of a write check, and must read.
                    ( name, plainNullK v ) :: witnessZeros rest witness

                Err _ ->
                    witnessZeros rest witness


-- | A record codec's decoder: `dec`, or a decoder that always fails when two
-- of the codec's keys are the same. Checked once, when the codec is built.
objectDecoder : List ( String, ColType ) -> Decoder a -> Decoder a
objectDecoder cols dec =
    case repeatedKey cols cols of

        Just key ->
            D.fail
                ("Codec.buildObject: the JSON key \"" ++ key
                    ++ "\" is used by two fields of one record codec; give each field its own key")

        Nothing ->
            dec


-- | The first key in `cols` (read in order) that an earlier column already
-- used, if any. `all` is the whole column list and `cols` a suffix of it: a
-- key occurs before `cols` exactly when it occurs more often in `all` than in
-- `cols`.
--
-- Written as plain recursion over the typed column list, with no `Dict` and no
-- `::` accumulator: the Dict and List kernels return Go `any`, and every
-- record codec in an app would then carry runtime narrowings for a check that
-- needs none (docs/rust-rewrite/14-runtime-narrowing-taxonomy.md, R5).
repeatedKey : List ( String, ColType ) -> List ( String, ColType ) -> Maybe String
repeatedKey all cols =
    case cols of

        [] ->
            Nothing

        ( key, _ ) :: rest ->
            if keyCount key all 0 > keyCount key cols 0 then
                Just key

            else
                repeatedKey all rest


-- | How many columns in `cols` use `key`, added to `n`.
keyCount : String -> List ( String, ColType ) -> Int -> Int
keyCount key cols n =
    case cols of

        [] ->
            n

        ( k, _ ) :: rest ->
            if k == key then
                keyCount key rest (n + 1)

            else
                keyCount key rest n


-- ── Derivation ───────────────────────────────────────────────────────────────
-- | Derive a codec from a record type — no field-by-field pipeline. The
-- argument is a zero-value witness (a `blank` record) that names the type.
-- Since v0.29.9 the compiler generates a typed encoder and decoder when the
-- type is a record of `Bool`, `Int`, `Float`, `String`, enums, records,
-- `Maybe`, `List`, `Dict String` and `Dict Int` (any depth). Any other record
-- uses reflection. The JSON text, the value and every error are the same. Handles scalars, `Maybe` (↔ null), nested records,
-- lists, and nullary enums (stored as their readable name).
--
-- A custom type with data is written as `{"tag":"Circle","v0":2.5}` and read
-- back by each variant's own payload types (v0.29.2): a `String`, `Int`,
-- `Float`, `Bool`, `Char`, an enum, a record, another such custom type, or a
-- `Maybe`, `List` or `Dict` of them. A payload whose type the generated code
-- does not keep inside a variant (a `Decimal`, `Money` or `Currency`, a
-- `Json.Value`, a type variable) cannot be read back: the field is a builder
-- problem (`problems`; `Std.Db.Store.fromCodec` refuses the store) and its
-- read is an `Err`. Give such a field an explicit `taggedUnion` codec through
-- `autoWith [ ( "shape", shapeCodec ) ] blank`. Two fields that become one
-- key (`aB` and `a_b` are both `a_b`) are a builder problem too, in the record
-- and in any record it holds (a nested record, a `List`, `Maybe` or `Dict` of
-- records, a variant's payload).
--
-- A `Json.Value` field carries any JSON. The blank marks it: give the field a
-- JSON value (`data = Json.Encode.null`), and a `Maybe Json.Value` field a
-- `Just` one (`more = Just Json.Encode.null`). A `List Json.Value` or `Dict
-- String Json.Value` field is marked by its first element (`items = [
-- Json.Encode.null ]`, v0.29.2). A field the blank does not mark this way, at
-- any depth (`items = []`, `Dict.empty`, `more = Nothing`), is a builder
-- problem (`problems`; `Std.Db.Store.fromCodec` refuses the store): a value
-- written there could not be read back. A `Just` written as null (`Just
-- Nothing` of a `Maybe (Maybe a)`, `Just Json.Encode.null`) has no JSON of its
-- own: a `Std.Db.Store` write refuses it, wherever the `Maybe` is (a `List`, a
-- record, a `Dict` value, a variant's payload).
--
-- Columns / JSON keys are **snake_case** (the DB convention): a record field
-- `priceMinor` maps to column `price_minor` with no hand-written codec. For a
-- custom per-column name (camelCase, an abbreviation, a legacy column) use an
-- explicit `Codec.object` / `Codec.field "col" .field …` codec.
--
--     userCodec : Codec User
--     userCodec = Codec.auto blankUser
auto : a -> Codec a
auto witness =
    autoBase True witness


-- | Like `auto`, but keeps camelCase column / JSON-key names (`priceMinor` stays
-- `priceMinor`) — for a camelCase schema or API. `auto` (snake_case) is the
-- default; per-column control still uses an explicit `Codec.field`.
autoCamel : a -> Codec a
autoCamel witness =
    autoBase False witness


autoBase : Bool -> a -> Codec a
autoBase snake witness =
    let
        -- Read once: `shp` and `fzr` share the witness's columns, so the
        -- kernel's result is narrowed at one site.
        cols = autoColsK snake witness
        dec = autoDecoderK snake witness
        -- The columns whose field type holds a Decimal or a Money, marked
        -- `|check` in their kind by the runtime: the partial ones (v0.29.2
        -- fifth Judge). `[]` for most records, which then pay no check on a
        -- write.
        checks = autoChecks dec (\_ -> autoEncK snake witness) cols
    in
        Codec
            { enc = \r -> autoEncK snake r
            , dec = dec
            , shp =
                SRecord (List.map (\( n, k ) -> ( n, kindToColType k )) cols)
            , sch = SnAuto (\_ -> autoSchemaK snake witness) []
            , zro = \_ -> Just (autoEncK snake witness)
            , fzr = \_ -> witnessZeros cols (autoEncK snake witness)
            , fck = \_ -> []
            , vck =
                case checks of

                    [] ->
                        []

                    _ ->
                        [ valueCheck dec ]
            , vcs = checks
            , jsn = \r -> autoJsonK snake r
            , prb = colProblems cols
            }


-- | Like `auto`, but OVERRIDE the codec for named columns — auto-derive everything
-- from the witness EXCEPT the listed fields, which use the given codec. The escape
-- hatch for a single field whose auto-derivation is wrong (a `Bool` stored as 0/1,
-- an enum with a custom wire format) without hand-writing the whole record codec:
--
--     intBool = Codec.map (\i -> i /= 0) (\b -> if b then 1 else 0) Codec.int
--     productCodec = Codec.autoWith [ ( "active", intBool ) ] productBlank
--
-- The overrides share one type (`Codec b`); mixed-type overrides need an explicit
-- `Codec.object`. Column names are snake_case (as `auto`). A key is the
-- column (`"price_list"`) or the record field (`"priceList"`), v0.29.2. A key
-- that is neither is never ignored: the codec's decoder fails naming the keys
-- it takes, and `Std.Db.Store.fromCodec` refuses the store (`problems`). Two
-- keys that name one column (`"price_list"` and `"priceList"`, or one key
-- given twice) are the same kind of error, naming both keys: one override
-- would otherwise be dropped with no sign.
autoWith : List ( String, Codec b ) -> a -> Codec a
autoWith overrides witness =
    let
        -- ( record field, column ) of each field, in field order.
        names =
            List.map2
                (\( field, _ ) ( col, _ ) -> ( field, col ))
                (autoColsK False witness)
                (autoColsK True witness)
        known =
            List.filterMap
                (\( key, Codec c ) ->
                    Maybe.map (\col -> ( col, c )) (overrideColumn names key))
                overrides
        unknown =
            List.filterMap
                (\( key, _ ) ->
                    case overrideColumn names key of

                        Just _ ->
                            Nothing

                        Nothing ->
                            Just key)
                overrides
        -- ( key, column ) of each key that names a column.
        keyed =
            List.filterMap
                (\( key, _ ) ->
                    Maybe.map (\col -> ( key, col )) (overrideColumn names key))
                overrides
        -- Two keys naming one column ("price_list" and "priceList", or one
        -- key twice) kept one override and dropped the other with no error
        -- (v0.29.2 fifth Judge). It is a builder problem naming both keys.
        repeated =
            case repeatedOverride keyed of

                Just ( first, second, col ) ->
                    [ "Codec.autoWith: the keys \"" ++ first ++ "\" and \""
                          ++ second
                          ++ "\" both name the column \""
                          ++ col
                          ++ "\", so one override would be dropped; give each field one override"
                    ]

                Nothing ->
                    []
        problems =
            List.concatMap (\( _, c ) -> c.prb) known
                ++ List.map (unknownOverrideKey names) unknown
                ++ repeated
                ++ colProblems cols
        encs = List.map (\( col, c ) -> ( col, c.enc )) known
        decs = List.map (\( col, c ) -> ( col, c.dec )) known
        shps = List.map (\( col, c ) -> ( col, c.shp )) known
        cols = autoColsWith True shps witness
        -- The override columns' own checks, then the auto columns that are
        -- partial and not overridden (`autoBase`).
        checks =
            List.concatMap
                (\( col, c ) -> List.map (\chk -> ( col, chk )) c.vck)
                known
                ++ autoChecks
                       dec
                       (\_ -> autoEncOverridesK True encs witness)
                       cols
        dec =
            if List.isEmpty unknown && List.isEmpty repeated then
                autoDecoderOverridesK True decs witness

            else
                D.fail (String.join "; " problems)
    in
        Codec
            { enc = \r -> autoEncOverridesK True encs r
            , dec = dec
            , shp =
                SRecord (List.map (\( n, k ) -> ( n, kindToColType k )) cols)
            , sch =
                SnAuto
                    (\_ -> autoSchemaK True witness)
                    (List.map (\( col, c ) -> ( col, c.sch )) known)
            , zro = \_ -> Just (autoEncOverridesK True encs witness)
            , fzr =
                \_ -> witnessZeros cols (autoEncOverridesK True encs witness)
            , fck = \_ -> []
            , vck =
                case checks of

                    [] ->
                        []

                    _ ->
                        [ valueCheck dec ]
            , vcs = checks
            , jsn = \_ -> Nothing
            , prb = problems
            }


-- The builder problems the runtime found in an auto record's columns (a
-- flag `|problem=<sentence>` on a column's kind, `Codec_autoCols`): a field
-- whose type the codec cannot read back (a variant carrying a Decimal), two
-- fields named by one column (`aB` and `a_b`). An overridden column has its
-- override's kind, so its problem is gone with it.
colProblems : List ( String, String ) -> List String
colProblems cols =
    -- Typed recursion, so no kernel result is narrowed (doc 14).
    case cols of

        [] ->
            []

        ( _, kind ) :: rest ->
            flagProblems (List.drop 1 (String.split "|" kind))
                ++ colProblems rest


flagProblems : List String -> List String
flagProblems flags =
    case flags of

        [] ->
            []

        flag :: rest ->
            if String.startsWith "problem=" flag then
                String.dropLeft 8 flag :: flagProblems rest

            else
                flagProblems rest


-- The first two keys of `keyed` (each ( key, column )) that name one column,
-- with the column.
repeatedOverride : List ( String, String ) -> Maybe ( String, String, String )
repeatedOverride keyed =
    case keyed of

        [] ->
            Nothing

        ( key, col ) :: rest ->
            case List.head (List.filter (\( _, c ) -> c == col) rest) of

                Just ( other, _ ) ->
                    Just ( key, other, col )

                Nothing ->
                    repeatedOverride rest


-- The write checks of an auto codec's partial columns (a kind the runtime
-- marked `|check`, `Codec_autoCols`), by column: the codec's own reader of
-- its blank record with the written value in that column. An overridden
-- column has its override's kind, so it is checked by the override's own
-- codec instead. Typed recursion, so no list of functions is mapped, and no
-- kernel is called (doc 14).
autoChecks : Decoder a -> (() -> Value) -> List ( String, String ) -> List ( String, Value -> Maybe String )
autoChecks dec blank cols =
    -- The blank is encoded only when a column is partial: an `autoWith`
    -- blank of another type than its override (`{ f = 0 }` with a
    -- `Codec.decimal` override) does not encode, and must not fail a codec
    -- that has nothing to check.
    if anyChecked cols then
        autoChecksWith dec (witnessZeros cols (blank ())) cols

    else
        []


anyChecked : List ( String, String ) -> Bool
anyChecked cols =
    case cols of

        [] ->
            False

        ( _, kind ) :: rest ->
            String.contains "|check" kind || anyChecked rest


autoChecksWith : Decoder a -> List ( String, Value ) -> List ( String, String ) -> List ( String, Value -> Maybe String )
autoChecksWith dec zeros cols =
    case cols of

        [] ->
            []

        ( col, kind ) :: rest ->
            if String.contains "|check" kind then
                ( col, autoSwapCheck dec zeros col )
                    :: autoChecksWith dec zeros rest

            else
                autoChecksWith dec zeros rest


autoSwapCheck : Decoder a -> List ( String, Value ) -> String -> Value -> Maybe String
autoSwapCheck dec zeros col v =
    valueCheck dec (E.object (swapKey col v zeros))


-- The column an `autoWith` key names: a column first, then a record field
-- (`names` holds each ( field, column )).
overrideColumn : List ( String, String ) -> String -> Maybe String
overrideColumn names key =
    if List.any (\( _, col ) -> col == key) names then
        Just key

    else
        List.head
            (List.filterMap
                (\( field, col ) ->
                    if field == key then
                        Just col

                    else
                        Nothing)
                names)


unknownOverrideKey : List ( String, String ) -> String -> String
unknownOverrideKey names key =
    "Codec.autoWith: the key \"" ++ key
        ++ "\" names no field of the record, so its codec would be ignored. A key is a column or a record field: "
        ++ String.join
               ", "
               (List.map
                   (\( field, col ) ->
                       if field == col then
                           col

                       else
                           col ++ " (" ++ field ++ ")")
                   names)


-- | Auto columns with each override column's kind replaced from its codec's shape.
autoColsWith : Bool -> List ( String, Shape ) -> a -> List ( String, String )
autoColsWith snake shps witness =
    List.map
        (\( col, kind ) ->
            case lookupShape col shps of

                Just shp ->
                    ( col, shapeKind shp )

                Nothing ->
                    ( col, kind ))
        (autoColsK snake witness)


lookupShape : String -> List ( String, Shape ) -> Maybe Shape
lookupShape col shps =
    case shps of

        [] ->
            Nothing

        ( c, s ) :: rest ->
            if c == col then
                Just s

            else
                lookupShape col rest


shapeKind : Shape -> String
shapeKind shp =
    case shp of

        SScalar ct ->
            colTypeKind ct

        SRecord _ ->
            "blob"

        SBlob ->
            "blob"


-- The colspec kind of a column type: `text`, `decimal|money=GBP`, `int?`.
-- Read by the runtime (`rt.Codec_colTypeKind`), so a build pays no runtime
-- narrowing per `ColType` payload.
colTypeKind : ColType -> String
colTypeKind =
    Ffi.kernel "Codec_colTypeKind"


autoEncK : Bool -> a -> Value
autoEncK =
    Ffi.kernel "Codec_autoEnc"


autoEncOverridesK : Bool -> List ( String, b -> Value ) -> a -> Value
autoEncOverridesK =
    Ffi.kernel "Codec_autoEncOverrides"


autoDecoderOverridesK : Bool -> List ( String, Decoder b ) -> a -> Decoder a
autoDecoderOverridesK =
    Ffi.kernel "Codec_autoDecoderOverrides"


-- The JSON text of a record whose type has a generated typed codec (v0.29.9,
-- runtime-go/rt/codec_auto_gen.go), else Nothing.
autoJsonK : Bool -> a -> Maybe String
autoJsonK =
    Ffi.kernel "Codec_autoJson"


autoDecoderK : Bool -> a -> Decoder a
autoDecoderK =
    Ffi.kernel "Codec_autoDecoder"


autoColsK : Bool -> a -> List ( String, String )
autoColsK =
    Ffi.kernel "Codec_autoCols"


autoSchemaK : Bool -> a -> String
autoSchemaK =
    Ffi.kernel "Codec_autoSchema"


-- The column type of a colspec kind: the inverse of `colTypeKind`, so a
-- shape that goes through its kind (an `autoWith` override) comes back as the
-- same `ColType`. The kind is `base`, `base?` (CNull) and `|flag`s after it:
-- `decimal|money=GBP` is `CMoneyIn "GBP"`, `decimal?|money=GBP` is
-- `CNull (CMoneyIn "GBP")`. Before v0.29.2 only a bare kind was read, and a
-- Money override fell to a JSON text column (`CBlob`).
kindToColType : String -> ColType
kindToColType k =
    case String.split "|" k of

        base :: flags ->
            kindBaseColType base flags

        [] ->
            CBlob


kindBaseColType : String -> List String -> ColType
kindBaseColType base flags =
    if String.endsWith "?" base then
        CNull (kindBaseColType (String.dropRight 1 base) flags)

    else
        case base of

            "text" ->
                CText

            "int" ->
                CInt

            "real" ->
                CReal

            "bool" ->
                CBool

            "decimal" ->
                case moneyFlag flags of

                    Just code ->
                        CMoneyIn code

                    Nothing ->
                        CDecimal

            _ ->
                CBlob


-- The currency of a `money=GBP` flag.
moneyFlag : List String -> Maybe String
moneyFlag flags =
    case flags of

        [] ->
            Nothing

        f :: rest ->
            if String.startsWith "money=" f then
                Just (String.dropLeft 6 f)

            else
                moneyFlag rest

-- ── ADTs / custom types (tagged unions) ─────────────────────────────────────
-- | A decode arm for one variant of a custom type.
--
-- The payload is a named record (its tag, the schemas of its arguments for
-- `toXml` / `fromXml`, and its decoder), so a function that matches a
-- `Variant` reads it with one runtime narrowing instead of one per field
-- (doc 14 §4.5, R6).
type Variant v
    = Variant (VariantPayload v)

type alias VariantPayload v =
    { tag : String
    , args : List SchemaNode
    , dec : Decoder v
    , vprb : List String
    }


-- | A variant with no arguments.
var0 : String -> v -> Variant v
var0 name ctor =
    Variant { tag = name, args = [], dec = D.succeed ctor, vprb = [] }


-- | A variant with one argument.
var1 : String -> (a -> v) -> Codec a -> Variant v
var1 name ctor (Codec c1) =
    Variant
        { tag = name
        , args = [ c1.sch ]
        , dec = D.map ctor (D.index 1 c1.dec)
        , vprb = c1.prb
        }


-- | A variant with two arguments.
var2 : String -> (a -> b2 -> v) -> Codec a -> Codec b2 -> Variant v
var2 name ctor (Codec c1) (Codec c2) =
    Variant
        { tag = name
        , args = [ c1.sch, c2.sch ]
        , dec = D.map2 ctor (D.index 1 c1.dec) (D.index 2 c2.dec)
        , vprb = c1.prb ++ c2.prb
        }


-- | A variant with three arguments.
var3 : String -> (a -> b2 -> c2 -> v) -> Codec a -> Codec b2 -> Codec c2 -> Variant v
var3 name ctor (Codec c1) (Codec c2) (Codec c3) =
    Variant
        { tag = name
        , args = [ c1.sch, c2.sch, c3.sch ]
        , dec =
            D.map3 ctor (D.index 1 c1.dec) (D.index 2 c2.dec) (D.index 3 c3.dec)
        , vprb = c1.prb ++ c2.prb ++ c3.prb
        }


-- | Codec for a custom type (tagged union). The first argument maps a value to
-- its `(tag, encoded-args)`; the second lists the per-tag decoders. Encodes each
-- variant as a tagged JSON array `["Tag", arg0, …]`; stored as a JSON TEXT blob
-- on the DB side.
--
--     shipmentCodec =
--         Codec.taggedUnion
--             (\v ->
--                 case v of
--                     NotShipped -> ( "NotShipped", [] )
--                     Shipped c ts -> ( "Shipped", [ Codec.toValue Codec.string c, Codec.toValue Codec.int ts ] )
--             )
--             [ Codec.var0 "NotShipped" NotShipped
--             , Codec.var2 "Shipped" Shipped Codec.string Codec.int
--             ]
taggedUnion : (v -> ( String, List Value )) -> List (Variant v) -> Codec v
taggedUnion toTagged variants =
    let
        arms = variantPayloads variants
        dec = D.andThen (\tag -> pickVariant tag arms) (D.index 0 D.string)
    in
        Codec
            { enc =
                \v ->
                    let
                        ( tag, args ) = toTagged v
                    in
                        E.list identity (E.string tag :: args)
            , dec = dec
            , shp = SBlob
            , sch = SnUnion (variantSchemas arms)
            , zro = \_ -> Nothing
            , fzr = \_ -> []
            , fck = \_ -> []
            -- Always partial: the encoder is the caller's function, which can
            -- write a tag no variant reads or the wrong number of arguments
            -- (v0.29.2 fifth Judge). Its own reader is the check.
            , vck = [ valueCheck dec ]
            , vcs = []
            , jsn = \_ -> Nothing
            , prb =
                armsProblems arms
                    ++ (case repeatedName (armTags arms) (armTags arms) of

                           Just tag ->
                               [ "Codec.taggedUnion: the tag \"" ++ tag
                                     ++ "\" is given to two variants, so the second would read back as the first; give each variant its own tag"
                               ]

                           Nothing ->
                               [])
            }


-- Each variant's tag, in order. Typed recursion, not List.map over a lambda,
-- so no value is narrowed (doc 14).
armTags : List (VariantPayload v) -> List String
armTags arms =
    case arms of

        [] ->
            []

        p :: rest ->
            p.tag :: armTags rest


armsProblems : List (VariantPayload v) -> List String
armsProblems arms =
    case arms of

        [] ->
            []

        p :: rest ->
            p.vprb ++ armsProblems rest


-- The variants' payloads, unwrapped once when the codec is built: the
-- decoder and the XML description then read typed records, so a union codec
-- pays one runtime narrowing per variant in all (doc 14 §4.5, R6), not one
-- per read.
variantPayloads : List (Variant v) -> List (VariantPayload v)
variantPayloads variants =
    case variants of

        [] ->
            []

        (Variant p) :: rest ->
            p :: variantPayloads rest


pickVariant : String -> List (VariantPayload v) -> Decoder v
pickVariant tag arms =
    case arms of

        [] ->
            D.fail ("Codec: unknown variant tag: " ++ tag)

        p :: rest ->
            if p.tag == tag then
                p.dec

            else
                pickVariant tag rest


-- Each variant's tag and argument schemas, for `toXml` / `fromXml`.
variantSchemas : List (VariantPayload v) -> List ( String, List SchemaNode )
variantSchemas arms =
    case arms of

        [] ->
            []

        p :: rest ->
            ( p.tag, p.args ) :: variantSchemas rest


-- | A nullary enum stored as a readable TEXT name, via `(value, name)` pairs:
-- `enum [ ( Stickers, "stickers" ), ( Bookmarks, "bookmarks" ) ]`. Unlike
-- `taggedUnion`, an enum maps to a queryable scalar column (not a blob). For
-- data-carrying variants use `taggedUnion` / `varN`.
--
-- A value that is not in `pairs` has no name, so the codec is partial
-- (v0.29.2 fifth Judge). It is never written as `""` or as another value's
-- name: `toJson` and `toValue` (which cannot fail) write the JSON object
-- `{"notInEnum": "Suspended"}` naming its constructor, which this codec and
-- every other reader refuses, and a `Std.Db.Store` write refuses the row with
-- the column and the constructor before any statement. Two values given one
-- name are a builder problem (`problems`), and `Store.fromCodec` refuses the
-- store: the second value would read back as the first.
enum : List ( v, String ) -> Codec v
enum pairs =
    Codec
        { enc = \v -> enumEncode v pairs
        , dec = enumDecoder pairs
        , shp = SScalar CText
        , sch = SnEnum (\_ -> List.map (\( _, n ) -> n) pairs)
        , zro =
            \_ ->
                case pairs of

                    ( _, n ) :: _ ->
                        Just (E.string n)

                    [] ->
                        Nothing
        , fzr = \_ -> []
        , fck = \_ -> []
        , vck = [ valueCheck (enumDecoder pairs) ]
        , vcs = []
        , jsn = \_ -> Nothing
        , prb =
            case repeatedName (enumNames pairs) (enumNames pairs) of

                Just name ->
                    [ "Codec.enum: the name \"" ++ name
                          ++ "\" is given to two values, so the second would read back as the first; give each value its own name"
                    ]

                Nothing ->
                    []
        }


enumEncode : v -> List ( v, String ) -> Value
enumEncode v pairs =
    case enumNameFor v pairs of

        Just name ->
            E.string name

        Nothing ->
            enumNotListedK v


-- The reader of `enum`. A name reads as its value. The object
-- `{"notInEnum": …}` that `enumEncode` writes for a value with no name is an
-- `Err` naming its constructor, at any depth (an element of a `Codec.list`
-- names it too). Anything else fails as `D.string` does.
enumDecoder : List ( v, String ) -> Decoder v
enumDecoder pairs =
    D.andThen (\name -> enumValueFor name pairs) (enumStringK (enumNames pairs))


-- `D.string`, and the `{"notInEnum": …}` object an `Err` naming the value
-- and the names. A decoder needs no runtime narrowing.
enumStringK : List String -> Decoder String
enumStringK =
    Ffi.kernel "Codec_enumString"


enumNames : List ( v, String ) -> List String
enumNames pairs =
    case pairs of

        [] ->
            []

        ( _, name ) :: rest ->
            name :: enumNames rest


-- The first name in `names` (read in order) that an earlier one already used.
-- `all` is the whole list and `names` a suffix of it, as in `repeatedKey`.
repeatedName : List String -> List String -> Maybe String
repeatedName all names =
    case names of

        [] ->
            Nothing

        name :: rest ->
            if nameCount name all 0 > nameCount name names 0 then
                Just name

            else
                repeatedName all rest


nameCount : String -> List String -> Int -> Int
nameCount name names n =
    case names of

        [] ->
            n

        k :: rest ->
            if k == name then
                nameCount name rest (n + 1)

            else
                nameCount name rest n


-- `{"notInEnum": "<the value in Sky syntax>"}` (`Suspended`, `Circle 1.5`):
-- what `enum` writes for a value with no name. Built by the runtime, so the
-- value is shown by the printer `Debug.toString` uses, and the result is a
-- `Value`, which needs no runtime narrowing.
enumNotListedK : v -> Value
enumNotListedK =
    Ffi.kernel "Codec_enumNotListed"


-- The value a Maybe codec writes for `Just x` whose inner encoding `v` is
-- JSON null: one every reader refuses (written as `null` in JSON text).
justNullK : Value -> Value
justNullK =
    Ffi.kernel "Codec_justNull"


-- `dec`, refusing the value `justNullK` writes.
refuseJustNullK : Decoder a -> Decoder a
refuseJustNullK =
    Ffi.kernel "Codec_refuseJustNull"


-- `v` with every value `justNullK` wrote made a plain null again.
plainNullK : Value -> Value
plainNullK =
    Ffi.kernel "Codec_plainNull"


enumNameFor : v -> List ( v, String ) -> Maybe String
enumNameFor v pairs =
    case pairs of

        [] ->
            Nothing

        ( val, name ) :: rest ->
            if val == v then
                Just name

            else
                enumNameFor v rest


enumValueFor : String -> List ( v, String ) -> Decoder v
enumValueFor name pairs =
    case pairs of

        [] ->
            D.fail ("Codec.enum: unknown name: " ++ name)

        ( val, nm ) :: rest ->
            if nm == name then
                D.succeed val

            else
                enumValueFor name rest


-- ── Internal ─────────────────────────────────────────────────────────────────
-- applicative `andMap` for decoders, built from map2.
codecAndMap : Decoder a -> Decoder (a -> b) -> Decoder b
codecAndMap da df =
    D.map2 (\f a -> f a) df da


-- a field's DB column type: scalars keep their type, everything else is a blob.
colTypeOf : Shape -> ColType
colTypeOf s =
    case s of

        SScalar t ->
            t

        _ ->
            CBlob


-- ── XML ──────────────────────────────────────────────────────────────────────
-- | Write a value as XML: one root element named `root`, then the codec's value
-- inside it. Total (see `Std.Xml.Encode.encode` for the characters XML cannot
-- carry; a field name or tag is written as it is in the codec).
--
--     Codec.toXml "order" orderCodec order
--     -- <order><id>A-1</id><lines><sku>x</sku><qty>2</qty></lines>…</order>
--
-- The mapping:
--
-- * a record — one child element per field, in field order;
-- * a list — one element per item, named after the field (an empty list
--   writes nothing); a list that is not a field (the root, an item of a list,
--   a variant argument) writes each item as `<item>`;
-- * `Nothing` — a field is left out; elsewhere (a list item, a variant
--   argument, the root) it is the element with `nil="true"`;
-- * a scalar — its text (`true` / `false`, a number in its shortest JSON
--   form); an `enum` — its name;
-- * a `taggedUnion` variant — `<field><Tag><arg>…</arg>…</Tag></field>`, a
--   variant with no arguments `<field><Tag/></field>`;
-- * a `result` — `<field><Ok>…</Ok></field>` or `<field><Err>…</Err></field>`;
-- * a `dict` — `<field><entry><key>…</key><value>…</value></entry>…</field>`;
-- * a `Json.Value` field (and any part a codec cannot describe) — compact JSON
--   text, so the round trip stays exact.
--
-- Two shapes do not round-trip: `Maybe (List a)` with `Just []` reads back as
-- `Nothing`, and `Maybe (Maybe a)` collapses (as it does in JSON). Runs on the
-- server: a Sky.Spa app calls it in its backend. Cost: O(size of the value).
toXml : String -> Codec a -> a -> String
toXml root (Codec c) x =
    XE.encode 0 (xmlElem root c.sch (c.enc x))


-- | Read a value written as XML: the reverse of `toXml`, from a document whose
-- root element has the local name `root` (an `Err` otherwise).
--
-- * A field is the child element with the field's local name or, when there
--   is none, the attribute with that name (`<line sku="x"><qty>2</qty></line>`).
-- * `Int`, `Float` and `Bool` (`true` / `false` / `1` / `0`) are read from
--   trimmed text; a `String` keeps its text exactly.
-- * A list is 0 to n repeated elements; `Maybe` is `Nothing` when the element
--   is absent (`<x/>` is `Just ""` for a `Maybe String`).
-- * A variant is the one child element named by its tag; text equal to the
--   tag of a variant with no arguments is accepted too.
-- * A field that is not a list with two or more elements is an `Err`
--   ("expected one"), and elements the codec does not name are ignored, as
--   unknown JSON keys are.
--
-- Names are local names, so a namespaced document (a SOAP body, an Atom feed)
-- reads by the names in the codec. The document is parsed by `Std.Xml.parse`
-- (no DOCTYPE, bounded). A failure names the path: `/order/lines[2]/qty`.
-- The codec's own decoder then runs on the value read, unchanged.
fromXml : String -> Codec a -> String -> Result Error a
fromXml root (Codec c) src =
    case Xml.parse src of

        Err e ->
            Err e

        Ok n ->
            if Xml.name n /= root then
                Err
                    (xmlFailAt
                        ("/" ++ Xml.name n)
                        ("expected the root element <" ++ root ++ ">, got <"
                            ++ Xml.name n
                            ++ ">"))

            else
                case xmlRead ("/" ++ root) c.sch n of

                    Ok v ->
                        D.decodeValue c.dec v

                    Err e ->
                        Err e


xmlFailAt : String -> String -> Error
xmlFailAt path msg =
    Error.failure "xml" "decode" |> Error.withAttr "path" path
        |> Error.fromDomain
               Error.Decode
               ("Codec.fromXml: " ++ msg ++ " at " ++ path)


-- Writing: the element `name` that holds `v`, as `sch` describes it.
xmlElem : String -> SchemaNode -> Value -> XE.Xml
xmlElem name sch v =
    case sch of

        SnNullable inner ->
            if valueIsNull v then
                XE.element name [ XE.attribute "nil" "true" ] []

            else
                xmlElem name inner v

        SnArray inner ->
            XE.element
                name
                []
                (List.map (\item -> xmlElem "item" inner item) (valueList v))

        SnObject fields ->
            XE.element name [] (xmlFields fields v)

        SnAuto fieldsJson overrides ->
            xmlElem name (autoNode (fieldsJson ()) overrides) v

        SnUnion variants ->
            XE.element name [] [ xmlVariant variants v ]

        SnResult se sa ->
            if valueTag v == "Ok" then
                XE.element name [] [ xmlElem "Ok" sa (valueAt 1 v) ]

            else
                XE.element name [] [ xmlElem "Err" se (valueAt 1 v) ]

        SnDict sk sv ->
            XE.element
                name
                []
                (List.map
                    (\pair ->
                        XE.element
                            "entry"
                            []
                            [ xmlElem "key" sk (valueAt 0 pair)
                            , xmlElem "value" sv (valueAt 1 pair)
                            ])
                    (valueList v))

        SnOpen ->
            XE.element name [] [ XE.text (E.encode 0 v) ]

        SnType _ ->
            XE.element name [] [ XE.text (scalarText v) ]

        SnDecimal ->
            XE.element name [] [ XE.text (scalarText v) ]

        SnEnum _ ->
            XE.element name [] [ XE.text (scalarText v) ]


-- A record's fields, in order.
xmlFields : List ( String, SchemaNode ) -> Value -> List XE.Xml
xmlFields fields v =
    List.concatMap (\( n, s ) -> xmlField n s (valueField n v)) fields


-- One field: no element for `Nothing`, one element per item for a list.
xmlField : String -> SchemaNode -> Value -> List XE.Xml
xmlField name sch v =
    case sch of

        SnNullable inner ->
            if valueIsNull v then
                []

            else
                xmlField name inner v

        SnArray inner ->
            List.map (\item -> xmlElem name inner item) (valueList v)

        SnAuto fieldsJson overrides ->
            xmlField name (autoNode (fieldsJson ()) overrides) v

        _ ->
            [ xmlElem name sch v ]


xmlVariant : List ( String, List SchemaNode ) -> Value -> XE.Xml
xmlVariant variants v =
    let
        tag = valueTag v
        args = List.drop 1 (valueList v)
    in
        XE.element tag [] (xmlArgs (variantArgs tag variants) args)


xmlArgs : List SchemaNode -> List Value -> List XE.Xml
xmlArgs schemas args =
    case args of

        [] ->
            []

        a :: rest ->
            case schemas of

                s :: more ->
                    xmlElem "arg" s a :: xmlArgs more rest

                [] ->
                    xmlElem "arg" SnOpen a :: xmlArgs [] rest


variantArgs : String -> List ( String, List SchemaNode ) -> List SchemaNode
variantArgs tag variants =
    case variants of

        [] ->
            []

        ( t, args ) :: rest ->
            if t == tag then
                args

            else
                variantArgs tag rest


scalarText : Value -> String
scalarText v =
    case D.decodeValue D.string v of

        Ok s ->
            s

        Err _ ->
            case D.decodeValue D.bool v of

                Ok b ->
                    if b then
                        "true"

                    else
                        "false"

                Err _ ->
                    E.encode 0 v


valueIsNull : Value -> Bool
valueIsNull v =
    case D.decodeValue (D.null True) v of

        Ok _ ->
            True

        Err _ ->
            False


valueList : Value -> List Value
valueList v =
    case D.decodeValue (D.list D.value) v of

        Ok items ->
            items

        Err _ ->
            []


valueAt : Int -> Value -> Value
valueAt i v =
    case D.decodeValue (D.index i D.value) v of

        Ok x ->
            x

        Err _ ->
            E.null


valueField : String -> Value -> Value
valueField name v =
    case D.decodeValue (D.field name D.value) v of

        Ok x ->
            x

        Err _ ->
            E.null


valueTag : Value -> String
valueTag v =
    case D.decodeValue (D.index 0 D.string) v of

        Ok t ->
            t

        Err _ ->
            ""


-- An auto codec's description as a node: the witness's fields (their JSON
-- Schema read back into nodes), each replaced by its `autoWith` override.
autoNode : String -> List ( String, SchemaNode ) -> SchemaNode
autoNode fieldsJson overrides =
    let
        fieldDecoder =
            D.map2
                (\n s -> ( n, s ))
                (D.field "name" D.string)
                (D.field "schema" D.value)
    in
        case D.decodeString
                 (D.field "fields" (D.nullable (D.list fieldDecoder)))
                 fieldsJson of

            Ok (Just fields) ->
                SnObject
                    (List.map
                        (\( n, s ) ->
                            case lookupSchema n overrides of

                                Just o ->
                                    ( n, o )

                                Nothing ->
                                    ( n, nodeOfJsonSchema s ))
                        fields)

            _ ->
                SnOpen


-- A JSON Schema (as `Codec_autoSchema` writes it) read back into a node:
-- `type`, `anyOf` with null, `items`, `properties` in `required` order and
-- `enum`. Anything else is open.
nodeOfJsonSchema : Value -> SchemaNode
nodeOfJsonSchema v =
    case D.decodeValue (D.field "anyOf" (D.list D.value)) v of

        Ok (first :: _) ->
            SnNullable (nodeOfJsonSchema first)

        _ ->
            case D.decodeValue (D.field "enum" (D.list D.string)) v of

                Ok names ->
                    SnEnum (\_ -> names)

                Err _ ->
                    nodeOfJsonType (D.decodeValue (D.field "type" D.string) v) v


nodeOfJsonType : Result Error String -> Value -> SchemaNode
nodeOfJsonType t v =
    case t of

        Ok "array" ->
            SnArray (nodeOfJsonSchema (valueField "items" v))

        Ok "object" ->
            case D.decodeValue (D.field "required" (D.list D.string)) v of

                Ok names ->
                    SnObject
                        (List.map
                            (\n ->
                                ( n
                                , nodeOfJsonSchema
                                      (valueField n (valueField "properties" v))
                                ))
                            names)

                Err _ ->
                    SnOpen

        Ok other ->
            SnType other

        Err _ ->
            SnOpen


-- Reading: the JSON value the element `n` holds, as `sch` describes it.
xmlRead : String -> SchemaNode -> Node -> Result Error Value
xmlRead path sch n =
    case sch of

        SnType t ->
            xmlScalar path t (Xml.text n)

        SnDecimal ->
            Ok (E.string (String.trim (Xml.text n)))

        SnEnum _ ->
            Ok (E.string (String.trim (Xml.text n)))

        SnNullable inner ->
            if Xml.attribute "nil" n == Just "true" then
                Ok E.null

            else
                xmlRead path inner n

        SnArray inner ->
            xmlReadList
                (path ++ "/item")
                inner
                1
                (Xml.elementsNamed "item" n)
                []

        SnObject fields ->
            xmlReadFields path fields n []

        SnAuto fieldsJson overrides ->
            xmlRead path (autoNode (fieldsJson ()) overrides) n

        SnUnion variants ->
            xmlReadVariant path variants n

        SnResult se sa ->
            case Xml.elementsNamed "Ok" n of

                [ ok ] ->
                    xmlTagged "Ok" [ xmlRead (path ++ "/Ok") sa ok ]

                _ ->
                    case Xml.elementsNamed "Err" n of

                        [ err ] ->
                            xmlTagged "Err" [ xmlRead (path ++ "/Err") se err ]

                        _ ->
                            Err
                                (xmlFailAt
                                    path
                                    "expected one <Ok> or <Err> element")

        SnDict sk sv ->
            xmlReadEntries
                (path ++ "/entry")
                sk
                sv
                1
                (Xml.elementsNamed "entry" n)
                []

        SnOpen ->
            case E.raw (Xml.text n) of

                Ok v ->
                    Ok v

                Err _ ->
                    Err (xmlFailAt path "expected JSON text")


-- A value read from text (an element's or an attribute's).
xmlScalar : String -> String -> String -> Result Error Value
xmlScalar path t raw =
    let
        trimmed = String.trim raw
    in
        if t == "integer" then
            case String.toInt trimmed of

                Just i ->
                    Ok (E.int i)

                Nothing ->
                    Err
                        (xmlFailAt
                            path
                            ("expected an Int, got \"" ++ trimmed ++ "\""))

        else if t == "number" then
            case String.toFloat trimmed of

                Just f ->
                    Ok (E.float f)

                Nothing ->
                    Err
                        (xmlFailAt
                            path
                            ("expected a Float, got \"" ++ trimmed ++ "\""))

        else if t == "boolean" then
            if trimmed == "true" || trimmed == "1" then
                Ok (E.bool True)

            else if trimmed == "false" || trimmed == "0" then
                Ok (E.bool False)

            else
                Err
                    (xmlFailAt
                        path
                        ("expected a Bool, got \"" ++ trimmed ++ "\""))

        else
            Ok (E.string raw)


-- A field read from an attribute: scalars and enums only.
xmlFromAttribute : String -> SchemaNode -> String -> Result Error Value
xmlFromAttribute path sch raw =
    case sch of

        SnType t ->
            xmlScalar path t raw

        SnDecimal ->
            Ok (E.string (String.trim raw))

        SnEnum _ ->
            Ok (E.string (String.trim raw))

        SnNullable inner ->
            xmlFromAttribute path inner raw

        _ ->
            Err (xmlFailAt path "expected an element, got an attribute")


xmlReadFields : String -> List ( String, SchemaNode ) -> Node -> List ( String, Value ) -> Result Error Value
xmlReadFields path fields n acc =
    case fields of

        [] ->
            Ok (E.object (List.reverse acc))

        ( name, sch ) :: rest ->
            case xmlReadField path n name sch of

                Ok v ->
                    xmlReadFields path rest n (( name, v ) :: acc)

                Err e ->
                    Err e


-- One field of the element `parent`.
xmlReadField : String -> Node -> String -> SchemaNode -> Result Error Value
xmlReadField path parent name sch =
    let
        here = path ++ "/" ++ name
    in
        case sch of

            SnAuto fieldsJson overrides ->
                xmlReadField
                    path
                    parent
                    name
                    (autoNode (fieldsJson ()) overrides)

            SnArray inner ->
                xmlReadList here inner 1 (Xml.elementsNamed name parent) []

            SnNullable inner ->
                if isListNode inner then
                    case Xml.elementsNamed name parent of

                        [] ->
                            Ok E.null

                        els ->
                            xmlReadList here (listItem inner) 1 els []

                else
                    case Xml.elementsNamed name parent of

                        [] ->
                            case Xml.attribute name parent of

                                Just raw ->
                                    xmlFromAttribute here inner raw

                                Nothing ->
                                    Ok E.null

                        [ one ] ->
                            xmlRead here sch one

                        els ->
                            Err (xmlExpectedOne here name els)

            _ ->
                case Xml.elementsNamed name parent of

                    [ one ] ->
                        xmlRead here sch one

                    [] ->
                        case Xml.attribute name parent of

                            Just raw ->
                                xmlFromAttribute here sch raw

                            Nothing ->
                                Err
                                    (xmlFailAt
                                        path
                                        ("no <" ++ name ++ "> element"))

                    els ->
                        Err (xmlExpectedOne here name els)


xmlExpectedOne : String -> String -> List Node -> Error
xmlExpectedOne path name els =
    xmlFailAt
        path
        ("expected one <" ++ name ++ "> element, got "
            ++ String.fromInt (List.length els))


isListNode : SchemaNode -> Bool
isListNode sch =
    case sch of

        SnArray _ ->
            True

        _ ->
            False


listItem : SchemaNode -> SchemaNode
listItem sch =
    case sch of

        SnArray inner ->
            inner

        _ ->
            sch


xmlReadList : String -> SchemaNode -> Int -> List Node -> List Value -> Result Error Value
xmlReadList base sch i els acc =
    case els of

        [] ->
            Ok (E.list identity (List.reverse acc))

        el :: rest ->
            case xmlRead (base ++ "[" ++ String.fromInt i ++ "]") sch el of

                Ok v ->
                    xmlReadList base sch (i + 1) rest (v :: acc)

                Err e ->
                    Err e


xmlReadEntries : String -> SchemaNode -> SchemaNode -> Int -> List Node -> List Value -> Result Error Value
xmlReadEntries base sk sv i els acc =
    case els of

        [] ->
            Ok (E.list identity (List.reverse acc))

        el :: rest ->
            let
                here = base ++ "[" ++ String.fromInt i ++ "]"
            in
                case xmlReadField here el "key" sk of

                    Ok k ->
                        case xmlReadField here el "value" sv of

                            Ok v ->
                                xmlReadEntries
                                    base
                                    sk
                                    sv
                                    (i + 1)
                                    rest
                                    (E.list identity [ k, v ] :: acc)

                            Err e ->
                                Err e

                    Err e ->
                        Err e


-- `["Tag", arg, …]`, the JSON a `taggedUnion` / `result` decoder reads.
xmlTagged : String -> List (Result Error Value) -> Result Error Value
xmlTagged tag args =
    case xmlAll args [] of

        Ok vs ->
            Ok (E.list identity (E.string tag :: vs))

        Err e ->
            Err e


xmlAll : List (Result Error Value) -> List Value -> Result Error (List Value)
xmlAll rs acc =
    case rs of

        [] ->
            Ok (List.reverse acc)

        (Ok v) :: rest ->
            xmlAll rest (v :: acc)

        (Err e) :: _ ->
            Err e


xmlReadVariant : String -> List ( String, List SchemaNode ) -> Node -> Result Error Value
xmlReadVariant path variants n =
    case Xml.elements n of

        [ el ] ->
            if isTag (Xml.name el) variants then
                xmlTagged
                    (Xml.name el)
                    (xmlReadArgs
                        (path ++ "/" ++ Xml.name el ++ "/arg")
                        1
                        (variantArgs (Xml.name el) variants)
                        (Xml.elementsNamed "arg" el))

            else
                Err
                    (xmlFailAt
                        path
                        ("<" ++ Xml.name el ++ "> is not a variant of this type"))

        [] ->
            let
                t = String.trim (Xml.text n)
            in
                if isNullaryTag t variants then
                    Ok (E.list identity [ E.string t ])

                else
                    Err
                        (xmlFailAt
                            path
                            ("expected a variant, got \"" ++ t ++ "\""))

        _ ->
            Err (xmlFailAt path "expected one variant element")


xmlReadArgs : String -> Int -> List SchemaNode -> List Node -> List (Result Error Value)
xmlReadArgs base i schemas els =
    case schemas of

        [] ->
            []

        s :: more ->
            let
                here = base ++ "[" ++ String.fromInt i ++ "]"
            in
                case els of

                    el :: rest ->
                        xmlRead here s el :: xmlReadArgs base (i + 1) more rest

                    [] ->
                        if isNullable s then
                            Ok E.null :: xmlReadArgs base (i + 1) more []

                        else
                            [ Err (xmlFailAt here "missing <arg> element") ]


isNullable : SchemaNode -> Bool
isNullable sch =
    case sch of

        SnNullable _ ->
            True

        _ ->
            False


isTag : String -> List ( String, List SchemaNode ) -> Bool
isTag tag variants =
    case variants of

        [] ->
            False

        ( t, _ ) :: rest ->
            t == tag || isTag tag rest


isNullaryTag : String -> List ( String, List SchemaNode ) -> Bool
isNullaryTag tag variants =
    case variants of

        [] ->
            False

        ( t, args ) :: rest ->
            (t == tag && List.isEmpty args) || isNullaryTag tag rest


-- ── Comparing schemas and checking values ────────────────────────────────────
-- | `Nothing` when every JSON value the JSON Schema `source` describes reads,
-- through a codec whose `jsonSchema` is `target`, as that same value, so a
-- projection is refused before any statement instead of failing on a row (a
-- `Codec.maybe` decoder reads only `null` as `Nothing`, and any other value
-- it cannot decode is an `Err`). `Just` the reason otherwise.
-- Both are schemas as `jsonSchema` writes them (its `schema` field, or a part
-- of one). The rule:
--
-- * a `Maybe x` target reads a source `x` or `Maybe x`, and a nullable source
--   needs a `Maybe` target;
-- * `String` reads `String` or an enum, `Float` reads `Float` or `Int`, and
--   `Int` and `Bool` read only themselves;
-- * an enum reads an enum whose names are all its own names;
-- * a list compares its items, a record each of its fields (every target
--   field must be in the source), a `Dict` under `auto` its values;
-- * a part the schema leaves open (`{}`: a `taggedUnion`, a `result`, a
--   `dict`, a `Json.Value` field, `Codec.error`) reads anything, except under
--   a `Maybe`: there it reads only an open part.
--
--     Codec.schemaFitError
--         (Codec.jsonSchema (Codec.maybe (Codec.list Codec.string))).schema
--         (Codec.jsonSchema (Codec.list Codec.int)).schema
--     -- Just "a list item: an Int does not read as a String"
schemaFitError : Value -> Value -> Maybe String
schemaFitError target source =
    fitSchema False target source


fitSchema : Bool -> Value -> Value -> Maybe String
fitSchema under t s =
    let
        tk = schemaKind t
        sk = schemaKind s
    in
        if tk == "nullable" then
            if sk == "nullable" then
                fitSchema True (nullableInner t) (nullableInner s)

            else
                fitSchema True (nullableInner t) s

        else if tk == "open" then
            if sk == "open" || not under then
                Nothing

            else
                Just
                    ("a Maybe of a part no schema describes reads only such a part, not "
                        ++ describeSchema s)

        else if sk == "nullable" then
            Just
                ("the source is " ++ describeSchema s ++ ", so "
                    ++ describeSchema t
                    ++ " needs a Maybe")

        else if sk == "open" then
            if under then
                Just
                    ("the source is a part no schema describes, and a Maybe of "
                        ++ describeSchema t
                        ++ " may not read it")

            else
                Nothing

        else if tk == "string" && sk == "enum" then
            Nothing

        else if tk == "number" && sk == "integer" then
            Nothing

        else if tk /= sk then
            Just (describeSchema s ++ " does not read as " ++ describeSchema t)

        else if tk == "enum" then
            case missingName (schemaNames t) (schemaNames s) of

                "" ->
                    Nothing

                n ->
                    Just
                        ("the source name \"" ++ n
                            ++ "\" is not one of the target enum's names")

        else if tk == "array" then
            within
                "a list item"
                (fitSchema under (schemaPart "items" t) (schemaPart "items" s))

        else if tk == "map" then
            within
                "a Dict value"
                (fitSchema
                    under
                    (schemaPart "additionalProperties" t)
                    (schemaPart "additionalProperties" s))

        else if tk == "object" then
            fieldsFit under t s (schemaNames (schemaPart "required" t))

        else
            Nothing


-- Every target field is in the source, and reads its values.
fieldsFit : Bool -> Value -> Value -> List String -> Maybe String
fieldsFit under t s names =
    case names of

        [] ->
            Nothing

        n :: rest ->
            case jsonField n (schemaPart "properties" s) of

                Nothing ->
                    Just ("the field \"" ++ n ++ "\" is not in the source")

                Just src ->
                    orElse
                        (within
                            ("the field \"" ++ n ++ "\"")
                            (fitSchema
                                under
                                (schemaPart n (schemaPart "properties" t))
                                src))
                        (fieldsFit under t s rest)


-- | `Nothing` when the JSON value is one the JSON Schema (as `jsonSchema`
-- writes it) reads: the right JSON type, an enum name that is one of the
-- names, a `null` only for a `Maybe`, every list item, every record field (a
-- missing field only for a `Maybe` one). A part the schema leaves open (`{}`)
-- takes any value: its codec's decoder checks it. `Just` the reason otherwise.
--
--     Codec.schemaValueError (Codec.jsonSchema (Codec.list Codec.int)).schema
--         (Encode.list Encode.string [ "a" ])
--     -- Just "expected an Int, got \"a\""
schemaValueError : Value -> Value -> Maybe String
schemaValueError schema v =
    let
        kind = schemaKind schema
        text = E.encode 0 v
    in
        if kind == "nullable" then
            if text == "null" then
                Nothing

            else
                schemaValueError (nullableInner schema) v

        else if kind == "open" then
            Nothing

        else if kind == "enum" then
            case jsonText v of

                Just n ->
                    if memberOf n (schemaNames schema) then
                        Nothing

                    else
                        Just
                            ("\"" ++ n ++ "\" is not one of the names "
                                ++ String.join ", " (schemaNames schema))

                Nothing ->
                    expectedSchema schema text

        else if kind == "array" then
            case jsonItems v of

                Just items ->
                    itemsError (schemaPart "items" schema) items

                Nothing ->
                    expectedSchema schema text

        else if kind == "object" || kind == "map" then
            if not (String.startsWith "{" text) then
                expectedSchema schema text

            else if kind == "object" then
                objectValueError
                    schema
                    (schemaNames (schemaPart "required" schema))
                    v

            else
                Nothing

        else if scalarIs kind text then
            Nothing

        else
            expectedSchema schema text


-- The kind of a JSON Schema as `jsonSchema` writes it: "nullable" (anyOf
-- with null), "enum", "array", "object" (a record: `required` lists its
-- fields), "map" (an object with `additionalProperties` only), a scalar type
-- ("string", "integer", "number", "boolean") or "open" (`{}`).
schemaKind : Value -> String
schemaKind s =
    case jsonField "anyOf" s of

        Just _ ->
            "nullable"

        Nothing ->
            case jsonField "enum" s of

                Just _ ->
                    "enum"

                Nothing ->
                    case jsonField "type" s of

                        Just tv ->
                            case jsonText tv of

                                Just "object" ->
                                    case jsonField "required" s of

                                        Just _ ->
                                            "object"

                                        Nothing ->
                                            "map"

                                Just t ->
                                    t

                                Nothing ->
                                    "open"

                        Nothing ->
                            "open"


-- The part of a schema under a key (`{}`, open, when there is none).
schemaPart : String -> Value -> Value
schemaPart key s =
    case jsonField key s of

        Just part ->
            part

        Nothing ->
            E.object []


-- The non-null side of a nullable schema.
nullableInner : Value -> Value
nullableInner s =
    case jsonItems (schemaPart "anyOf" s) of

        Just (first :: _) ->
            first

        _ ->
            E.object []


-- An enum's names, or the names of `required`.
schemaNames : Value -> List String
schemaNames s =
    case jsonItems (schemaPart "enum" s) of

        Just items ->
            textsOf items

        Nothing ->
            case jsonItems s of

                Just items ->
                    textsOf items

                Nothing ->
                    []


textsOf : List Value -> List String
textsOf items =
    case items of

        [] ->
            []

        x :: rest ->
            case jsonText x of

                Just t ->
                    t :: textsOf rest

                Nothing ->
                    textsOf rest


-- The first source name the target names do not have, or "".
missingName : List String -> List String -> String
missingName target source =
    case source of

        [] ->
            ""

        n :: rest ->
            if memberOf n target then
                missingName target rest

            else
                n


memberOf : String -> List String -> Bool
memberOf n names =
    case names of

        [] ->
            False

        x :: rest ->
            x == n || memberOf n rest


orElse : Maybe String -> Maybe String -> Maybe String
orElse first second =
    case first of

        Just msg ->
            Just msg

        Nothing ->
            second


within : String -> Maybe String -> Maybe String
within part r =
    case r of

        Just msg ->
            Just (part ++ ": " ++ msg)

        Nothing ->
            Nothing


-- Whether the compact JSON text is a scalar of the JSON Schema type `kind`.
scalarIs : String -> String -> Bool
scalarIs kind text =
    if kind == "string" then
        String.startsWith "\"" text

    else if kind == "integer" then
        case String.toInt text of

            Just _ ->
                True

            Nothing ->
                False

    else if kind == "number" then
        case String.toFloat text of

            Just _ ->
                True

            Nothing ->
                False

    else if kind == "boolean" then
        text == "true" || text == "false"

    else
        True


-- The items of a JSON array.
jsonItems : Value -> Maybe (List Value)
jsonItems v =
    Result.toMaybe (D.decodeValue (D.list D.value) v)


-- The content of a JSON string.
jsonText : Value -> Maybe String
jsonText v =
    Result.toMaybe (D.decodeValue D.string v)


-- The value of an object's field.
jsonField : String -> Value -> Maybe Value
jsonField name v =
    Result.toMaybe (D.decodeValue (D.field name D.value) v)


itemsError : Value -> List Value -> Maybe String
itemsError item values =
    case values of

        [] ->
            Nothing

        x :: rest ->
            orElse (schemaValueError item x) (itemsError item rest)


objectValueError : Value -> List String -> Value -> Maybe String
objectValueError schema names v =
    case names of

        [] ->
            Nothing

        n :: rest ->
            let
                field = schemaPart n (schemaPart "properties" schema)
            in
                case jsonField n v of

                    Just x ->
                        orElse
                            (within
                                ("the field \"" ++ n ++ "\"")
                                (schemaValueError field x))
                            (objectValueError schema rest v)

                    Nothing ->
                        if schemaKind field == "nullable" then
                            objectValueError schema rest v

                        else
                            Just ("the field \"" ++ n ++ "\" is missing")


expectedSchema : Value -> String -> Maybe String
expectedSchema schema text =
    Just
        ("expected " ++ describeSchema schema ++ ", got " ++ String.left 60 text)


-- A description of a schema for an error message.
describeSchema : Value -> String
describeSchema s =
    let
        kind = schemaKind s
    in
        if kind == "string" then
            "a String"

        else if kind == "integer" then
            "an Int"

        else if kind == "number" then
            "a Float"

        else if kind == "boolean" then
            "a Bool"

        else if kind == "nullable" then
            "a Maybe of " ++ describeSchema (nullableInner s)

        else if kind == "array" then
            "a list of " ++ describeSchema (schemaPart "items" s)

        else if kind == "enum" then
            "an enum (" ++ String.join ", " (schemaNames s) ++ ")"

        else if kind == "object" then
            "a record"

        else if kind == "map" then
            "a Dict"

        else
            "a part no schema describes"
