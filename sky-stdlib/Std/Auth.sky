-- | Std.Auth — authentication helpers (Layer 3 Sky source).
--
-- Two-tier API: pure crypto helpers (`hashPassword` /
-- `verifyPassword` / `signToken` / `verifyToken` /
-- `passwordStrength`) return `Result Error _`; the higher-level
-- DB-touching flows (`register` / `login` / `setRole`) return
-- `Task Error _` because they read + write to the user store.
--
-- Bcrypt cost defaults to 12 for `hashPassword`; use
-- `hashPasswordCost` to override (10 for tests, 14+ for high
-- security).
module Std.Auth exposing
    ( register
    , login
    , setRole
    , hashPassword
    , hashPasswordCost
    , verifyPassword
    , passwordStrength
    , signToken
    , verifyToken
    , signTokenWithClaims
    , verifyTokenWithAlgorithm
    , signSlidingToken
    , setSlidingCookie
    , AccessState(..)
    , revokeUser
    , disableUser
    , enableUser
    , isRevoked
    , isDisabled
    , userAccessState
    )

import Sky.Ffi as Ffi
import Sky.Core.Error exposing (Error)
import Sky.Core.Jwt as Jwt
import Sky.Core.Task as Task


-- ─── DB-touching flows (Task) ──────────────────────────────────────
-- | `register db email password` — create a new user.  Returns
-- the freshly-assigned user id.
register : Db -> String -> String -> Task Error Int
register =
    Ffi.kernel "Auth_register"


-- | `login db email password` — authenticate.  Returns the user
-- id on success.
login : Db -> String -> String -> Task Error Int
login =
    Ffi.kernel "Auth_login"


-- | `setRole db userId role` — assign a role to the user.
setRole : Db -> Int -> String -> Task Error ()
setRole =
    Ffi.kernel "Auth_setRole"


-- ─── Pure crypto (Result) ──────────────────────────────────────────
-- | Bcrypt hash with default cost (12).
hashPassword : String -> Result Error String
hashPassword =
    Ffi.kernel "Auth_hashPassword"


-- | Bcrypt hash with explicit cost — `hashPasswordCost password
-- cost`.  Use 10 for tests, 14+ for high security.
hashPasswordCost : String -> Int -> Result Error String
hashPasswordCost =
    Ffi.kernel "Auth_hashPasswordCost"


-- | `verifyPassword password hash` — constant-time bcrypt verify.
verifyPassword : String -> String -> Result Error Bool
verifyPassword =
    Ffi.kernel "Auth_verifyPassword"


-- | Categorical password strength: "weak" / "fair" / "strong".
passwordStrength : String -> Result Error String
passwordStrength =
    Ffi.kernel "Auth_passwordStrength"


-- | `signToken secret claims expirySeconds` — produce a signed
-- JWT.  `claims` is left polymorphic; typically a `Dict` or a
-- typed-record alias.
signToken : String -> a -> Int -> Result Error String
signToken =
    Ffi.kernel "Auth_signToken"


-- | `verifyToken secret token` — verify + decode a JWT.
verifyToken : String -> String -> Result Error a
verifyToken =
    Ffi.kernel "Auth_verifyToken"


-- | `signSlidingToken secret claims { windowSeconds, maxLifetimeSeconds }` —
-- issue a ROLLING-session JWT for use with `Live.withAuthSliding`.
--
-- Stamps `iat = now`, `exp = now + windowSeconds` (the idle-timeout window
-- the sliding middleware re-issues against), `aexp = now + maxLifetimeSeconds`
-- (the ABSOLUTE lifetime cap, carried verbatim through every re-issue and
-- never extended), and `w = windowSeconds` as its own signed claim.
--
-- Rejects `windowSeconds > maxLifetimeSeconds` with an `Err` — that would
-- stamp `exp > aexp` on a fresh token and break the cap invariant. Otherwise
-- signs exactly as `signToken` (same HMAC-SHA256 path). Use it at login; set
-- the cookie with `setSlidingCookie` so the builder owns the attributes.
--
--     Auth.signSlidingToken secret { sub = uid }
--         { windowSeconds = 900, maxLifetimeSeconds = 86400 }
signSlidingToken : String -> a -> { windowSeconds : Int
, maxLifetimeSeconds : Int
} -> Result Error String
signSlidingToken =
    Ffi.kernel "Auth_signSlidingToken"


-- | `setSlidingCookie req token resp` — set the sliding auth cookie on a
-- response at LOGIN time with the SAME attributes the re-issue middleware
-- uses (`Path=/`, HttpOnly, the builder's `SameSite`, `Secure` by the shared
-- rule, and the sliding Max-Age). Both this and the middleware build the
-- cookie from the ONE config `Live.withAuthSliding` registered, so the login
-- and re-issue attributes cannot drift.
--
-- The middleware cannot read cookie attributes off a later request (browsers
-- send only `name=value`), so the login handler MUST use this setter — a
-- hand-rolled `Server.withCookie` for the sliding cookie is unsupported.
setSlidingCookie : Request -> String -> Response -> Response
setSlidingCookie =
    Ffi.kernel "Auth_setSlidingCookie"

-- ─── PULL-model revocation + suspension ────────────────────────────
-- | The access state of a user, as reported by `userAccessState`.
--
--   - `Disabled` — the user is BANNED (`disableUser`); checked FIRST, and
--     enforced in `login` before the password verify (the re-login lock-out).
--   - `Revoked` — the user's existing sessions/tokens were invalidated
--     (`revokeUser`); a token/session whose issue time predates the revoke is
--     revoked, but a FRESH login after the revoke is Active again (revoke != ban).
--   - `Active` — neither disabled nor revoked.
type AccessState
    = Active
    | Revoked
    | Disabled


-- | `revokeUser db userId` — invalidate the user's EXISTING sessions/tokens
-- (== invalidateSessions): stamps `revoked_at = now` in the shared
-- `sky_revocations` table on the app `Db`. A live Sky.Live session bound to
-- this user (via `Live.bindSessionUser` / sliding-auth auto-bind) is EVICTED on
-- its next interaction, and a sliding token stops re-issuing. A fresh login
-- afterwards is NOT affected — this kills existing sessions, it does not ban the
-- user (use `disableUser` for a ban). `userId` is a String so an OAuth subject
-- or a large integer id both key exactly (an Int id passed as a String avoids
-- the JWT float64 precision floor at 2^53).
--
-- Sky provides the MECHANISM; your app owns the "is the caller an admin?"
-- authorization check before calling it.
revokeUser : Db -> String -> Task Error ()
revokeUser =
    Ffi.kernel "Auth_revokeUser"


-- | `disableUser db userId` — BAN the user: sets `users.disabled_at`. The
-- built-in `login` rejects a disabled user BEFORE the bcrypt verify, so they
-- cannot re-authenticate, and a live session is evicted on its next
-- interaction. Reverse with `enableUser`.
disableUser : Db -> String -> Task Error ()
disableUser =
    Ffi.kernel "Auth_disableUser"


-- | `enableUser db userId` — clear a `disableUser` ban. (Independent of
-- revocation: it does not clear a `revokeUser` stamp.)
enableUser : Db -> String -> Task Error ()
enableUser =
    Ffi.kernel "Auth_enableUser"


-- | `isRevoked db userId issuedAt` — True iff a token/session issued at
-- `issuedAt` (unix seconds) for `userId` predates the user's `revoked_at`. This
-- is the natural wiring for `Live.withAuthSliding`'s `revokedCheck` slide-stopper.
isRevoked : Db -> String -> Int -> Task Error Bool
isRevoked =
    Ffi.kernel "Auth_isRevoked"


-- | `isDisabled db userId` — True iff the user is banned (`disableUser`).
isDisabled : Db -> String -> Task Error Bool
isDisabled =
    Ffi.kernel "Auth_isDisabled"


-- | `userAccessState db userId issuedAt` — the combined verdict, with
-- `Disabled` (ban) taking precedence over `Revoked`. `issuedAt` is the unix
-- second the session/token was minted (its `iat`, or a live session's bind
-- time). Built on `isDisabled` + `isRevoked`.
userAccessState : Db -> String -> Int -> Task Error AccessState
userAccessState db userId issuedAt =
    isDisabled db userId
        |> Task.andThen
               (\disabled ->
                   if disabled then
                       Task.succeed Disabled

                   else
                       isRevoked db userId issuedAt
                           |> Task.map
                                  (\revoked ->
                                      if revoked then
                                          Revoked

                                      else
                                          Active))


-- | `signTokenWithClaims alg claims` — typed-builder alternative
-- to `signToken`.  Routes through `Sky.Core.Jwt.encode` so the
-- caller composes the algorithm + claims via the typed builders
-- (`Jwt.hs256 secret`, `Jwt.claims |> Jwt.issuer "..."` etc.).
--
-- The arity-3 `signToken` shape (`secret -> claims -> expirySeconds`)
-- stays the canonical short-form; reach for `signTokenWithClaims`
-- when you need fine-grained control over the algorithm + multi-
-- claim shape:
--
-- @
--     import Sky.Core.Jwt as Jwt
--     import Std.Auth as Auth
--     import Sky.Core.Time as Time
--
--     buildToken : Int -> Result Error String
--     buildToken now =
--         Auth.signTokenWithClaims
--             (Jwt.hs256 "secret")
--             (Jwt.claims
--                 |> Jwt.subject "user-42"
--                 |> Jwt.audience "https://example.app"
--                 |> Jwt.expiresAt (now + 86400)
--             )
-- @
signTokenWithClaims : Jwt.Algorithm -> Jwt.Claims -> Result Error String
signTokenWithClaims alg claims =
    Jwt.encode alg claims


-- | `verifyTokenWithAlgorithm alg now token` — typed-builder
-- mirror of `verifyToken` that delegates to `Sky.Core.Jwt.decode`.
-- The `now : Int` argument is the current unix-millis used for
-- `exp` / `nbf` window checks.
--
-- @
--     Auth.verifyTokenWithAlgorithm (Jwt.hs256 "secret") now token
-- @
verifyTokenWithAlgorithm : Jwt.Algorithm -> Int -> String -> Result Error String
verifyTokenWithAlgorithm alg now token =
    Jwt.decode alg now token
