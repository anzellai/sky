module Std.Image exposing
    ( Format(..)
    , Rgb
    , resizeToFit
    , thumbnail
    , dimensions
    , frames
    , reduceFrames
    , trim
    , crop
    , toAlpha
    , whiteToAlpha
    )

{-| Backend image resize, thumbnail, trim, crop and colour to alpha.

Operate on raw bytes (`Sky.Core.Bytes`, an alias of `String`) — decode the base64
payload of an upload first (`Sky.Core.Encoding.base64Decode`), resize, then write
with `Sky.Core.File.writeFile`. Scaling runs on the server (a Sky.Spa app resizes
in its backend, never in the wasm client), so an admin can upload a full-size
photo and the app serves a capped image plus a small thumbnail with no client-side
image code.

The output `Format` is the caller's choice: `Jpeg quality` (best for photos),
`Png` (lossless; keeps transparency, for logos/stickers), `Gif` (keeps an
animation), `WebpLossless` (lossless WebP), or `Preserve` (keep the source
format: a JPEG stays a JPEG at quality 85, a GIF stays a GIF with every frame,
a WebP becomes a lossless WebP, anything else becomes a PNG). When
you choose an explicit format you also know the file extension to save it under.
Resizing preserves the aspect ratio and NEVER upscales. A non-image or corrupt
input fails with a classified `Error`. JPEG, PNG, GIF and WebP (lossy or
lossless) are read.

**Animated GIF.** Written as `Gif` or `Preserve`, a GIF keeps every frame:
each operation runs on every frame as it is shown (the frame drawn over what
the earlier frames left), and each frame keeps its delay and the loop count.
Comments and other extensions are dropped. Written as `Jpeg`, `Png` or
`WebpLossless`, a GIF gives its first frame. `frames` counts the frames and
`reduceFrames` drops some to make the file smaller.

**Limits (decompression bombs).** A small file can claim a huge image. Every
function that decodes reads the header first and refuses, before it decodes
anything, an image over 100 megapixels (width x height), an animated GIF of more
than 1,000 frames, or one of more than 250 million pixels in all its frames
(width x height x frames). The refusal is an `InvalidInput` `Error` in the
domain `"image"` (`Error.domain`) with the code `too_many_pixels`,
`too_many_frames` or `too_many_frame_pixels` and the attributes `limit` and
`value`. `dimensions` and `frames` read the header only and never refuse, so
an app can check an upload first.

To clean up a logo on a white square: `trim` cuts the white margin, `whiteToAlpha`
makes the white transparent (keeping soft edges smooth), and `resizeToFit Png`
caps the size. All of it runs in the backend with no outside tools.

    import Std.Image as Image
    import Sky.Core.Encoding as Encoding
    import Sky.Core.File as File

    saveUpload : String -> Task Error String
    saveUpload dataUrl =
        case Encoding.base64Decode dataUrl of
            Ok bytes ->
                Image.resizeToFit (Image.Jpeg 85) 1600 1600 bytes
                    |> Task.andThen (\big -> File.writeFile "public/photo.jpg" big)
                    |> Task.andThen (\_ -> Image.thumbnail (Image.Jpeg 85) 400 bytes)
                    |> Task.andThen (\small -> File.writeFile "public/photo.thumb.jpg" small)
                    |> Task.map (\_ -> "/static/photo.jpg")

            Err e ->
                Task.fail e
-}

import Sky.Ffi as Ffi
import Sky.Core.Error exposing (Error)

{-| The output image format for a resize.

  - `Jpeg quality` — JPEG at `quality` (1..100; a value outside that range uses
    85). Best for photographs; smallest bytes.
  - `Png` — lossless PNG; preserves transparency (logos, stickers).
  - `Gif` — GIF. An animated GIF keeps every frame, its delays and its loop
    count; any other image becomes a GIF of one frame. A GIF holds 256 colours
    a frame, so a photograph is dithered, and its transparency is on or off.
  - `WebpLossless` — lossless WebP: every pixel is kept exactly, transparency
    included. Smaller than PNG for most graphics; larger than `Jpeg` for photos.
  - `Preserve` — keep the source format (JPEG stays JPEG at quality 85; GIF
    stays GIF with every frame; WebP becomes lossless WebP; PNG and anything
    else become PNG).
-}
type Format
    = Jpeg Int
    | Png
    | Gif
    | WebpLossless
    | Preserve


{-| Scale an image to fit within `maxWidth` x `maxHeight`, preserving the aspect
ratio and never enlarging, re-encoded in the chosen `Format`. The bytes in and out
are the raw image file contents (`Sky.Core.Bytes`). -}
resizeToFit : Format -> Int -> Int -> String -> Task Error String
resizeToFit fmt maxWidth maxHeight bytes =
    resize_ (formatName fmt) (formatQuality fmt) maxWidth maxHeight bytes


{-| Scale an image to fit within `maxDim` x `maxDim` — a square bound for a
thumbnail — re-encoded in the chosen `Format`. Preserves the aspect ratio and
never enlarges. -}
thumbnail : Format -> Int -> String -> Task Error String
thumbnail fmt maxDim bytes =
    resize_ (formatName fmt) (formatQuality fmt) maxDim maxDim bytes


{-| The pixel dimensions of an image, read from its header (cheap, no full
decode). Like the resize entries it is a `Task` — the whole module is a backend
capability, so every function is an effect. A non-image input is an `Err`. -}
dimensions : String -> Task Error { width : Int, height : Int }
dimensions =
    Ffi.kernel "Image_dimensions"


{-| The number of frames: the frame count of a GIF, 1 for any other image. It
reads the GIF's block structure only (no decode, no limit), so an app can show
"a GIF of N frames" or refuse one before any work. A non-image input is an
`Err`. Cost: O(bytes). -}
frames : String -> Task Error Int
frames =
    Ffi.kernel "Image_frames"


{-| Keep 1 frame in `n` of an animated GIF (frames 1, 1 + n, 1 + 2n, ...) and
add the delays of the dropped frames to the frame kept before them, so the
animation keeps its length. It is the main way to make a GIF smaller for an
email. The output is a GIF; every kept frame is written whole. An image that
is not a GIF comes back unchanged. `n` below 1 fails with `InvalidInput`.

    Image.reduceFrames 2 upload
        |> Task.andThen (Image.resizeToFit Image.Preserve 300 300)
-}
reduceFrames : Int -> String -> Task Error String
reduceFrames =
    Ffi.kernel "Image_reduceFrames"

{-| A colour as red, green and blue, each 0..255. -}
type alias Rgb =
    { red : Int
    , green : Int
    , blue : Int
    }


{-| Cut away the edge rows and columns that are only margin, and keep `padding`
pixels around what is left (never more than the image has). A pixel is margin
when it is fully transparent, or when its red, green and blue are each at least
`threshold` (0..255; 245 treats near-white as white). An image with no margin
keeps its size. An image that is all margin fails with `InvalidInput` ("nothing
left to trim to"). The output is written in the chosen `Format`; `Png` keeps
transparency. Every frame of an animated GIF is cut to one box, the one that
holds what is left of every frame. -}
trim : Format -> Int -> Int -> String -> Task Error String
trim fmt threshold padding bytes =
    trim_ (formatName fmt) (formatQuality fmt) threshold padding bytes


{-| Cut out the area that starts `x` pixels from the left and `y` pixels from
the top, `width` by `height`. An area that runs past the edge is cut at the
edge. An empty area, or a negative width or height, fails with `InvalidInput`.
The output is written in the chosen `Format`. -}
crop : Format -> Int -> Int -> Int -> Int -> String -> Task Error String
crop fmt x y width height bytes =
    crop_ (formatName fmt) (formatQuality fmt) x y width height bytes


{-| Make one background colour transparent ("colour to alpha"). Each pixel
keeps its own colour and gets the coverage that, laid back over the background
colour, gives the original pixel, so soft and anti-aliased edges stay smooth.
The background colour itself becomes fully transparent. The output is PNG; an animated GIF
stays an animated GIF (every frame keyed, with on-or-off transparency). A channel outside 0..255 fails with `InvalidInput`. -}
toAlpha : Rgb -> String -> Task Error String
toAlpha colour bytes =
    toAlpha_ colour.red colour.green colour.blue bytes


{-| `toAlpha` with white as the background: makes a white background
transparent. The output is PNG (an animated GIF stays an animated GIF). -}
whiteToAlpha : String -> Task Error String
whiteToAlpha bytes =
    toAlpha { red = 255, green = 255, blue = 255 } bytes


-- The primitive resize kernel (format string + quality int + bounds + bytes).
-- The `Format` ADT is translated to these primitives above so the FFI boundary
-- carries no Sky ADT.
resize_ : String -> Int -> Int -> Int -> String -> Task Error String
resize_ =
    Ffi.kernel "Image_resize"


-- The primitive edit kernels: the `Format` and the `Rgb` record are passed as
-- primitives, like `resize_`.
trim_ : String -> Int -> Int -> Int -> String -> Task Error String
trim_ =
    Ffi.kernel "Image_trim"


crop_ : String -> Int -> Int -> Int -> Int -> Int -> String -> Task Error String
crop_ =
    Ffi.kernel "Image_crop"


toAlpha_ : Int -> Int -> Int -> String -> Task Error String
toAlpha_ =
    Ffi.kernel "Image_toAlpha"


formatName : Format -> String
formatName fmt =
    case fmt of

        Jpeg _ ->
            "jpeg"

        Png ->
            "png"

        Gif ->
            "gif"

        WebpLossless ->
            "webp"

        Preserve ->
            "preserve"


formatQuality : Format -> Int
formatQuality fmt =
    case fmt of

        Jpeg q ->
            q

        Png ->
            0

        Gif ->
            0

        WebpLossless ->
            0

        Preserve ->
            0
