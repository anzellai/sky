-- | Std.Spa — client-side TEA (Sky.Spa), the browser counterpart of Std.Live.
--
-- **DEPRECATED for direct use — write `Std.App` instead.** `Std.App` composes
-- this module for the client targets (`--target web:app` / `mobile:*` /
-- `desktop:*`), synthesising the split from your `App.app`. Still functional,
-- but new code should use `App.app` + `App.run`. See docs/skyapp/overview.md.
--
-- An app is written EXACTLY like a Sky.Live app — the same `Model`, `Msg`,
-- pure `update`, and `view` over the renderer-agnostic `Std.Html` /
-- `Std.Ui` — but the TEA loop runs on the CLIENT, compiled to
-- `GOOS=js GOARCH=wasm`. Pure `update` branches run in the browser with zero
-- round-trip; there is no server session, no SSE.
--
-- ```elm
-- main =
--     Spa.app
--         (Spa.config
--             { init = Model.init
--             , update = Update.update
--             , view = View.view
--             , subscriptions = Subs.subscriptions
--             }
--             |> Spa.withRoutes
--                 [ Spa.route "/" Home
--                 , Spa.route "/about" About
--                 ]
--             |> Spa.withNotFound NotFound
--         )
-- ```
--
-- Every binding is an `Ffi.kernel` alias carrying its real HM signature (the
-- routing kernels), so the type-checker, LSP hover, and `sky doc` all read this
-- ONE file; the boundary helpers (`getJson` / `postJson`) are ordinary Sky over
-- `Cmd.perform` + `Http` + `Codec`, so they add no runtime surface. The runtime
-- kernels are `rt.Spa_config` / `rt.Spa_app` / `rt.Spa_route` /
-- `rt.Spa_withRoutes` / `rt.Spa_withNotFound` / `rt.Spa_withOnNavigate`
-- (spa_core.go); the client driver is `live_wasm.go` (`//go:build js`).
--
-- Client effects run through the single-threaded wasm interpreter —
-- `Cmd.perform` (sync kernels like `Time.now`/`Random`/`Uuid` inline, async
-- `Http` via `fetch`), and `Sub.every` timers.
--
-- ## Routing (opt-in, History API)
--
-- Routing is attached with the `withX` builders, not the core `config` record,
-- so a single-view app (a counter) needs no `routes`/`notFound`. `route`,
-- `withRoutes`, `withNotFound`, and `withOnNavigate` read exactly like Sky.Live
-- (same names, same convention). The convention (inherited from Sky.Live): a
-- routed app's `Model` has a `page` field; on navigation the runtime resolves
-- `location.pathname` to a route and sets `model.page`, re-renders, and — if
-- `withOnNavigate` is set — dispatches `onNavigate page` through `update`.
-- Internal `<a href>` clicks are intercepted (History `pushState`, no page
-- reload); Back/Forward (`popstate`) is honoured; an external host, a
-- `target="_blank"`, a `download`, a `sky-external` mark, or a modified click
-- is left to the browser as a real navigation.
--
-- ## The explicit typed server boundary
--
-- `getJson` / `postJson` are the ergonomic path for talking to a STATELESS Sky
-- backend over `Http`, decoding the response with a `Std.Codec` that is the
-- SAME codec compiled into the backend — one type, one codec, one wire
-- contract (no OpenAPI/TS drift). They hand `update` a `Result Error a`
-- directly (2xx + decoded, or an `Err`), so the app writes one `case`, not two.
--
-- SECURITY — the client runs on the USER'S machine and is UNTRUSTED. These
-- helpers are transport, not trust: they carry no ambient authority. The
-- backend MUST re-validate and re-authorize every request and re-read
-- authoritative data (price, role, ownership) from its own store — it may never
-- trust a client-sent field for anything security-relevant. Auth is an explicit
-- header/cookie the author adds and the backend verifies with `Std.Auth` on
-- every call; there is no session a client can spoof, because the backend is
-- stateless. Typed secrets (`Auth.signToken` takes `String`) + the production
-- gate carry over unchanged.
module Std.Spa exposing
    ( AppConfig
    , Route
    , app
    , config
    , route
    , routeInt
    , withRoutes
    , withNotFound
    , withOnNavigate
    , withHead
    , withModelDecoder
    , getJson
    , postJson
    )

import Sky.Ffi as Ffi
import Sky.Core.Error as Error exposing (Error)
import Sky.Core.String as String
import Sky.Core.Http as Http exposing (HttpResponse)
import Std.Cmd as Cmd
import Sky.Core.Task as Task
import Std.Codec as Codec exposing (Codec)
import Std.Html exposing (Html)

-- | The built Sky.Spa app configuration. Opaque — produced by `config`,
-- refined by the `withX` builders, consumed by `app`. Phantom `model` / `msg`
-- thread the TEA types through the builder chain.
type AppConfig model msg
    = AppConfig_OPAQUE


-- | A client-side route, produced by `route` and registered with `withRoutes`.
-- Opaque — its runtime shape (`rt.spaRoute`) is an implementation detail.
type Route
    = Route_OPAQUE


-- | Build the client app config from the four required TEA fields. Attach
-- routing with `withRoutes` / `withNotFound` / `withOnNavigate`.
--
--     main =
--         Spa.app
--             (Spa.config
--                 { init = init
--                 , update = update
--                 , view = view
--                 , subscriptions = subscriptions
--                 }
--             )
--
-- `subscriptions : model -> Sub msg` is evaluated after every `update`; the
-- client driver reconciles the active `Sub.every` timers against the result
-- (starts new intervals, stops removed ones, leaves unchanged ones running).
-- Use `\_ -> Sub.none` when the app has no ongoing subscriptions.
config :
    { init : a -> ( model, Cmd msg )
    , update : msg -> model -> ( model, Cmd msg )
    , view : model -> Html msg
    , subscriptions : model -> Sub msg
    }
    -> AppConfig model msg
config =
    Ffi.kernel "Spa_config"


-- | Run the Sky.Spa client app. Returns a `Task` so `main` forces it exactly
-- like `Live.app` — the wasm driver then owns the browser event loop.
app : AppConfig model msg -> Task Error ()
app =
    Ffi.kernel "Spa_app"


-- | `route path page` — register a client-side page route. `path` may contain
-- `:param` segments (`/thing/:id`); a captured segment is passed to the page
-- value if it is a constructor (`ThingPage : String -> Page`). Put literal
-- routes before `:param` patterns (declaration order matters).
route : String -> page -> Route
route =
    Ffi.kernel "Spa_route"


-- | `routeInt path toPage` — a route whose `:param` segment(s) are **Ints**.
-- `toPage` is a constructor taking Int (`TodoPage : Int -> Page`); the captured
-- segment is parsed to an Int before it reaches the constructor, so the page
-- carries a typed `Int`, not a `String` you re-parse in `view`. A segment that
-- is not a valid integer makes the route **not match** — `/todo/abc` falls
-- through to the next route or `withNotFound`, exactly as an invalid id should.
--
--     |> Spa.withRoutes
--         [ Spa.route "/" Home
--         , Spa.routeInt "/todo/:id" TodoDetail   -- TodoDetail : Int -> Page
--         ]
--
-- (The runtime cannot see the constructor's parameter type under the erased ABI,
-- so the Int-ness is declared here at the route rather than inferred.)
routeInt : String -> (Int -> page) -> Route
routeInt =
    Ffi.kernel "Spa_routeInt"


-- | Register the client-side routes. The runtime resolves `location.pathname`
-- against them on mount, on an intercepted internal-link click, and on
-- Back/Forward, setting the model's `page` field to the matched route's page.
withRoutes : List Route -> AppConfig model msg -> AppConfig model msg
withRoutes =
    Ffi.kernel "Spa_withRoutes"


-- | The page to show when no route matches (the 404). Without it, an unmatched
-- URL leaves the model's `page` unchanged.
withNotFound : page -> AppConfig model msg -> AppConfig model msg
withNotFound =
    Ffi.kernel "Spa_withNotFound"


-- | Hook fired on in-app navigation (initial mount, intercepted click,
-- popstate) AFTER the route is applied — the runtime passes the new page value
-- and dispatches the resulting `msg` through `update`. Ignore the page
-- (`\_ -> ResetBanner`) to run one effect on every navigation, or pattern-match
-- it (`\page -> case page of …`) to react per-destination.
withOnNavigate : (page -> msg) -> AppConfig model msg -> AppConfig model msg
withOnNavigate =
    Ffi.kernel "Spa_withOnNavigate"


-- | Set the document `<head>` builder — `head model` returns the `<head>`
-- children (title, meta, link) for the current (route-resolved) model. The SSR
-- backend runs it per route through the SAME `Std.Html` → HTML renderer Sky.Live
-- uses (`renderAppHead`), so a Sky.Spa content site gets a correct per-route
-- `<head>` for SEO. Mirrors `App.withHead` / `Live.withHead`; the wasm client
-- never re-renders head into `<body>` (head stays server-owned).
--
--     |> Spa.withHead (\m -> [ Head.title m.post.title, Head.meta "description" m.post.summary ])
withHead : (model -> List (Html msg)) -> AppConfig model msg -> AppConfig model msg
withHead =
    Ffi.kernel "Spa_withHead"


-- | Set the model DECODER — `decode json` turns the SSR-embedded `#sky-model`
-- JSON blob (the string the backend wrote with `Codec.toJson (Codec.auto model)`)
-- back into the TYPED initial model, so the wasm client boots from the
-- server-resolved data instead of re-running the effectful `init` (design §4.5).
-- Symmetric with the backend embed: `\s -> Codec.fromJson (Codec.auto blank) s`.
-- The auto-split synthesises this from the app's `init` when the SSR backend
-- settles a GET-safe read; a hand-authored Sky.Spa app can set it directly to
-- hydrate from an embedded model. The client uses it ONLY when the mount carries
-- `data-sky-ssr` and a `#sky-model` blob is present; otherwise `init` runs as
-- usual.
withModelDecoder : (String -> Result Error model) -> AppConfig model msg -> AppConfig model msg
withModelDecoder =
    Ffi.kernel "Spa_withModelDecoder"


-- | `getJson codec url toMsg` — GET `url` from the stateless backend and decode
-- the 2xx body with the shared `codec`, handing `update` a `Result Error a`.
--
--     Refresh ->
--         ( { model | items = Loading }
--         , Spa.getJson itemsCodec (model.apiBase ++ "/items") GotItems )
--
--     GotItems (Ok items) -> ( { model | items = Loaded items }, Cmd.none )
--     GotItems (Err e)    -> ( { model | items = Failed e }, Cmd.none )
--
-- A non-2xx status or a decode failure is an `Err`; a network/fetch failure is
-- an `Err`. SECURITY: see the module note — the backend re-validates every
-- request; the client is untrusted.
getJson : Codec a -> String -> (Result Error a -> msg) -> Cmd msg
getJson codec url toMsg =
    Cmd.perform (Task.andThenResult (decodeResponse codec) (Http.get url)) toMsg


-- | `postJson bodyCodec respCodec url payload toMsg` — encode `payload` with
-- `bodyCodec`, POST it as JSON to `url`, and decode the 2xx response with
-- `respCodec`, handing `update` a `Result Error a`. Same shared-codec + typed
-- `Result` contract as `getJson`. SECURITY: the backend re-validates every
-- request; never trust the posted body for anything authoritative.
postJson : Codec body -> Codec a -> String -> body -> (Result Error a -> msg) -> Cmd msg
postJson bodyCodec respCodec url payload toMsg =
    Cmd.perform
        (Task.andThenResult (decodeResponse respCodec)
            (Http.post url (Codec.toJson bodyCodec payload))
        )
        toMsg


-- | Decode an HTTP response body with a codec, treating a non-2xx status as an
-- error rather than attempting to decode an error page as the success type. A
-- 4xx/5xx is a completed round trip (a value, not a transport failure — see
-- `http_wasm.go`), so it arrives here as `Ok resp`; we turn it into an `Err`
-- carrying the status + body so the app can surface it.
decodeResponse : Codec a -> HttpResponse -> Result Error a
decodeResponse codec resp =
    if resp.status >= 200 && resp.status < 300 then
        Codec.fromJson codec resp.body

    else
        Err
            (Error.unexpected
                ("HTTP " ++ String.fromInt resp.status ++ ": " ++ resp.body)
            )
