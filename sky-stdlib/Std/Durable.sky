module Std.Durable exposing
    ( Ctx
    , WorkflowDef
    , RegisteredWorkflow
    , register
    , registerVersioned
    , erase
    , conn
    , runId
    , setup
    , start
    , signal
    , poll
    , VersionPolicy(..)
    , pollWith
    , step
    , stepValue
    , sleep
    , awaitSignal
    , isSuspend
    , compact
    , saveSnapshot
    , saveSnapshotAuto
    , loadSnapshot
    , SnapshotEvent(..)
    , restoreCmd
    , snapshotCmd
    , applyRestore
    )

{-| `Std.Durable` — durable, resumable workflows over `Std.Db` (Postgres or
SQLite). A workflow is an ordinary `Task` that marks its side-effecting
boundaries with `step`; each step's result is journalled, so on a restart the
workflow re-runs from the top and a completed step returns its recorded value
instead of re-executing. `sleep` and `awaitSignal` suspend the run passively — a
run blocked on a timer or a human approval holds no process; a worker `poll`
claims it again when it is due. It is a general server primitive (checkout /
payment sagas, order fulfilment, onboarding, approvals), not AI-specific.

Design + guarantees: `docs/design/durable-execution.md`.

## The determinism contract

The body re-runs from the top on every resume, so code BETWEEN steps must be
deterministic: no `Time.now` / `Uuid` / `Random` / direct I/O outside a `step`
(use `stepValue` to journal a fresh id or timestamp). Every effect goes in a
`step`, whose result is journalled and replayed.

## Sketch

    checkout : Durable.Ctx -> Input -> Task Error OrderId
    checkout ctx input =
        Durable.step ctx reserveCodec "reserve" (Inventory.reserve input.items)
            |> Task.andThen (\r ->
                Durable.step ctx chargeCodec "charge" (Payments.charge input.card)
                |> Task.andThen (\c ->
                    Durable.awaitSignal ctx settledCodec "payment.settled"
                    |> Task.andThen (\s ->
                        Durable.step ctx orderCodec "finalise" (Orders.finalise r c s))))

    -- once, at startup:
    Durable.setup db

    -- start an instance (idempotent on the id):
    Durable.start db checkoutDef "cart-42" input

    -- in a worker tick (Sub.every / a Cli loop):
    Durable.poll db [ Durable.erase checkoutDef ]
-}

import Sky.Core.Prelude exposing (..)
import Sky.Core.Task as Task
import Sky.Core.Error as Error exposing (Error(..))
import Sky.Core.List as List
import Sky.Core.String as String
import Sky.Core.Time as Time
import Sky.Core.Dict as Dict exposing (Dict)
import Sky.Core.Maybe exposing (Maybe(..))
import Sky.Core.Result exposing (Result(..))
import Std.Codec as Codec exposing (Codec)
import Std.Cmd as Cmd
import Std.Db as Db exposing (Db, SqlValue(..))
import Std.Db.Store as Store

-- ---------------------------------------------------------------------------
-- Types
-- ---------------------------------------------------------------------------
{-| The execution context threaded through a workflow body: the shared database
handle and the run's id. Every `step` / `sleep` / `awaitSignal` takes it.
-}
type Ctx
    = Ctx { db : Db
, runId : String
}

{-| A typed, registered workflow: its name, the input codec (so `start` can
encode), and its type-erased runner. Build it with `register`.
-}
type WorkflowDef i o
    = WorkflowDef { name : String
, version : String
, inputCodec : Codec i
, erased : RegisteredWorkflow
}

{-| A workflow with its input/output types erased to JSON, so the runner can hold
a heterogeneous list of them and dispatch by name. Get it with `erase`.
-}
type RegisteredWorkflow
    = RegisteredWorkflow { name : String
, version : String
, run : Ctx -> String -> Task Error String
}


-- The lease visibility timeout: a run claimed longer ago than this is reclaimed
-- by a peer (its worker is presumed dead). 30 minutes, matching Std.Jobs.
leaseMs : Int
leaseMs =
    30 * 60 * 1000


-- Far-future wake, for a run parked on an awaitSignal (woken by `signal`, not a
-- timer). ~Year 5000 in ms.
farFuture : Int
farFuture =
    95617584000000


-- The suspend sentinel. `sleep` / `awaitSignal` fail with this to unwind the body
-- when their wake condition is not met; the runner recognises it (`isSuspend`)
-- and treats it as a suspension, not a failure.
suspendMarker : String
suspendMarker =
    "\u{0001}sky.durable.suspend\u{0001}"


suspendError : Error
suspendError =
    Error.unexpected suspendMarker


{-| Is this error the durable suspend sentinel (as opposed to a real failure)?
The runner uses it; user code rarely needs it.
-}
isSuspend : Error -> Bool
isSuspend err =
    case err of

        Error _ info ->
            info.message == suspendMarker


-- ---------------------------------------------------------------------------
-- Registration
-- ---------------------------------------------------------------------------
{-| Register a workflow: a stable `name`, the input and output codecs, and the
body `Ctx -> input -> Task Error output`. The result is a typed handle for
`start`; pass `erase` of it to `poll`.
-}
register : String -> Codec i -> Codec o -> (Ctx -> i -> Task Error o) -> WorkflowDef i o
register name inputCodec outputCodec body =
    registerVersioned name "1" inputCodec outputCodec body


{-| Register a workflow at an explicit VERSION. A run is stamped with the def's
version at `start`; on resume, `poll` reconciles the run's stamped version against
the registered defs (see `pollWith`). Use it to run two versions of the same
workflow side by side while in-flight runs drain on the old code. `register` is
`registerVersioned name "1"`.
-}
registerVersioned : String -> String -> Codec i -> Codec o -> (Ctx -> i -> Task Error o) -> WorkflowDef i o
registerVersioned name version inputCodec outputCodec body =
    WorkflowDef
        { name = name
        , version = version
        , inputCodec = inputCodec
        , erased =
            RegisteredWorkflow
                { name = name
                , version = version
                , run =
                    \ctx inputJson ->
                        case Codec.fromJson inputCodec inputJson of

                            Ok input ->
                                body ctx input
                                    |> Task.map
                                           (\output ->
                                               Codec.toJson outputCodec output)

                            Err e ->
                                Task.fail e
                }
        }


{-| The type-erased form of a workflow, for the runner's `poll` list. -}
erase : WorkflowDef i o -> RegisteredWorkflow
erase (WorkflowDef d) =
    d.erased


{-| The database handle for this run, for a `step`'s own DB effects (so a
workflow body does not need to thread a connection separately): e.g.
`Durable.step ctx codec "charge" (chargeCard (Durable.conn ctx) …)`.
-}
conn : Ctx -> Db
conn (Ctx c) =
    c.db


{-| The id of the run this workflow body is executing under — the key passed to
`start`. Use it to key per-run records (a cost trace, an audit row) to the run.
-}
runId : Ctx -> String
runId (Ctx c) =
    c.runId


-- ---------------------------------------------------------------------------
-- Schema
-- ---------------------------------------------------------------------------
{-| Create the durable tables if they do not exist. Idempotent; call once at
startup. Works on Postgres and SQLite (times are epoch-ms integers, so no
timestamp-type marshalling).
-}
setup : Db -> Task Error ()
setup db =
    Db.execRaw
        db
        ("CREATE TABLE IF NOT EXISTS _sky_durable_runs ("
            ++ "id TEXT PRIMARY KEY, workflow TEXT NOT NULL, version TEXT NOT NULL DEFAULT '', "
            ++ "status TEXT NOT NULL, "
            ++ "input TEXT NOT NULL, output TEXT, attempts INTEGER NOT NULL DEFAULT 0, "
            ++ "wake_at BIGINT NOT NULL, waiting_signal TEXT, last_error TEXT NOT NULL DEFAULT '', "
            ++ "claimed_at BIGINT, created_at BIGINT NOT NULL, updated_at BIGINT NOT NULL)")
        |> Task.andThen
               (\_ ->
                   -- Idempotent migration: a table created before workflow versioning
                   -- lacks the `version` column. ADD COLUMN it; a duplicate-column
                   -- error (new table, or a re-run) is swallowed, so setup stays
                   -- idempotent on both fresh and existing databases.
                   Db.execRaw
                       db
                       "ALTER TABLE _sky_durable_runs ADD COLUMN version TEXT NOT NULL DEFAULT ''"
                       |> Task.onError (\_ -> Task.succeed 0))
        |> Task.andThen
               (\_ ->
                   Db.execRaw
                       db
                       ("CREATE TABLE IF NOT EXISTS _sky_durable_journal ("
                           ++ "run_id TEXT NOT NULL, step_id TEXT NOT NULL, result TEXT NOT NULL, "
                           ++ "created_at BIGINT NOT NULL, PRIMARY KEY (run_id, step_id))"))
        |> Task.andThen
               (\_ ->
                   Db.execRaw
                       db
                       ("CREATE TABLE IF NOT EXISTS _sky_durable_signals ("
                           ++ "run_id TEXT NOT NULL, name TEXT NOT NULL, payload TEXT NOT NULL, "
                           ++ "created_at BIGINT NOT NULL, PRIMARY KEY (run_id, name))"))
        |> Task.andThen
               (\_ ->
                   Db.execRaw
                       db
                       ("CREATE TABLE IF NOT EXISTS _sky_durable_snapshot ("
                           ++ "run_id TEXT PRIMARY KEY, seq BIGINT NOT NULL, model_json TEXT NOT NULL, "
                           ++ "updated_at BIGINT NOT NULL)"))
        |> Task.map (\_ -> ())


-- ---------------------------------------------------------------------------
-- Start + signal
-- ---------------------------------------------------------------------------
{-| Start a workflow instance, keyed by `id` (the caller's idempotency key). A
second `start` with the same id is a no-op — the existing run is untouched.
-}
start : Db -> WorkflowDef i o -> String -> i -> Task Error ()
start db (WorkflowDef d) id input =
    Time.now ()
        |> Task.andThen
               (\now ->
                   Db.exec
                       db
                       ("INSERT INTO _sky_durable_runs "
                           ++ "(id, workflow, version, status, input, attempts, wake_at, last_error, created_at, updated_at) "
                           ++ "VALUES (?, ?, ?, 'running', ?, 0, ?, '', ?, ?) "
                           ++ "ON CONFLICT (id) DO NOTHING")
                       [ SqlString id
                       , SqlString d.name
                       , SqlString d.version
                       , SqlString (Codec.toJson d.inputCodec input)
                       , SqlInt now
                       , SqlInt now
                       , SqlInt now
                       ]
                       |> Task.map (\_ -> ()))


{-| Deliver a named signal to a run, waking an `awaitSignal` that is blocked on
it. Idempotent per (run, name). The run becomes claimable immediately.
-}
signal : Db -> String -> String -> Codec a -> a -> Task Error ()
signal db runId name codec payload =
    Time.now ()
        |> Task.andThen
               (\now ->
                   Db.exec
                       db
                       ("INSERT INTO _sky_durable_signals (run_id, name, payload, created_at) "
                           ++ "VALUES (?, ?, ?, ?) ON CONFLICT (run_id, name) DO NOTHING")
                       [ SqlString runId
                       , SqlString name
                       , SqlString (Codec.toJson codec payload)
                       , SqlInt now
                       ]
                       |> Task.andThen
                              (\_ ->
                                  Db.exec
                                      db
                                      ("UPDATE _sky_durable_runs SET wake_at = ?, waiting_signal = NULL, updated_at = ? "
                                          ++ "WHERE id = ?")
                                      [ SqlInt now
                                      , SqlInt now
                                      , SqlString runId
                                      ])
                       |> Task.map (\_ -> ()))

-- ---------------------------------------------------------------------------
-- Workflow-body primitives
-- ---------------------------------------------------------------------------
-- One-column row shapes for typed reads.
type alias ResultRow =
    { result : String }


resultRowCodec : Codec ResultRow
resultRowCodec =
    Codec.auto { result = "" }

type alias PayloadRow =
    { payload : String }


payloadRowCodec : Codec PayloadRow
payloadRowCodec =
    Codec.auto { payload = "" }


-- Read a journalled step result, if present.
readJournal : Db -> String -> String -> Task Error (Maybe String)
readJournal db runId stepId =
    Store.selectRaw
        db
        resultRowCodec
        "SELECT result FROM _sky_durable_journal WHERE run_id = ? AND step_id = ?"
        [ SqlString runId, SqlString stepId ]
        |> Task.map
               (\rows ->
                   case List.head rows of

                       Just row ->
                           Just row.result

                       Nothing ->
                           Nothing)


-- Write a journalled step result. `ON CONFLICT DO NOTHING` keeps it write-once,
-- so a re-run that raced never overwrites a recorded result.
writeJournal : Db -> String -> String -> String -> Task Error ()
writeJournal db runId stepId json =
    Time.now ()
        |> Task.andThen
               (\now ->
                   Db.exec
                       db
                       ("INSERT INTO _sky_durable_journal (run_id, step_id, result, created_at) "
                           ++ "VALUES (?, ?, ?, ?) ON CONFLICT (run_id, step_id) DO NOTHING")
                       [ SqlString runId
                       , SqlString stepId
                       , SqlString json
                       , SqlInt now
                       ]
                       |> Task.map (\_ -> ()))


{-| Run a side-effecting `task` as a durable step, journalled under `stepId`. On
the first execution the task runs and its result is recorded; on a resume the
recorded result is returned and the task does NOT run again. `stepId` must be
stable and unique within the workflow body.
-}
step : Ctx -> Codec a -> String -> Task Error a -> Task Error a
step (Ctx c) codec stepId task =
    readJournal c.db c.runId stepId
        |> Task.andThen
               (\maybe ->
                   case maybe of

                       Just json ->
                           Task.fromResult (Codec.fromJson codec json)

                       Nothing ->
                           task
                               |> Task.andThen
                                      (\result ->
                                          writeJournal
                                              c.db
                                              c.runId
                                              stepId
                                              (Codec.toJson codec result)
                                              |> Task.map (\_ -> result)))


{-| Journal a fresh, nondeterministic PURE value (a uuid, a timestamp) so it is
stable across resumes. `thunk` is evaluated once, its result recorded; a resume
returns the recorded value. Use this instead of calling `Uuid.v4` / `Time.now`
directly between steps.
-}
stepValue : Ctx -> Codec a -> String -> (() -> a) -> Task Error a
stepValue ctx codec stepId thunk =
    step ctx codec stepId (Task.lazy thunk)


{-| Suspend the run for `ms` from now, passively. On the first hit it records the
wake time and suspends (the run holds no process); when the timer is due a worker
`poll` resumes the body and this returns `()`. `sleepId` must be stable.
-}
sleep : Ctx -> String -> Int -> Task Error ()
sleep (Ctx c) sleepId ms =
    let
        key = "__sleep:" ++ sleepId
    in
        readJournal c.db c.runId key
            |> Task.andThen
                   (\maybe ->
                       case maybe of

                           Just _ ->
                               Task.succeed ()

                           Nothing ->
                               Time.now ()
                                   |> Task.andThen
                                          (\now ->
                                              let
                                                  wake = now + ms
                                              in
                                                  writeJournal
                                                      c.db
                                                      c.runId
                                                      key
                                                      (String.fromInt wake)
                                                      |> Task.andThen
                                                             (\_ ->
                                                                 setWake
                                                                     c.db
                                                                     c.runId
                                                                     wake)
                                                      |> Task.andThen
                                                             (\_ ->
                                                                 Task.fail
                                                                     suspendError)))


{-| Suspend the run until a signal named `name` is delivered (by `signal`), then
return its decoded payload. A run parked here holds no process and no timer; it
wakes only when the signal arrives.
-}
awaitSignal : Ctx -> Codec a -> String -> Task Error a
awaitSignal (Ctx c) codec name =
    Store.selectRaw
        c.db
        payloadRowCodec
        "SELECT payload FROM _sky_durable_signals WHERE run_id = ? AND name = ?"
        [ SqlString c.runId, SqlString name ]
        |> Task.andThen
               (\rows ->
                   case List.head rows of

                       Just row ->
                           Task.fromResult (Codec.fromJson codec row.payload)

                       Nothing ->
                           setWaitingSignal c.db c.runId name
                               |> Task.andThen (\_ -> Task.fail suspendError))


setWake : Db -> String -> Int -> Task Error ()
setWake db runId wake =
    Time.now ()
        |> Task.andThen
               (\now ->
                   Db.exec
                       db
                       "UPDATE _sky_durable_runs SET wake_at = ?, updated_at = ? WHERE id = ?"
                       [ SqlInt wake, SqlInt now, SqlString runId ]
                       |> Task.map (\_ -> ()))


setWaitingSignal : Db -> String -> String -> Task Error ()
setWaitingSignal db runId name =
    Time.now ()
        |> Task.andThen
               (\now ->
                   Db.exec
                       db
                       ("UPDATE _sky_durable_runs SET status = 'waiting', waiting_signal = ?, wake_at = ?, "
                           ++ "updated_at = ? WHERE id = ?")
                       [ SqlString name
                       , SqlInt farFuture
                       , SqlInt now
                       , SqlString runId
                       ]
                       |> Task.map (\_ -> ()))

-- ---------------------------------------------------------------------------
-- The runner
-- ---------------------------------------------------------------------------
type alias ClaimRow =
    { id : String
    , workflow : String
    , version : String
    , input : String
    }


dictGet : String -> Dict String String -> String
dictGet key row =
    case Dict.get key row of

        Just v ->
            v

        Nothing ->
            ""


{-| Claim one due run and advance it until it suspends or completes. Returns
`True` if it did work (so a poll loop drains, re-firing until `False`), `False`
if there was nothing due. Mount it on a tick (a `Sub.every` in a Sky.Live /
`Std.App` app, or a loop in a `Sky.Cli` daemon). Horizontal scale is free: run
more instances; each claims independently.
-}
poll : Db -> List RegisteredWorkflow -> Task Error Bool
poll db defs =
    pollWith db FailSafe defs

{-| How `poll` reconciles a claimed run whose stamped version has no matching
registered definition (the run was started under a workflow version that is no
longer in this worker's `poll` list):

  - `FailSafe` — mark the run `failed` with a version-mismatch error. The default
    (`poll`): a run must have code to advance it, and silently stalling is worse
    than a visible failure you can act on.
  - `PinToStart` — leave the run alone (release its lease) so a worker still
    running the run's original version can claim it. Use it during a rolling
    deploy where old and new workers coexist: register both versions
    (`registerVersioned`) on the workers that have the old code.

A run whose registered version DOES match, and a legacy run stamped with no
version (started before versioning), always advance normally.
-}
type VersionPolicy
    = FailSafe
    | PinToStart


{-| `poll` with an explicit `VersionPolicy`. `poll = pollWith FailSafe`. -}
pollWith : Db -> VersionPolicy -> List RegisteredWorkflow -> Task Error Bool
pollWith db policy defs =
    Time.now ()
        |> Task.andThen
               (\now ->
                   claim db now
                       |> Task.andThen
                              (\maybe ->
                                  case maybe of

                                      Nothing ->
                                          Task.succeed False

                                      Just row ->
                                          advance db policy defs row
                                              |> Task.map (\_ -> True)))


-- Optimistic, dialect-portable claim: pick the oldest-due candidate, then take it
-- with a guarded atomic UPDATE. If the UPDATE hits 0 rows a peer won it — return
-- nothing this tick. Correct under concurrency without `FOR UPDATE SKIP LOCKED`.
claim : Db -> Int -> Task Error (Maybe ClaimRow)
claim db now =
    Db.query
        db
        ("SELECT id, workflow, version, input FROM _sky_durable_runs "
            ++ "WHERE status IN ('running', 'waiting') AND wake_at <= ? "
            ++ "AND (claimed_at IS NULL OR claimed_at < ?) "
            ++ "ORDER BY wake_at ASC LIMIT 1")
        [ SqlInt now, SqlInt (now - leaseMs) ]
        |> Task.andThen
               (\rows ->
                   case List.head rows of

                       Nothing ->
                           Task.succeed Nothing

                       Just row ->
                           let
                               rowId = dictGet "id" row
                           in
                               Db.exec
                                   db
                                   ("UPDATE _sky_durable_runs SET claimed_at = ?, status = 'running', "
                                       ++ "attempts = attempts + 1, updated_at = ? "
                                       ++ "WHERE id = ? AND (claimed_at IS NULL OR claimed_at < ?)")
                                   [ SqlInt now
                                   , SqlInt now
                                   , SqlString rowId
                                   , SqlInt (now - leaseMs)
                                   ]
                                   |> Task.map
                                          (\affected ->
                                              if affected == 1 then
                                                  Just
                                                      { id = rowId
                                                      , workflow =
                                                          dictGet "workflow" row
                                                      , version =
                                                          dictGet "version" row
                                                      , input =
                                                          dictGet "input" row
                                                      }

                                              else
                                                  Nothing))


advance : Db -> VersionPolicy -> List RegisteredWorkflow -> ClaimRow -> Task Error ()
advance db policy defs row =
    case findDef row.workflow row.version defs of

        Just (RegisteredWorkflow def) ->
            def.run (Ctx { db = db, runId = row.id }) row.input
                |> Task.andThen (\output -> markDone db row.id output)
                |> Task.onError
                       (\err ->
                           if isSuspend err then
                               releaseLease db row.id

                           else
                               markFailed db row.id (Error.toString err))

        Nothing ->
            if anyNamed row.workflow defs then
                case policy of

                    FailSafe ->
                        markFailed
                            db
                            row.id
                            ("version mismatch: run version '" ++ row.version
                                ++ "' of workflow '"
                                ++ row.workflow
                                ++ "' has no registered definition")

                    PinToStart ->
                        -- Park it (status 'waiting', lease released) for a worker
                        -- running the run's own version to claim and advance.
                        parkForVersion db row.id

            else
                -- The workflow name is registered, but not at this run's version.
                markDead
                    db
                    row.id
                    ("no registered workflow named " ++ row.workflow)


-- Find a def matching `name` AND `version`. A legacy run stamped with an empty
-- version (started before versioning) matches by name only, for back-compat.
findDef : String -> String -> List RegisteredWorkflow -> Maybe RegisteredWorkflow
findDef name version defs =
    List.filter
        (\(RegisteredWorkflow d) ->
            d.name == name && (version == "" || d.version == version))
        defs
        |> List.head


anyNamed : String -> List RegisteredWorkflow -> Bool
anyNamed name defs =
    List.filter (\(RegisteredWorkflow d) -> d.name == name) defs |> List.isEmpty
        |> not


markDone : Db -> String -> String -> Task Error ()
markDone db runId output =
    Time.now ()
        |> Task.andThen
               (\now ->
                   Db.exec
                       db
                       ("UPDATE _sky_durable_runs SET status = 'done', output = ?, claimed_at = NULL, "
                           ++ "updated_at = ? WHERE id = ?")
                       [ SqlString output, SqlInt now, SqlString runId ]
                       |> Task.map (\_ -> ()))


-- Release the lease on a suspended run (it stays 'running'/'waiting'; its wake_at
-- was set by sleep/awaitSignal), so a worker can reclaim it when it is due.
releaseLease : Db -> String -> Task Error ()
releaseLease db runId =
    Time.now ()
        |> Task.andThen
               (\now ->
                   Db.exec
                       db
                       "UPDATE _sky_durable_runs SET claimed_at = NULL, updated_at = ? WHERE id = ?"
                       [ SqlInt now, SqlString runId ]
                       |> Task.map (\_ -> ()))


-- Park a claimed run back to 'waiting' with its lease released (PinToStart): it
-- was not advanced or failed, so a worker running its own version can claim it.
-- `claim` had flipped it to 'running'; this restores the parked status.
parkForVersion : Db -> String -> Task Error ()
parkForVersion db runId =
    Time.now ()
        |> Task.andThen
               (\now ->
                   Db.exec
                       db
                       "UPDATE _sky_durable_runs SET status = 'waiting', claimed_at = NULL, updated_at = ? WHERE id = ?"
                       [ SqlInt now, SqlString runId ]
                       |> Task.map (\_ -> ()))


markFailed : Db -> String -> String -> Task Error ()
markFailed db runId msg =
    Time.now ()
        |> Task.andThen
               (\now ->
                   Db.exec
                       db
                       ("UPDATE _sky_durable_runs SET status = 'failed', last_error = ?, claimed_at = NULL, "
                           ++ "updated_at = ? WHERE id = ?")
                       [ SqlString msg, SqlInt now, SqlString runId ]
                       |> Task.map (\_ -> ()))


markDead : Db -> String -> String -> Task Error ()
markDead db runId msg =
    Time.now ()
        |> Task.andThen
               (\now ->
                   Db.exec
                       db
                       ("UPDATE _sky_durable_runs SET status = 'dead', last_error = ?, claimed_at = NULL, "
                           ++ "updated_at = ? WHERE id = ?")
                       [ SqlString msg, SqlInt now, SqlString runId ]
                       |> Task.map (\_ -> ()))


-- ---------------------------------------------------------------------------
-- History compaction (v2)
-- ---------------------------------------------------------------------------
{-| Delete the journal + signal rows of TERMINAL runs (`done` / `dead` /
`failed`) whose `updated_at` is older than `retentionMs` ago, and return how many
journal rows were removed. The run row itself is kept — its `output` is the
retained summary — so a compacted run is still visible with its final status and
result; only its per-step history is collapsed.

SAFE by construction: it never touches a `running` or `waiting` run, because a
waiting run's journal IS its resume state (what `step` replays). Call it on a
timer (a `Sub.every` tick, or a cron) to keep an append-heavy `_sky_durable_journal`
bounded. `compact db 0` collapses every terminal run immediately.
-}
compact : Db -> Int -> Task Error Int
compact db retentionMs =
    Time.now ()
        |> Task.andThen
               (\now ->
                   let
                       cutoff = now - retentionMs
                       terminalOlderThan =
                           " IN (SELECT id FROM _sky_durable_runs "
                               ++ "WHERE status IN ('done', 'dead', 'failed') AND updated_at <= ?)"
                   in
                       Db.exec
                           db
                           ("DELETE FROM _sky_durable_journal WHERE run_id"
                               ++ terminalOlderThan)
                           [ SqlInt cutoff ]
                           |> Task.andThen
                                  (\journalDeleted ->
                                      Db.exec
                                          db
                                          ("DELETE FROM _sky_durable_signals WHERE run_id"
                                              ++ terminalOlderThan)
                                          [ SqlInt cutoff ]
                                          |> Task.map (\_ -> journalDeleted)))


-- ---------------------------------------------------------------------------
-- Model snapshots (v2) — durable TEA substrate
-- ---------------------------------------------------------------------------
{-| Persist a snapshot of a value (typically a TEA `Model`) for `runId`, keyed by
a monotonic `seq`. WRITE-IF-NEWER: a stale write (lower `seq`) is a no-op, so two
concurrent effects racing to snapshot cannot regress the state. The value is
serialised with `Std.Codec` (`Codec.toJson`) — so a durable Model must be a plain
data value with a `Codec`, no function fields (the same rule Elm's ports impose).

This is the pure-Sky Model-snapshot primitive behind durable TEA replay: on a
restart, `loadSnapshot` restores the last Model directly, so state resumes without
re-folding the whole message history.
-}
saveSnapshot : Db -> String -> Codec a -> Int -> a -> Task Error ()
saveSnapshot db runId codec seq model =
    Time.now ()
        |> Task.andThen
               (\now ->
                   Db.exec
                       db
                       ("INSERT INTO _sky_durable_snapshot (run_id, seq, model_json, updated_at) "
                           ++ "VALUES (?, ?, ?, ?) "
                           ++ "ON CONFLICT (run_id) DO UPDATE SET "
                           ++ "seq = excluded.seq, model_json = excluded.model_json, updated_at = excluded.updated_at "
                           ++ "WHERE excluded.seq > _sky_durable_snapshot.seq")
                       [ SqlString runId
                       , SqlInt seq
                       , SqlString (Codec.toJson codec model)
                       , SqlInt now
                       ]
                       |> Task.map (\_ -> ()))


{-| Load the last snapshot for `runId`, decoded with `codec`. `Nothing` if the run
has no snapshot (a fresh run — start from your `init` Model) or the stored JSON
does not decode under `codec` (a Model shape change without a migration).
-}
loadSnapshot : Db -> String -> Codec a -> Task Error (Maybe a)
loadSnapshot db runId codec =
    Db.query
        db
        "SELECT model_json FROM _sky_durable_snapshot WHERE run_id = ?"
        [ SqlString runId ]
        |> Task.map
               (\rows ->
                   case List.head rows of

                       Just row ->
                           case Codec.fromJson codec (dictGet "model_json" row) of

                               Ok m ->
                                   Just m

                               Err _ ->
                                   Nothing

                       Nothing ->
                           Nothing)


{-| Like `saveSnapshot`, but the caller does not manage the `seq` — it is
auto-incremented in the write (the current row's `seq` + 1). Correct for a
serialised TEA loop, where one Msg is processed at a time so snapshots do not
overlap. This is what `snapshotCmd` uses.
-}
saveSnapshotAuto : Db -> String -> Codec a -> a -> Task Error ()
saveSnapshotAuto db runId codec model =
    Time.now ()
        |> Task.andThen
               (\now ->
                   Db.exec
                       db
                       ("INSERT INTO _sky_durable_snapshot (run_id, seq, model_json, updated_at) "
                           ++ "VALUES (?, COALESCE((SELECT seq FROM _sky_durable_snapshot WHERE run_id = ?), 0) + 1, ?, ?) "
                           ++ "ON CONFLICT (run_id) DO UPDATE SET "
                           ++ "seq = _sky_durable_snapshot.seq + 1, model_json = excluded.model_json, updated_at = excluded.updated_at")
                       [ SqlString runId
                       , SqlString runId
                       , SqlString (Codec.toJson codec model)
                       , SqlInt now
                       ]
                       |> Task.map (\_ -> ()))

-- ---------------------------------------------------------------------------
-- Durable TEA (v2) — restore-on-first-tick wiring for a Std.App / Sky.Live app
-- ---------------------------------------------------------------------------
{-| The event a durable TEA app routes through one added `Msg` variant. `Restored`
carries the model loaded at startup (`Nothing` for a fresh run); `Persisted`
acknowledges a snapshot write. -}
type SnapshotEvent model
    = Restored (Maybe model)
    | Persisted


{-| A `Cmd` for the app's `init` that loads the last snapshot and delivers it as
`Restored`. Wire it into `init` alongside your own initial `Cmd`; the model starts
from your `init` value and is swapped to the restored one on the first tick
(`applyRestore`). This is the restore-on-first-tick model — it needs no change to
`Std.App`'s synchronous `init`.

    init seed =
        let ( m, c ) = myInit seed
        in ( m, Cmd.batch [ c, Durable.restoreCmd db "session-1" modelCodec Durable ] )
-}
restoreCmd : Db -> String -> Codec model -> (SnapshotEvent model -> msg) -> Cmd msg
restoreCmd db runId codec toMsg =
    Cmd.perform
        (loadSnapshot db runId codec)
        (\res ->
            toMsg
                (Restored
                    (case res of

                        Ok mm ->
                            mm

                        Err _ ->
                            Nothing)))


{-| A `Cmd` for the app's `update` that snapshots the new model after a real
update, delivering `Persisted`. Add it to the `Cmd` your `update` returns.

    update msg model =
        case msg of
            Durable ev ->
                ( Durable.applyRestore ev model, Cmd.none )

            _ ->
                let ( m2, c ) = myUpdate msg model
                in ( m2, Cmd.batch [ c, Durable.snapshotCmd db "session-1" modelCodec Durable m2 ] )
-}
snapshotCmd : Db -> String -> Codec model -> (SnapshotEvent model -> msg) -> model -> Cmd msg
snapshotCmd db runId codec toMsg model =
    Cmd.perform (saveSnapshotAuto db runId codec model) (\_ -> toMsg Persisted)


{-| Apply a `SnapshotEvent` in `update`: `Restored (Just m)` swaps in the restored
model; everything else keeps the current model. -}
applyRestore : SnapshotEvent model -> model -> model
applyRestore ev model =
    case ev of

        Restored (Just m) ->
            m

        Restored Nothing ->
            model

        Persisted ->
            model
