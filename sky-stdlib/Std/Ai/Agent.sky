module Std.Ai.Agent exposing
    ( Input
    , Output
    , oneShot
    , ToolOutput
    , toolLoop
    , nativeToolLoop
    , inputCodec
    , outputCodec
    )

{-| `Std.Ai.Agent` — an agent run as a `Std.Durable` workflow. The model call is a
journalled `Durable.step`, so it is EXACTLY-ONCE: if the run crashes and resumes
after the call, the recorded answer is replayed and the (paid) model is not called
again. This is the point of running an agent on `Std.Durable` — an expensive,
non-idempotent LLM call becomes durable and replay-safe.

`oneShot` is the minimal shape: a fixed system prompt plus the caller's messages,
one journalled model call, the answer and its token usage out. A tool-calling loop
(each model call and each tool call its own journalled step) is the next
increment; the durable substrate is the same.

    agentDef =
        Agent.oneShot "assistant" (Provider.openai key "gpt-4o-mini") "You are terse."

    -- start + drive it like any durable workflow:
    Durable.start db agentDef "chat-42" { messages = [ Provider.user "Hi" ] }
    Durable.poll db [ Durable.erase agentDef ]
-}

import Sky.Core.Prelude exposing (..)
import Sky.Core.Task as Task
import Sky.Core.Error exposing (Error)
import Sky.Core.String as String
import Sky.Core.List as List
import Sky.Core.Maybe exposing (Maybe(..))
import Sky.Core.Result exposing (Result(..))
import Std.Codec as Codec exposing (Codec)
import Std.Durable as Durable exposing (Ctx)
import Std.Ai.Provider as Provider exposing (Provider, Message)
import Std.Ai.Tool as Tool exposing (Tool)

type alias Input =
    { messages : List Message }

type alias Output =
    { answer : String
    , usage : Provider.Usage
    }


inputCodec : Codec Input
inputCodec =
    Codec.auto { messages = [ { role = "", content = "" } ] }


outputCodec : Codec Output
outputCodec =
    Codec.auto
        { answer = ""
        , usage = { promptTokens = 0, completionTokens = 0, totalTokens = 0 }
        }


responseCodec : Codec Provider.ChatResponse
responseCodec =
    Codec.auto
        { content = ""
        , usage = { promptTokens = 0, completionTokens = 0, totalTokens = 0 }
        }


{-| A one-shot durable agent: prepend `systemPrompt`, call `provider` once inside
a journalled step, return the answer and usage. Register it under `name`, then
`Durable.start` / `Durable.poll` it like any workflow.
-}
oneShot : String -> Provider -> String -> Durable.WorkflowDef Input Output
oneShot name provider systemPrompt =
    Durable.register name inputCodec outputCodec (body provider systemPrompt)


body : Provider -> String -> Ctx -> Input -> Task Error Output
body provider systemPrompt ctx input =
    Durable.step
        ctx
        responseCodec
        "llm"
        (Provider.chat provider (Provider.system systemPrompt :: input.messages))
        |> Task.map (\r -> { answer = r.content, usage = r.usage })

-- ---------------------------------------------------------------------------
-- Tool-calling loop
-- ---------------------------------------------------------------------------
type alias ToolOutput =
    { answer : String }


toolOutputCodec : Codec ToolOutput
toolOutputCodec =
    Codec.auto { answer = "" }


{-| A tool-calling agent as a durable workflow. The model is told the `tools` and
asked to reply with the JSON protocol (`{"tool":…}` / `{"answer":…}`); the loop
calls a requested tool, feeds the result back, and repeats up to `maxTurns`. Every
model turn and every tool call is a journalled `Durable.step`, so the run resumes
without repeating a model call or a tool it already ran. Between-turn state (the
message list) is rebuilt deterministically from the journalled steps, so replay is
exact.
-}
toolLoop : String -> Provider -> String -> List Tool -> Int -> Durable.WorkflowDef Input ToolOutput
toolLoop name provider systemPrompt tools maxTurns =
    Durable.register
        name
        inputCodec
        toolOutputCodec
        (\ctx input ->
            loop
                provider
                tools
                maxTurns
                ctx
                0
                (Provider.system
                    (systemPrompt ++ "\n\n" ++ Tool.instructions tools)
                    :: input.messages))


loop : Provider -> List Tool -> Int -> Ctx -> Int -> List Message -> Task Error ToolOutput
loop provider tools maxTurns ctx turn messages =
    if turn >= maxTurns then
        Task.succeed
            { answer = "(reached the turn limit without a final answer)" }

    else
        Durable.step
            ctx
            responseCodec
            ("turn:" ++ String.fromInt turn)
            (Provider.chat provider messages)
            |> Task.andThen
                   (\resp ->
                       case parseAction resp.content of

                           Answer a ->
                               Task.succeed { answer = a }

                           Plain a ->
                               Task.succeed { answer = a }

                           UseTool toolName args ->
                               Durable.step
                                   ctx
                                   Codec.string
                                   ("tool:" ++ String.fromInt turn)
                                   (Tool.run tools toolName args)
                                   |> Task.andThen
                                          (\result ->
                                              loop
                                                  provider
                                                  tools
                                                  maxTurns
                                                  ctx
                                                  (turn + 1)
                                                  (messages
                                                      ++ [ Provider.assistant
                                                               resp.content
                                                         , Provider.user
                                                               ("Tool "
                                                                   ++ toolName
                                                                   ++ " returned: "
                                                                   ++ result)
                                                         ])))

type Action
    = Answer String
    | UseTool String String
    | Plain String

type alias Parsed =
    { tool : Maybe String
    , args : Maybe String
    , answer : Maybe String
    }


parsedCodec : Codec Parsed
parsedCodec =
    Codec.auto { tool = Just "", args = Just "", answer = Just "" }


parseAction : String -> Action
parseAction content =
    case Codec.fromJson parsedCodec content of

        Ok p ->
            case p.answer of

                Just a ->
                    Answer a

                Nothing ->
                    case p.tool of

                        Just t ->
                            UseTool
                                t
                                (case p.args of

                                    Just x ->
                                        x

                                    Nothing ->
                                        "")

                        Nothing ->
                            Plain content

        Err _ ->
            Plain content


-- ---------------------------------------------------------------------------
-- Native tool-calling loop (OpenAI function-calling)
-- ---------------------------------------------------------------------------
toolRespCodec : Codec Provider.ToolResponse
toolRespCodec =
    Codec.auto
        { content = ""
        , toolCalls =
            [ { id = "", name = "", arguments = "", continuation = Nothing } ]
        , usage = { promptTokens = 0, completionTokens = 0, totalTokens = 0 }
        }


{-| Like `toolLoop`, but uses the provider's NATIVE function-calling API
(`Provider.chatTools`) instead of the prompt-based JSON protocol: the model
returns real `tool_calls`, the loop runs each requested tool and feeds the result
back as a `tool` message, and repeats up to `maxTurns`. Every model turn and every
tool call is a journalled `Durable.step`, so a resumed run never repeats one.
Tools are advertised by name + description; the model fills in free-form JSON
arguments passed to the tool's `exec`.
-}
nativeToolLoop : String -> Provider -> String -> List Tool -> Int -> Durable.WorkflowDef Input ToolOutput
nativeToolLoop name provider systemPrompt tools maxTurns =
    Durable.register
        name
        inputCodec
        toolOutputCodec
        (\ctx input ->
            nativeLoop
                provider
                tools
                maxTurns
                ctx
                0
                (Provider.Say (Provider.system systemPrompt)
                    :: List.map Provider.Say input.messages))


toolSpecsOf : List Tool -> List Provider.ToolSpec
toolSpecsOf tools =
    List.map (\t -> { name = Tool.name t, description = Tool.describe t }) tools


nativeLoop : Provider -> List Tool -> Int -> Ctx -> Int -> List Provider.Turn -> Task Error ToolOutput
nativeLoop provider tools maxTurns ctx turn turns =
    if turn >= maxTurns then
        Task.succeed
            { answer = "(reached the turn limit without a final answer)" }

    else
        Durable.step
            ctx
            toolRespCodec
            ("turn:" ++ String.fromInt turn)
            (Provider.chatTools provider turns (toolSpecsOf tools))
            |> Task.andThen
                   (\resp ->
                       if List.isEmpty resp.toolCalls then
                           Task.succeed { answer = resp.content }

                       else
                           runCalls tools ctx turn 0 resp.toolCalls
                               |> Task.andThen
                                      (\returned ->
                                          nativeLoop
                                              provider
                                              tools
                                              maxTurns
                                              ctx
                                              (turn + 1)
                                              (turns
                                                  ++ (Provider.Called
                                                         resp.toolCalls
                                                         :: returned))))


-- Run each requested tool call as its own journalled step, in order, and collect
-- the results as `Returned` turns keyed to their call id.
runCalls : List Tool -> Ctx -> Int -> Int -> List Provider.ToolCall -> Task Error (List Provider.Turn)
runCalls tools ctx turn idx calls =
    case calls of

        [] ->
            Task.succeed []

        call :: rest ->
            Durable.step
                ctx
                Codec.string
                ("tool:" ++ String.fromInt turn ++ ":" ++ String.fromInt idx)
                (Tool.run tools call.name call.arguments)
                |> Task.andThen
                       (\result ->
                           runCalls tools ctx turn (idx + 1) rest
                               |> Task.map
                                      (\more ->
                                          Provider.Returned call result :: more))
