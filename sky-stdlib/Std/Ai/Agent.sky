module Std.Ai.Agent exposing
    ( Input
    , Output
    , oneShot
    , ToolOutput
    , toolLoop
    , nativeToolLoop
    , structuredToolLoop
    , Options
    , defaultOptions
    , oneShotWith
    , toolLoopWith
    , nativeToolLoopWith
    , structuredToolLoopWith
    , inputCodec
    , outputCodec
    )

{-| `Std.Ai.Agent` — an agent run as a `Std.Durable` workflow. The model call is a
journalled `Durable.step`, so it is EXACTLY-ONCE: if the run crashes and resumes
after the call, the recorded answer is replayed and the (paid) model is not called
again. This is the point of running an agent on `Std.Durable` — an expensive,
non-idempotent LLM call becomes durable and replay-safe.

`oneShot` is the minimal shape: a fixed system prompt plus the caller's messages,
one journalled model call, the answer and its token usage out. A tool-calling loop
(each model call and each tool call its own journalled step) is the next
increment; the durable substrate is the same.

    agentDef =
        Agent.oneShot "assistant" (Provider.openai key "gpt-4o-mini") "You are terse."

    -- start + drive it like any durable workflow:
    Durable.start db agentDef "chat-42" { messages = [ Provider.user "Hi" ] }
    Durable.poll db [ Durable.erase agentDef ]
-}

import Sky.Core.Prelude exposing (..)
import Sky.Core.Task as Task
import Sky.Core.Error as Error exposing (Error)
import Sky.Core.Json.Decode as JsonD
import Sky.Core.Json.Encode as JsonE
import Sky.Core.String as String
import Sky.Core.List as List
import Sky.Core.Maybe exposing (Maybe(..))
import Sky.Core.Result exposing (Result(..))
import Std.Codec as Codec exposing (Codec)
import Std.Durable as Durable exposing (Ctx)
import Std.Ai.Provider as Provider exposing (Provider, Message)
import Std.Ai.Tool as Tool exposing (Tool)
import Std.Ai.Trace as Trace

type alias Input =
    { messages : List Message }

type alias Output =
    { answer : String
    , usage : Provider.Usage
    }


inputCodec : Codec Input
inputCodec =
    Codec.auto { messages = [ { role = "", content = "" } ] }


outputCodec : Codec Output
outputCodec =
    Codec.auto
        { answer = ""
        , usage = { promptTokens = 0, completionTokens = 0, totalTokens = 0 }
        }


responseCodec : Codec Provider.ChatResponse
responseCodec =
    Codec.auto
        { content = ""
        , usage = { promptTokens = 0, completionTokens = 0, totalTokens = 0 }
        }

-- ---------------------------------------------------------------------------
-- Options: tracing
-- ---------------------------------------------------------------------------
{-| How an agent runs. `trace = Just book` records every model call in
`Std.Ai.Trace` under the durable run's id, priced with `book`: the call and
what it did (slot, tier, adapter, queue wait, latency, tokens per second,
outcome). The call and its facts are journalled together, and the row is
written by its own keyed step, so a resumed run neither calls the model again
nor records the call twice. A call that fails is recorded with its outcome
each time it is tried. Call `Trace.setup db` once at start-up, with
`Durable.setup`. -}
type alias Options =
    { trace : Maybe Provider.PriceBook }


{-| No tracing. -}
defaultOptions : Options
defaultOptions =
    { trace = Nothing }

-- A model call and what it did, as the run's journal keeps it.
type alias Journalled a =
    { response : a
    , facts : Provider.CallFacts
    }


factsSample : Provider.CallFacts
factsSample =
    { slot = ""
    , tier = ""
    , adapter = ""
    , queueWaitMs = Just 0
    , startMs = Just 0
    , latencyMs = Just 0
    , firstTokenMs = Just 0
    , tokensPerSecond = Just 0.0
    , draftAcceptance = Just 0.0
    , outcome = ""
    }


journalledChatCodec : Codec (Journalled Provider.ChatResponse)
journalledChatCodec =
    Codec.auto
        { response =
            { content = ""
            , usage =
                { promptTokens = 0, completionTokens = 0, totalTokens = 0 }
            }
        , facts = factsSample
        }


journalledToolsCodec : Codec (Journalled Provider.ToolResponse)
journalledToolsCodec =
    Codec.auto
        { response =
            { content = ""
            , toolCalls =
                [ { id = "", name = "", arguments = "", continuation = Nothing }
                ]
            , usage =
                { promptTokens = 0, completionTokens = 0, totalTokens = 0 }
            }
        , facts = factsSample
        }


-- The trace entry of a model step: the run, the step's key, the book.
traceEntry : Ctx -> String -> Provider.PriceBook -> Trace.Ledger
traceEntry ctx key book =
    { runId = Durable.runId ctx
    , key = key
    , kind = Trace.Call
    , book = Just book
    }


-- One model call as a journalled step, traced when the options say so.
chatStep : Options -> Ctx -> String -> Provider -> List Message -> Task Error Provider.ChatResponse
chatStep opts ctx key provider messages =
    case opts.trace of

        Nothing ->
            Durable.step ctx responseCodec key (Provider.chat provider messages)

        Just book ->
            Durable.step
                ctx
                journalledChatCodec
                key
                (measuredChat ctx key book provider messages)
                |> Task.andThen (writeChatTrace ctx key book)


-- Call the model, measured. A failure is recorded (each attempt is a real
-- call) and fails the step.
measuredChat : Ctx -> String -> Provider.PriceBook -> Provider -> List Message -> Task Error (Journalled Provider.ChatResponse)
measuredChat ctx key book provider messages =
    Provider.measure Provider.defaultOptions provider messages
        |> Task.andThen
               (\m ->
                   case m.result of

                       Ok r ->
                           Task.succeed { response = r, facts = m.facts }

                       Err e ->
                           Trace.recordCall
                               (Durable.conn ctx)
                               (failedEntry ctx book)
                               m
                               |> Task.andThen (\_ -> Task.fail e))


failedEntry : Ctx -> Provider.PriceBook -> Trace.Ledger
failedEntry ctx book =
    Trace.ledger (Durable.runId ctx) |> Trace.priced book


writeChatTrace : Ctx -> String -> Provider.PriceBook -> Journalled Provider.ChatResponse -> Task Error Provider.ChatResponse
writeChatTrace ctx key book j =
    Durable.step
        ctx
        Codec.string
        ("trace:" ++ key)
        (Trace.recordCall
            (Durable.conn ctx)
            (traceEntry ctx key book)
            { result = Ok j.response, facts = j.facts }
            |> Task.map (\_ -> ""))
        |> Task.map (\_ -> j.response)


-- One native tool-calling model turn as a journalled step, traced when the
-- options say so.
toolsStep : Options -> Ctx -> String -> Provider -> List Provider.Turn -> Provider.ToolRequest -> Task Error Provider.ToolResponse
toolsStep opts ctx key provider turns req =
    case opts.trace of

        Nothing ->
            Durable.step
                ctx
                toolRespCodec
                key
                (Provider.chatToolRequest provider turns req)

        Just book ->
            Durable.step
                ctx
                journalledToolsCodec
                key
                (measuredTools ctx book provider turns req)
                |> Task.andThen (writeToolsTrace ctx key book)


measuredTools : Ctx -> Provider.PriceBook -> Provider -> List Provider.Turn -> Provider.ToolRequest -> Task Error (Journalled Provider.ToolResponse)
measuredTools ctx book provider turns req =
    Provider.measureToolRequest provider turns req
        |> Task.andThen
               (\m ->
                   case m.result of

                       Ok r ->
                           Task.succeed { response = r, facts = m.facts }

                       Err e ->
                           Trace.recordToolCall
                               (Durable.conn ctx)
                               (failedEntry ctx book)
                               m
                               |> Task.andThen (\_ -> Task.fail e))


writeToolsTrace : Ctx -> String -> Provider.PriceBook -> Journalled Provider.ToolResponse -> Task Error Provider.ToolResponse
writeToolsTrace ctx key book j =
    Durable.step
        ctx
        Codec.string
        ("trace:" ++ key)
        (Trace.recordToolCall
            (Durable.conn ctx)
            (traceEntry ctx key book)
            { result = Ok j.response, facts = j.facts }
            |> Task.map (\_ -> ""))
        |> Task.map (\_ -> j.response)


{-| A one-shot durable agent: prepend `systemPrompt`, call `provider` once inside
a journalled step, return the answer and usage. Register it under `name`, then
`Durable.start` / `Durable.poll` it like any workflow.
-}
oneShot : String -> Provider -> String -> Durable.WorkflowDef Input Output
oneShot name provider systemPrompt =
    oneShotWith defaultOptions name provider systemPrompt


{-| `oneShot` with `Options` (tracing). -}
oneShotWith : Options -> String -> Provider -> String -> Durable.WorkflowDef Input Output
oneShotWith opts name provider systemPrompt =
    Durable.register
        name
        inputCodec
        outputCodec
        (body opts provider systemPrompt)


body : Options -> Provider -> String -> Ctx -> Input -> Task Error Output
body opts provider systemPrompt ctx input =
    chatStep
        opts
        ctx
        "llm"
        provider
        (Provider.system systemPrompt :: input.messages)
        |> Task.map (\r -> { answer = r.content, usage = r.usage })

-- ---------------------------------------------------------------------------
-- Tool-calling loop
-- ---------------------------------------------------------------------------
type alias ToolOutput =
    { answer : String }


toolOutputCodec : Codec ToolOutput
toolOutputCodec =
    Codec.auto { answer = "" }


{-| A tool-calling agent as a durable workflow. The model is told the `tools` and
asked to reply with the JSON protocol (`{"tool":…}` / `{"answer":…}`); the loop
calls a requested tool, feeds the result back, and repeats up to `maxTurns`. Every
model turn and every tool call is a journalled `Durable.step`, so the run resumes
without repeating a model call or a tool it already ran. Between-turn state (the
message list) is rebuilt deterministically from the journalled steps, so replay is
exact.
-}
toolLoop : String -> Provider -> String -> List Tool -> Int -> Durable.WorkflowDef Input ToolOutput
toolLoop name provider systemPrompt tools maxTurns =
    toolLoopWith defaultOptions name provider systemPrompt tools maxTurns


{-| `toolLoop` with `Options` (tracing). -}
toolLoopWith : Options -> String -> Provider -> String -> List Tool -> Int -> Durable.WorkflowDef Input ToolOutput
toolLoopWith opts name provider systemPrompt tools maxTurns =
    Durable.register
        name
        inputCodec
        toolOutputCodec
        (\ctx input ->
            loop
                opts
                provider
                tools
                maxTurns
                ctx
                0
                (Provider.system
                    (systemPrompt ++ "\n\n" ++ Tool.instructions tools)
                    :: input.messages))


loop : Options -> Provider -> List Tool -> Int -> Ctx -> Int -> List Message -> Task Error ToolOutput
loop opts provider tools maxTurns ctx turn messages =
    if turn >= maxTurns then
        Task.succeed
            { answer = "(reached the turn limit without a final answer)" }

    else
        chatStep opts ctx ("turn:" ++ String.fromInt turn) provider messages
            |> Task.andThen
                   (\resp ->
                       case parseAction resp.content of

                           Answer a ->
                               Task.succeed { answer = a }

                           Plain a ->
                               Task.succeed { answer = a }

                           UseTool toolName args ->
                               Durable.step
                                   ctx
                                   Codec.string
                                   ("tool:" ++ String.fromInt turn)
                                   (runChecked tools toolName args)
                                   |> Task.andThen
                                          (\result ->
                                              loop
                                                  opts
                                                  provider
                                                  tools
                                                  maxTurns
                                                  ctx
                                                  (turn + 1)
                                                  (messages
                                                      ++ [ Provider.assistant
                                                               resp.content
                                                         , Provider.user
                                                               ("Tool "
                                                                   ++ toolName
                                                                   ++ " returned: "
                                                                   ++ result)
                                                         ])))

type Action
    = Answer String
    | UseTool String String
    | Plain String

type alias Parsed =
    { tool : Maybe String
    , args : Maybe String
    , answer : Maybe String
    }


-- `args` is a string, or (for a typed tool) a JSON object, which is passed on
-- as its JSON text.
parsedDecoder : JsonD.Decoder Parsed
parsedDecoder =
    JsonD.map3
        (\t a x -> { tool = t, args = a, answer = x })
        (optionalField "tool" JsonD.string)
        (optionalField
            "args"
            (JsonD.oneOf
                [ JsonD.string, JsonD.map (\v -> JsonE.encode 0 v) JsonD.value ]))
        (optionalField "answer" JsonD.string)


optionalField : String -> JsonD.Decoder a -> JsonD.Decoder (Maybe a)
optionalField key d =
    JsonD.oneOf [ JsonD.map Just (JsonD.field key d), JsonD.succeed Nothing ]


parseAction : String -> Action
parseAction content =
    case JsonD.decodeString parsedDecoder content of

        Ok p ->
            case p.answer of

                Just a ->
                    Answer a

                Nothing ->
                    case p.tool of

                        Just t ->
                            UseTool
                                t
                                (case p.args of

                                    Just x ->
                                        x

                                    Nothing ->
                                        "")

                        Nothing ->
                            Plain content

        Err _ ->
            Plain content


-- ---------------------------------------------------------------------------
-- Native tool-calling loop (OpenAI function-calling)
-- ---------------------------------------------------------------------------
toolRespCodec : Codec Provider.ToolResponse
toolRespCodec =
    Codec.auto
        { content = ""
        , toolCalls =
            [ { id = "", name = "", arguments = "", continuation = Nothing } ]
        , usage = { promptTokens = 0, completionTokens = 0, totalTokens = 0 }
        }


{-| Like `toolLoop`, but uses the provider's NATIVE function-calling API
(`Provider.chatTools`) instead of the prompt-based JSON protocol: the model
returns real `tool_calls`, the loop runs each requested tool and feeds the result
back as a `tool` message, and repeats up to `maxTurns`. Every model turn and every
tool call is a journalled `Durable.step`, so a resumed run never repeats one.
Tools are advertised by name + description; the model fills in free-form JSON
arguments passed to the tool's `exec`.
-}
nativeToolLoop : String -> Provider -> String -> List Tool -> Int -> Durable.WorkflowDef Input ToolOutput
nativeToolLoop name provider systemPrompt tools maxTurns =
    nativeToolLoopWith defaultOptions name provider systemPrompt tools maxTurns


{-| `nativeToolLoop` with `Options` (tracing). -}
nativeToolLoopWith : Options -> String -> Provider -> String -> List Tool -> Int -> Durable.WorkflowDef Input ToolOutput
nativeToolLoopWith opts name provider systemPrompt tools maxTurns =
    Durable.register
        name
        inputCodec
        toolOutputCodec
        (\ctx input ->
            nativeLoop
                opts
                provider
                tools
                maxTurns
                ctx
                0
                (Provider.Say (Provider.system systemPrompt)
                    :: List.map Provider.Say input.messages))


toolSchemasOf : List Tool -> List Provider.ToolSchema
toolSchemasOf tools =
    List.map
        (\t ->
            { name = Tool.name t
            , description = Tool.describe t
            , parameters = Tool.parameters t
            })
        tools


nativeLoop : Options -> Provider -> List Tool -> Int -> Ctx -> Int -> List Provider.Turn -> Task Error ToolOutput
nativeLoop opts provider tools maxTurns ctx turn turns =
    if turn >= maxTurns then
        Task.succeed
            { answer = "(reached the turn limit without a final answer)" }

    else
        toolsStep
            opts
            ctx
            ("turn:" ++ String.fromInt turn)
            provider
            turns
            { tools = toolSchemasOf tools, responseFormat = Nothing }
            |> Task.andThen
                   (\resp ->
                       if List.isEmpty resp.toolCalls then
                           Task.succeed { answer = resp.content }

                       else
                           runCalls tools ctx turn 0 resp.toolCalls
                               |> Task.andThen
                                      (\returned ->
                                          nativeLoop
                                              opts
                                              provider
                                              tools
                                              maxTurns
                                              ctx
                                              (turn + 1)
                                              (turns
                                                  ++ (Provider.Called
                                                         resp.toolCalls
                                                         :: returned))))


-- Run each requested tool call as its own journalled step, in order, and collect
-- the results as `Returned` turns keyed to their call id.
runCalls : List Tool -> Ctx -> Int -> Int -> List Provider.ToolCall -> Task Error (List Provider.Turn)
runCalls tools ctx turn idx calls =
    case calls of

        [] ->
            Task.succeed []

        call :: rest ->
            Durable.step
                ctx
                Codec.string
                ("tool:" ++ String.fromInt turn ++ ":" ++ String.fromInt idx)
                (runChecked tools call.name call.arguments)
                |> Task.andThen
                       (\result ->
                           runCalls tools ctx turn (idx + 1) rest
                               |> Task.map
                                      (\more ->
                                          Provider.Returned call result :: more))


-- Run a requested tool after checking its arguments. Arguments a typed tool
-- cannot decode are handed back to the model as the tool's result, so it can
-- call again; they never reach the executor and never fail the run.
runChecked : List Tool -> String -> String -> Task Error String
runChecked tools toolName args =
    case Tool.checkArguments tools toolName args of

        Ok _ ->
            Tool.run tools toolName args

        Err e ->
            Task.succeed ("error: " ++ Error.toString e)


-- ---------------------------------------------------------------------------
-- Structured native tool loop: a typed final answer
-- ---------------------------------------------------------------------------
{-| `nativeToolLoop` whose final answer has a shape: each model turn asks for
the shape (`Provider.chatToolRequest` with its `response_format`), and the
answer is decoded with the shape's codec into the workflow's typed output. An
answer that does not decode is handed back to the model, with the reason, as
the next turn. Every model turn and tool call is a journalled step, as in
`nativeToolLoop`. With no answer of the shape within `maxTurns` turns, the run
fails with a `Decode` error naming the shape. A `custom` provider cannot ask
for a shape and fails with `InvalidSetting`.

    type alias Reply = { answer : String, refund : Bool }

    replyShape =
        Provider.responseShape "reply" (Codec.auto { answer = "", refund = False })

    agent =
        Agent.structuredToolLoop replyShape "support" provider
            "You are a support agent." [ orderTool ] 6
-}
structuredToolLoop : Provider.ResponseShape a -> String -> Provider -> String -> List Tool -> Int -> Durable.WorkflowDef Input a
structuredToolLoop shape name provider systemPrompt tools maxTurns =
    structuredToolLoopWith
        defaultOptions
        shape
        name
        provider
        systemPrompt
        tools
        maxTurns


{-| `structuredToolLoop` with `Options` (tracing). -}
structuredToolLoopWith : Options -> Provider.ResponseShape a -> String -> Provider -> String -> List Tool -> Int -> Durable.WorkflowDef Input a
structuredToolLoopWith opts shape name provider systemPrompt tools maxTurns =
    Durable.register
        name
        inputCodec
        (Provider.shapeCodec shape)
        (\ctx input ->
            structuredLoop
                opts
                shape
                provider
                tools
                maxTurns
                ctx
                0
                (Provider.Say (Provider.system systemPrompt)
                    :: List.map Provider.Say input.messages))


structuredLoop : Options -> Provider.ResponseShape a -> Provider -> List Tool -> Int -> Ctx -> Int -> List Provider.Turn -> Task Error a
structuredLoop opts shape provider tools maxTurns ctx turn turns =
    if turn >= maxTurns then
        Task.fail
            (Error.decode
                ("Agent.structuredToolLoop: no answer of the shape "
                    ++ (Provider.responseFormat shape).name
                    ++ " within "
                    ++ String.fromInt maxTurns
                    ++ " turns"))

    else
        toolsStep
            opts
            ctx
            ("turn:" ++ String.fromInt turn)
            provider
            turns
            { tools = toolSchemasOf tools
            , responseFormat = Just (Provider.responseFormat shape)
            }
            |> Task.andThen
                   (\resp ->
                       if List.isEmpty resp.toolCalls then
                           case Provider.decodeStructured shape resp.content of

                               Ok value ->
                                   Task.succeed value

                               Err e ->
                                   structuredLoop
                                       opts
                                       shape
                                       provider
                                       tools
                                       maxTurns
                                       ctx
                                       (turn + 1)
                                       (turns
                                           ++ [ Provider.Say
                                                    (Provider.assistant
                                                        resp.content)
                                              , Provider.Say
                                                    (Provider.user
                                                        ("Your answer does not match the required JSON schema ("
                                                            ++ Error.toString e
                                                            ++ "). Answer again with JSON that matches it."))
                                              ])

                       else
                           runCalls tools ctx turn 0 resp.toolCalls
                               |> Task.andThen
                                      (\returned ->
                                          structuredLoop
                                              opts
                                              shape
                                              provider
                                              tools
                                              maxTurns
                                              ctx
                                              (turn + 1)
                                              (turns
                                                  ++ (Provider.Called
                                                         resp.toolCalls
                                                         :: returned))))
