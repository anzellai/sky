-- | The base's id.
baseId : BaseModel -> String
baseId (BaseModel b) =
    b.id


-- | The GGUF model that serves the base's adapters.
baseServing : BaseModel -> Local.ModelRef
baseServing (BaseModel b) =
    b.serving


-- | The weights a backend trains on, if the base has them.
baseWeights : Backend -> BaseModel -> Maybe Snapshot
baseWeights backend (BaseModel b) =
    case backend of

        Mlx ->
            b.mlx

        Unsloth ->
            b.unsloth

        Vertex ->
            b.unsloth

        Fake ->
            Nothing

-- ── Jobs ────────────────────────────────────────────────────────────
-- | Where a job trains. `Mlx` and `Unsloth` run on this machine, `Vertex`
-- runs the same driver in a pinned container as a Vertex AI custom job on
-- Google Cloud (`withCloud`, `withBudget`), and `Fake` runs the scripted
-- trainer (tests, CI, a machine with no accelerator).
type Backend
    = Mlx
    | Unsloth
    | Vertex
    | Fake


-- | The backend's name, as `SKY_AI_TRAIN_BACKEND` writes it.
backendName : Backend -> String
backendName b =
    case b of

        Mlx ->
            "mlx"

        Unsloth ->
            "unsloth"

        Vertex ->
            "vertex"

        Fake ->
            "fake"

-- | Rows per optimiser step: `perDevice` rows at a time, gradients accumulated
-- over `accumulate` of those.
type alias Batch =
    { perDevice : Int
    , accumulate : Int
    }

-- | Everything a job holds. Read it with `settings`.
type alias Settings =
    { name : String
    , baseId : String
    , serving : String
    , format : String
    , dataset : String
    , datasetDigest : String
    , dataFile : String
    , trainRows : Int
    , evalRows : Int
    , quantBits : Int
    , gradientCheckpointing : Bool
    , memoryCap : Int
    , rank : Int
    , alpha : Int
    , layers : Int
    , targets : List String
    , learningRate : Float
    , epochs : Int
    , maxSteps : Int
    , batch : Batch
    , sequenceLength : Int
    , seed : Int
    , checkpointEvery : Int
    , evalEvery : Int
    , backend : Maybe Backend
    , ggufExport : Bool
    , mergedExport : Bool
    , workDir : String
    , maxRelaunches : Int
    , watchWindowMs : Int
    , fakeCrashAt : Int
    , fakeStepMs : Int
    , cloud : Cloud
    , budget : Maybe Money
    , prices : Maybe MachinePriceBook
    , image : String
    , serviceAccount : String
    , maxRuntimeMinutes : Int
    , spot : Bool
    , keepStaging : Bool
    , labels : List ( String, String )
    }

-- `Job`'s payloads are named records, so a match reads each payload with
-- one runtime narrowing instead of one per field (doc 14 §4.5, R6).
type alias JobPayload =
    { s : Settings
    , base : BaseModel
    , registry : Maybe Registry.Registry
    }

-- | A training job: a base, a frozen dataset version and the settings.
type Job
    = Job JobPayload


-- | A LoRA job on a chat dataset (the `{"messages": [...]}` format). The loss
-- counts each conversation's last assistant turn.
lora : BaseModel -> Dataset.Version Dataset.Chat -> Job
lora base version =
    newJob base "chat" (Dataset.manifest version) (Dataset.blobPath version)


-- | A LoRA job on an instruction dataset (`{"prompt", "completion"}`). The
-- loss counts the completion.
loraOnInstructions : BaseModel -> Dataset.Version Dataset.Instruction -> Job
loraOnInstructions base version =
    newJob
        base
        "instruction"
        (Dataset.manifest version)
        (Dataset.blobPath version)


newJob : BaseModel -> String -> Dataset.Manifest -> String -> Job
newJob base format m file =
    Job
        { s =
            { name = "adapter"
            , baseId = baseId base
            , serving = Local.reference (baseServing base)
            , format = format
            , dataset = m.name
            , datasetDigest = m.digest
            , dataFile = file
            , trainRows = m.train
            , evalRows = m.eval
            , quantBits = 16
            , gradientCheckpointing = False
            , memoryCap = 0
            , rank = 8
            , alpha = 0
            , layers = 16
            , targets = defaultTargets
            , learningRate = 1.0e-4
            , epochs = 1
            , maxSteps = 0
            , batch = { perDevice = 4, accumulate = 1 }
            , sequenceLength = 1024
            , seed = 0
            , checkpointEvery = 100
            , evalEvery = 50
            , backend = Nothing
            , ggufExport = False
            , mergedExport = False
            , workDir = ".sky/ai/runs"
            , maxRelaunches = 3
            , watchWindowMs = 300000
            , fakeCrashAt = 0
            , fakeStepMs = 20
            , cloud = { project = "", region = "", machine = "", staging = "" }
            , budget = Nothing
            , prices = Nothing
            , image = ""
            , serviceAccount = ""
            , maxRuntimeMinutes = 0
            , spot = False
            , keepStaging = False
            , labels = []
            }
        , base = base
        , registry = Nothing
        }


defaultTargets : List String
defaultTargets =
    [ "self_attn.q_proj"
    , "self_attn.k_proj"
    , "self_attn.v_proj"
    , "self_attn.o_proj"
    ]


knownTargets : List String
knownTargets =
    defaultTargets ++ [ "mlp.gate_proj", "mlp.up_proj", "mlp.down_proj" ]


update : (Settings -> Settings) -> Job -> Job
update f (Job j) =
    Job { j | s = f j.s }


-- | The adapter's name: the run directory's prefix, and the registry model
-- name. Lower case, digits and `-`. Default: `adapter`.
withName : String -> Job -> Job
withName n =
    update (\s -> { s | name = n })


-- | Mark the job QLoRA: the base weights are 4-bit (the snapshot already is,
-- for `devBase`). The same as `withQuantBits 4`. Recorded in the lineage and
-- the registry method.
withQuantisedBase : Job -> Job
withQuantisedBase =
    withQuantBits 4


-- | The bits the base weights are held in while training: 4 or 8 quantise a
-- 16-bit base as it loads (QLoRA), 16 keeps it as it is. A base snapshot that
-- is already quantised (`devBase`'s MLX weights) trains as it is. Default:
-- 16. `SKY_AI_TRAIN_QUANT_BITS` overrides it.
withQuantBits : Int -> Job -> Job
withQuantBits n =
    update (\s -> { s | quantBits = n })


-- | Recompute each adapted layer's activations in the backward pass instead
-- of keeping them: less memory, more time. The adapter is the same. Default:
-- off. `SKY_AI_TRAIN_GRAD_CHECKPOINT` (`on` or `off`) overrides it.
withGradientCheckpointing : Job -> Job
withGradientCheckpointing =
    update (\s -> { s | gradientCheckpointing = True })


-- | The most memory the trainer may use, in bytes. The plan refuses a job
-- whose estimate is above it (`ModelTooLarge`), and the native trainer's
-- guard kills a run that goes over it and ends it with `ModelTooLarge`, never
-- relaunching it. Default: the memory this machine can give (three quarters
-- of it on Apple silicon). `SKY_AI_TRAIN_MEMORY_CAP` (bytes, or `2.5GB`)
-- overrides it.
withMemoryCap : Int -> Job -> Job
withMemoryCap bytes =
    update (\s -> { s | memoryCap = bytes })


-- | The LoRA rank. Default: 8. `SKY_AI_TRAIN_RANK` overrides it.
withRank : Int -> Job -> Job
withRank n =
    update (\s -> { s | rank = n })


-- | The LoRA alpha (the update is scaled by alpha / rank). Default: twice
-- the rank.
withAlpha : Int -> Job -> Job
withAlpha n =
    update (\s -> { s | alpha = n })


-- | How many of the last decoder layers get adapters; `-1` for all. Default:
-- 16.
withLayers : Int -> Job -> Job
withLayers n =
    update (\s -> { s | layers = n })


-- | Which projections get adapters, as Hugging Face module paths
-- (`self_attn.q_proj`, `mlp.down_proj`, …). Default: the four attention
-- projections.
withTargets : List String -> Job -> Job
withTargets ts =
    update (\s -> { s | targets = ts })


-- | The learning rate (Adam). Default: 1e-4.
withLearningRate : Float -> Job -> Job
withLearningRate r =
    update (\s -> { s | learningRate = r })


-- | Passes over the train split. Default: 1. `withMaxSteps` wins.
withEpochs : Int -> Job -> Job
withEpochs n =
    update (\s -> { s | epochs = n })


-- | Stop after this many optimiser steps.
withMaxSteps : Int -> Job -> Job
withMaxSteps n =
    update (\s -> { s | maxSteps = n })


-- | Rows per step. Default: `{ perDevice = 4, accumulate = 1 }`.
-- `SKY_AI_TRAIN_BATCH` (`4`, or rows x accumulate: `1x4`) overrides it.
withBatch : Batch -> Job -> Job
withBatch b =
    update (\s -> { s | batch = b })


-- | Tokens per row; a longer row is cut. Default: 1024.
-- `SKY_AI_TRAIN_SEQUENCE_LENGTH` overrides it.
withSequenceLength : Int -> Job -> Job
withSequenceLength n =
    update (\s -> { s | sequenceLength = n })


-- | The seed of the adapter's initial values and of the data order. A resumed
-- run reads exactly the batches the first run would have. Default: 0.
withSeed : Int -> Job -> Job
withSeed n =
    update (\s -> { s | seed = n })


-- | Write a checkpoint every n steps (0: none). A relaunched trainer repeats
-- at most this many steps. Default: 100.
withCheckpointEvery : Int -> Job -> Job
withCheckpointEvery n =
    update (\s -> { s | checkpointEvery = n })


-- | Measure the eval split's loss every n steps (0: at the end only).
-- Default: 50.
withEvalEvery : Int -> Job -> Job
withEvalEvery n =
    update (\s -> { s | evalEvery = n })


-- | Train on this backend unless `SKY_AI_TRAIN_BACKEND` says otherwise.
-- Without it the backend is detected.
withBackend : Backend -> Job -> Job
withBackend b =
    update (\s -> { s | backend = Just b })


-- | Also convert the adapter to GGUF, the format the managed llama-server
-- loads (`Local.withAdapter`, the registry's local slots).
withGgufExport : Job -> Job
withGgufExport =
    update (\s -> { s | ggufExport = True })


-- | Also fold the adapter into the serving model and write a merged GGUF
-- model (`merged.gguf` in the run directory; it implies the GGUF adapter).
-- The adapter stays the product: the registry holds adapters only.
withMergedExport : Job -> Job
withMergedExport =
    update (\s -> { s | ggufExport = True, mergedExport = True })


-- | The directory that holds the run directories. Default: `.sky/ai/runs`.
withWorkDir : String -> Job -> Job
withWorkDir d =
    update (\s -> { s | workDir = d })


-- | Register the finished adapter in this registry under the job's name, with
-- its lineage (the dataset version and digest, the base, the run).
withRegistry : Registry.Registry -> Job -> Job
withRegistry r (Job j) =
    Job { j | registry = Just r }


-- | How often a trainer that died is relaunched from its newest checkpoint
-- before the run fails with `TrainingFailed`. Default: 3.
withMaxRelaunches : Int -> Job -> Job
withMaxRelaunches n =
    update (\s -> { s | maxRelaunches = n })


-- | The longest one watch of the trainer lasts, in milliseconds (at most five
-- minutes, which keeps every durable step inside its lease). Default: 300000.
withWatchWindow : Int -> Job -> Job
withWatchWindow n =
    update (\s -> { s | watchWindowMs = n })


-- | `Fake` only: the first attempt dies after this step, as a killed trainer
-- does, so a test sees the relaunch from the newest checkpoint.
fakeCrashAt : Int -> Job -> Job
fakeCrashAt n =
    update (\s -> { s | fakeCrashAt = n })


-- | `Fake` only: the time one step takes. Default: 20.
fakeStepMs : Int -> Job -> Job
fakeStepMs n =
    update (\s -> { s | fakeStepMs = n })

-- ── Cloud settings (the Vertex backend) ─────────────────────────────
-- | Where a `Vertex` job runs: the Google Cloud project, the region (Vertex
-- AI's, and the staging bucket's: they must match), the machine type
-- (`g2-standard-4` carries one NVIDIA L4; `n2-standard-4` has no GPU and runs
-- the Fake driver) and the staging location `gs://<bucket>/<prefix>` the run's
-- data, checkpoints and adapter pass through. Each field falls back to
-- `SKY_AI_TRAIN_PROJECT`, `_REGION`, `_MACHINE` and `_STAGING`; an operator's
-- variable wins over the code. Default machine: `g2-standard-4`.
type alias Cloud =
    { project : String
    , region : String
    , machine : String
    , staging : String
    }


-- | Set where a `Vertex` job runs. An empty field is left to its variable.
withCloud : Cloud -> Job -> Job
withCloud c =
    update (\s -> { s | cloud = c })


-- | The most a `Vertex` job may cost. A cloud job without a budget never
-- starts: `plan` refuses it (`InvalidSetting`), and an estimate above it is
-- `BudgetExceeded` before anything launches. The budget also sets the job's
-- hard runtime ceiling, so Vertex itself stops the job even when no Sky
-- worker is left, and a watch that measures the spend at the budget cancels
-- the job. Env: `SKY_AI_TRAIN_BUDGET` (`USD 5.00`).
withBudget : Money -> Job -> Job
withBudget m =
    update (\s -> { s | budget = Just m })

-- | One machine's price per hour in a region, as text in the book's
-- currency (`"1.10"`): the machine and the accelerators its type carries.
type alias MachineRate =
    { machine : String
    , region : String
    , perHour : String
    }

-- | The prices a cloud job is estimated and watched with: a currency, a
-- version (a date, so a stale book is visible), and a rate per machine and
-- region. The stdlib ships none: prices change, and the program states the
-- ones it trusts (`machinePrices`).
type MachinePriceBook
    = MachinePriceBook PriceBook

type alias PriceBook =
    { currency : Money.Currency
    , version : String
    , rates : List PricedRate
    , problems : List String
    }

type alias PricedRate =
    { machine : String
    , region : String
    , perHour : Money
    }


-- | A price book from its rates. A rate that does not parse as an amount of
-- at least 0, a machine and region given twice, or a book without a version
-- is refused when a job that uses the book starts (`InvalidSetting`), so a
-- book can be a plain top-level value.
machinePrices : Money.Currency -> String -> List MachineRate -> MachinePriceBook
machinePrices currency version rates =
    let
        parsed =
            List.map
                (\r ->
                    case Money.fromString currency (String.trim r.perHour) of

                        Ok m ->
                            if Money.isNegative m then
                                Err
                                    (r.machine ++ " in " ++ r.region
                                        ++ ": a price is 0 or more")

                            else
                                Ok
                                    { machine = r.machine
                                    , region = r.region
                                    , perHour = m
                                    }

                        Err _ ->
                            Err
                                (r.machine ++ " in " ++ r.region ++ ": "
                                    ++ quoteText r.perHour
                                    ++ " is not an amount"))
                rates
        bad =
            List.filterMap
                (\x ->
                    case x of

                        Err e ->
                            Just e

                        Ok _ ->
                            Nothing)
                parsed
        good =
            List.filterMap
                (\x ->
                    case x of

                        Ok r ->
                            Just r

                        Err _ ->
                            Nothing)
                parsed
        keys = List.map (\r -> r.machine ++ "@" ++ r.region) good
        duplicate =
            List.filter
                (\k -> List.length (List.filter (\x -> x == k) keys) > 1)
                keys
                |> List.map (\k -> k ++ " is in the book twice")
        unversioned =
            if String.isEmpty (String.trim version) then
                [ "a price book needs a version (the date its rates were read)"
                ]

            else
                []
    in
        MachinePriceBook
            { currency = currency
            , version = version
            , rates = good
            , problems = unversioned ++ bad ++ duplicate
            }


-- | The price book's version.
priceBookVersion : MachinePriceBook -> String
priceBookVersion (MachinePriceBook b) =
    b.version


-- | The prices a `Vertex` job's estimate and spend use.
withMachinePrices : MachinePriceBook -> Job -> Job
withMachinePrices book =
    update (\s -> { s | prices = Just book })


-- | The trainer image a `Vertex` job runs, pinned by digest
-- (`<region>-docker.pkg.dev/<project>/<repo>/sky-ai-trainer@sha256:<hex>`; a
-- tag alone is refused). `sky ai image build --train` builds it in your own
-- project with Cloud Build and prints the reference. Env:
-- `SKY_AI_TRAIN_IMAGE`.
withImage : String -> Job -> Job
withImage ref =
    update (\s -> { s | image = ref })


-- | The service account the job runs as (it needs only the staging bucket).
-- Default: the project's Vertex AI service agent. Env:
-- `SKY_AI_TRAIN_SERVICE_ACCOUNT`.
withServiceAccount : String -> Job -> Job
withServiceAccount email =
    update (\s -> { s | serviceAccount = email })


-- | A runtime ceiling in minutes for each Vertex job (each attempt), below
-- the one the budget sets. Vertex stops the job there even with no Sky
-- process left. The budget bounds the whole run, relaunches included.
withMaxRuntimeMinutes : Int -> Job -> Job
withMaxRuntimeMinutes n =
    update (\s -> { s | maxRuntimeMinutes = n })


-- | Run on Spot capacity: cheaper, and pre-emptible. A pre-empted attempt is
-- relaunched from its newest checkpoint like any other lost attempt (up to
-- `withMaxRelaunches`). Price the book's rate as the Spot rate.
withSpot : Job -> Job
withSpot =
    update (\s -> { s | spot = True })


-- | Labels for the job's Vertex resources, beside Sky's own (`sky-managed`,
-- `sky-run`, `sky-attempt`, `sky-kind`): a team, a cost centre. Each key and
-- value is lower case letters, digits, `-` and `_`, at most 63 characters.
-- Env: `SKY_AI_TRAIN_LABELS` (`team=support,env=qa`), added to these.
withLabels : List ( String, String ) -> Job -> Job
withLabels ls =
    update (\s -> { s | labels = s.labels ++ ls })


-- | Keep the run's staging prefix (data, checkpoints, adapter) and its
-- Vertex job records after the adapter is registered. By default they are
-- deleted, so nothing stays behind in the cloud.
withKeepStaging : Job -> Job
withKeepStaging =
    update (\s -> { s | keepStaging = True })


-- | What a job holds.
settings : Job -> Settings
settings (Job j) =
    j.s


alphaOf : Settings -> Int
alphaOf s =
    if s.alpha > 0 then
        s.alpha

    else
        2 * s.rank


-- | The job as canonical JSON: the settings that decide the adapter (not the
-- backend, which the environment picks, nor where the run lives), keys
-- sorted. It goes into the lineage, and its digest names the run.
jobJson : Job -> String
jobJson (Job j) =
    let
        s = j.s
        crash =
            if s.fakeCrashAt > 0 then
                [ ( "fakeCrashAt", JsonE.int s.fakeCrashAt ) ]

            else
                []
    in
        JsonE.encode
            0
            (JsonE.object
                ([ ( "alpha", JsonE.int (alphaOf s) )
                , ( "base", JsonE.string s.baseId )
                , ( "batch"
                  , JsonE.object
                        [ ( "accumulate", JsonE.int s.batch.accumulate )
                        , ( "perDevice", JsonE.int s.batch.perDevice )
                        ]
                  )
                , ( "checkpointEvery", JsonE.int s.checkpointEvery )
                , ( "dataset"
                  , JsonE.object
                        [ ( "digest", JsonE.string s.datasetDigest )
                        , ( "name", JsonE.string s.dataset )
                        ]
                  )
                , ( "epochs", JsonE.int s.epochs )
                , ( "evalEvery", JsonE.int s.evalEvery )
                ]
                    ++ crash
                    ++ [ ( "format", JsonE.string s.format )
                       , ( "gguf", JsonE.bool s.ggufExport )
                       , ( "layers", JsonE.int s.layers )
                       , ( "learningRate", JsonE.float s.learningRate )
                       , ( "maxSteps", JsonE.int s.maxSteps )
                       , ( "merged", JsonE.bool s.mergedExport )
                       , ( "name", JsonE.string s.name )
                       , ( "quantBits", JsonE.int s.quantBits )
                       , ( "rank", JsonE.int s.rank )
                       , ( "seed", JsonE.int s.seed )
                       , ( "sequenceLength", JsonE.int s.sequenceLength )
                       , ( "serving", JsonE.string s.serving )
                       , ( "targets", JsonE.list JsonE.string s.targets )
                       ]))


-- | The run's id: the job's name and the first twelve hex digits of its
-- JSON's SHA-256. The same job is the same run, so starting it again attaches
-- to it instead of training twice.
runId : Job -> String
runId job =
    (settings job).name ++ "-" ++ String.left 12 (Crypto.sha256 (jobJson job))


-- | The run's directory: `<workDir>/<runId>`.
runDir : Job -> String
runDir job =
    (settings job).workDir ++ "/" ++ runId job


-- | The optimiser steps the job runs: `maxSteps` when set, else whole epochs
-- of the train split.
totalSteps : Job -> Int
totalSteps job =
    let
        s = settings job
        per = Math.max 1 (s.batch.perDevice * s.batch.accumulate)
    in
        if s.maxSteps > 0 then
            s.maxSteps

        else
            Math.max 1 ((s.epochs * s.trainRows + per - 1) // per)


invalid : String -> String -> Error
invalid setting reason =
    Failure.toError (InvalidSetting { setting = setting, reason = reason })


-- | Check a job before it runs, without I/O. An empty train or eval split is
-- `DatasetInvalid` (the eval split measures the adapter); a setting out of
-- range is `InvalidSetting`.
check : Job -> Result Error ()
check job =
    let
        s = settings job
        fails =
            List.filterMap
                identity
                [ failIf
                      (not (validName s.name))
                      ( "name"
                      , quoteText s.name
                            ++ " is not a name: use lower case letters, digits and -"
                      )
                , failIf (s.rank < 1) ( "rank", "the rank must be at least 1" )
                , failIf (s.alpha < 0) ( "alpha", "alpha must be positive" )
                , failIf
                      (s.layers == 0 || s.layers < -1)
                      ( "layers", "use a number of layers, or -1 for all" )
                , failIf
                      (List.isEmpty s.targets)
                      ( "targets", "name at least one projection" )
                , failIf
                      (List.any
                          (\t -> not (List.member t knownTargets))
                          s.targets)
                      ( "targets"
                      , "a target is one of " ++ String.join ", " knownTargets
                      )
                , failIf
                      (not (s.learningRate > 0.0))
                      ( "learningRate", "the learning rate must be above 0" )
                , failIf
                      (s.epochs < 1 && s.maxSteps < 1)
                      ( "epochs", "train for at least one epoch or one step" )
                , failIf
                      (s.batch.perDevice < 1 || s.batch.accumulate < 1)
                      ( "batch", "a batch is at least one row" )
                , failIf
                      (s.sequenceLength < 16)
                      ( "sequenceLength", "a sequence is at least 16 tokens" )
                , failIf
                      (s.checkpointEvery < 0 || s.evalEvery < 0)
                      ( "checkpointEvery", "use 0 or a number of steps" )
                , failIf
                      (s.maxRelaunches < 0)
                      ( "maxRelaunches", "use 0 or more" )
                , failIf
                      (not (List.member s.quantBits [ 4, 8, 16 ]))
                      ( "quantBits", "use 4, 8 or 16 bits (16: not quantised)" )
                , failIf
                      (s.memoryCap < 0)
                      ( "memoryCap"
                      , "use a number of bytes, or 0 for this machine's memory"
                      )
                ]
    in
        case fails of

            ( setting, reason ) :: _ ->
                Err (invalid setting reason)

            [] ->
                if s.trainRows < 1 || s.evalRows < 1 then
                    Err
                        (Failure.toError
                            (DatasetInvalid
                                { dataset =
                                    s.dataset ++ "@"
                                        ++ String.left 12 s.datasetDigest
                                , reasons =
                                    "training needs rows in both the train and the eval split ("
                                        ++ String.fromInt s.trainRows
                                        ++ " train, "
                                        ++ String.fromInt s.evalRows
                                        ++ " eval)"
                                }))

                else
                    Ok ()


failIf : Bool -> ( String, String ) -> Maybe ( String, String )
failIf cond pair =
    if cond then
        Just pair

    else
        Nothing


quoteText : String -> String
quoteText s =
    "\"" ++ s ++ "\""


validName : String -> Bool
validName n =
    not (String.isEmpty n) && String.length n <= 48
        && List.all
               (\c ->
                   (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-')
               (String.toList n)
        && not (String.startsWith "-" n)

-- ── Planning ────────────────────────────────────────────────────────
-- | The machine: `accelerator` is `metal`, `cuda` or `cpu`.
type alias Host =
    { os : String
    , arch : String
    , totalBytes : Int
    , availableBytes : Int
    , accelerator : String
    }

-- | The base model's shape, read from its serving GGUF.
type alias ModelShape =
    { architecture : String
    , layers : Int
    , hidden : Int
    , intermediate : Int
    , qDim : Int
    , kvDim : Int
    , vocab : Int
    , parameters : Int
    }


hostRaw : () -> Task Error Host
hostRaw =
    Ffi.kernel "Ai_trainHost"


-- | This machine.
host : () -> Task Error Host
host _ =
    hostRaw ()


shapesRaw : String -> Task Error ModelShape
shapesRaw =
    Ffi.kernel "Ai_trainShapes"


-- | The shape of the base's serving model (fetched if allowed).
shapeOf : BaseModel -> Task Error ModelShape
shapeOf base =
    shapesRaw (Local.reference (baseServing base))


trainedLayers : ModelShape -> Settings -> Int
trainedLayers shape s =
    if s.layers < 0 || s.layers > shape.layers then
        shape.layers

    else
        s.layers


dims : ModelShape -> String -> ( Int, Int )
dims shape target =
    case target of

        "self_attn.q_proj" ->
            ( shape.hidden, shape.qDim )

        "self_attn.k_proj" ->
            ( shape.hidden, shape.kvDim )

        "self_attn.v_proj" ->
            ( shape.hidden, shape.kvDim )

        "self_attn.o_proj" ->
            ( shape.qDim, shape.hidden )

        "mlp.down_proj" ->
            ( shape.intermediate, shape.hidden )

        _ ->
            ( shape.hidden, shape.intermediate )


-- | The memory the native trainer (`Mlx`) needs for a job, in bytes: a
-- documented estimate on the high side, calibrated against the trainer's
-- measured peak footprint (Qwen2.5 0.5B, 4-bit, rank 8, 8 layers, q and v,
-- one row: 1.09 GB at 128 tokens and 1.77 GB at 256 on Metal; this formula
-- gives 1.26 GB and 1.97 GB):
--
--   * weights: parameters × 0.5625 bytes at 4 bits (4.5 bits with the
--     scales), × 1.0625 at 8, × 2 at 16;
--   * the adapter: its parameters (rank × (in + out) per adapted projection)
--     × 16 bytes (the value, its gradient and Adam's two moments, as f32);
--   * activations, per token (rows × sequence length): adapted layers × (16 ×
--     hidden + 4 × intermediate) × 2 bytes, or with gradient checkpointing
--     adapted layers × hidden × 4 bytes plus one layer's full set;
--   * the logits and the loss: tokens × vocabulary × 36 bytes (measured:
--     about nine f32 copies of each row's logits are alive at the peak);
--   * 256 MiB for MLX's cache and the runtime.
estimateMemory : ModelShape -> Job -> Int
estimateMemory shape job =
    let
        s = settings job
        layers = trainedLayers shape s
        tokens = s.batch.perDevice * s.sequenceLength
        full = 16 * shape.hidden + 4 * shape.intermediate
        activations =
            if s.gradientCheckpointing then
                tokens * (layers * shape.hidden * 4 + full * 2)

            else
                tokens * layers * full * 2
    in
        weightBytes shape s + adapterBytes shape s + activations
            + tokens * shape.vocab * 36
            + 268435456


weightBytes : ModelShape -> Settings -> Int
weightBytes shape s =
    if s.quantBits == 4 then
        shape.parameters * 9 // 16

    else if s.quantBits == 8 then
        shape.parameters * 17 // 16

    else
        shape.parameters * 2


adapterBytes : ModelShape -> Settings -> Int
adapterBytes shape s =
    let
        perLayer =
            List.foldl
                (\t acc ->
                    let
                        ( i, o ) = dims shape t
                    in
                        acc + s.rank * (i + o))
                0
                s.targets
    in
        trainedLayers shape s * perLayer * 16


-- The memory a Python backend (Unsloth) needs: the estimate the driver was
-- sized with, which counts its fused loss (8 bytes per logit) and 512 MiB
-- for the Python runtime.
estimatePython : ModelShape -> Job -> Int
estimatePython shape job =
    let
        s = settings job
        tokens = s.batch.perDevice * s.sequenceLength
    in
        weightBytes shape s + adapterBytes shape s
            + tokens * trainedLayers shape s
                  * (16 * shape.hidden + 4 * shape.intermediate)
                  * 2
            + tokens * shape.vocab * 8
            + 536870912

-- | One training setting as it was resolved: its key (`SEQUENCE_LENGTH`,
-- `BATCH`, `RANK`, `QUANT_BITS`, `GRAD_CHECKPOINT`, `MEMORY_CAP`), the
-- variable that overrides it, its value, and where the value came from:
-- `env` (the operator), `code` (the job, its builder or its default) or
-- `default` (nobody set it).
type alias Setting =
    { key : String
    , name : String
    , value : String
    , source : String
    }

-- The job's own values, for the resolver: the code layer under the
-- `SKY_AI_TRAIN_*` variables.
type alias TrainCode =
    { sequenceLength : String
    , batch : String
    , rank : String
    , quantBits : String
    , gradientCheckpointing : String
    , memoryCap : String
    }


trainSettingsRaw : TrainCode -> Task Error (List Setting)
trainSettingsRaw =
    Ffi.kernel "Ai_trainSettingsResolve"


trainCode : Settings -> TrainCode
trainCode s =
    { sequenceLength = String.fromInt s.sequenceLength
    , batch =
        String.fromInt s.batch.perDevice ++ "x"
            ++ String.fromInt s.batch.accumulate
    , rank = String.fromInt s.rank
    , quantBits = String.fromInt s.quantBits
    , gradientCheckpointing =
        if s.gradientCheckpointing then
            "on"

        else
            "off"
    , memoryCap =
        if s.memoryCap > 0 then
            String.fromInt s.memoryCap

        else
            ""
    }


-- One resolved setting written into the job's settings. The resolver hands
-- back normalised text (`1x4`, `on`, bytes), so a value that does not read
-- here cannot occur; it leaves the setting as it was.
applySetting : Setting -> Settings -> Settings
applySetting st s =
    let
        num = Maybe.withDefault 0 (String.toInt st.value)
    in
        case st.key of

            "SEQUENCE_LENGTH" ->
                { s
                    | sequenceLength =
                        Maybe.withDefault
                            s.sequenceLength
                            (String.toInt st.value)
                }

            "BATCH" ->
                case List.map String.toInt (String.split "x" st.value) of

                    [ Just rows, Just acc ] ->
                        { s | batch = { perDevice = rows, accumulate = acc } }

                    _ ->
                        s

            "RANK" ->
                { s | rank = Maybe.withDefault s.rank (String.toInt st.value) }

            "QUANT_BITS" ->
                { s
                    | quantBits =
                        Maybe.withDefault s.quantBits (String.toInt st.value)
                }

            "GRAD_CHECKPOINT" ->
                { s | gradientCheckpointing = st.value == "on" }

            "MEMORY_CAP" ->
                { s | memoryCap = num }

            _ ->
                s


-- The job as it runs here, and how each setting was resolved.
effectiveWith : Job -> Task Error ( Job, List Setting )
effectiveWith job =
    trainSettingsRaw (trainCode (settings job))
        |> Task.map (\sts -> ( applyAll sts job, sts ))


applyAll : List Setting -> Job -> Job
applyAll sts job =
    update (\s -> List.foldl applySetting s sts) job


-- | The job as it runs on this machine: the sequence length, the batch, the
-- rank, the quantisation bits, gradient checkpointing and the memory cap
-- from `SKY_AI_TRAIN_*` when the operator set them, else the job's own. A
-- variable that changes the adapter is a different run (`runId` of the
-- effective job). `plan`, `start`, `drive`, `progress`, `result`, `resume`
-- and `cancel` all take the job through it; a value that does not parse is
-- `InvalidSetting` naming the variable.
effective : Job -> Task Error Job
effective job =
    effectiveWith job |> Task.map Tuple.first

-- | What `plan` found: the backend and where it came from (`env`, `code`,
-- `detected`), the machine, the base's shape, the steps, the estimate and
-- the memory the backend may use.
type alias Plan =
    { runId : String
    , backend : String
    , backendSource : String
    , host : Host
    , shape : ModelShape
    , steps : Int
    , trainRows : Int
    , evalRows : Int
    , estimateBytes : Int
    , availableBytes : Int
    , capBytes : Int
    , settings : List Setting
    , cloud : Maybe CloudPlan
    }

type alias RawSetting =
    { key : String
    , name : String
    , value : String
    , source : String
    }


resolveRaw : String -> Task Error RawSetting
resolveRaw =
    Ffi.kernel "Ai_trainResolve"


backendCode : Settings -> String
backendCode s =
    Maybe.withDefault "" (Maybe.map backendName s.backend)


-- Apple silicon shares its memory with the GPU and Metal works within about
-- three quarters of it; elsewhere the memory available now.
usable : Host -> Int
usable h =
    if h.accelerator == "metal" then
        h.totalBytes * 3 // 4

    else
        h.availableBytes


-- | Plan a job before it runs: resolve its settings (`effective`), check it,
-- resolve the backend, read the host and the base's shape, and estimate the
-- memory. A job that will not fit under the memory cap is `ModelTooLarge`
-- before anything is downloaded or started; a backend this host cannot run
-- is `NoAccelerator`. `settings` says where each setting came from.
plan : Job -> Task Error Plan
plan job0 =
    effectiveWith job0 |> Task.andThen (\( job, sts ) -> planWith job sts)


planWith : Job -> List Setting -> Task Error Plan
planWith job sts =
    let
        s = settings job
    in
        Task.fromResult (check job)
            |> Task.andThen (\_ -> resolveRaw (backendCode s))
            |> Task.andThen
                   (\b ->
                       host ()
                           |> Task.andThen
                                  (\h ->
                                      shapeOf (baseOf job)
                                          |> Task.andThen
                                                 (\shape ->
                                                     if b.value == "vertex" then
                                                         fitPlan
                                                             job
                                                             sts
                                                             b
                                                             h
                                                             shape
                                                             |> Task.andThen
                                                                    (\p ->
                                                                        planCloudWith
                                                                            job
                                                                            shape
                                                                            |> Task.map
                                                                                   (\c ->
                                                                                       { p
                                                                                           | cloud =
                                                                                               Just
                                                                                                   c
                                                                                       }))

                                                     else
                                                         fitPlan
                                                             job
                                                             sts
                                                             b
                                                             h
                                                             shape)))


-- The memory the trainer may use: the job's cap, else what this machine can
-- give.
capOf : Settings -> Host -> Int
capOf s h =
    if s.memoryCap > 0 then
        s.memoryCap

    else
        usable h


fitPlan : Job -> List Setting -> RawSetting -> Host -> ModelShape -> Task Error Plan
fitPlan job sts b h shape =
    let
        s = settings job
        need =
            if b.value == "mlx" then
                estimateMemory shape job

            else
                estimatePython shape job
        avail = usable h
        cap = Math.min avail (capOf s h)
        p =
            { runId = runId job
            , backend = b.value
            , backendSource = b.source
            , host = h
            , shape = shape
            , steps = totalSteps job
            , trainRows = s.trainRows
            , evalRows = s.evalRows
            , estimateBytes = need
            , availableBytes = avail
            , capBytes = cap
            , settings = sts
            , cloud = Nothing
            }
    in
        if b.value /= "fake" && b.value /= "vertex" && need > cap then
            Task.fail
                (Failure.toError
                    (ModelTooLarge { needBytes = need, availableBytes = cap }))

        else
            Task.succeed p


baseOf : Job -> BaseModel
baseOf (Job j) =
    j.base


registryOf : Job -> Maybe Registry.Registry
registryOf (Job j) =
    j.registry

-- ── Progress ────────────────────────────────────────────────────────
-- | Where a run is.
type Status
    = Queued
    | Provisioning
    | Running
    | Relaunching
    | Converting
    | Registering
    | Done
    | Failed
    | Cancelled


-- | A status as lower-case text.
statusText : Status -> String
statusText st =
    case st of

        Queued ->
            "queued"

        Provisioning ->
            "provisioning"

        Running ->
            "running"

        Relaunching ->
            "relaunching"

        Converting ->
            "converting"

        Registering ->
            "registering"

        Done ->
            "done"

        Failed ->
            "failed"

        Cancelled ->
            "cancelled"

-- | One point of a loss curve.
type alias LossPoint =
    { step : Int
    , value : Float
    }

-- | A run's progress, folded from the trainer's protocol lines. `losses` and
-- `valLosses` hold at most 200 points each (a long run is thinned evenly).
-- `relaunches` counts trainers started after the first; `resumedFrom` is the
-- checkpoint step the last one resumed from.
type alias Progress =
    { runId : String
    , status : Status
    , backend : String
    , step : Int
    , totalSteps : Int
    , loss : Maybe Float
    , valLoss : Maybe Float
    , tokensPerSecond : Float
    , attempt : Int
    , relaunches : Int
    , resumedFrom : Int
    , lastCheckpoint : Int
    , losses : List LossPoint
    , valLosses : List LossPoint
    , message : String
    }


-- | The progress of a run that has written nothing yet.
emptyProgress : String -> Progress
emptyProgress id =
    { runId = id
    , status = Queued
    , backend = ""
    , step = 0
    , totalSteps = 0
    , loss = Nothing
    , valLoss = Nothing
    , tokensPerSecond = 0.0
    , attempt = 0
    , relaunches = 0
    , resumedFrom = 0
    , lastCheckpoint = 0
    , losses = []
    , valLosses = []
    , message = ""
    }

-- `Event`'s payloads are named records, so a match reads each payload with
-- one runtime narrowing instead of one per field (doc 14 §4.5, R6).
type alias HelloPayload =
    { backend : String
    , attempt : Int
    , resumeFrom : Int
    , totalSteps : Int
    }

type alias StepProgressPayload =
    { step : Int
    , total : Int
    , loss : Float
    , tokensPerSecond : Float
    }

type alias MetricPayload =
    { step : Int
    , name : String
    , value : Float
    }

type alias CheckpointPayload =
    { step : Int
    , path : String
    }

type alias ArtefactPayload =
    { kind : String
    , path : String
    , sha256 : String
    }

type alias DoneEventPayload =
    { step : Int
    , trainLoss : Float
    , valLoss : Float
    }

type alias CancelledEventPayload =
    { step : Int }

type alias DriverErrorPayload =
    { code : String
    , message : String
    , peakBytes : Int
    , capBytes : Int
    }

-- ── The driver protocol ─────────────────────────────────────────────
-- | One line the trainer writes (`docs/ai/train.md`, "The driver protocol").
type Event
    = Hello HelloPayload
    | StepProgress StepProgressPayload
    | Metric MetricPayload
    | Checkpoint CheckpointPayload
    | Artefact ArtefactPayload
    | DoneEvent DoneEventPayload
    | CancelledEvent CancelledEventPayload
    | DriverError DriverErrorPayload


toolchainFailed : String -> Error
toolchainFailed text =
    Failure.toError (ToolchainFailed { tool = "trainer", logTail = text })


-- A number the trainer could not write (a non-finite loss is written as
-- null) reads as -1.
num : String -> JsonD.Decoder Float
num key =
    JsonD.oneOf [ JsonD.field key JsonD.float, JsonD.succeed (-1.0) ]


intOr : String -> Int -> JsonD.Decoder Int
intOr key d =
    JsonD.oneOf [ JsonD.field key JsonD.int, JsonD.succeed d ]


strOr : String -> JsonD.Decoder String
strOr key =
    JsonD.oneOf [ JsonD.field key JsonD.string, JsonD.succeed "" ]


-- | Decode one protocol line. A line of a type this release does not know is
-- `Ok Nothing` (a newer driver may add types); a line that is not protocol
-- JSON, or whose version `v` is not 1, is `ToolchainFailed`.
decodeEvent : String -> Result Error (Maybe Event)
decodeEvent line =
    case JsonD.decodeString
             (JsonD.map2
                 Tuple.pair
                 (JsonD.field "v" JsonD.int)
                 (JsonD.field "type" JsonD.string))
             line of

        Err _ ->
            Err
                (toolchainFailed
                    ("the trainer wrote a line that is not protocol JSON: "
                        ++ String.left 200 line))

        Ok ( v, typ ) ->
            if v /= 1 then
                Err
                    (toolchainFailed
                        ("the trainer speaks protocol version "
                            ++ String.fromInt v
                            ++ "; this Sky reads version 1 (the toolchain and the runtime differ)"))

            else
                case eventDecoder typ of

                    Nothing ->
                        Ok Nothing

                    Just d ->
                        JsonD.decodeString d line |> Result.map Just
                            |> Result.mapError
                                   (\_ ->
                                       toolchainFailed
                                           ("the trainer wrote a " ++ typ
                                               ++ " line without its fields: "
                                               ++ String.left 200 line))


eventDecoder : String -> Maybe (JsonD.Decoder Event)
eventDecoder typ =
    case typ of

        "hello" ->
            Just
                (JsonD.map4
                    (\b a r t ->
                        Hello
                            { backend = b
                            , attempt = a
                            , resumeFrom = r
                            , totalSteps = t
                            })
                    (strOr "backend")
                    (intOr "attempt" 0)
                    (intOr "resumeFrom" 0)
                    (intOr "totalSteps" 0))

        "progress" ->
            Just
                (JsonD.map4
                    (\s t l tps ->
                        StepProgress
                            { step = s
                            , total = t
                            , loss = l
                            , tokensPerSecond = tps
                            })
                    (JsonD.field "step" JsonD.int)
                    (intOr "total" 0)
                    (num "loss")
                    (num "tokensPerSecond"))

        "metric" ->
            Just
                (JsonD.map3
                    (\s n v -> Metric { step = s, name = n, value = v })
                    (JsonD.field "step" JsonD.int)
                    (JsonD.field "name" JsonD.string)
                    (num "value"))

        "checkpoint" ->
            Just
                (JsonD.map2
                    (\s p -> Checkpoint { step = s, path = p })
                    (JsonD.field "step" JsonD.int)
                    (JsonD.field "path" JsonD.string))

        "artefact" ->
            Just
                (JsonD.map3
                    (\k p h -> Artefact { kind = k, path = p, sha256 = h })
                    (JsonD.field "kind" JsonD.string)
                    (JsonD.field "path" JsonD.string)
                    (JsonD.field "sha256" JsonD.string))

        "done" ->
            Just
                (JsonD.map3
                    (\s t v -> DoneEvent { step = s, trainLoss = t, valLoss = v })
                    (JsonD.field "step" JsonD.int)
                    (num "trainLoss")
                    (num "valLoss"))

        "cancelled" ->
            Just
                (JsonD.map
                    (\s -> CancelledEvent { step = s })
                    (JsonD.field "step" JsonD.int))

        "error" ->
            Just
                (JsonD.map4
                    (\c m pk cp ->
                        DriverError
                            { code = c
                            , message = m
                            , peakBytes = pk
                            , capBytes = cp
                            })
                    (JsonD.field "code" JsonD.string)
                    (strOr "message")
                    (intOr "peakBytes" 0)
                    (intOr "capBytes" 0))

        _ ->
            Nothing


maxPoints : Int
maxPoints =
    200


-- Keep a curve at most `maxPoints` long: when it is full, drop every second
-- point (the first and the newest stay).
addPoint : LossPoint -> List LossPoint -> List LossPoint
addPoint p pts =
    let
        next = pts ++ [ p ]
    in
        if List.length next > maxPoints then
            thin next

        else
            next


thin : List LossPoint -> List LossPoint
thin pts =
    List.indexedMap Tuple.pair pts
        |> List.filter (\( i, _ ) -> modBy 2 i == 0 || i == List.length pts - 1)
        |> List.map Tuple.second


-- | Fold one protocol line into a run's progress.
foldProgress : Event -> Progress -> Progress
foldProgress ev p =
    case ev of

        Hello h ->
            { p
                | status = Running
                , backend = h.backend
                , attempt = h.attempt
                , relaunches =
                    if h.attempt > 0 then
                        p.relaunches + 1

                    else
                        p.relaunches
                , resumedFrom =
                    if h.attempt > 0 then
                        h.resumeFrom

                    else
                        p.resumedFrom
                , totalSteps =
                    if h.totalSteps > 0 then
                        h.totalSteps

                    else
                        p.totalSteps
                , message = ""
            }

        StepProgress e ->
            { p
                | status = Running
                , step = e.step
                , totalSteps =
                    if e.total > 0 then
                        e.total

                    else
                        p.totalSteps
                , loss = Just e.loss
                , tokensPerSecond = e.tokensPerSecond
                , losses =
                    if e.loss >= 0.0 then
                        addPoint { step = e.step, value = e.loss } p.losses

                    else
                        p.losses
            }

        Metric m ->
            if m.name == "val_loss" then
                { p
                    | valLoss = Just m.value
                    , valLosses =
                        addPoint { step = m.step, value = m.value } p.valLosses
                }

            else
                p

        Checkpoint c ->
            { p | lastCheckpoint = c.step }

        Artefact _ ->
            p

        DoneEvent d ->
            { p | status = Converting, step = d.step, valLoss = Just d.valLoss }

        CancelledEvent c ->
            { p | status = Cancelled, step = c.step, message = "cancelled" }

        DriverError e ->
            { p | status = Failed, message = e.code ++ ": " ++ e.message }


-- Fold every decodable line; an undecodable one is noted in the message and
-- skipped, so progress never fails on one bad line.
foldLines : List String -> Progress -> Progress
foldLines lines p0 =
    List.foldl
        (\line p ->
            case decodeEvent line of

                Ok (Just ev) ->
                    foldProgress ev p

                Ok Nothing ->
                    p

                Err e ->
                    { p | message = Error.toString e })
        p0
        lines

-- ── Artefacts and the result ────────────────────────────────────────
-- | A file the run produced and its SHA-256.
type alias Artefact =
    { path : String
    , sha256 : String
    }

-- | A trained adapter and its lineage. `peft` is the adapter in the PEFT
-- layout (safetensors); `gguf` is the GGUF adapter when the job asked for it,
-- `merged` the merged model. `registered` is the registry label
-- (`<name>@v<n>`) when the job had a registry.
type alias Adapter =
    { name : String
    , runId : String
    , baseId : String
    , serving : String
    , dataset : String
    , datasetDigest : String
    , backend : String
    , toolchain : String
    , method : String
    , seed : Int
    , steps : Int
    , peft : Artefact
    , gguf : Maybe Artefact
    , merged : Maybe Artefact
    , trainLoss : Float
    , valLoss : Float
    , relaunches : Int
    , resumedFrom : Int
    , registered : Maybe String
    , job : String
    }


artefactCodec : Codec Artefact
artefactCodec =
    Codec.object (\p h -> { path = p, sha256 = h })
        |> Codec.field "path" .path Codec.string
        |> Codec.field "sha256" .sha256 Codec.string
        |> Codec.buildObject


-- | The JSON form of an adapter record (the run's `result.json`, the durable
-- workflow's output).
adapterCodec : Codec Adapter
adapterCodec =
    Codec.object
        (\n r b sv d dd be tc m sd st pf gg mg tl vl rl rf rg jb ->
            { name = n
            , runId = r
            , baseId = b
            , serving = sv
            , dataset = d
            , datasetDigest = dd
            , backend = be
            , toolchain = tc
            , method = m
            , seed = sd
            , steps = st
            , peft = pf
            , gguf = gg
            , merged = mg
            , trainLoss = tl
            , valLoss = vl
            , relaunches = rl
            , resumedFrom = rf
            , registered = rg
            , job = jb
            })
        |> Codec.field "name" .name Codec.string
        |> Codec.field "runId" .runId Codec.string
        |> Codec.field "baseId" .baseId Codec.string
        |> Codec.field "serving" .serving Codec.string
        |> Codec.field "dataset" .dataset Codec.string
        |> Codec.field "datasetDigest" .datasetDigest Codec.string
        |> Codec.field "backend" .backend Codec.string
        |> Codec.field "toolchain" .toolchain Codec.string
        |> Codec.field "method" .method Codec.string
        |> Codec.field "seed" .seed Codec.int
        |> Codec.field "steps" .steps Codec.int
        |> Codec.field "peft" .peft artefactCodec
        |> Codec.field "gguf" .gguf (Codec.maybe artefactCodec)
        |> Codec.field "merged" .merged (Codec.maybe artefactCodec)
        |> Codec.field "trainLoss" .trainLoss Codec.float
        |> Codec.field "valLoss" .valLoss Codec.float
        |> Codec.field "relaunches" .relaunches Codec.int
        |> Codec.field "resumedFrom" .resumedFrom Codec.int
        |> Codec.field "registered" .registered (Codec.maybe Codec.string)
        |> Codec.field "job" .job Codec.string
        |> Codec.buildObject


-- | The registry's view of a trained adapter: the GGUF file when there is
-- one (what a local engine loads), else the PEFT safetensors.
registryAdapter : Adapter -> Registry.Adapter
registryAdapter a =
    case a.gguf of

        Just g ->
            { path = g.path, format = Registry.Gguf, method = methodOf a }

        Nothing ->
            { path = a.peft.path
            , format = Registry.Safetensors
            , method = methodOf a
            }


-- | The files registered with the version besides its main file: the PEFT
-- weights (when the GGUF file is the version) and `adapter_config.json`, which
-- a vLLM tier loads, from the run's `adapter/` directory.
companions : Adapter -> List Registry.Companion
companions a =
    let
        dir = dirOf a.peft.path
        config =
            { role = "peft.config", path = dir ++ "/adapter_config.json" }
    in
        case a.gguf of

            Just _ ->
                [ { role = "peft", path = a.peft.path }, config ]

            Nothing ->
                [ config ]


dirOf : String -> String
dirOf path =
    case List.reverse (String.split "/" path) of

        _ :: rest ->
            String.join "/" (List.reverse rest)

        [] ->
            "."


methodOf : Adapter -> Registry.Method
methodOf a =
    if a.method == "qlora" then
        Registry.Qlora

    else
        Registry.Lora


-- | The lineage a trained adapter is registered with: the serving model is the
-- base (its digest is what an engine checks), the dataset version and its
-- digest, and the run as metadata.
lineage : Adapter -> Registry.Lineage
lineage a =
    { base = Local.fromReference a.serving
    , dataset = a.dataset ++ "@" ++ String.left 12 a.datasetDigest
    , datasetDigest = a.datasetDigest
    , metadata =
        [ ( "runId", a.runId )
        , ( "baseId", a.baseId )
        , ( "backend", a.backend )
        , ( "toolchain", a.toolchain )
        , ( "seed", String.fromInt a.seed )
        , ( "steps", String.fromInt a.steps )
        , ( "trainLoss", String.fromFloat a.trainLoss )
        , ( "valLoss", String.fromFloat a.valLoss )
        , ( "job", a.job )
        ]
    }


-- | The GGUF adapter as a pinned file, for `Local.withAdapter`. A job without
-- `withGgufExport` has no GGUF adapter: this is `Nothing`.
adapterRef : Adapter -> Maybe Local.ModelRef
adapterRef a =
    Maybe.map (\g -> Local.file { path = g.path, sha256 = g.sha256 }) a.gguf

-- ── Kernels ─────────────────────────────────────────────────────────
type alias RawStaged =
    { train : Int
    , eval : Int
    }

type alias RawTokenized =
    { train : Int
    , eval : Int
    , steps : Int
    }

type alias RawVersion =
    { name : String
    , version : String
    }

-- | One package of a toolchain and its version.
type alias ToolchainVersion =
    RawVersion

-- | A training toolchain: its id (a digest of every pinned input), its
-- managed python and driver, or its native `trainer` (the Mlx backend's
-- `sky-trainer`; `""` for a Python toolchain), and the versions it carries.
type alias Toolchain =
    { name : String
    , id : String
    , python : String
    , driverDir : String
    , dir : String
    , versions : List ToolchainVersion
    , packages : Int
    , installed : Bool
    , trainer : String
    }

type alias RawLaunched =
    { pid : Int
    , attempt : Int
    , resumeFrom : Int
    , startedAtMs : Int
    , attached : Bool
    }

type alias RawWatched =
    { offset : Int
    , lines : List String
    , alive : Bool
    , cancelRequested : Bool
    , stderrTail : String
    }

type alias RawCheckpoint =
    { step : Int
    , path : String
    }

type alias RawRunState =
    { exists : Bool
    , launched : Bool
    , converted : Bool
    , size : Int
    , attemptOffset : Int
    , lines : List String
    , alive : Bool
    , attempt : Int
    , pid : Int
    , cancelRequested : Bool
    , result : String
    , stderrTail : String
    , generation : Int
    }

type alias RawConverted =
    { path : String
    , sha256 : String
    , tensors : Int
    , architecture : String
    }

type alias RawRun =
    { runId : String
    , dir : String
    , modifiedMs : Int
    }


stageRaw : String -> String -> String -> String -> Task Error RawStaged
stageRaw =
    Ffi.kernel "Ai_trainStage"


tokenizeRaw : String -> String -> Task Error RawTokenized
tokenizeRaw =
    Ffi.kernel "Ai_trainTokenize"


toolchainRaw : String -> Task Error Toolchain
toolchainRaw =
    Ffi.kernel "Ai_toolchainEnsure"


trainerRaw : String -> Task Error Toolchain
trainerRaw =
    Ffi.kernel "Ai_trainerEnsure"


toolchainStatusRaw : () -> Task Error (List Toolchain)
toolchainStatusRaw =
    Ffi.kernel "Ai_toolchainStatus"


baseRaw : String -> Task Error String
baseRaw =
    Ffi.kernel "Ai_trainBaseEnsure"


launchRaw : String -> String -> Task Error RawLaunched
launchRaw =
    Ffi.kernel "Ai_trainLaunch"


watchRaw : String -> Int -> Int -> Task Error RawWatched
watchRaw =
    Ffi.kernel "Ai_trainWatch"


checkpointsRaw : String -> Task Error (List RawCheckpoint)
checkpointsRaw =
    Ffi.kernel "Ai_trainCheckpoints"


cancelRaw : String -> Task Error Bool
cancelRaw =
    Ffi.kernel "Ai_trainCancel"


readRaw : String -> Task Error RawRunState
readRaw =
    Ffi.kernel "Ai_trainRead"


runsRaw : String -> Task Error (List RawRun)
runsRaw =
    Ffi.kernel "Ai_trainRuns"


finishRaw : String -> String -> Task Error ()
finishRaw =
    Ffi.kernel "Ai_trainFinish"


resumeRaw : String -> Task Error Int
resumeRaw =
    Ffi.kernel "Ai_trainResume"


convertRaw : String -> String -> String -> Task Error RawConverted
convertRaw =
    Ffi.kernel "Ai_trainConvert"


mergeRaw : String -> String -> Task Error RawConverted
mergeRaw =
    Ffi.kernel "Ai_trainMerge"

type alias RawDigest =
    { sha256 : String
    , size : Int
    }


digestRaw : String -> Task Error RawDigest
digestRaw =
    Ffi.kernel "Ai_fileDigest"


-- ── Toolchains ──────────────────────────────────────────────────────
-- | Install the toolchain a backend trains in (`sky ai provision --train
-- <backend>` calls this): the native trainer for `Mlx`, the managed Python
-- for the others. Idempotent: an installed toolchain returns at once.
provision : Backend -> Task Error Toolchain
provision backend =
    ensureTrainer (backendName backend)


-- The Mlx backend trains natively; the others in their Python toolchain.
ensureTrainer : String -> Task Error Toolchain
ensureTrainer backend =
    if backend == "mlx" then
        trainerRaw backend

    else
        toolchainRaw backend


-- | Download and verify the weights a backend trains the base on, returning
-- their directory. `Fake` needs none: it returns `""`.
provisionBase : Backend -> BaseModel -> Task Error String
provisionBase backend base =
    case baseWeights backend base of

        Just snap ->
            baseRaw (snapshotJson snap)

        Nothing ->
            case backend of

                Fake ->
                    Task.succeed ""

                _ ->
                    Task.fail
                        (invalid
                            "base"
                            (baseId base ++ " has no weights for the "
                                ++ backendName backend
                                ++ " backend; give it Train.withWeights"))


-- | Download and verify a pinned snapshot below the AI home and return its
-- directory (`<home>/bases/<org>--<repo>@<commit>`). `Std.Ai.Serve` stages
-- its base this way.
provisionSnapshot : Snapshot -> Task Error String
provisionSnapshot snap =
    baseRaw (snapshotJson snap)


snapshotJson : Snapshot -> String
snapshotJson snap =
    JsonE.encode
        0
        (JsonE.object
            [ ( "files"
              , JsonE.list
                    (\f ->
                        JsonE.object
                            [ ( "path", JsonE.string f.path )
                            , ( "sha256", JsonE.string f.sha256 )
                            ])
                    snap.files
              )
            , ( "repo", JsonE.string snap.repo )
            , ( "revision", JsonE.string snap.revision )
            ])


-- | Every toolchain this host can run, installed or not.
toolchainStatus : () -> Task Error (List Toolchain)
toolchainStatus _ =
    toolchainStatusRaw ()

-- ── The durable workflow ────────────────────────────────────────────
-- | A run's durable input: the run's id and the digest of the job that
-- started it. A worker whose job differs refuses the run.
type alias RunRequest =
    { runId : String
    , job : String
    }


requestCodec : Codec RunRequest
requestCodec =
    Codec.object (\r j -> { runId = r, job = j })
        |> Codec.field "runId" .runId Codec.string
        |> Codec.field "job" .job Codec.string
        |> Codec.buildObject


request : Job -> RunRequest
request job =
    { runId = runId job, job = Crypto.sha256 (jobJson job) }


settingCodec : Codec RawSetting
settingCodec =
    Codec.object (\k n v s -> { key = k, name = n, value = v, source = s })
        |> Codec.field "key" .key Codec.string
        |> Codec.field "name" .name Codec.string
        |> Codec.field "value" .value Codec.string
        |> Codec.field "source" .source Codec.string
        |> Codec.buildObject


shapeCodec : Codec ModelShape
shapeCodec =
    Codec.object
        (\a l h i q k v p ->
            { architecture = a
            , layers = l
            , hidden = h
            , intermediate = i
            , qDim = q
            , kvDim = k
            , vocab = v
            , parameters = p
            })
        |> Codec.field "architecture" .architecture Codec.string
        |> Codec.field "layers" .layers Codec.int
        |> Codec.field "hidden" .hidden Codec.int
        |> Codec.field "intermediate" .intermediate Codec.int
        |> Codec.field "qDim" .qDim Codec.int
        |> Codec.field "kvDim" .kvDim Codec.int
        |> Codec.field "vocab" .vocab Codec.int
        |> Codec.field "parameters" .parameters Codec.int
        |> Codec.buildObject

-- The journalled part of a toolchain: what a launch needs.
type alias Tool =
    { name : String
    , id : String
    , python : String
    , driverDir : String
    , trainer : String
    }


toolCodec : Codec Tool
toolCodec =
    Codec.object
        (\n i p d t ->
            { name = n, id = i, python = p, driverDir = d, trainer = t })
        |> Codec.field "name" .name Codec.string
        |> Codec.field "id" .id Codec.string
        |> Codec.field "python" .python Codec.string
        |> Codec.field "driverDir" .driverDir Codec.string
        |> Codec.field "trainer" .trainer Codec.string
        |> Codec.buildObject

-- Where the run stands when the workflow takes it up: the last attempt
-- recorded in the run directory (-1 for none) and whether it finished.
type alias Origin =
    { attempt : Int
    , alive : Bool
    , finished : Bool
    , offset : Int
    }


originCodec : Codec Origin
originCodec =
    Codec.object
        (\a l f o -> { attempt = a, alive = l, finished = f, offset = o })
        |> Codec.field "attempt" .attempt Codec.int
        |> Codec.field "alive" .alive Codec.bool
        |> Codec.field "finished" .finished Codec.bool
        |> Codec.field "offset" .offset Codec.int
        |> Codec.buildObject

-- What one watch saw, reduced to what the workflow decides on (the lines
-- themselves stay in the run directory, so the journal stays small).
type alias Seen =
    { offset : Int
    , outcome : String
    , step : Int
    , code : String
    , message : String
    , trainLoss : Float
    , valLoss : Float
    , peft : String
    , relaunches : Int
    , resumedFrom : Int
    , peakBytes : Int
    , capBytes : Int
    }


seenCodec : Codec Seen
seenCodec =
    Codec.object
        (\o c s cd m tl vl pf rl rf pk cp ->
            { offset = o
            , outcome = c
            , step = s
            , code = cd
            , message = m
            , trainLoss = tl
            , valLoss = vl
            , peft = pf
            , relaunches = rl
            , resumedFrom = rf
            , peakBytes = pk
            , capBytes = cp
            })
        |> Codec.field "offset" .offset Codec.int
        |> Codec.field "outcome" .outcome Codec.string
        |> Codec.field "step" .step Codec.int
        |> Codec.field "code" .code Codec.string
        |> Codec.field "message" .message Codec.string
        |> Codec.field "trainLoss" .trainLoss Codec.float
        |> Codec.field "valLoss" .valLoss Codec.float
        |> Codec.field "peft" .peft Codec.string
        |> Codec.field "relaunches" .relaunches Codec.int
        |> Codec.field "resumedFrom" .resumedFrom Codec.int
        |> Codec.field "peakBytes" .peakBytes Codec.int
        |> Codec.field "capBytes" .capBytes Codec.int
        |> Codec.buildObject


checkpointCodec : Codec RawCheckpoint
checkpointCodec =
    Codec.object (\s p -> { step = s, path = p })
        |> Codec.field "step" .step Codec.int
        |> Codec.field "path" .path Codec.string
        |> Codec.buildObject


convertedCodec : Codec Artefact
convertedCodec =
    artefactCodec

-- Everything the steps before the launch settled.
type alias Setup =
    { backend : String
    , shape : ModelShape
    , tool : Tool
    , weights : String
    , capBytes : Int
    }


-- | The training workflow, registered under `name`. Each line is a
-- journalled `Std.Durable` step:
--
--     resolve      the backend (env > code > detection)
--     stage        the version's Train and Eval rows into the run directory
--     trainer      the native trainer (Mlx) or the managed toolchain,
--                  installed if allowed
--     base         the backend's base weights, downloaded and verified
--     shape        the serving model's shape (fetched if allowed)
--     fit          the memory estimate against the cap (the job's, else this
--                  host's): a job that will not fit is ModelTooLarge before
--                  the trainer starts; the cap is the trainer's guard
--     origin       the run directory's last attempt, if any
--     launch-<a>   the trainer, detached (attaches if it already runs)
--     watch-<a>-<n>, tick-<a>-<n>
--                  watch up to the window, then a durable one-second sleep
--     resume-<a>, launch-<a>
--                  a dead trainer relaunched from its newest checkpoint
--     collect      the PEFT adapter's digest, checked against the trainer's
--     convert      the GGUF adapter (withGgufExport)
--     merge        the merged GGUF model (withMergedExport)
--     register     the registry version (withRegistry)
--
-- The run finishes with its result in `<run>/result.json`, a success or the
-- typed failure, which `progress` and `drive` read.
workflow : String -> Job -> Durable.WorkflowDef RunRequest Adapter
workflow name job =
    Durable.register name requestCodec adapterCodec (body job)


-- | The workflows of several jobs, for a worker's `Durable.poll` list.
workflows : List Job -> List Durable.RegisteredWorkflow
workflows jobs =
    List.map (\j -> Durable.erase (defaultWorkflow j)) jobs


defaultWorkflow : Job -> Durable.WorkflowDef RunRequest Adapter
defaultWorkflow job =
    workflow ("sky.ai.train/" ++ runId job) job


durableId : Job -> Int -> String
durableId job generation =
    if generation == 0 then
        runId job

    else
        runId job ++ "-g" ++ String.fromInt generation


-- | Start the job's run (idempotent: a run that exists is left alone) and
-- return its id. A worker then advances it with `poll`. The job is checked
-- and its backend resolved first, so a job that cannot run here (a bad
-- setting, a backend this host lacks) fails at once and starts no run.
start : Db -> Job -> Task Error String
start db code =
    effective code |> Task.andThen (startEffective db code)


startEffective : Db -> Job -> Job -> Task Error String
startEffective db code job =
    Task.fromResult (check job)
        |> Task.andThen (\_ -> resolveRaw (backendCode (settings job)))
        |> Task.andThen
               (\b ->
                   if b.value == "vertex" then
                       cloudSettings job
                           |> Task.map
                                  (\_ ->
                                      -- A cloud job's settings are checked before a run
                                      -- exists: no project, no budget, an unpinned image.
                                      ())

                   else
                       Task.succeed ())
        |> Task.andThen (\_ -> Durable.setup db)
        |> Task.andThen (\_ -> Trace.setup db)
        |> Task.andThen (\_ -> readRaw (runDir job))
        |> Task.andThen
               (\state ->
                   -- The workflow is named after the job as written (a
                   -- worker's `workflows` list is pure); the run is the
                   -- effective job's.
                   Durable.start
                       db
                       (defaultWorkflow code)
                       (durableId job state.generation)
                       (request job))
        |> Task.map (\_ -> runId job)


-- | Advance the runs of these jobs that are due (one worker tick). `True`
-- when it did work.
poll : Db -> List Job -> Task Error Bool
poll db jobs =
    Durable.poll db (workflows jobs)


-- | Train in the foreground: start the run, advance it until it ends, and
-- return the adapter (or the run's typed failure). A finished run returns its
-- adapter at once; a run whose trainer is still running is attached to. A
-- Ctrl-C stops this program only: the trainer keeps training, and `drive` or
-- `start` picks it up again.
drive : Db -> Job -> Task Error Adapter
drive db code =
    effective code
        |> Task.andThen
               (\job ->
                   startEffective db code job
                       |> Task.andThen
                              (\_ -> Task.loop (driveStep db code job) 0))


driveStep : Db -> Job -> Job -> Int -> Task Error (Task.Step Int Adapter)
driveStep db code job n =
    readRaw (runDir job)
        |> Task.andThen
               (\state ->
                   case resultOf state.result of

                       Just (Ok a) ->
                           Task.succeed (Task.Done a)

                       Just (Err e) ->
                           Task.fail e

                       Nothing ->
                           poll db [ code ]
                               |> Task.andThen
                                      (\worked ->
                                          if worked then
                                              Task.succeed (Task.Loop (n + 1))

                                          else
                                              Time.sleep 250
                                                  |> Task.map
                                                         (\_ -> Task.Loop (n + 1))))


-- The finished run's record: Ok adapter, Err failure, Nothing while it runs.
resultOf : String -> Maybe (Result Error Adapter)
resultOf text =
    if String.isEmpty text then
        Nothing

    else
        case JsonD.decodeString (JsonD.field "status" JsonD.string) text of

            Ok "done" ->
                Just (adapterIn text)

            Ok _ ->
                Just (Err (errorIn text))

            Err e ->
                Just (Err e)


adapterIn : String -> Result Error Adapter
adapterIn text =
    case JsonD.decodeString (JsonD.field "adapter" JsonD.value) text of

        Ok v ->
            Codec.fromJson adapterCodec (JsonE.encode 0 v)

        Err e ->
            Err e


errorIn : String -> Error
errorIn text =
    case JsonD.decodeString (JsonD.field "error" JsonD.value) text of

        Ok v ->
            case Codec.fromJson Codec.error (JsonE.encode 0 v) of

                Ok e ->
                    e

                Err _ ->
                    Error.unexpected ("the run failed: " ++ text)

        Err _ ->
            Error.unexpected ("the run failed: " ++ text)


-- | Start the run again after it failed or was cancelled: the next `start` or
-- `drive` relaunches the trainer from its newest verified checkpoint. Returns
-- the run's new generation.
resume : Job -> Task Error Int
resume job =
    effective job |> Task.andThen (\e -> resumeRaw (runDir e))


-- | `resume` for the run in a run directory.
resumeAt : String -> Task Error Int
resumeAt dir =
    resumeRaw dir


-- | Convert the finished adapter in a run directory to GGUF (and, with
-- `merged`, fold it into the serving model), whether or not the job asked for
-- it. The serving model and the base come from the run's `job.json`. Returns
-- the GGUF adapter, or the merged model.
exportAt : String -> Bool -> Task Error Artefact
exportAt dir merged =
    File.readFile (dir ++ "/job.json")
        |> Task.andThen
               (\text ->
                   Task.fromResult
                       (JsonD.decodeString
                           (JsonD.map2
                               Tuple.pair
                               (JsonD.field "serving" JsonD.string)
                               (JsonD.field "base" JsonD.string))
                           text))
        |> Task.andThen
               (\( serving, base ) ->
                   convertRaw dir serving base
                       |> Task.andThen
                              (\c ->
                                  if merged then
                                      mergeRaw dir serving

                                  else
                                      Task.succeed c))
        |> Task.map (\c -> { path = c.path, sha256 = c.sha256 })


-- | Cancel the job's run: the trainer writes a checkpoint and stops (killed
-- after a minute if it does not), and the run ends with `TrainingCancelled`.
-- `True` when a live trainer was signalled.
cancel : Job -> Task Error Bool
cancel job =
    effective job |> Task.andThen (\e -> cancelAt (runDir e))


-- | Cancel the run in a run directory. A Vertex run is cancelled in the
-- cloud: a `cancel` marker in its staging prefix (the container's shim
-- checkpoints and stops) and Vertex's own cancel.
cancelAt : String -> Task Error Bool
cancelAt dir =
    readCloudFile dir
        |> Task.andThen
               (\found ->
                   case found of

                       Just c ->
                           if c.job == "" then
                               cancelRaw dir

                           else
                               cancelCloud c

                       Nothing ->
                           cancelRaw dir)


-- | The job's run's progress, from its run directory (no database needed).
progress : Job -> Task Error Progress
progress job =
    effective job |> Task.andThen (\e -> progressAt (runDir e))


-- | The job's finished adapter: `Nothing` while the run has not finished, the
-- adapter when it has, and the run's typed failure (`TrainingFailed`,
-- `TrainingCancelled`, …) when it failed.
result : Job -> Task Error (Maybe Adapter)
result code =
    effective code |> Task.andThen (\job -> readRaw (runDir job))
        |> Task.andThen
               (\state ->
                   case resultOf state.result of

                       Just (Ok a) ->
                           Task.succeed (Just a)

                       Just (Err e) ->
                           Task.fail e

                       Nothing ->
                           Task.succeed Nothing)


-- | The progress of the run in a run directory.
progressAt : String -> Task Error Progress
progressAt dir =
    readRaw dir |> Task.map (progressOf (lastSegment dir))


lastSegment : String -> String
lastSegment path =
    String.split "/" path |> List.filter (\p -> not (String.isEmpty p))
        |> List.reverse
        |> List.head
        |> Maybe.withDefault path


progressOf : String -> RawRunState -> Progress
progressOf id state =
    let
        folded = foldLines state.lines (emptyProgress id)
    in
        case resultOf state.result of

            Just (Ok a) ->
                { folded
                    | status = Done
                    , message =
                        case a.registered of

                            Just label ->
                                "registered " ++ label

                            Nothing ->
                                "done"
                }

            Just (Err e) ->
                case Failure.fromError e of

                    Just (TrainingCancelled _) ->
                        { folded
                            | status = Cancelled
                            , message = Error.toString e
                        }

                    _ ->
                        { folded | status = Failed, message = Error.toString e }

            Nothing ->
                if not state.exists then
                    folded

                else if state.alive then
                    { folded | status = Running }

                else if not state.launched then
                    { folded
                        -- Staged; the trainer and the base are on their way.
                        | status = Provisioning
                    }

                else if folded.status == Running then
                    { folded | status = Relaunching }

                else if folded.status == Converting && state.converted then
                    { folded
                        -- The GGUF adapter is written: the run is registering.
                        | status = Registering
                    }

                else
                    folded


-- | Every run in a work directory, newest first, with its progress.
runs : String -> Task Error (List Progress)
runs workDir =
    runsRaw workDir
        |> Task.andThen
               (\rs ->
                   Task.sequence
                       (List.map
                           (\r -> readRaw r.dir |> Task.map (progressOf r.runId))
                           rs))


-- ── The workflow body ───────────────────────────────────────────────
-- The worker resolves the job's settings once, as a journalled step, so a
-- replay runs the job the first attempt ran; a worker whose environment makes
-- it a different run refuses it.
body : Job -> Durable.Ctx -> RunRequest -> Task Error Adapter
body code ctx req =
    Durable.step
        ctx
        (Codec.list settingCodec)
        "settings"
        (effectiveWith code |> Task.map Tuple.second)
        |> Task.onError
               (\e ->
                   recordFailure ((settings code).workDir ++ "/" ++ req.runId) e
                       |> Task.map (\_ -> []))
        |> Task.andThen (\sts -> bodyFor (applyAll sts code) ctx req)


bodyFor : Job -> Durable.Ctx -> RunRequest -> Task Error Adapter
bodyFor job ctx req =
    if req.runId /= runId job then
        Task.fail
            (invalid
                "job"
                ("this worker's job is run " ++ runId job
                    ++ ", and the durable run is "
                    ++ req.runId
                    ++ "; the job or its SKY_AI_TRAIN_* settings changed after the run started (a new job is a new run)"))
            |> Task.onError (\e -> recordFailure (runDir job) e)

    else
        trainRun ctx job
            |> Task.onError
                   (\e ->
                       costOnFailure ctx job e
                           |> Task.andThen (recordFailure (runDir job)))
            |> Task.andThen (\a -> traceCost ctx job |> Task.map (\_ -> a))


trainRun : Durable.Ctx -> Job -> Task Error Adapter
trainRun ctx job =
    resolveStep ctx job |> Task.andThen (trainOn ctx job)


trainOn : Durable.Ctx -> Job -> String -> Task Error Adapter
trainOn ctx job backend =
    if backend == "vertex" then
        cloudTrain ctx job
            |> Task.andThen
                   (\( st, seen, cloud ) ->
                       finish ctx job (cloudCleanup ctx job cloud) ( st, seen ))

    else
        setupFrom ctx job backend |> Task.andThen (\st -> train ctx job st)
            |> Task.andThen
                   (\done -> finish ctx job (\a -> Task.succeed a) done)


-- ── Std.Ai.Trace ────────────────────────────────────────────────────
-- A training run's rows in Std.Ai.Trace, under the run's id (`runId job`):
-- each step's progress as the watch reads it, and one cost row when the run
-- ends, finished or failed. A Vertex run's row is its measured spend in exact
-- money; a run on this machine has no price, so its row is unpriced. Every
-- row is keyed (the step; "cost"), so a replayed step writes nothing twice.
-- The progress in a run's protocol lines: one entry per step, with the
-- checkpoint written at that step.
traceProgressOf : List String -> List Trace.TrainingStep
traceProgressOf lines =
    List.foldl addProgressLine [] lines


addProgressLine : String -> List Trace.TrainingStep -> List Trace.TrainingStep
addProgressLine line acc =
    case decodeEvent line of

        Ok (Just (StepProgress p)) ->
            upsertStep
                p.step
                (\old ->
                    { step = p.step
                    , total = p.total
                    , loss = finite p.loss
                    , tokensPerSecond = finite p.tokensPerSecond
                    , checkpoint =
                        case old of

                            Just pr ->
                                pr.checkpoint

                            Nothing ->
                                ""
                    })
                acc

        Ok (Just (Checkpoint c)) ->
            upsertStep
                c.step
                (\old ->
                    case old of

                        Just pr ->
                            { pr | checkpoint = c.path }

                        Nothing ->
                            { step = c.step
                            , total = 0
                            , loss = Nothing
                            , tokensPerSecond = Nothing
                            , checkpoint = c.path
                            })
                acc

        _ ->
            acc


-- A value the trainer could not write reads as -1 (`num`): no value.
finite : Float -> Maybe Float
finite x =
    if x < 0.0 then
        Nothing

    else
        Just x


upsertStep : Int -> (Maybe Trace.TrainingStep -> Trace.TrainingStep) -> List Trace.TrainingStep -> List Trace.TrainingStep
upsertStep step make acc =
    case acc of

        [] ->
            [ make Nothing ]

        pr :: rest ->
            -- `[ x ] ++ rest`, not `x :: rest`: both sides are typed lists of
            -- one element type, so the append is typed (`rt.List_appendT`),
            -- where a cons returns `any` and is narrowed back.
            if pr.step == step then
                [ make (Just pr) ] ++ rest

            else
                [ pr ] ++ upsertStep step make rest


-- A trace write, with the tables made first when a run started by an earlier
-- release meets a database without them.
withTraceTables : Db -> Task Error () -> Task Error ()
withTraceTables db write =
    write |> Task.onError (\_ -> Trace.setup db |> Task.andThen (\_ -> write))


traceLines : Durable.Ctx -> Job -> List String -> Task Error ()
traceLines ctx job lines =
    let
        db = Durable.conn ctx
    in
        withTraceTables
            db
            (traceProgressOf lines
                |> List.map (Trace.recordTrainingStep db (runId job))
                |> Task.sequence
                |> Task.map (\_ -> ()))


-- Every progress line of the run so far (a cloud run's events are mirrored
-- into the run directory by its watch).
traceRunLines : Durable.Ctx -> Job -> Task Error ()
traceRunLines ctx job =
    readRaw (runDir job)
        |> Task.andThen (\state -> traceLines ctx job state.lines)


-- The run's cost row, once.
traceCost : Durable.Ctx -> Job -> Task Error ()
traceCost ctx job =
    Durable.step
        ctx
        Codec.string
        "trace-cost"
        (writeCost ctx job |> Task.map (\_ -> ""))
        |> Task.map (\_ -> ())


writeCost : Durable.Ctx -> Job -> Task Error ()
writeCost ctx job =
    let
        db = Durable.conn ctx
        e =
            { runId = runId job
            , key = "cost"
            , kind = Trace.Training
            , book = Nothing
            }
    in
        cloudStatus job
            |> Task.andThen
                   (\status ->
                       withTraceTables
                           db
                           (case status of

                               Just cs ->
                                   Trace.recordCost db e (runId job) cs.spent

                               Nothing ->
                                   Trace.recordUnpriced db e (runId job)))


-- A failed run records its cost too (a cloud run paid for what it did). When
-- that write fails as well, the run's own failure is kept and says so.
costOnFailure : Durable.Ctx -> Job -> Error -> Task Error Error
costOnFailure ctx job e =
    if Durable.isSuspend e then
        Task.succeed e

    else
        traceCost ctx job |> Task.map (\_ -> e)
            |> Task.onError
                   (\traceErr ->
                       Task.succeed
                           (Error.withMessage
                               (messageOf e
                                   ++ " (and its cost row could not be recorded: "
                                   ++ messageOf traceErr
                                   ++ ")")
                               e))


messageOf : Error -> String
messageOf e =
    case e of

        Error.Error _ info ->
            info.message


recordFailure : String -> Error -> Task Error Adapter
recordFailure dir e =
    if Durable.isSuspend e then
        Task.fail e

    else
        finishRaw
            dir
            (JsonE.encode
                0
                (JsonE.object
                    [ ( "error"
                      , Result.withDefault
                            JsonE.null
                            (JsonE.raw (Codec.toJson Codec.error e))
                      )
                    , ( "message", JsonE.string (Error.toString e) )
                    , ( "status", JsonE.string "failed" )
                    ]))
            |> Task.andThen (\_ -> Task.fail e)


resolveStep : Durable.Ctx -> Job -> Task Error String
resolveStep ctx job =
    Durable.step
        ctx
        settingCodec
        "resolve"
        (resolveRaw (backendCode (settings job)))
        |> Task.andThen
               (\b -> Task.fromResult (check job) |> Task.map (\_ -> b.value))


setupFrom : Durable.Ctx -> Job -> String -> Task Error Setup
setupFrom ctx job backend =
    stageStep ctx job backend |> Task.andThen (trainerStep ctx)
        |> Task.andThen (baseStep ctx job)
        |> Task.andThen (tokenizeStep ctx job)
        |> Task.andThen (shapeStep ctx job)


stageStep : Durable.Ctx -> Job -> String -> Task Error String
stageStep ctx job backend =
    let
        s = settings job
    in
        Durable.step
            ctx
            Codec.int
            "stage"
            (stageRaw (runDir job) s.dataFile s.datasetDigest (jobJson job)
                |> Task.map (\st -> st.train))
            |> Task.map (\_ -> backend)


trainerStep : Durable.Ctx -> String -> Task Error ( String, Tool )
trainerStep ctx backend =
    Durable.step
        ctx
        toolCodec
        "trainer"
        (ensureTrainer backend |> Task.map toolOf)
        |> Task.map (\tool -> ( backend, tool ))


baseStep : Durable.Ctx -> Job -> ( String, Tool ) -> Task Error ( String, Tool, String )
baseStep ctx job ( backend, tool ) =
    Durable.step ctx Codec.string "base" (weightsFor backend job)
        |> Task.map (\w -> ( backend, tool, w ))


-- The native trainer's data: the staged rows tokenized with the base's own
-- tokenizer and chat format, and the order of every step (data/train.tok,
-- data/valid.tok, data/order.bin). Only the MLX backend trains natively; the
-- other backends read data/*.jsonl themselves.
tokenizeStep : Durable.Ctx -> Job -> ( String, Tool, String ) -> Task Error ( String, Tool, String )
tokenizeStep ctx job ( backend, tool, weights ) =
    if backend == "mlx" && weights /= "" then
        Durable.step
            ctx
            Codec.int
            "tokenize"
            (tokenizeRaw (runDir job) weights |> Task.map .steps)
            |> Task.map (\_ -> ( backend, tool, weights ))

    else
        Task.succeed ( backend, tool, weights )


shapeStep : Durable.Ctx -> Job -> ( String, Tool, String ) -> Task Error Setup
shapeStep ctx job ( backend, tool, weights ) =
    Durable.step ctx shapeCodec "shape" (shapeOf (baseOf job))
        |> Task.andThen
               (\shape ->
                   Durable.step
                       ctx
                       Codec.int
                       "fit"
                       (host ()
                           |> Task.andThen
                                  (\h ->
                                      fitPlan
                                          job
                                          []
                                          { key = ""
                                          , name = ""
                                          , value = backend
                                          , source = ""
                                          }
                                          h
                                          shape)
                           |> Task.map .capBytes)
                       |> Task.map
                              (\cap ->
                                  { backend = backend
                                  , shape = shape
                                  , tool = tool
                                  , weights = weights
                                  , capBytes = cap
                                  }))


toolOf : Toolchain -> Tool
toolOf t =
    { name = t.name
    , id = t.id
    , python = t.python
    , driverDir = t.driverDir
    , trainer = t.trainer
    }


weightsFor : String -> Job -> Task Error String
weightsFor backend job =
    case backend of

        "vertex" ->
            -- The container fetches and verifies its own weights.
            Task.succeed ""

        "mlx" ->
            provisionBase Mlx (baseOf job)

        "unsloth" ->
            provisionBase Unsloth (baseOf job)

        _ ->
            Task.succeed ""


-- The driver's configuration for one attempt (driver.json).
driverJson : Job -> Setup -> Int -> Maybe RawCheckpoint -> String
driverJson job st attempt from =
    let
        s = settings job
    in
        JsonE.encode
            0
            (JsonE.object
                [ ( "alpha", JsonE.int (alphaOf s) )
                , ( "attempt", JsonE.int attempt )
                , ( "backend", JsonE.string st.backend )
                , ( "base"
                  , JsonE.object
                        [ ( "id", JsonE.string s.baseId )
                        , ( "weights", JsonE.string st.weights )
                        ]
                  )
                , ( "batch"
                  , JsonE.object
                        [ ( "accumulate", JsonE.int s.batch.accumulate )
                        , ( "perDevice", JsonE.int s.batch.perDevice )
                        ]
                  )
                , ( "checkpointEvery", JsonE.int s.checkpointEvery )
                , ( "driverDir", JsonE.string st.tool.driverDir )
                , ( "epochs", JsonE.int s.epochs )
                , ( "evalEvery", JsonE.int s.evalEvery )
                , ( "fakeCrashAt", JsonE.int s.fakeCrashAt )
                , ( "fakeStepMs", JsonE.int s.fakeStepMs )
                , ( "format", JsonE.string s.format )
                , ( "gradientCheckpointing"
                  , JsonE.bool s.gradientCheckpointing
                  )
                , ( "layers", JsonE.int s.layers )
                , ( "learningRate", JsonE.float s.learningRate )
                , ( "maxSteps", JsonE.int s.maxSteps )
                , ( "memoryCap", JsonE.int st.capBytes )
                , ( "python", JsonE.string st.tool.python )
                , ( "quantBits", JsonE.int s.quantBits )
                , ( "quantised", JsonE.bool (s.quantBits < 16) )
                , ( "rank", JsonE.int s.rank )
                , ( "resumeDir"
                  , JsonE.string (Maybe.withDefault "" (Maybe.map .path from))
                  )
                , ( "resumeFrom"
                  , JsonE.int (Maybe.withDefault 0 (Maybe.map .step from))
                  )
                , ( "seed", JsonE.int s.seed )
                , ( "sequenceLength", JsonE.int s.sequenceLength )
                , ( "shapes"
                  , JsonE.object
                        [ ( "hidden", JsonE.int st.shape.hidden )
                        , ( "intermediate", JsonE.int st.shape.intermediate )
                        , ( "kvDim", JsonE.int st.shape.kvDim )
                        , ( "layers", JsonE.int st.shape.layers )
                        , ( "qDim", JsonE.int st.shape.qDim )
                        ]
                  )
                , ( "targets", JsonE.list JsonE.string s.targets )
                , ( "toolchain", JsonE.string st.tool.id )
                , ( "trainer", JsonE.string st.tool.trainer )
                , ( "v", JsonE.int 1 )
                ])


-- The run directory as the workflow finds it: a run whose trainer finished
-- is collected without a launch, a live trainer is attached to, otherwise
-- the next attempt starts (from the newest checkpoint when there is one).
origin : String -> Task Error Origin
origin dir =
    readRaw dir
        |> Task.map
               (\state ->
                   let
                       folded = foldLines state.lines (emptyProgress "")
                       finished = folded.status == Converting
                   in
                       { attempt =
                           if state.launched then
                               state.attempt

                           else
                               -1
                       , alive = state.alive
                       , finished = finished
                       , offset =
                           if finished || state.alive then
                               state.attemptOffset

                           else
                               state.size
                       })


train : Durable.Ctx -> Job -> Setup -> Task Error ( Setup, Seen )
train ctx job st =
    let
        dir = runDir job
    in
        Durable.step ctx originCodec "origin" (origin dir)
            |> Task.andThen
                   (\o ->
                       if o.finished || o.alive then
                           watchLoop
                               ctx
                               job
                               st
                               (Math.max 0 o.attempt)
                               0
                               0
                               o.offset
                               |> Task.map
                                      (\seen ->
                                          -- Attach: the trainer finished or still runs.
                                          ( st, seen ))

                       else
                           let
                               attempt = o.attempt + 1
                           in
                               launchAttempt ctx job st attempt
                                   |> Task.andThen
                                          (\_ ->
                                              watchLoop
                                                  ctx
                                                  job
                                                  st
                                                  attempt
                                                  0
                                                  0
                                                  o.offset)
                                   |> Task.map (\seen -> ( st, seen )))


launchAttempt : Durable.Ctx -> Job -> Setup -> Int -> Task Error RawLaunched
launchAttempt ctx job st attempt =
    let
        dir = runDir job
        tag = String.fromInt attempt
    in
        Durable.step
            ctx
            (Codec.maybe checkpointCodec)
            ("resume-" ++ tag)
            (if attempt == 0 then
                Task.succeed Nothing

            else
                checkpointsRaw dir |> Task.map List.head)
            |> Task.andThen
                   (\from ->
                       Durable.step
                           ctx
                           launchedCodec
                           ("launch-" ++ tag)
                           (launchRaw dir (driverJson job st attempt from)))


launchedCodec : Codec RawLaunched
launchedCodec =
    Codec.object
        (\p a r s at ->
            { pid = p
            , attempt = a
            , resumeFrom = r
            , startedAtMs = s
            , attached = at
            })
        |> Codec.field "pid" .pid Codec.int
        |> Codec.field "attempt" .attempt Codec.int
        |> Codec.field "resumeFrom" .resumeFrom Codec.int
        |> Codec.field "startedAtMs" .startedAtMs Codec.int
        |> Codec.field "attached" .attached Codec.bool
        |> Codec.buildObject


-- Watch the trainer: each watch is a journalled step that blocks up to the
-- window, and between two watches a one-second durable sleep releases the
-- run, so a worker never holds it past its lease.
watchLoop : Durable.Ctx -> Job -> Setup -> Int -> Int -> Int -> Int -> Task Error Seen
watchLoop ctx job st attempt relaunched n offset =
    let
        s = settings job
        dir = runDir job
        tag = String.fromInt attempt ++ "-" ++ String.fromInt n
    in
        Durable.step
            ctx
            seenCodec
            ("watch-" ++ tag)
            (watchRaw dir offset s.watchWindowMs
                |> Task.andThen
                       (\w ->
                           traceLines ctx job w.lines
                               |> Task.map (\_ -> seenOf offset w)))
            |> Task.andThen
                   (\seen ->
                       case seen.outcome of

                           "done" ->
                               Task.succeed { seen | relaunches = relaunched }

                           "error" ->
                               Task.fail (driverFailure job seen)

                           "cancelled" ->
                               Task.fail (cancelled job seen.step)

                           "running" ->
                               Durable.sleep ctx ("tick-" ++ tag) 1000
                                   |> Task.andThen
                                          (\_ ->
                                              watchLoop
                                                  ctx
                                                  job
                                                  st
                                                  attempt
                                                  relaunched
                                                  (n + 1)
                                                  seen.offset)

                           "cancelling" ->
                               Task.fail (cancelled job seen.step)

                           _ ->
                               if relaunched >= s.maxRelaunches then
                                   Task.fail
                                       (Failure.toError
                                           (TrainingFailed
                                               { runId = runId job
                                               , step = seen.step
                                               , reason =
                                                   "the trainer died without finishing "
                                                       ++ String.fromInt
                                                              (relaunched + 1)
                                                       ++ " times (withMaxRelaunches "
                                                       ++ String.fromInt
                                                              s.maxRelaunches
                                                       ++ ")"
                                               , logTail = seen.message
                                               }))

                               else
                                   launchAttempt ctx job st (attempt + 1)
                                       |> Task.andThen
                                              (\_ ->
                                                  watchLoop
                                                      ctx
                                                      job
                                                      st
                                                      (attempt + 1)
                                                      (relaunched + 1)
                                                      0
                                                      seen.offset))


-- What a watch saw. The outcome is the attempt's terminal line, else
-- `running` while the trainer lives, `cancelling` when a cancel was asked
-- for and the trainer is gone, and `dead` otherwise.
seenOf : Int -> RawWatched -> Seen
seenOf from w =
    let
        start0 =
            { offset = w.offset
            , outcome = ""
            , step = 0
            , code = ""
            , message = ""
            , trainLoss = 0.0
            , valLoss = 0.0
            , peft = ""
            , relaunches = 0
            , resumedFrom = 0
            , peakBytes = 0
            , capBytes = 0
            }
        folded =
            List.foldl
                (\line acc ->
                    if not (String.isEmpty acc.outcome) then
                        acc

                    else
                        case decodeEvent line of

                            Ok (Just ev) ->
                                seeEvent ev acc

                            Ok Nothing ->
                                acc

                            Err e ->
                                { acc
                                    | outcome = "error"
                                    , code = "ToolchainFailed"
                                    , message = Error.toString e
                                })
                start0
                w.lines
    in
        if not (String.isEmpty folded.outcome) then
            folded

        else if w.alive then
            { folded | outcome = "running" }

        else if w.cancelRequested then
            { folded | outcome = "cancelling" }

        else
            { folded | outcome = "dead", message = w.stderrTail }


seeEvent : Event -> Seen -> Seen
seeEvent ev acc =
    case ev of

        Hello h ->
            { acc | resumedFrom = h.resumeFrom }

        StepProgress p ->
            { acc | step = p.step, trainLoss = p.loss }

        Metric m ->
            if m.name == "val_loss" then
                { acc | valLoss = m.value }

            else
                acc

        Checkpoint _ ->
            acc

        Artefact a ->
            if a.kind == "peft" then
                { acc | peft = a.sha256 }

            else
                acc

        DoneEvent d ->
            { acc
                | outcome = "done"
                , step = d.step
                , trainLoss = d.trainLoss
                , valLoss = d.valLoss
            }

        CancelledEvent c ->
            { acc | outcome = "cancelled", step = c.step }

        DriverError e ->
            { acc
                | outcome = "error"
                , code = e.code
                , message = e.message
                , peakBytes = e.peakBytes
                , capBytes = e.capBytes
            }


cancelled : Job -> Int -> Error
cancelled job step =
    Failure.toError (TrainingCancelled { runId = runId job, step = step })


-- A Vertex job stopped at its scheduling timeout, which nobody asked to
-- cancel: BudgetExceeded when the budget set the ceiling and is spent, else
-- TrainingFailed naming the ceiling (`withMaxRuntimeMinutes`).
ceilingReached : Job -> CloudSettings -> CloudPlan -> Money -> Int -> Error
ceilingReached job cs p spent step =
    if Money.gte (Money.add spent (perMinutes cs.perHour 1)) cs.budget then
        Failure.toError
            (BudgetExceeded { budget = cs.budget, estimate = spent })

    else
        Failure.toError
            (TrainingFailed
                { runId = runId job
                , step = step
                , reason =
                    "Vertex AI stopped the job at its runtime ceiling of "
                        ++ String.fromInt (p.timeoutSeconds // 60)
                        ++ " minutes (withMaxRuntimeMinutes) before it finished"
                , logTail = ""
                })


-- A driver's error line as the typed failure its code names.
driverFailure : Job -> Seen -> Error
driverFailure job seen =
    case seen.code of

        "ModelTooLarge" ->
            -- The memory guard's kill: what the trainer had reached, and its
            -- cap.
            Failure.toError
                (ModelTooLarge
                    { needBytes = seen.peakBytes
                    , availableBytes = seen.capBytes
                    })

        "NoAccelerator" ->
            Failure.toError (NoAccelerator { wanted = seen.message })

        "DatasetInvalid" ->
            Failure.toError
                (DatasetInvalid
                    { dataset = (settings job).dataset, reasons = seen.message })

        "ToolchainFailed" ->
            Failure.toError
                (ToolchainFailed { tool = "trainer", logTail = seen.message })

        _ ->
            Failure.toError
                (TrainingFailed
                    { runId = runId job
                    , step = seen.step
                    , reason = seen.message
                    , logTail = ""
                    })


-- Collect, convert, merge, register, and write the result.
finish : Durable.Ctx -> Job -> (Adapter -> Task Error Adapter) -> ( Setup, Seen ) -> Task Error Adapter
finish ctx job after ( st, seen ) =
    -- The checkpoint the last attempt resumed from, read from every protocol
    -- line of the run: the watch that saw `done` may not have seen that
    -- attempt's `hello`, which came in an earlier watch window.
    Durable.step
        ctx
        Codec.int
        "resumed"
        (readRaw (runDir job)
            |> Task.map
                   (\state ->
                       (foldLines state.lines (emptyProgress "")).resumedFrom))
        |> Task.andThen
               (\r -> finishWith ctx job after ( st, { seen | resumedFrom = r } ))


finishWith : Durable.Ctx -> Job -> (Adapter -> Task Error Adapter) -> ( Setup, Seen ) -> Task Error Adapter
finishWith ctx job after ( st, seen ) =
    let
        s = settings job
        dir = runDir job
        peftPath = dir ++ "/adapter/adapter_model.safetensors"
    in
        Durable.step
            ctx
            Codec.string
            "collect"
            (digestRaw peftPath |> Task.map .sha256
                |> Task.andThen
                       (\sum ->
                           if not (String.isEmpty seen.peft) && sum /= seen.peft then
                               Task.fail
                                   (Failure.toError
                                       (ChecksumMismatch
                                           { expected = seen.peft
                                           , actual = sum
                                           }))

                           else
                               Task.succeed sum))
            |> Task.andThen
                   (\peftSum ->
                       optionalStep
                           ctx
                           s.ggufExport
                           "convert"
                           (convertRaw dir s.serving s.baseId)
                           |> Task.andThen
                                  (\gguf ->
                                      optionalStep
                                          ctx
                                          s.mergedExport
                                          "merge"
                                          (mergeRaw dir s.serving)
                                          |> Task.map
                                                 (\merged ->
                                                     adapterOf
                                                         job
                                                         st
                                                         seen
                                                         { path = peftPath
                                                         , sha256 = peftSum
                                                         }
                                                         gguf
                                                         merged)))
            |> Task.andThen (\a -> registerStep ctx job a)
            |> Task.andThen after
            |> Task.andThen
                   (\a ->
                       finishRaw
                           dir
                           (JsonE.encode
                               0
                               (JsonE.object
                                   [ ( "adapter"
                                     , Result.withDefault
                                           JsonE.null
                                           (JsonE.raw
                                               (Codec.toJson adapterCodec a))
                                     )
                                   , ( "status", JsonE.string "done" )
                                   ]))
                           |> Task.map (\_ -> a))


optionalStep : Durable.Ctx -> Bool -> String -> Task Error RawConverted -> Task Error (Maybe Artefact)
optionalStep ctx wanted id task =
    if wanted then
        Durable.step
            ctx
            convertedCodec
            id
            (task |> Task.map (\c -> { path = c.path, sha256 = c.sha256 }))
            |> Task.map Just

    else
        Task.succeed Nothing


adapterOf : Job -> Setup -> Seen -> Artefact -> Maybe Artefact -> Maybe Artefact -> Adapter
adapterOf job st seen peft gguf merged =
    let
        s = settings job
    in
        { name = s.name
        , runId = runId job
        , baseId = s.baseId
        , serving = s.serving
        , dataset = s.dataset
        , datasetDigest = s.datasetDigest
        , backend = st.backend
        , toolchain = st.tool.name ++ "@" ++ st.tool.id
        , method =
            if s.quantBits < 16 then
                "qlora"

            else
                "lora"
        , seed = s.seed
        , steps = seen.step
        , peft = peft
        , gguf = gguf
        , merged = merged
        , trainLoss = seen.trainLoss
        , valLoss = seen.valLoss
        , relaunches = seen.relaunches
        , resumedFrom = seen.resumedFrom
        , registered = Nothing
        , job = jobJson job
        }


registerStep : Durable.Ctx -> Job -> Adapter -> Task Error Adapter
registerStep ctx job a =
    case registryOf job of

        Nothing ->
            Task.succeed a

        Just reg ->
            Durable.step
                ctx
                Codec.string
                "register"
                (Registry.registerWith
                    reg
                    (settings job).name
                    (registryAdapter a)
                    (lineage a)
                    (companions a)
                    |> Task.map Registry.label)
                |> Task.map (\label -> { a | registered = Just label })

-- ── The Vertex backend ──────────────────────────────────────────────
-- A `Vertex` job runs the same driver as `Unsloth` (or, on a machine with no
-- GPU, the Fake driver) in a pinned container, as a Vertex AI custom job.
-- The workflow stages the frozen data as content-addressed blobs in the
-- staging bucket, launches the job exactly once, watches it through the
-- protocol segments the container writes next to its checkpoints, stops it at
-- the budget, relaunches a lost attempt from its newest checkpoint, downloads
-- the adapter, and from there finishes like a local run (convert, register).
--
-- The run's objects, below the staging location:
--
--     runs/<key>/inputs.json                   what every attempt trains on
--     runs/<key>/launch-<a>.intent             the exactly-once launch marker
--     runs/<key>/attempt-<a>/hello.json        the job that runs attempt a
--     runs/<key>/attempt-<a>/events/<seq>.jsonl  protocol segments
--     runs/<key>/checkpoints/<step>/…          manifest.json written last
--     runs/<key>/adapter/…                     the PEFT adapter, manifest last
--     runs/<key>/done.json, cancel             the end; a cancel request
--
-- `<key>` is `runKey (runId job)`. The run directory on this machine mirrors
-- the protocol (`events.jsonl`) and the job's state (`cloud.json`), so
-- `progress`, `runs`, the console and `cancel` work as they do locally.
-- | A `Vertex` job's resolved settings: each from the operator's variable,
-- else the job's `withX` value, else the default; the machine's
-- accelerator; the rate the price book gives it; and where each setting came
-- from.
type alias CloudSettings =
    { project : String
    , region : String
    , machine : String
    , staging : String
    , image : String
    , serviceAccount : String
    , budget : Money
    , perHour : Money
    , priceBook : String
    , accelerator : String
    , acceleratorCount : Int
    , labels : List ( String, String )
    , sources : List RawSetting
    }

-- | What `plan` (and the workflow's `cloud-plan` step) found for a `Vertex`
-- job: the machine, its rate, the estimate against the budget, the hard
-- runtime ceiling the job is created with, the staging bucket's location,
-- and the accelerator quota when Cloud Quotas could be read.
type alias CloudPlan =
    { project : String
    , region : String
    , machine : String
    , accelerator : String
    , acceleratorCount : Int
    , image : String
    , staging : String
    , steps : Int
    , estimateMinutes : Int
    , timeoutSeconds : Int
    , perHour : Money
    , estimate : Money
    , budget : Money
    , priceBook : String
    , bucketLocation : String
    , quotaLimit : Maybe Int
    , quotaNote : String
    }

type alias RawCloudCode =
    { project : String
    , region : String
    , machine : String
    , staging : String
    , budget : String
    , image : String
    , serviceAccount : String
    , labels : String
    }


cloudResolveRaw : RawCloudCode -> Task Error (List RawSetting)
cloudResolveRaw =
    Ffi.kernel "Ai_trainCloudResolve"


-- Money as "<ISO code> <exact decimal>" ("USD 5.00"), the form a variable
-- holds and a failure records.
moneyText : Money -> String
moneyText m =
    Money.currencyCode (Money.currency m) ++ " "
        ++ Decimal.toString (Money.amount m)


parseMoney : String -> Maybe Money
parseMoney text =
    case String.split " " (String.trim text) of

        [ c, amount ] ->
            if Money.isKnownCode c then
                Result.toMaybe (Money.fromString (Money.parseCurrency c) amount)

            else
                Nothing

        _ ->
            Nothing


moneyCodec : Codec Money
moneyCodec =
    Codec.map
        (\t -> Maybe.withDefault (Money.zero Money.USD) (parseMoney t))
        moneyText
        Codec.string


-- | Resolve and check a `Vertex` job's settings without touching the cloud:
-- a project, a region and a staging location (`gs://…`) are set, the image is
-- pinned by digest, the budget is set and above zero, and the price book has
-- the machine in the region, in the budget's currency.
cloudSettings : Job -> Task Error CloudSettings
cloudSettings job =
    let
        s = settings job
        code =
            { project = s.cloud.project
            , region = s.cloud.region
            , machine = s.cloud.machine
            , staging = s.cloud.staging
            , budget = Maybe.withDefault "" (Maybe.map moneyText s.budget)
            , image = s.image
            , serviceAccount = s.serviceAccount
            , labels = ""
            }
    in
        cloudResolveRaw code
            |> Task.andThen (\found -> Task.fromResult (checkCloud s found))


settingValue : String -> List RawSetting -> RawSetting
settingValue key found =
    List.filter (\x -> x.key == key) found |> List.head
        |> Maybe.withDefault
               { key = key
               , name = "SKY_AI_TRAIN_" ++ key
               , value = ""
               , source = "default"
               }


notSet : RawSetting -> String -> Error
notSet r builder =
    Failure.toError
        (NotConfigured
            { setting = r.name ++ " (or Train." ++ builder ++ " in code)" })


checkCloud : Settings -> List RawSetting -> Result Error CloudSettings
checkCloud s found =
    let
        project = settingValue "PROJECT" found
        region = settingValue "REGION" found
        machineR = settingValue "MACHINE" found
        staging = settingValue "STAGING" found
        budgetR = settingValue "BUDGET" found
        image = settingValue "IMAGE" found
        account = settingValue "SERVICE_ACCOUNT" found
        labelsR = settingValue "LABELS" found
        envLabels =
            String.split "," labelsR.value |> List.map String.trim
                |> List.filter (\l -> not (String.isEmpty l))
                |> List.map
                       (\l ->
                           case String.split "=" l of

                               [ k, v ] ->
                                   ( String.trim k, String.trim v )

                               _ ->
                                   ( l, "" ))
        allLabels = s.labels ++ envLabels
        badLabel =
            List.filter
                (\( k, v ) ->
                    not (Google.validLabel k) || not (Google.validLabel v)
                        || String.startsWith "sky-" k)
                allLabels
        machine =
            if machineR.value == "" then
                "g2-standard-4"

            else
                machineR.value
        ( acc, count ) = Google.accelerator machine
        pinned =
            case String.split "@sha256:" image.value of

                [ _, hex ] ->
                    String.length hex == 64
                        && List.all
                               (\c ->
                                   (c >= '0' && c <= '9')
                                       || (c >= 'a' && c <= 'f'))
                               (String.toList hex)

                _ ->
                    False
    in
        if not (List.isEmpty badLabel) then
            Err
                (invalid
                    labelsR.name
                    (String.join
                        ", "
                        (List.map (\( k, v ) -> k ++ "=" ++ v) badLabel)
                        ++ ": a label is lower case letters, digits, - and _ (at most 63), and sky- keys are Sky's own"))

        else if project.value == "" then
            Err (notSet project "withCloud")

        else if region.value == "" then
            Err (notSet region "withCloud")

        else if staging.value == "" then
            Err (notSet staging "withCloud")

        else if not (String.startsWith "gs://" staging.value)
            || String.length staging.value <= 5 then
            Err
                (invalid
                    staging.name
                    (quoteText staging.value
                        ++ " is not a staging location; use gs://<bucket>/<prefix>"))

        else if image.value == "" then
            Err
                (Failure.toError
                    (NotConfigured
                        { setting =
                            image.name
                                ++ " (or Train.withImage in code); `sky ai image build --train` builds the trainer image in your project"
                        }))

        else if not pinned then
            Err
                (invalid
                    image.name
                    (quoteText image.value
                        ++ " is not pinned: use <image>@sha256:<64 hex digits>, the reference `sky ai image build --train` prints"))

        else if budgetR.value == "" then
            Err
                (invalid
                    budgetR.name
                    "a cloud job needs a budget: Train.withBudget (Money.fromMajor Money.USD 5) or SKY_AI_TRAIN_BUDGET=\"USD 5.00\"")

        else
            case parseMoney budgetR.value of

                Nothing ->
                    Err
                        (invalid
                            budgetR.name
                            (quoteText budgetR.value
                                ++ " is not an amount; write it as \"USD 5.00\""))

                Just budget ->
                    if not (Money.isPositive budget) then
                        Err (invalid budgetR.name "the budget must be above 0")

                    else
                        case s.prices of

                            Nothing ->
                                Err
                                    (invalid
                                        "prices"
                                        "a cloud job needs a price book: Train.withMachinePrices (Train.machinePrices …), with the rates you checked")

                            Just (MachinePriceBook book) ->
                                case book.problems of

                                    problem :: _ ->
                                        Err
                                            (invalid
                                                "prices"
                                                ("the price book "
                                                    ++ book.version
                                                    ++ ": "
                                                    ++ problem))

                                    [] ->
                                        case List.filter
                                                 (\r ->
                                                     r.machine == machine
                                                         && r.region
                                                                == region.value)
                                                 book.rates of

                                            rate :: _ ->
                                                if Money.currencyCode book.currency
                                                    /= Money.currencyCode
                                                           (Money.currency budget) then
                                                    Err
                                                        (invalid
                                                            "prices"
                                                            ("the price book "
                                                                ++ book.version
                                                                ++ " is in "
                                                                ++ Money.currencyCode
                                                                       book.currency
                                                                ++ " and the budget in "
                                                                ++ Money.currencyCode
                                                                       (Money.currency
                                                                           budget)))

                                                else
                                                    Ok
                                                        { project =
                                                            project.value
                                                        , region = region.value
                                                        , machine = machine
                                                        , staging =
                                                            staging.value
                                                        , image = image.value
                                                        , serviceAccount =
                                                            account.value
                                                        , budget = budget
                                                        , perHour = rate.perHour
                                                        , priceBook =
                                                            book.version
                                                        , accelerator = acc
                                                        , acceleratorCount =
                                                            count
                                                        , labels = allLabels
                                                        , sources = found
                                                        }

                                            [] ->
                                                Err
                                                    (invalid
                                                        "prices"
                                                        ("the price book "
                                                            ++ book.version
                                                            ++ " has no rate for "
                                                            ++ machine
                                                            ++ " in "
                                                            ++ region.value
                                                            ++ "; without a price there is no estimate"))


-- | The estimate for a `Vertex` job, pure: `( minutes, estimate,
-- timeoutSeconds )` for a base of `parameters` parameters. Documented and
-- deliberately high:
--
--   * 15 minutes to provision the machine and pull the image, 5 to export and
--     upload the adapter;
--   * seconds per step: on a CPU machine (the Fake driver) the job's
--     `fakeStepMs` plus 50 ms; on an L4, the larger of 0.25 s and
--     parameters / 10⁹ × tokens per step / 4000;
--   * the estimate is the minutes at the book's rate per hour, and the
--     runtime ceiling the smaller of what the budget buys and
--     `withMaxRuntimeMinutes`.
cloudEstimate : Job -> CloudSettings -> Int -> ( Int, Money, Int )
cloudEstimate job cs parameters =
    let
        s = settings job
        steps = totalSteps job
        tokens = s.batch.perDevice * s.batch.accumulate * s.sequenceLength
        perStepMs =
            if cs.acceleratorCount == 0 then
                s.fakeStepMs + 50

            else
                Math.max 250 (parameters // 1000000 * tokens // 4000)
        minutes = 15 + (steps * perStepMs + 59999) // 60000 + 5
        estimate = perMinutes cs.perHour minutes
        affordable =
            case Decimal.div (Money.amount cs.budget) (Money.amount cs.perHour) of

                Ok hours ->
                    Decimal.toInt
                        (Decimal.floor (Decimal.mul hours (Decimal.fromInt 3600)))

                Err _ ->
                    -- A free machine: only the ceiling bounds it.
                    86400
        ceiling =
            if s.maxRuntimeMinutes > 0 then
                Math.min affordable (s.maxRuntimeMinutes * 60)

            else
                affordable
    in
        ( minutes, estimate, Math.max 60 ceiling )


-- A rate per hour for some minutes.
perMinutes : Money -> Int -> Money
perMinutes rate minutes =
    Money.mul (Decimal.fromMinor 4 (minutes * 10000 // 60)) rate


-- A rate per hour for some milliseconds.
perMillis : Money -> Int -> Money
perMillis rate ms =
    case Decimal.div (Decimal.fromInt ms) (Decimal.fromInt 3600000) of

        Ok hours ->
            Money.mul hours rate

        Err _ ->
            Money.zeroOf rate


-- | Plan a `Vertex` job: its settings, the estimate against the budget
-- (`BudgetExceeded`), the staging bucket in the job's region (a bucket
-- elsewhere, or a multi-region one, is `InvalidSetting`: the data stays in
-- the region), and the L4 quota when Cloud Quotas can be read (a quota below
-- the machine's GPUs is `QuotaExceeded`).
planCloud : Job -> Task Error CloudPlan
planCloud job =
    Task.fromResult (check job) |> Task.andThen (\_ -> shapeOf (baseOf job))
        |> Task.andThen (planCloudWith job)


-- The Cloud Quotas id of Vertex AI's L4 custom-training quota (listed with
-- the Cloud Quotas API on 2026-10-12).
l4TrainingQuota : String
l4TrainingQuota =
    "CustomModelTrainingL4GPUsPerProjectPerRegion"


planCloudWith : Job -> ModelShape -> Task Error CloudPlan
planCloudWith job shape =
    cloudSettings job
        |> Task.andThen
               (\cs ->
                   let
                       ( minutes, estimate, timeout ) =
                           cloudEstimate job cs shape.parameters
                   in
                       if Money.gt estimate cs.budget then
                           Task.fail
                               (Failure.toError
                                   (BudgetExceeded
                                       { budget = cs.budget
                                       , estimate = estimate
                                       }))

                       else
                           Task.fromResult (Store.fromUrl cs.staging)
                               |> Task.andThen Store.bucketLocation
                               |> Task.andThen
                                      (\location ->
                                          if location /= cs.region then
                                              Task.fail
                                                  (invalid
                                                      "SKY_AI_TRAIN_STAGING"
                                                      (cs.staging ++ " is in "
                                                          ++ location
                                                          ++ ", not in the job's region "
                                                          ++ cs.region
                                                          ++ "; training data stays in the job's region, so use a bucket there"))

                                          else
                                              quotaFor cs
                                                  |> Task.andThen
                                                         (\q ->
                                                             case q.limit of

                                                                 Just n ->
                                                                     if n
                                                                         < cs.acceleratorCount then
                                                                         Task.fail
                                                                             (Failure.toError
                                                                                 (QuotaExceeded
                                                                                     { resource =
                                                                                         "aiplatform.googleapis.com/custom_model_training_nvidia_l4_gpus"
                                                                                     , region =
                                                                                         cs.region
                                                                                     , limit =
                                                                                         n
                                                                                     }))

                                                                     else
                                                                         Task.succeed
                                                                             q

                                                                 Nothing ->
                                                                     Task.succeed
                                                                         q)
                                                  |> Task.map
                                                         (\q ->
                                                             { project =
                                                                 cs.project
                                                             , region =
                                                                 cs.region
                                                             , machine =
                                                                 cs.machine
                                                             , accelerator =
                                                                 cs.accelerator
                                                             , acceleratorCount =
                                                                 cs.acceleratorCount
                                                             , image = cs.image
                                                             , staging =
                                                                 cs.staging
                                                             , steps =
                                                                 totalSteps job
                                                             , estimateMinutes =
                                                                 minutes
                                                             , timeoutSeconds =
                                                                 timeout
                                                             , perHour =
                                                                 cs.perHour
                                                             , estimate =
                                                                 estimate
                                                             , budget =
                                                                 cs.budget
                                                             , priceBook =
                                                                 cs.priceBook
                                                             , bucketLocation =
                                                                 location
                                                             , quotaLimit =
                                                                 q.limit
                                                             , quotaNote =
                                                                 q.note
                                                             })))


quotaFor : CloudSettings -> Task Error Google.QuotaReading
quotaFor cs =
    if cs.acceleratorCount == 0 then
        Task.succeed
            { quotaId = "", region = cs.region, limit = Nothing, note = "" }

    else
        Google.quota
            cs.project
            "aiplatform.googleapis.com"
            l4TrainingQuota
            cs.region


-- | The key of a run's objects in the staging bucket and of its Vertex
-- labels: `sky-` and the first 20 hex digits of the SHA-256 of the run's id.
-- The same job is the same key, so a resumed run finds its checkpoints.
runKey : String -> String
runKey id =
    "sky-" ++ String.left 20 (Crypto.sha256 id)


runPath : String -> String
runPath key =
    "runs/" ++ key


-- The staging location below which a run's objects live, as a URL.
stagingUrl : CloudSettings -> String -> String
stagingUrl cs path =
    trimSlash cs.staging ++ "/" ++ path


trimSlash : String -> String
trimSlash s =
    if String.endsWith "/" s then
        trimSlash (String.dropRight 1 s)

    else
        s


-- | The custom job for one attempt: the container runs the shim
-- (`sky_cloud.py`) with the run's inputs, its staging prefix, the attempt
-- and the step it resumes from. Labelled `sky-managed=true`,
-- `sky-run=<key>`, `sky-attempt=<a>` and `sky-kind=train`, so the attempt
-- is found again by its labels and `sky ai cloud ls` lists it.
cloudJobSpec : CloudSettings -> CloudPlan -> String -> Int -> Int -> Google.JobSpec
cloudJobSpec cs p key attempt resumeFrom =
    { displayName = key ++ "-a" ++ String.fromInt attempt
    , machine = cs.machine
    , image = cs.image
    , args =
        [ "--inputs"
        , stagingUrl cs (runPath key ++ "/inputs.json")
        , "--run"
        , stagingUrl cs (runPath key)
        , "--attempt"
        , String.fromInt attempt
        , "--resume-from"
        , String.fromInt resumeFrom
        ]
    , env = []
    , serviceAccount = cs.serviceAccount
    , timeoutSeconds = p.timeoutSeconds
    , spot = False
    , bootDiskGb = 100
    , labels =
        [ ( "sky-managed", "true" )
        , ( "sky-run", key )
        , ( "sky-attempt", String.fromInt attempt )
        , ( "sky-kind", "train" )
        ]
            ++ cs.labels
    }


-- The driver the container runs: Unsloth on a GPU, the Fake driver on a CPU
-- machine.
containerBackend : CloudSettings -> String
containerBackend cs =
    if cs.acceleratorCount > 0 then
        "unsloth"

    else
        "fake"


-- | The run's `inputs.json`: the staging location, the driver's settings for
-- an attempt (the shim fills in the attempt, the resume step and the local
-- paths), the digests of the train and eval rows, and the base's pinned
-- snapshot (the container fetches it and checks every file). The same job is
-- the same text, so it is written once.
inputsJson : Job -> CloudSettings -> ModelShape -> String -> Store.Blob -> Store.Blob -> Result Error String
inputsJson job cs shape key train valid =
    let
        backend = containerBackend cs
        st =
            { backend = backend
            , shape = shape
            , tool =
                { name = "vertex"
                , id = cs.image
                , python = ""
                , driverDir = ""
                , trainer = ""
                }
            , weights = ""
            , capBytes = 0
            }
        blobValue b =
            JsonE.object
                [ ( "sha256", JsonE.string b.sha256 )
                , ( "size", JsonE.int b.size )
                ]
        base =
            if backend == "unsloth" then
                case baseWeights Unsloth (baseOf job) of

                    Just snap ->
                        if String.startsWith "file:" snap.repo then
                            Err
                                (invalid
                                    "base"
                                    (baseId (baseOf job)
                                        ++ " is a local directory; a Vertex job trains in the cloud, so push the weights to the Hub and use an hf: base"))

                        else if List.isEmpty snap.files then
                            Err
                                (invalid
                                    "base"
                                    (baseId (baseOf job)
                                        ++ " does not list its weight files; pin them with Train.pinWeights before a Vertex job"))

                        else
                            Result.map Just (JsonE.raw (snapshotJson snap))

                    Nothing ->
                        Err
                            (invalid
                                "base"
                                (baseId (baseOf job)
                                    ++ " has no Unsloth weights for a GPU job; give the base Train.withWeights Vertex"))

            else
                Ok Nothing
    in
        Result.map2
            (\driver b ->
                JsonE.encode
                    0
                    (JsonE.object
                        [ ( "base", Maybe.withDefault JsonE.null b )
                        , ( "data"
                          , JsonE.object
                                [ ( "train", blobValue train )
                                , ( "valid", blobValue valid )
                                ]
                          )
                        , ( "driver", driver )
                        , ( "run", JsonE.string (runPath key) )
                        , ( "runKey", JsonE.string key )
                        , ( "store", JsonE.string cs.staging )
                        , ( "v", JsonE.int 1 )
                        ]))
            (JsonE.raw (driverJson job st 0 Nothing))
            base

-- ── The cloud workflow ──────────────────────────────────────────────
-- What the cloud part of a run hands to its cleanup.
type alias CloudRun =
    { settings : CloudSettings
    , key : String
    }

-- The journalled settings (money as text).
type alias RawCloud =
    { project : String
    , region : String
    , machine : String
    , staging : String
    , image : String
    , serviceAccount : String
    , budget : String
    , perHour : String
    , priceBook : String
    , accelerator : String
    , acceleratorCount : Int
    , labels : List ( String, String )
    }


rawCloudCodec : Codec RawCloud
rawCloudCodec =
    Codec.object
        (\p r m st i sa b ph pb a ac ls ->
            { project = p
            , region = r
            , machine = m
            , staging = st
            , image = i
            , serviceAccount = sa
            , budget = b
            , perHour = ph
            , priceBook = pb
            , accelerator = a
            , acceleratorCount = ac
            , labels = ls
            })
        |> Codec.field "project" .project Codec.string
        |> Codec.field "region" .region Codec.string
        |> Codec.field "machine" .machine Codec.string
        |> Codec.field "staging" .staging Codec.string
        |> Codec.field "image" .image Codec.string
        |> Codec.field "serviceAccount" .serviceAccount Codec.string
        |> Codec.field "budget" .budget Codec.string
        |> Codec.field "perHour" .perHour Codec.string
        |> Codec.field "priceBook" .priceBook Codec.string
        |> Codec.field "accelerator" .accelerator Codec.string
        |> Codec.field "acceleratorCount" .acceleratorCount Codec.int
        |> Codec.field
               "labels"
               .labels
               (Codec.list
                   (Codec.map
                       (\t ->
                           case String.split "=" t of

                               [ k, v ] ->
                                   ( k, v )

                               _ ->
                                   ( t, "" ))
                       (\( k, v ) -> k ++ "=" ++ v)
                       Codec.string))
        |> Codec.buildObject


toRawCloud : CloudSettings -> RawCloud
toRawCloud cs =
    { project = cs.project
    , region = cs.region
    , machine = cs.machine
    , staging = cs.staging
    , image = cs.image
    , serviceAccount = cs.serviceAccount
    , budget = moneyText cs.budget
    , perHour = moneyText cs.perHour
    , priceBook = cs.priceBook
    , accelerator = cs.accelerator
    , acceleratorCount = cs.acceleratorCount
    , labels = cs.labels
    }


fromRawCloud : RawCloud -> CloudSettings
fromRawCloud r =
    { project = r.project
    , region = r.region
    , machine = r.machine
    , staging = r.staging
    , image = r.image
    , serviceAccount = r.serviceAccount
    , budget = Maybe.withDefault (Money.zero Money.USD) (parseMoney r.budget)
    , perHour = Maybe.withDefault (Money.zero Money.USD) (parseMoney r.perHour)
    , priceBook = r.priceBook
    , accelerator = r.accelerator
    , acceleratorCount = r.acceleratorCount
    , labels = r.labels
    , sources = []
    }


planCodec : Codec CloudPlan
planCodec =
    Codec.object
        (\pr rg mc ac acn im st sp em ts ph es bu pb bl ql qn ->
            { project = pr
            , region = rg
            , machine = mc
            , accelerator = ac
            , acceleratorCount = acn
            , image = im
            , staging = st
            , steps = sp
            , estimateMinutes = em
            , timeoutSeconds = ts
            , perHour = ph
            , estimate = es
            , budget = bu
            , priceBook = pb
            , bucketLocation = bl
            , quotaLimit = ql
            , quotaNote = qn
            })
        |> Codec.field "project" .project Codec.string
        |> Codec.field "region" .region Codec.string
        |> Codec.field "machine" .machine Codec.string
        |> Codec.field "accelerator" .accelerator Codec.string
        |> Codec.field "acceleratorCount" .acceleratorCount Codec.int
        |> Codec.field "image" .image Codec.string
        |> Codec.field "staging" .staging Codec.string
        |> Codec.field "steps" .steps Codec.int
        |> Codec.field "estimateMinutes" .estimateMinutes Codec.int
        |> Codec.field "timeoutSeconds" .timeoutSeconds Codec.int
        |> Codec.field "perHour" .perHour moneyCodec
        |> Codec.field "estimate" .estimate moneyCodec
        |> Codec.field "budget" .budget moneyCodec
        |> Codec.field "priceBook" .priceBook Codec.string
        |> Codec.field "bucketLocation" .bucketLocation Codec.string
        |> Codec.field "quotaLimit" .quotaLimit (Codec.maybe Codec.int)
        |> Codec.field "quotaNote" .quotaNote Codec.string
        |> Codec.buildObject

-- One watch of a cloud attempt, as journalled.
type alias CloudWatch =
    { segment : String
    , state : String
    , outcome : String
    , step : Int
    , code : String
    , message : String
    , trainLoss : Float
    , valLoss : Float
    , peft : String
    , resumedFrom : Int
    , spentMinor : Int
    , errorCode : Int
    , errorMessage : String
    , relaunches : Int
    , ranSeconds : Int
    }


cloudWatchCodec : Codec CloudWatch
cloudWatchCodec =
    Codec.object
        (\sg st oc sp cd ms tl vl pf rf sm ec em rl rs ->
            { segment = sg
            , state = st
            , outcome = oc
            , step = sp
            , code = cd
            , message = ms
            , trainLoss = tl
            , valLoss = vl
            , peft = pf
            , resumedFrom = rf
            , spentMinor = sm
            , errorCode = ec
            , errorMessage = em
            , relaunches = rl
            , ranSeconds = rs
            })
        |> Codec.field "segment" .segment Codec.string
        |> Codec.field "state" .state Codec.string
        |> Codec.field "outcome" .outcome Codec.string
        |> Codec.field "step" .step Codec.int
        |> Codec.field "code" .code Codec.string
        |> Codec.field "message" .message Codec.string
        |> Codec.field "trainLoss" .trainLoss Codec.float
        |> Codec.field "valLoss" .valLoss Codec.float
        |> Codec.field "peft" .peft Codec.string
        |> Codec.field "resumedFrom" .resumedFrom Codec.int
        |> Codec.field "spentMinor" .spentMinor Codec.int
        |> Codec.field "errorCode" .errorCode Codec.int
        |> Codec.field "errorMessage" .errorMessage Codec.string
        |> Codec.field "relaunches" .relaunches Codec.int
        |> Codec.field "ranSeconds" .ranSeconds Codec.int
        |> Codec.buildObject

-- Where a cloud run stands when the workflow takes it up: the last attempt
-- this machine recorded (cloud.json), its job, and whether it finished.
type alias CloudOrigin =
    { attempt : Int
    , job : String
    , live : Bool
    , finished : Bool
    , spentMinor : Int
    }


cloudOriginCodec : Codec CloudOrigin
cloudOriginCodec =
    Codec.object
        (\a j l f sm ->
            { attempt = a, job = j, live = l, finished = f, spentMinor = sm })
        |> Codec.field "attempt" .attempt Codec.int
        |> Codec.field "job" .job Codec.string
        |> Codec.field "live" .live Codec.bool
        |> Codec.field "finished" .finished Codec.bool
        |> Codec.field "spentMinor" .spentMinor Codec.int
        |> Codec.buildObject

-- The cloud.json a watch writes in the run directory.
type alias CloudFile =
    { job : String
    , state : String
    , attempt : Int
    , staging : String
    , runKey : String
    , spentMinor : Int
    , runningSinceMs : Int
    }


readCloudFile : String -> Task Error (Maybe CloudFile)
readCloudFile dir =
    let
        path = dir ++ "/cloud.json"
    in
        File.exists path
            |> Task.andThen
                   (\there ->
                       if not there then
                           Task.succeed Nothing

                       else
                           File.readFile path
                               |> Task.map
                                      (\text ->
                                          JsonD.decodeString
                                              (JsonD.map5
                                                  (\( j, s, a ) st k sm rs ->
                                                      { job = j
                                                      , state = s
                                                      , attempt = a
                                                      , staging = st
                                                      , runKey = k
                                                      , spentMinor = sm
                                                      , runningSinceMs = rs
                                                      })
                                                  (JsonD.map3
                                                      (\j s a -> ( j, s, a ))
                                                      (JsonD.field
                                                          "job"
                                                          JsonD.string)
                                                      (JsonD.field
                                                          "state"
                                                          JsonD.string)
                                                      (JsonD.field
                                                          "attempt"
                                                          JsonD.int))
                                                  (JsonD.field
                                                      "staging"
                                                      JsonD.string)
                                                  (JsonD.field
                                                      "runKey"
                                                      JsonD.string)
                                                  (JsonD.oneOf
                                                      [ JsonD.field
                                                            "spentMinor"
                                                            JsonD.int
                                                      , JsonD.succeed 0
                                                      ])
                                                  (JsonD.oneOf
                                                      [ JsonD.field
                                                            "runningSinceMs"
                                                            JsonD.int
                                                      , JsonD.succeed 0
                                                      ]))
                                              text
                                              |> Result.toMaybe))


-- `runningSinceMs`: when a watch first saw the job RUNNING (0 before), the
-- start of the time Vertex bills; spend counts from there, not from the
-- job's start time, which Vertex sets when the job begins PENDING.
writeCloudFile : String -> CloudSettings -> String -> String -> String -> Int -> Int -> Int -> Task Error ()
writeCloudFile dir cs key jobName state attempt spentMinor runningSinceMs =
    Time.unixMillis ()
        |> Task.andThen
               (\now ->
                   File.writeFile
                       (dir ++ "/cloud.json.partial")
                       (JsonE.encode
                           0
                           (JsonE.object
                               [ ( "attempt", JsonE.int attempt )
                               , ( "backend", JsonE.string "vertex" )
                               , ( "budget"
                                 , JsonE.string (moneyText cs.budget)
                                 )
                               , ( "job", JsonE.string jobName )
                               , ( "machine", JsonE.string cs.machine )
                               , ( "project", JsonE.string cs.project )
                               , ( "region", JsonE.string cs.region )
                               , ( "runKey", JsonE.string key )
                               , ( "runningSinceMs", JsonE.int runningSinceMs )
                               , ( "spent"
                                 , JsonE.string
                                       (moneyText
                                           (Money.fromMinor
                                               (Money.currency cs.budget)
                                               spentMinor))
                                 )
                               , ( "spentMinor", JsonE.int spentMinor )
                               , ( "staging", JsonE.string cs.staging )
                               , ( "state", JsonE.string state )
                               , ( "updatedMs", JsonE.int now )
                               ])))
        |> Task.andThen
               (\_ ->
                   File.rename
                       (dir ++ "/cloud.json.partial")
                       (dir ++ "/cloud.json"))


-- Cancel a cloud run from its cloud.json: the cancel marker (the container's
-- shim checkpoints and stops at the next step) and Vertex's own cancel.
cancelCloud : CloudFile -> Task Error Bool
cancelCloud c =
    Task.fromResult (Store.fromUrl c.staging)
        |> Task.andThen
               (\store -> Store.putAt store (runPath c.runKey ++ "/cancel") "{}")
        |> Task.andThen (\_ -> Google.cancelCustomJob c.job)
        |> Task.map
               (\_ ->
                   c.state == "JOB_STATE_RUNNING"
                       || c.state == "JOB_STATE_PENDING"
                       || c.state == "JOB_STATE_QUEUED")


cloudTrain : Durable.Ctx -> Job -> Task Error ( Setup, Seen, CloudRun )
cloudTrain ctx job =
    let
        s = settings job
        dir = runDir job
        key = runKey (runId job)
    in
        Durable.step
            ctx
            rawCloudCodec
            "cloud"
            (cloudSettings job |> Task.map toRawCloud)
            |> Task.map fromRawCloud
            |> Task.andThen
                   (\cs ->
                       Durable.step
                           ctx
                           Codec.int
                           "stage"
                           (stageRaw dir s.dataFile s.datasetDigest (jobJson job)
                               |> Task.map (\st -> st.train))
                           |> Task.andThen
                                  (\_ ->
                                      Durable.step
                                          ctx
                                          shapeCodec
                                          "shape"
                                          (shapeOf (baseOf job)))
                           |> Task.andThen
                                  (\shape ->
                                      Durable.step
                                          ctx
                                          planCodec
                                          "cloud-plan"
                                          (planCloudWith job shape)
                                          |> Task.andThen
                                                 (\p ->
                                                     cloudLaunchAndWatch
                                                         ctx
                                                         job
                                                         cs
                                                         p
                                                         shape
                                                         key)))


cloudLaunchAndWatch : Durable.Ctx -> Job -> CloudSettings -> CloudPlan -> ModelShape -> String -> Task Error ( Setup, Seen, CloudRun )
cloudLaunchAndWatch ctx job cs p shape key =
    let
        dir = runDir job
        st =
            { backend = "vertex"
            , shape = shape
            , tool =
                { name = "vertex"
                , id = cs.image
                , python = ""
                , driverDir = ""
                , trainer = ""
                }
            , weights = ""
            , capBytes = 0
            }
    in
        Task.fromResult (Store.fromUrl cs.staging)
            |> Task.andThen
                   (\store ->
                       Durable.step
                           ctx
                           Codec.string
                           "upload"
                           (uploadInputs job cs shape store key)
                           |> Task.andThen
                                  (\_ ->
                                      Durable.step
                                          ctx
                                          cloudOriginCodec
                                          "origin"
                                          (cloudOrigin dir)
                                          |> Task.andThen
                                                 (\o ->
                                                     if o.finished then
                                                         Task.succeed
                                                             { segment = ""
                                                             , state =
                                                                 "JOB_STATE_SUCCEEDED"
                                                             , outcome = "done"
                                                             , step = 0
                                                             , code = ""
                                                             , message = ""
                                                             , trainLoss = 0.0
                                                             , valLoss = 0.0
                                                             , peft = ""
                                                             , resumedFrom = 0
                                                             , spentMinor =
                                                                 o.spentMinor
                                                             , errorCode = 0
                                                             , errorMessage = ""
                                                             , relaunches = 0
                                                             , ranSeconds = 0
                                                             }

                                                     else if o.live then
                                                         cloudWatchLoop
                                                             ctx
                                                             job
                                                             cs
                                                             p
                                                             store
                                                             key
                                                             o.attempt
                                                             o.job
                                                             0
                                                             ""
                                                             0
                                                             o.spentMinor

                                                     else
                                                         cloudRelaunch
                                                             ctx
                                                             job
                                                             cs
                                                             p
                                                             store
                                                             key
                                                             (o.attempt + 1)
                                                             0
                                                             o.spentMinor)
                                          |> Task.andThen
                                                 (\w ->
                                                     Durable.step
                                                         ctx
                                                         Codec.string
                                                         "download"
                                                         (downloadAdapter
                                                             dir
                                                             store
                                                             key)
                                                         |> Task.map
                                                                (\_ ->
                                                                    ( st
                                                                    , { offset =
                                                                          0
                                                                      , outcome =
                                                                          "done"
                                                                      , step =
                                                                          w.step
                                                                      , code =
                                                                          ""
                                                                      , message =
                                                                          ""
                                                                      , trainLoss =
                                                                          w.trainLoss
                                                                      , valLoss =
                                                                          w.valLoss
                                                                      , peft =
                                                                          w.peft
                                                                      , relaunches =
                                                                          w.relaunches
                                                                      , resumedFrom =
                                                                          w.resumedFrom
                                                                      , peakBytes =
                                                                          0
                                                                      , capBytes =
                                                                          0
                                                                      }
                                                                    , { settings =
                                                                          cs
                                                                      , key =
                                                                          key
                                                                      }
                                                                    )))))


uploadInputs : Job -> CloudSettings -> ModelShape -> Store -> String -> Task Error String
uploadInputs job cs shape store key =
    let
        dir = runDir job
    in
        Store.put store (dir ++ "/data/train.jsonl")
            |> Task.andThen
                   (\train ->
                       Store.put store (dir ++ "/data/valid.jsonl")
                           |> Task.andThen
                                  (\valid ->
                                      Task.fromResult
                                          (inputsJson
                                              job
                                              cs
                                              shape
                                              key
                                              train
                                              valid)))
            |> Task.andThen
                   (\text ->
                       Store.putIf store (runPath key ++ "/inputs.json") "" text
                           |> Task.andThen
                                  (\created ->
                                      if created then
                                          Task.succeed (Crypto.sha256 text)

                                      else
                                          Store.getAt
                                              store
                                              (runPath key ++ "/inputs.json")
                                              |> Task.andThen
                                                     (\existing ->
                                                         if existing == Just text then
                                                             Task.succeed
                                                                 (Crypto.sha256
                                                                     text)

                                                         else
                                                             Task.fail
                                                                 (invalid
                                                                     "job"
                                                                     (stagingUrl
                                                                         cs
                                                                         (runPath
                                                                             key
                                                                             ++ "/inputs.json")
                                                                         ++ " holds other inputs for this run; delete the run's staging prefix or change the job")))))


-- The run's last recorded attempt, from cloud.json and the mirrored lines.
cloudOrigin : String -> Task Error CloudOrigin
cloudOrigin dir =
    readCloudFile dir
        |> Task.andThen
               (\found ->
                   readRaw dir
                       |> Task.map
                              (\state ->
                                  let
                                      folded =
                                          foldLines
                                              state.lines
                                              (emptyProgress "")
                                  in
                                      case found of

                                          Just c ->
                                              { attempt = c.attempt
                                              , job = c.job
                                              , live =
                                                  List.member
                                                      c.state
                                                      [ "JOB_STATE_QUEUED"
                                                      , "JOB_STATE_PENDING"
                                                      , "JOB_STATE_RUNNING"
                                                      , "JOB_STATE_CANCELLING"
                                                      ]
                                              , finished =
                                                  folded.status == Converting
                                              , spentMinor = c.spentMinor
                                              }

                                          Nothing ->
                                              { attempt = -1
                                              , job = ""
                                              , live = False
                                              , finished = False
                                              , spentMinor = 0
                                              }))


-- Launch attempt `attempt` (from the newest verified checkpoint for a
-- relaunch) and watch it.
cloudRelaunch : Durable.Ctx -> Job -> CloudSettings -> CloudPlan -> Store -> String -> Int -> Int -> Int -> Task Error CloudWatch
cloudRelaunch ctx job cs p store key attempt relaunched spentMinor =
    let
        tag = String.fromInt attempt
    in
        Durable.step
            ctx
            Codec.int
            ("resume-" ++ tag)
            (if attempt == 0 then
                Task.succeed 0

            else
                newestCheckpoint store key)
            |> Task.andThen
                   (\from ->
                       Durable.step
                           ctx
                           Codec.string
                           ("launch-" ++ tag)
                           (budgetLeft job cs attempt spentMinor
                               |> Task.andThen
                                      (\_ ->
                                          -- The first cloud.json is written inside the launch
                                          -- step, once: written after it, every replay of the
                                          -- workflow wrote QUEUED over what the watches had
                                          -- recorded (the watch then never saw its own PENDING).
                                          launchOnce
                                              job
                                              cs
                                              p
                                              store
                                              key
                                              attempt
                                              from
                                              spentMinor)
                               |> Task.andThen
                                      (\launched ->
                                          writeCloudFile
                                              (runDir job)
                                              cs
                                              key
                                              launched
                                              "JOB_STATE_QUEUED"
                                              attempt
                                              spentMinor
                                              0
                                              |> Task.map (\_ -> launched)))
                           |> Task.andThen
                                  (\name ->
                                      cloudWatchLoop
                                          ctx
                                          job
                                          cs
                                          p
                                          store
                                          key
                                          attempt
                                          name
                                          0
                                          ""
                                          relaunched
                                          spentMinor))


-- The seconds of machine time the rest of the budget buys.
affordableSeconds : CloudSettings -> Int -> Int
affordableSeconds cs spentMinor =
    let
        left =
            Money.sub
                cs.budget
                (Money.fromMinor (Money.currency cs.budget) spentMinor)
    in
        case Decimal.div (Money.amount left) (Money.amount cs.perHour) of

            Ok hours ->
                Decimal.toInt
                    (Decimal.floor (Decimal.mul hours (Decimal.fromInt 3600)))

            Err _ ->
                86400


-- A relaunch needs at least its provisioning allowance (15 minutes) of
-- budget left; else the run ends BudgetExceeded instead of paying for an
-- attempt that cannot finish.
budgetLeft : Job -> CloudSettings -> Int -> Int -> Task Error ()
budgetLeft job cs attempt spentMinor =
    let
        spent = Money.fromMinor (Money.currency cs.budget) spentMinor
        next = Money.add spent (perMinutes cs.perHour 15)
    in
        if attempt > 0 && Money.gt next cs.budget then
            Task.fail
                (Failure.toError
                    (BudgetExceeded { budget = cs.budget, estimate = next }))

        else
            Task.succeed ()


-- The newest checkpoint whose manifest is in the bucket (the manifest is
-- written last, so its presence means every file of the checkpoint is
-- there; the container checks each file's digest when it resumes).
newestCheckpoint : Store -> String -> Task Error Int
newestCheckpoint store key =
    Store.list store (runPath key ++ "/checkpoints/") ""
        |> Task.map
               (\keys ->
                   keys
                       |> List.filter (\k -> String.endsWith "/manifest.json" k)
                       |> List.filterMap
                              (\k ->
                                  String.split "/" k |> List.reverse
                                      |> List.drop 1
                                      |> List.head
                                      |> Maybe.andThen String.toInt)
                       |> List.foldl Math.max 0)


-- Create the attempt's custom job exactly once. The intent object is
-- written first, with a create-only precondition: whoever writes it creates
-- the job; anyone who finds it there (another worker, or this workflow
-- resumed after a crash between the create and its journal row) attaches to
-- the job its labels name instead. A create is never made twice.
launchOnce : Job -> CloudSettings -> CloudPlan -> Store -> String -> Int -> Int -> Int -> Task Error String
launchOnce job cs p store key attempt from spentMinor =
    let
        intentKey =
            runPath key ++ "/launch-" ++ String.fromInt attempt ++ ".intent"
        spec = cloudJobSpec cs p key attempt from
        -- A relaunch gets only what is left of the budget as its ceiling.
        jobSpec =
            { spec
                | spot = (settings job).spot
                , timeoutSeconds =
                    Math.max
                        60
                        (Math.min
                            spec.timeoutSeconds
                            (affordableSeconds cs spentMinor))
            }
    in
        Time.unixMillis ()
            |> Task.andThen
                   (\now ->
                       Store.putIf
                           store
                           intentKey
                           ""
                           (JsonE.encode
                               0
                               (JsonE.object
                                   [ ( "attempt", JsonE.int attempt )
                                   , ( "at", JsonE.int now )
                                   , ( "resumeFrom", JsonE.int from )
                                   ]))
                           |> Task.andThen
                                  (\mine ->
                                      if mine then
                                          Google.createCustomJob
                                              cs.project
                                              cs.region
                                              (Google.customJobJson jobSpec)
                                              |> Task.map .name

                                      else
                                          attach
                                              job
                                              cs
                                              store
                                              key
                                              attempt
                                              intentKey
                                              0))


-- Find the attempt's job by its labels (the list can lag the create), else
-- by the hello.json its container writes first. Up to ten minutes after the
-- intent; after that the intent has no job and the run fails instead of
-- paying for a second one.
attach : Job -> CloudSettings -> Store -> String -> Int -> String -> Int -> Task Error String
attach job cs store key attempt intentKey tries =
    Google.listCustomJobs
        cs.project
        cs.region
        ("labels.sky-run=\"" ++ key ++ "\" AND labels.sky-attempt=\""
            ++ String.fromInt attempt
            ++ "\"")
        |> Task.andThen
               (\jobs ->
                   case jobs of

                       found :: _ ->
                           Task.succeed found.name

                       [] ->
                           Store.getAt
                               store
                               (runPath key ++ "/attempt-"
                                   ++ String.fromInt attempt
                                   ++ "/hello.json")
                               |> Task.andThen
                                      (\hello ->
                                          case Maybe.andThen (helloJob cs) hello of

                                              Just name ->
                                                  Task.succeed name

                                              Nothing ->
                                                  Store.getAt store intentKey
                                                      |> Task.andThen
                                                             (\intent ->
                                                                 Time.unixMillis
                                                                     ()
                                                                     |> Task.andThen
                                                                            (\now ->
                                                                                let
                                                                                    at =
                                                                                        Maybe.withDefault
                                                                                            now
                                                                                            (Maybe.andThen
                                                                                                (\t ->
                                                                                                    Result.toMaybe
                                                                                                        (JsonD.decodeString
                                                                                                            (JsonD.field
                                                                                                                "at"
                                                                                                                JsonD.int)
                                                                                                            t))
                                                                                                intent)
                                                                                in
                                                                                    if now
                                                                                        - at
                                                                                        > 600000 then
                                                                                        Task.fail
                                                                                            (Failure.toError
                                                                                                (TrainingFailed
                                                                                                    { runId =
                                                                                                        runId
                                                                                                            job
                                                                                                    , step =
                                                                                                        0
                                                                                                    , reason =
                                                                                                        "launch intent without a job: attempt "
                                                                                                            ++ String.fromInt
                                                                                                                   attempt
                                                                                                            ++ " was claimed more than ten minutes ago and no job carries its labels; no second job was created"
                                                                                                    , logTail =
                                                                                                        ""
                                                                                                    }))

                                                                                    else
                                                                                        Time.sleep
                                                                                            (Math.min
                                                                                                5000
                                                                                                (500
                                                                                                    + tries
                                                                                                          * 500))
                                                                                            |> Task.andThen
                                                                                                   (\_ ->
                                                                                                       attach
                                                                                                           job
                                                                                                           cs
                                                                                                           store
                                                                                                           key
                                                                                                           attempt
                                                                                                           intentKey
                                                                                                           (tries
                                                                                                               + 1))))))


-- The job a container's hello.json names: its full resource name, or the
-- numeric id Vertex gives the container.
helloJob : CloudSettings -> String -> Maybe String
helloJob cs text =
    case JsonD.decodeString (JsonD.field "job" JsonD.string) text of

        Ok name ->
            if String.isEmpty name then
                Nothing

            else
                Just name

        Err _ ->
            case JsonD.decodeString (JsonD.field "jobId" JsonD.string) text of

                Ok id ->
                    if String.isEmpty id then
                        Nothing

                    else
                        Just
                            ("projects/" ++ cs.project ++ "/locations/"
                                ++ cs.region
                                ++ "/customJobs/"
                                ++ id)

                Err _ ->
                    Nothing


cloudWatchLoop : Durable.Ctx -> Job -> CloudSettings -> CloudPlan -> Store -> String -> Int -> String -> Int -> String -> Int -> Int -> Task Error CloudWatch
cloudWatchLoop ctx job cs p store key attempt name n segment relaunched spentBefore =
    let
        s = settings job
        tag = String.fromInt attempt ++ "-" ++ String.fromInt n
        tick = Math.max 100 (Math.min 30000 s.watchWindowMs)
    in
        Durable.step
            ctx
            cloudWatchCodec
            ("watch-" ++ tag)
            (watchCloud job cs store key attempt name segment spentBefore
                |> Task.andThen
                       (\w -> traceRunLines ctx job |> Task.map (\_ -> w)))
            |> Task.andThen
                   (\w ->
                       let
                           spent =
                               Money.fromMinor
                                   (Money.currency cs.budget)
                                   w.spentMinor
                           job0 =
                               { name = name
                               , displayName = ""
                               , state = w.state
                               , createMs = 0
                               , startMs = 0
                               , endMs = 0
                               , labels = []
                               , errorCode = w.errorCode
                               , errorMessage = w.errorMessage
                               }
                           -- The ceiling this attempt was launched with
                           -- (launchOnce: the budget left, at most the plan's).
                           attemptTimeout =
                               Math.max
                                   60
                                   (Math.min
                                       p.timeoutSeconds
                                       (affordableSeconds cs spentBefore))
                           -- An attempt that ended unfinished: a typed cloud
                           -- failure, the budget spent, too many relaunches,
                           -- or a relaunch.
                           ended _ =
                               case Google.jobFailure cs.region job0 of

                                   Just e ->
                                       Task.fail e

                                   Nothing ->
                                       if Money.gte
                                           (Money.add
                                               spent
                                               (perMinutes cs.perHour 1))
                                           cs.budget then
                                           Task.fail
                                               (Failure.toError
                                                   (BudgetExceeded
                                                       { budget = cs.budget
                                                       , estimate = spent
                                                       }))

                                       else if relaunched >= s.maxRelaunches then
                                           Google.logTail
                                               cs.project
                                               (lastSegment name)
                                               50
                                               |> Task.andThen
                                                      (\tail ->
                                                          -- It ran into the ceiling its budget set: Vertex
                                                          -- stopped it, and nothing is left to relaunch with.
                                                          Task.fail
                                                              (Failure.toError
                                                                  (TrainingFailed
                                                                      { runId =
                                                                          runId
                                                                              job
                                                                      , step =
                                                                          w.step
                                                                      , reason =
                                                                          "the Vertex job ended without finishing "
                                                                              ++ String.fromInt
                                                                                     (relaunched
                                                                                         + 1)
                                                                              ++ " times (withMaxRelaunches "
                                                                              ++ String.fromInt
                                                                                     s.maxRelaunches
                                                                              ++ "): "
                                                                              ++ w.errorMessage
                                                                      , logTail =
                                                                          tail
                                                                      })))

                                       else
                                           cloudRelaunch
                                               ctx
                                               job
                                               cs
                                               p
                                               store
                                               key
                                               (attempt + 1)
                                               (relaunched + 1)
                                               w.spentMinor
                       in
                           case w.outcome of

                               "done" ->
                                   Task.succeed { w | relaunches = relaunched }

                               "error" ->
                                   Task.fail
                                       (driverFailure
                                           job
                                           { offset = 0
                                           , outcome = "error"
                                           , step = w.step
                                           , code = w.code
                                           , message = w.message
                                           , trainLoss = w.trainLoss
                                           , valLoss = w.valLoss
                                           , peft = ""
                                           , relaunches = relaunched
                                           , resumedFrom = w.resumedFrom
                                           , peakBytes = 0
                                           , capBytes = 0
                                           })

                               "cancelled" ->
                                   -- Vertex also cancels a job that reached
                                   -- its scheduling timeout (the runtime
                                   -- ceiling). Only a cancel Sky asked for
                                   -- (`cancel`, or the budget stop) writes
                                   -- the run's cancel object. A cancel
                                   -- nobody asked for, before the ceiling,
                                   -- is an attempt that ended unfinished.
                                   Store.getAt store (runPath key ++ "/cancel")
                                       |> Task.andThen
                                              (\asked ->
                                                  case asked of

                                                      Just _ ->
                                                          Task.fail
                                                              (cancelled
                                                                  job
                                                                  w.step)

                                                      Nothing ->
                                                          if w.ranSeconds + 60
                                                              >= attemptTimeout then
                                                              Task.fail
                                                                  (ceilingReached
                                                                      job
                                                                      cs
                                                                      p
                                                                      spent
                                                                      w.step)

                                                          else
                                                              ended ())

                               "dead" ->
                                   ended ()

                               _ ->
                                   if Money.gte spent cs.budget then
                                       Durable.step
                                           ctx
                                           Codec.int
                                           ("budget-stop-" ++ tag)
                                           (Store.putAt
                                               store
                                               (runPath key ++ "/cancel")
                                               "{\"reason\":\"budget\"}"
                                               |> Task.andThen
                                                      (\_ ->
                                                          Google.cancelCustomJob
                                                              name)
                                               |> Task.map (\_ -> w.spentMinor))
                                           |> Task.andThen
                                                  (\_ ->
                                                      Task.fail
                                                          (Failure.toError
                                                              (BudgetExceeded
                                                                  { budget =
                                                                      cs.budget
                                                                  , estimate =
                                                                      spent
                                                                  })))

                                   else
                                       Durable.sleep ctx ("tick-" ++ tag) tick
                                           |> Task.andThen
                                                  (\_ ->
                                                      cloudWatchLoop
                                                          ctx
                                                          job
                                                          cs
                                                          p
                                                          store
                                                          key
                                                          attempt
                                                          name
                                                          (n + 1)
                                                          w.segment
                                                          relaunched
                                                          spentBefore))


-- One watch: the job's state, the protocol segments written since the last
-- watch (mirrored into the run directory), what they say, and the spend so
-- far (earlier attempts plus this one's running time, from its start, or
-- from its creation while it waits).
watchCloud : Job -> CloudSettings -> Store -> String -> Int -> String -> String -> Int -> Task Error CloudWatch
watchCloud job cs store key attempt name after spentBefore =
    let
        dir = runDir job
        prefix =
            runPath key ++ "/attempt-" ++ String.fromInt attempt ++ "/events/"
    in
        Google.getCustomJob name
            |> Task.andThen
                   (\cj ->
                       Store.list store prefix after
                           |> Task.andThen
                                  (\keys ->
                                      Task.sequence
                                          (List.map
                                              (\k ->
                                                  Store.getAt store k
                                                      |> Task.andThen
                                                             (\body ->
                                                                 let
                                                                     text =
                                                                         Maybe.withDefault
                                                                             ""
                                                                             body
                                                                 in
                                                                     mirrorSegment
                                                                         dir
                                                                         attempt
                                                                         k
                                                                         text
                                                                         |> Task.map
                                                                                (\_ ->
                                                                                    text)))
                                              keys)
                                          |> Task.andThen
                                                 (\texts ->
                                                     rebuildEvents dir
                                                         |> Task.map
                                                                (\_ -> texts))
                                          |> Task.andThen
                                                 (\texts ->
                                                     Time.unixMillis ()
                                                         |> Task.andThen
                                                                (\now ->
                                                                    readCloudFile
                                                                        dir
                                                                        |> Task.andThen
                                                                               (\prevFile ->
                                                                                   let
                                                                                       -- Vertex bills a job's
                                                                                       -- running time. Its start
                                                                                       -- time is set when it
                                                                                       -- begins PENDING, and a
                                                                                       -- stockout keeps it PENDING
                                                                                       -- for as long as it lasts
                                                                                       -- (an hour, live). Spend
                                                                                       -- counts from the first
                                                                                       -- watch that saw it RUNNING.
                                                                                       pending =
                                                                                           cj.state
                                                                                               == "JOB_STATE_QUEUED"
                                                                                               || cj.state
                                                                                                      == "JOB_STATE_PENDING"
                                                                                       -- What the previous watch of this
                                                                                       -- job recorded (another job's
                                                                                       -- file counts as nothing).
                                                                                       seenSince =
                                                                                           case prevFile of

                                                                                               Just pf ->
                                                                                                   if pf.job
                                                                                                       == name then
                                                                                                       pf.runningSinceMs

                                                                                                   else
                                                                                                       0

                                                                                               Nothing ->
                                                                                                   0
                                                                                       sawPending =
                                                                                           case prevFile of

                                                                                               Just pf ->
                                                                                                   pf.job
                                                                                                       == name
                                                                                                       && pf.state
                                                                                                              == "JOB_STATE_PENDING"

                                                                                               Nothing ->
                                                                                                   False
                                                                                       -- Recorded (and kept) only when
                                                                                       -- a watch saw the job wait
                                                                                       -- PENDING and then run.
                                                                                       runningSince =
                                                                                           if pending then
                                                                                               0

                                                                                           else if seenSince
                                                                                               > 0 then
                                                                                               seenSince

                                                                                           else if sawPending then
                                                                                               now

                                                                                           else
                                                                                               0
                                                                                       -- Never seen PENDING: it began
                                                                                       -- running at its start.
                                                                                       from =
                                                                                           if pending then
                                                                                               0

                                                                                           else if runningSince
                                                                                               > 0 then
                                                                                               runningSince

                                                                                           else if cj.startMs
                                                                                               > 0 then
                                                                                               cj.startMs

                                                                                           else
                                                                                               cj.createMs
                                                                                       until =
                                                                                           if cj.endMs
                                                                                               > 0 then
                                                                                               cj.endMs

                                                                                           else
                                                                                               now
                                                                                       ran =
                                                                                           if from
                                                                                               > 0 then
                                                                                               Math.max
                                                                                                   0
                                                                                                   (until
                                                                                                       - from)

                                                                                           else
                                                                                               0
                                                                                       spentMinor =
                                                                                           spentBefore
                                                                                               + Money.toMinor
                                                                                                     (perMillis
                                                                                                         cs.perHour
                                                                                                         ran)
                                                                                       lines =
                                                                                           List.concatMap
                                                                                               (\t ->
                                                                                                   List.filter
                                                                                                       (\l ->
                                                                                                           not
                                                                                                               (String.isEmpty
                                                                                                                   (String.trim
                                                                                                                       l)))
                                                                                                       (String.lines
                                                                                                           t))
                                                                                               texts
                                                                                       live =
                                                                                           List.member
                                                                                               cj.state
                                                                                               [ "JOB_STATE_QUEUED"
                                                                                               , "JOB_STATE_PENDING"
                                                                                               , "JOB_STATE_RUNNING"
                                                                                               , "JOB_STATE_CANCELLING"
                                                                                               , "JOB_STATE_UPDATING"
                                                                                               ]
                                                                                       seen =
                                                                                           seenOf
                                                                                               0
                                                                                               { offset =
                                                                                                   0
                                                                                               , lines =
                                                                                                   lines
                                                                                               , alive =
                                                                                                   live
                                                                                               , cancelRequested =
                                                                                                   cj.state
                                                                                                       == "JOB_STATE_CANCELLED"
                                                                                               , stderrTail =
                                                                                                   cj.errorMessage
                                                                                               }
                                                                                       outcome =
                                                                                           if seen.outcome
                                                                                               == "cancelling" then
                                                                                               "cancelled"

                                                                                           else
                                                                                               seen.outcome
                                                                                   in
                                                                                       writeCloudFile
                                                                                           dir
                                                                                           cs
                                                                                           key
                                                                                           name
                                                                                           cj.state
                                                                                           attempt
                                                                                           spentMinor
                                                                                           runningSince
                                                                                           |> Task.map
                                                                                                  (\_ ->
                                                                                                      { segment =
                                                                                                          List.reverse
                                                                                                              keys
                                                                                                              |> List.head
                                                                                                              |> Maybe.withDefault
                                                                                                                     after
                                                                                                      , state =
                                                                                                          cj.state
                                                                                                      , outcome =
                                                                                                          outcome
                                                                                                      , step =
                                                                                                          seen.step
                                                                                                      , code =
                                                                                                          seen.code
                                                                                                      , message =
                                                                                                          seen.message
                                                                                                      , trainLoss =
                                                                                                          seen.trainLoss
                                                                                                      , valLoss =
                                                                                                          seen.valLoss
                                                                                                      , peft =
                                                                                                          seen.peft
                                                                                                      , resumedFrom =
                                                                                                          seen.resumedFrom
                                                                                                      , spentMinor =
                                                                                                          spentMinor
                                                                                                      , errorCode =
                                                                                                          cj.errorCode
                                                                                                      , errorMessage =
                                                                                                          cj.errorMessage
                                                                                                      , relaunches =
                                                                                                          0
                                                                                                      , ranSeconds =
                                                                                                          if cj.startMs
                                                                                                              > 0
                                                                                                              && cj.endMs
                                                                                                                     > cj.startMs then
                                                                                                              (cj.endMs
                                                                                                                  - cj.startMs)
                                                                                                                  // 1000

                                                                                                          else
                                                                                                              0
                                                                                                      }))))))


-- A segment's local copy: `cloud-events/<attempt>-<seq>.jsonl`, the same
-- bytes each time, so a replayed watch writes nothing new.
mirrorSegment : String -> Int -> String -> String -> Task Error ()
mirrorSegment dir attempt key text =
    let
        seq = lastSegment key
        name = String.padLeft 6 '0' (String.fromInt attempt) ++ "-" ++ seq
    in
        File.mkdirAll (dir ++ "/cloud-events")
            |> Task.andThen
                   (\_ -> File.writeFile (dir ++ "/cloud-events/" ++ name) text)


-- events.jsonl is every mirrored segment in order, so the local readers
-- (progress, the console, `runs`) see a cloud run as a local one.
rebuildEvents : String -> Task Error ()
rebuildEvents dir =
    File.readDir (dir ++ "/cloud-events")
        |> Task.onError (\_ -> Task.succeed [])
        |> Task.andThen
               (\names ->
                   Task.sequence
                       (List.map
                           (\n -> File.readFile (dir ++ "/cloud-events/" ++ n))
                           (List.sort
                               (List.filter
                                   (\n -> String.endsWith ".jsonl" n)
                                   names)))
                       |> Task.andThen
                              (\texts ->
                                  File.writeFile
                                      (dir ++ "/events.jsonl.partial")
                                      (String.concat texts)
                                      |> Task.andThen
                                             (\_ ->
                                                 File.rename
                                                     (dir
                                                         ++ "/events.jsonl.partial")
                                                     (dir ++ "/events.jsonl"))))


-- Download the adapter the container uploaded, each file checked against
-- the adapter's manifest, into the run directory's adapter/ (where a local
-- run leaves it). Returns the PEFT weights' digest.
downloadAdapter : String -> Store -> String -> Task Error String
downloadAdapter dir store key =
    Store.getAt store (runPath key ++ "/adapter/manifest.json")
        |> Task.andThen
               (\found ->
                   case found of

                       Nothing ->
                           Task.fail
                               (Failure.toError
                                   (TrainingFailed
                                       { runId = key
                                       , step = 0
                                       , reason =
                                           "the job finished but its adapter has no manifest in the staging bucket"
                                       , logTail = ""
                                       }))

                       Just text ->
                           Task.fromResult
                               (JsonD.decodeString
                                   (JsonD.field
                                       "files"
                                       (JsonD.list
                                           (JsonD.map2
                                               (\n h -> ( n, h ))
                                               (JsonD.field "name" JsonD.string)
                                               (JsonD.field "sha256" JsonD.string))))
                                   text))
        |> Task.andThen
               (\files ->
                   File.mkdirAll (dir ++ "/adapter")
                       |> Task.andThen
                              (\_ ->
                                  Task.sequence
                                      (List.map
                                          (\( n, h ) ->
                                              Store.fetchAt
                                                  store
                                                  (runPath key ++ "/adapter/"
                                                      ++ n)
                                                  h
                                                  |> Task.andThen
                                                         (\path ->
                                                             File.copy
                                                                 path
                                                                 (dir
                                                                     ++ "/adapter/"
                                                                     ++ n)))
                                          files))
                       |> Task.map
                              (\_ ->
                                  List.filter
                                      (\( n, _ ) ->
                                          n == "adapter_model.safetensors")
                                      files
                                      |> List.head
                                      |> Maybe.map (\( _, h ) -> h)
                                      |> Maybe.withDefault ""))


-- After the adapter is registered: delete the run's Vertex job records and
-- its staging prefix, unless the job keeps them (`withKeepStaging`). A job
-- that has not ended is left alone (it cannot be deleted, and it ends by its
-- own runtime ceiling).
cloudCleanup : Durable.Ctx -> Job -> CloudRun -> Adapter -> Task Error Adapter
cloudCleanup ctx job cloud a =
    if (settings job).keepStaging then
        Task.succeed a

    else
        Durable.step
            ctx
            Codec.int
            "cleanup"
            (Google.listCustomJobs
                cloud.settings.project
                cloud.settings.region
                ("labels.sky-run=\"" ++ cloud.key ++ "\"")
                |> Task.andThen
                       (\jobs ->
                           Task.sequence
                               (List.map
                                   (\j ->
                                       if List.member
                                           j.state
                                           [ "JOB_STATE_SUCCEEDED"
                                           , "JOB_STATE_FAILED"
                                           , "JOB_STATE_CANCELLED"
                                           ] then
                                           Google.deleteCustomJob j.name

                                       else
                                           Task.succeed ())
                                   jobs))
                |> Task.andThen
                       (\_ ->
                           Task.fromResult
                               (Store.fromUrl cloud.settings.staging)
                               |> Task.andThen
                                      (\store ->
                                          Store.deletePrefix
                                              store
                                              (runPath cloud.key ++ "/"))))
            |> Task.map (\_ -> a)

-- | A Vertex run as its last watch saw it: the job, its state
-- (`JOB_STATE_RUNNING`, …), the attempt, where it runs, and the spend so far
-- against the budget, in exact money.
type alias CloudStatus =
    { job : String
    , state : String
    , attempt : Int
    , region : String
    , machine : String
    , spent : Money
    , budget : Money
    }


-- A recorded amount, or zero dollars when it does not parse. A `case`, not
-- `Maybe.withDefault`: the polymorphic default's result would be narrowed
-- back at run time.
moneyOrZero : String -> Money
moneyOrZero text =
    case parseMoney text of

        Just m ->
            m

        Nothing ->
            Money.zero Money.USD


-- | The job's Vertex run, from its run directory (`Nothing` for a local run
-- or one that has not launched).
cloudStatus : Job -> Task Error (Maybe CloudStatus)
cloudStatus job =
    let
        path = runDir job ++ "/cloud.json"
    in
        File.exists path
            |> Task.andThen
                   (\there ->
                       if not there then
                           Task.succeed Nothing

                       else
                           File.readFile path
                               |> Task.map
                                      (\text ->
                                          JsonD.decodeString
                                              (JsonD.map3
                                                  (\( j, st, a ) ( r, m ) ( sp, bu ) ->
                                                      { job = j
                                                      , state = st
                                                      , attempt = a
                                                      , region = r
                                                      , machine = m
                                                      , spent = moneyOrZero sp
                                                      , budget = moneyOrZero bu
                                                      })
                                                  (JsonD.map3
                                                      (\j st a -> ( j, st, a ))
                                                      (JsonD.field
                                                          "job"
                                                          JsonD.string)
                                                      (JsonD.field
                                                          "state"
                                                          JsonD.string)
                                                      (JsonD.field
                                                          "attempt"
                                                          JsonD.int))
                                                  (JsonD.map2
                                                      (\r m -> ( r, m ))
                                                      (JsonD.field
                                                          "region"
                                                          JsonD.string)
                                                      (JsonD.field
                                                          "machine"
                                                          JsonD.string))
                                                  (JsonD.map2
                                                      (\sp bu -> ( sp, bu ))
                                                      (JsonD.field
                                                          "spent"
                                                          JsonD.string)
                                                      (JsonD.field
                                                          "budget"
                                                          JsonD.string)))
                                              text
                                              |> Result.toMaybe))
