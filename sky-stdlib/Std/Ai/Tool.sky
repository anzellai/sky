module Std.Ai.Tool exposing
    ( Tool
    , tool
    , typed
    , name
    , describe
    , parameters
    , checkArguments
    , run
    , instructions
    )

{-| `Std.Ai.Tool` — a named capability the agent can call. A `Tool` carries a
stable name, a description the model reads, and an executor `arguments -> result`
(both strings on the wire; the executor parses/serialises as it likes). The v1
loop uses a prompt-based protocol: the model is told the tools and asked to reply
with `{"tool":"<name>","args":"<input>"}` to call one, or `{"answer":"<final>"}`
when done. Native OpenAI function-calling (a `tools` array + `tool_calls`) is
also available: `Agent.nativeToolLoop` runs it over the same `Tool` values, and
`Provider.chatTools` is the single call it makes.

    weather =
        Tool.tool "weather" "Get the weather for a city (args: the city name)"
            (\city -> WeatherApi.lookup city)

A typed tool (`typed`) declares its arguments with a `Codec`: the model is sent
the codec's JSON Schema, and the arguments are decoded with the codec before
the executor runs. Arguments that do not decode are a `Decode` error, which the
agent loops hand back to the model as the tool's result so it can call again.

    forecast =
        Tool.typed "forecast" "The forecast for a city"
            (Codec.auto { city = "", days = 0 })
            (\args -> Weather.forecast args.city args.days)
-}

import Sky.Core.Prelude exposing (..)
import Sky.Core.Task as Task
import Sky.Core.Error as Error exposing (Error)
import Sky.Core.List as List
import Sky.Core.String as String
import Sky.Core.Result as Result exposing (Result(..))
import Sky.Core.Maybe exposing (Maybe(..))
import Sky.Core.Json.Encode as JsonE
import Std.Codec as Codec exposing (Codec)

type Tool
    = Tool { name : String
, description : String
, exec : String -> Task Error String
, parameters : Maybe JsonE.Value
, check : String -> Result Error ()
}


{-| Define a tool: a stable `name`, a `description` the model reads, and an
executor `arguments -> Task Error result`. Arguments and result are strings on the
wire (parse a typed input inside the executor with a `Codec` as you wish).
-}
tool : String -> String -> (String -> Task Error String) -> Tool
tool nm description exec =
    Tool
        { name = nm
        , description = description
        , exec = exec
        , parameters = Nothing
        , check = \_ -> Ok ()
        }


{-| Define a tool with typed arguments: the model is sent `codec`'s JSON
Schema (`Codec.jsonSchema`) as the tool's parameters, and the executor gets
the arguments decoded with `codec`. Arguments that do not decode never reach
the executor: they are a `Decode` error naming the tool.
-}
typed : String -> String -> Codec a -> (a -> Task Error String) -> Tool
typed nm description codec exec =
    Tool
        { name = nm
        , description = description
        , exec =
            \args ->
                case decodeArguments nm codec args of

                    Ok a ->
                        exec a

                    Err e ->
                        Task.fail e
        , parameters = Just (Codec.jsonSchema codec).schema
        , check = \args -> Result.map (\_ -> ()) (decodeArguments nm codec args)
        }


decodeArguments : String -> Codec a -> String -> Result Error a
decodeArguments nm codec args =
    case Codec.fromJson codec args of

        Ok a ->
            Ok a

        Err e ->
            Err
                (Error.decode
                    ("tool " ++ nm ++ ": the arguments do not match its schema: "
                        ++ Error.toString e))


{-| The JSON Schema of a tool's arguments: its codec's schema for a `typed`
tool, the permissive `{"type": "object"}` otherwise. -}
parameters : Tool -> JsonE.Value
parameters (Tool t) =
    case t.parameters of

        Just p ->
            p

        Nothing ->
            JsonE.object [ ( "type", JsonE.string "object" ) ]


{-| Check the arguments the model gave the tool named `nm`, without running it:
a `typed` tool decodes them with its codec, any other tool takes any string.
An unknown name is `Ok`: `run` reports it. The agent loops call this first and
hand a failure back to the model. -}
checkArguments : List Tool -> String -> String -> Result Error ()
checkArguments tools nm args =
    case List.filter (\(Tool t) -> t.name == nm) tools of

        (Tool t) :: _ ->
            t.check args

        [] ->
            Ok ()


{-| A tool's name. -}
name : Tool -> String
name (Tool t) =
    t.name


{-| A tool's description. -}
describe : Tool -> String
describe (Tool t) =
    t.description


{-| Run the tool named `nm` from `tools` with `args`. Fails with a classified
error if no tool has that name. Used by the agent loop; rarely called directly.
-}
run : List Tool -> String -> String -> Task Error String
run tools nm args =
    case List.filter (\(Tool t) -> t.name == nm) tools of

        (Tool t) :: _ ->
            t.exec args

        [] ->
            Task.fail
                (Error.notFound |> Error.withMessage ("no tool named " ++ nm))


{-| The tool-use instructions appended to the agent's system prompt: the tool
list and the JSON reply protocol. Deterministic (sorted iteration is the caller's
concern; `tools` order is preserved), so it is stable across a durable replay.
-}
instructions : List Tool -> String
instructions tools =
    let
        one (Tool t) =
            case t.parameters of

                Just p ->
                    "- " ++ t.name ++ ": " ++ t.description
                        ++ "\n  args: a JSON object matching "
                        ++ JsonE.encode 0 p

                Nothing ->
                    "- " ++ t.name ++ ": " ++ t.description
        listed = List.map one tools |> String.join "\n"
        anyTyped =
            List.any
                (\(Tool t) ->
                    case t.parameters of

                        Just _ ->
                            True

                        Nothing ->
                            False)
                tools
    in
        "You can use these tools:\n" ++ listed
            ++ "\n\nTo use a tool, reply with ONLY a JSON object: "
            ++ "{\"tool\": \"<name>\", \"args\": \"<input string>\"}. "
            ++ (if anyTyped then
                   "For a tool that lists a JSON object for its args, give that object as args. "

               else
                   "")
            ++ "When you have the final answer, reply with ONLY: {\"answer\": \"<final answer>\"}."
