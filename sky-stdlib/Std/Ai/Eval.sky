-- | Std.Ai.Eval — evaluate a model with Sky values: suites of cases, scorers,
-- a judge, a typed report, a comparison against a baseline and a gate.
--
-- ```elm
-- import Std.Ai.Eval as Eval exposing (Expect(..))
--
-- support : Eval.Suite String
-- support =
--     Eval.suite "support"
--         (\question -> [ Provider.system "Answer in one sentence.", Provider.user question ])
--         [ { id = "refund", input = "How do I get a refund?", expect = Contains "refund", tags = [] }
--         , { id = "tone", input = "You are useless.", expect = Rubric "Stays polite and offers help.", tags = [ "tone" ] }
--         ]
--
-- gateSupport : Db -> Provider -> Task Error Eval.Passed
-- gateSupport db candidate =
--     Eval.run db candidate support
--         |> Task.andThen (\report -> Task.fromResult (Eval.check Eval.thresholds report))
-- ```
--
-- A run is repeatable: every call uses temperature 0 and a fixed seed unless
-- the suite says otherwise, and `withSamples n` asks each case n times with
-- the seeds `seed`, `seed + 1`, …, so the statistics use every sample.
--
-- The judge for `Rubric` cases is a model slot, `"judge"`. Its default is the
-- local pinned development model, and an operator switches it with the
-- `SKY_AI_JUDGE_*` variables like any other slot (docs/ai/local.md). Under
-- `sky test` in test mode (a project with `.env.test`) no engine starts: the
-- judge's calls, like every slot's, are answered by fixtures under
-- `tests/mocks/`.
--
-- Every run is recorded in the database (`_sky_ai_eval_runs`) and shown in the
-- Sky Console's AI panel: a run in the app's own process, and one another
-- process wrote to the app's database (`sky ai eval`), which the panel reads
-- from the database when it opens.
--
-- **Judge discipline.** Every judge call is journalled in the database
-- (`_sky_ai_eval_judge_journal`), keyed by the judge's identity, the rubric
-- prompt version and the exact prompt (rubric, question and answer), so a
-- re-run of an unchanged output costs nothing and returns the same verdict.
-- `withCalibration` gives a judge human-labelled cases: a run first measures
-- the judge's agreement with them and records it in the report, and the gate
-- refuses a report whose judge fell below the agreement it needs.
-- `pairwise` compares two reports' answers case by case and asks the judge
-- in both orders, so a judge that prefers the first (or second) position
-- cannot decide the result.
module Std.Ai.Eval exposing
    ( Suite
    , Case
    , Expect(..)
    , Score
    , Judge
    , Report
    , CaseResult
    , ScorerScore
    , Comparison
    , ScorerDelta
    , Thresholds
    , Passed
    , RunSummary
    , Labelled
    , Calibration
    , Disagreement
    , Pairwise
    , PairResult
    , suite
    , suiteName
    , prompts
    , withSamples
    , withConcurrency
    , withJudge
    , withLatencyBudget
    , withCostBudget
    , withOptions
    , withSeed
    , withPriceBook
    , withTools
    , judge
    , withPassScore
    , judgeSlot
    , defaultJudge
    , judgeOn
    , withCalibration
    , calibrate
    , pairwise
    , judgeAnswer
    , judgeAnswerWith
    , setup
    , run
    , runAs
    , history
    , compare
    , alone
    , thresholds
    , withMinPassRate
    , withFloor
    , withMaxRegression
    , withCalibratedJudge
    , gate
    , check
    , passedSuite
    , passedCandidate
    , passedDigest
    , toJunit
    , toMarkdown
    , encodeReport
    , decodeReport
    )

import Sky.Core.Prelude exposing (..)
import Sky.Core.Task as Task
import Sky.Core.Error as Error exposing (Error, ErrorKind(..))
import Sky.Core.List as List
import Sky.Core.String as String
import Sky.Core.Maybe as Maybe exposing (Maybe(..))
import Sky.Core.Dict exposing (Dict)
import Sky.Core.Regex as Regex
import Sky.Core.Crypto as Crypto
import Sky.Core.Time as Time
import Sky.Core.Json.Encode as JsonE
import Sky.Core.Json.Decode as JsonD
import Sky.Ffi as Ffi
import Std.Codec as Codec
import Std.Db as Db exposing (Db, SqlValue(..))
import Std.Money as Money exposing (Money)
import Std.Decimal as Decimal
import Std.Ai.Provider as Provider exposing
    ( Provider
    , Message
    , ChatResponse
    , ToolSpec
    , ToolCall
    , PriceBook
    )
import Std.Ai.Endpoint as Endpoint exposing (Endpoint)
import Std.Ai.Local as Local
import Std.Ai.Failure as Failure exposing (Failure(..))

-- ── Cases and expectations ──────────────────────────────────────────
-- | One case: a stable id (it pairs the case across runs), the input the
-- suite's prompt function turns into messages, what to expect, and tags.
type alias Case input =
    { id : String
    , input : input
    , expect : Expect
    , tags : List String
    }

-- | What a case expects of the answer.
--
--   * `Exact s`: the answer, with surrounding white space removed, is `s`.
--   * `Contains s`: the answer contains `s` (case sensitive).
--   * `Matches re`: the answer matches the RE2 regular expression `re`.
--   * `JsonShape shape`: the answer is JSON of the codec's shape
--     (`Codec.shape myCodec`): a record's every field is present with its
--     column type, and a `Maybe` field may be `null`.
--   * `CallsTool { name, args }`: the model asked for the tool `name`, and
--     `args` accepts its JSON arguments. The suite advertises its tools with
--     `withTools`.
--   * `Refuses`: the answer declines (it says "I can't", "I cannot",
--     "I won't", "I'm sorry" or "unable to", in any case).
--   * `Rubric text`: the judge scores the answer against `text` from 1 to 5,
--     and 4 or more passes (`withPassScore` changes the bar).
--   * `Custom name scorer`: your own scorer, reported under `name`.
--   * `AllOf expects`: every expectation must pass; the score is their mean.
type Expect
    = Exact String
    | Contains String
    | Matches String
    | JsonShape Codec.Shape
    | CallsTool { name : String, args : String -> Bool }
    | Refuses
    | Rubric String
    | Custom String (ChatResponse -> Score)
    | AllOf (List Expect)

-- | A scorer's verdict: a value from 0 to 1, whether it passes, and why.
type alias Score =
    { value : Float
    , passed : Bool
    , reason : String
    }

-- ── Suites ──────────────────────────────────────────────────────────
-- | A named set of cases and how to run them. Build it with `suite` and
-- refine it with the `with…` builders.
type Suite input
    = Suite { name : String
, prompt : input -> List Message
, cases : List (Case input)
, samples : Int
, concurrency : Int
, judge : Maybe Judge
, latencyBudgetMs : Maybe Int
, costBudget : Maybe Money
, options : Provider.Options
, seed : Int
, priceBook : Maybe PriceBook
, tools : List ToolSpec
}


-- | A suite: its name, how an input becomes messages, and its cases. One
-- sample per case, four at a time, temperature 0, seed 42.
suite : String -> (input -> List Message) -> List (Case input) -> Suite input
suite name prompt cases =
    Suite
        { name = name
        , prompt = prompt
        , cases = cases
        , samples = 1
        , concurrency = 4
        , judge = Nothing
        , latencyBudgetMs = Nothing
        , costBudget = Nothing
        , options =
            { temperature = Just 0.0
            , seed = Nothing
            , maxTokens = Nothing
            , adapter = Nothing
            }
        , seed = 42
        , priceBook = Nothing
        , tools = []
        }


{-| Every request a run of the suite sends, in order: each case's messages
with the options of each sample (temperature 0 and seed `seed + sample` by
default). A device records the answers to them (`Std.Ai.Device.recordPrompts`), and
the server scores the recording with `Std.Ai.Device.replay` and `runAs`, so one
suite measures the device and the server alike. -}
prompts : Suite input -> List { messages : List Message, options : Provider.Options }
prompts (Suite s) =
    List.concatMap
        (\c ->
            List.map
                (\sample ->
                    { messages = s.prompt c.input
                    , options =
                        { temperature = s.options.temperature
                        , seed =
                            Just
                                (Maybe.withDefault
                                    (s.seed + sample)
                                    s.options.seed)
                        , maxTokens = s.options.maxTokens
                        , adapter = s.options.adapter
                        }
                    })
                (List.range 0 (s.samples - 1)))
        s.cases


-- | The suite's name: the `suite` field of its reports.
suiteName : Suite input -> String
suiteName (Suite s) =
    s.name


-- | Ask each case `n` times (at least once), with the seeds `seed` to
-- `seed + n - 1`. Use it where an engine is not deterministic.
withSamples : Int -> Suite input -> Suite input
withSamples n (Suite s) =
    Suite { s | samples = max 1 n }


-- | How many calls run at once (at least one).
withConcurrency : Int -> Suite input -> Suite input
withConcurrency n (Suite s) =
    Suite { s | concurrency = max 1 n }


-- | The judge for `Rubric` cases. Without it, `defaultJudge`.
withJudge : Judge -> Suite input -> Suite input
withJudge j (Suite s) =
    Suite { s | judge = Just j }


-- | The p95 latency budget in milliseconds. A report over it fails the gate.
withLatencyBudget : Int -> Suite input -> Suite input
withLatencyBudget ms (Suite s) =
    Suite { s | latencyBudgetMs = Just ms }


-- | The mean cost per case. A report over it fails the gate. Needs
-- `withPriceBook`, because a cost is priced from token usage.
withCostBudget : Money -> Suite input -> Suite input
withCostBudget m (Suite s) =
    Suite { s | costBudget = Just m }


-- | The sampling options. The suite's seed fills `seed` when it is `Nothing`.
withOptions : Provider.Options -> Suite input -> Suite input
withOptions o (Suite s) =
    Suite { s | options = o }


-- | The base seed (default 42).
withSeed : Int -> Suite input -> Suite input
withSeed n (Suite s) =
    Suite { s | seed = n }


-- | Price each call, for the report's cost figures and `withCostBudget`.
withPriceBook : PriceBook -> Suite input -> Suite input
withPriceBook book (Suite s) =
    Suite { s | priceBook = Just book }


-- | Advertise tools, for `CallsTool` cases. The calls then go through
-- `Provider.chatTools`.
withTools : List ToolSpec -> Suite input -> Suite input
withTools ts (Suite s) =
    Suite { s | tools = ts }

-- ── The judge ───────────────────────────────────────────────────────
-- | A judge: a provider and the version of its rubric prompt, recorded in the
-- report so a changed prompt is visible.
type Judge
    = Judge { provider : Provider
, version : String
, passAt : Int
, slot : Maybe Endpoint
, labelled : List Labelled
, minAgreement : Float
}

-- | A human-labelled judging case: a question, an answer, the rubric, and
-- whether a person judged that the answer meets the rubric.
type alias Labelled =
    { id : String
    , question : String
    , answer : String
    , rubric : String
    , passes : Bool
    }


-- | A judge on a provider, with the version name of your rubric prompt. The
-- version is the judge's identity in the judge journal: change it when you
-- change the judge's model or prompt. A judge on a slot (`judgeOn`) also
-- records the slot's resolved model.
judge : Provider -> String -> Judge
judge p version =
    Judge
        { provider = p
        , version = version
        , passAt = 4
        , slot = Nothing
        , labelled = []
        , minAgreement = 0.0
        }


-- | A judge on a model slot. Its identity in the judge journal is the
-- version plus the slot's resolved target, model and adapter, so moving the
-- slot to another model (an operator's `SKY_AI_<SLOT>_MODEL`) never reuses a
-- verdict from the old one.
judgeOn : Endpoint -> String -> Judge
judgeOn slot version =
    Judge
        { provider = Endpoint.provider slot
        , version = version
        , passAt = 4
        , slot = Just slot
        , labelled = []
        , minAgreement = 0.0
        }


-- | Calibrate the judge on human-labelled cases. Before a run scores any
-- `Rubric` case, it asks the judge about each labelled case and measures how
-- often the judge agrees with the label. The report records the result, and
-- `gate` fails when the agreement is below `minAgreement` (from 0 to 1), so a
-- drifting judge cannot pass a bad model.
withCalibration : List Labelled -> Float -> Judge -> Judge
withCalibration cases minAgreement (Judge j) =
    Judge
        { j | labelled = cases, minAgreement = max 0.0 (min 1.0 minAgreement) }


-- | The lowest score from 1 to 5 that passes (default 4).
withPassScore : Int -> Judge -> Judge
withPassScore n (Judge j) =
    Judge { j | passAt = max 1 (min 5 n) }


-- | The judge's model slot, `"judge"`: the local pinned development model by
-- default. The slot's `URL` variable (with `KEY` and `MODEL`, under
-- `SKY_AI_JUDGE_<KEY>`) moves it to a remote model, and its `MODEL` alone pins
-- another local model.
judgeSlot : Endpoint
judgeSlot =
    Endpoint.endpoint "judge"
        |> Endpoint.withLocal
               (Local.model Local.devModel |> Local.withContext 4096)


-- | The default judge: `judgeSlot` with the rubric prompt `rubric-v1`.
defaultJudge : Judge
defaultJudge =
    judgeOn judgeSlot "rubric-v1"


judgeVersion : Judge -> String
judgeVersion (Judge j) =
    j.version


-- | Ask the judge to score one answer against a rubric, outside a suite: the
-- same prompt, temperature 0 and pass mark a `Rubric` case uses, with the
-- seed you give. `Std.Ai.Dataset.Synthetic` filters generated rows with it.
-- It has no database, so the call does not go through the judge journal.
--
--     Eval.judgeAnswer Eval.defaultJudge 42 "Polite and correct." question answer
judgeAnswer : Judge -> Int -> String -> String -> String -> Task Error Score
judgeAnswer (Judge j) seed rubric question answer =
    Provider.chatWith
        (judgeOptions seed 64)
        j.provider
        (judgePrompt (Judge j) [ Provider.user question ] rubric answer)
        |> Task.map (\r -> readJudge j.passAt r.content)


-- | `judgeAnswer` through the judge journal in a database: an unchanged call
-- (the same judge identity, rubric version, seed and prompt) is answered from
-- the journal with no model call, so re-running a generator or a check that
-- judges the same answers costs nothing and returns the same verdicts.
-- `Std.Ai.Dataset.Synthetic.withJournal` uses it.
judgeAnswerWith : Db -> Judge -> Int -> String -> String -> String -> Task Error Score
judgeAnswerWith db (Judge j) seed rubric question answer =
    setup db |> Task.andThen (\_ -> judgeIdentity (Judge j))
        |> Task.andThen
               (\identity ->
                   journalled
                       { judge = Judge j, db = db, identity = identity }
                       seed
                       64
                       (judgePrompt
                           (Judge j)
                           [ Provider.user question ]
                           rubric
                           answer))
        |> Task.map (\reply -> readJudge j.passAt reply)

-- ── Reports ─────────────────────────────────────────────────────────
-- | One case at one sample. `score` is the mean of its scorers; `scores`
-- holds each scorer's value under its name (`exact`, `contains`, `regex`,
-- `json`, `tool`, `refuses`, `judge`, or the custom name). An error (the
-- model call failed) counts as a failure with score 0.
type alias CaseResult =
    { id : String
    , sample : Int
    , tags : List String
    , passed : Bool
    , score : Float
    , scores : List ( String, Float )
    , reason : String
    , output : String
    , latencyMs : Int
    , cost : Maybe Money
    , error : Maybe String
    }

-- | One scorer's mean over the run.
type alias ScorerScore =
    { scorer : String
    , mean : Float
    , count : Int
    }

-- | A run of a suite. `digest` names the run's outputs: two runs with the
-- same digest answered the same.
type alias Report =
    { suite : String
    , candidate : String
    , seed : Int
    , samples : Int
    , judge : Maybe String
    , startedAt : Int
    , durationMs : Int
    , cases : List CaseResult
    , passed : Int
    , failed : Int
    , errors : Int
    , passRate : Float
    , scorers : List ScorerScore
    , p95LatencyMs : Int
    , meanCost : Maybe Money
    , latencyBudgetMs : Maybe Int
    , costBudget : Maybe Money
    , calibration : Maybe Calibration
    , digest : String
    }

-- | A judge's calibration: how often it agreed with the human labels.
-- `kappa` is Cohen's kappa (agreement corrected for chance). `truePass` counts
-- cases both the label and the judge passed, `falsePass` cases the judge
-- passed and the label failed, and so on. `calibrated` is `agreement >=
-- minAgreement` on at least one labelled case.
type alias Calibration =
    { judge : String
    , cases : Int
    , agreed : Int
    , agreement : Float
    , kappa : Float
    , truePass : Int
    , trueFail : Int
    , falsePass : Int
    , falseFail : Int
    , minAgreement : Float
    , calibrated : Bool
    , disagreements : List Disagreement
    }

-- | A labelled case the judge decided differently.
type alias Disagreement =
    { id : String
    , label : Bool
    , verdict : Bool
    , reason : String
    }

-- | A past run, as `history` reads it from the database.
type alias RunSummary =
    { digest : String
    , suite : String
    , candidate : String
    , passed : Int
    , failed : Int
    , errors : Int
    , passRate : Float
    , p95LatencyMs : Int
    , createdAt : Int
    }


-- ── Running ─────────────────────────────────────────────────────────
-- The eval tables, in the format of `db/migrations/*.json`: dialect-neutral
-- ops applied through the `_sky_migrations` ledger (ids `_sky_ai_eval_*`).
evalMigrations : String
evalMigrations =
    """[{"id":"_sky_ai_eval_0001","ops":[
{"kind":"createTable","table":"_sky_ai_eval_runs","columns":[
{"name":"digest","type":"text"},{"name":"suite","type":"text"},{"name":"candidate","type":"text"},
{"name":"passed","type":"int"},{"name":"failed","type":"int"},{"name":"errors","type":"int"},
{"name":"pass_rate","type":"text"},{"name":"p95_latency_ms","type":"int"},{"name":"report","type":"text"},
{"name":"created_at","type":"int"}]},
{"kind":"createTable","table":"_sky_ai_eval_judge_journal","columns":[
{"name":"entry_key","type":"text"},{"name":"judge","type":"text"},{"name":"reply","type":"text"},
{"name":"created_at","type":"int"}]},
{"kind":"addIndex","name":"_sky_ai_eval_judge_journal_key","table":"_sky_ai_eval_judge_journal","indexColumns":["entry_key"],"unique":true}
]},
{"id":"_sky_ai_eval_0002","ops":[
{"kind":"addColumn","table":"_sky_ai_eval_runs","column":"console","type":"text","nullable":true}
]}]"""


migrateRaw : Db -> String -> Task Error (List String)
migrateRaw =
    Ffi.kernel "Ai_migrate"


-- | Create or update the eval tables (idempotent): the run history and the
-- judge journal. `run` calls it.
setup : Db -> Task Error ()
setup db =
    migrateRaw db evalMigrations |> Task.map (\_ -> ())


-- | Run a suite against a provider, record it in the database and the
-- console, and return the report. The candidate is recorded as `"default"`.
run : Db -> Provider -> Suite input -> Task Error Report
run db p s =
    runAs "default" db p s

-- What a run's judge calls need: the judge, the journal's database and the
-- judge's identity (resolved once per run).
type alias JudgeCtx =
    { judge : Judge
    , db : Db
    , identity : String
    }


-- | `run`, naming the candidate (a model, an adapter, a registry version
-- such as `Registry.label v`) in the report.
runAs : String -> Db -> Provider -> Suite input -> Task Error Report
runAs candidate db p (Suite s) =
    let
        j = judgeFor (Suite s)
        rubric = List.any (\c -> hasRubric c.expect) s.cases
    in
        setup db
            |> Task.andThen
                   (\_ ->
                       if rubric then
                           judgeIdentity j

                       else
                           Task.succeed "")
            |> Task.map
                   (\identity -> { judge = j, db = db, identity = identity })
            |> Task.andThen
                   (\ctx ->
                       calibrateIf rubric ctx |> Task.map (\cal -> ( ctx, cal )))
            |> Task.andThen
                   (\( ctx, cal ) -> runCases candidate ctx p (Suite s) cal)
            |> Task.andThen
                   (\report -> store db report |> Task.map (\_ -> report))


calibrateIf : Bool -> JudgeCtx -> Task Error (Maybe Calibration)
calibrateIf rubric ctx =
    case ctx.judge of

        Judge j ->
            if rubric && not (List.isEmpty j.labelled) then
                calibrateWith ctx |> Task.map Just

            else
                Task.succeed Nothing


runCases : String -> JudgeCtx -> Provider -> Suite input -> Maybe Calibration -> Task Error Report
runCases candidate ctx p (Suite s) cal =
    let
        jobs =
            List.concatMap
                (\c ->
                    List.map
                        (\k -> runCase ctx p (Suite s) c k)
                        (List.range 0 (s.samples - 1)))
                s.cases
    in
        Time.now ()
            |> Task.andThen
                   (\started ->
                       Task.parallelN s.concurrency jobs
                           |> Task.andThen
                                  (\results ->
                                      Time.now ()
                                          |> Task.map
                                                 (\ended ->
                                                     buildReport
                                                         candidate
                                                         (Suite s)
                                                         cal
                                                         started
                                                         (ended - started)
                                                         results)))


-- One case at one sample. A failed model call is a result, not a failed run.
runCase : JudgeCtx -> Provider -> Suite input -> Case input -> Int -> Task Error CaseResult
runCase ctx p (Suite s) c sample =
    let
        opts =
            { temperature = s.options.temperature
            , seed = Just (Maybe.withDefault (s.seed + sample) s.options.seed)
            , maxTokens = s.options.maxTokens
            , adapter = s.options.adapter
            }
        messages = s.prompt c.input
    in
        Time.now ()
            |> Task.andThen
                   (\t0 ->
                       callModel p s.tools opts messages
                           |> Task.andThen
                                  (\out ->
                                      Time.now ()
                                          |> Task.andThen
                                                 (\t1 ->
                                                     scoreExpect
                                                         ctx
                                                         s.seed
                                                         messages
                                                         c.expect
                                                         out
                                                         |> Task.map
                                                                (\sc ->
                                                                    okResult
                                                                        (Suite s)
                                                                        c
                                                                        sample
                                                                        out
                                                                        (t1 - t0)
                                                                        sc)))
                           |> Task.onError
                                  (\e ->
                                      Time.now ()
                                          |> Task.map
                                                 (\t1 ->
                                                     errResult
                                                         c
                                                         sample
                                                         (t1 - t0)
                                                         e)))


judgeFor : Suite input -> Judge
judgeFor (Suite s) =
    Maybe.withDefault defaultJudge s.judge

-- The answer a scorer sees.
type alias Output =
    { content : String
    , toolCalls : List ToolCall
    , usage : Provider.Usage
    }


callModel : Provider -> List ToolSpec -> Provider.Options -> List Message -> Task Error Output
callModel p tools opts messages =
    if List.isEmpty tools then
        Provider.chatWith opts p messages
            |> Task.map
                   (\r ->
                       { content = r.content, toolCalls = [], usage = r.usage })

    else
        Provider.chatTools p (List.map Provider.Say messages) tools
            |> Task.map
                   (\r ->
                       { content = r.content
                       , toolCalls = r.toolCalls
                       , usage = r.usage
                       })


okResult : Suite input -> Case input -> Int -> Output -> Int -> ( List ( String, Float ), Score ) -> CaseResult
okResult (Suite s) c sample out latency ( parts, sc ) =
    { id = c.id
    , sample = sample
    , tags = c.tags
    , passed = sc.passed
    , score = sc.value
    , scores = parts
    , reason = sc.reason
    , output = out.content
    , latencyMs = latency
    , cost = Maybe.map (\book -> Provider.cost book out.usage) s.priceBook
    , error = Nothing
    }


errResult : Case input -> Int -> Int -> Error -> CaseResult
errResult c sample latency e =
    { id = c.id
    , sample = sample
    , tags = c.tags
    , passed = False
    , score = 0.0
    , scores = []
    , reason = "the call failed: " ++ Error.toString e
    , output = ""
    , latencyMs = latency
    , cost = Nothing
    , error = Just (Error.toString e)
    }


-- ── Scorers ─────────────────────────────────────────────────────────
-- Score one expectation: each scorer's value under its name, and the verdict.
scoreExpect : JudgeCtx -> Int -> List Message -> Expect -> Output -> Task Error ( List ( String, Float ), Score )
scoreExpect j seed messages expect out =
    case expect of

        Rubric rubric ->
            judgeScore j seed messages rubric out.content
                |> Task.map (\sc -> ( [ ( "judge", sc.value ) ], sc ))

        AllOf expects ->
            Task.sequence
                (List.map (\e -> scoreExpect j seed messages e out) expects)
                |> Task.map combine

        _ ->
            let
                ( name, sc ) = scorePure expect out
            in
                Task.succeed ( [ ( name, sc.value ) ], sc )


combine : List ( List ( String, Float ), Score ) -> ( List ( String, Float ), Score )
combine parts =
    let
        named = List.concatMap (\( n, _ ) -> n) parts
        scores = List.map (\( _, sc ) -> sc) parts
        failing = List.filter (\sc -> not sc.passed) scores
    in
        ( named
        , { value = mean (List.map .value scores)
          , passed = List.isEmpty failing
          , reason =
              case failing of

                  [] ->
                      "all " ++ String.fromInt (List.length scores)
                          ++ " expectations passed"

                  _ ->
                      String.join "; " (List.map .reason failing)
          }
        )


verdict : Bool -> String -> String -> Score
verdict ok yes no =
    if ok then
        { value = 1.0, passed = True, reason = yes }

    else
        { value = 0.0, passed = False, reason = no }


-- Every scorer that needs no model.
scorePure : Expect -> Output -> ( String, Score )
scorePure expect out =
    let
        text = String.trim out.content
    in
        case expect of

            Exact s ->
                ( "exact"
                , verdict
                      (text == String.trim s)
                      "the answer is exact"
                      ("expected " ++ quote s ++ ", got " ++ quote (clip text))
                )

            Contains s ->
                ( "contains"
                , verdict
                      (String.contains s out.content)
                      ("the answer contains " ++ quote s)
                      ("the answer does not contain " ++ quote s)
                )

            Matches re ->
                ( "regex"
                , verdict
                      (Regex.match re out.content)
                      ("the answer matches " ++ re)
                      ("the answer does not match " ++ re)
                )

            JsonShape shape ->
                ( "json", jsonScore shape text )

            CallsTool t ->
                ( "tool", toolScore t.name t.args out.toolCalls )

            Refuses ->
                ( "refuses"
                , verdict
                      (refuses out.content)
                      "the answer declines"
                      ("the answer does not decline: " ++ quote (clip text))
                )

            Custom name scorer ->
                ( name
                , clampScore
                      (scorer { content = out.content, usage = out.usage })
                )

            Rubric _ ->
                ( "judge", verdict False "" "a rubric needs the judge" )

            AllOf _ ->
                ( "all"
                , verdict
                      False
                      ""
                      "nested expectations are scored by scoreExpect"
                )


clampScore : Score -> Score
clampScore sc =
    { sc | value = max 0.0 (min 1.0 sc.value) }


refusalPhrases : List String
refusalPhrases =
    [ "i can't"
    , "i cannot"
    , "i can not"
    , "i won't"
    , "i will not"
    , "i'm sorry"
    , "i am sorry"
    , "unable to"
    , "i'm not able"
    , "i am not able"
    ]


refuses : String -> Bool
refuses s =
    let
        lower = String.toLower (String.replace "’" "'" s)
    in
        List.any (\p -> String.contains p lower) refusalPhrases


toolScore : String -> (String -> Bool) -> List ToolCall -> Score
toolScore name accepts calls =
    let
        named = List.filter (\c -> c.name == name) calls
    in
        if List.isEmpty named then
            verdict
                False
                ""
                ("no call to the tool " ++ quote name ++ " (called: "
                    ++ String.join ", " (List.map .name calls)
                    ++ ")")

        else if List.any (\c -> accepts c.arguments) named then
            verdict True ("called " ++ name ++ " with accepted arguments") ""

        else
            verdict
                False
                ""
                ("called " ++ name ++ " with arguments the case rejects")


jsonScore : Codec.Shape -> String -> Score
jsonScore shape answer =
    let
        text = unfence answer
    in
        case JsonD.decodeString JsonD.value text of

            Err _ ->
                verdict
                    False
                    ""
                    ("the answer is not JSON: " ++ quote (clip text))

            Ok _ ->
                case JsonD.decodeString (shapeDecoder shape) text of

                    Ok _ ->
                        verdict
                            True
                            "the answer is JSON of the expected shape"
                            ""

                    Err e ->
                        verdict
                            False
                            ""
                            ("the JSON does not have the expected shape: "
                                ++ Error.toString e)


-- The JSON of an answer that is one Markdown code fence (```json … ```),
-- as models often write it; any other answer as it is. Text around the fence
-- is not stripped: an answer with prose around its JSON is not JSON.
unfence : String -> String
unfence answer =
    Regex.replace "^\\s*```(?:json)?\\s*([\\s\\S]*?)\\s*```\\s*$" "$1" answer


shapeDecoder : Codec.Shape -> JsonD.Decoder ()
shapeDecoder shape =
    case shape of

        Codec.SRecord cols ->
            List.foldl
                (\( name, col ) acc ->
                    JsonD.map2
                        (\_ _ -> ())
                        acc
                        (JsonD.field name (colDecoder col)))
                (JsonD.succeed ())
                cols

        Codec.SScalar col ->
            colDecoder col

        Codec.SBlob ->
            JsonD.map (\_ -> ()) JsonD.value


colDecoder : Codec.ColType -> JsonD.Decoder ()
colDecoder col =
    case col of

        Codec.CText ->
            JsonD.map (\_ -> ()) JsonD.string

        Codec.CInt ->
            JsonD.map (\_ -> ()) JsonD.int

        Codec.CReal ->
            JsonD.map (\_ -> ()) JsonD.float

        Codec.CBool ->
            JsonD.map (\_ -> ()) JsonD.bool

        Codec.CBlob ->
            JsonD.map (\_ -> ()) JsonD.value

        Codec.CNull inner ->
            JsonD.oneOf [ jsonNull, colDecoder inner ]


-- A JSON null (and nothing else).
jsonNull : JsonD.Decoder ()
jsonNull =
    JsonD.andThen
        (\v ->
            if JsonE.encode 0 v == "null" then
                JsonD.succeed ()

            else
                JsonD.fail "not null")
        JsonD.value


-- The judge's prompt, version "rubric-v1" by default. Its answer must carry
-- `SCORE: <1-5>`; one without a score fails the case and says so. The call
-- goes through the judge journal.
judgeScore : JudgeCtx -> Int -> List Message -> String -> String -> Task Error Score
judgeScore ctx seed messages rubric answer =
    case ctx.judge of

        Judge j ->
            journalled
                ctx
                seed
                64
                (judgePrompt ctx.judge messages rubric answer)
                |> Task.map (\reply -> readJudge j.passAt reply)


-- The judge's prompt for one answer: the last user message is the question.
judgePrompt : Judge -> List Message -> String -> String -> List Message
judgePrompt (Judge j) messages rubric answer =
    let
        question =
            messages |> List.filter (\m -> m.role == "user") |> List.reverse
                |> List.head
                |> Maybe.map .content
                |> Maybe.withDefault ""
    in
        [ Provider.system
              ("You are a strict evaluator (" ++ j.version
                  ++ "). Score the RESPONSE against the RUBRIC from 1 (fails it) to 5 (fully meets it). "
                  ++ "Reply with one line: SCORE: <1-5> - <one short reason>.")
        , Provider.user
              ("RUBRIC:\n" ++ rubric ++ "\n\nQUESTION:\n" ++ question
                  ++ "\n\nRESPONSE:\n"
                  ++ answer)
        ]


-- A judge call's options: temperature 0, the seed and a token limit.
judgeOptions : Int -> Int -> Provider.Options
judgeOptions seed maxTokens =
    { temperature = Just 0.0
    , seed = Just seed
    , maxTokens = Just maxTokens
    , adapter = Nothing
    }


-- One judge call through the journal: an entry for the same judge identity,
-- version and prompt is the answer; otherwise the judge is asked and its
-- answer recorded. Two runs that race on one entry both keep the first
-- answer written.
journalled : JudgeCtx -> Int -> Int -> List Message -> Task Error String
journalled ctx seed maxTokens prompt =
    case ctx.judge of

        Judge j ->
            let
                key =
                    Crypto.sha256
                        (String.join
                            "\n"
                            [ ctx.identity
                            , j.version
                            , String.fromInt seed
                            , String.fromInt maxTokens
                            , JsonE.encode 0 (JsonE.list messageValue prompt)
                            ])
                ask =
                    Provider.chatWith
                        (judgeOptions seed maxTokens)
                        j.provider
                        prompt
                        |> Task.andThen
                               (\r ->
                                   remember ctx key r.content
                                       |> Task.map (\_ -> r.content))
            in
                Db.query
                    ctx.db
                    "SELECT reply FROM _sky_ai_eval_judge_journal WHERE entry_key = ?"
                    [ SqlString key ]
                    |> Task.andThen
                           (\rows ->
                               case List.head rows of

                                   Just row ->
                                       Task.succeed (Db.getString "reply" row)

                                   Nothing ->
                                       ask)


remember : JudgeCtx -> String -> String -> Task Error ()
remember ctx key reply =
    Time.now ()
        |> Task.andThen
               (\now ->
                   Db.exec
                       ctx.db
                       "INSERT INTO _sky_ai_eval_judge_journal (entry_key, judge, reply, created_at) VALUES (?, ?, ?, ?)"
                       [ SqlString key
                       , SqlString (judgeVersion ctx.judge)
                       , SqlString reply
                       , SqlInt now
                       ]
                       |> Task.map (\_ -> ())
                       |> Task.onError (\_ -> Task.succeed ()))


messageValue : Message -> JsonE.Value
messageValue m =
    JsonE.object
        [ ( "role", JsonE.string m.role )
        , ( "content", JsonE.string m.content )
        ]


-- The judge's identity: its slot's resolved target, model and adapter (no
-- secret, no URL path), or "" for a judge on a plain provider.
judgeIdentity : Judge -> Task Error String
judgeIdentity (Judge j) =
    case j.slot of

        Just slot ->
            Endpoint.describe slot
                |> Task.map
                       (\d ->
                           String.join
                               "|"
                               (d.slot :: d.mode :: d.target
                                   :: List.filterMap
                                          (\st ->
                                              if st.key == "MODEL"
                                                  || st.key == "ADAPTER" then
                                                  Just
                                                      (st.key ++ "=" ++ st.value)

                                              else
                                                  Nothing)
                                          d.settings))

        Nothing ->
            Task.succeed ""


-- The score is `SCORE: <1-5>` anywhere in the reply, or, when the label is
-- missing, a reply that starts with a single digit 1 to 5 (`5`, `4 - polite`):
-- small judge models often drop the label. A reply such as `10/10` or `No.`
-- has no score.
readJudge : Int -> String -> Score
readJudge passAt reply =
    let
        labelled = Regex.find "SCORE:\\s*[1-5]" (String.toUpper reply)
        bare = Regex.find "^\\s*[1-5](\\D|$)" reply
        found =
            case labelled of

                Just f ->
                    Just (String.right 1 f)

                Nothing ->
                    Maybe.map (\b -> String.left 1 (String.trim b)) bare
    in
        case found of

            Just digit ->
                let
                    n = Maybe.withDefault 1 (String.toInt digit)
                in
                    { value = intToFloat (n - 1) / 4.0
                    , passed = n >= passAt
                    , reason =
                        "judge " ++ String.fromInt n ++ "/5: "
                            ++ clip (String.trim reply)
                    }

            Nothing ->
                { value = 0.0
                , passed = False
                , reason = "the judge gave no SCORE: " ++ quote (clip reply)
                }


-- ── Calibration ─────────────────────────────────────────────────────
-- | Calibrate a judge on its labelled cases (`withCalibration`): ask the
-- judge about each one, compare its verdict with the label, and report the
-- agreement. The calls go through the judge journal, so calibrating an
-- unchanged judge again costs nothing. A judge with no labelled cases fails
-- with `InvalidSetting`.
calibrate : Db -> Judge -> Task Error Calibration
calibrate db (Judge j) =
    if List.isEmpty j.labelled then
        Task.fail
            (Failure.toError
                (InvalidSetting
                    { setting = "calibration"
                    , reason =
                        "the judge has no labelled cases; give it Eval.withCalibration"
                    }))

    else
        setup db |> Task.andThen (\_ -> judgeIdentity (Judge j))
            |> Task.andThen
                   (\identity ->
                       calibrateWith
                           { judge = Judge j, db = db, identity = identity })


calibrateWith : JudgeCtx -> Task Error Calibration
calibrateWith ctx =
    case ctx.judge of

        Judge j ->
            j.labelled
                |> List.map
                       (\l ->
                           judgeScore
                               ctx
                               42
                               [ Provider.user l.question ]
                               l.rubric
                               l.answer
                               |> Task.map (\sc -> ( l, sc )))
                |> Task.sequence
                |> Task.map (calibrationOf j.version j.minAgreement)


calibrationOf : String -> Float -> List ( Labelled, Score ) -> Calibration
calibrationOf version minAgreement verdicts =
    let
        count p = List.length (List.filter p verdicts)
        n = List.length verdicts
        tp = count (\( l, sc ) -> l.passes && sc.passed)
        tn = count (\( l, sc ) -> not l.passes && not sc.passed)
        fp = count (\( l, sc ) -> not l.passes && sc.passed)
        fn = count (\( l, sc ) -> l.passes && not sc.passed)
        agreement = ratio (tp + tn) n
        labelYes = ratio (tp + fn) n
        judgeYes = ratio (tp + fp) n
        chance = labelYes * judgeYes + (1.0 - labelYes) * (1.0 - judgeYes)
        kappa =
            if n == 0 then
                0.0

            else if chance >= 1.0 then
                if agreement >= 1.0 then
                    1.0

                else
                    0.0

            else
                (agreement - chance) / (1.0 - chance)
    in
        { judge = version
        , cases = n
        , agreed = tp + tn
        , agreement = agreement
        , kappa = kappa
        , truePass = tp
        , trueFail = tn
        , falsePass = fp
        , falseFail = fn
        , minAgreement = minAgreement
        , calibrated = n > 0 && agreement >= minAgreement
        , disagreements =
            verdicts |> List.filter (\( l, sc ) -> l.passes /= sc.passed)
                |> List.map
                       (\( l, sc ) ->
                           { id = l.id
                           , label = l.passes
                           , verdict = sc.passed
                           , reason = sc.reason
                           })
        }

-- ── Pairwise judging ────────────────────────────────────────────────
-- | One paired case: the winner (`"candidate"`, `"baseline"` or `"tie"`) and
-- what the judge said in each order (`first`: the baseline shown as A,
-- `second`: the candidate shown as A). `"unclear"` is an answer without a
-- `WINNER:` line.
type alias PairResult =
    { id : String
    , sample : Int
    , winner : String
    , first : String
    , second : String
    }

-- | A pairwise comparison of two reports' answers. A case counts as a win
-- only when the judge picked the same answer in both orders; a judge that
-- changes its mind with the order gives a tie. `winRate` is the candidate's
-- wins plus half the ties, over the pairs; `unclear` counts pairs where an
-- answer had no verdict.
type alias Pairwise =
    { suite : String
    , baseline : String
    , candidate : String
    , judge : String
    , pairs : Int
    , candidateWins : Int
    , baselineWins : Int
    , ties : Int
    , unclear : Int
    , winRate : Float
    , cases : List PairResult
    }


-- | Compare a baseline report (first) and a candidate report (second) with
-- the judge, against a rubric. Cases are paired by id and sample, as in
-- `compare`; a case that failed its call in either report is left out. The
-- suite gives each case's question. Every judge call goes through the judge
-- journal.
pairwise : Db -> Judge -> String -> Suite input -> Report -> Report -> Task Error Pairwise
pairwise db j rubric (Suite s) base cand =
    let
        key c = c.id ++ "#" ++ String.fromInt c.sample
        questionOf id =
            List.find (\c -> c.id == id) s.cases
                |> Maybe.map (\c -> lastUserText (s.prompt c.input))
                |> Maybe.withDefault ""
        paired =
            List.filterMap
                (\c ->
                    case List.find (\b -> key b == key c) base.cases of

                        Just b ->
                            if b.error == Nothing && c.error == Nothing then
                                Just ( questionOf c.id, b, c )

                            else
                                Nothing

                        Nothing ->
                            Nothing)
                cand.cases
    in
        setup db |> Task.andThen (\_ -> judgeIdentity j)
            |> Task.andThen
                   (\identity ->
                       paired
                           |> List.map
                                  (judgePair
                                      { judge = j
                                      , db = db
                                      , identity = identity
                                      }
                                      rubric
                                      s.seed)
                           |> Task.sequence)
            |> Task.map
                   (pairwiseOf
                       s.name
                       base.candidate
                       cand.candidate
                       (judgeVersion j))


judgePair : JudgeCtx -> String -> Int -> ( String, CaseResult, CaseResult ) -> Task Error PairResult
judgePair ctx rubric seed ( question, b, c ) =
    let
        ask first second =
            journalled
                ctx
                seed
                64
                (pairPrompt (judgeVersion ctx.judge) rubric question first second)
                |> Task.map readWinner
    in
        Task.map2
            (\one two ->
                let
                    firstSays = winnerName one "baseline" "candidate"
                    secondSays = winnerName two "candidate" "baseline"
                in
                    { id = b.id
                    , sample = b.sample
                    , winner =
                        if firstSays == secondSays && firstSays /= "unclear" then
                            firstSays

                        else
                            "tie"
                    , first = firstSays
                    , second = secondSays
                    })
            (ask b.output c.output)
            (ask c.output b.output)


pairPrompt : String -> String -> String -> String -> String -> List Message
pairPrompt version rubric question a b =
    [ Provider.system
          ("You are a strict evaluator (" ++ version
              ++ "). Compare RESPONSE A and RESPONSE B against the RUBRIC for the QUESTION. "
              ++ "Reply with one line: WINNER: A, WINNER: B or WINNER: TIE - <one short reason>.")
    , Provider.user
          ("RUBRIC:\n" ++ rubric ++ "\n\nQUESTION:\n" ++ question
              ++ "\n\nRESPONSE A:\n"
              ++ a
              ++ "\n\nRESPONSE B:\n"
              ++ b)
    ]


-- "A", "B", "TIE", or "" for an answer without a verdict.
readWinner : String -> String
readWinner reply =
    case Regex.find "WINNER:\\s*(TIE|A|B)" (String.toUpper reply) of

        Just found ->
            if String.endsWith "TIE" found then
                "TIE"

            else
                String.right 1 found

        Nothing ->
            ""


winnerName : String -> String -> String -> String
winnerName verdict ifA ifB =
    if verdict == "A" then
        ifA

    else if verdict == "B" then
        ifB

    else if verdict == "TIE" then
        "tie"

    else
        "unclear"


pairwiseOf : String -> String -> String -> String -> List PairResult -> Pairwise
pairwiseOf suiteName baseName candName version results =
    let
        count w = List.length (List.filter (\r -> r.winner == w) results)
        n = List.length results
        ties = count "tie"
    in
        { suite = suiteName
        , baseline = baseName
        , candidate = candName
        , judge = version
        , pairs = n
        , candidateWins = count "candidate"
        , baselineWins = count "baseline"
        , ties = ties
        , unclear =
            List.length
                (List.filter
                    (\r -> r.first == "unclear" || r.second == "unclear")
                    results)
        , winRate =
            if n == 0 then
                0.0

            else
                (intToFloat (count "candidate") + 0.5 * intToFloat ties)
                    / intToFloat n
        , cases = results
        }


lastUserText : List Message -> String
lastUserText messages =
    messages |> List.filter (\m -> m.role == "user") |> List.reverse
        |> List.head
        |> Maybe.map .content
        |> Maybe.withDefault ""


-- ── Aggregation ─────────────────────────────────────────────────────
buildReport : String -> Suite input -> Maybe Calibration -> Int -> Int -> List CaseResult -> Report
buildReport candidate (Suite s) cal started duration results =
    let
        errors =
            List.length (List.filter (\r -> r.error /= Nothing) results)
        passed = List.length (List.filter .passed results)
        total = List.length results
        costs = List.filterMap .cost results
    in
        { suite = s.name
        , candidate = candidate
        , seed = s.seed
        , samples = s.samples
        , judge =
            if List.any (\c -> hasRubric c.expect) s.cases then
                Just (judgeVersion (judgeFor (Suite s)))

            else
                Nothing
        , startedAt = started
        , durationMs = duration
        , cases = results
        , passed = passed
        , failed = total - passed
        , errors = errors
        , passRate = ratio passed total
        , scorers = scorerScores results
        , p95LatencyMs = percentile 95 (List.map .latencyMs results)
        , meanCost = meanMoney costs
        , latencyBudgetMs = s.latencyBudgetMs
        , costBudget = s.costBudget
        , calibration = cal
        , digest = digestOf s.name candidate s.seed results
        }


hasRubric : Expect -> Bool
hasRubric e =
    case e of

        Rubric _ ->
            True

        AllOf es ->
            List.any hasRubric es

        _ ->
            False


scorerScores : List CaseResult -> List ScorerScore
scorerScores results =
    let
        pairs = List.concatMap .scores results
        names = uniqueSorted (List.map (\( n, _ ) -> n) pairs)
    in
        List.map
            (\n ->
                let
                    vs =
                        List.filterMap
                            (\( m, v ) ->
                                if m == n then
                                    Just v

                                else
                                    Nothing)
                            pairs
                in
                    { scorer = n, mean = mean vs, count = List.length vs })
            names


digestOf : String -> String -> Int -> List CaseResult -> String
digestOf name candidate seed results =
    let
        lines =
            results
                |> List.sortBy
                       (\r ->
                           r.id ++ "#"
                               ++ String.padLeft 6 '0' (String.fromInt r.sample))
                |> List.map
                       (\r ->
                           r.id ++ "#" ++ String.fromInt r.sample ++ "="
                               ++ Crypto.sha256 r.output)
    in
        String.left
            16
            (Crypto.sha256
                (String.join
                    "\n"
                    (name :: candidate :: String.fromInt seed :: lines)))


-- ── Persistence and the console ─────────────────────────────────────
store : Db -> Report -> Task Error ()
store db r =
    Db.exec
        db
        ("INSERT INTO _sky_ai_eval_runs "
            ++ "(digest, suite, candidate, passed, failed, errors, pass_rate, p95_latency_ms, report, created_at, console) "
            ++ "VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)")
        [ SqlString r.digest
        , SqlString r.suite
        , SqlString r.candidate
        , SqlInt r.passed
        , SqlInt r.failed
        , SqlInt r.errors
        , SqlString (String.fromFloat r.passRate)
        , SqlInt r.p95LatencyMs
        , SqlString (JsonE.encode 0 (reportValue r))
        , SqlInt r.startedAt
        , SqlString (JsonE.encode 0 (consoleValue r))
        ]
        |> Task.andThen (\_ -> recordConsole (JsonE.encode 0 (consoleValue r)))


recordConsole : String -> Task Error ()
recordConsole =
    Ffi.kernel "Ai_recordEval"


-- | The runs of a suite in the database, newest first.
history : Db -> String -> Task Error (List RunSummary)
history db suiteName =
    Db.query
        db
        ("SELECT digest, suite, candidate, passed, failed, errors, pass_rate, p95_latency_ms, created_at "
            ++ "FROM _sky_ai_eval_runs WHERE suite = ? ORDER BY created_at DESC")
        [ SqlString suiteName ]
        |> Task.map (List.map summaryOf)


summaryOf : Dict String String -> RunSummary
summaryOf row =
    { digest = Db.getString "digest" row
    , suite = Db.getString "suite" row
    , candidate = Db.getString "candidate" row
    , passed = Db.getInt "passed" row
    , failed = Db.getInt "failed" row
    , errors = Db.getInt "errors" row
    , passRate =
        Maybe.withDefault 0.0 (String.toFloat (Db.getString "pass_rate" row))
    , p95LatencyMs = Db.getInt "p95_latency_ms" row
    , createdAt = Db.getInt "created_at" row
    }


reportValue : Report -> JsonE.Value
reportValue r =
    JsonE.object
        [ ( "suite", JsonE.string r.suite )
        , ( "candidate", JsonE.string r.candidate )
        , ( "seed", JsonE.int r.seed )
        , ( "samples", JsonE.int r.samples )
        , ( "judge", optString r.judge )
        , ( "startedAt", JsonE.int r.startedAt )
        , ( "durationMs", JsonE.int r.durationMs )
        , ( "passed", JsonE.int r.passed )
        , ( "failed", JsonE.int r.failed )
        , ( "errors", JsonE.int r.errors )
        , ( "passRate", JsonE.float r.passRate )
        , ( "p95LatencyMs", JsonE.int r.p95LatencyMs )
        , ( "meanCost", optString (Maybe.map moneyText r.meanCost) )
        , ( "latencyBudgetMs", optInt r.latencyBudgetMs )
        , ( "costBudget", optString (Maybe.map moneyText r.costBudget) )
        , ( "calibration"
          , case r.calibration of

                Just c ->
                    calibrationValue c

                Nothing ->
                    JsonE.null
          )
        , ( "digest", JsonE.string r.digest )
        , ( "scorers", JsonE.list scorerValue r.scorers )
        , ( "cases", JsonE.list caseValue r.cases )
        ]


calibrationValue : Calibration -> JsonE.Value
calibrationValue c =
    JsonE.object
        [ ( "judge", JsonE.string c.judge )
        , ( "cases", JsonE.int c.cases )
        , ( "agreed", JsonE.int c.agreed )
        , ( "agreement", JsonE.float c.agreement )
        , ( "kappa", JsonE.float c.kappa )
        , ( "truePass", JsonE.int c.truePass )
        , ( "trueFail", JsonE.int c.trueFail )
        , ( "falsePass", JsonE.int c.falsePass )
        , ( "falseFail", JsonE.int c.falseFail )
        , ( "minAgreement", JsonE.float c.minAgreement )
        , ( "calibrated", JsonE.bool c.calibrated )
        , ( "disagreements"
          , JsonE.list
                (\d ->
                    JsonE.object
                        [ ( "id", JsonE.string d.id )
                        , ( "label", JsonE.bool d.label )
                        , ( "verdict", JsonE.bool d.verdict )
                        , ( "reason", JsonE.string d.reason )
                        ])
                c.disagreements
          )
        ]


optInt : Maybe Int -> JsonE.Value
optInt m =
    case m of

        Just n ->
            JsonE.int n

        Nothing ->
            JsonE.null


-- | A report as JSON text: every field, so `decodeReport` reads the same
-- report back. The registry stores attached reports in this form.
encodeReport : Report -> String
encodeReport r =
    JsonE.encode 0 (reportValue r)


-- | A report from the JSON `encodeReport` wrote. A report written before a
-- field existed reads that field as absent.
decodeReport : String -> Result Error Report
decodeReport text =
    JsonD.decodeString reportDecoder text


apply : JsonD.Decoder a -> JsonD.Decoder (a -> b) -> JsonD.Decoder b
apply da df =
    JsonD.andThen (\f -> JsonD.map f da) df


req : String -> JsonD.Decoder a -> JsonD.Decoder (a -> b) -> JsonD.Decoder b
req name d df =
    apply (JsonD.field name d) df


opt : String -> JsonD.Decoder a -> JsonD.Decoder (Maybe a -> b) -> JsonD.Decoder b
opt name d df =
    apply
        (JsonD.oneOf
            [ JsonD.field
                  name
                  (JsonD.oneOf
                      [ JsonD.map Just d, JsonD.map (\_ -> Nothing) jsonNull ])
            , JsonD.succeed Nothing
            ])
        df


moneyDecoder : JsonD.Decoder Money
moneyDecoder =
    JsonD.andThen
        (\text ->
            case String.split " " (String.trim text) of

                [ c, amount ] ->
                    case Money.fromString (Money.parseCurrency c) amount of

                        Ok m ->
                            JsonD.succeed m

                        Err _ ->
                            JsonD.fail ("not an amount: " ++ text)

                _ ->
                    JsonD.fail ("not an amount: " ++ text))
        JsonD.string


reportDecoder : JsonD.Decoder Report
reportDecoder =
    JsonD.succeed Report |> req "suite" JsonD.string
        |> req "candidate" JsonD.string
        |> req "seed" JsonD.int
        |> req "samples" JsonD.int
        |> opt "judge" JsonD.string
        |> req "startedAt" JsonD.int
        |> req "durationMs" JsonD.int
        |> req "cases" (JsonD.list caseDecoder)
        |> req "passed" JsonD.int
        |> req "failed" JsonD.int
        |> req "errors" JsonD.int
        |> req "passRate" JsonD.float
        |> req "scorers" (JsonD.list scorerDecoder)
        |> req "p95LatencyMs" JsonD.int
        |> opt "meanCost" moneyDecoder
        |> opt "latencyBudgetMs" JsonD.int
        |> opt "costBudget" moneyDecoder
        |> opt "calibration" calibrationDecoder
        |> req "digest" JsonD.string


scorerDecoder : JsonD.Decoder ScorerScore
scorerDecoder =
    JsonD.map3
        (\n m c -> { scorer = n, mean = m, count = c })
        (JsonD.field "scorer" JsonD.string)
        (JsonD.field "mean" JsonD.float)
        (JsonD.field "count" JsonD.int)


caseDecoder : JsonD.Decoder CaseResult
caseDecoder =
    JsonD.succeed CaseResult |> req "id" JsonD.string |> req "sample" JsonD.int
        |> req "tags" (JsonD.list JsonD.string)
        |> req "passed" JsonD.bool
        |> req "score" JsonD.float
        |> req
               "scores"
               (JsonD.list
                   (JsonD.map2
                       (\n v -> ( n, v ))
                       (JsonD.field "scorer" JsonD.string)
                       (JsonD.field "value" JsonD.float)))
        |> req "reason" JsonD.string
        |> req "output" JsonD.string
        |> req "latencyMs" JsonD.int
        |> opt "cost" moneyDecoder
        |> opt "error" JsonD.string


calibrationDecoder : JsonD.Decoder Calibration
calibrationDecoder =
    JsonD.succeed Calibration |> req "judge" JsonD.string
        |> req "cases" JsonD.int
        |> req "agreed" JsonD.int
        |> req "agreement" JsonD.float
        |> req "kappa" JsonD.float
        |> req "truePass" JsonD.int
        |> req "trueFail" JsonD.int
        |> req "falsePass" JsonD.int
        |> req "falseFail" JsonD.int
        |> req "minAgreement" JsonD.float
        |> req "calibrated" JsonD.bool
        |> req
               "disagreements"
               (JsonD.list
                   (JsonD.map4
                       (\i l v why ->
                           { id = i, label = l, verdict = v, reason = why })
                       (JsonD.field "id" JsonD.string)
                       (JsonD.field "label" JsonD.bool)
                       (JsonD.field "verdict" JsonD.bool)
                       (JsonD.field "reason" JsonD.string)))


scorerValue : ScorerScore -> JsonE.Value
scorerValue s =
    JsonE.object
        [ ( "scorer", JsonE.string s.scorer )
        , ( "mean", JsonE.float s.mean )
        , ( "count", JsonE.int s.count )
        ]


caseValue : CaseResult -> JsonE.Value
caseValue c =
    JsonE.object
        [ ( "id", JsonE.string c.id )
        , ( "sample", JsonE.int c.sample )
        , ( "tags", JsonE.list JsonE.string c.tags )
        , ( "passed", JsonE.bool c.passed )
        , ( "score", JsonE.float c.score )
        , ( "scores"
          , JsonE.list
                (\( n, v ) ->
                    JsonE.object
                        [ ( "scorer", JsonE.string n )
                        , ( "value", JsonE.float v )
                        ])
                c.scores
          )
        , ( "reason", JsonE.string c.reason )
        , ( "output", JsonE.string c.output )
        , ( "latencyMs", JsonE.int c.latencyMs )
        , ( "cost", optString (Maybe.map moneyText c.cost) )
        , ( "error", optString c.error )
        ]


-- The console row: no model output (it can be long and carry user data),
-- only ids, scores and reasons.
consoleValue : Report -> JsonE.Value
consoleValue r =
    JsonE.object
        [ ( "id", JsonE.string r.digest )
        , ( "suite", JsonE.string r.suite )
        , ( "model", JsonE.string r.candidate )
        , ( "seed", JsonE.int r.seed )
        , ( "cases", JsonE.int (List.length r.cases) )
        , ( "passed", JsonE.int r.passed )
        , ( "failed", JsonE.int r.failed )
        , ( "errors", JsonE.int r.errors )
        , ( "passRate", JsonE.float r.passRate )
        , ( "scores"
          , JsonE.object
                (List.map (\s -> ( s.scorer, JsonE.float s.mean )) r.scorers)
          )
        , ( "p95LatencyMs", JsonE.int r.p95LatencyMs )
        , ( "verdict"
          , JsonE.string
                (case check thresholds r of

                    Ok _ ->
                        "passed"

                    Err _ ->
                        "failed")
          )
        , ( "failures"
          , JsonE.list JsonE.string (gateFailures thresholds (alone r))
          )
        , ( "caseResults"
          , JsonE.list
                (\c ->
                    JsonE.object
                        [ ( "id", JsonE.string (caseLabel c) )
                        , ( "passed", JsonE.bool c.passed )
                        , ( "score", JsonE.float c.score )
                        , ( "latencyMs", JsonE.int c.latencyMs )
                        , ( "reason", JsonE.string c.reason )
                        ])
                r.cases
          )
        ]


optString : Maybe String -> JsonE.Value
optString m =
    case m of

        Just s ->
            JsonE.string s

        Nothing ->
            JsonE.null


caseLabel : CaseResult -> String
caseLabel c =
    if c.sample == 0 then
        c.id

    else
        c.id ++ "#" ++ String.fromInt c.sample

-- ── Comparison ──────────────────────────────────────────────────────
-- | One scorer compared across a baseline and a candidate. `ciLow` and
-- `ciHigh` bound the paired mean difference (candidate minus baseline), from
-- a bootstrap with a fixed seed, so the same reports give the same interval.
type alias ScorerDelta =
    { scorer : String
    , baseline : Float
    , candidate : Float
    , delta : Float
    , ciLow : Float
    , ciHigh : Float
    , pairs : Int
    }

-- | A candidate report, with a baseline when there is one. `regressions`
-- counts paired cases the baseline passed and the candidate failed,
-- `improvements` the reverse, and `mcnemarP` is the exact two-sided McNemar
-- p-value over those discordant pairs.
type alias Comparison =
    { candidate : Report
    , baseline : Maybe Report
    , deltas : List ScorerDelta
    , regressions : Int
    , improvements : Int
    , mcnemarP : Float
    }


-- | A candidate on its own: the absolute thresholds apply, the regression
-- ones have nothing to compare.
alone : Report -> Comparison
alone r =
    { candidate = r
    , baseline = Nothing
    , deltas = []
    , regressions = 0
    , improvements = 0
    , mcnemarP = 1.0
    }


-- | Compare a baseline (first) and a candidate (second), pairing cases by
-- id and sample. Pure: the same reports give the same comparison.
compare : Report -> Report -> Comparison
compare base cand =
    let
        paired = pairCases base.cases cand.cases
        regressions =
            List.length
                (List.filter (\( b, c ) -> b.passed && not c.passed) paired)
        improvements =
            List.length
                (List.filter (\( b, c ) -> not b.passed && c.passed) paired)
        names = uniqueSorted ([ "pass" ] ++ scorerNames paired)
    in
        { candidate = cand
        , baseline = Just base
        , deltas = List.map (\n -> scorerDelta cand.seed n paired) names
        , regressions = regressions
        , improvements = improvements
        , mcnemarP = mcnemar regressions improvements
        }


scorerValueOf : String -> CaseResult -> Maybe Float
scorerValueOf name c =
    if name == "pass" then
        Just
            (if c.passed then
                1.0

            else
                0.0)

    else
        lookupScore name c.scores


-- The paired-comparison helpers below recurse over typed lists instead of
-- passing lambdas to the generic `List` functions, whose parameters are
-- erased and narrowed back one by one (doc 14 R1 / R12).
caseKey : CaseResult -> String
caseKey c =
    c.id ++ "#" ++ String.fromInt c.sample


-- Each candidate case with the baseline case of the same id and sample, in
-- candidate order; a candidate case with no baseline is left out.
pairCases : List CaseResult -> List CaseResult -> List ( CaseResult, CaseResult )
pairCases base cands =
    case cands of

        [] ->
            []

        c :: rest ->
            case findCase (caseKey c) base of

                Just b ->
                    [ ( b, c ) ] ++ pairCases base rest

                Nothing ->
                    pairCases base rest


findCase : String -> List CaseResult -> Maybe CaseResult
findCase key cases =
    case cases of

        [] ->
            Nothing

        c :: rest ->
            if caseKey c == key then
                Just c

            else
                findCase key rest


scorerNames : List ( CaseResult, CaseResult ) -> List String
scorerNames paired =
    case paired of

        [] ->
            []

        ( _, c ) :: rest ->
            scoreNames c.scores ++ scorerNames rest


scoreNames : List ( String, Float ) -> List String
scoreNames scores =
    case scores of

        [] ->
            []

        ( n, _ ) :: rest ->
            [ n ] ++ scoreNames rest


lookupScore : String -> List ( String, Float ) -> Maybe Float
lookupScore name scores =
    case scores of

        [] ->
            Nothing

        ( n, v ) :: rest ->
            if n == name then
                Just v

            else
                lookupScore name rest


scorerDelta : Int -> String -> List ( CaseResult, CaseResult ) -> ScorerDelta
scorerDelta seed name paired =
    let
        both =
            List.filterMap
                (\( b, c ) ->
                    case ( scorerValueOf name b, scorerValueOf name c ) of

                        ( Just x, Just y ) ->
                            Just ( x, y )

                        _ ->
                            Nothing)
                paired
        diffs = List.map (\( x, y ) -> y - x) both
        ( lo, hi ) = bootstrap seed diffs
    in
        { scorer = name
        , baseline = mean (List.map (\( x, _ ) -> x) both)
        , candidate = mean (List.map (\( _, y ) -> y) both)
        , delta = mean diffs
        , ciLow = lo
        , ciHigh = hi
        , pairs = List.length both
        }


-- The 95% interval of the mean of `xs`, from 1000 resamples drawn with a
-- linear congruential generator seeded by `seed`.
bootstrap : Int -> List Float -> ( Float, Float )
bootstrap seed xs =
    let
        n = List.length xs
    in
        if n == 0 then
            ( 0.0, 0.0 )

        else
            let
                means =
                    List.sort
                        (resampleMeans
                            xs
                            n
                            1000
                            (modBy 2147483648 (abs seed) + 1)
                            [])
            in
                ( nth 24 means, nth 974 means )


lcgStep : Int -> Int
lcgStep s =
    modBy 2147483648 (s * 1103515245 + 12345)


-- `left` more resample means, each prepended to `acc`.
resampleMeans : List Float -> Int -> Int -> Int -> List Float -> List Float
resampleMeans xs n left st acc =
    if left <= 0 then
        acc

    else
        case resampleSum xs n n st 0.0 of

            ( st2, total ) ->
                resampleMeans
                    xs
                    n
                    (left - 1)
                    st2
                    ([ total / intToFloat n ] ++ acc)


-- The sum of `left` draws with replacement, and the generator state after them.
resampleSum : List Float -> Int -> Int -> Int -> Float -> ( Int, Float )
resampleSum xs n left st acc =
    if left <= 0 then
        ( st, acc )

    else
        let
            st2 = lcgStep st
        in
            resampleSum xs n (left - 1) st2 (acc + nth (modBy n st2) xs)


nth : Int -> List Float -> Float
nth i xs =
    case xs of

        [] ->
            0.0

        x :: rest ->
            if i <= 0 then
                x

            else
                nth (i - 1) rest


-- The exact two-sided McNemar p-value for b and c discordant pairs.
mcnemar : Int -> Int -> Float
mcnemar b c =
    let
        n = b + c
    in
        if n == 0 then
            1.0

        else
            Math.min
                1.0
                (2.0
                    * mcnemarTerms
                          n
                          (Math.min b c)
                          0
                          (intToFloat n * Math.log 0.5)
                          0.0)


-- The binomial tail sum for i = 0 .. k, with log C(n, i) / 2^n carried in
-- `logT` from one term to the next.
mcnemarTerms : Int -> Int -> Int -> Float -> Float -> Float
mcnemarTerms n k i logT acc =
    if i > k then
        acc

    else
        mcnemarTerms
            n
            k
            (i + 1)
            (logT + Math.log (intToFloat (n - i)) - Math.log (intToFloat (i + 1)))
            (acc + Math.exp logT)

-- ── Thresholds and the gate ─────────────────────────────────────────
-- | The rules `gate` applies. Build them from `thresholds` with the
-- `with…` builders.
type Thresholds
    = Thresholds { minPassRate : Maybe Float
, floors : List ( String, Float )
, maxRegression : Float
, calibratedJudge : Bool
}


-- | No pass-rate floor, no scorer floors, and an allowed regression of 0.05
-- (the lower bound of a scorer's paired difference may not fall below -0.05).
-- The suite's latency and cost budgets always apply.
thresholds : Thresholds
thresholds =
    Thresholds
        { minPassRate = Nothing
        , floors = []
        , maxRegression = 5.0e-2
        , calibratedJudge = False
        }


-- | The lowest pass rate, from 0 to 1.
withMinPassRate : Float -> Thresholds -> Thresholds
withMinPassRate x (Thresholds t) =
    Thresholds { t | minPassRate = Just x }


-- | The lowest mean of one scorer (`"exact"`, `"judge"`, a custom name, or
-- `"pass"` for the pass rate).
withFloor : String -> Float -> Thresholds -> Thresholds
withFloor scorer x (Thresholds t) =
    Thresholds { t | floors = t.floors ++ [ ( scorer, x ) ] }


-- | The largest allowed drop of a scorer against the baseline, measured at
-- the lower bound of the paired difference's 95% interval.
withMaxRegression : Float -> Thresholds -> Thresholds
withMaxRegression x (Thresholds t) =
    Thresholds { t | maxRegression = max 0.0 x }


-- | Require a calibrated judge: a report that scored `Rubric` cases with a
-- judge that has no labelled cases (`withCalibration`) fails the gate. A
-- judge that has them and fell below its agreement always fails it.
withCalibratedJudge : Thresholds -> Thresholds
withCalibratedJudge (Thresholds t) =
    Thresholds { t | calibratedJudge = True }

-- | Proof that a candidate passed a gate. Only `gate` and `check` make one, so
-- a function that requires a `Passed` cannot run without a passing evaluation.
type Passed
    = Passed { suite : String, candidate : String, digest : String }


-- | The suite the passing report ran.
passedSuite : Passed -> String
passedSuite (Passed p) =
    p.suite


-- | The candidate the passing report named (`Registry.label v` for a
-- registry version).
passedCandidate : Passed -> String
passedCandidate (Passed p) =
    p.candidate


-- | The digest of the report that passed.
passedDigest : Passed -> String
passedDigest (Passed p) =
    p.digest


-- | Apply the thresholds. It fails when the pass rate or a scorer's mean is
-- below its floor, when a scorer regressed beyond the allowed drop against the
-- baseline, when the p95 latency or the mean cost is over the suite's
-- budget, or when the judge failed its calibration. The failure is `Std.Ai.Failure.GateFailed`, which names every reason.
gate : Thresholds -> Comparison -> Result Error Passed
gate t cmp =
    case gateFailures t cmp of

        [] ->
            Ok
                (Passed
                    { suite = cmp.candidate.suite
                    , candidate = cmp.candidate.candidate
                    , digest = cmp.candidate.digest
                    })

        reasons ->
            Err
                (Failure.toError
                    (GateFailed
                        { suite = cmp.candidate.suite
                        , reasons = String.join "; " reasons
                        }))


-- | `gate` for a report on its own.
check : Thresholds -> Report -> Result Error Passed
check t r =
    gate t (alone r)


gateFailures : Thresholds -> Comparison -> List String
gateFailures (Thresholds t) cmp =
    let
        r = cmp.candidate
        passRate =
            case t.minPassRate of

                Just floor ->
                    if r.passRate < floor then
                        [ "pass rate " ++ pct r.passRate ++ " is below "
                              ++ pct floor
                        ]

                    else
                        []

                Nothing ->
                    []
        floors =
            List.filterMap
                (\( name, floor ) ->
                    let
                        value =
                            if name == "pass" then
                                Just r.passRate

                            else
                                List.find (\s -> s.scorer == name) r.scorers
                                    |> Maybe.map .mean
                    in
                        case value of

                            Just v ->
                                if v < floor then
                                    Just
                                        (name ++ " " ++ fixed v
                                            ++ " is below its floor "
                                            ++ fixed floor)

                                else
                                    Nothing

                            Nothing ->
                                Just
                                    (name
                                        ++ " has no score in this run (its floor is "
                                        ++ fixed floor
                                        ++ ")"))
                t.floors
        regressions =
            List.filterMap
                (\d ->
                    if d.pairs > 0 && d.ciLow < 0.0 - t.maxRegression then
                        Just
                            (d.scorer ++ " regressed: " ++ fixed d.baseline
                                ++ " -> "
                                ++ fixed d.candidate
                                ++ " (95% interval of the change "
                                ++ fixed d.ciLow
                                ++ " to "
                                ++ fixed d.ciHigh
                                ++ ", allowed drop "
                                ++ fixed t.maxRegression
                                ++ ")")

                    else
                        Nothing)
                cmp.deltas
        latency =
            case r.latencyBudgetMs of

                Just budget ->
                    if r.p95LatencyMs > budget then
                        [ "p95 latency " ++ String.fromInt r.p95LatencyMs
                              ++ " ms is over the budget "
                              ++ String.fromInt budget
                              ++ " ms"
                        ]

                    else
                        []

                Nothing ->
                    []
        cost =
            case ( r.costBudget, r.meanCost ) of

                ( Just budget, Just m ) ->
                    if Money.gt m budget then
                        [ "mean cost " ++ moneyText m ++ " is over the budget "
                              ++ moneyText budget
                        ]

                    else
                        []

                ( Just budget, Nothing ) ->
                    [ "the suite has a cost budget (" ++ moneyText budget
                          ++ ") and no price book; add withPriceBook"
                    ]

                _ ->
                    []
        calibration =
            case r.calibration of

                Just c ->
                    if c.calibrated then
                        []

                    else
                        [ "the judge " ++ c.judge
                              ++ " failed calibration: it agreed with "
                              ++ String.fromInt c.agreed
                              ++ " of "
                              ++ String.fromInt c.cases
                              ++ " labelled cases ("
                              ++ pct c.agreement
                              ++ "), below "
                              ++ pct c.minAgreement
                        ]

                Nothing ->
                    if t.calibratedJudge && r.judge /= Nothing then
                        [ "the judge " ++ Maybe.withDefault "" r.judge
                              ++ " has no calibration; give it Eval.withCalibration"
                        ]

                    else
                        []
    in
        passRate ++ floors ++ regressions ++ latency ++ cost ++ calibration


-- ── Output formats ──────────────────────────────────────────────────
-- | JUnit XML for a CI system: one test case per case and sample, a failure
-- for each failed case and an error for each failed call.
toJunit : Report -> String
toJunit r =
    let
        one c =
            "  <testcase classname=\"" ++ xml r.suite ++ "\" name=\""
                ++ xml (caseLabel c)
                ++ "\" time=\""
                ++ seconds c.latencyMs
                ++ "\">"
                ++ (case c.error of

                       Just e ->
                           "<error message=\"" ++ xml e ++ "\"/>"

                       Nothing ->
                           if c.passed then
                               ""

                           else
                               "<failure message=\"" ++ xml c.reason ++ "\"/>")
                ++ "</testcase>\n"
    in
        "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n" ++ "<testsuite name=\""
            ++ xml r.suite
            ++ "\" tests=\""
            ++ String.fromInt (List.length r.cases)
            ++ "\" failures=\""
            ++ String.fromInt (r.failed - r.errors)
            ++ "\" errors=\""
            ++ String.fromInt r.errors
            ++ "\" time=\""
            ++ seconds r.durationMs
            ++ "\">\n"
            ++ String.join "" (List.map one r.cases)
            ++ "</testsuite>\n"


-- | A Markdown summary of a comparison, for a pull request or a CI log.
toMarkdown : Comparison -> String
toMarkdown cmp =
    let
        r = cmp.candidate
        head =
            "## Eval `" ++ r.suite ++ "`: " ++ r.candidate ++ "\n\n"
                ++ "Pass rate "
                ++ pct r.passRate
                ++ " ("
                ++ String.fromInt r.passed
                ++ " of "
                ++ String.fromInt (List.length r.cases)
                ++ ", "
                ++ String.fromInt r.errors
                ++ " errors). p95 latency "
                ++ String.fromInt r.p95LatencyMs
                ++ " ms. Seed "
                ++ String.fromInt r.seed
                ++ ". Digest `"
                ++ r.digest
                ++ "`.\n\n"
        scorers =
            "| Scorer | Mean | Cases |\n|---|---|---|\n"
                ++ String.join
                       ""
                       (List.map
                           (\s ->
                               "| " ++ s.scorer ++ " | " ++ fixed s.mean
                                   ++ " | "
                                   ++ String.fromInt s.count
                                   ++ " |\n")
                           r.scorers)
        versus =
            case cmp.baseline of

                Just b ->
                    "\nAgainst `" ++ b.candidate ++ "` (digest `" ++ b.digest
                        ++ "`): "
                        ++ String.fromInt cmp.regressions
                        ++ " regressions, "
                        ++ String.fromInt cmp.improvements
                        ++ " improvements, McNemar p = "
                        ++ fixed cmp.mcnemarP
                        ++ ".\n\n| Scorer | Baseline | Candidate | Change | 95% interval |\n|---|---|---|---|---|\n"
                        ++ String.join
                               ""
                               (List.map
                                   (\d ->
                                       "| " ++ d.scorer ++ " | "
                                           ++ fixed d.baseline
                                           ++ " | "
                                           ++ fixed d.candidate
                                           ++ " | "
                                           ++ fixed d.delta
                                           ++ " | "
                                           ++ fixed d.ciLow
                                           ++ " to "
                                           ++ fixed d.ciHigh
                                           ++ " |\n")
                                   cmp.deltas)

                Nothing ->
                    ""
        failing = List.filter (\c -> not c.passed) r.cases
        failures =
            if List.isEmpty failing then
                ""

            else
                "\n### Failed cases\n\n"
                    ++ String.join
                           ""
                           (List.map
                               (\c ->
                                   "- `" ++ caseLabel c ++ "`: " ++ c.reason
                                       ++ "\n")
                               failing)
        calibrated =
            case r.calibration of

                Just c ->
                    "\nJudge `" ++ c.judge ++ "` calibration: agreed with "
                        ++ String.fromInt c.agreed
                        ++ " of "
                        ++ String.fromInt c.cases
                        ++ " labelled cases ("
                        ++ pct c.agreement
                        ++ ", kappa "
                        ++ fixed c.kappa
                        ++ "), "
                        ++ (if c.calibrated then
                               "calibrated"

                           else
                               "below the required " ++ pct c.minAgreement)
                        ++ ".\n"

                Nothing ->
                    ""
    in
        head ++ scorers ++ calibrated ++ versus ++ failures


-- ── Helpers ─────────────────────────────────────────────────────────
mean : List Float -> Float
mean xs =
    case xs of

        [] ->
            0.0

        _ ->
            sumFloats 0.0 xs / intToFloat (List.length xs)


sumFloats : Float -> List Float -> Float
sumFloats acc xs =
    case xs of

        [] ->
            acc

        x :: rest ->
            sumFloats (acc + x) rest


ratio : Int -> Int -> Float
ratio a b =
    if b == 0 then
        0.0

    else
        intToFloat a / intToFloat b


-- Nearest-rank percentile.
percentile : Int -> List Int -> Int
percentile p xs =
    let
        sorted = List.sort xs
        n = List.length sorted
        rank = max 1 ((p * n + 99) // 100)
    in
        if n == 0 then
            0

        else
            List.drop (rank - 1) sorted |> List.head |> Maybe.withDefault 0


meanMoney : List Money -> Maybe Money
meanMoney ms =
    case ms of

        [] ->
            Nothing

        first :: _ ->
            let
                total = List.foldl Money.add (Money.zeroOf first) ms
            in
                case Decimal.div
                         (Money.amount total)
                         (Decimal.fromInt (List.length ms)) of

                    Ok d ->
                        Just (Money.Money d (Money.currency first))

                    Err _ ->
                        Nothing


uniqueSorted : List String -> List String
uniqueSorted xs =
    case List.sort xs of

        [] ->
            []

        x :: rest ->
            [ x ] ++ dropRepeats x rest


-- A sorted list without the entries equal to the one before them.
dropRepeats : String -> List String -> List String
dropRepeats prev xs =
    case xs of

        [] ->
            []

        x :: rest ->
            if x == prev then
                dropRepeats prev rest

            else
                [ x ] ++ dropRepeats x rest


moneyText : Money -> String
moneyText m =
    Money.currencyCode (Money.currency m) ++ " "
        ++ Decimal.toString (Money.amount m)


pct : Float -> String
pct x =
    String.fromInt (Math.round (x * 100.0)) ++ "%"


-- Three decimals, for a table.
fixed : Float -> String
fixed x =
    let
        scaled = Math.round (x * 1000.0)
        sign =
            if scaled < 0 then
                "-"

            else
                ""
        a = abs scaled
    in
        sign ++ String.fromInt (a // 1000) ++ "."
            ++ String.padLeft 3 '0' (String.fromInt (modBy 1000 a))


seconds : Int -> String
seconds ms =
    String.fromInt (ms // 1000) ++ "."
        ++ String.padLeft 3 '0' (String.fromInt (modBy 1000 (abs ms)))


clip : String -> String
clip s =
    if String.length s > 200 then
        String.left 200 s ++ "…"

    else
        s


quote : String -> String
quote s =
    "\"" ++ s ++ "\""


xml : String -> String
xml s =
    s |> String.replace "&" "&amp;" |> String.replace "<" "&lt;"
        |> String.replace ">" "&gt;"
        |> String.replace "\"" "&quot;"


-- An Int as a Float (exact for every Int a report holds).
intToFloat : Int -> Float
intToFloat n =
    case String.toFloat (String.fromInt n) of

        Just f ->
            f

        Nothing ->
            0.0
