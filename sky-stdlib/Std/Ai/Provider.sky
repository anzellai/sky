module Std.Ai.Provider exposing
    ( Provider
    , openai
    , compatible
    , router
    , custom
    , customTools
    , WireTransport
    , wire
    , StreamTransport
    , wireStreaming
    , Message
    , user
    , system
    , assistant
    , Usage
    , ChatResponse
    , chat
    , Options
    , defaultOptions
    , chatWith
    , Stream
    , StreamStep(..)
    , stream
    , read
    , close
    , chatStream
    , embed
    , PriceBook
    , priceBook
    , freePriceBook
    , cost
    , ToolSpec
    , ToolCall
    , ToolResponse
    , Turn(..)
    , chatTools
    )

{-| `Std.Ai.Provider` — a swappable LLM chat backend over `Sky.Core.Http`. The
first adapter is OpenAI-compatible, which is one wire format for hosted OpenAI,
vLLM, llama.cpp, and most gateways, so `compatible` reaches a local model with no
new code. A `Provider` is a value, so a router (a `Provider` that dispatches to
others) drops in anywhere one does.

Every `chat` returns the assistant text AND a typed `Usage` (token counts), and
`cost` prices that usage in `Std.Money` from a versioned `PriceBook` — exact,
never a float, so per-task and per-tenant cost roll-ups are honest.

    provider = Provider.openai (Secret.fromEnv "OPENAI_API_KEY") "gpt-4o-mini"

    Provider.chat provider [ Provider.system "You are terse.", Provider.user "Hi" ]
        |> Task.map (\r -> ( r.content, Provider.cost book r.usage ))
-}

import Sky.Core.Prelude exposing (..)
import Sky.Core.Task as Task exposing (Step(..))
import Sky.Ffi as Ffi
import Sky.Core.Error as Error
import Sky.Core.String as String
import Sky.Core.List as List
import Sky.Core.Result exposing (Result(..))
import Sky.Core.Maybe as Maybe exposing (Maybe(..))
import Sky.Core.Secret as Secret exposing (Secret)
import Sky.Core.Http as Http
import Sky.Core.Json.Encode as JsonE
import Sky.Core.Json.Decode as JsonD
import Std.Codec as Codec exposing (Codec)
import Std.Money as Money exposing (Money)
import Std.Decimal as Decimal

-- ---------------------------------------------------------------------------
-- Provider
-- ---------------------------------------------------------------------------
{-| The bring-your-own backend: the two functions a `custom` provider supplies.
`chat` is mandatory; `chatTools` is how it answers a native tool-calling request
(a `custom` provider with no native wire degrades this to a plain `chat`).
-}
type alias CustomImpl =
    { chat : List Message -> Task Error ChatResponse
    , chatTools : List Turn -> List ToolSpec -> Task Error ToolResponse
    }

{-| How a `wire` provider reaches its server: `post path body` sends one
OpenAI-compatible request body to `path` (relative to the server's `/v1` base,
for example `"/chat/completions"` or `"/embeddings"`) and returns the response
body. A failure is an `Error`, classified by the transport.
-}
type alias WireTransport =
    String -> String -> Task Error String

-- `post what path body`: `what` names the operation ("chat", "chatTools",
-- "embed") for a built-in backend's error message; a `wire` transport ignores
-- it. The built-in backends (`openai`, `compatible`) are a `Wire` too, over
-- `backendPost`, so every operation has one OpenAI-compatible arm.
type alias WireImpl =
    { post : String -> String -> String -> Task Error String
    , model : String
    , stream : Maybe StreamTransport
    }

{-| How a streaming `wire` provider reads an answer as it is written:
`open path body` sends a streaming request and returns a stream id, `next id`
returns the stream's next event, and `close id` ends a stream early. An event
is the JSON `{"delta":"<text>"}` or, last, `{"done":true,"body":"<the
OpenAI chat-completions response, as a JSON string>"}`. -}
type alias StreamTransport =
    { open : String -> String -> Task Error String
    , next : String -> Task Error String
    , close : String -> Task Error ()
    }

type Provider
    = Routed (List Message -> Provider)
    | Custom CustomImpl
    | Wire WireImpl


{-| The hosted OpenAI chat-completions endpoint. -}
openai : Secret -> String -> Provider
openai apiKey model =
    compatible "https://api.openai.com/v1/chat/completions" apiKey model


{-| Any OpenAI-compatible endpoint — a gateway, vLLM, or a local llama.cpp server
(`http://localhost:8080/v1/chat/completions`). Same wire format, so no new code.
-}
compatible : String -> Secret -> String -> Provider
compatible endpoint apiKey model =
    Wire
        { post = \what path body -> backendPost endpoint apiKey what path body
        , model = model
        , stream =
            Just
                { open = \_ body -> streamOpenUrl endpoint apiKey body
                , next = streamNext
                , close = streamClose
                }
        }


{-| A multi-provider ROUTER: a `Provider` that, per call, picks a concrete backend
by a deterministic policy over the messages (task shape, sensitivity, length). It
is itself a `Provider`, so it drops in anywhere one does, and it composes (a route
may return another router). Start with rules; the route decision is a pure
function you can log and later learn from outcomes.

    Provider.router
        (\messages ->
            if sensitive messages then localModel else Provider.openai key "gpt-4o-mini")
-}
router : (List Message -> Provider) -> Provider
router select =
    Routed select


{-| Bring your own backend: wrap any `List Message -> Task Error ChatResponse`
as a `Provider`. This is the extension point for a backend the stdlib does not
ship — a different wire format (Anthropic, Gemini), a proprietary API (the OpenAI
Responses API), a local process, or a test double. The result is an ordinary
`Provider`, so it drops into `router`, `Std.Ai.Agent`, `Policy`, `Trace`, and
`cost` unchanged. Keep provider-specific logic in your own module or a Sky
package; the stdlib stays vendor-neutral.

    myProvider =
        Provider.custom
            (\messages ->
                Http.request theRequest
                    |> Task.andThen decodeToChatResponse)

A `custom` provider has no NATIVE tool-calling wire, so `chatTools` on it
degrades to a plain `chat` that returns no tool calls. Use it with the
prompt-based `Std.Ai.Tool` loop, or `customTools` to implement native calling.
-}
custom : (List Message -> Task Error ChatResponse) -> Provider
custom chatFn =
    Custom
        { chat = chatFn
        , chatTools =
            \turns _tools ->
                chatFn (turnMessages turns)
                    |> Task.map
                           (\r ->
                               { content = r.content
                               , toolCalls = []
                               , usage = r.usage
                               })
        }


{-| Like `custom`, but the provider ALSO implements native tool-calling: supply
both the plain `chat` and a `chatTools` that advertises the tool specs and
returns any `tool_calls` the model requested. Use this for a full peer of the
built-in `openai` provider — a wire format with its own native function-calling
(the OpenAI Responses API, Anthropic tool use, Gemini function calling).
-}
customTools : (List Message -> Task Error ChatResponse) -> (List Turn -> List ToolSpec -> Task Error ToolResponse) -> Provider
customTools chatFn toolsFn =
    Custom { chat = chatFn, chatTools = toolsFn }


{-| An OpenAI-compatible provider over your own transport. The provider builds
and decodes the OpenAI wire format (chat, native tools, embeddings) and hands
each request to `transport path body`. `Std.Ai.Endpoint` and `Std.Ai.Local`
build their providers this way: the transport resolves where the call goes, the
queue and the retries, and the wire stays here.

`model` is the model name sent with each request. An empty `model` lets the
transport fill it in at call time (an `Endpoint` does, from its resolved slot).
-}
wire : WireTransport -> String -> Provider
wire transport model =
    Wire
        { post = \_ path body -> transport path body
        , model = model
        , stream = Nothing
        }


{-| `wire`, with a transport that streams an answer as it is written
(`chatStream`). `Std.Ai.Endpoint`, `Std.Ai.Local` and `Std.Ai.Device` build
their providers this way. -}
wireStreaming : WireTransport -> StreamTransport -> String -> Provider
wireStreaming transport streamTransport model =
    Wire
        { post = \_ path body -> transport path body
        , model = model
        , stream = Just streamTransport
        }


streamOpenUrl : String -> Secret -> String -> Task Error String
streamOpenUrl =
    Ffi.kernel "Ai_streamOpenUrl"


streamNext : String -> Task Error String
streamNext =
    Ffi.kernel "Ai_streamNext"


streamClose : String -> Task Error ()
streamClose =
    Ffi.kernel "Ai_streamClose"

-- ---------------------------------------------------------------------------
-- Messages
-- ---------------------------------------------------------------------------
type alias Message =
    { role : String
    , content : String
    }


user : String -> Message
user content =
    { role = "user", content = content }


system : String -> Message
system content =
    { role = "system", content = content }


assistant : String -> Message
assistant content =
    { role = "assistant", content = content }

-- ---------------------------------------------------------------------------
-- Response + usage
-- ---------------------------------------------------------------------------
type alias Usage =
    { promptTokens : Int
    , completionTokens : Int
    , totalTokens : Int
    }

type alias ChatResponse =
    { content : String
    , usage : Usage
    }

-- ---------------------------------------------------------------------------
-- Options
-- ---------------------------------------------------------------------------
{-| Per-call sampling options. Each field left `Nothing` is not sent, so the
server's own default applies.

  - `temperature`: 0 makes an answer as repeatable as the server allows.
  - `seed`: a fixed seed, for engines that honour one (llama.cpp, vLLM).
  - `maxTokens`: the most tokens the answer may have.
  - `adapter`: a fine-tuned adapter to answer with. It is sent as the request's
    model name, which is how vLLM and an OpenAI-compatible gateway select a
    LoRA adapter. It replaces the provider's model for this call.

A `custom` provider receives only the messages, so it ignores the options.
-}
type alias Options =
    { temperature : Maybe Float
    , seed : Maybe Int
    , maxTokens : Maybe Int
    , adapter : Maybe String
    }


{-| Every option unset: the server's defaults. -}
defaultOptions : Options
defaultOptions =
    { temperature = Nothing
    , seed = Nothing
    , maxTokens = Nothing
    , adapter = Nothing
    }

-- ---------------------------------------------------------------------------
-- chat
-- ---------------------------------------------------------------------------
-- The OpenAI response subset we read. A lenient decoder ignores the other fields
-- (id / object / created / finish_reason / …).
type alias RawMessage =
    { content : String }

type alias RawChoice =
    { message : RawMessage }

type alias RawUsage =
    { prompt_tokens : Int
    , completion_tokens : Int
    , total_tokens : Int
    }

type alias RawResponse =
    { choices : List RawChoice
    , usage : RawUsage
    }


responseCodec : Codec RawResponse
responseCodec =
    Codec.auto
        { choices = [ { message = { content = "" } } ]
        , usage = { prompt_tokens = 0, completion_tokens = 0, total_tokens = 0 }
        }


{-| Send a chat and get the assistant text plus token usage. Fails with a
classified `Error` on a non-2xx response, naming the status and body.
-}
chat : Provider -> List Message -> Task Error ChatResponse
chat provider messages =
    chatWith defaultOptions provider messages


{-| `chat` with per-call `Options` (temperature, seed, max tokens, adapter).

    Provider.chatWith
        { defaultOptions | temperature = Just 0, seed = Just 7 }
        provider
        [ Provider.user "Hi" ]
-}
chatWith : Options -> Provider -> List Message -> Task Error ChatResponse
chatWith opts provider messages =
    case provider of

        Routed select ->
            chatWith opts (select messages) messages

        Custom c ->
            c.chat messages

        Wire w ->
            w.post "chat" "/chat/completions" (chatBody opts w.model messages)
                |> Task.andThen decodeChat

{-| An answer being written, read a piece at a time with `read`. A TEA app
reads it one piece per update:

    Cmd.perform (Provider.stream Provider.defaultOptions assistant messages) Opened

    -- in update
    Opened (Ok s) ->
        ( model, Cmd.perform (Provider.read s) Got )

    Got (Ok (Provider.Piece text next)) ->
        ( { model | answer = model.answer ++ text }, Cmd.perform (Provider.read next) Got )

    Got (Ok (Provider.Finished r)) ->
        ( { model | usage = Just r.usage }, Cmd.none )

A server slot (`Std.Ai.Endpoint`, `Std.Ai.Local`), a built-in backend and a
device slot (`Std.Ai.Device`) stream token by token. A `custom` provider, and
a server that answers a streaming request with one body, give the whole
answer as one piece. -}
type Stream
    = Open StreamTransport String
    | Whole ChatResponse Bool

{-| The next part of a stream: a piece of text and the stream to read next,
or the whole answer with its usage, as `chatWith` returns it. -}
type StreamStep
    = Piece String Stream
    | Finished ChatResponse


{-| Send a chat and start reading its answer as it is written. -}
stream : Options -> Provider -> List Message -> Task Error Stream
stream opts provider messages =
    case provider of

        Routed select ->
            stream opts (select messages) messages

        Custom c ->
            c.chat messages |> Task.map (\r -> Whole r False)

        Wire w ->
            case w.stream of

                Just st ->
                    st.open "/chat/completions" (chatBody opts w.model messages)
                        |> Task.map (Open st)

                Nothing ->
                    w.post
                        "chat"
                        "/chat/completions"
                        (chatBody opts w.model messages)
                        |> Task.andThen decodeChat
                        |> Task.map (\r -> Whole r False)


{-| Read the next piece of a stream. -}
read : Stream -> Task Error StreamStep
read s =
    case s of

        Whole r sent ->
            if sent || r.content == "" then
                Task.succeed (Finished r)

            else
                Task.succeed (Piece r.content (Whole r True))

        Open st id ->
            st.next id
                |> Task.andThen
                       (\ev ->
                           case JsonD.decodeString streamEvent ev of

                               Ok (EvDelta text) ->
                                   Task.succeed (Piece text s)

                               Ok (EvDone body) ->
                                   decodeChat body |> Task.map Finished

                               Err e ->
                                   Task.fail e)


{-| Stop reading a stream before its end (the user left the page, the
answer is long enough). Closing a finished stream does nothing. -}
close : Stream -> Task Error ()
close s =
    case s of

        Open st id ->
            st.close id

        Whole _ _ ->
            Task.succeed ()

type StreamEvent
    = EvDelta String
    | EvDone String


streamEvent : JsonD.Decoder StreamEvent
streamEvent =
    JsonD.oneOf
        [ JsonD.field "delta" JsonD.string |> JsonD.map EvDelta
        , JsonD.field "body" JsonD.string |> JsonD.map EvDone
        ]


{-| `chatWith`, with each piece of the answer handed to `onPiece` as it is
written, in order. The result is the whole answer with its usage. When
`onPiece` fails, the stream is closed and the call fails with that error. Use
it in a Task program or a server handler; a TEA app reads a `stream` one
piece per update instead.

    Provider.chatStream Provider.defaultOptions assistant messages
        (\piece -> Log.print piece)
-}
chatStream : Options -> Provider -> List Message -> (String -> Task Error ()) -> Task Error ChatResponse
chatStream opts provider messages onPiece =
    stream opts provider messages
        |> Task.andThen
               (\s ->
                   Task.loop (streamStep onPiece) s
                       |> Task.onError
                              (\e -> close s |> Task.andThen (\_ -> Task.fail e)))


streamStep : (String -> Task Error ()) -> Stream -> Task Error (Step Stream ChatResponse)
streamStep onPiece s =
    read s
        |> Task.andThen
               (\step ->
                   case step of

                       Piece text next ->
                           onPiece text |> Task.map (\_ -> Loop next)

                       Finished r ->
                           Task.succeed (Done r))


chatBody : Options -> String -> List Message -> String
chatBody opts model messages =
    JsonE.encode
        0
        (JsonE.object
            (List.concat
                [ [ ( "model", JsonE.string (modelFor opts model) )
                  , ( "messages", JsonE.list messageValue messages )
                  ]
                , (case opts.temperature of

                      Just t ->
                          [ ( "temperature", JsonE.float t ) ]

                      Nothing ->
                          [])
                , (case opts.seed of

                      Just n ->
                          [ ( "seed", JsonE.int n ) ]

                      Nothing ->
                          [])
                , (case opts.maxTokens of

                      Just n ->
                          [ ( "max_tokens", JsonE.int n ) ]

                      Nothing ->
                          [])
                ]))


modelFor : Options -> String -> String
modelFor opts model =
    case opts.adapter of

        Just a ->
            a

        Nothing ->
            model


messageValue : Message -> JsonE.Value
messageValue m =
    JsonE.object
        [ ( "role", JsonE.string m.role )
        , ( "content", JsonE.string m.content )
        ]


decodeChat : String -> Task Error ChatResponse
decodeChat body =
    case Codec.fromJson responseCodec body of

        Ok raw ->
            Task.succeed (extract raw)

        Err e ->
            Task.fail e


-- The transport of a built-in backend: `/chat/completions` posts to the
-- configured endpoint, `/embeddings` to the URL derived from it.
backendPost : String -> Secret -> String -> String -> String -> Task Error String
backendPost endpoint apiKey what path body =
    if path == "/embeddings" then
        case embeddingsUrl endpoint of

            Just url ->
                postBackend what url apiKey body

            Nothing ->
                Task.fail
                    (Error.invalidInput
                        ("Provider.embed: cannot derive the embeddings URL from "
                            ++ endpoint
                            ++ " (it does not end with /chat/completions)"))

    else
        postBackend what endpoint apiKey body


-- POST one OpenAI-compatible body to a fixed URL (the built-in backends).
postBackend : String -> String -> Secret -> String -> Task Error String
postBackend what url apiKey body =
    let
        req = Http.defaultRequest url
    in
        { req | method = "POST" } |> Http.withBearer apiKey
            |> Http.withHeader "Content-Type" "application/json"
            |> Http.withBody body
            |> Http.request
            |> Task.andThen
                   (\resp ->
                       if resp.status >= 200 && resp.status < 300 then
                           Task.succeed resp.body

                       else
                           Task.fail
                               (Error.unexpected
                                   (what ++ " failed: HTTP "
                                       ++ String.fromInt resp.status
                                       ++ " — "
                                       ++ resp.body)))


-- ---------------------------------------------------------------------------
-- Embeddings
-- ---------------------------------------------------------------------------
{-| Embed each input text as a vector, in input order, through the server's
OpenAI-compatible `/embeddings` route. A local engine serves embeddings when its
spec has `Local.withEmbeddings`.

A `custom` provider has no embeddings route and fails with `InvalidInput`. A
`router` routes on the inputs as user messages.
-}
embed : Provider -> List String -> Task Error (List (List Float))
embed provider inputs =
    case provider of

        Routed select ->
            embed (select (List.map user inputs)) inputs

        Custom _ ->
            Task.fail
                (Error.invalidInput
                    "Provider.embed: a custom provider has no embeddings route; use Provider.wire for an OpenAI-compatible server")

        Wire w ->
            w.post "embed" "/embeddings" (embedBody w.model inputs)
                |> Task.andThen decodeEmbeddings


embeddingsUrl : String -> Maybe String
embeddingsUrl endpoint =
    if String.endsWith "/chat/completions" endpoint then
        Just (String.dropRight 17 endpoint ++ "/embeddings")

    else
        Nothing


embedBody : String -> List String -> String
embedBody model inputs =
    JsonE.encode
        0
        (JsonE.object
            [ ( "model", JsonE.string model )
            , ( "input", JsonE.list JsonE.string inputs )
            ])


decodeEmbeddings : String -> Task Error (List (List Float))
decodeEmbeddings body =
    case JsonD.decodeString embeddingsDecoder body of

        Ok vs ->
            Task.succeed vs

        Err e ->
            Task.fail e


embeddingsDecoder =
    JsonD.field
        "data"
        (JsonD.list (JsonD.field "embedding" (JsonD.list JsonD.float)))


extract : RawResponse -> ChatResponse
extract raw =
    { content =
        case List.head raw.choices of

            Just ch ->
                ch.message.content

            Nothing ->
                ""
    , usage =
        { promptTokens = raw.usage.prompt_tokens
        , completionTokens = raw.usage.completion_tokens
        , totalTokens = raw.usage.total_tokens
        }
    }

-- ---------------------------------------------------------------------------
-- Native function-calling (OpenAI tools API)
-- ---------------------------------------------------------------------------
{-| A tool the model may call, declared by name + description. Arguments are
free-form JSON the model fills in and the tool parses (matching
`Std.Ai.Tool`'s `exec : String -> Task Error String`). A typed, Codec-derived
parameter schema is a later increment; v1 advertises a permissive object schema.
-}
type alias ToolSpec =
    { name : String
    , description : String
    }

{-| A tool call the model requested: the provider-assigned `id` (echoed back with
the result), the tool `name`, its `arguments` as a JSON string, and an optional
`continuation`.

`continuation` is provider-owned and opaque. A provider sets it when its native
tool loop needs state from this response to continue: the OpenAI Responses API
sets the response id for `previous_response_id`, and a Gemini provider sets the
call's `thoughtSignature`. The value comes back to the same provider on the next
`chatTools` call, inside the `Called` and `Returned` turns. The tool executor
never sees it. A provider with nothing to carry sets `Nothing`, as the built-in
chat-completions backend does.

A `Routed` provider can switch backend between turns, so a provider can receive
a call whose `continuation` another provider set. A provider must check that it
recognises the value, and replay the history when it does not.
-}
type alias ToolCall =
    { id : String
    , name : String
    , arguments : String
    , continuation : Maybe String
    }

{-| A response from `chatTools`: the assistant text (empty when it only called
tools), the tool calls it requested (empty when it answered), and token usage. -}
type alias ToolResponse =
    { content : String
    , toolCalls : List ToolCall
    , usage : Usage
    }

{-| One entry in a tool-calling conversation. `Say` is a plain message; `Called`
echoes the assistant's tool-call request back into history; `Returned` carries a
tool result keyed to the call id. A native tool loop builds `[Say sys, Say user]`,
then appends `Called …` + one `Returned …` per executed tool, and repeats.
-}
type Turn
    = Say Message
    | Called (List ToolCall)
    | Returned ToolCall String


{-| Like `chat`, but advertises `tools` and returns any `tool_calls` the model
requested. Uses the OpenAI native function-calling wire format. Drive the loop
with `Std.Ai.Agent.nativeToolLoop`.
-}
chatTools : Provider -> List Turn -> List ToolSpec -> Task Error ToolResponse
chatTools provider turns tools =
    case provider of

        Routed select ->
            chatTools (select (turnMessages turns)) turns tools

        Custom c ->
            c.chatTools turns tools

        Wire w ->
            w.post
                "chatTools"
                "/chat/completions"
                (JsonE.encode 0 (requestValue w.model turns tools))
                |> Task.andThen decodeToolResponse


decodeToolResponse : String -> Task Error ToolResponse
decodeToolResponse body =
    case JsonD.decodeString toolResponseDecoder body of

        Ok r ->
            Task.succeed r

        Err e ->
            Task.fail e


-- The router policy is a `List Message -> Provider`; project the turns to plain
-- messages so a router can inspect them the same way it inspects a `chat` call.
turnMessages : List Turn -> List Message
turnMessages turns =
    List.filterMap
        (\turn ->
            case turn of

                Say m ->
                    Just m

                Called _ ->
                    Nothing

                Returned _ content ->
                    Just { role = "tool", content = content })
        turns


requestValue model turns tools =
    JsonE.object
        (( "model", JsonE.string model )
            :: ( "messages", JsonE.list turnValue turns )
            :: (if List.isEmpty tools then
                   []

               else
                   [ ( "tools", JsonE.list toolSpecValue tools ) ]))


turnValue turn =
    case turn of

        Say m ->
            JsonE.object
                [ ( "role", JsonE.string m.role )
                , ( "content", JsonE.string m.content )
                ]

        Called calls ->
            JsonE.object
                [ ( "role", JsonE.string "assistant" )
                , ( "content", JsonE.null )
                , ( "tool_calls", JsonE.list toolCallValue calls )
                ]

        Returned call content ->
            JsonE.object
                [ ( "role", JsonE.string "tool" )
                , ( "tool_call_id", JsonE.string call.id )
                , ( "content", JsonE.string content )
                ]


toolCallValue call =
    JsonE.object
        [ ( "id", JsonE.string call.id )
        , ( "type", JsonE.string "function" )
        , ( "function"
          , JsonE.object
                [ ( "name", JsonE.string call.name )
                , ( "arguments", JsonE.string call.arguments )
                ]
          )
        ]


toolSpecValue spec =
    JsonE.object
        [ ( "type", JsonE.string "function" )
        , ( "function"
          , JsonE.object
                [ ( "name", JsonE.string spec.name )
                , ( "description", JsonE.string spec.description )
                , ( "parameters"
                  , JsonE.object [ ( "type", JsonE.string "object" ) ]
                  )
                ]
          )
        ]


toolResponseDecoder =
    JsonD.map3
        (\content calls usage ->
            { content = content, toolCalls = calls, usage = usage })
        (JsonD.oneOf
            [ JsonD.field
                  "choices"
                  (JsonD.index
                      0
                      (JsonD.field "message" (JsonD.field "content" JsonD.string)))
            , JsonD.succeed ""
            ])
        (JsonD.oneOf
            [ JsonD.field
                  "choices"
                  (JsonD.index
                      0
                      (JsonD.field
                          "message"
                          (JsonD.field "tool_calls" (JsonD.list toolCallDecoder))))
            , JsonD.succeed []
            ])
        (JsonD.field "usage" usageDecoder)


toolCallDecoder =
    JsonD.map2
        (\id fn ->
            { id = id
            , name = fn.name
            , arguments = fn.arguments
            , continuation = Nothing
            })
        (JsonD.oneOf [ JsonD.field "id" JsonD.string, JsonD.succeed "" ])
        (JsonD.field
            "function"
            (JsonD.map2
                (\n a -> { name = n, arguments = a })
                (JsonD.field "name" JsonD.string)
                (JsonD.oneOf
                    [ JsonD.field "arguments" JsonD.string, JsonD.succeed "" ])))


usageDecoder =
    JsonD.map3
        (\p c t -> { promptTokens = p, completionTokens = c, totalTokens = t })
        (JsonD.oneOf [ JsonD.field "prompt_tokens" JsonD.int, JsonD.succeed 0 ])
        (JsonD.oneOf
            [ JsonD.field "completion_tokens" JsonD.int, JsonD.succeed 0 ])
        (JsonD.oneOf [ JsonD.field "total_tokens" JsonD.int, JsonD.succeed 0 ])

-- ---------------------------------------------------------------------------
-- Cost
-- ---------------------------------------------------------------------------
{-| Per-1000-token input/output rates for a model, in a currency. Versioned data
so a historical trace prices with the rates that applied then.
-}
type alias PriceBook =
    { inputPer1k : Money
    , outputPer1k : Money
    }


{-| Build a price book from decimal-string rates (e.g. "0.00015" per 1k input
tokens). Returns an error if a rate does not parse.
-}
priceBook : Money.Currency -> String -> String -> Result Error PriceBook
priceBook currency inputRate outputRate =
    case Money.fromString currency inputRate of

        Err e ->
            Err e

        Ok inp ->
            case Money.fromString currency outputRate of

                Err e ->
                    Err e

                Ok out ->
                    Ok { inputPer1k = inp, outputPer1k = out }


{-| A zero-cost book, for a local model or a test. -}
freePriceBook : Money.Currency -> PriceBook
freePriceBook currency =
    { inputPer1k = Money.zero currency, outputPer1k = Money.zero currency }


{-| The money cost of a usage under a price book: tokens/1000 × the per-1k rate,
input and output summed, in `Std.Money` (exact decimal, never a float).
-}
cost : PriceBook -> Usage -> Money
cost book usage =
    Money.add
        (per1k usage.promptTokens book.inputPer1k)
        (per1k usage.completionTokens book.outputPer1k)


per1k : Int -> Money -> Money
per1k tokens rate =
    let
        frac =
            case Decimal.div (Decimal.fromInt tokens) (Decimal.fromInt 1000) of

                Ok d ->
                    d

                Err _ ->
                    Decimal.zero
    in
        Money.mul frac rate
