    ( Rule
    , Report
    , Scrubber
    , email
    , phone
    , cardNumber
    , iban
    , usSsn
    , ukNino
    , secrets
    , pattern
    , custom
    , defaults
    , ruleName
    , scrubText
    , scrubber
    , forString
    , forInstruction
    , forChat
    , forPreference
    , dropIf
    , scrubRow
