-- | Std.Live.Console — the identity an app's console check returns, for
-- `SKY_CONSOLE_AUTH=app` (see `Std.App.withConsoleAuth`).
module Std.Live.Console exposing (Identity, defaultIdentity, withEmail, withClaim, withClaims)

-- With `SKY_CONSOLE_AUTH=app`, the app's own check decides who opens the
-- Sky Console at `/_sky/console`. It has the shape
--
--     check : Request -> Task Error (Maybe Identity)
--
-- and is attached with `App.withConsoleAuth check` (or, in a hand-written
-- Sky.Http.Server app, `Server.setConsoleAuth check` before `listen`).
-- The runtime calls it for a console request that has no console session.
-- `Just identity` with a non-empty `subject` lets the request in, sets the
-- signed `__Host-sky_console` session cookie, and logs
-- `console.auth.allowed` with the subject. `Nothing`, `Err`, a panic or an
-- empty `subject` refuses with 403 and logs `console.auth.denied`.
--
-- Example, reading the app's own session:
--
--     import Std.Live.Console as Console
--
--     adminsOnly : Request -> Task Error (Maybe Console.Identity)
--     adminsOnly req =
--         case Dict.get "session" req.cookies of
--             Just token ->
--                 sessionUser db token
--                     |> Task.map
--                         (\user ->
--                             if user.role == "admin" then
--                                 Just (Console.defaultIdentity user.id |> Console.withEmail user.email)
--
--                             else
--                                 Nothing
--                         )
--
--             Nothing ->
--                 Task.succeed Nothing
--
-- `sessionUser` stands for the app's own session lookup. `claims` carries
-- extra attributes for the audit trail; the gate does not read them, so
-- pass `Dict.empty` (as `defaultIdentity` does) when there are none.

import Sky.Core.Prelude exposing (..)
import Sky.Core.Dict as Dict exposing (Dict)

-- | Identity the console check returns when access is permitted.
-- `subject` is the user's stable identifier (a login, an email, a
-- database id); it must not be empty, or the request is refused.
-- `email` is logged beside it so the audit line is readable. `claims`
-- carries extra attributes for the audit trail.
type alias Identity =
    { subject : String
    , email : String
    , claims : Dict String String
    }


-- | `defaultIdentity "user-42"` — Identity with empty email + claims.
-- Builder chain stays source-compat when v0.16.5+ adds optional fields.
defaultIdentity : String -> Identity
defaultIdentity subject =
    { subject = subject, email = "", claims = Dict.empty }


-- | `withEmail "alice@example.com" id` — replace the audit email.
withEmail : String -> Identity -> Identity
withEmail email id =
    { id | email = email }


-- | `withClaim "role" "admin" id` — add a single RBAC claim.
withClaim : String -> String -> Identity -> Identity
withClaim key value id =
    { id | claims = Dict.insert key value id.claims }


-- | `withClaims (Dict.fromList [("role", "admin"), ("tier", "pro")]) id`
-- — replace the entire claims Dict at once.
withClaims : Dict String String -> Identity -> Identity
withClaims claims id =
    { id | claims = claims }
