-- | Std.App — the unified app builder.
--
-- One `App.app { init, update, view, subscriptions }` describes a program
-- once; the same value runs on every backend. The five `run<Backend>`
-- functions each adapt the single `view : model -> Element msg` to that
-- backend's slot and delegate to the existing kernel entry (Std.Live,
-- Std.Spa, Std.Tui, Std.Cli, Std.Webview) — Std.App *composes* them, it does
-- not reimplement them. The build picks a runner from `--target`
-- (`family[:variant]`); until that lands, call a runner directly:
--
--     main = App.runTui (App.app { init = init, update = update, view = view, subscriptions = subs })
--
-- Config is layered in two pieces (see docs/design/std-app-config-dx.md):
--
--   - [`withBase`] carries the cross-target [`BaseConfig`] (log, database, env).
--   - [`withConfig`] carries a per-target [`Config`] variant whose name matches
--     the `--target` flag family — `WebConfig`, `DesktopConfig`, `TabletConfig`,
--     `MobileConfig`, `TerminalConfig` — each an exposed `*Opts` record you
--     record-update from an exposed `*Defaults`.
--   - Function-valued knobs (`withHead`, `withGuard`, `withOnKey`,
--     `withOnNavigate`) stay builders because they thread `model`/`msg`/`page`.
--
-- Type: `App fallback seed page model msg key`. `fallback` is a phantom
-- capability flag — `withNotFound` flips it to `HasFallback`, and `runLive`
-- (web) requires it, so a web app with no fallback page is a COMPILE error
-- (users never write the type; inference handles it). `seed` is `init`'s
-- argument (Live passes a request record; the native backends pass unit — so a
-- portable app's `init` must NOT read its seed, or it pins `seed` and only
-- builds for `web`). `page` is the routing page type (unconstrained when there
-- are no routes). `key` is the terminal key-event type ([`withOnKey`]);
-- unconstrained until a handler is attached.
--
-- See docs/design/unified-app-builder.md + docs/design/std-app-config-dx.md.
module Std.App exposing
    ( App
    , NoFallback
    , HasFallback
    , BaseConfig
    , Config(..)
    , WebOpts
    , TabletOpts
    , DesktopOpts
    , TerminalOpts
    , MobileOpts
    , app
    , withRoutes
    , withNotFound
    , withWindow
    , withInput
    , withBase
    , withConfig
    , withHead
    , withGuard
    , withOnKey
    , withOnNavigate
    , baseDefaults
    , webDefaults
    , tabletDefaults
    , desktopDefaults
    , terminalDefaults
    , mobileDefaults
    , run
    , runLive
    , runLiveWindow
    , runSpa
    , runTui
    , runCli
    , runWebview
    )

import Sky.Core.Error as Error exposing (Error)
import Sky.Core.List as List
import Sky.Core.String as String
import Sky.Core.Task as Task
import Sky.Core.Time as Time
import Std.Cli as Cli
import Std.Html exposing (Html)
import Std.Live as Live
import Std.Spa as Spa
import Std.Tui as Tui
import Std.Ui as Ui exposing (Element(..))
import Std.Webview as Webview

-- | Phantom capability markers for the `App` `fallback` parameter. `app` starts
-- at `NoFallback`; [`withNotFound`] flips it to `HasFallback`. [`runLive`]
-- (Live/web) requires `HasFallback`, so building a web app with no fallback page
-- is a COMPILE error — the other runners accept either. These carry no data;
-- they exist only in types.
type NoFallback
    = NoFallback

type HasFallback
    = HasFallback

-- | Cross-target config shared by every backend. Plain data — record-update it
-- from [`baseDefaults`] and attach with [`withBase`]. `logFormat` / `logLevel`
-- are simple strings for now (they map to `Sky.Config` later); `database` is an
-- optional DSN; `env` is the environment mode (`"dev"` / `"production"` / …).
type alias BaseConfig =
    { logFormat : String
    , logLevel : String
    , database : Maybe String
    , env : String
    }


-- | The built-in [`BaseConfig`] default. Record-update it: `{ baseDefaults |
-- logLevel = "debug" }`.
baseDefaults : BaseConfig
baseDefaults =
    { logFormat = "text", logLevel = "info", database = Nothing, env = "dev" }

-- | Per-target config. The variant name matches the `--target` flag family, so
-- `--target desktop:mac` tells you to write `DesktopConfig`. Each variant wraps
-- an exposed `*Opts` record — record-update it from the matching `*Defaults` and
-- attach with [`withConfig`]. Data-only: function-valued knobs stay builders.
type Config
    = WebConfig WebOpts
    | DesktopConfig DesktopOpts
    | TabletConfig TabletOpts
    | MobileConfig MobileOpts
    | TerminalConfig TerminalOpts

-- | Web-target (Sky.Live) scalar config. `port` defaults to 8080 and `csrf` to
-- `True`; the `Maybe` fields are unset by default. Maps to `Live.withPort` /
-- `withStatic` / `withStaticUrl` / `withTtl` / `withIdleEvict` /
-- `withMaxBodyBytes` / `withInput` (`inputMode`).
type alias WebOpts =
    { port : Int
    , static : Maybe String
    , staticUrl : Maybe String
    , ttl : Maybe String
    , idleEvict : Maybe String
    , maxBodyBytes : Maybe Int
    , inputMode : Maybe String
    , csrf : Bool
    }


-- | The built-in [`WebOpts`] default.
webDefaults : WebOpts
webDefaults =
    { port = 8080
    , static = Nothing
    , staticUrl = Nothing
    , ttl = Nothing
    , idleEvict = Nothing
    , maxBodyBytes = Nothing
    , inputMode = Nothing
    , csrf = True
    }

-- | Tablet-target config — same Live-backed shape as [`WebOpts`].
type alias TabletOpts =
    WebOpts


-- | The built-in [`TabletOpts`] default (= [`webDefaults`]).
tabletDefaults : TabletOpts
tabletDefaults =
    webDefaults

-- | Desktop-target (Sky.Webview / Live-in-window) config: window `title` +
-- initial `width`/`height`. Defaults: `"Sky"`, 800×600.
type alias DesktopOpts =
    { title : String
    , width : Int
    , height : Int
    }


-- | The built-in [`DesktopOpts`] default.
desktopDefaults : DesktopOpts
desktopDefaults =
    { title = "Sky", width = 800, height = 600 }

-- | Terminal-target (Sky.Tui) config: the logical design canvas in pixels.
-- Defaults: 1280×720. Maps to `Tui.withCanvasWidth` / `withCanvasHeight`.
type alias TerminalOpts =
    { canvasWidth : Int
    , canvasHeight : Int
    }


-- | The built-in [`TerminalOpts`] default.
terminalDefaults : TerminalOpts
terminalDefaults =
    { canvasWidth = 1280, canvasHeight = 720 }

-- | Mobile-target config. Placeholder: no stdlib backend exists yet, so this is
-- seeded minimal (`bundleId`) as future work — the flag already routes to it.
type alias MobileOpts =
    { bundleId : String }


-- | The built-in [`MobileOpts`] default.
mobileDefaults : MobileOpts
mobileDefaults =
    { bundleId = "" }

-- | An app described once, runnable on any backend. Built by [`app`] and
-- refined by the `with…` builders; consumed by a `run<Backend>` runner.
--
-- `fallback` is a phantom capability flag (`NoFallback` / `HasFallback`) — it
-- tracks whether [`withNotFound`] has supplied the fallback page that Live
-- requires; it is not stored in the record. Users never write the `App` type
-- (inference handles the flag); it surfaces only when [`runLive`] rejects an app
-- that lacks a fallback. `key` is the terminal key-event type carried by
-- [`withOnKey`] (unconstrained until attached).
type App fallback seed page model msg key
    = App { init : seed -> ( model, Cmd msg )
, update : msg -> model -> ( model, Cmd msg )
, view : model -> Element msg
, subscriptions : model -> Sub msg
, routes : List ( String, page )
, notFound : Maybe page
, onInput : Maybe (String -> msg)
, base : BaseConfig
, configs : List Config
, head : Maybe (model -> List (Html msg))
, guard : Maybe (msg -> model -> Result Error ())
, onKey : Maybe (key -> msg)
, onNavigate : Maybe (page -> msg)
}


-- | Describe an app from the shared TEA core. Routing, config, and function
-- knobs are added by the `with…` builders below (each is target-relevant and
-- ignored by targets that have no use for it).
app : { init : seed -> ( model, Cmd msg )
, update : msg -> model -> ( model, Cmd msg )
, view : model -> Element msg
, subscriptions : model -> Sub msg
} -> App NoFallback seed page model msg key
app cfg =
    App
        { init = cfg.init
        , update = cfg.update
        , view = cfg.view
        , subscriptions = cfg.subscriptions
        , routes = []
        , notFound = Nothing
        , onInput = Nothing
        , base = baseDefaults
        , configs = []
        , head = Nothing
        , guard = Nothing
        , onKey = Nothing
        , onNavigate = Nothing
        }


-- | Attach URL routes as `(path, page)` pairs (web targets). Pair with
-- [`withNotFound`] — the `web` target requires a fallback page.
withRoutes : List ( String, page ) -> App fallback seed page model msg key -> App fallback seed page model msg key
withRoutes routes (App a) =
    App { a | routes = routes }


-- | Set the fallback page for an unmatched route (web targets).
withNotFound : page -> App fallback seed page model msg key -> App HasFallback seed page model msg key
withNotFound page_ (App a) =
    App { a | notFound = Just page_ }


-- | Set the desktop window title + initial size (desktop targets). Shorthand
-- for a [`DesktopConfig`] via [`withConfig`].
withWindow : String -> Int -> Int -> App fallback seed page model msg key -> App fallback seed page model msg key
withWindow title width height (App a) =
    App { a | configs = DesktopConfig { title = title, width = width, height = height } :: a.configs }


-- | Wire a line/text input handler (terminal targets). The payload is the
-- entered line; a terminal renderer maps its input to it.
withInput : (String -> msg) -> App fallback seed page model msg key -> App fallback seed page model msg key
withInput onLine (App a) =
    App { a | onInput = Just onLine }


-- | Attach the cross-target [`BaseConfig`] (log, database, env). Record-update
-- from [`baseDefaults`].
withBase : BaseConfig -> App fallback seed page model msg key -> App fallback seed page model msg key
withBase base (App a) =
    App { a | base = base }


-- | Attach a per-target [`Config`] variant. Call once per customised target;
-- the variant is prepended to the app's config list and the matching runner
-- reads its own variant (via [`findWeb`] / [`findDesktop`] / [`findTerminal`]),
-- so an app carries only the configs actually provided — not one record per
-- target — keeping the generic builder cheap (docs/design/std-app-config-dx.md
-- §"scalar/function split").
withConfig : Config -> App fallback seed page model msg key -> App fallback seed page model msg key
withConfig cfg (App a) =
    App { a | configs = cfg :: a.configs }


-- | The first [`WebConfig`] (or [`TabletConfig`], Live-backed too) in the app's
-- config list, else [`webDefaults`]. Used by [`runLive`].
findWeb : List Config -> WebOpts
findWeb configs =
    case configs of

        [] ->
            webDefaults

        (WebConfig o) :: _ ->
            o

        (TabletConfig o) :: _ ->
            o

        _ :: rest ->
            findWeb rest


-- | The first [`DesktopConfig`] in the app's config list, else
-- [`desktopDefaults`]. Used by [`runWebview`] / [`runLiveWindow`].
findDesktop : List Config -> DesktopOpts
findDesktop configs =
    case configs of

        [] ->
            desktopDefaults

        (DesktopConfig o) :: _ ->
            o

        _ :: rest ->
            findDesktop rest


-- | The first [`TerminalConfig`] in the app's config list, else
-- [`terminalDefaults`]. Used by [`runTui`].
findTerminal : List Config -> TerminalOpts
findTerminal configs =
    case configs of

        [] ->
            terminalDefaults

        (TerminalConfig o) :: _ ->
            o

        _ :: rest ->
            findTerminal rest


-- | Set the document `<head>` builder (web/desktop targets → `Live.withHead`).
withHead : (model -> List (Html msg)) -> App fallback seed page model msg key -> App fallback seed page model msg key
withHead headFor (App a) =
    App { a | head = Just headFor }


-- | Attach a per-Msg guard — `guard msg model` returns `Err` to reject the
-- message before `update` runs (web + terminal targets → `Live.withGuard` /
-- `Tui.withGuard`).
withGuard : (msg -> model -> Result Error ()) -> App fallback seed page model msg key -> App fallback seed page model msg key
withGuard guard (App a) =
    App { a | guard = Just guard }


-- | Attach a raw key-event handler (terminal target → `Tui.withOnKey`). The
-- key-event type is whatever the handler declares.
withOnKey : (key -> msg) -> App fallback seed page model msg key -> App fallback seed page model msg key
withOnKey onKey (App a) =
    App { a | onKey = Just onKey }


-- | Wire a navigation handler — `onNavigate page` yields a `msg` when the app
-- routes to `page` (web target → `Live.withOnNavigate`).
withOnNavigate : (page -> msg) -> App fallback seed page model msg key -> App fallback seed page model msg key
withOnNavigate onNav (App a) =
    App { a | onNavigate = Just onNav }


-- | The unified entry: `main = App.run app`. The build resolves `--target` and
-- REWRITES this call to the matching `run<Backend>` (so dead-code elimination
-- still prunes the unused backends). You never pick a backend in source — this
-- is the whole point of `Std.App`. When built without a target it defaults to
-- `web` (Sky.Live). The body here is a placeholder the build replaces; it is
-- never the compiled entry.
run : App fallback seed page model msg key -> Task Error ()
run =
    runTui


-- ─── Runners — one per backend, target → runner is resolved by the build ───
-- | Run as server-driven HTML + SSE (`--target web`, = Sky.Live). Requires a
-- fallback page ([`withNotFound`]) because Live routing is total. Folds the
-- accumulated [`WebOpts`] + the `withHead`/`withGuard`/`withOnNavigate` builders
-- into the `Live.config` chain.
runLive : App HasFallback seed page model msg key -> Task Error ()
runLive (App a) =
    case a.notFound of

        Just fallback ->
            let
                w = findWeb a.configs
                base =
                    Live.config
                        { init = a.init
                        , update = a.update
                        , view = \model -> Ui.layout [] (a.view model)
                        , subscriptions = a.subscriptions
                        , routes =
                            List.map
                                (\( path, page_ ) -> Live.route path page_)
                                a.routes
                        , notFound = fallback
                        }
                withStatic_ =
                    case w.static of

                        Just s ->
                            Live.withStatic s base

                        Nothing ->
                            base
                withStaticUrl_ =
                    case w.staticUrl of

                        Just s ->
                            Live.withStaticUrl s withStatic_

                        Nothing ->
                            withStatic_
                withTtl_ =
                    case w.ttl of

                        Just t ->
                            Live.withTtl t withStaticUrl_

                        Nothing ->
                            withStaticUrl_
                withIdle_ =
                    case w.idleEvict of

                        Just t ->
                            Live.withIdleEvict t withTtl_

                        Nothing ->
                            withTtl_
                withMaxBody_ =
                    case w.maxBodyBytes of

                        Just n ->
                            Live.withMaxBodyBytes n withIdle_

                        Nothing ->
                            withIdle_
                withInputMode_ =
                    case w.inputMode of

                        Just m ->
                            Live.withInput m withMaxBody_

                        Nothing ->
                            withMaxBody_
                withPort_ = Live.withPort w.port withInputMode_
                -- TODO(std-app-config): `w.csrf` has no `Std.Live` builder
                -- (CSRF is a `Sky.Config` concern, and `Live.app` takes no
                -- `Sky.Config`), so it is stored but not yet threaded.
                -- TODO(std-app-config): `a.base` (log/database/env) likewise has
                -- no `Live.app` hook yet; it is stored for the boot-time
                -- resolution described in the design (§4) once `Sky.Config` is
                -- wired through.
                withHead_ =
                    case a.head of

                        Just h ->
                            Live.withHead h withPort_

                        Nothing ->
                            withPort_
                withGuard_ =
                    case a.guard of

                        Just g ->
                            Live.withGuard g withHead_

                        Nothing ->
                            withHead_
                withNav_ =
                    case a.onNavigate of

                        Just f ->
                            Live.withOnNavigate f withGuard_

                        Nothing ->
                            withGuard_
            in
                Live.app withNav_

        Nothing ->
            Task.fail
                (Error.invalidInput
                    "target 'web' requires a fallback page — add `|> App.withNotFound <page>`")


-- | Run as a client wasm SPA (`--target web:app` / `mobile:*` / `tablet:*`,
-- = Sky.Spa). Effects auto-split to a backend at build time. Folds only what
-- Spa supports (routes + fallback); web-server-only knobs are ignored.
runSpa : App fallback seed page model msg key -> Task Error ()
runSpa (App a) =
    let
        base =
            Spa.config
                { init = a.init
                , update = a.update
                , view = \model -> Ui.layout [] (a.view model)
                , subscriptions = a.subscriptions
                }
        routed =
            Spa.withRoutes
                (List.map (\( path, page_ ) -> Spa.route path page_) a.routes)
                base
        withFallback =
            case a.notFound of

                Just fallback ->
                    Spa.withNotFound fallback routed

                Nothing ->
                    routed
    in
        Spa.app withFallback


-- | Run as a full-screen terminal UI (`--target terminal:tui`, = Sky.Tui).
-- The `Element` view renders directly to ANSI cells. Folds the [`TerminalOpts`]
-- canvas + the `withOnKey`/`withGuard` builders into the `Tui.config` chain.
runTui : App fallback seed page model msg key -> Task Error ()
runTui (App a) =
    let
        t = findTerminal a.configs
        base =
            Tui.config
                { init = a.init
                , update = a.update
                , view = a.view
                , subscriptions = a.subscriptions
                }
        withW_ = Tui.withCanvasWidth t.canvasWidth base
        withH_ = Tui.withCanvasHeight t.canvasHeight withW_
        withKey_ =
            case a.onKey of

                Just k ->
                    Tui.withOnKey k withH_

                Nothing ->
                    withH_
        withGuard_ =
            case a.guard of

                Just g ->
                    Tui.withGuard g withKey_

                Nothing ->
                    withKey_
    in
        Tui.app withGuard_


-- | Run as a line-based CLI (`--target terminal:cli`, = Sky.Cli). The
-- `Element` view is flattened to text (best-effort — see [`elementToText`]);
-- `Std.Cli.program` stays the escape hatch for a hand-authored `String` view.
runCli : App fallback seed page model msg key -> Task Error ()
runCli (App a) =
    let
        base =
            Cli.config
                { init = a.init
                , update = a.update
                , view = \model -> elementToText (a.view model)
                , subscriptions = a.subscriptions
                }
        withLine =
            case a.onInput of

                Just onLine ->
                    Cli.withOnLine onLine base

                Nothing ->
                    base
    in
        Cli.program withLine


-- | Run as a native desktop window (`--target desktop:<os>` is native wasm; this
-- is the standalone Sky.Webview form). `seed` is pinned to unit. The window is
-- taken from [`withWindow`] / a `DesktopConfig` via [`withConfig`].
runWebview : App fallback () page model msg key -> Task Error ()
runWebview (App a) =
    let
        d = findDesktop a.configs
    in
        Webview.app
            { init = a.init
            , update = a.update
            , view = \model -> Ui.layout [] (a.view model)
            , subscriptions = a.subscriptions
            , window = { title = d.title, size = ( d.width, d.height ) }
            }


-- | Run as **Sky.Live in a native window** (`--target desktop`): serve the Live
-- app AND open a native webview onto it — the desktop delivery of a server-driven
-- app. Requires a fallback page (it runs `runLive`). The window opens shortly
-- after the server starts.
runLiveWindow : App HasFallback seed page model msg key -> Task Error ()
runLiveWindow (App a) =
    let
        d = findDesktop a.configs
    in
        Task.map
            (\_ -> ())
            (Task.parallel
                [ runLive (App a)
                , openLiveWindow_ { title = d.title, size = ( d.width, d.height ) }
                ])


openLiveWindow_ : { title : String
, size : ( Int, Int )
} -> Task Error ()
openLiveWindow_ window =
    Task.andThen
        (\_ -> Webview.url "http://localhost:8000" window)
        (Time.sleep 800)


-- ─── Element → text (best-effort, for terminal:cli) ───
-- | Flatten an `Element` tree to text: `Text` leaves are kept, block children
-- are newline-joined, and `Raw` (an opaque Std.Html node) becomes empty —
-- 2-D layout has no lossless text form, so this is deliberately best-effort.
elementToText : Element msg -> String
elementToText element =
    case element of

        Empty ->
            ""

        Text content ->
            content

        Node _ _ children ->
            joinChildren children

        TaggedNode _ _ _ children ->
            joinChildren children

        Raw _ ->
            ""


joinChildren : List (Element msg) -> String
joinChildren children =
    String.join
        "\n"
        (List.filter (\line -> line /= "") (List.map elementToText children))
