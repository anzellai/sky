-- | Std.App — the unified app builder.
--
-- One `App.app { init, update, view, subscriptions }` describes a program
-- once; the same value runs on every backend. The five `run<Backend>`
-- functions each adapt the single `view : model -> Element msg` to that
-- backend's slot and delegate to the existing kernel entry (Std.Live,
-- Std.Spa, Std.Tui, Std.Cli, Std.Webview) — Std.App *composes* them, it does
-- not reimplement them. The build picks a runner from `--target`
-- (`family[:variant]`); until that lands, call a runner directly:
--
--     main = App.runTui (App.app { init = init, update = update, view = view, subscriptions = subs })
--
-- Config is layered in two pieces (see docs/design/std-app-config-dx.md):
--
--   - [`withBase`] carries the cross-target [`BaseConfig`] (log, database,
--     telemetry), applied at boot via `Sky.Config.apply`.
--   - [`withConfig`] carries a per-target [`Config`] variant whose name matches
--     the `--target` flag family — `WebConfig`, `DesktopConfig`, `TabletConfig`,
--     `MobileConfig`, `TerminalConfig` — each an exposed `*Opts` record you
--     record-update from an exposed `*Defaults`.
--   - Function-valued knobs (`withHead`, `withGuard`, `withOnKey`,
--     `withOnNavigate`) stay builders because they thread `model`/`msg`/`page`.
--
-- Type: `App fallback seed page model msg key`. `fallback` is a phantom
-- capability flag — `withNotFound` flips it to `HasFallback`, and `runLive`
-- (web) requires it, so a web app with no fallback page is a COMPILE error
-- (users never write the type; inference handles it). `seed` is `init`'s
-- argument (Live passes a request record; the native backends pass unit — so a
-- portable app's `init` must NOT read its seed, or it pins `seed` and only
-- builds for `web`). `page` is the routing page type (unconstrained when there
-- are no routes). `key` is the terminal key-event type ([`withOnKey`]);
-- unconstrained until a handler is attached.
--
-- See docs/design/unified-app-builder.md + docs/design/std-app-config-dx.md.
module Std.App exposing
    ( App
    , NoFallback
    , HasFallback
    , BaseConfig
    , Config(..)
    , WebOpts
    , TabletOpts
    , DesktopOpts
    , TerminalOpts
    , MobileOpts
    , app
    , web
    , cli
    , tui
    , route
    , routeParam
    , api
    , spaRoute
    , apiServerRoute
    , withRoutes
    , withNotFound
    , withWindow
    , withInput
    , withBase
    , withConfig
    , withHead
    , withGuard
    , withOnKey
    , withOnNavigate
    , withRequest
    , baseDefaults
    , webDefaults
    , tabletDefaults
    , desktopDefaults
    , terminalDefaults
    , mobileDefaults
    , run
    , runLive
    , runLiveWindow
    , runSpa
    , runTui
    , runCli
    , runWebview
    )

import Sky.Config as Config
import Sky.Core.Error as Error exposing (Error)
import Sky.Core.Http as Http
import Sky.Core.List as List
import Sky.Core.String as String
import Sky.Core.Task as Task
import Sky.Core.Time as Time
import Sky.Ffi as Ffi
import Sky.Http.Server as Server
import Std.Cli as Cli
import Std.Cmd as Cmd
import Std.Html as Html exposing (Html)
import Std.Live as Live
import Std.Spa as Spa
import Std.Tui as Tui
import Std.Ui as Ui exposing (Element(..))
import Std.Webview as Webview

-- | Phantom capability markers for the `App` `fallback` parameter. `app` starts
-- at `NoFallback`; [`withNotFound`] flips it to `HasFallback`. [`runLive`]
-- (Live/web) requires `HasFallback`, so building a web app with no fallback page
-- is a COMPILE error — the other runners accept either. These carry no data;
-- they exist only in types.
type NoFallback
    = NoFallback

type HasFallback
    = HasFallback

-- | Cross-target config shared by every backend. Plain data — record-update it
-- from [`baseDefaults`] and attach with [`withBase`]. The fields are the typed
-- `Sky.Config` values, so import their constructors:
--
--     import Sky.Config as Config exposing (LogFormat(..), LogLevel(..), Database(..))
--
-- `logFormat` / `logLevel` set the structured log; `database` is an optional
-- `Sqlite path` / `Postgres dsn`; `telemetry` an optional OTLP endpoint.
-- (The constructors are NOT re-exported from `Std.App` — the compiler carries a
-- re-exported type name but not its data constructors — so `import Sky.Config`
-- for `Text` / `Debug` / `Sqlite …`.)
--
-- There is deliberately NO `env` field — the environment mode is
-- operator-owned (`ENV=…`), not something the source sets (see `Sky.Config`).
type alias BaseConfig =
    { logFormat : Config.LogFormat
    , logLevel : Config.LogLevel
    , database : Maybe Config.Database
    , telemetry : Maybe Config.Telemetry
    }


-- | The built-in [`BaseConfig`] default. Record-update it (with `Sky.Config`
-- constructors in scope): `{ baseDefaults | logLevel = Debug }`.
baseDefaults : BaseConfig
baseDefaults =
    { logFormat = Config.Text
    , logLevel = Config.Info
    , database = Nothing
    , telemetry = Nothing
    }

-- | Per-target config. The variant name matches the `--target` flag family, so
-- `--target desktop:mac` tells you to write `DesktopConfig`. Each variant wraps
-- an exposed `*Opts` record — record-update it from the matching `*Defaults` and
-- attach with [`withConfig`]. Data-only: function-valued knobs stay builders.
type Config
    = WebConfig WebOpts
    | DesktopConfig DesktopOpts
    | TabletConfig TabletOpts
    | MobileConfig MobileOpts
    | TerminalConfig TerminalOpts

-- | Web-target (Sky.Live) scalar config. `port` defaults to 8080 and `csrf` to
-- `True`; the `Maybe` fields are unset by default. `store` is the session store
-- (`"memory"` / `"sqlite:path"` / `"redis:url"` / `"postgres"`). Maps to
-- `Live.withPort` / `withStore` / `withStatic` / `withStaticUrl` / `withTtl` /
-- `withIdleEvict` / `withMaxBodyBytes` / `withInput` (`inputMode`).
type alias WebOpts =
    { port : Int
    , store : Maybe String
    , static : Maybe String
    , staticUrl : Maybe String
    , ttl : Maybe String
    , idleEvict : Maybe String
    , maxBodyBytes : Maybe Int
    , inputMode : Maybe String
    , analytics : Maybe { pageViews : Bool }
    , csrf : Bool
    }


-- | The built-in [`WebOpts`] default.
webDefaults : WebOpts
webDefaults =
    { port = 8080
    , store = Nothing
    , static = Nothing
    , staticUrl = Nothing
    , ttl = Nothing
    , idleEvict = Nothing
    , maxBodyBytes = Nothing
    , inputMode = Nothing
    , analytics = Nothing
    , csrf = True
    }

-- | Tablet-target config — same Live-backed shape as [`WebOpts`].
type alias TabletOpts =
    WebOpts


-- | The built-in [`TabletOpts`] default (= [`webDefaults`]).
tabletDefaults : TabletOpts
tabletDefaults =
    webDefaults

-- | Desktop-target (Sky.Webview / Live-in-window) config: window `title` +
-- initial `width`/`height`. Defaults: `"Sky"`, 800×600.
type alias DesktopOpts =
    { title : String
    , width : Int
    , height : Int
    }


-- | The built-in [`DesktopOpts`] default.
desktopDefaults : DesktopOpts
desktopDefaults =
    { title = "Sky", width = 800, height = 600 }

-- | Terminal-target (Sky.Tui) config: the logical design canvas in pixels.
-- Defaults: 1280×720. Maps to `Tui.withCanvasWidth` / `withCanvasHeight`.
type alias TerminalOpts =
    { canvasWidth : Int
    , canvasHeight : Int
    }


-- | The built-in [`TerminalOpts`] default.
terminalDefaults : TerminalOpts
terminalDefaults =
    { canvasWidth = 1280, canvasHeight = 720 }

-- | Mobile-target config. Placeholder: no stdlib backend exists yet, so this is
-- seeded minimal (`bundleId`) as future work — the flag already routes to it.
type alias MobileOpts =
    { bundleId : String }


-- | The built-in [`MobileOpts`] default.
mobileDefaults : MobileOpts
mobileDefaults =
    { bundleId = "" }

-- | A URL route. A `page` type erased over static vs parametric so a route list
-- can MIX a nullary page (`route "/" Home`) with a `:param` route whose page is
-- built from the captured segment (`routeParam "/p/:slug" Product`, where
-- `Product : String -> page`). Build them with [`route`] / [`routeParam`] and
-- attach with [`withRoutes`]; the runners lower each to the backend's own route
-- (`Sky.Live` / `Sky.Spa`), which already erase the page type the same way.
type Route page
    = RouteStatic String page
    | RouteParam String (String -> page)
    | RouteApi String (Request -> Task Error Response)


-- | A static route: `route "/about" AboutPage`.
route : String -> page -> Route page
route path page_ =
    RouteStatic path page_


-- | A parametric route: `routeParam "/products/:slug" ProductPage`, where
-- `ProductPage : String -> page` receives the captured `:slug` segment.
routeParam : String -> (String -> page) -> Route page
routeParam path make =
    RouteParam path make


-- | A raw HTTP endpoint alongside the TEA routes: `api "/webhook" handler`,
-- where `handler : Request -> Task Error Response` (JSON/webhook endpoints that
-- return a `Response` directly, not a `page`). Attach it in [`withRoutes`].
-- SERVER-side, for the `web`/`desktop` (Live) targets. The terminal backends
-- drop it; the client (Spa) targets cannot carry it at all — the handler is
-- server-side, so keep raw endpoints in a `web`-target app.
api : String -> (Request -> Task Error Response) -> Route page
api path handler =
    RouteApi path handler

-- | The app's view, held as one of two shapes so both a `Std.Ui` view and a
-- `Std.Html` view can flow through the same `App`. [`app`] wraps a
-- `model -> Element msg` in `ViewUi`; [`web`] wraps a `model -> Html msg` in
-- `ViewHtml`; [`cli`] / [`tui`] wrap a `model -> String` in `ViewString`. The
-- web/desktop/mobile runners render `ViewUi` (adapting via `Ui.layout []`) or
-- `ViewHtml`, and reject a `ViewString` at boot (terminal-only); the terminal
-- runners render `ViewUi` (flattened) or `ViewString` (verbatim), and reject a
-- `ViewHtml`. Internal — not exposed.
type ViewImpl model msg
    = ViewUi (model -> Element msg)
    | ViewHtml (model -> Html msg)
    | ViewString (model -> String)


-- | Render a `ViewUi` value to a page-tall Html document for the web-family
-- backends (Live/Spa/Webview).
--
-- The intended shape is `Ui.layout [] el` — wrap the `Element` in a document.
-- But a user can annotate their view `model -> any` and root it at `Ui.layout`
-- themselves, returning a full `Html` DOCUMENT where an `Element` is expected.
-- `any` + a polymorphic `msg` lets `Html a` unify with `Element msg`, so
-- `sky check` (and `go build`) accept it. Because `Element` and `Html` share
-- ONE Go representation (`rt.SkyADT`), the erasure-boundary `rt.Coerce` is a
-- no-op and the raw `Html` document reaches this point unchanged — then
-- `Ui.layout` re-wraps it, and since Html's `HElement` and Element's `Empty`
-- both lower to Tag 0, the whole document renders as an empty Element (a
-- SILENTLY BLANK page). See `runtime-go/rt/std_app_view.go` for the mechanism.
--
-- [`htmlDocOrDefault_`] discriminates on the runtime constructor NAME (unique
-- across the two ADTs even though their Tags collide): an already-Html document
-- is returned as-is; a genuine `Element` falls through to `Ui.layout [] el` —
-- the behaviour that has always been correct for well-typed views.
renderUiRoot_ : Element msg -> Html.Html msg
renderUiRoot_ el =
    htmlDocOrDefault_ el (Ui.layout [] el)


-- | Normalise an `App.web` (`ViewHtml`) root the SYMMETRIC way. The slot is
-- `Html msg`, so the common case is a genuine Std.Html document — but a view
-- annotated `model -> any` can return a Std.Ui `Element` there (Element/Html
-- share `rt.SkyADT`, so the `any` slot accepts it), and rendering that Element
-- AS Html is silently blank (the twin of the `ViewUi` hole). `asElement_` is a
-- runtime identity (same Go rep) that lets us reuse the SkyName discriminator:
-- a real Html doc (`HElement`/`HText`/`HRaw`) passes straight through, a
-- crossed-in Element is wrapped in `Ui.layout []`.
renderHtmlRoot_ : Html.Html msg -> Html.Html msg
renderHtmlRoot_ h =
    renderUiRoot_ (asElement_ h)


htmlDocOrDefault_ : Element msg -> Html.Html msg -> Html.Html msg
htmlDocOrDefault_ =
    Ffi.kernel "Std_App_htmlDocOrDefault"


asElement_ : Html.Html msg -> Element msg
asElement_ =
    Ffi.kernel "Std_App_asElement"

-- | An app described once, runnable on any backend. Built by [`app`] and
-- refined by the `with…` builders; consumed by a `run<Backend>` runner.
--
-- `fallback` is a phantom capability flag (`NoFallback` / `HasFallback`) — it
-- tracks whether [`withNotFound`] has supplied the fallback page that Live
-- requires; it is not stored in the record. Users never write the `App` type
-- (inference handles the flag); it surfaces only when [`runLive`] rejects an app
-- that lacks a fallback. `key` is the terminal key-event type carried by
-- [`withOnKey`] (unconstrained until attached).
type App fallback seed page model msg key
    = App { init : seed -> ( model, Cmd msg )
, update : msg -> model -> ( model, Cmd msg )
, viewImpl : ViewImpl model msg
, subscriptions : model -> Sub msg
, routes : List (Route page)
, notFound : Maybe page
, onInput : Maybe (String -> msg)
, base : BaseConfig
, configs : List Config
, head : Maybe (model -> List (Html msg))
, guard : Maybe (msg -> model -> Result Error ())
, onKey : Maybe (key -> msg)
, onNavigate : Maybe (page -> msg)
, onRequest : Maybe (Request -> model -> ( model, Cmd msg ))
}


-- | Describe an app from the shared TEA core. Routing, config, and function
-- knobs are added by the `with…` builders below (each is target-relevant and
-- ignored by targets that have no use for it).
app : { init : seed -> ( model, Cmd msg )
, update : msg -> model -> ( model, Cmd msg )
, view : model -> Element msg
, subscriptions : model -> Sub msg
} -> App NoFallback seed page model msg key
app cfg =
    App
        { init = cfg.init
        , update = cfg.update
        , viewImpl = ViewUi cfg.view
        , subscriptions = cfg.subscriptions
        , routes = []
        , notFound = Nothing
        , onInput = Nothing
        , base = baseDefaults
        , configs = []
        , head = Nothing
        , guard = Nothing
        , onKey = Nothing
        , onNavigate = Nothing
        , onRequest = Nothing
        }


-- | Describe an app whose `view` returns `Std.Html.Html` (not a `Std.Ui`
-- `Element`). Identical to [`app`] in every other way — the same `with…`
-- builders refine it and the same runners consume it — but the web/desktop/mobile
-- backends (Live/Spa/Webview) render the `Html` natively, while the terminal
-- backends (Tui/Cli) reject it (they require a `Std.Ui` view — use [`app`] for a
-- cross-platform view).
web : { init : seed -> ( model, Cmd msg )
, update : msg -> model -> ( model, Cmd msg )
, view : model -> Html msg
, subscriptions : model -> Sub msg
} -> App NoFallback seed page model msg key
web cfg =
    App
        { init = cfg.init
        , update = cfg.update
        , viewImpl = ViewHtml cfg.view
        , subscriptions = cfg.subscriptions
        , routes = []
        , notFound = Nothing
        , onInput = Nothing
        , base = baseDefaults
        , configs = []
        , head = Nothing
        , guard = Nothing
        , onKey = Nothing
        , onNavigate = Nothing
        , onRequest = Nothing
        }


-- | Describe an app whose `view` returns a plain `String` — the line-oriented
-- CLI shape (`--target terminal:cli`, = Sky.Cli). Feed stdin lines to a `Msg`
-- with [`withOnLine`]. A `String` view is terminal-only: the web / desktop /
-- mobile runners reject it at boot (use [`app`] for a cross-platform `Std.Ui`
-- view). This is the first-class home of what used to be `Std.Cli.program`.
cli : { init : seed -> ( model, Cmd msg )
, update : msg -> model -> ( model, Cmd msg )
, view : model -> String
, subscriptions : model -> Sub msg
} -> App NoFallback seed page model msg key
cli cfg =
    App
        { init = cfg.init
        , update = cfg.update
        , viewImpl = ViewString cfg.view
        , subscriptions = cfg.subscriptions
        , routes = []
        , notFound = Nothing
        , onInput = Nothing
        , base = baseDefaults
        , configs = []
        , head = Nothing
        , guard = Nothing
        , onKey = Nothing
        , onNavigate = Nothing
        , onRequest = Nothing
        }


-- | Describe an app whose `view` returns a plain `String`, rendered full-screen
-- on the terminal (`--target terminal:tui`, = Sky.Tui's `program` loop). Attach
-- a key handler with [`withOnKey`]. Identical to [`cli`] in shape — both carry a
-- `ViewString` — differing only in which terminal runner draws it; a `String`
-- view is terminal-only (the web / desktop / mobile runners reject it at boot).
-- Use [`app`] instead when you want a `Std.Ui` view that renders full-screen
-- ANSI *and* the web. This is the first-class home of `Std.Tui.program`.
tui : { init : seed -> ( model, Cmd msg )
, update : msg -> model -> ( model, Cmd msg )
, view : model -> String
, subscriptions : model -> Sub msg
} -> App NoFallback seed page model msg key
tui cfg =
    App
        { init = cfg.init
        , update = cfg.update
        , viewImpl = ViewString cfg.view
        , subscriptions = cfg.subscriptions
        , routes = []
        , notFound = Nothing
        , onInput = Nothing
        , base = baseDefaults
        , configs = []
        , head = Nothing
        , guard = Nothing
        , onKey = Nothing
        , onNavigate = Nothing
        , onRequest = Nothing
        }


-- | Attach URL routes (web targets), built with [`route`] / [`routeParam`].
-- Pair with [`withNotFound`] — the `web` target requires a fallback page.
withRoutes : List (Route page) -> App fallback seed page model msg key -> App fallback seed page model msg key
withRoutes routes (App a) =
    App { a | routes = routes }


-- | Set the fallback page for an unmatched route (web targets).
withNotFound : page -> App fallback seed page model msg key -> App HasFallback seed page model msg key
withNotFound page_ (App a) =
    App { a | notFound = Just page_ }


-- | Set the desktop window title + initial size (desktop targets). Shorthand
-- for a [`DesktopConfig`] via [`withConfig`].
withWindow : String -> Int -> Int -> App fallback seed page model msg key -> App fallback seed page model msg key
withWindow title width height (App a) =
    App
        { a | configs =
            DesktopConfig { title = title, width = width, height = height }
                :: a.configs
        }


-- | Wire a line/text input handler (terminal targets). The payload is the
-- entered line; a terminal renderer maps its input to it.
withInput : (String -> msg) -> App fallback seed page model msg key -> App fallback seed page model msg key
withInput onLine (App a) =
    App { a | onInput = Just onLine }


-- | Attach the cross-target [`BaseConfig`] (log, database, telemetry).
-- Record-update from [`baseDefaults`] (with `Sky.Config` constructors imported):
--
--     import Sky.Config as Config exposing (Database(..), LogLevel(..))
--
--     app { … }
--         |> App.withBase { App.baseDefaults | database = Just (Sqlite "app.db"), logLevel = Debug }
--
-- The runner applies this base config as its FIRST effect at boot (via
-- `Sky.Config.apply`), before it starts the backend — so it folds into the
-- same `rt.ApplyConfig` layer a top-level `config` binding uses, and an
-- operator's `SKY_*` env var still wins.
--
-- `--embed` caveat: an `--embed` app's database is decided at process start
-- (`rt.MaybeStartEmbeddedPostgres`, before any runner Task runs), so setting
-- `database` here has NO effect under `--embed` — the embedded cluster provides
-- the DB. Do not set `database` in `withBase` for an embedded app.
withBase : BaseConfig -> App fallback seed page model msg key -> App fallback seed page model msg key
withBase base (App a) =
    App { a | base = base }


-- | Fold a [`BaseConfig`] into a `Sky.Config.Config`, so a runner can `apply`
-- it at boot through the proven `rt.ApplyConfig` path. Starts from
-- `Config.default` and layers only the fields the base actually sets (the
-- `Maybe` fields contribute nothing when `Nothing`). Private.
baseToConfig_ : BaseConfig -> Config.Config
baseToConfig_ b =
    let
        withLog_ = Config.withLog b.logFormat b.logLevel Config.default
        withDb_ =
            case b.database of

                Just db ->
                    Config.withDatabase db withLog_

                Nothing ->
                    withLog_
        withTel_ =
            case b.telemetry of

                Just t ->
                    Config.withTelemetry t withDb_

                Nothing ->
                    withDb_
    in
        withTel_


-- | Attach a per-target [`Config`] variant. Call once per customised target;
-- the variant is prepended to the app's config list and the matching runner
-- reads its own variant (via [`findWeb`] / [`findDesktop`] / [`findTerminal`]),
-- so an app carries only the configs actually provided — not one record per
-- target — keeping the generic builder cheap (docs/design/std-app-config-dx.md
-- §"scalar/function split").
withConfig : Config -> App fallback seed page model msg key -> App fallback seed page model msg key
withConfig cfg (App a) =
    App { a | configs = cfg :: a.configs }


-- | The first [`WebConfig`] (or [`TabletConfig`], Live-backed too) in the app's
-- config list, else [`webDefaults`]. Used by [`runLive`].
findWeb : List Config -> WebOpts
findWeb configs =
    case configs of

        [] ->
            webDefaults

        (WebConfig o) :: _ ->
            o

        (TabletConfig o) :: _ ->
            o

        _ :: rest ->
            findWeb rest


-- | The first [`DesktopConfig`] in the app's config list, else
-- [`desktopDefaults`]. Used by [`runWebview`] / [`runLiveWindow`].
findDesktop : List Config -> DesktopOpts
findDesktop configs =
    case configs of

        [] ->
            desktopDefaults

        (DesktopConfig o) :: _ ->
            o

        _ :: rest ->
            findDesktop rest


-- | The first [`TerminalConfig`] in the app's config list, else
-- [`terminalDefaults`]. Used by [`runTui`].
findTerminal : List Config -> TerminalOpts
findTerminal configs =
    case configs of

        [] ->
            terminalDefaults

        (TerminalConfig o) :: _ ->
            o

        _ :: rest ->
            findTerminal rest


-- | Set the document `<head>` builder (web/desktop targets → `Live.withHead`).
withHead : (model -> List (Html msg)) -> App fallback seed page model msg key -> App fallback seed page model msg key
withHead headFor (App a) =
    App { a | head = Just headFor }


-- | Attach a per-Msg guard — `guard msg model` returns `Err` to reject the
-- message before `update` runs (web + terminal targets → `Live.withGuard` /
-- `Tui.withGuard`).
withGuard : (msg -> model -> Result Error ()) -> App fallback seed page model msg key -> App fallback seed page model msg key
withGuard guard (App a) =
    App { a | guard = Just guard }


-- | Attach a raw key-event handler (terminal target → `Tui.withOnKey`). The
-- key-event type is whatever the handler declares.
withOnKey : (key -> msg) -> App fallback seed page model msg key -> App fallback seed page model msg key
withOnKey onKey (App a) =
    App { a | onKey = Just onKey }


-- | Wire a navigation handler — `onNavigate page` yields a `msg` when the app
-- routes to `page` (web target → `Live.withOnNavigate`).
withOnNavigate : (page -> msg) -> App fallback seed page model msg key -> App fallback seed page model msg key
withOnNavigate onNav (App a) =
    App { a | onNavigate = Just onNav }


-- | Give a WEB app the incoming HTTP request at session start —
-- `withRequest (\req model -> …)` refines the freshly-`init`ed model with the
-- request's cookies / headers / path / query BEFORE the first paint, so an
-- auth-dependent view renders correctly on first render (no logged-out flash,
-- no `Cmd.perform` round-trip). It runs after `init` and returns the same
-- `( model, Cmd msg )` shape, so it can also fire a startup command.
--
-- This is the PORTABLE way to read the request: `init` stays `seed -> …` and
-- ignores its seed (so the same app builds for Tui / Cli / Webview, which have
-- no HTTP request and skip this hook entirely), while the request arrives only
-- through this web-only channel. Using it fixes the app's `seed` to `()` — the
-- request is no longer smuggled through `init`'s argument.
--
-- Only the Live/web runner consumes it. At session init the request carries
-- `method` / `path` / `headers` / `params` / `query` / `cookies`; `body` and
-- `remoteAddr` are empty (init is a GET-time hook — read a POST body in a route
-- handler or an `update` command instead).
--
--     app { init = init, update = update, view = view, subscriptions = subs }
--         |> withRequest
--             (\req model ->
--                 case Dict.get "sky_sid" req.cookies of
--                     Just sid -> ( { model | session = Just sid }, Cmd.none )
--                     Nothing  -> ( model, Cmd.none )
--             )
--         |> withNotFound NotFound
withRequest : (Request -> model -> ( model, Cmd msg )) -> App fallback () page model msg key -> App fallback () page model msg key
withRequest onReq (App a) =
    App { a | onRequest = Just onReq }


-- | The unified entry: `main = App.run app`. The build resolves `--target` and
-- REWRITES this call to the matching `run<Backend>` (so dead-code elimination
-- still prunes the unused backends). You never pick a backend in source — this
-- is the whole point of `Std.App`. When built without a target it defaults to
-- `web` (Sky.Live). The body here is a placeholder the build replaces; it is
-- never the compiled entry.
run : App fallback seed page model msg key -> Task Error ()
run =
    runTui


-- | Lower an [`App`] [`Route`] to a `Sky.Live` route. `Live.route` erases its
-- page arg, so a static page and a `:param` constructor (`String -> page`) both
-- pass through — Live applies the constructor to the captured segment at match.
liveRoute_ r =
    case r of

        RouteStatic path page_ ->
            Live.route path page_

        RouteParam path make ->
            Live.route path make

        RouteApi path handler ->
            Live.api path handler


-- | Lower an [`App`] [`Route`] to a `Sky.Spa` route (same erasure as Live).
-- Exposed because the `--target <spa>` build synthesises a `Sky.Spa` entry that
-- maps the app's routes through it. A raw [`api`] endpoint yields the empty list
-- — the client (Spa) backend has no server endpoints, so those are dropped
-- (`List.concatMap`) rather than routed.
spaRoute : Route page -> List Spa.Route
spaRoute r =
    case r of

        RouteStatic path page_ ->
            [ Spa.route path page_ ]

        RouteParam path make ->
            [ Spa.route path make ]

        RouteApi _ _ ->
            []


-- | Lower an [`App`] [`Route`] to the BACKEND server routes it mounts: a raw
-- [`api`] endpoint yields `[ Server.api path handler ]`, a page route yields `[]`.
-- The symmetric partner of [`spaRoute`] (which keeps page routes for the client
-- and drops api endpoints). Exposed for the `--target <spa>` BACKEND: `withRoutes`
-- can MIX page routes with `App.api` server endpoints (OAuth callbacks, /healthz,
-- webhooks), and the split synthesis routes the api endpoints here so they are
-- mounted as real `Server` handlers on the backend — the client (Spa) cannot
-- carry them (the handler is server-side). `List.concatMap apiServerRoute` over
-- the app's route list yields exactly the api mounts.
apiServerRoute : Route page -> List Server.Route
apiServerRoute r =
    case r of

        RouteStatic _ _ ->
            []

        RouteParam _ _ ->
            []

        RouteApi path handler ->
            [ Server.api path handler ]


-- Build a `Sky.Http.Server.Request` from the request-shaped seed record the
-- Live runtime hands `init` at session start (`runtime-go/rt/live.go`
-- `handleInitial`). That seed carries method / path / headers / params / query
-- / cookies; `body` and `remoteAddr` are not delivered at init, so they are
-- empty. `query` arrives as a raw string and is parsed to the `Dict` shape
-- `Request` declares. This is the ONE bridge — [`withRequest`] delivers this
-- `Request` to the app; `init` itself never sees the seed (it is called with
-- `()`), which is what keeps the app portable.
requestFromSeed_ : { method : String
, path : String
, headers : Dict String String
, params : Dict String String
, query : String
, cookies : Dict String String
} -> Request
requestFromSeed_ s =
    { method = s.method
    , path = s.path
    , body = ""
    , headers = s.headers
    , params = s.params
    , query = Http.parseQuery s.query
    , cookies = s.cookies
    , remoteAddr = ""
    }


-- ─── Runners — one per backend, target → runner is resolved by the build ───
-- Sequence the base config's `apply` BEFORE a runner's own boot Task, so the
-- log / database / telemetry from [`withBase`] land through the proven
-- `rt.ApplyConfig` layer first (an operator's `SKY_*` env var still wins). Each
-- runner delegates its body to a private `run<Backend>Boot_` and wraps it here,
-- so [`withBase`] applies uniformly on every backend. Constructing a boot Task
-- has no effect (it is a thunk); only `andThen` forcing it runs the backend, so
-- `apply` is guaranteed to run first. Private.
applyBase_ : BaseConfig -> Task Error () -> Task Error ()
applyBase_ base boot =
    Task.andThen (\_ -> boot) (Config.apply (baseToConfig_ base))


-- | A `ViewString` app ([`cli`] / [`tui`]) renders a raw `String` and runs ONLY
-- on the terminal targets. The web / desktop / mobile runners call this to
-- refuse it at boot — loudly, before serving anything — mirroring how the
-- terminal runners refuse a `ViewHtml`. `boot` is a pure Task construction, so
-- evaluating it before the guard fires has no observable effect; for a
-- `ViewString` it is simply discarded.
guardTerminalView_ : ViewImpl model msg -> Task Error () -> Task Error ()
guardTerminalView_ vi boot =
    case vi of

        ViewString _ ->
            Task.fail
                (Error.invalidInput
                    "this app has a String view (App.cli / App.tui) — build it with --target terminal:cli or terminal:tui; use App.app for a cross-platform Std.Ui view that also renders on the web")

        _ ->
            boot


-- | Run as server-driven HTML + SSE (`--target web`, = Sky.Live). Requires a
-- fallback page ([`withNotFound`]) because Live routing is total. Folds the
-- accumulated [`WebOpts`] + the `withHead`/`withGuard`/`withOnNavigate` builders
-- into the `Live.config` chain. The [`BaseConfig`] applies first (see
-- [`applyBase_`]).
runLive : App HasFallback () page model msg key -> Task Error ()
runLive (App a) =
    applyBase_ a.base (guardTerminalView_ a.viewImpl (runLiveBoot_ (App a)))


runLiveBoot_ : App HasFallback () page model msg key -> Task Error ()
runLiveBoot_ (App a) =
    case a.notFound of

        Just fallback ->
            let
                w = findWeb a.configs
                base =
                    Live.config
                        { init =
                            \liveSeed ->
                                let
                                    ( m0, c0 ) = a.init ()
                                in
                                    case a.onRequest of

                                        Just f ->
                                            let
                                                ( m1, c1 ) =
                                                    f
                                                        (requestFromSeed_
                                                            liveSeed)
                                                        m0
                                            in
                                                ( m1, Cmd.batch [ c0, c1 ] )

                                        Nothing ->
                                            ( m0, c0 )
                        , update = a.update
                        , view =
                            \model ->
                                case a.viewImpl of

                                    ViewUi v ->
                                        renderUiRoot_ (v model)

                                    ViewHtml v ->
                                        renderHtmlRoot_ (v model)

                                    ViewString v ->
                                        -- unreachable: guardTerminalView_ refuses a String view before Live renders
                                        Html.text (v model)
                        , subscriptions = a.subscriptions
                        , routes = List.map liveRoute_ a.routes
                        , notFound = fallback
                        }
                withStore_ =
                    case w.store of

                        Just s ->
                            Live.withStore s base

                        Nothing ->
                            base
                withStatic_ =
                    case w.static of

                        Just s ->
                            Live.withStatic s withStore_

                        Nothing ->
                            withStore_
                withStaticUrl_ =
                    case w.staticUrl of

                        Just s ->
                            Live.withStaticUrl s withStatic_

                        Nothing ->
                            withStatic_
                withTtl_ =
                    case w.ttl of

                        Just t ->
                            Live.withTtl t withStaticUrl_

                        Nothing ->
                            withStaticUrl_
                withIdle_ =
                    case w.idleEvict of

                        Just t ->
                            Live.withIdleEvict t withTtl_

                        Nothing ->
                            withTtl_
                withMaxBody_ =
                    case w.maxBodyBytes of

                        Just n ->
                            Live.withMaxBodyBytes n withIdle_

                        Nothing ->
                            withIdle_
                withInputMode_ =
                    case w.inputMode of

                        Just m ->
                            Live.withInput m withMaxBody_

                        Nothing ->
                            withMaxBody_
                withPort_ = Live.withPort w.port withInputMode_
                withAnalytics_ =
                    case w.analytics of

                        Just an ->
                            Live.withAnalytics an withPort_

                        Nothing ->
                            withPort_
                -- NOTE(std-app-config): `a.base` (log/database/telemetry) IS
                -- now wired — [`runLive`] applies it at boot via [`applyBase_`]
                -- through `rt.ApplyConfig`. `w.csrf` is still stored-but-not
                -- threaded here: it maps to `Sky.Config.withCsrf`, which could be
                -- folded into the same `applyBase_` path in a follow-up.
                withHead_ =
                    case a.head of

                        Just h ->
                            Live.withHead h withAnalytics_

                        Nothing ->
                            withAnalytics_
                withGuard_ =
                    case a.guard of

                        Just g ->
                            Live.withGuard g withHead_

                        Nothing ->
                            withHead_
                withNav_ =
                    case a.onNavigate of

                        Just f ->
                            Live.withOnNavigate f withGuard_

                        Nothing ->
                            withGuard_
            in
                Live.app withNav_

        Nothing ->
            Task.fail
                (Error.invalidInput
                    "target 'web' requires a fallback page — add `|> App.withNotFound <page>`")


-- | Run as a client wasm SPA (`--target web:app` / `mobile:*` / `tablet:*`,
-- = Sky.Spa). Effects auto-split to a backend at build time. Folds only what
-- Spa supports (routes + fallback); web-server-only knobs are ignored.
runSpa : App fallback seed page model msg key -> Task Error ()
runSpa (App a) =
    applyBase_ a.base (guardTerminalView_ a.viewImpl (runSpaBoot_ (App a)))


runSpaBoot_ : App fallback seed page model msg key -> Task Error ()
runSpaBoot_ (App a) =
    let
        base =
            Spa.config
                { init = a.init
                , update = a.update
                , view =
                    \model ->
                        case a.viewImpl of

                            ViewUi v ->
                                renderUiRoot_ (v model)

                            ViewHtml v ->
                                renderHtmlRoot_ (v model)

                            ViewString v ->
                                -- unreachable: guardTerminalView_ refuses a String view before Spa renders
                                Html.text (v model)
                , subscriptions = a.subscriptions
                }
        routed = Spa.withRoutes (List.concatMap spaRoute a.routes) base
        withFallback =
            case a.notFound of

                Just fallback ->
                    Spa.withNotFound fallback routed

                Nothing ->
                    routed
    in
        Spa.app withFallback


-- | Run as a full-screen terminal UI (`--target terminal:tui`, = Sky.Tui).
-- The `Element` view renders directly to ANSI cells. Folds the [`TerminalOpts`]
-- canvas + the `withOnKey`/`withGuard` builders into the `Tui.config` chain.
runTui : App fallback seed page model msg key -> Task Error ()
runTui (App a) =
    applyBase_ a.base (runTuiBoot_ (App a))


runTuiBoot_ : App fallback seed page model msg key -> Task Error ()
runTuiBoot_ (App a) =
    case a.viewImpl of

        ViewUi v ->
            let
                t = findTerminal a.configs
                base =
                    Tui.config
                        { init = a.init
                        , update = a.update
                        , view = v
                        , subscriptions = a.subscriptions
                        }
                withW_ = Tui.withCanvasWidth t.canvasWidth base
                withH_ = Tui.withCanvasHeight t.canvasHeight withW_
                withKey_ =
                    case a.onKey of

                        Just k ->
                            Tui.withOnKey k withH_

                        Nothing ->
                            withH_
                withGuard_ =
                    case a.guard of

                        Just g ->
                            Tui.withGuard g withKey_

                        Nothing ->
                            withKey_
            in
                Tui.app withGuard_

        ViewString v ->
            -- App.tui: a hand-authored String view, drawn full-screen by
            -- Tui.program (what Std.Tui.program used to be, now first-class).
            let
                t = findTerminal a.configs
                base =
                    Tui.config
                        { init = a.init
                        , update = a.update
                        , view = v
                        , subscriptions = a.subscriptions
                        }
                withW_ = Tui.withCanvasWidth t.canvasWidth base
                withH_ = Tui.withCanvasHeight t.canvasHeight withW_
                withKey_ =
                    case a.onKey of

                        Just k ->
                            Tui.withOnKey k withH_

                        Nothing ->
                            withH_
                withGuard_ =
                    case a.guard of

                        Just g ->
                            Tui.withGuard g withKey_

                        Nothing ->
                            withKey_
            in
                Tui.program withGuard_

        ViewHtml _ ->
            Task.fail
                (Error.invalidInput
                    "terminal:tui requires a Std.Ui or String view — App.web (Std.Html) targets web/desktop/mobile; use App.app or App.tui")


-- | Run as a line-based CLI (`--target terminal:cli`, = Sky.Cli). An [`app`]
-- `Element` view is flattened to text (best-effort — see [`elementToText`]); a
-- [`cli`] `String` view is printed verbatim — the first-class successor to the
-- old `Std.Cli.program` escape hatch.
runCli : App fallback seed page model msg key -> Task Error ()
runCli (App a) =
    applyBase_ a.base (runCliBoot_ (App a))


runCliBoot_ : App fallback seed page model msg key -> Task Error ()
runCliBoot_ (App a) =
    case a.viewImpl of

        ViewUi v ->
            let
                base =
                    Cli.config
                        { init = a.init
                        , update = a.update
                        , view = \model -> elementToText (v model)
                        , subscriptions = a.subscriptions
                        }
                withLine =
                    case a.onInput of

                        Just onLine ->
                            Cli.withOnLine onLine base

                        Nothing ->
                            base
            in
                Cli.program withLine

        ViewString v ->
            -- App.cli: a hand-authored String view, printed verbatim (what
            -- Std.Cli.program used to be, now first-class).
            let
                base =
                    Cli.config
                        { init = a.init
                        , update = a.update
                        , view = v
                        , subscriptions = a.subscriptions
                        }
                withLine =
                    case a.onInput of

                        Just onLine ->
                            Cli.withOnLine onLine base

                        Nothing ->
                            base
            in
                Cli.program withLine

        ViewHtml _ ->
            Task.fail
                (Error.invalidInput
                    "terminal:cli requires a Std.Ui or String view — App.web targets web/desktop; use App.app or App.cli")


-- | Run as a native desktop window (`--target desktop:<os>` is native wasm; this
-- is the standalone Sky.Webview form). `seed` is pinned to unit. The window is
-- taken from [`withWindow`] / a `DesktopConfig` via [`withConfig`].
runWebview : App fallback () page model msg key -> Task Error ()
runWebview (App a) =
    applyBase_ a.base (guardTerminalView_ a.viewImpl (runWebviewBoot_ (App a)))


runWebviewBoot_ : App fallback () page model msg key -> Task Error ()
runWebviewBoot_ (App a) =
    let
        d = findDesktop a.configs
    in
        Webview.app
            { init = a.init
            , update = a.update
            , view =
                \model ->
                    case a.viewImpl of

                        ViewUi v ->
                            renderUiRoot_ (v model)

                        ViewHtml v ->
                            renderHtmlRoot_ (v model)

                        ViewString v ->
                            -- unreachable: guardTerminalView_ refuses a String view before the webview renders
                            Html.text (v model)
            , subscriptions = a.subscriptions
            , window = { title = d.title, size = ( d.width, d.height ) }
            }


-- | Run as **Sky.Live in a native window** (`--target desktop`): serve the Live
-- app AND open a native webview onto it — the desktop delivery of a server-driven
-- app. Requires a fallback page (it runs `runLive`). The window opens shortly
-- after the server starts.
runLiveWindow : App HasFallback () page model msg key -> Task Error ()
runLiveWindow (App a) =
    let
        d = findDesktop a.configs
    in
        Task.map
            (\_ -> ())
            (Task.parallel
                [ runLive (App a)
                , openLiveWindow_
                      { title = d.title, size = ( d.width, d.height ) }
                ])


openLiveWindow_ : { title : String
, size : ( Int, Int )
} -> Task Error ()
openLiveWindow_ window =
    Task.andThen
        (\_ -> Webview.url "http://localhost:8000" window)
        (Time.sleep 800)


-- ─── Element → text (best-effort, for terminal:cli) ───
-- | Flatten an `Element` tree to text: `Text` leaves are kept, block children
-- are newline-joined, and `Raw` (an opaque Std.Html node) becomes empty —
-- 2-D layout has no lossless text form, so this is deliberately best-effort.
elementToText : Element msg -> String
elementToText element =
    case element of

        Empty ->
            ""

        Text content ->
            content

        Node _ _ children ->
            joinChildren children

        TaggedNode _ _ _ children ->
            joinChildren children

        Raw _ ->
            ""


joinChildren : List (Element msg) -> String
joinChildren children =
    String.join
        "\n"
        (List.filter (\line -> line /= "") (List.map elementToText children))
