-- | Std.Live — server-driven web UI backend (Layer 3 Sky source).
--
-- **DEPRECATED for direct use — write `Std.App` instead.** `Std.App` is the
-- single public app builder; it composes this module for the `web` target
-- (`--target web`, the default). This module stays functional (Std.App uses it
-- internally, and existing apps keep compiling), but new code should use
-- `App.app { … } |> App.withNotFound … ` + `App.run`. See docs/skyapp/overview.md.
--
-- `Live.app` takes a typed builder config: `Live.config { init, update,
-- view, subscriptions, routes, notFound }` produces an opaque `AppConfig`,
-- and optional fields (head / guard / static / analytics / …) are attached
-- with the `withX` builders. Every binding is an `Ffi.kernel` alias carrying
-- its real HM signature, so the type-checker, LSP hover, and `sky doc` all
-- read this ONE file.
--
-- ```elm
-- main =
--     Live.app
--         (Live.config
--             { init = init, update = update, view = view
--             , subscriptions = subscriptions
--             , routes = [ Live.route "/" Home ], notFound = Home
--             }
--             |> Live.withHead headFor
--         )
-- ```
module Std.Live exposing
    ( AppConfig
    , Route
    , app
    , config
    , route
    , api
    , lifecycle
    , withHead
    , withConsoleAuth
    , withOnNavigate
    , withGuard
    , withStatic
    , withStaticUrl
    , withPort
    , withStore
    , withStorePath
    , withTtl
    , withIdleEvict
    , withMaxBodyBytes
    , withInput
    , withAnalytics
    , withAnalyticsIdentify
    , withStatus
    , withAuthSliding
    , withRevocation
    , bindSessionUser
    )

import Sky.Ffi as Ffi
import Sky.Core.Error exposing (Error)
import Std.Html exposing (Html)

-- | The built Sky.Live app configuration. Opaque — produced by `config`,
-- refined by the `withX` builders, consumed by `app`. Phantom `model` /
-- `msg` thread the TEA types through the builder chain.
type AppConfig model msg
    = AppConfig_OPAQUE


-- | A server route, produced by `route` / `api` and registered in a config's
-- `routes`. Opaque — its runtime shape (`rt.liveRoute`) is an implementation
-- detail. DECLARED (not left kernel-implicit) so a same-named local `type Route`
-- in user code cannot collide with it in the Sky→Go type map — matching the
-- `Std.Spa` / `Sky.Http.Server` `Route` declarations. Without this an annotated
-- converter `Local.Route -> Live.Route` mis-narrowed the kernel handle to the
-- local nominal and panicked at runtime while `sky check` passed.
type Route
    = Route_OPAQUE


-- | Build the app config from the six required fields. Attach optional
-- fields (head, guard, static, analytics, …) with the `withX` builders.
--
--     main =
--         Live.app
--             (Live.config
--                 { init = init, update = update, view = view
--                 , subscriptions = subscriptions
--                 , routes = [ Live.route "/" Home ], notFound = Home
--                 }
--                 |> Live.withHead headFor
--             )
config : { init : a -> ( model, Cmd msg )
, update : msg -> model -> ( model, Cmd msg )
, view : model -> Html msg
, subscriptions : model -> Sub msg
, routes : List Route
, notFound : page
} -> AppConfig model msg
config =
    Ffi.kernel "Live_config"


-- | Open the HTTP listener and run the TEA loop. Sits at the top of `main`.
app : AppConfig model msg -> Task Error ()
app =
    Ffi.kernel "Live_app"


-- | `route path page` — register a page route. Put literals before
-- `:param` patterns (declaration order matters).
route : String -> page -> Route
route =
    Ffi.kernel "Live_route"


-- | `api path handler` — register a raw JSON/HTTP endpoint alongside the
-- page routes; the handler returns a `Response`.
api : String -> (Request -> Task Error Response) -> Route
api =
    Ffi.kernel "Live_api"


-- | Tag a message as a lifecycle message (identity at the type level; the
-- runtime routes it through the lifecycle dispatch).
lifecycle : msg -> msg
lifecycle =
    Ffi.kernel "Live_lifecycle"


-- | Per-page `<head>` injection — `head model` returns the extra `<head>`
-- nodes for the current page (title / meta / canonical / OG …).
withHead : (model -> List (Html msg)) -> AppConfig model msg -> AppConfig model msg
withHead =
    Ffi.kernel "Live_withHead"


-- | Gate the `/_sky/console` mount — `consoleAuth req` returns the
-- authenticated identity (or `Nothing` to deny).
withConsoleAuth : (Request -> Task Error (Maybe a)) -> AppConfig model msg -> AppConfig model msg
withConsoleAuth =
    Ffi.kernel "Live_withConsoleAuth"


-- | Hook fired on in-app navigation (initial mount, `sky-nav` fetch,
-- popstate) AFTER the route is applied — the runtime passes the new
-- `Page` value and dispatches the resulting `msg` through `update`.
-- Ignore the page (`\_ -> ResetBanner`) to run one effect on every
-- navigation, or pattern-match it (`\page -> case page of …`) to react
-- per-destination. The argument is the model's page type, so a bare
-- `\_ ->` leaves it fully polymorphic.
withOnNavigate : (page -> msg) -> AppConfig model msg -> AppConfig model msg
withOnNavigate =
    Ffi.kernel "Live_withOnNavigate"


-- | Per-Msg guard — `guard msg model` returns `Err` to reject the message
-- before `update` runs.
withGuard : (msg -> model -> Result Error ()) -> AppConfig model msg -> AppConfig model msg
withGuard =
    Ffi.kernel "Live_withGuard"


-- | Serve a static directory at `/static` (override the mount with
-- `withStaticUrl`).
withStatic : String -> AppConfig model msg -> AppConfig model msg
withStatic =
    Ffi.kernel "Live_withStatic"


-- | Override the static mount path (default `/static`).
withStaticUrl : String -> AppConfig model msg -> AppConfig model msg
withStaticUrl =
    Ffi.kernel "Live_withStaticUrl"


-- | Set the listen port.
--
-- Precedence, highest first:
--
--   1. `SKY_LIVE_PORT` set by the operator (shell or `.env`)
--   2. this `withPort` call
--   3. `[live] port` in `sky.toml`
--   4. 8080
--
-- So an operator can always override the binary, and `withPort` always beats
-- the `sky.toml` default. (2 and 3 used to be inverted: `sky.toml`'s port is
-- injected into `SKY_LIVE_PORT` at init, which made this call dead.)
withPort : Int -> AppConfig model msg -> AppConfig model msg
withPort =
    Ffi.kernel "Live_withPort"


-- | Select the session store kind ("memory" / "sqlite" / "redis" /
-- "postgres").
--
-- Resolved by the same precedence order as `withPort`, highest first:
-- operator env `SKY_LIVE_STORE` (shell or `.env`) → this call →
-- `[live] store` in `sky.toml` → "memory".
withStore : String -> AppConfig model msg -> AppConfig model msg
withStore =
    Ffi.kernel "Live_withStore"


-- | Session store path / URL.
--
-- Same precedence order as `withPort`: operator env `SKY_LIVE_STORE_PATH`
-- (shell or `.env`) → this call → `[live] storePath` in `sky.toml` → the
-- store's own fallback (postgres: `DATABASE_URL`; redis: `REDIS_URL`, then
-- `localhost:6379`). An operator can therefore repoint the store (e.g. at a
-- mounted volume) without a recompile, even when the app calls this.
withStorePath : String -> AppConfig model msg -> AppConfig model msg
withStorePath =
    Ffi.kernel "Live_withStorePath"


-- | Session TTL ("30m" / "24h" / bare seconds).
--
-- Same precedence order as `withPort`: operator env `SKY_LIVE_TTL` (shell or
-- `.env`) → this call → `[live] ttl` in `sky.toml` → 30 minutes. An empty or
-- unparseable value at one layer falls through to the next.
withTtl : String -> AppConfig model msg -> AppConfig model msg
withTtl =
    Ffi.kernel "Live_withTtl"


-- | Tiered-session-cache idle-evict window ("5m" / "0"/"off" to disable).
--
-- Same precedence order as `withPort`: operator env `SKY_LIVE_IDLE_EVICT`
-- (shell or `.env`) → this call → 5 minutes.
-- On a durable store (sqlite / postgres / redis)
-- a session with no active SSE that's been idle this long drops its live
-- pointer from RAM while its blob stays on disk to the full TTL, resurrecting
-- on next access — bounding RAM to the ACTIVE working set. Ignored by the
-- memory store. See docs/skylive/tiered-session-cache.md.
withIdleEvict : String -> AppConfig model msg -> AppConfig model msg
withIdleEvict =
    Ffi.kernel "Live_withIdleEvict"


-- | Maximum bytes accepted on a single TEA event request (the channel that
-- also carries `Event.onFile` / `Event.onImage` base64 uploads). Default 5 MiB.
--
-- Same precedence order as `withPort`: operator env `SKY_LIVE_MAX_BODY_BYTES`
-- (shell or `.env`) → this call → `[live] maxBodyBytes` in `sky.toml` → 5 MiB.
-- A non-positive or unparseable value at one layer falls through to the next.
withMaxBodyBytes : Int -> AppConfig model msg -> AppConfig model msg
withMaxBodyBytes =
    Ffi.kernel "Live_withMaxBodyBytes"


-- | When the JS driver reports an input's value: `"debounce"` (after a typing
-- pause, the default) or `"blur"` (only when the field loses focus).
--
-- Same precedence order as `withPort`: operator env `SKY_LIVE_INPUT_MODE`
-- (shell or `.env`) → this call → `[live] input` in `sky.toml` → `"debounce"`.
-- An unrecognised value falls back to `"debounce"` with a warning.
withInput : String -> AppConfig model msg -> AppConfig model msg
withInput =
    Ffi.kernel "Live_withInput"


-- | Opt into Sky.Live auto page-view analytics —
-- `withAnalytics { pageViews = True }`.
withAnalytics : { pageViews : Bool } -> AppConfig model msg -> AppConfig model msg
withAnalytics =
    Ffi.kernel "Live_withAnalytics"


-- | Attribute auto page-views to an already-authenticated session: a resolver
-- run against the current model on each page-view (incl. the first render), so a
-- returning signed-in user is captured without a manual `Analytics.identify`.
-- `Just id` stamps the session user id; `Nothing` leaves it anonymous.
--
--     |> Live.withAnalytics { pageViews = True }
--     |> Live.withAnalyticsIdentify (\model -> Maybe.map .userId model.session)
withAnalyticsIdentify : (model -> Maybe String) -> AppConfig model msg -> AppConfig model msg
withAnalyticsIdentify =
    Ffi.kernel "Live_withAnalyticsIdentify"


-- | Override the connection-status banner strings —
-- `withStatus { reconnecting = "…", offline = "…" }`.
withStatus : { reconnecting : String
, offline : String
} -> AppConfig model msg -> AppConfig model msg
withStatus =
    Ffi.kernel "Live_withStatus"


-- | Opt into SLIDING (rolling) auth tokens — the middleware re-issues a
-- signed JWT on activity, keeping active users signed in while an idle token
-- still lapses, under a hard absolute-lifetime cap.
--
--     |> Live.withAuthSliding
--         { cookie = "sky_auth"
--         , secretEnv = "SKY_AUTH_TOKEN_SECRET"
--         , sameSite = "Strict"
--         , revokedCheck = Nothing
--         }
--
-- Fields:
--
--   - `cookie` — the auth cookie name the token rides in.
--   - `secretEnv` — the ENV-VAR NAME holding the HMAC secret (never the secret
--     value — the operator owns it). The middleware reads it at request time.
--   - `sameSite` — `"Strict"` (default; pass `""` for the default), `"Lax"`,
--     or `"None"`. Applied to BOTH login and re-issue via the builder-owned
--     setter so the attributes cannot drift.
--   - `revokedCheck` — `Just (\sub -> …)` runs a per-subject revocation check
--     (`String -> Task Error Bool`) at RE-ISSUE time only (not per request);
--     `True` stops the slide. `Nothing` disables the check (revocation latency
--     then equals the absolute cap).
--
-- Issue tokens with `Auth.signSlidingToken` and set the cookie with
-- `Auth.setSlidingCookie` — a hand-rolled `Server.withCookie` for the sliding
-- cookie is unsupported (its attributes would drift from the re-issue).
withAuthSliding : { cookie : String
, secretEnv : String
, sameSite : String
, revokedCheck : Maybe (String -> Task Error Bool)
} -> AppConfig model msg -> AppConfig model msg
withAuthSliding =
    Ffi.kernel "Live_withAuthSliding"


-- | Opt into PULL-model user revocation + suspension. Hand the runtime the
-- application `Db` where the shared revocation state lives
-- (`sky_revocations` + `users.disabled_at`) — the SAME `Db` you pass to
-- `Std.Auth`, NOT the session store. This is the enabling signal: the per-
-- session gate is inert until you register it.
--
-- Once registered, every session dispatch (interaction, `Cmd.perform`
-- completion, `Time.every` tick, subscriber) checks — fresh from the shared
-- table each time — whether its bound user is revoked or disabled, and EVICTS
-- the session (retiring its goroutines and replying session-lost) if so. Bind
-- sessions to users with `bindSessionUser` at login (or auto-bind via
-- `withAuthSliding`), or the gate has no subject to check and warns loudly.
--
--     |> Live.withRevocation db
withRevocation : Db -> AppConfig model msg -> AppConfig model msg
withRevocation =
    Ffi.kernel "Live_withRevocation"


-- | `bindSessionUser userId` — bind the CURRENT live session to an application
-- user at auth time, so `Auth.revokeUser` / `Auth.disableUser` can evict it.
-- Call it (via `Cmd.perform`) in your login flow once the user is
-- authenticated. `userId` is a String (an OAuth subject or a stringified id).
-- Outside a live-session dispatch (a CLI `Task.run`) it is a harmless no-op.
--
--     LoggedIn userId ->
--         ( { model | user = Just userId }
--         , Cmd.perform (Live.bindSessionUser userId) (\_ -> Ignore)
--         )
bindSessionUser : String -> Task Error ()
bindSessionUser =
    Ffi.kernel "Live_bindSessionUser"
