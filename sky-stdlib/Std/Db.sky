-- | Std.Db — relational database helpers (Layer 3 Sky source).
--
-- `Db` is the opaque connection handle (runtime-typed — shares
-- its representation with the existing kernel-registered Db).
-- Open one with `connect` or `open`, pass it to every subsequent
-- query, close it with `close` (or let `withTransaction` manage
-- the lifecycle).
--
-- All row results come back as `Dict String String` — read
-- typed values via `getInt` / `getBool` / `getField`.
module Std.Db exposing
    ( open
    , connect
    , close
    , exec
    , execRaw
    , query
    , insertRow
    , getById
    , updateById
    , deleteById
    , findOneByField
    , findManyByField
    , findByConditions
    , unsafeFindWhere
    , queryDecode
    , getByIdDecode
    , withTransaction
    , getField
    , getString
    , getInt
    , getBool
    , Migration
    , defaultMigration
    , withSql
    , migrate
    -- v0.16.26 — typed SQL value binding (#582)
    , SqlValue(..)
    , fromMaybeString
    , fromMaybeInt
    , fromMaybeFloat
    , fromMaybeBool
    , fromMaybeBytes
    , fromMaybeDecimal
    , fromMaybeTime
    , fromMaybeMoney
    , SqlField(..)
    , updateFields
    , insertFields
    , insertFieldsReturning
    )

import Sky.Ffi as Ffi
import Sky.Core.List as List
import Sky.Core.Error exposing (Error)
import Sky.Core.Maybe as Maybe
import Std.Decimal exposing (Decimal)
import Std.Decimal as Decimal
import Std.Money exposing (Money)
import Std.Money as Money


-- `Time` is a Unix-millis Int in Sky's stdlib (Sky.Core.Time has
-- no opaque type; every entry takes/returns Int). SqlTime carries
-- raw millis for driver-side `time.UnixMilli(...).UTC()` round-trip.


-- ─── Connection lifecycle ──────────────────────────────────────────


-- | `open driver dsn` — opens a database connection.
-- `driver` is `"sqlite"` / `"postgres"`; `dsn` is the connection
-- string.
open : String -> String -> Task Error Db
open =
    Ffi.kernel "Db_open"


-- | Use the connection configured by `sky.toml`'s `[database]`
-- section (driver + url).
connect : () -> Task Error Db
connect =
    Ffi.kernel "Db_connect"


close : Db -> Task Error ()
close =
    Ffi.kernel "Db_close"


-- ─── Raw SQL ───────────────────────────────────────────────────────


-- | `exec db sql params` — parameterised SQL with bound args.
-- Returns the affected-row count.
--
-- `params` is a homogeneously-typed list, so mixed-type SQL params
-- (e.g. `INSERT INTO users (name, age, admin) VALUES (?, ?, ?)`
-- bound with String + Int + Bool) must be normalised at the call
-- site. The convention is to stringify everything via
-- `String.fromInt` / `String.fromFloat` / `toString` (#575):
--
--     Db.exec conn
--         "INSERT INTO users (name, age, admin) VALUES (?, ?, ?)"
--         [ "Alice", String.fromInt 30, toString True ]
--
-- The SQL driver re-parses each ? parameter to the column's
-- declared type, so the round-trip is correct for SQLite +
-- PostgreSQL. Maybe-typed columns route through Maybe directly
-- (Just v / Nothing) thanks to #574 — no coercion needed:
--
--     Db.exec conn
--         "INSERT INTO people (name, age) VALUES (?, ?)"
--         [ Just "Alice", Just 30 ]
exec : Db -> String -> List a -> Task Error Int
exec =
    Ffi.kernel "Db_exec"


-- | `execRaw db sql` — SQL without bound args (DDL,
-- multi-statement scripts).  No parameter binding — vulnerable
-- to injection if `sql` is built from user input.
execRaw : Db -> String -> Task Error Int
execRaw =
    Ffi.kernel "Db_execRaw"


-- | `query db sql params` — parameterised SELECT.  Returns rows
-- as a list of `Dict String String`.
--
-- Same mixed-type convention as `exec` (#575): stringify
-- non-String params at the call site, or pass Maybe-typed values
-- directly (#574). See `exec`'s docstring for examples.
query : Db -> String -> List a -> Task Error (List (Dict String String))
query =
    Ffi.kernel "Db_query"


-- ─── Convenience CRUD ──────────────────────────────────────────────


-- | `insertRow db table fields` — insert a row built from
-- `fields` (`Dict String String`).  Returns the new row's `id`.
insertRow : Db -> String -> Dict String String -> Task Error Int
insertRow =
    Ffi.kernel "Db_insertRow"


-- | `getById db table id` — fetch a single row by integer id.
getById : Db -> String -> String -> Task Error (Maybe (Dict String String))
getById =
    Ffi.kernel "Db_getById"


-- | `updateById db table id fields` — partial update; returns
-- the affected-row count.
updateById : Db -> String -> String -> Dict String String -> Task Error Int
updateById =
    Ffi.kernel "Db_updateById"


-- | `deleteById db table id` — delete one row by id; returns
-- the affected-row count.
deleteById : Db -> String -> String -> Task Error Int
deleteById =
    Ffi.kernel "Db_deleteById"


-- | `findOneByField db table fieldName value` — equality lookup.
findOneByField : Db -> String -> String -> a -> Task Error (Maybe (Dict String String))
findOneByField =
    Ffi.kernel "Db_findOneByField"


-- | `findManyByField db table fieldName value` — equality
-- lookup returning all matches.
findManyByField : Db -> String -> String -> a -> Task Error (List (Dict String String))
findManyByField =
    Ffi.kernel "Db_findManyByField"


-- | `findByConditions db table conditions` — AND-joined equality
-- on every key/value pair in `conditions`.
findByConditions : Db -> String -> Dict String String -> Task Error (List (Dict String String))
findByConditions =
    Ffi.kernel "Db_findByConditions"


-- | `unsafeFindWhere db table whereClause params` — raw `WHERE`
-- with parameterised args.  The `whereClause` is appended
-- verbatim to the SELECT — vulnerable to injection if built from
-- user input.
unsafeFindWhere : Db -> String -> String -> List a -> Task Error (List (Dict String String))
unsafeFindWhere =
    Ffi.kernel "Db_unsafeFindWhere"


-- | `queryDecode db sql params decoder` — typed query with a
-- per-row decoder (v0.15.45).
--
-- `decoder` is a `Std.Db.Decode.Decoder b` describing how to extract
-- each row's columns into a typed `b`.  Returns a `List b` on
-- success; the first row-decoder failure short-circuits the entire
-- task with `Err`.
queryDecode : Db -> String -> List a -> Decoder b -> Task Error (List b)
queryDecode =
    Ffi.kernel "Db_queryDecode"


-- | `getByIdDecode db table id decoder` — typed sibling of
-- `getById`.  Returns `Nothing` when the row isn't present; `Just`
-- the decoded value otherwise.  Decoder failure surfaces as
-- `Err Error` (not `Ok Nothing`) — the row exists but didn't match
-- the expected shape.
getByIdDecode : Db -> String -> Int -> Decoder a -> Task Error (Maybe a)
getByIdDecode =
    Ffi.kernel "Db_getByIdDecode"


-- ─── Transactions ──────────────────────────────────────────────────


-- | Run a block of database work inside a transaction; commits
-- on `Ok`, rolls back on `Err`.
withTransaction : Db -> (Db -> Task Error a) -> Task Error a
withTransaction =
    Ffi.kernel "Db_withTransaction"

-- ─── Schema migrations ─────────────────────────────────────────────


-- | A single schema migration: a unique `name` and the `sql` that
-- applies it.  `name` is the identity recorded in `_sky_migrations`
-- — keep it stable once a migration has shipped (a rename reads as
-- a brand-new migration; an edit to the SQL of an applied
-- migration is rejected by the checksum guard).
type alias Migration =
    { name : String
    , sql : String
    }


-- | `defaultMigration "0001_users"` — Migration named with empty SQL.
-- Pair with `withSql` to populate the SQL body.  Builder chain stays
-- source-compat when v0.17+ adds optional fields like `description`.
defaultMigration : String -> Migration
defaultMigration migrationName =
    { name = migrationName, sql = "" }


-- | `withSql sqlBody m` — replace the migration's SQL body.
withSql : String -> Migration -> Migration
withSql sqlBody m =
    { m | sql = sqlBody }


-- | Apply pending schema migrations, in list order.
--
-- Each migration whose `name` is not yet recorded runs in its own
-- transaction and is then recorded with a checksum of its SQL.
-- Migrations already recorded are checksum-verified and skipped.
-- Forward-only — there are no down migrations; to undo, ship a new
-- compensating migration.
--
-- Returns the names applied this run (empty when already current).
-- Call once at start-up, before serving:
--
--     migrations : List Migration
--     migrations =
--         [ { name = "0001_users", sql = """
--             CREATE TABLE users (id INTEGER PRIMARY KEY, email TEXT)
--           """ }
--         ]
--
--     Db.connect ()
--         |> Task.andThen (\db -> Db.migrate db migrations)
--
-- ### Tenant-gate bypass (by design)
--
-- `migrate` INTENTIONALLY bypasses the v0.16.6 tenant-prefix WHERE
-- gate (`HubStoreReaderWithTenant`). Schema changes are GLOBAL by
-- design — `CREATE TABLE` / `ALTER TABLE` / index DDL cannot be
-- scoped to a single tenant prefix because they alter the shared
-- physical schema all tenants read from.
--
-- Operational contract:
--
--   * Call `migrate` from a SINGLE deployment-time entry point
--     (`main` at server start-up, or a one-shot `sky db migrate`
--     CLI run).
--   * NEVER call `migrate` from a per-tenant runtime path (request
--     handler, Sky.Live update, scheduled job that fans out per
--     tenant). Doing so would let a tenant-bound code path issue
--     unscoped DDL — the exact escalation the v0.16.6 tenant-prefix
--     gate exists to prevent.
--   * The tenant-prefix gate stays enforced for every other
--     `Db.exec` / `Db.query` / `Db.queryDecode` / `Db.findOneByField`
--     / `Db.findManyByField` / `Db.findByConditions` /
--     `Db.unsafeFindWhere` call — only `migrate` is exempt.
migrate : Db -> List Migration -> Task Error (List String)
migrate db migrations =
    migrateApply db (List.map (\m -> ( m.name, m.sql )) migrations)


-- | Low-level kernel: applies (name, sql) pairs. The record-shaped
-- `Migration` API above is pure-Sky sugar over this.
migrateApply : Db -> List ( String, String ) -> Task Error (List String)
migrateApply =
    Ffi.kernel "Db_migrateApply"


-- ─── Row accessors (read columns from a row) ───────────────────────


-- | Read a field as a String (the canonical row-element shape).
getField : String -> row -> String
getField =
    Ffi.kernel "Db_getField"


getString : String -> row -> String
getString =
    Ffi.kernel "Db_getString"


getInt : String -> row -> Int
getInt =
    Ffi.kernel "Db_getInt"


getBool : String -> row -> Bool
getBool =
    Ffi.kernel "Db_getBool"

-- ─── Typed SQL parameter binding (v0.16.26 — #582) ─────────────────


-- | A typed SQL parameter value for prepared-statement binding.
-- Covers SQLite's 5 storage classes + PostgreSQL's common extensions
-- (Decimal, Time, Bytes, Money). Lets `List SqlValue` flow
-- homogeneously through `Db.exec` / `Db.query` while preserving
-- per-column type-information to the SQL driver.
--
-- Nullability is a VALUE-level property expressed via `SqlNull
-- witness` — the wrapped SqlValue carries a type-tag for the driver
-- (e.g. `SqlNull (SqlInt 0)` means "NULL, Int type"). The wrapped
-- value's data is ignored.
--
-- "Column omitted" (not present in the SQL statement at all) is a
-- SQL-statement-level concern handled by `updateFields` /
-- `insertFields` builders below, not a `SqlValue` variant.
--
-- Money serialises as `"ISO_CODE AMOUNT"` text (e.g. `"USD 1234.56"`)
-- for lossless round-trip via a single TEXT column. For two-column
-- money storage (`amount NUMERIC, currency CHAR(3)`), decompose at
-- the call site: `SqlDecimal (Money.amount m), SqlString
-- (Money.currencyCode (Money.currency m))`.
--
-- Example with mixed types — the call site sky-sqlgen emits:
--
--     Db.exec conn
--         "INSERT INTO orders (id, customer, amount, paid_at) VALUES (?, ?, ?, ?)"
--         [ SqlInt orderId
--         , SqlString customerUuid
--         , SqlMoney total
--         , fromMaybeTime maybePaidAt    -- nullable column
--         ]
type SqlValue
    = SqlString String
    | SqlInt Int
    | SqlFloat Float
    | SqlBool Bool
    | SqlBytes String
    | SqlDecimal Decimal
    | SqlTime Int
    | SqlMoney Money
    | SqlNull SqlValue


-- ─── Maybe-lifting helpers ─────────────────────────────────────────
--
-- Each helper maps `Maybe T` to the corresponding `SqlValue`
-- variant: `Just v` → `SqlT v`, `Nothing` → `SqlNull (SqlT
-- defaultWitness)`. Lets sky-sqlgen and hand-written code emit
-- nullable columns without inline `case-of` boilerplate.
fromMaybeString : Maybe String -> SqlValue
fromMaybeString m =
    case m of

        Just v ->
            SqlString v

        Nothing ->
            -- Witness uses USD as the type-tag carrier; only the
            -- variant tag is read by the driver.
            SqlNull (SqlString "")


fromMaybeInt : Maybe Int -> SqlValue
fromMaybeInt m =
    case m of

        Just v ->
            SqlInt v

        Nothing ->
            SqlNull (SqlInt 0)


fromMaybeFloat : Maybe Float -> SqlValue
fromMaybeFloat m =
    case m of

        Just v ->
            SqlFloat v

        Nothing ->
            SqlNull (SqlFloat 0.0)


fromMaybeBool : Maybe Bool -> SqlValue
fromMaybeBool m =
    case m of

        Just v ->
            SqlBool v

        Nothing ->
            SqlNull (SqlBool False)


fromMaybeBytes : Maybe String -> SqlValue
fromMaybeBytes m =
    case m of

        Just v ->
            SqlBytes v

        Nothing ->
            SqlNull (SqlBytes "")


fromMaybeDecimal : Maybe Decimal -> SqlValue
fromMaybeDecimal m =
    case m of

        Just v ->
            SqlDecimal v

        Nothing ->
            SqlNull (SqlDecimal Decimal.zero)


fromMaybeTime : Maybe Int -> SqlValue
fromMaybeTime m =
    case m of

        Just v ->
            SqlTime v

        Nothing ->
            SqlNull (SqlTime 0)


fromMaybeMoney : Maybe Money -> SqlValue
fromMaybeMoney m =
    case m of

        Just v ->
            SqlMoney v

        Nothing ->
            SqlNull (SqlMoney (Money.zero (Money.parseCurrency "USD")))
-- ─── updateFields / insertFields builders ──────────────────────────


-- | Per-column "what to do" instruction for partial updates.
-- `SetField v` includes the column in the SET clause and binds `v`
-- (which may be `SqlNull witness` for an explicit NULL). `OmitField`
-- drops the column from the SQL statement entirely — the database's
-- existing value is unchanged. This is the third "absent" state SQL
-- requires for PATCH semantics that the per-value `SqlValue` ADT
-- can't express alone (#582 L3).

type SqlField
    = SetField SqlValue
    | OmitField
-- | `updateFields db table whereCols setFields` — PATCH-style update
-- with dynamically-generated SQL. Each `SetField v` becomes a
-- `column = ?` clause; `OmitField` columns are dropped from the SQL
-- entirely so the database keeps their existing value.
--
-- Example: change `email` and explicitly NULL `paid_at`, leave
-- `notes` untouched:
--
--     Db.updateFields conn "users"
--         [ ("id", SqlInt 1) ]
--         [ ("email",   SetField (SqlString "new@example.com"))
--         , ("paid_at", SetField (SqlNull (SqlTime 0)))
--         , ("notes",   OmitField)
--         ]
--     -- generates: UPDATE users SET email = ?, paid_at = ? WHERE id = ?
--     -- args:      [ SqlString "new@example.com"
--     --            , SqlNull (SqlTime 0)
--     --            , SqlInt 1 ]
--
-- Returns the affected-row count.


updateFields : Db -> String -> List ( String, SqlValue ) -> List ( String, SqlField ) -> Task Error Int
updateFields =
    Ffi.kernel "Db_updateFields"


-- | `insertFields db table fields` — DEFAULT-omittable INSERT with
-- dynamically-generated SQL. The INSERT counterpart of
-- `updateFields`: each `SetField v` becomes a `(col)` / `(?)` entry
-- in the column list and VALUES clause; `OmitField` columns are
-- dropped entirely so the database applies their `DEFAULT`.
--
-- Example: insert a row with `name` + `note` set, let the database
-- fill `status` (DEFAULT 'pending') and `created_at` (DEFAULT
-- CURRENT_TIMESTAMP):
--
--     Db.insertFields conn "items"
--         [ ("name",   SetField (SqlString "Widget"))
--         , ("status", OmitField)               -- DEFAULT 'pending'
--         , ("note",   SetField (SqlString "first batch"))
--         ]
--     -- generates: INSERT INTO items (name, note) VALUES (?, ?)
--     -- args:      [ SqlString "Widget"
--     --            , SqlString "first batch" ]
--
-- All columns OmitField → `INSERT INTO <table> DEFAULT VALUES` (a
-- single all-defaults row).  Returns the affected-row count.
insertFields : Db -> String -> List ( String, SqlField ) -> Task Error Int
insertFields =
    Ffi.kernel "Db_insertFields"


-- | `insertFieldsReturning db table fields projection decoder` —
-- the decoding counterpart of `insertFields`.  Same DEFAULT-
-- omittable INSERT (SetField/OmitField three-state), with a
-- `RETURNING <projection>` clause appended; each returned row is
-- decoded through `decoder` and the list returned.
--
-- The projection string is a caller-controlled SQL fragment — the
-- same trust model as `queryDecode`'s SQL.  Supply a column list
-- (`"id, title, body"`), `"*"`, aliases, or SQL expressions; the
-- kernel does NOT validate or rewrite the text.  Schema-derived
-- literals (sky-sqlgen) are safe; user input is not.
--
-- Example: insert a row, let `id` autoincrement + `created_at`
-- default-fill, and decode both back to bind them to the caller:
--
--     Db.insertFieldsReturning conn "items"
--         [ ( "name", SetField (SqlString "Widget") )
--         , ( "note", SetField (SqlString "first batch") )
--         ]
--         "id, created_at"
--         itemReturnDecoder
--     -- → INSERT INTO items (name, note) VALUES (?, ?)
--     --      RETURNING id, created_at
--     -- decodes one row per row affected (typically exactly one)
--
-- Requires SQLite ≥ 3.35 (Mar 2021) or PostgreSQL — same as every
-- other `RETURNING` use already in `Std.Db`.  (#586)
insertFieldsReturning : Db -> String -> List ( String, SqlField ) -> String -> Decoder a -> Task Error (List a)
insertFieldsReturning =
    Ffi.kernel "Db_insertFieldsReturning"
