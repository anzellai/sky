-- | Std.Time — IANA-zone helpers complementing kernel `Time` (Layer 3 Sky source).
--
-- Adds calendar arithmetic that kernel `Sky.Core.Time` doesn't —
-- `addMonths` / `addYears` (month-end CLAMPED so Feb 30 → Feb 28/29),
-- `dayOfWeek` (ISO Mon=1..Sun=7), `weekOfYear` (ISO 8601),
-- `startOfDay` / `startOfWeek` / `startOfMonth` / `startOfYear`,
-- diff helpers in days / hours / minutes / seconds.
--
-- Every fallible IANA-zone lookup ships with an infallible `*Utc`
-- companion (v0.15.48+) — `dayOfWeekUtc` / `startOfDayUtc` /
-- `yearUtc` etc. return `Int -> Int` so server-internal callers
-- don't thread `Result.withDefault 0` for the UTC happy path.
--
-- The full IANA time zone database is embedded in every Sky binary: the
-- server, the CLI and the Sky.Spa wasm client in a browser. Use it. Do not
-- keep your own table of zones or offsets. `zones` lists the zone names,
-- `isZone` checks a name, `toParts` gives a local time in one call,
-- `fromParts` / `fromPartsWith` make an instant from a local time (with an
-- explicit rule for the hour the clocks skip or repeat), and
-- `nextTransition` / `previousTransition` find when a zone's offset
-- changes, for a scheduler.
module Std.Time exposing
    ( inZone
    , formatInZone
    , addMonths
    , addYears
    , addDays
    , addHours
    , addMinutes
    , addSeconds
    , startOfDay
    , endOfDay
    , startOfWeek
    , startOfMonth
    , endOfMonth
    , startOfYear
    , endOfYear
    , year
    , month
    , day
    , dayOfWeek
    , dayOfYear
    , weekOfYear
    , isWeekend
    , daysInMonth
    , isLeapYear
    , diffDays
    , diffHours
    , diffMinutes
    , diffSeconds
    , fromParts
    , Disambiguation(..)
    , fromPartsWith
    , Parts
    , toParts
    , toPartsUtc
    , isZone
    , zones
    , nextTransition
    , previousTransition
    , zoneOffset
    , zoneName
    , utc
    , yearUtc
    , monthUtc
    , dayUtc
    , dayOfWeekUtc
    , dayOfYearUtc
    , weekOfYearUtc
    , isWeekendUtc
    , startOfDayUtc
    , endOfDayUtc
    , startOfWeekUtc
    , startOfMonthUtc
    , endOfMonthUtc
    , startOfYearUtc
    , endOfYearUtc
    )

-- | Std.Time — IANA timezone-aware time helpers.
--
-- Real apps need to display timestamps in the user's local zone,
-- schedule events at "9am London time", do calendar arithmetic
-- ("invoice due 1 month from issue"), and bucket reports by local
-- day boundaries.
--
-- Zones are IANA strings: "UTC", "America/New_York", "Asia/Tokyo".
-- Invalid zone names return `Err Error`. Names are case-sensitive
-- ("europe/london" is an `Err` that names "Europe/London"). The empty name
-- is UTC. "Local" is refused, because it is the host's zone and not an IANA
-- name. Every `Err` from this module is `InvalidInput` with the domain
-- "time" and a code: "UnknownZone", "InvalidDate", "NonexistentLocalTime"
-- or "AmbiguousLocalTime" (`Error.domain`).
--
-- Layer 3 design: thin Sky-source wrappers around the
-- `Ffi.callPure` boundary into runtime-go/rt/time_zones.go.

import Sky.Core.Prelude exposing (..)
import Sky.Core.Error exposing (Error)
import Sky.Ffi as Ffi


-- ─── Shorthand for the UTC zone ─────────────────────────────────
utc : String
utc =
    "UTC"


-- ─── Formatting ────────────────────────────────────────────────
inZone : String -> Int -> Result Error String
inZone zone ms =
    Ffi.callPure "Time_inZone" [ Ffi.toAny zone, Ffi.toAny ms ]


formatInZone : String -> String -> Int -> Result Error String
formatInZone zone layout ms =
    Ffi.callPure
        "Time_formatInZone"
        [ Ffi.toAny zone, Ffi.toAny layout, Ffi.toAny ms ]


-- ─── Calendar arithmetic ───────────────────────────────────────
addMonths : Int -> Int -> Int
addMonths months ms =
    Ffi.callPure "Time_addMonths" [ months, ms ]


addYears : Int -> Int -> Int
addYears years_ ms =
    Ffi.callPure "Time_addYears" [ years_, ms ]


addDays : Int -> Int -> Int
addDays days ms =
    Ffi.callPure "Time_addDays" [ days, ms ]


addHours : Int -> Int -> Int
addHours hours ms =
    Ffi.callPure "Time_addHours" [ hours, ms ]


addMinutes : Int -> Int -> Int
addMinutes minutes ms =
    Ffi.callPure "Time_addMinutes" [ minutes, ms ]


addSeconds : Int -> Int -> Int
addSeconds seconds ms =
    Ffi.callPure "Time_addSeconds" [ seconds, ms ]


-- ─── Period boundaries ─────────────────────────────────────────
startOfDay : String -> Int -> Result Error Int
startOfDay zone ms =
    Ffi.callPure "Time_startOfDay" [ Ffi.toAny zone, Ffi.toAny ms ]


endOfDay : String -> Int -> Result Error Int
endOfDay zone ms =
    Ffi.callPure "Time_endOfDay" [ Ffi.toAny zone, Ffi.toAny ms ]


startOfWeek : String -> Int -> Result Error Int
startOfWeek zone ms =
    Ffi.callPure "Time_startOfWeek" [ Ffi.toAny zone, Ffi.toAny ms ]


startOfMonth : String -> Int -> Result Error Int
startOfMonth zone ms =
    Ffi.callPure "Time_startOfMonth" [ Ffi.toAny zone, Ffi.toAny ms ]


endOfMonth : String -> Int -> Result Error Int
endOfMonth zone ms =
    Ffi.callPure "Time_endOfMonth" [ Ffi.toAny zone, Ffi.toAny ms ]


startOfYear : String -> Int -> Result Error Int
startOfYear zone ms =
    Ffi.callPure "Time_startOfYear" [ Ffi.toAny zone, Ffi.toAny ms ]


endOfYear : String -> Int -> Result Error Int
endOfYear zone ms =
    Ffi.callPure "Time_endOfYear" [ Ffi.toAny zone, Ffi.toAny ms ]


-- ─── Calendar queries ──────────────────────────────────────────
year : String -> Int -> Result Error Int
year zone ms =
    Ffi.callPure "Time_year" [ Ffi.toAny zone, Ffi.toAny ms ]


month : String -> Int -> Result Error Int
month zone ms =
    Ffi.callPure "Time_month" [ Ffi.toAny zone, Ffi.toAny ms ]


day : String -> Int -> Result Error Int
day zone ms =
    Ffi.callPure "Time_day" [ Ffi.toAny zone, Ffi.toAny ms ]


dayOfWeek : String -> Int -> Result Error Int
dayOfWeek zone ms =
    Ffi.callPure "Time_dayOfWeek" [ Ffi.toAny zone, Ffi.toAny ms ]


dayOfYear : String -> Int -> Result Error Int
dayOfYear zone ms =
    Ffi.callPure "Time_dayOfYear" [ Ffi.toAny zone, Ffi.toAny ms ]


weekOfYear : String -> Int -> Result Error Int
weekOfYear zone ms =
    Ffi.callPure "Time_weekOfYear" [ Ffi.toAny zone, Ffi.toAny ms ]


isWeekend : String -> Int -> Result Error Bool
isWeekend zone ms =
    Ffi.callPure "Time_isWeekend" [ Ffi.toAny zone, Ffi.toAny ms ]


daysInMonth : Int -> Int -> Int
daysInMonth y m =
    Ffi.callPure "Time_daysInMonth" [ y, m ]


isLeapYear : Int -> Bool
isLeapYear y =
    Ffi.callPure "Time_isLeapYear" [ y ]


-- ─── Differences ───────────────────────────────────────────────
diffDays : Int -> Int -> Int
diffDays a b =
    Ffi.callPure "Time_diffDays" [ a, b ]


diffHours : Int -> Int -> Int
diffHours a b =
    Ffi.callPure "Time_diffHours" [ a, b ]


diffMinutes : Int -> Int -> Int
diffMinutes a b =
    Ffi.callPure "Time_diffMinutes" [ a, b ]


diffSeconds : Int -> Int -> Int
diffSeconds a b =
    Ffi.callPure "Time_diffSeconds" [ a, b ]


-- ─── Construction from parts ───────────────────────────────────
{-| The instant (Unix ms) of a local time in a zone: `fromParts zone year
month day hour minute second`. It is `fromPartsWith Reject`.

It refuses, with an `Err`:

  - a date that is not in the calendar: 31 April, 29 February in a year
    that is not a leap year, a month outside 1 to 12;
  - a field out of range: a year outside 1 to 9999, an hour outside 0 to
    23, a minute or a second outside 0 to 59 (there are no leap seconds);
  - a local time that does not exist in the zone, because the clocks go
    forward over it (code "NonexistentLocalTime"). 01:30 on 29 March 2026
    in "Europe/London" is one;
  - a local time that exists twice in the zone, because the clocks go back
    over it (code "AmbiguousLocalTime"). 01:30 on 25 October 2026 in
    "Europe/London" is one. The message gives both instants.

Use `fromPartsWith` to choose an instant for the last two cases.

    fromParts "Europe/London" 2026 7 1 9 0 0
    -- Ok 1782892800000 (08:00 UTC)
-}
fromParts : String -> Int -> Int -> Int -> Int -> Int -> Int -> Result Error Int
fromParts zone y m d h mins s =
    Ffi.callPure
        "Time_fromParts"
        [ Ffi.toAny zone
        , Ffi.toAny y
        , Ffi.toAny m
        , Ffi.toAny d
        , Ffi.toAny h
        , Ffi.toAny mins
        , Ffi.toAny s
        ]

{-| What `fromPartsWith` does with a local time that does not exist (a gap:
the clocks go forward) or that exists twice (an overlap: the clocks go
back). The four options are the ones of JavaScript Temporal, with the same
meaning:

  - `Compatible`: the earlier instant of an overlap. For a gap, the local
    time moved forward by the length of the gap (01:30 in a gap from 01:00
    to 02:00 gives 02:30). Most calendar programs do this.
  - `Earlier`: the earlier instant of an overlap. For a gap, the local time
    moved back by the length of the gap (01:30 gives 00:30).
  - `Later`: the later instant of an overlap. For a gap, the same as
    `Compatible`.
  - `Reject`: an `Err` for both. `fromParts` does this.

A local time that exists once gives the same instant for all four.
-}
type Disambiguation
    = Compatible
    | Earlier
    | Later
    | Reject


disambiguationIndex : Disambiguation -> Int
disambiguationIndex d =
    case d of

        Compatible ->
            0

        Earlier ->
            1

        Later ->
            2

        Reject ->
            3


{-| `fromParts` with an explicit rule for a local time in a gap or an
overlap (see `Disambiguation`). The calendar checks of `fromParts` still
apply: 31 April is an `Err` for every rule.

    fromPartsWith Compatible "Europe/London" 2026 3 29 1 30 0
    -- Ok 1774747800000: 02:30 BST, because the clocks skip 01:00 to 02:00
    fromPartsWith Later "America/New_York" 2026 11 1 1 30 0
    -- Ok 1793514600000: 01:30 EST, the second 01:30 of that day
-}
fromPartsWith : Disambiguation -> String -> Int -> Int -> Int -> Int -> Int -> Int -> Result Error Int
fromPartsWith disambiguation zone y m d h mins s =
    Ffi.callPure
        "Time_fromPartsWith"
        [ Ffi.toAny (disambiguationIndex disambiguation)
        , Ffi.toAny zone
        , Ffi.toAny y
        , Ffi.toAny m
        , Ffi.toAny d
        , Ffi.toAny h
        , Ffi.toAny mins
        , Ffi.toAny s
        ]

-- ─── Parts of a local time ──────────────────────────────────────
{-| All parts of an instant as a local time in a zone. `weekday` is ISO:
1 is Monday and 7 is Sunday. `offsetMinutes` is the zone's offset from UTC
at that instant, east positive (60 for BST, -300 for EST, 630 for Lord Howe
in winter). Local mean time before about 1900 can have an offset with
seconds: `offsetMinutes` drops them (towards zero), and `zoneOffset` gives
the offset in seconds. `abbreviation` is the zone's short name at that
instant ("BST", "EST"), or the offset ("+1030") where the zone has no name.
-}
type alias Parts =
    { year : Int
    , month : Int
    , day : Int
    , hour : Int
    , minute : Int
    , second : Int
    , millisecond : Int
    , weekday : Int
    , offsetMinutes : Int
    , abbreviation : String
    }


{-| The local time of an instant (Unix ms) in a zone, all parts in one call.
An unknown zone is an `Err`.

    toParts "Europe/London" 1782905696789
    -- Ok { year = 2026, month = 7, day = 1, hour = 12, minute = 34,
    --      second = 56, millisecond = 789, weekday = 3,
    --      offsetMinutes = 60, abbreviation = "BST" }
-}
toParts : String -> Int -> Result Error Parts
toParts zone ms =
    Ffi.callPure "Time_toParts" [ Ffi.toAny zone, Ffi.toAny ms ]


{-| `toParts` in UTC. It cannot fail. -}
toPartsUtc : Int -> Parts
toPartsUtc ms =
    Ffi.callPure "Time_toPartsUtc" [ Ffi.toAny ms ]


-- ─── Zone names ─────────────────────────────────────────────────
{-| True when the other functions of this module accept the name as a zone:
a canonical IANA name ("Europe/London", "Etc/UTC") or a link to one ("UTC",
"GMT", "Asia/Calcutta", "US/Eastern"). The check is exact and
case-sensitive. The empty name is not a zone (the other functions read it
as UTC), and "Local" is not a zone. Use it to check a zone that a user or a
file gives.
-}
isZone : String -> Bool
isZone name =
    Ffi.callPure "Time_isZone" [ Ffi.toAny name ]


{-| The canonical IANA zone names, sorted: the zones of the embedded
database (for example "Africa/Abidjan", "Europe/London", "Etc/UTC"). Link
names are other names for a zone ("UTC", "GMT", "Asia/Calcutta",
"US/Eastern"). They are not in the list, but `isZone` and every function of
this module accept them. "Factory" is not in the list. Use the list for a
zone picker. It comes from the IANA data of the Go version that Sky builds
with.
-}
zones : List String
zones =
    Ffi.callPure "Time_zones" []


-- ─── Transitions ────────────────────────────────────────────────
{-| The next instant (Unix ms) after `ms` at which the zone's UTC offset or
abbreviation changes: the first millisecond of the new offset. `Nothing`
when there is no change in the 50 years (of 365.2425 days) after `ms`, as
for "Asia/Shanghai" or "UTC". A scheduler uses it to know when "09:00
local" moves against UTC. Times outside the years 1 to 9999 are not
searched.

    nextTransition "Europe/London" 1767225600000
    -- Ok (Just 1774746000000): 2026-03-29 01:00 UTC
-}
nextTransition : String -> Int -> Result Error (Maybe Int)
nextTransition zone ms =
    Ffi.callPure "Time_nextTransition" [ Ffi.toAny zone, Ffi.toAny ms ]


{-| The last instant (Unix ms) before `ms` at which the zone's UTC offset or
abbreviation changed. `Nothing` when there is no change in the 50 years
before `ms`. The result is always before `ms`, so a call on its own result
gives the change before it. To find when the offset in effect at `ms`
started, call it with `ms + 1`.
-}
previousTransition : String -> Int -> Result Error (Maybe Int)
previousTransition zone ms =
    Ffi.callPure "Time_previousTransition" [ Ffi.toAny zone, Ffi.toAny ms ]


-- ─── Zone discovery ────────────────────────────────────────────
zoneOffset : String -> Int -> Result Error Int
zoneOffset zone ms =
    Ffi.callPure "Time_zoneOffset" [ Ffi.toAny zone, Ffi.toAny ms ]


zoneName : String -> Int -> Result Error String
zoneName zone ms =
    Ffi.callPure "Time_zoneName" [ Ffi.toAny zone, Ffi.toAny ms ]


-- ─── UTC infallible companions (v0.15.48) ──────────────────────
--
-- The `*Utc` variants plug the IANA-zone lookup at the call site
-- with `"UTC"` (always valid → no fallible `Result Error _`
-- wrap), so callers that don't need TZ-awareness don't have to
-- thread a `Result.withDefault 0` everywhere.
--
-- The full zone-aware fn stays canonical; reach for `*Utc` only
-- when you're already operating on canonical UTC unix millis
-- (e.g. server-internal timestamps, log lines, audit rows).
yearUtc : Int -> Int
yearUtc ms =
    case year utc ms of

        Ok v ->
            v

        Err _ ->
            0


monthUtc : Int -> Int
monthUtc ms =
    case month utc ms of

        Ok v ->
            v

        Err _ ->
            0


dayUtc : Int -> Int
dayUtc ms =
    case day utc ms of

        Ok v ->
            v

        Err _ ->
            0


dayOfWeekUtc : Int -> Int
dayOfWeekUtc ms =
    case dayOfWeek utc ms of

        Ok v ->
            v

        Err _ ->
            0


dayOfYearUtc : Int -> Int
dayOfYearUtc ms =
    case dayOfYear utc ms of

        Ok v ->
            v

        Err _ ->
            0


weekOfYearUtc : Int -> Int
weekOfYearUtc ms =
    case weekOfYear utc ms of

        Ok v ->
            v

        Err _ ->
            0


isWeekendUtc : Int -> Bool
isWeekendUtc ms =
    case isWeekend utc ms of

        Ok v ->
            v

        Err _ ->
            False


startOfDayUtc : Int -> Int
startOfDayUtc ms =
    case startOfDay utc ms of

        Ok v ->
            v

        Err _ ->
            ms


endOfDayUtc : Int -> Int
endOfDayUtc ms =
    case endOfDay utc ms of

        Ok v ->
            v

        Err _ ->
            ms


startOfWeekUtc : Int -> Int
startOfWeekUtc ms =
    case startOfWeek utc ms of

        Ok v ->
            v

        Err _ ->
            ms


startOfMonthUtc : Int -> Int
startOfMonthUtc ms =
    case startOfMonth utc ms of

        Ok v ->
            v

        Err _ ->
            ms


endOfMonthUtc : Int -> Int
endOfMonthUtc ms =
    case endOfMonth utc ms of

        Ok v ->
            v

        Err _ ->
            ms


startOfYearUtc : Int -> Int
startOfYearUtc ms =
    case startOfYear utc ms of

        Ok v ->
            v

        Err _ ->
            ms


endOfYearUtc : Int -> Int
endOfYearUtc ms =
    case endOfYear utc ms of

        Ok v ->
            v

        Err _ ->
            ms
