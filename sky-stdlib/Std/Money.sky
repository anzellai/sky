-- ─── Arithmetic (currency-checked) ────────────────────────────────
add : Money -> Money -> Result Error Money
add a b =
    if eqCurrency (currency a) (currency b) then
        Ok (Money (Dec.add (amount a) (amount b)) (currency a))

    else
        Err (mismatch "add" a b)


sub : Money -> Money -> Result Error Money
sub a b =
    if eqCurrency (currency a) (currency b) then
        Ok (Money (Dec.sub (amount a) (amount b)) (currency a))

    else
        Err (mismatch "sub" a b)


-- The error both `add` and `sub` raise on a currency mismatch.
--
-- Naming both operands matters: the failure is that two DIFFERENT currencies met,
-- so a message that names only one of them leaves the reader guessing which call
-- site produced the other.
mismatch : String -> Money -> Money -> Error
mismatch op a b =
    Error.invalidInput
        ("Money." ++ op ++ ": currency mismatch — " ++ currencyCode (currency a)
            ++ " vs "
            ++ currencyCode (currency b)
            ++ ". Convert one side first (Money.convert) — there is no exchange rate here to apply.")


-- | Multiply by a scalar (Decimal). Currency carries through.
mul : Decimal -> Money -> Money
mul k m =
    Money (Dec.mul k (amount m)) (currency m)


neg : Money -> Money
neg m =
    Money (Dec.neg (amount m)) (currency m)


abs : Money -> Money
abs m =
    Money (Dec.abs (amount m)) (currency m)


-- | Allocate a Money value across N parts as evenly as possible,
-- with any remainder distributed 1 cent at a time to the front.
-- The sum of returned parts equals the input exactly.
--
--   allocate 3 ($100.00)  → [$33.34, $33.33, $33.33]
allocate : Int -> Money -> List Money
allocate parts m =
    let
        decimals =
            Ffi.callPure
                "Money_allocate"
                [ Ffi.toAny (minorUnits (currency m))
                , Ffi.toAny parts
                , Ffi.toAny (amount m)
                ]
    in
        List.map (\d -> Money d (currency m)) decimals


-- | Sum a list of Money values (all should be same currency).
-- Sum a list of `Money`, all of which must be in currency `c`.
--
-- Returns `Err` on the first entry that is not — it inherited `add`'s old
-- behaviour of returning the accumulator unchanged, so a single EUR row in a
-- list of USD rows was dropped from the total in silence. A total that quietly
-- omits a line is worse than one that fails: it reconciles against nothing and
-- nobody knows to look.
sumOf : Currency -> List Money -> Result Error Money
sumOf c xs =
    sumOfHelp xs (Ok (zero c))


sumOfHelp : List Money -> Result Error Money -> Result Error Money
sumOfHelp xs acc =
    case xs of

        [] ->
            acc

        first :: rest ->
            case acc of

                Err e ->
                    Err e

                Ok a ->
                    sumOfHelp rest (add a first)


-- ─── Comparison ───────────────────────────────────────────────────
-- Order by currency FIRST, then by amount.
--
-- Comparing bare magnitudes across currencies is meaningless — 100 USD is not
-- 100 EUR at any exchange rate but 1.0 — and this returned `0` for that pair,
-- which meant `compare` disagreed with `eq` (which does check currency). A sort
-- over mixed-currency `Money` silently interleaved them by magnitude alone, and
-- any binary search or dedup built on `compare` was wrong without saying so.
--
-- Ordering by ISO code first groups each currency together and keeps amounts
-- ordered within it. That is the only total order on `Money` that does not
-- invent a conversion rate, and it makes `compare a b == 0` agree with `eq a b`.
compare : Money -> Money -> Int
compare a b =
    let
        ca = currencyCode (currency a)
        cb = currencyCode (currency b)
    in
        if ca == cb then
            Dec.compare (amount a) (amount b)

        else if ca < cb then
            -1

        else
            1


eq : Money -> Money -> Bool
eq a b =
    eqCurrency (currency a) (currency b) && Dec.eq (amount a) (amount b)


neq : Money -> Money -> Bool
neq a b =
    not (eq a b)


lt : Money -> Money -> Bool
lt a b =
    Dec.lt (amount a) (amount b)


lte : Money -> Money -> Bool
lte a b =
    Dec.lte (amount a) (amount b)


gt : Money -> Money -> Bool
gt a b =
    Dec.gt (amount a) (amount b)


gte : Money -> Money -> Bool
gte a b =
    Dec.gte (amount a) (amount b)


eqCurrency : Currency -> Currency -> Bool
eqCurrency a b =
    currencyCode a == currencyCode b


-- ─── Predicates ───────────────────────────────────────────────────
isZero : Money -> Bool
isZero m =
    Dec.isZero (amount m)


isPositive : Money -> Bool
isPositive m =
    Dec.isPositive (amount m)


isNegative : Money -> Bool
isNegative m =
    Dec.isNegative (amount m)


-- ─── Percent helpers ──────────────────────────────────────────────
percentOf : Decimal -> Money -> Money
percentOf pct m =
    Money (Dec.percentOf pct (amount m)) (currency m)


addPercent : Decimal -> Money -> Money
addPercent pct m =
    Money (Dec.addPercent pct (amount m)) (currency m)


subPercent : Decimal -> Money -> Money
subPercent pct m =
    Money (Dec.subPercent pct (amount m)) (currency m)


-- ─── Formatting + minor extraction ────────────────────────────────
-- | Default symbol-prefixed form: "$12.34", "¥1234" (JPY).
format : Money -> String
format m =
    Ffi.callPure
        "Money_format"
        [ Ffi.toAny (currencyCode (currency m)), Ffi.toAny (amount m) ]


-- | ISO-code suffix form: "12.34 USD". Preferred for B2B.
formatWithCode : Money -> String
formatWithCode m =
    Ffi.callPure
        "Money_formatWithCode"
        [ Ffi.toAny (currencyCode (currency m)), Ffi.toAny (amount m) ]


-- | Integer-cents representation, for DB persistence.
toMinor : Money -> Int
toMinor m =
    Dec.toMinor (minorUnits (currency m)) (amount m)


-- ─── FX rate registry ─────────────────────────────────────────────
setRate : Currency -> Currency -> Decimal -> Result Error ()
setRate from to rate =
    Ffi.callPure
        "Money_setRate"
        [ Ffi.toAny (currencyCode from)
        , Ffi.toAny (currencyCode to)
        , Ffi.toAny rate
        ]


getRate : Currency -> Currency -> Result Error Decimal
getRate from to =
    Ffi.callPure "Money_getRate" [ currencyCode from, currencyCode to ]


hasRate : Currency -> Currency -> Bool
hasRate from to =
    Ffi.callPure "Money_hasRate" [ currencyCode from, currencyCode to ]


clearRates : () -> Result Error ()
clearRates _ =
    Ffi.callPure "Money_clearRates" []


-- | Convert Money to a target currency using the registered rate.
convert : Currency -> Money -> Result Error Money
convert to m =
    if eqCurrency (currency m) to then
        Ok m

    else
        case getRate (currency m) to of

            Ok rate ->
                Ok (Money (Dec.mul rate (amount m)) to)

            Err e ->
                Err e
