-- | Std.Money — currency-typed Money on `Std.Decimal` (Layer 3 Sky source).
--
-- `Money` carries both magnitude and ISO-4217 currency code in one
-- typed value.  `add` / `sub` / `sumOf` are exact within a currency and
-- return `Err` across currencies — they do NOT silently pick one side.
-- Convert first with `convert` (which needs a registered rate).
--
-- 50+ ISO-4217 codes baked in (USD, EUR, GBP, JPY, AUD, …) plus
-- crypto (BTC, ETH).  `allocate` splits amounts fairly so rounding
-- residue lands deterministically on the first allocator (handles
-- the classic "split $1.00 three ways" problem without losing or
-- inventing cents).
--
-- Serialise as `"ISO_CODE AMOUNT"` TEXT for DB / wire — `Std.Db.Sql`
-- ships `SqlMoney` + `Db.Decode.money` for round-trip without manual
-- formatting.
module Std.Money exposing
    ( Money(..)
    , Currency(..)
    , fromMinor
    , fromMajor
    , fromString
    , zero
    , zeroOf
    , amount
    , currency
    , currencyCode
    , add
    , sub
    , mul
    , allocate
    , sumOf
    , neg
    , abs
    , eq
    , neq
    , lt
    , lte
    , gt
    , gte
    , compare
    , isZero
    , isPositive
    , isNegative
    , format
    , formatWithCode
    , toMinor
    , percentOf
    , addPercent
    , subPercent
    , minorUnits
    , symbol
    , currencyName
    , knownCurrency
    , isKnownCode
    , parseCurrency
    , setRate
    , getRate
    , hasRate
    , clearRates
    , convert
    )

-- | Std.Money — production-grade currency arithmetic.
--
-- Built on Std.Decimal for exact math, with ISO 4217 minor-unit
-- awareness (JPY rounds to 0 dp, USD to 2 dp, BHD to 3 dp). All
-- arithmetic enforces currency-match.
--
-- Currency is a typed enum of the ~50 most-used codes plus
-- `CurrencyRaw String` for the long tail. Underlying property
-- lookup (minor units, symbol, name) routes through the runtime
-- table; unknown codes fall back to (2 dp, code-as-symbol).
--
-- Pluggable FX rate registry: register rates at startup, use
-- `convert` to apply. The registry is process-local — multi-
-- instance deployments need a shared source for consistency.
--
-- Common patterns:
--
--   -- Tax: 8.875% NYC sales tax on $99.99
--   let subTotal = Money.fromString USD "99.99"
--                      |> Result.withDefault (Money.zero USD)
--       tax = Money.percentOf taxRate subTotal
--   in
--   Money.add subTotal tax           -- Result Error Money
--       |> Result.map Money.format   -- Ok "$108.87"
--
--   -- Both operands are USD here, so the Err arm is unreachable in
--   -- THIS example — but it is reachable the moment a second currency
--   -- enters the program, which is exactly when you want to hear about
--   -- it rather than silently total one side.
--
--   -- Split: $100 invoice across 3 fairly
--   Money.allocate 3 (Money.fromMajor USD 100)
--       -- → [$33.34, $33.33, $33.33]
--
--   -- Convert: $100 USD → EUR (rate set at startup)
--   Money.setRate USD EUR (Dec.fromString "0.92" |> okOrZero)
--   Money.convert EUR (Money.fromMajor USD 100)   -- → Ok €92.00

import Sky.Core.Prelude exposing (..)
import Sky.Core.Error as Error exposing (Error)
import Sky.Core.List as List
import Sky.Ffi as Ffi
import Std.Decimal as Dec exposing (Decimal)

-- ─── Currency enum ────────────────────────────────────────────────
type Currency
    = USD
    | EUR
    | GBP
    | JPY
    | CHF
    | AUD
    | CAD
    | NZD
    | SEK
    | NOK
    | DKK
    | CNY
    | HKD
    | SGD
    | KRW
    | TWD
    | INR
    | THB
    | MYR
    | IDR
    | PHP
    | VND
    | BRL
    | MXN
    | ARS
    | CLP
    | ZAR
    | TRY
    | RUB
    | UAH
    | PLN
    | CZK
    | HUF
    | RON
    | BGN
    | AED
    | SAR
    | QAR
    | KWD
    | BHD
    | OMR
    | JOD
    | ILS
    | EGP
    | NGN
    | KES
    | GHS
    | MAD
    | TND
    | DZD
    | PKR
    | BDT
    | LKR
    | NPR
    | BTC
    | ETH
    | USDT
    | USDC
    | CurrencyRaw String

-- ─── The Money ADT ────────────────────────────────────────────────
type Money
    = Money Decimal Currency


-- ─── Construction ─────────────────────────────────────────────────
fromMinor : Currency -> Int -> Money
fromMinor c minor =
    Money (Dec.fromMinor (minorUnits c) minor) c


fromMajor : Currency -> Int -> Money
fromMajor c n =
    Money (Dec.fromInt n) c


fromString : Currency -> String -> Result Error Money
fromString c s =
    case Dec.fromString s of

        Ok d ->
            Ok (Money d c)

        Err e ->
            Err e


zero : Currency -> Money
zero c =
    Money Dec.zero c


zeroOf : Money -> Money
zeroOf m =
    Money Dec.zero (currency m)


-- ─── Accessors ────────────────────────────────────────────────────
amount : Money -> Decimal
amount (Money d _) =
    d


currency : Money -> Currency
currency (Money _ c) =
    c


currencyCode : Currency -> String
currencyCode c =
    case c of

        USD ->
            "USD"

        EUR ->
            "EUR"

        GBP ->
            "GBP"

        JPY ->
            "JPY"

        CHF ->
            "CHF"

        AUD ->
            "AUD"

        CAD ->
            "CAD"

        NZD ->
            "NZD"

        SEK ->
            "SEK"

        NOK ->
            "NOK"

        DKK ->
            "DKK"

        CNY ->
            "CNY"

