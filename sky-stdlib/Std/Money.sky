-- | Std.Money — currency-typed Money on `Std.Decimal` (Layer 3 Sky source).
--
-- `Money` carries both magnitude and ISO-4217 currency code in one
-- typed value.
--
-- **The one rule.** Every operation that combines two Money values by
-- arithmetic or by order returns a `Result Error _`: `add`, `sub`, `sum`,
-- `compare`, `lt`, `lte`, `gt` and `gte`. Two different currencies are an
-- `Err` (kind `InvalidInput`) that names both currencies, never a value and
-- never a crash. `convert` one side with explicit `Rates` first. The one
-- exception is equality: `eq` and `neq` are plain `Bool`, because two
-- amounts in different currencies are simply not equal.
--
-- Scaling one Money value stays total: `mul`, `neg`, `abs`, `percentOf`,
-- `addPercent`, `subPercent`, `allocate` and the predicates `isZero`,
-- `isPositive` and `isNegative`.
--
-- 50+ ISO-4217 codes baked in (USD, EUR, GBP, JPY, AUD, …) plus
-- crypto (BTC, ETH), and `CurrencyRaw String` for any other code. A code is
-- read in upper case: `CurrencyRaw "gbp"` is GBP to every operation and codec.
-- `allocate` splits amounts fairly so rounding residue lands
-- deterministically on the first allocator (handles the classic "split
-- $1.00 three ways" problem without losing or inventing cents).
--
-- Store it with `Std.Codec`: `Codec.moneyIn GBP` keeps one currency in an
-- exact decimal column a `Std.Db.Store` can sum and order, and
-- `Codec.moneyObject` (the JSON `Codec.auto` writes) keeps any currency as
-- `{"amount": "12.34", "currency": "GBP"}`. Raw SQL binds `SqlMoney` as the
-- text `"GBP 12.34"`, and `Db.Decode.money` reads it back (it also reads
-- `"12.34 GBP"`, the `formatWithCode` form).
--
-- Common patterns:
--
--   -- Tax: 8.875% NYC sales tax on $99.99
--   subTotal = Money.fromString USD "99.99"
--   total = Result.andThen (\s -> Money.add s (Money.percentOf taxRate s)) subTotal
--   Result.map Money.format total       -- Ok "$108.87"
--
--   -- Split: $100 invoice across 3 fairly
--   Money.allocate 3 (Money.fromMajor USD 100)
--       -- → [$33.34, $33.33, $33.33]
--
--   -- Convert: $100 USD → EUR with an explicit rate table
--   fx = Money.rates [ ( USD, EUR, usdToEur ) ]
--   Money.convert fx EUR (Money.fromMajor USD 100)   -- → Ok €92.00
module Std.Money exposing
    ( Money(..)
    , Currency(..)
    , fromMinor
    , fromMajor
    , fromString
    , zero
    , amount
    , currency
    , currencyCode
    , currencyFromCode
    , add
    , sub
    , sum
    , mul
    , allocate
    , neg
    , abs
    , eq
    , neq
    , lt
    , lte
    , gt
    , gte
    , compare
    , eqCurrency
    , isZero
    , isPositive
    , isNegative
    , format
    , formatWithCode
    , toMinor
    , percentOf
    , addPercent
    , subPercent
    , minorUnits
    , symbol
    , currencyName
    , Rates
    , rates
    , rate
    , convert
    )

import Sky.Core.Prelude exposing (..)
import Sky.Core.Error as Error exposing (Error)
import Sky.Core.List as List
import Sky.Core.String as String
import Sky.Core.Result as Result
import Sky.Ffi as Ffi
import Std.Decimal as Dec exposing (Decimal)

-- ─── Currency enum ────────────────────────────────────────────────
type Currency
    = USD
    | EUR
    | GBP
    | JPY
    | CHF
    | AUD
    | CAD
    | NZD
    | SEK
    | NOK
    | DKK
    | CNY
    | HKD
    | SGD
    | KRW
    | TWD
    | INR
    | THB
    | MYR
    | IDR
    | PHP
    | VND
    | BRL
    | MXN
    | ARS
    | CLP
    | ZAR
    | TRY
    | RUB
    | UAH
    | PLN
    | CZK
    | HUF
    | RON
    | BGN
    | AED
    | SAR
    | QAR
    | KWD
    | BHD
    | OMR
    | JOD
    | ILS
    | EGP
    | NGN
    | KES
    | GHS
    | MAD
    | TND
    | DZD
    | PKR
    | BDT
    | LKR
    | NPR
    | BTC
    | ETH
    | USDT
    | USDC
    | CurrencyRaw String

-- ─── The Money ADT ────────────────────────────────────────────────
type Money
    = Money Decimal Currency


-- ─── Construction ─────────────────────────────────────────────────
fromMinor : Currency -> Int -> Money
fromMinor c minor =
    Money (Dec.fromMinor (minorUnits c) minor) c


fromMajor : Currency -> Int -> Money
fromMajor c n =
    Money (Dec.fromInt n) c


fromString : Currency -> String -> Result Error Money
fromString c s =
    case Dec.fromString s of

        Ok d ->
            Ok (Money d c)

        Err _ ->
            -- Name the call the user made, not the Decimal parse under it.
            Err
                (Error.decode
                    ("Money.fromString: \"" ++ String.left 64 s
                        ++ "\" is not a decimal amount (see Decimal.fromString)"))


zero : Currency -> Money
zero c =
    Money Dec.zero c


-- ─── Accessors ────────────────────────────────────────────────────
amount : Money -> Decimal
amount (Money d _) =
    d


currency : Money -> Currency
currency (Money _ c) =
    c


-- | The code of a currency, in upper case (`CurrencyRaw "gbp"` is `"GBP"`).
currencyCode : Currency -> String
currencyCode c =
    case c of

        USD ->
            "USD"

        EUR ->
            "EUR"

        GBP ->
            "GBP"

        JPY ->
            "JPY"

        CHF ->
            "CHF"

        AUD ->
            "AUD"

        CAD ->
            "CAD"

        NZD ->
            "NZD"

        SEK ->
            "SEK"

        NOK ->
            "NOK"

        DKK ->
            "DKK"

        CNY ->
            "CNY"

        HKD ->
            "HKD"

        SGD ->
            "SGD"

        KRW ->
            "KRW"

        TWD ->
            "TWD"

        INR ->
            "INR"

        THB ->
            "THB"

        MYR ->
            "MYR"

        IDR ->
            "IDR"

        PHP ->
            "PHP"

        VND ->
            "VND"

        BRL ->
            "BRL"

        MXN ->
            "MXN"

        ARS ->
            "ARS"

        CLP ->
            "CLP"

        ZAR ->
            "ZAR"

        TRY ->
            "TRY"

        RUB ->
            "RUB"

        UAH ->
            "UAH"

        PLN ->
            "PLN"

        CZK ->
            "CZK"

        HUF ->
            "HUF"

        RON ->
            "RON"

        BGN ->
            "BGN"

        AED ->
            "AED"

        SAR ->
            "SAR"

        QAR ->
            "QAR"

        KWD ->
            "KWD"

        BHD ->
            "BHD"

        OMR ->
            "OMR"

        JOD ->
            "JOD"

        ILS ->
            "ILS"

        EGP ->
            "EGP"

        NGN ->
            "NGN"

        KES ->
            "KES"

        GHS ->
            "GHS"

        MAD ->
            "MAD"

        TND ->
            "TND"

        DZD ->
            "DZD"

        PKR ->
            "PKR"

        BDT ->
            "BDT"

        LKR ->
            "LKR"

        NPR ->
            "NPR"

        BTC ->
            "BTC"

        ETH ->
            "ETH"

        USDT ->
            "USDT"

        USDC ->
            "USDC"

        CurrencyRaw s ->
            -- A code is read in upper case everywhere (v0.29.2 sixth Judge):
            -- `CurrencyRaw "gbp"` is GBP to `eqCurrency`, `add`, `rates` and
            -- every codec, which read `"gbp"` as GBP.
            String.toUpper s


-- ─── Currency property lookups ────────────────────────────────────
minorUnits : Currency -> Int
minorUnits c =
    Ffi.callPure "Money_minorUnits" [ currencyCode c ]


symbol : Currency -> String
symbol c =
    Ffi.callPure "Money_symbol" [ currencyCode c ]


currencyName : Currency -> String
currencyName c =
    Ffi.callPure "Money_currencyName" [ currencyCode c ]


-- | The Currency of an ISO 4217 code, or `Nothing` for text that is not a
-- code. The grammar is the one the strict decoders use (`Codec.moneyObject`,
-- `Codec.isoCurrency`): 3 to 10 ASCII letters or digits, read in upper case,
-- with nothing around them. A code Sky names is its variant (`"GBP"` is
-- `Just GBP`, `"gbp"` too); any other code is `Just (CurrencyRaw code)`;
-- `""`, `" GBP"` and `"GB P"` are `Nothing`.
currencyFromCode : String -> Maybe Currency
currencyFromCode code =
    let
        n = String.length code
    in
        if n >= 3 && n <= 10 && allCodeChars (String.toList code) then
            Just (currencyOfCode (String.toUpper code))

        else
            Nothing


allCodeChars : List Char -> Bool
allCodeChars cs =
    case cs of

        [] ->
            True

        c :: rest ->
            isCodeChar c && allCodeChars rest


-- An ASCII letter or digit (the strict decoders' code grammar).
isCodeChar : Char -> Bool
isCodeChar c =
    (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9')


-- The variant of an upper-case code that is already valid.
currencyOfCode : String -> Currency
currencyOfCode code =
    case code of

        "USD" ->
            USD

        "EUR" ->
            EUR

        "GBP" ->
            GBP

        "JPY" ->
            JPY

        "CHF" ->
            CHF

        "AUD" ->
            AUD

        "CAD" ->
            CAD

        "NZD" ->
            NZD

        "SEK" ->
            SEK

        "NOK" ->
            NOK

        "DKK" ->
            DKK

        "CNY" ->
            CNY

        "HKD" ->
            HKD

        "SGD" ->
            SGD

        "KRW" ->
            KRW

        "TWD" ->
            TWD

        "INR" ->
            INR

        "THB" ->
            THB

        "MYR" ->
            MYR

        "IDR" ->
            IDR

        "PHP" ->
            PHP

        "VND" ->
            VND

        "BRL" ->
            BRL

        "MXN" ->
            MXN

        "ARS" ->
            ARS

        "CLP" ->
            CLP

        "ZAR" ->
            ZAR

        "TRY" ->
            TRY

        "RUB" ->
            RUB

        "UAH" ->
            UAH

        "PLN" ->
            PLN

        "CZK" ->
            CZK

        "HUF" ->
            HUF

        "RON" ->
            RON

        "BGN" ->
            BGN

        "AED" ->
            AED

        "SAR" ->
            SAR

        "QAR" ->
            QAR

        "KWD" ->
            KWD

        "BHD" ->
            BHD

        "OMR" ->
            OMR

        "JOD" ->
            JOD

        "ILS" ->
            ILS

        "EGP" ->
            EGP

        "NGN" ->
            NGN

        "KES" ->
            KES

        "GHS" ->
            GHS

        "MAD" ->
            MAD

        "TND" ->
            TND

        "DZD" ->
            DZD

        "PKR" ->
            PKR

        "BDT" ->
            BDT

        "LKR" ->
            LKR

        "NPR" ->
            NPR

        "BTC" ->
            BTC

        "ETH" ->
            ETH

        "USDT" ->
            USDT

        "USDC" ->
            USDC

        other ->
            CurrencyRaw other


-- ─── Arithmetic (one currency) ────────────────────────────────────
-- | The sum of two Money values. Two currencies are an `Err` naming both
-- (convert one side first).
--
--     Money.add (Money.fromMajor GBP 1) (Money.fromMajor GBP 2)  -- Ok 3.00 GBP
--     Money.add (Money.fromMajor GBP 1) (Money.fromMajor USD 2)  -- Err
add : Money -> Money -> Result Error Money
add a b =
    if eqCurrency (currency a) (currency b) then
        Ok (Money (Dec.add (amount a) (amount b)) (currency a))

    else
        Err (mismatch "add" a b)


-- | `a` minus `b`. Two currencies are an `Err`, as `add`.
sub : Money -> Money -> Result Error Money
sub a b =
    if eqCurrency (currency a) (currency b) then
        Ok (Money (Dec.sub (amount a) (amount b)) (currency a))

    else
        Err (mismatch "sub" a b)


-- | The sum of a list of Money values in `c` (`zero c` for an empty list). A
-- value in any other currency is an `Err` naming both currencies.
sum : Currency -> List Money -> Result Error Money
sum c xs =
    sumHelp xs (zero c)


sumHelp : List Money -> Money -> Result Error Money
sumHelp xs acc =
    case xs of

        [] ->
            Ok acc

        first :: rest ->
            if eqCurrency (currency acc) (currency first) then
                sumHelp
                    rest
                    (Money (Dec.add (amount acc) (amount first)) (currency acc))

            else
                Err (mismatch "sum" acc first)


-- Two currencies in one operation: the `InvalidInput` Err every combining
-- operation returns.
mismatch : String -> Money -> Money -> Error
mismatch verb a b =
    Error.invalidInput
        ("Money." ++ verb ++ ": " ++ currencyCode (currency a) ++ " and "
            ++ currencyCode (currency b)
            ++ " are different currencies; convert one side first (Money.convert)")


-- | Multiply by a scalar (Decimal). Currency carries through.
mul : Decimal -> Money -> Money
mul k m =
    Money (Dec.mul k (amount m)) (currency m)


neg : Money -> Money
neg m =
    Money (Dec.neg (amount m)) (currency m)


abs : Money -> Money
abs m =
    Money (Dec.abs (amount m)) (currency m)


-- | Allocate a Money value across N parts as evenly as possible,
-- with any remainder distributed 1 cent at a time to the front.
-- The sum of returned parts equals the input exactly. Every part is a
-- whole number of minor units, except that digits of the amount below the
-- minor unit (1.005 USD, from `mul`, `percentOf` or `convert`) go to the
-- first part: `allocate 3` of 1.005 USD is [0.345, 0.33, 0.33] (v0.29.2).
--
--   allocate 3 ($100.00)  → [$33.34, $33.33, $33.33]
allocate : Int -> Money -> List Money
allocate parts m =
    let
        decimals =
            Ffi.callPure
                "Money_allocate"
                [ Ffi.toAny (minorUnits (currency m))
                , Ffi.toAny parts
                , Ffi.toAny (amount m)
                ]
    in
        List.map (\d -> Money d (currency m)) decimals


-- ─── Comparison ───────────────────────────────────────────────────
-- | The order of two amounts in one currency: `-1`, `0` or `1`. Two
-- currencies have no order: an `Err` naming both. To sort Money values in
-- one currency, sort by `amount` (`List.sortWith (\a b -> Decimal.compare
-- (Money.amount a) (Money.amount b))`).
compare : Money -> Money -> Result Error Int
compare a b =
    if eqCurrency (currency a) (currency b) then
        Ok (Dec.compare (amount a) (amount b))

    else
        Err (mismatch "compare" a b)


-- | Equal amount AND equal currency. The one combining operation that is
-- total: two amounts in different currencies are not equal (`False`).
eq : Money -> Money -> Bool
eq a b =
    eqCurrency (currency a) (currency b) && Dec.eq (amount a) (amount b)


-- | `not (eq a b)`: `True` for two different currencies.
neq : Money -> Money -> Bool
neq a b =
    not (eq a b)


-- | `a < b` in one currency; an `Err` for two currencies.
lt : Money -> Money -> Result Error Bool
lt a b =
    if eqCurrency (currency a) (currency b) then
        Ok (Dec.lt (amount a) (amount b))

    else
        Err (mismatch "lt" a b)


-- | `a <= b` in one currency; an `Err` for two currencies.
lte : Money -> Money -> Result Error Bool
lte a b =
    if eqCurrency (currency a) (currency b) then
        Ok (Dec.lte (amount a) (amount b))

    else
        Err (mismatch "lte" a b)


-- | `a > b` in one currency; an `Err` for two currencies.
gt : Money -> Money -> Result Error Bool
gt a b =
    if eqCurrency (currency a) (currency b) then
        Ok (Dec.gt (amount a) (amount b))

    else
        Err (mismatch "gt" a b)


-- | `a >= b` in one currency; an `Err` for two currencies.
gte : Money -> Money -> Result Error Bool
gte a b =
    if eqCurrency (currency a) (currency b) then
        Ok (Dec.gte (amount a) (amount b))

    else
        Err (mismatch "gte" a b)


-- | Two currencies are the same when their codes are, in upper case:
-- `CurrencyRaw "gbp"` is `GBP` (as `currencyFromCode "gbp"` is, and as every
-- codec reads it). Compare Money with `eq`, not `==`: `==` also compares how
-- the currency was written (`CurrencyRaw "gbp"` is not the variant `GBP`).
eqCurrency : Currency -> Currency -> Bool
eqCurrency a b =
    currencyCode a == currencyCode b


-- ─── Predicates ───────────────────────────────────────────────────
isZero : Money -> Bool
isZero m =
    Dec.isZero (amount m)


isPositive : Money -> Bool
isPositive m =
    Dec.isPositive (amount m)


isNegative : Money -> Bool
isNegative m =
    Dec.isNegative (amount m)


-- ─── Percent helpers ──────────────────────────────────────────────
percentOf : Decimal -> Money -> Money
percentOf pct m =
    Money (Dec.percentOf pct (amount m)) (currency m)


addPercent : Decimal -> Money -> Money
addPercent pct m =
    Money (Dec.addPercent pct (amount m)) (currency m)


subPercent : Decimal -> Money -> Money
subPercent pct m =
    Money (Dec.subPercent pct (amount m)) (currency m)


-- ─── Formatting + minor extraction ────────────────────────────────
-- | Default symbol-prefixed form: "$12.34", "¥1234" (JPY).
format : Money -> String
format m =
    Ffi.callPure
        "Money_format"
        [ Ffi.toAny (currencyCode (currency m)), Ffi.toAny (amount m) ]


-- | ISO-code suffix form: "12.34 USD". Preferred for B2B.
formatWithCode : Money -> String
formatWithCode m =
    Ffi.callPure
        "Money_formatWithCode"
        [ Ffi.toAny (currencyCode (currency m)), Ffi.toAny (amount m) ]


-- | The amount in minor units (cents for USD). An amount whose minor units
-- do not fit a 64-bit Int fails as the classified `NumericOverflow`
-- (v0.29.2), never a wrapped number: ETH has 18 minor units, so that is from
-- 9.22 ETH up. To store any amount exactly, use `Codec.moneyIn` or
-- `Codec.moneyObject` rather than the minor units.
toMinor : Money -> Int
toMinor m =
    Dec.toMinor (minorUnits (currency m)) (amount m)

-- ─── Exchange rates ───────────────────────────────────────────────
-- | A table of exchange rates: a value you build and pass, not a global.
-- Opaque; make it with `rates`, read it with `rate`, use it with `convert`.
type Rates
    = Rates (List ( String, String, Decimal ))


-- | A rate table from `( from, to, rate )` triples: one unit of `from` is
-- worth `rate` units of `to`. A rate that is zero or negative is left out
-- (`convert` then has no rate for that pair). A later triple for the same
-- pair wins over an earlier one.
--
--     fx = Money.rates [ ( USD, EUR, usdToEur ), ( GBP, EUR, gbpToEur ) ]
rates : List ( Currency, Currency, Decimal ) -> Rates
rates triples =
    Rates
        (List.foldl
            (\( from, to, r ) acc ->
                if Dec.isPositive r then
                    ( currencyCode from, currencyCode to, r ) :: acc

                else
                    acc)
            []
            triples)


-- | The rate from one currency to another: `Just 1` for the same currency,
-- the rate given for the pair, else the inverse of the rate given for the
-- other direction (`1 / r`, rounded to 16 decimal places when it does not
-- end sooner), else `Nothing`. `convert` does not multiply by this rounded
-- inverse: it divides by `r`.
rate : Currency -> Currency -> Rates -> Maybe Decimal
rate from to (Rates table) =
    let
        f = currencyCode from
        t = currencyCode to
    in
        if f == t then
            Just Dec.one

        else
            case findRate f t table of

                Just r ->
                    Just r

                Nothing ->
                    case findRate t f table of

                        Just r ->
                            Result.toMaybe (Dec.div Dec.one r)

                        Nothing ->
                            Nothing


-- The newest entry for the pair (`rates` keeps the list newest first).
findRate : String -> String -> List ( String, String, Decimal ) -> Maybe Decimal
findRate f t table =
    case table of

        [] ->
            Nothing

        ( a, b, r ) :: rest ->
            if a == f && b == t then
                Just r

            else
                findRate f t rest


-- | Convert Money to `to` with a rate from `fx`. The same currency is
-- returned unchanged; a pair with no rate is an `Err` naming both currencies.
--
-- The rate given for the pair multiplies the amount, which is exact. With
-- only the rate for the other direction, the amount is DIVIDED by that rate
-- (never multiplied by a rounded `1 / r`): 3 EUR at USD->EUR 3 is exactly
-- 1 USD. A quotient with more than 16 decimal places is rounded to 16, half
-- away from zero (1 EUR at USD->EUR 3 is 0.3333333333333333 USD). Round to
-- the currency's minor unit yourself when you store or show it.
convert : Rates -> Currency -> Money -> Result Error Money
convert (Rates table) to m =
    let
        f = currencyCode (currency m)
        t = currencyCode to
    in
        if f == t then
            Ok m

        else
            case findRate f t table of

                Just r ->
                    Ok (Money (Dec.mul r (amount m)) to)

                Nothing ->
                    case findRate t f table of

                        Just r ->
                            case Dec.div (amount m) r of

                                Ok q ->
                                    Ok (Money q to)

                                Err e ->
                                    Err e

                        Nothing ->
                            Err
                                (Error.invalidInput
                                    ("Money.convert: no rate from " ++ f
                                        ++ " to "
                                        ++ t))
