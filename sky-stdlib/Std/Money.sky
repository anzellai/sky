            HUF

        "RON" ->
            RON

        "BGN" ->
            BGN

        "AED" ->
            AED

        "SAR" ->
            SAR

        "QAR" ->
            QAR

        "KWD" ->
            KWD

        "BHD" ->
            BHD

        "OMR" ->
            OMR

        "JOD" ->
            JOD

        "ILS" ->
            ILS

        "EGP" ->
            EGP

        "NGN" ->
            NGN

        "KES" ->
            KES

        "GHS" ->
            GHS

        "MAD" ->
            MAD

        "TND" ->
            TND

        "DZD" ->
            DZD

        "PKR" ->
            PKR

        "BDT" ->
