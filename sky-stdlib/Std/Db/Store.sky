import Sky.Ffi as Ffi
import Sky.Core.Error as Error exposing (Error)
import Sky.Core.Task as Task
import Sky.Core.List as List
import Sky.Core.String as String
import Sky.Core.Char as Char
import Sky.Core.Json.Encode as JE exposing (Value)
import Sky.Core.Json.Decode as JD
import Std.Codec as Codec exposing (Codec, ColType(..), Shape(..))
import Std.Db as Db exposing (SqlValue(..))

-- | A table described by one codec. Opaque: build it with `fromCodec` and the
-- builders below.
type Store a
    = Store (StoreRec a)

type alias StoreRec a =
    { name : String
    , codec : Codec a
    , pk : String
    , cols : List ( String, String )
    , generated : List String
    , computed : List ( String, () -> SqlValue )
    , problems : List String
    , indexes : List IndexSpec
    }

-- | One declared index (`index`, `uniqueOn`, `uniqueWhere`). `name` is empty
-- for a Store builder: the runtime names it `ix_<table>_<h>` or
-- `ux_<table>_<h>`, where `<h>` is 8 hex digits of a hash of the table, the
-- columns, the unique flag and the predicate. A `Std.Db.Schema` `withIndex`
-- keeps its own name. `predicate` is the partial-index WHERE, rendered from
-- constants only ("" for a full index).
type alias IndexSpec =
    { name : String
    , cols : List String
    , unique : Bool
    , predicate : String
    }


-- The ONE place a `Store` is taken apart. Every verb and builder reads the
-- record through here, so the payload is narrowed once per program, not once
-- per verb (coerce-floor lever a, doc 14 §5).
storeRec : Store a -> StoreRec a
storeRec (Store s) =
    s


-- | Define a store from a table name and its codec. The columns are derived
-- from the codec's record shape.
fromCodec : String -> Codec a -> Store a
fromCodec name codec =
    let
        cols = codecColumns codec
    in
        Store
            { name = name
            , codec = codec
            , pk = ""
            , cols = cols
            , generated = []
            , computed = []
            , indexes = []
            , problems =
                case cols of

                    [] ->
                        [ "Store.fromCodec \"" ++ name
                              ++ "\": the codec is not a record codec, so it has no columns"
                        ]

                    _ ->
                        []
            }


-- | Mark the primary-key column (NOT NULL; used by `findBy`/`delete`/`update`).
-- Accepts the record FIELD name or the snake column name (resolved either way).
-- An unknown name makes the first verb on the store fail.
primaryKey : String -> Store a -> Store a
primaryKey pk store =
    let
        s = storeRec store
        ( col, problems ) = builderCol "primaryKey" pk s.cols s.problems
    in
        Store { s | pk = col, problems = problems }


-- | Mark an INTEGER primary key as auto-increment (SQLite `INTEGER PRIMARY KEY
-- AUTOINCREMENT` / Postgres `BIGSERIAL`) — the database assigns it, so `insert`
-- OMITS the column and the DB fills the next id. Use this for the common
-- `id : Int` serial-PK table: `Store.fromCodec "todos" codec |> Store.serial "id"`.
-- (For a String/UUID PK you generate yourself, use `primaryKey` instead.)
serial : String -> Store a -> Store a
serial name store =
    let
        s = storeRec store
        ( col, problems ) = builderCol "serial" name s.cols s.problems
    in
        Store
            { s
                | pk = col
                , generated = col :: s.generated
                , cols = appendKind col "!" s.cols
                , problems = problems
            }


-- | Append a suffix to one column's colspec kind: `!` (serial) or a
-- `|`-delimited flag (see the runtime's codecColExtras). The flag drives the
-- CREATE-TABLE constraint/default; the base kind (hence every read/write path)
-- is unaffected.
appendKind : String -> String -> List ( String, String ) -> List ( String, String )
appendKind col suffix cols =
    case cols of

        [] ->
            []

        ( c, k ) :: rest ->
            if c == col then
                ( c, k ++ suffix ) :: appendKind col suffix rest

            else
                ( c, k ) :: appendKind col suffix rest


-- | One builder flag on one column. An unknown column is recorded as a
-- problem, and the first verb on the store fails with it.
withFlag : String -> String -> String -> Store a -> Store a
withFlag verb name flag store =
    let
        s = storeRec store
        ( col, problems ) = builderCol verb name s.cols s.problems
    in
        Store
            { s
                | cols = appendKind col ("|" ++ flag) s.cols
                , problems = problems
            }


-- | A default value inside a colspec flag. `%` and `|` are percent-encoded, so
-- a value can hold either one without ending the flag or injecting another
-- (the runtime's codecFlagValueDecoder reverses it).
flagValue : String -> String
flagValue v =
    String.replace "|" "%7C" (String.replace "%" "%25" v)


-- | Mark a column `UNIQUE` in the generated DDL (e.g. a login email):
-- `Store.fromCodec "users" codec |> Store.primaryKey "id" |> Store.unique "email"`.
-- A duplicate insert surfaces as a `Task.fail` from the driver.
unique : String -> Store a -> Store a
unique name store =
    withFlag "unique" name "u" store


-- | Give a text column a `DEFAULT` of the current timestamp (`now()` on
-- PostgreSQL, `datetime('now')` on SQLite) AND mark it `generated`, so
-- `insert` and `update` never write the record's value:
-- `Store.defaultNow "created_at"`. On PostgreSQL the database stamps a new
-- row. On SQLite `insert` / `insertMany` / `upsert` bind the app clock in the
-- same `YYYY-MM-DD HH:MM:SS` (UTC) format, because a column that `migrate`
-- added holds a constant default there (SQLite refuses `datetime('now')` in
-- ADD COLUMN). The column must be text (a `String` or `Maybe String` field):
-- on any other kind the first verb on the store fails.
defaultNow : String -> Store a -> Store a
defaultNow name store =
    let
        s = storeRec store
        ( col, problems ) =
            textOnly
                "defaultNow"
                name
                s.cols
                (builderCol "defaultNow" name s.cols s.problems)
    in
        Store
            { s
                | cols = appendKind col "|dnow" s.cols
                , generated = col :: s.generated
                , problems = problems
            }


-- | Mark a timestamp column that the DB stamps on INSERT (`defaultNow`) AND that
-- `Store.update`/`updateWhere` auto-bump to the current time on EVERY update — the
-- classic `updated_at`: `Store.touchOnUpdate "updated_at"`. No read-modify-write and
-- no raw SQL: `Store.update` sets it to `now()` for you (a SQL DEFAULT alone only
-- fires on INSERT).
touchOnUpdate : String -> Store a -> Store a
touchOnUpdate name store =
    let
        s = storeRec store
        ( col, problems ) =
            textOnly
                "touchOnUpdate"
                name
                s.cols
                (builderCol "touchOnUpdate" name s.cols s.problems)
    in
        Store
            { s
                | cols = appendKind col "|dnow" (appendKind col "|touch" s.cols)
                , generated = col :: s.generated
                , problems = problems
            }


-- | Give a column a `DEFAULT` text value in the generated DDL:
-- `Store.defaultText "content" ""`. (Does NOT mark the column generated — the
-- record's value is still written on insert; the DEFAULT only applies when the
-- column is omitted, e.g. via `Store.generated`.) The value is stored as given,
-- including `|` and `%`.
defaultText : String -> String -> Store a -> Store a
defaultText name val store =
    withFlag "defaultText" name ("dtext=" ++ flagValue val) store


-- | Give a column a `DEFAULT` integer value in the generated DDL:
-- `Store.defaultInt "verified" 0`.
defaultInt : String -> Int -> Store a -> Store a
defaultInt name val store =
    withFlag "defaultInt" name ("dint=" ++ String.fromInt val) store


-- | Give a column a `DEFAULT` boolean value in the generated DDL (`TRUE`/`FALSE`
-- on Postgres, `1`/`0` on SQLite): `Store.defaultBool "active" True`.
defaultBool : String -> Bool -> Store a -> Store a
defaultBool name val store =
    withFlag
        "defaultBool"
        name
        (if val then
            "dbool=true"

        else
            "dbool=false")
        store


-- | Give a column a `DEFAULT` float value in the generated DDL:
-- `Store.defaultFloat "score" 1.5`. NaN and Infinity have no SQL literal: the
-- first verb on the store fails with them.
defaultFloat : String -> Float -> Store a -> Store a
defaultFloat name val store =
    if val - val == 0.0 then
        withFlag "defaultFloat" name ("dfloat=" ++ String.fromFloat val) store

    else
        let
            s = storeRec store
        in
            Store
                { s
                    | problems =
                        s.problems
                            ++ [ "Store.defaultFloat \"" ++ name
                                     ++ "\": NaN and Infinity have no SQL literal"
                               ]
                }


-- | Index the columns, in order: `Store.index [ "customer_id", "created_at" ]`.
-- `create` and `migrate` create it (`CREATE INDEX IF NOT EXISTS`), and
-- `migrate` creates a declared index that is missing on an existing table.
-- The name is `ix_<table>_<h>` (see `IndexSpec`). An unknown column makes the
-- first verb on the store fail.
index : List String -> Store a -> Store a
index names store =
    addIndex "index" names False "" store


-- | A UNIQUE index over the columns, in order:
-- `Store.uniqueOn [ "customer_id", "code" ]`. Every column must be required
-- (not a `Maybe` field): both engines treat NULLs as distinct, so a nullable
-- column would let duplicate rows in. The name is `ux_<table>_<h>`.
uniqueOn : List String -> Store a -> Store a
uniqueOn names store =
    let
        s = storeRec store
        ( cols, problems ) = builderCols "uniqueOn" names s.cols s.problems
        withNullable =
            case nullableIn cols s.cols of

                "" ->
                    problems

                c ->
                    problems
                        ++ [ "Store.uniqueOn: column \"" ++ c
                                 ++ "\" is nullable, and NULLs never conflict: use uniqueWhere with notNull, or a required field"
                           ]
    in
        indexWith "uniqueOn" cols True "" { s | problems = withNullable }


-- | A partial UNIQUE index: the columns are unique among the rows where the
-- condition holds. `Store.uniqueWhere [ "slug" ] (Store.neq "slug" (SqlString ""))`
-- lets many rows keep an empty slug. The condition is written into the DDL
-- as constants, so it takes `eq` / `neq` / `gt` / `gte` / `lt` / `lte` with
-- `SqlString` / `SqlInt` / `SqlFloat` / `SqlBool` values, `isNull` / `notNull`,
-- `inList`, the column conditions `eqCol` and friends, and `and_` / `or_` /
-- `not_` over them. Any other condition makes the first verb fail. A changed
-- condition gives a new index name: `migrate` creates the new index and
-- never drops the old one (`sky db migrate --gen` writes a `dropIndex`).
uniqueWhere : List String -> Cond -> Store a -> Store a
uniqueWhere names cond store =
    let
        s = storeRec store
    in
        case predicateSql s.cols cond of

            Ok pred ->
                addIndex "uniqueWhere" names True pred store

            Err (Error.Error _ info) ->
                Store
                    { s
                        | problems =
                            s.problems
                                ++ [ "Store.uniqueWhere: " ++ info.message ]
                    }


addIndex : String -> List String -> Bool -> String -> Store a -> Store a
addIndex verb names isUnique pred store =
    let
        s = storeRec store
        ( cols, problems ) = builderCols verb names s.cols s.problems
    in
        indexWith verb cols isUnique pred { s | problems = problems }


indexWith : String -> List String -> Bool -> String -> StoreRec a -> Store a
indexWith verb cols isUnique pred s =
    case cols of

        [] ->
            Store
                { s
                    | problems =
                        s.problems ++ [ "Store." ++ verb ++ ": no columns" ]
                }

        _ ->
            Store
                { s
                    | indexes =
                        s.indexes
                            ++ [ { name = ""
                                 , cols = cols
                                 , unique = isUnique
                                 , predicate = pred
                                 }
                               ]
                }


-- The first of the columns whose kind is nullable, else "".
nullableIn : List String -> List ( String, String ) -> String
nullableIn names cols =
    case names of

        [] ->
            ""

        n :: rest ->
            if kindNullable (kindOf n cols) then
                n

            else
                nullableIn rest cols


-- A builder that needs a text column records a problem for any other kind.
textOnly : String -> String -> List ( String, String ) -> ( String, List String ) -> ( String, List String )
textOnly verb name cols resolved =
    let
        ( col, problems ) = resolved
    in
        case lookupKind col cols of

            Just k ->
                if kindBase k == "text" then
                    resolved

                else
                    ( col
                    , problems
                          ++ [ "Store." ++ verb ++ ": column \"" ++ name
                                   ++ "\" is "
                                   ++ kindBase k
                                   ++ ", and the timestamp is text"
                             ]
                    )

            Nothing ->
                resolved


-- The predicate of a partial index, as SQL with constants only (DDL takes no
-- bound parameters). A string is quoted with `'` doubled.
predicateSql : List ( String, String ) -> Cond -> Result Error String
predicateSql cols c =
    case c of

        CondOp col op v ->
            case predicateCol cols col of

                Err e ->
                    Err e

                Ok name ->
                    if List.member op [ "=", "<>", ">", ">=", "<", "<=" ] then
                        case sqlLiteral v of

                            Ok lit ->
                                Ok (name ++ " " ++ op ++ " " ++ lit)

                            Err e ->
                                Err e

                    else
                        Err
                            (Error.invalidInput
                                ("the operator " ++ op
                                    ++ " is not supported in an index predicate"))

        CondNull col wantNull ->
            case predicateCol cols col of

                Err e ->
                    Err e

                Ok name ->
                    if wantNull then
                        Ok (name ++ " IS NULL")

                    else
                        Ok (name ++ " IS NOT NULL")

        CondIn col vs ->
            case predicateCol cols col of

                Err e ->
                    Err e

                Ok name ->
                    case sqlLiterals vs of

                        Err e ->
                            Err e

                        Ok [] ->
                            Ok "1 = 0"

                        Ok lits ->
                            Ok (name ++ " IN (" ++ String.join ", " lits ++ ")")

        CondAnd cs ->
            predicateGroup cols " AND " "1 = 1" cs

        CondOr cs ->
            predicateGroup cols " OR " "1 = 0" cs

        CondNot inner ->
            case predicateSql cols inner of

                Ok p ->
                    Ok ("NOT (" ++ p ++ ")")

                Err e ->
                    Err e

        CondCol op left right ->
            case predicateCol cols left of

                Err e ->
                    Err e

                Ok l ->
                    case predicateCol cols right of

                        Err e ->
                            Err e

                        Ok r ->
                            Ok (l ++ " " ++ op ++ " " ++ r)

        CondText kind _ _ ->
            Err
                (Error.invalidInput
                    (kind ++ " is not supported in an index predicate"))

        CondNest _ ->
            Err
                (Error.invalidInput
                    "a subquery or a join condition is not supported in an index predicate")


predicateGroup : List ( String, String ) -> String -> String -> List Cond -> Result Error String
predicateGroup cols sep empty cs =
    case cs of

        [] ->
            Ok empty

        _ ->
            case predicateList cols cs of

                Ok parts ->
                    Ok ("(" ++ String.join (")" ++ sep ++ "(") parts ++ ")")

                Err e ->
                    Err e


predicateList : List ( String, String ) -> List Cond -> Result Error (List String)
predicateList cols cs =
    case cs of

        [] ->
            Ok []

        c :: rest ->
            case predicateSql cols c of

                Err e ->
                    Err e

                Ok p ->
                    case predicateList cols rest of

                        Err e ->
                            Err e

                        Ok more ->
                            Ok (p :: more)


predicateCol : List ( String, String ) -> String -> Result Error String
predicateCol cols name =
    let
        col = resolveCol cols name
    in
        case lookupKind col cols of

            Just _ ->
                Ok col

            Nothing ->
                Err
                    (Error.invalidInput
                        ("unknown column \"" ++ name ++ "\" — columns are "
                            ++ colNames cols))


-- A constant in DDL: text quoted with `'` doubled, a finite number, TRUE or
-- FALSE (SQLite reads TRUE as 1, which a bool column stores).
sqlLiteral : SqlValue -> Result Error String
sqlLiteral v =
    case v of

        SqlString t ->
            Ok ("'" ++ String.replace "'" "''" t ++ "'")

        SqlInt n ->
            Ok (String.fromInt n)

        SqlFloat f ->
            if f - f == 0.0 then
                Ok (String.fromFloat f)

            else
                Err (Error.invalidInput "NaN and Infinity have no SQL literal")

        SqlBool b ->
            if b then
                Ok "TRUE"

            else
                Ok "FALSE"

        _ ->
            Err
                (Error.invalidInput
                    "an index predicate takes SqlString, SqlInt, SqlFloat or SqlBool values")


sqlLiterals : List SqlValue -> Result Error (List String)
sqlLiterals vs =
    case vs of

        [] ->
            Ok []

        v :: rest ->
            case sqlLiteral v of

                Err e ->
                    Err e

                Ok lit ->
                    case sqlLiterals rest of

                        Err e ->
                            Err e

                        Ok more ->
                            Ok (lit :: more)


-- | Give a column an APP-SIDE computed default: a `() -> SqlValue` the runtime
-- calls at INSERT time (the DB can't run Sky, so this complements the SQL-side
-- `default*`). The prime use is a UUID/String primary key you don't want to pass
-- on every insert — `Store.defaultWith "id" (\_ -> SqlString (newId ()))` (use the
-- unit-arg `Task.run` idiom inside for effectful generators like `Uuid.v4`). The
-- column is marked `generated`, so `insert` ignores the record's value and writes
-- the computed one instead.
defaultWith : String -> (() -> SqlValue) -> Store a -> Store a
defaultWith name gen store =
    let
        s = storeRec store
        ( col, problems ) = builderCol "defaultWith" name s.cols s.problems
    in
        Store
            { s
                | computed = ( col, gen ) :: s.computed
                , generated = col :: s.generated
                , problems = problems
            }


-- | Mark columns the DATABASE fills — a `serial` PK, a `DEFAULT`/`defaultNow`
-- timestamp — so `insert` and `update` OMIT them (the DB assigns/keeps them):
-- `Store.fromCodec "notes" codec |> Store.primaryKey "id" |> Store.generated [ "id", "created_at" ]`.
generated : List String -> Store a -> Store a
generated names store =
    let
        s = storeRec store
        ( cols, problems ) = builderCols "generated" names s.cols s.problems
    in
        Store { s | generated = cols, problems = problems }


-- | Resolve a builder's column name. An unknown name is recorded as a problem.
builderCol : String -> String -> List ( String, String ) -> List String -> ( String, List String )
builderCol verb name cols problems =
    let
        col = resolveCol cols name
    in
        case lookupKind col cols of

            Just _ ->
                ( col, problems )

            Nothing ->
                ( col
                , problems
                      ++ [ "Store." ++ verb ++ ": unknown column \"" ++ name
                               ++ "\" — columns are "
                               ++ colNames cols
                         ]
                )


builderCols : String -> List String -> List ( String, String ) -> List String -> ( List String, List String )
builderCols verb names cols problems =
    case names of

        [] ->
            ( [], problems )

        n :: rest ->
            let
                ( col, p1 ) = builderCol verb n cols problems
                ( more, p2 ) = builderCols verb rest cols p1
            in
                ( col :: more, p2 )


-- | Create the table (dialect-correct DDL derived from the codec).
create : Db -> Store a -> Task Error ()
create conn store =
    let
        s = storeRec store
    in
        case storeError s.name s.pk s.cols s.problems of

            Just e ->
                Task.fail e

            Nothing ->
                dbCreateCols conn s.name s.cols s.pk s.indexes


-- | Safe additive migration: create the table (with its indexes) if absent,
-- ADD any column the record type has gained, and create any declared index
-- (`index` / `uniqueOn` / `uniqueWhere`) that is missing. `sky db migrate
-- --gen` follows the same rule, so both paths give the same column:
--
-- * a `Maybe` field gives a nullable column (with its declared default, if any);
-- * any other field gives `NOT NULL DEFAULT <d>`, where `<d>` is the declared
--   default (`defaultInt` / `defaultText` / `defaultBool` / `defaultFloat` /
--   `defaultNow`), else the zero value of the type (`0`, `''`, false), so the
--   rows that exist read a value;
-- * a required JSON (blob) field gives `NOT NULL DEFAULT '<json>'`, where
--   `<json>` is that field's own zero (`Codec.fieldZeros`: its value in the
--   blank record of `Codec.auto`, or its codec's zero in a `Codec.object`
--   codec), so a sibling field with no zero does not take it away. A field
--   with no zero (a `taggedUnion`, `result` or `Codec.error` field, or an
--   object field holding one) is `NOT NULL` with no default: an empty table
--   takes it, a table with 1 or more rows is an `Err`, and a
--   `sky db migrate` file fails there with the same advice;
-- * a required enum field (a `Codec.enum` field, or a nullary custom type
--   under `Codec.auto`) gives `NOT NULL DEFAULT '<name>'`: the first name of
--   the `Codec.enum`, or the witness's constructor name under `Codec.auto`.
--   A plain String field keeps `''`;
-- * a `defaultNow` column added on SQLite holds the time of the ALTER in the
--   rows that exist (SQLite refuses `datetime('now')` in ADD COLUMN);
-- * a `unique` column is added, then given a unique index. A required unique
--   column cannot be added to a table with 2 or more rows (every row would get
--   the same value): that is an `Err`, and the table is not changed. A
--   `sky db migrate` file fails at the same count, with the same advice.
--
-- An existing column is never altered: a column an older `migrate` added
-- nullable stays nullable. Nothing is dropped, renamed or retyped (see
-- docs/history/v0.19/auto-migration-architecture.md). Idempotent; returns the
-- SQL statements it ran (empty when up to date).
migrate : Db -> Store a -> Task Error (List String)
migrate conn store =
    let
        s = storeRec store
    in
        case storeError s.name s.pk s.cols s.problems of

            Just e ->
                Task.fail e

            Nothing ->
                dbAutoMigrate
                    conn
                    s.name
                    (withZeros s.codec s.cols)
                    s.pk
                    s.indexes


-- | Insert a record. Columns marked `generated` (a `serial` PK, `defaultNow`) are
-- OMITTED so the database assigns them.
--
-- Returns the PRIMARY KEY the database assigned when the PK is an Int (a
-- `Store.serial` id) — that value is the whole point, since a `generated` PK is
-- omitted from the INSERT and the caller has no other way to learn it. Wire
-- child rows to this id:
--
--     Store.insert conn entries header
--         |> Task.andThen (\entryId -> Store.insert conn lines { line | entryId = entryId })
--
-- For a caller-supplied PK (a String/UUID key) there is no DB-assigned integer,
-- so the result is the affected-row count.
insert : Db -> Store a -> a -> Task Error Int
insert conn store record =
    let
        s = storeRec store
    in
        case storeError s.name s.pk s.cols s.problems of

            Just e ->
                Task.fail e

            Nothing ->
                dbExecObjectWith
                    conn
                    s.name
                    (insertCols s.generated s.cols)
                    (Codec.toValue s.codec record)
                    (computedValues s.computed)
                    s.pk
                    (kindOf s.pk s.cols)


computedValues : List ( String, () -> SqlValue ) -> List ( String, SqlValue )
computedValues computed =
    case computed of

        [] ->
            []

        ( col, gen ) :: rest ->
            ( col, gen () ) :: computedValues rest


-- | Bulk-insert many records in ONE multi-row INSERT — for time-series / batch
-- writes where a per-row `insert` would be N round-trips. Columns marked
-- `generated` are omitted (the DB fills them). `defaultWith` computed columns are
-- NOT applied here — provide those values in the records. Returns rows affected.
insertMany : Db -> Store a -> List a -> Task Error Int
insertMany conn store records =
    let
        s = storeRec store
    in
        case storeError s.name s.pk s.cols s.problems of

            Just e ->
                Task.fail e

            Nothing ->
                dbExecObjectMany
                    conn
                    s.name
                    (insertCols s.generated s.cols)
                    (List.map (Codec.toValue s.codec) records)


-- | Insert the record, or UPDATE it in place if its primary key already exists
-- (`INSERT ... ON CONFLICT(pk) DO UPDATE`). The idempotent write for config rows
-- keyed by a natural/app id — `Store.upsert conn monitors monitor`. Requires a
-- non-generated PK (a String/UUID key you provide, not `serial`).
-- Returns the row's PK for an Int-keyed store (0 when an `ON CONFLICT DO
-- NOTHING` wrote nothing), and the affected-row count otherwise — the same
-- contract as `insert`.
-- To keep some columns, add to a counter, or conflict on a `uniqueOn` set,
-- use `upsertWith` (it returns rows affected, never the key).
upsert : Db -> Store a -> a -> Task Error Int
upsert conn store record =
    let
        s = storeRec store
    in
        case storeError s.name s.pk s.cols s.problems of

            Just e ->
                Task.fail e

            Nothing ->
                dbUpsertObject
                    conn
                    s.name
                    (insertCols s.generated s.cols)
                    s.pk
                    (Codec.toValue s.codec record)
                    (kindOf s.pk s.cols)


-- | Update the row identified by the record's PRIMARY KEY, setting every column
-- to the record's value (the PK and `generated` columns are never written). Read
-- a row, change fields, `update` it back. Returns rows affected.
update : Db -> Store a -> a -> Task Error Int
update conn store record =
    let
        s = storeRec store
    in
        case storeError s.name s.pk s.cols s.problems of

            Just e ->
                Task.fail e

            Nothing ->
                dbUpdateByPk
                    conn
                    s.name
                    (setColspecOf s.pk s.generated s.cols)
                    s.pk
                    (kindOf s.pk s.cols)
                    (Codec.toValue s.codec record)


-- | Update every row matching a `Cond` to the record's column values (PK +
-- `generated` columns excluded). For compound / ownership conditions the PK alone
-- can't express: `Store.updateWhere conn notes (Store.and_ [ Store.eq "id" (SqlInt id), Store.eq "user_id" (SqlString uid) ]) note`.
updateWhere : Db -> Store a -> Cond -> a -> Task Error Int
updateWhere conn store cond record =
    let
        s = storeRec store
    in
        case writeWhere (dialectOf conn) s.name s.pk s.cols s.problems cond of

            Err e ->
                Task.fail e

            Ok ( whereSql, whereParams ) ->
                dbUpdateWhere
                    conn
                    s.name
                    (setColspecOf s.pk s.generated s.cols)
                    (Codec.toValue s.codec record)
                    whereSql
                    whereParams


-- | PARTIAL-column update by `Cond`: `SET` only the named columns and leave the
-- rest untouched — unlike `update`/`updateWhere`, which rewrite the WHOLE record
-- from the codec. This is the PATCH primitive: set one or two columns without a
-- read-modify-write, and without needing them present in the codec's read shape.
-- Column names accept the record FIELD or the snake column; values bind as
-- `SqlValue` params (injection-safe). Example — mark an order shipped:
-- `Store.updateFields conn orders (eq "id" (SqlString oid))
--     [ ( "status", SqlString "shipped" ), ( "tracking", SqlString t ) ]`.
updateFields : Db -> Store a -> Cond -> List ( String, SqlValue ) -> Task Error Int
updateFields conn store cond sets =
    case sets of

        [] ->
            Task.succeed 0

        _ ->
            let
                s = storeRec store
            in
                runExec
                    conn
                    (prepareSet
                        (dialectOf conn)
                        s.name
                        s.pk
                        s.cols
                        s.problems
                        cond
                        False
                        sets)


-- | PARTIAL-column update by primary key — the everyday PATCH-by-id:
-- `Store.setFields conn users (SqlString uid) [ ( "verified", SqlBool True ) ]`.
setFields : Db -> Store a -> SqlValue -> List ( String, SqlValue ) -> Task Error Int
setFields conn store pkValue sets =
    updateFields conn store (eq (storeRec store).pk pkValue) sets


-- | Atomic relative adjustment of integer columns — `SET col = col + delta` per
-- entry, by `Cond`. The one write a value-based update can't express (the value
-- depends on the column's CURRENT value): a race-free counter/stock/balance
-- change without reading first. Negative deltas subtract:
-- `Store.adjust conn products (eq "id" (SqlString pid)) [ ( "stock", -qty ) ]`.
-- (For a clamped decrement like `max 0 (stock - qty)`, that's app logic — stay
-- with raw `Db.exec` inside a `Store.transaction`.)
adjust : Db -> Store a -> Cond -> List ( String, Int ) -> Task Error Int
adjust conn store cond deltas =
    case deltas of

        [] ->
            Task.succeed 0

        _ ->
            let
                s = storeRec store
            in
                runExec
                    conn
                    (prepareSet
                        (dialectOf conn)
                        s.name
                        s.pk
                        s.cols
                        s.problems
                        cond
                        True
                        (intSets deltas))


intSets : List ( String, Int ) -> List ( String, SqlValue )
intSets deltas =
    case deltas of

        [] ->
            []

        ( c, d ) :: rest ->
            ( c, SqlInt d ) :: intSets rest


-- | Every row, decoded via the codec.
all : Db -> Store a -> Task Error (List a)
all conn store =
    toList conn (query store)


-- | The single row where `col = value` (value bound as text), or Nothing.
-- `col` must be a codec column (field or snake name).
findBy : Db -> Store a -> String -> String -> Task Error (Maybe a)
findBy conn store col value =
    toMaybe conn (query store |> where_ (eq col (SqlString value)))


-- | Run ANY SQL and decode each row into a typed projection record via a codec.
-- The last escape hatch: `groupBy` + `aggregate`, `select`, `latestPer`,
-- `jsonText` and the text conditions cover grouped counts, projections and
-- per-key newest rows with checked names, `join` / `leftJoin` read two stores,
-- and `inQuery` / `exists` take a subquery. Reach for this for a shape they do
-- not model (a join of three tables, a window function, a CTE). You
-- own the SQL; the codec owns the mapping, so rows come back as records, not
-- `Dict String String`. The codec's columns must match the SELECT's output
-- columns (alias to snake_case):
--
--     type alias Tally = { ideaId : String, votes : Int }
--     tallyCodec = Codec.auto { ideaId = "", votes = 0 }
--     Store.selectRaw conn tallyCodec
--         "SELECT idea_id, COUNT(*) AS votes FROM votes GROUP BY idea_id"
--         []
selectRaw : Db -> Codec row -> String -> List SqlValue -> Task Error (List row)
selectRaw conn codec sql params =
    readRows conn (Ok ( sql, params )) [ ( "", "", codecColumns codec ) ]
        |> Task.andThen
               (\rows -> Task.fromResult (decodeAll (rowDecoder codec) rows []))


-- | Delete rows where `col = value` (single column). `col` must be a codec
-- column (field or snake name).
delete : Db -> Store a -> String -> String -> Task Error Int
delete conn store col value =
    deleteWhere conn store (eq col (SqlString value))


-- | Delete every row matching a `Cond` — for compound conditions the single-column
-- `delete` can't express: `Store.deleteWhere conn notes (Store.and_ [ Store.eq "id" (SqlInt id), Store.eq "user_id" (SqlString uid) ])`.
deleteWhere : Db -> Store a -> Cond -> Task Error Int
deleteWhere conn store cond =
    let
        s = storeRec store
    in
        runExec
            conn
            (case writeWhere (dialectOf conn) s.name s.pk s.cols s.problems cond of

                Err e ->
                    Err e

                Ok ( whereSql, whereParams ) ->
                    Ok
                        ( "DELETE FROM " ++ s.name ++ " WHERE " ++ whereSql
                        , whereParams
                        ))

-- ── Writes with a conflict rule, expression SET, copy and RETURNING ─────────
-- Each verb below renders ONE statement in Sky, checks every name against
-- the codec first, and binds every value as a parameter. The text is the same
-- on SQLite (3.35+) and PostgreSQL except where noted.
--
-- | One rule for a column when `upsertWith` meets a row that exists. Build it
-- with `addExcluded`, `keepMin`, `keepMax` or `setExcluded`. Opaque.
type OnConflict
    = OnConflict String String


-- | Add the new row's value to the stored one: `count = t.count + excluded.count`.
-- A required `Int` or `Float` column only (a NULL would make the sum NULL).
addExcluded : String -> OnConflict
addExcluded col =
    OnConflict "add" col


-- | Keep the smaller of the stored and the new value. A NULL on either side
-- gives the other value. Not for a bool or JSON (blob) column. Text compares
-- by the database collation (byte order on SQLite).
keepMin : String -> OnConflict
keepMin col =
    OnConflict "min" col


-- | Keep the larger of the stored and the new value (NULL rules as `keepMin`).
keepMax : String -> OnConflict
keepMax col =
    OnConflict "max" col


-- | Set the column to the new row's value: `c = excluded.c`.
setExcluded : String -> OnConflict
setExcluded col =
    OnConflict "set" col

-- | One column of `updateSet`. Build it with `setCol`, `setValue` or
-- `setWhen`. Opaque.
type SetExpr
    = SetExpr SetSpec

type alias SetSpec =
    { kind : String
    , target : String
    , source : String
    , cond : Cond
    , value : SqlValue
    , keepOld : Bool
    , orElse : SqlValue
    }

-- | The ELSE branch of `setWhen`: `keep` (the value the row holds) or
-- `otherwise v`. Opaque.
type Otherwise
    = Otherwise Bool SqlValue

-- | One source of a `copyInto` column: `from` a column of the source query,
-- or a `const` value. Opaque.
type CopyFrom
    = CopyFrom Bool String SqlValue


noValue : SqlValue
noValue =
    SqlNull (SqlString "")


-- | Copy another column of the same row: `Store.setCol "wanted_at" "status_at"`
-- renders `wanted_at = status_at`. The two columns have one kind, and a
-- nullable source needs a nullable target.
setCol : String -> String -> SetExpr
setCol target source =
    SetExpr
        { kind = "col"
        , target = target
        , source = source
        , cond = CondAnd []
        , value = noValue
        , keepOld = True
        , orElse = noValue
        }


-- | Set a value: `Store.setValue "status" (SqlString "open")` renders `status = ?`.
setValue : String -> SqlValue -> SetExpr
setValue target v =
    SetExpr
        { kind = "value"
        , target = target
        , source = ""
        , cond = CondAnd []
        , value = v
        , keepOld = True
        , orElse = noValue
        }


-- | Set a value on the rows where a condition holds:
-- `Store.setWhen "status" (Store.eq "status" (SqlString "ai")) (SqlString "open") Store.keep`
-- renders `status = CASE WHEN (status = ?) THEN CAST(? AS TEXT) ELSE status END`.
-- The condition takes the same leaves as `where_`.
setWhen : String -> Cond -> SqlValue -> Otherwise -> SetExpr
setWhen target cond v orElse =
    case orElse of

        Otherwise keepOld other ->
            SetExpr
                { kind = "when"
                , target = target
                , source = ""
                , cond = cond
                , value = v
                , keepOld = keepOld
                , orElse = other
                }


-- | `setWhen`'s ELSE: the row keeps the value it holds.
keep : Otherwise
keep =
    Otherwise True noValue


-- | `setWhen`'s ELSE: set this value.
otherwise : SqlValue -> Otherwise
otherwise v =
    Otherwise False v


-- | A `copyInto` column read from the source query's column (a field or
-- snake name of the source rows).
from : String -> CopyFrom
from col =
    CopyFrom True col noValue


-- | A `copyInto` column set to one value for every copied row.
const : SqlValue -> CopyFrom
const v =
    CopyFrom False "" v


-- | Insert the record, or do nothing when it would break the primary key or
-- any unique constraint (`INSERT … ON CONFLICT DO NOTHING`). Returns 1 when
-- it wrote the row and 0 when one was there. The atomic "claim once": of two
-- concurrent calls with one key, exactly one returns 1. Columns marked
-- `generated` are left out, `defaultWith` columns are computed, as `insert`.
insertOrIgnore : Db -> Store a -> a -> Task Error Int
insertOrIgnore conn store record =
    runExec
        conn
        (case insertHead (dialectOf conn) (storeRec store) record of

            Err e ->
                Err e

            Ok ( head, params ) ->
                Ok ( head ++ " ON CONFLICT DO NOTHING", params ))


-- | `insertOrIgnore` that ignores only a conflict on these columns:
-- `Store.insertOrIgnoreOn [ "dedupe_key" ] conn followups row`. The columns are
-- the primary key, a `unique` column or a `uniqueOn` set, and required (both
-- engines treat NULLs as distinct). A conflict on any other constraint is an
-- `Err`. Returns 1 or 0.
insertOrIgnoreOn : List String -> Db -> Store a -> a -> Task Error Int
insertOrIgnoreOn names conn store record =
    let
        s = storeRec store
    in
        runExec
            conn
            (case insertHead (dialectOf conn) s record of

                Err e ->
                    Err e

                Ok ( head, params ) ->
                    case conflictTarget "insertOrIgnoreOn" s names of

                        Err e ->
                            Err e

                        Ok target ->
                            Ok
                                ( head ++ " ON CONFLICT ("
                                      ++ String.join ", " target
                                      ++ ") DO NOTHING"
                                , params
                                ))


-- | Insert the record, or apply the rules to the row that exists — a partial
-- or counter upsert in one statement:
--
--     Store.upsertWith conn dailyCounts row
--         { conflictOn = [ "day", "customer_id", "event" ]
--         , onConflict =
--             [ Store.addExcluded "count"
--             , Store.keepMin "first_at"
--             , Store.keepMax "last_at"
--             , Store.setExcluded "source"
--             ]
--         }
--
-- `conflictOn` is the primary key, a `unique` column or a `uniqueOn` set
-- (not a `uniqueWhere`), of required columns. A column that a rule does not
-- name keeps its value; `touchOnUpdate` columns take the clock. No rule may
-- name a `conflictOn`, primary-key or generated column. An empty rule list
-- is `DO NOTHING`. Returns rows affected (1, or 0 for `DO NOTHING`), not the
-- primary key that `upsert` returns for an Int-keyed store.
upsertWith : Db -> Store a -> a -> { conflictOn : List String, onConflict : List OnConflict } -> Task Error Int
upsertWith conn store record rule =
    let
        s = storeRec store
        d = dialectOf conn
    in
        runExec
            conn
            (case insertHead d s record of

                Err e ->
                    Err e

                Ok ( head, params ) ->
                    case conflictTarget "upsertWith" s rule.conflictOn of

                        Err e ->
                            Err e

                        Ok target ->
                            case conflictItems s target rule.onConflict [] [] of

                                Err e ->
                                    Err e

                                Ok items ->
                                    Ok
                                        ( head ++ " ON CONFLICT ("
                                              ++ String.join ", " target
                                              ++ ") "
                                              ++ conflictAction d s.cols items
                                        , params
                                        ))


-- | Insert the record and return the row as the database stored it — with a
-- `serial` id and `defaultNow` stamp filled (`INSERT … RETURNING`). Fails
-- when no row comes back.
insertReturning : Db -> Store a -> a -> Task Error a
insertReturning conn store record =
    let
        s = storeRec store
    in
        runReturning conn s.codec s.cols (insertHead (dialectOf conn) s record)
            |> Task.andThen
                   (\rows ->
                       case rows of

                           r :: _ ->
                               Task.succeed r

                           [] ->
                               Task.fail
                                   (storeErr
                                       "insertReturning: the database returned no row"))


-- | `updateFields` that returns the updated rows (`UPDATE … RETURNING`),
-- decoded by the codec. The read-after-write of a claim in one statement:
-- `updateFieldsReturning conn jobs (and_ [ eq "id" id, isNull "owner" ]) [ ( "owner", me ) ]`
-- gives `[ job ]` to the one caller that claimed it and `[]` to the others.
-- An empty set list is an `Err`.
updateFieldsReturning : Db -> Store a -> Cond -> List ( String, SqlValue ) -> Task Error (List a)
updateFieldsReturning conn store cond sets =
    let
        s = storeRec store
    in
        case sets of

            [] ->
                Task.fail (storeErr "updateFieldsReturning: no columns to set")

            _ ->
                runReturning
                    conn
                    s.codec
                    s.cols
                    (prepareSet
                        (dialectOf conn)
                        s.name
                        s.pk
                        s.cols
                        s.problems
                        cond
                        False
                        sets)


-- | `deleteWhere` that returns the deleted rows (`DELETE … RETURNING`).
deleteWhereReturning : Db -> Store a -> Cond -> Task Error (List a)
deleteWhereReturning conn store cond =
    let
        s = storeRec store
    in
        runReturning
            conn
            s.codec
            s.cols
            (case writeWhere (dialectOf conn) s.name s.pk s.cols s.problems cond of

                Err e ->
                    Err e

                Ok ( whereSql, whereParams ) ->
                    Ok
                        ( "DELETE FROM " ++ s.name ++ " WHERE " ++ whereSql
                        , whereParams
                        ))


-- | Set columns from expressions in one `UPDATE` over the rows a condition
-- matches: copy a column (`setCol`), set a value (`setValue`), or set a
-- value where a condition holds (`setWhen` with `keep` / `otherwise`):
--
--     Store.updateSet conn orderLines (Store.eq "wanted_at" (SqlInt 0))
--         [ Store.setCol "wanted_at" "status_at"
--         , Store.setWhen "status" (Store.eq "status" (SqlString "ai")) (SqlString "open") Store.keep
--         ]
--
-- Every row takes its own values. A target is a codec column, not the
-- primary key or a generated column, at most once. `touchOnUpdate` columns
-- take the clock. An empty list returns 0 and runs nothing. Returns rows
-- affected.
updateSet : Db -> Store a -> Cond -> List SetExpr -> Task Error Int
updateSet conn store cond exprs =
    case exprs of

        [] ->
            Task.succeed 0

        _ ->
            runExec
                conn
                (prepareUpdateSet (dialectOf conn) (storeRec store) cond exprs)


-- | Insert the rows of a query in one `INSERT … SELECT`: a copy between
-- tables, or a roll-up from an `aggregate` query.
--
--     Store.copyInto conn enquiries
--         (Store.query supportRequests |> Store.where_ (Store.gt "created_at" (SqlInt 0)))
--         [ ( "id", Store.from "id" ), ( "kind", Store.const (SqlString "support") ), ( "customer_id", Store.from "customer_id" ) ]
--
-- Each pair names a target column and its source: `from` a column of the
-- query's rows (after `select` / `aggregate`, a result field), or a `const`
-- value. The kinds match, and a nullable source needs a nullable target.
-- Every required target column without a default is mapped, and so is every
-- `defaultWith` column. A `serial` column is never mapped (the database
-- assigns it). A join query needs `select` first. Returns rows inserted.
copyInto : Db -> Store t -> Query s -> List ( String, CopyFrom ) -> Task Error Int
copyInto conn store q mapping =
    runExec
        conn
        (prepareCopy False (dialectOf conn) (storeRec store) (specOf q) mapping)


-- | `copyInto` that skips a row that would break the primary key or a unique
-- constraint (`ON CONFLICT DO NOTHING`). Returns rows inserted.
copyIntoOrIgnore : Db -> Store t -> Query s -> List ( String, CopyFrom ) -> Task Error Int
copyIntoOrIgnore conn store q mapping =
    runExec
        conn
        (prepareCopy True (dialectOf conn) (storeRec store) (specOf q) mapping)


-- The `INSERT INTO t (…) VALUES (…)` of one record. Every column that is not
-- generated binds the record's value (Db_objectSqlValues), a `defaultWith`
-- column its computed value, and a `defaultNow` column takes `datetime('now')`
-- on SQLite (the same text as the app clock `insert` binds) and the
-- database default on PostgreSQL.
insertHead : Dialect -> StoreRec a -> a -> Result Error ( String, List SqlValue )
insertHead d s record =
    case storeError s.name s.pk s.cols s.problems of

        Just e ->
            Err e

        Nothing ->
            let
                plain = colsExcluding s.generated s.cols
                computed = computedValues s.computed
                nowCols =
                    case d of

                        Sqlite ->
                            colNamesList (nowColsOf s.cols)

                        Postgres ->
                            []
                cols = colNamesList plain ++ pairNames computed ++ nowCols
                marks =
                    repeatText (List.length plain + List.length computed) "?"
                        ++ repeatText (List.length nowCols) "datetime('now')"
            in
                case cols of

                    [] ->
                        Err
                            <| storeErr
                                   ("\"" ++ s.name ++ "\": no column to insert")

                    _ ->
                        Ok
                            ( "INSERT INTO " ++ s.name ++ " ("
                                  ++ String.join ", " cols
                                  ++ ") VALUES ("
                                  ++ String.join ", " marks
                                  ++ ")"
                            , dbObjectSqlValues
                                  plain
                                  (Codec.toValue s.codec record)
                                  ++ pairValues computed
                            )


repeatText : Int -> String -> List String
repeatText n text =
    if n <= 0 then
        []

    else
        text :: repeatText (n - 1) text


pairNames : List ( String, SqlValue ) -> List String
pairNames pairs =
    case pairs of

        [] ->
            []

        ( c, _ ) :: rest ->
            c :: pairNames rest


pairValues : List ( String, SqlValue ) -> List SqlValue
pairValues pairs =
    case pairs of

        [] ->
            []

        ( _, v ) :: rest ->
            v :: pairValues rest


-- The conflict target: every name a required codec column, the set equal to
-- the primary key, one `unique` column, or a `uniqueOn` set.
conflictTarget : String -> StoreRec a -> List String -> Result Error (List String)
conflictTarget verb s names =
    case resolveNames verb s.cols names [] of

        Err e ->
            Err e

        Ok cols ->
            case cols of

                [] ->
                    Err <| storeErr (verb ++ ": no conflict columns")

                _ ->
                    case nullableIn cols s.cols of

                        "" ->
                            if isConflictKey s cols then
                                Ok cols

                            else
                                Err
                                    <| storeErr
                                           (verb ++ ": ("
                                               ++ String.join ", " cols
                                               ++ ") is not the primary key, a unique column or a uniqueOn set of \""
                                               ++ s.name
                                               ++ "\"")

                        c ->
                            Err
                                <| storeErr
                                       (verb ++ ": column \"" ++ c
                                           ++ "\" is nullable, and NULLs never conflict")


-- Resolve names to codec columns, refusing an unknown one or a repeat.
resolveNames : String -> List ( String, String ) -> List String -> List String -> Result Error (List String)
resolveNames verb cols names acc =
    case names of

        [] ->
            Ok (List.reverse acc)

        n :: rest ->
            let
                col = resolveCol cols n
            in
                case lookupKind col cols of

                    Nothing ->
                        Err <| unknownColErr n cols

                    Just _ ->
                        if List.member col acc then
                            Err
                                <| storeErr
                                       (verb ++ ": column \"" ++ col
                                           ++ "\" is named twice")

                        else
                            resolveNames verb cols rest (col :: acc)


isConflictKey : StoreRec a -> List String -> Bool
isConflictKey s cols =
    (s.pk /= "" && sameNames cols [ s.pk ]) || uniqueColumn cols s.cols
        || uniqueIndex cols s.indexes


uniqueColumn : List String -> List ( String, String ) -> Bool
uniqueColumn cols all =
    case cols of

        [ c ] ->
            hasFlag "u" (kindOf c all)

        _ ->
            False


uniqueIndex : List String -> List IndexSpec -> Bool
uniqueIndex cols indexes =
    case indexes of

        [] ->
            False

        ix :: rest ->
            (ix.unique && ix.predicate == "" && sameNames cols ix.cols)
                || uniqueIndex cols rest


sameNames : List String -> List String -> Bool
sameNames a b =
    List.length a == List.length b && allIn a b


allIn : List String -> List String -> Bool
allIn names within =
    case names of

        [] ->
            True

        n :: rest ->
            List.member n within && allIn rest within


-- The DO UPDATE SET items of `upsertWith`, one per rule.
conflictItems : StoreRec a -> List String -> List OnConflict -> List String -> List String -> Result Error (List String)
conflictItems s target rules seen items =
    case rules of

        [] ->
            Ok (List.reverse items)

        (OnConflict kind name) :: rest ->
            let
                col = resolveCol s.cols name
            in
                case lookupKind col s.cols of

                    Nothing ->
                        Err <| unknownColErr name s.cols

                    Just k ->
                        case conflictRuleError kind col k s target seen of

                            Just msg ->
                                Err <| storeErr ("upsertWith: " ++ msg)

                            Nothing ->
                                conflictItems
                                    s
                                    target
                                    rest
                                    (col :: seen)
                                    (conflictRuleSql kind s.name col :: items)


conflictRuleError : String -> String -> String -> StoreRec a -> List String -> List String -> Maybe String
conflictRuleError kind col k s target seen =
    let
        base = kindBase k
    in
        if col == s.pk || List.member col target then
            Just
                ("\"" ++ col
                    ++ "\" identifies the row (primary key or conflictOn): no rule may set it")

        else if List.member col s.generated then
            Just
                ("\"" ++ col
                    ++ "\" is generated (serial, defaultNow, defaultWith or generated): the database or the Store fills it")

        else if List.member col seen then
            Just ("\"" ++ col ++ "\" has two rules")

        else if kind == "add" && (kindNullable k || (base /= "int" && base /= "real")) then
            Just
                ("addExcluded \"" ++ col
                    ++ "\": the column must be a required Int or Float")

        else if (kind == "min" || kind == "max") && (base == "bool" || base == "blob") then
            Just
                ("keepMin / keepMax \"" ++ col ++ "\": a " ++ base
                    ++ " column has no order")

        else
            Nothing


conflictRuleSql : String -> String -> String -> String
conflictRuleSql kind table col =
    let
        old = table ++ "." ++ col
        new = "excluded." ++ col
    in
        if kind == "add" then
            col ++ " = " ++ old ++ " + " ++ new

        else if kind == "min" then
            col ++ " = " ++ keepCase old new "<"

        else if kind == "max" then
            col ++ " = " ++ keepCase old new ">"

        else
            col ++ " = " ++ new


-- One text on both dialects: LEAST / GREATEST and the scalar MIN / MAX
-- treat NULL differently, so the NULL rule is spelled out.
keepCase : String -> String -> String -> String
keepCase old new op =
    "CASE WHEN " ++ new ++ " IS NULL THEN " ++ old ++ " WHEN " ++ old
        ++ " IS NULL THEN "
        ++ new
        ++ " WHEN "
        ++ new
        ++ " "
        ++ op
        ++ " "
        ++ old
        ++ " THEN "
        ++ new
        ++ " ELSE "
        ++ old
        ++ " END"


conflictAction : Dialect -> List ( String, String ) -> List String -> String
conflictAction d cols items =
    case items of

        [] ->
            "DO NOTHING"

        _ ->
            "DO UPDATE SET " ++ String.join ", " (items ++ touchItems d cols)


-- `c = <clock>` for each `touchOnUpdate` column.
touchItems : Dialect -> List ( String, String ) -> List String
touchItems d cols =
    case touchColsOf cols of

        [] ->
            []

        touched ->
            touchSql (nowSql d) touched


touchSql : String -> List ( String, String ) -> List String
touchSql now cols =
    case cols of

        [] ->
            []

        ( c, _ ) :: rest ->
            (c ++ " = " ++ now) :: touchSql now rest


nowSql : Dialect -> String
nowSql d =
    case d of

        Sqlite ->
            "datetime('now')"

        Postgres ->
            "now()"


-- A parameter typed as the column, so PostgreSQL can type a CASE branch or
-- a SELECT-list value.
castParam : String -> String
castParam k =
    "CAST(? AS " ++ sqlTypeOf k ++ ")"


sqlTypeOf : String -> String
sqlTypeOf k =
    let
        base = kindBase k
    in
        if base == "int" then
            "BIGINT"

        else if base == "real" then
            "DOUBLE PRECISION"

        else if base == "bool" then
            "BOOLEAN"

        else
            "TEXT"


prepareUpdateSet : Dialect -> StoreRec a -> Cond -> List SetExpr -> Result Error ( String, List SqlValue )
prepareUpdateSet d s cond exprs =
    case writeWhere d s.name s.pk s.cols s.problems cond of

        Err e ->
            Err e

        Ok ( whereSql, whereParams ) ->
            case setExprItems d s exprs [] [] noParams of

                Err e ->
                    Err e

                Ok ( items, params ) ->
                    Ok
                        ( "UPDATE " ++ s.name ++ " SET "
                              ++ String.join ", " (items ++ touchItems d s.cols)
                              ++ " WHERE "
                              ++ whereSql
                        , params ++ whereParams
                        )


setExprItems : Dialect -> StoreRec a -> List SetExpr -> List String -> List String -> List SqlValue -> Result Error ( List String, List SqlValue )
setExprItems d s exprs seen items params =
    case exprs of

        [] ->
            Ok ( items, params )

        (SetExpr e) :: rest ->
            let
                target = resolveCol s.cols e.target
            in
                case lookupKind target s.cols of

                    Nothing ->
                        Err <| unknownColErr e.target s.cols

                    Just tk ->
                        case setTargetError s target seen of

                            Just msg ->
                                Err <| storeErr ("updateSet: " ++ msg)

                            Nothing ->
                                case setExprSql d s target tk e of

                                    Err err ->
                                        Err err

                                    Ok ( sql, ps ) ->
                                        setExprItems
                                            d
                                            s
                                            rest
                                            (target :: seen)
                                            (items ++ [ target ++ " = " ++ sql ])
                                            (params ++ ps)


setTargetError : StoreRec a -> String -> List String -> Maybe String
setTargetError s target seen =
    if not (isIdent target) then
        Just ("column \"" ++ target ++ "\" is not a valid identifier")

    else if target == s.pk then
        Just ("\"" ++ target ++ "\" is the primary key")

    else if List.member target s.generated then
        Just
            ("\"" ++ target
                ++ "\" is generated (serial, defaultNow, defaultWith or generated)")

    else if List.member target seen then
        Just ("\"" ++ target ++ "\" is set twice")

    else
        Nothing


setExprSql : Dialect -> StoreRec a -> String -> String -> SetSpec -> Result Error ( String, List SqlValue )
setExprSql d s target tk e =
    if e.kind == "col" then
        let
            src = resolveCol s.cols e.source
        in
            case lookupKind src s.cols of

                Nothing ->
                    Err <| unknownColErr e.source s.cols

                Just sk ->
                    case fitError target tk sk of

                        Just msg ->
                            Err <| storeErr ("updateSet: " ++ msg)

                        Nothing ->
                            if isIdent src then
                                Ok ( src, noParams )

                            else
                                Err
                                    <| storeErr
                                           ("updateSet: column \"" ++ src
                                               ++ "\" is not a valid identifier")

    else if e.kind == "value" then
        Ok ( "?", [ e.value ] )

    else
        case renderCond (plainCtx d s.name s.cols) e.cond of

            Err err ->
                Err err

            Ok ( cSql, cParams ) ->
                if e.keepOld then
                    Ok
                        ( "CASE WHEN (" ++ cSql ++ ") THEN " ++ castParam tk
                              ++ " ELSE "
                              ++ target
                              ++ " END"
                        , cParams ++ [ e.value ]
                        )

                else
                    Ok
                        ( "CASE WHEN (" ++ cSql ++ ") THEN " ++ castParam tk
                              ++ " ELSE "
                              ++ castParam tk
                              ++ " END"
                        , cParams ++ [ e.value, e.orElse ]
                        )


-- `INSERT INTO t (…) SELECT … FROM (<the source query>) sky_s`. The source
-- query renders through `prepare`, so its names are checked there; the
-- outer SELECT reads its result columns by name.
prepareCopy : Bool -> Dialect -> StoreRec t -> QuerySpec -> List ( String, CopyFrom ) -> Result Error ( String, List SqlValue )
prepareCopy ignore d s spec mapping =
    case storeError s.name s.pk s.cols s.problems of

        Just e ->
            Err e

        Nothing ->
            if List.isEmpty mapping then
                Err <| storeErr "copyInto: no columns to copy"

            else if spec.joined && isStar spec.out then
                Err <| storeErr "copyInto: a join source needs select first"

            else
                case prepare d spec of

                    Err e ->
                        Err e

                    Ok ( srcSql, srcParams ) ->
                        case copyItems
                                 s
                                 spec.outCols
                                 (isStar spec.out)
                                 mapping
                                 []
                                 []
                                 noParams of

                            Err e ->
                                Err e

                            Ok ( ( cols, exprs ), params ) ->
                                case unmappedError s cols of

                                    Just msg ->
                                        Err <| storeErr ("copyInto: " ++ msg)

                                    Nothing ->
                                        let
                                            stamped =
                                                copyNowCols d s.cols cols
                                        in
                                            Ok
                                                ( "INSERT INTO " ++ s.name
                                                      ++ " ("
                                                      ++ String.join
                                                             ", "
                                                             (cols ++ stamped)
                                                      ++ ") SELECT "
                                                      ++ String.join
                                                             ", "
                                                             (exprs
                                                                 ++ repeatText
                                                                        (List.length
                                                                            stamped)
                                                                        (nowSql d))
                                                      ++ " FROM ("
                                                      ++ srcSql
                                                      ++ ") sky_s"
                                                      ++ (if ignore then
                                                             " WHERE 1 = 1 ON CONFLICT DO NOTHING"

                                                         else
                                                             "")
                                                , params ++ srcParams
                                                )


isStar : Output -> Bool
isStar out =
    case out of

        OutStar ->
            True

        _ ->
            False


copyItems : StoreRec t -> List ( String, String ) -> Bool -> List ( String, CopyFrom ) -> List String -> List String -> List SqlValue -> Result Error ( ( List String, List String ), List SqlValue )
copyItems s srcCols star mapping cols exprs params =
    case mapping of

        [] ->
            Ok ( ( cols, exprs ), params )

        ( field, CopyFrom isCol name v ) :: rest ->
            let
                target = resolveCol s.cols field
            in
                case lookupKind target s.cols of

                    Nothing ->
                        Err <| unknownColErr field s.cols

                    Just tk ->
                        if not (isIdent target) then
                            Err
                                <| storeErr
                                       ("copyInto: column \"" ++ target
                                           ++ "\" is not a valid identifier")

                        else if List.member target cols then
                            Err
                                <| storeErr
                                       ("copyInto: \"" ++ target
                                           ++ "\" is mapped twice")

                        else if String.contains "!" (beforeFlags tk) then
                            Err
                                <| storeErr
                                       ("copyInto: \"" ++ target
                                           ++ "\" is serial: the database assigns it")

                        else if isCol then
                            let
                                src = resolveCol srcCols name
                            in
                                case lookupKind src srcCols of

                                    Nothing ->
                                        Err
                                            <| storeErr
                                                   ("copyInto: \"" ++ name
                                                       ++ "\" is not a column of the source query — columns are "
                                                       ++ colNames srcCols)

                                    Just sk ->
                                        case fitError target tk sk of

                                            Just msg ->
                                                Err
                                                    <| storeErr
                                                           ("copyInto: " ++ msg)

                                            Nothing ->
                                                copyItems
                                                    s
                                                    srcCols
                                                    star
                                                    rest
                                                    (cols ++ [ target ])
                                                    (exprs
                                                        ++ [ "sky_s."
                                                                 ++ (if star then
                                                                        src

                                                                    else
                                                                        quoteAlias
                                                                            src)
                                                           ])
                                                    params

                        else
                            copyItems
                                s
                                srcCols
                                star
                                rest
                                (cols ++ [ target ])
                                (exprs ++ [ castParam tk ])
                                (params ++ [ v ])


-- A target column the mapping leaves out must be nullable, have a declared
-- default, or be filled by the database; a `defaultWith` column must be
-- mapped (the copy does not compute it).
unmappedError : StoreRec t -> List String -> Maybe String
unmappedError s mapped =
    unmappedIn s.cols (computedNames s.computed) s.generated mapped


computedNames : List ( String, () -> SqlValue ) -> List String
computedNames computed =
    case computed of

        [] ->
            []

        ( c, _ ) :: rest ->
            c :: computedNames rest


unmappedIn : List ( String, String ) -> List String -> List String -> List String -> Maybe String
unmappedIn cols computed gen mapped =
    case cols of

        [] ->
            Nothing

        ( c, k ) :: rest ->
            if List.member c mapped then
                unmappedIn rest computed gen mapped

            else if List.member c computed then
                Just
                    ("\"" ++ c
                        ++ "\" has a defaultWith: map it (the copy does not compute it)")

            else if kindNullable k || hasDeclaredDefault k || List.member c gen
                || String.contains "!" (beforeFlags k) then
                unmappedIn rest computed gen mapped

            else
                Just
                    ("required column \"" ++ c
                        ++ "\" is not mapped and has no default")


hasDeclaredDefault : String -> Bool
hasDeclaredDefault k =
    String.contains "|dint=" k || String.contains "|dtext=" k
        || String.contains "|dbool=" k
        || String.contains "|dfloat=" k
        || hasFlag "dnow" k


-- On SQLite an unmapped `defaultNow` column takes the clock (a column that
-- `migrate` added holds the time of the ALTER as its default).
copyNowCols : Dialect -> List ( String, String ) -> List String -> List String
copyNowCols d cols mapped =
    case d of

        Postgres ->
            []

        Sqlite ->
            unmappedNow (nowColsOf cols) mapped


unmappedNow : List ( String, String ) -> List String -> List String
unmappedNow cols mapped =
    case cols of

        [] ->
            []

        ( c, _ ) :: rest ->
            if List.member c mapped then
                unmappedNow rest mapped

            else
                c :: unmappedNow rest mapped


-- The only call site of the RETURNING kernel: the write runs, and each
-- returned row decodes through the codec.
runReturning : Db -> Codec a -> List ( String, String ) -> Result Error ( String, List SqlValue ) -> Task Error (List a)
runReturning conn codec cols prepared =
    case prepared of

        Err e ->
            Task.fail e

        Ok ( sql, params ) ->
            dbWriteReturningObjects
                conn
                (sql ++ " RETURNING " ++ colNames cols)
                params
                [ ( "", "", cols ) ]
                |> Task.andThen
                       (\rows ->
                           Task.fromResult
                               (decodeAll (rowDecoder codec) rows []))

-- ── Project (schema-dump for file-based migrations) ─────────────────────────
-- | A table's schema erased of its record type — name, primary key, and
-- (column, kind) list — for the migration schema-dump. `problems` holds the
-- store's builder problems (see `toTable`); a hand-built `Table` sets
-- `problems = []`.
type alias Table =
    { name : String
    , pk : String
    , cols : List ( String, String )
    , indexes : List IndexSpec
    , problems : List String
    }


-- | Erase a store to its `Table` schema. The store's builder problems (an
-- unknown column in `unique` / `index` / `uniqueOn`, …) go with it, so
-- `pushProject` and `dumpSchema` (`sky db migrate --gen`) refuse the table.
toTable : Store a -> Table
toTable store =
    let
        s = storeRec store
    in
        { name = s.name
        , pk = s.pk
        , cols = withZeros s.codec s.cols
        , indexes = s.indexes
        , problems = s.problems
        }

-- | A project's set of tables — the single declaration `sky db` reads to derive
-- the target schema: `db = Store.project [ Store.toTable users, Store.toTable orders ]`.
type Project
    = Project (List Table)


-- | Build a `Project` from a list of erased tables (via `toTable`). Expose the
-- result as `db : Store.Project` from your entry module for `sky db migrate --gen`.
project : List Table -> Project
project tables =
    Project tables


-- | How many tables the project declares — the count `sky db reset` / `sky db
-- drop` echo in their confirmation prompt.
projectTableCount : Project -> Int
projectTableCount (Project tables) =
    List.length tables


-- | Print the project's schema as JSON (between SKY_SCHEMA_* markers) and exit —
-- the pure, DB-free schema-dump that `sky db migrate --gen` captures to diff
-- against `db/schema.json`. Make this a project's `main` in the gen entry.
dumpSchema : Project -> Task Error ()
dumpSchema (Project tables) =
    case tablesError tables of

        Just e ->
            Task.fail e

        Nothing ->
            dbDumpProject tables


-- The name check every Store verb runs, over a project's tables: each table
-- name follows the identifier rule, each primary key is empty or a column,
-- and no builder recorded a problem.
tablesError : List Table -> Maybe Error
tablesError tables =
    case tables of

        [] ->
            Nothing

        t :: rest ->
            case storeError t.name t.pk t.cols t.problems of

                Just e ->
                    Just e

                Nothing ->
                    tablesError rest


dbDumpProject : List Table -> Task Error ()
dbDumpProject =
    Ffi.kernel "Db_dumpProject"


-- | Push the whole project's schema to the live DB — create each missing table,
-- ADD any new columns and create any missing index, for every store, by the
-- same rule as `migrate`. The no-migration-files
-- "make my dev DB match my types" path (`sky db push`); production uses the
-- committed `db/migrations/` files via `sky db migrate`. Returns the SQL applied.
pushProject : Db -> Project -> Task Error (List String)
pushProject conn (Project tables) =
    pushTables conn tables


pushTables : Db -> List Table -> Task Error (List String)
pushTables conn tables =
    case tables of

        [] ->
            Task.succeed []

        t :: rest ->
            (case storeError t.name t.pk t.cols t.problems of

                Just e ->
                    Task.fail e

                Nothing ->
                    dbAutoMigrate conn t.name t.cols t.pk t.indexes)
                |> Task.andThen
                       (\applied ->
                           Task.map
                               (\more -> applied ++ more)
                               (pushTables conn rest))


-- | EMPTY the data from every table the project declares — keeps the schema and
-- the `_sky_migrations` ledger, resets autoincrement counters. The `sky db reset`
-- path. Returns the SQL executed.
resetProject : Db -> Project -> Task Error (List String)
resetProject conn (Project tables) =
    dbResetTables conn (List.map .name tables)


-- | DROP every table the project declares PLUS `_sky_migrations` — a fresh
-- "never ran migrate/push" state. The `sky db drop` path. Returns the SQL executed.
dropProject : Db -> Project -> Task Error (List String)
dropProject conn (Project tables) =
    dbDropTables conn (List.map .name tables ++ [ "_sky_migrations" ])


-- | EMPTY the data from a single named table (schema + ledger untouched).
resetTable : Db -> String -> Task Error (List String)
resetTable conn name =
    dbResetTables conn [ name ]


-- | DROP a single named table. Does NOT touch `_sky_migrations`.
dropTable : Db -> String -> Task Error (List String)
dropTable conn name =
    dbDropTables conn [ name ]


dbResetTables : Db -> List String -> Task Error (List String)
dbResetTables =
    Ffi.kernel "Db_resetTables"


dbDropTables : Db -> List String -> Task Error (List String)
dbDropTables =
    Ffi.kernel "Db_dropTables"

-- ── Query builder (compose conditions + ordering + paging, no raw SQL) ───────
-- A `Cond` is a composable boolean condition; `and_` / `or_` / `not_` nest them.
-- A `Query r` holds a description of the SELECT (pure data: the source table,
-- conditions, ORDER BY, LIMIT/OFFSET, an optional projection or aggregate) and
-- the decoder for one result row. A terminal (`toList` / `toRows` / `toMaybe` /
-- `count`) checks every name against the codecs, renders the SQL for the
-- connection's dialect and runs it. Every VALUE binds as a `SqlValue` param —
-- injection-safe. A column argument is a codec column (field or snake name) or a
-- `jsonText` reference. Never build a column argument from user input: a
-- `jsonText` reference can read any key of a JSON column.
--
-- | A composable WHERE condition — build a leaf with `eq` / `gt` / `like` / … and
-- combine with `and_` / `or_` / `not_`; apply to a query with `where_`. Opaque
-- (build it with the combinators; don't pattern-match).
type Cond
    = CondOp String String SqlValue
    | CondNull String Bool
    | CondIn String (List SqlValue)
    | CondAnd (List Cond)
    | CondOr (List Cond)
    | CondNot Cond
    | CondCol String String String
    | CondText String String String
    | CondNest Nest

-- A condition that holds a store or a query: `whereLeft` / `whereRight`
-- (kind "side"), `inQuery` / `notInQuery` (kind "in"), `exists` /
-- `notExists` (kind "exists"). One record, so the walk takes it apart once.
type alias Nest =
    { kind : String
    , side : String
    , col : String
    , subCol : String
    , negated : Bool
    , source : Source
    , pairs : List ( String, String )
    , inner : Cond
    , sub : QuerySpec
    }

-- An ORDER BY term: side ("" for any, "left" / "right" in a join), name,
-- direction.
type alias OrderTerm =
    { side : String
    , col : String
    , dir : String
    }

-- | One column of a query, for `inQuery` / `notInQuery`. Build it with
-- `column`. Opaque.
type Subquery
    = Subquery String QuerySpec

-- | The ON pairs of a join: `on` for one pair, `onAll` for several. Opaque.
type JoinOn
    = JoinOn (List ( String, String ))

-- | The pairs that tie an `exists` / `notExists` subquery to the outer row.
-- Build it with `correlate`. Opaque.
type Correlate
    = Correlate (List ( String, String ))

-- | One output column of `aggregate`. Build it with `key`, `keyAs`, `countAs`,
-- `countIfAs`, `countDistinctAs`, `sumAs`, `minAs` or `maxAs`. Opaque.
type Agg
    = Agg String String String Cond

type Output
    = OutStar
    | OutCols (List ( String, String ))
    | OutAggs (List Agg)
    | OutCount

type Dialect
    = Sqlite
    | Postgres

type alias Source =
    { table : String
    , pk : String
    , cols : List ( String, String )
    , problems : List String
    }

type alias QuerySpec =
    { source : Source
    , joined : Bool
    , leftOuter : Bool
    , right : Source
    , onPairs : List ( String, String )
    , onConds : List Cond
    , conds : List Cond
    , orders : List OrderTerm
    , limitN : Maybe Int
    , offsetN : Maybe Int
    , distinct : Bool
    , groups : List String
    , out : Output
    , outCols : List ( String, String )
    , having : List Cond
    , latest : Maybe ( List String, String )
    }

-- | An in-progress query whose rows decode to `r`. Start with `query`, add
-- conditions with `where_`, ordering with `orderAsc` / `orderDesc`, paging with
-- `limit` / `offset`, reshape with `select` / `aggregate`, then run a terminal
-- (`toList` / `toRows` / `toMaybe` / `count`).
type Query r
    = Query QuerySpec (List String -> Result Error r)


-- The ONE place a `Query` is taken apart (see `storeRec`).
specOf : Query r -> QuerySpec
specOf (Query spec _) =
    spec


decoderOf : Query r -> List String -> Result Error r
decoderOf (Query _ dec) =
    dec


mapSpec : (QuerySpec -> QuerySpec) -> Query r -> Query r
mapSpec f q =
    Query (f (specOf q)) (decoderOf q)


-- | Start a query over a store:
-- `Store.query products |> Store.where_ (Store.eq "active" (SqlBool True)) |> Store.toList conn`.
query : Store a -> Query a
query store =
    Query (baseSpec (sourceOf store)) (rowDecoder (storeRec store).codec)


sourceOf : Store a -> Source
sourceOf store =
    let
        s = storeRec store
    in
        { table = s.name, pk = s.pk, cols = s.cols, problems = s.problems }


baseSpec : Source -> QuerySpec
baseSpec src =
    { source = src
    , joined = False
    , leftOuter = False
    , right = src
    , onPairs = []
    , onConds = []
    , conds = []
    , orders = []
    , limitN = Nothing
    , offsetN = Nothing
    , distinct = False
    , groups = []
    , out = OutStar
    , outCols = src.cols
    , having = []
    , latest = Nothing
    }


rowDecoder : Codec r -> List String -> Result Error r
rowDecoder codec groups =
    case groups of

        j :: _ ->
            Codec.fromJson codec j

        [] ->
            Err (Error.decode "Store: a result row had no columns")


-- | Add a condition. Multiple `where_` calls are AND-combined; use `and_` / `or_`
-- / `not_` inside one call for grouped OR / negation:
-- `q |> where_ (eq "a" x) |> where_ (or_ [ gt "b" y, eq "c" z ])`.
where_ : Cond -> Query r -> Query r
where_ c q =
    mapSpec (\s -> { s | conds = c :: s.conds }) q


-- ── Condition leaves (each returns a `Cond`) ─────────────────────────────────
-- | `col = value`.
eq : String -> SqlValue -> Cond
eq col v =
    CondOp col "=" v


-- | `col <> value`.
neq : String -> SqlValue -> Cond
neq col v =
    CondOp col "<>" v


-- | `col > value`.
gt : String -> SqlValue -> Cond
gt col v =
    CondOp col ">" v


-- | `col >= value`.
gte : String -> SqlValue -> Cond
gte col v =
    CondOp col ">=" v


-- | `col < value`.
lt : String -> SqlValue -> Cond
lt col v =
    CondOp col "<" v


-- | `col <= value`.
lte : String -> SqlValue -> Cond
lte col v =
    CondOp col "<=" v


-- | `col LIKE pattern`. The pattern is used as given: `%` and `_` are
-- wildcards and there is no escape. It is case-sensitive on PostgreSQL and
-- ignores ASCII case on SQLite. For text a user typed, use `contains`,
-- `startsWith`, `endsWith`, `eqCi` or `containsCi`, which escape the needle
-- and match the same way on both dialects.
like : String -> String -> Cond
like col pat =
    CondOp col "LIKE" (SqlString pat)


-- | `col` equals `text`, ignoring case (`LOWER(col) = LOWER(?)`). A text column
-- only. SQLite's `LOWER` folds ASCII letters only; PostgreSQL folds all letters.
eqCi : String -> String -> Cond
eqCi col text =
    CondText "eqCi" col text


-- | `col` contains `needle`, case-sensitive on both dialects. `%`, `_` and `!`
-- in the needle are literal. An empty needle matches every non-NULL row.
contains : String -> String -> Cond
contains col needle =
    CondText "contains" col needle


-- | `col` contains `needle`, ignoring case. `%`, `_` and `!` in the needle are
-- literal. An empty needle matches every non-NULL row.
containsCi : String -> String -> Cond
containsCi col needle =
    CondText "containsCi" col needle


-- | `col` starts with `prefix`, case-sensitive on both dialects. An empty
-- prefix matches every non-NULL row.
startsWith : String -> String -> Cond
startsWith col prefix =
    CondText "startsWith" col prefix


-- | `col` ends with `suffix`, case-sensitive on both dialects:
-- `Store.endsWith "email" "@work.io"`. An empty suffix matches every non-NULL row.
endsWith : String -> String -> Cond
endsWith col suffix =
    CondText "endsWith" col suffix


-- | `left = right`, two columns of the same kind.
eqCol : String -> String -> Cond
eqCol left right =
    CondCol "=" left right


-- | `left <> right`, two columns of the same kind.
neqCol : String -> String -> Cond
neqCol left right =
    CondCol "<>" left right


-- | `left > right`, two columns of the same kind:
-- `Store.gtCol "last_staff_at" "customer_read_at"`.
gtCol : String -> String -> Cond
gtCol left right =
    CondCol ">" left right


-- | `left >= right`, two columns of the same kind.
gteCol : String -> String -> Cond
gteCol left right =
    CondCol ">=" left right


-- | `left < right`, two columns of the same kind.
ltCol : String -> String -> Cond
ltCol left right =
    CondCol "<" left right


-- | `left <= right`, two columns of the same kind.
lteCol : String -> String -> Cond
lteCol left right =
    CondCol "<=" left right


-- | A reference to one key of a JSON text column, usable wherever a column name
-- is (a condition, `groupBy`, `keyAs`, `selectAs`, an order term):
-- `Store.eq (Store.jsonText "props" "source") (SqlString "web")`. The value is
-- the key's text, or NULL when the key is missing: a JSON `true` reads `"true"`
-- on both dialects, a number reads as its text (which can differ between
-- SQLite and PostgreSQL, e.g. `1e2`). The column must be a text or blob column,
-- the key follows the identifier rule, and a compared value must be `SqlString`.
jsonText : String -> String -> String
jsonText col jsonKey =
    col ++ "->>" ++ jsonKey


-- | `col IS NULL`.
isNull : String -> Cond
isNull col =
    CondNull col True


-- | `col IS NOT NULL`.
notNull : String -> Cond
notNull col =
    CondNull col False


-- | `col IN (v1, v2, …)`. An empty list matches nothing.
inList : String -> List SqlValue -> Cond
inList col vs =
    CondIn col vs


-- ── Condition combinators ────────────────────────────────────────────────────
-- | All of the conditions (AND). An empty list is always true.
and_ : List Cond -> Cond
and_ conds =
    CondAnd conds


-- | Any of the conditions (OR). An empty list is always false.
or_ : List Cond -> Cond
or_ conds =
    CondOr conds


-- | Negate a condition (NOT).
not_ : Cond -> Cond
not_ cond =
    CondNot cond


-- ── Subquery conditions ──────────────────────────────────────────────────────
-- | One column of a query, for `inQuery` / `notInQuery`:
--
--     Store.deleteWhere conn importRows
--         (Store.inQuery "batch_id"
--             (Store.query importBatches
--                 |> Store.where_ (Store.lt "created_at" (SqlInt cutoff))
--                 |> Store.column "id"))
--
-- The column is checked against the inner store's codec when the outer query
-- or write runs. The inner query takes `where_`, `orderAsc` / `orderDesc`,
-- `limit` and `offset` (a `limit` or `offset` needs an order); a `select`,
-- `aggregate`, `groupBy`, `distinct`, `latestPer` or join there is an `Err`.
column : String -> Query a -> Subquery
column col q =
    Subquery col (specOf q)


-- | `col IN (SELECT …)`: the outer column equals a value of the subquery
-- column. Both columns must be of one kind. The subquery leaves out its NULLs
-- (`… AND inner IS NOT NULL`), so an outer NULL never matches, and
-- `not_ (inQuery …)` keeps an outer value that is not in the set even when the
-- inner column holds NULL. Under `not_` (or `notInQuery`), an outer NULL is
-- left out when the inner set has rows and kept when it is empty
-- (`NULL NOT IN ()` is true on both engines). One statement: a delete or
-- update with `inQuery` sees the inner rows of the same moment.
inQuery : String -> Subquery -> Cond
inQuery col sub =
    subNest col False sub


-- | `col NOT IN (SELECT …)`, the same as `not_ (inQuery col sub)`.
notInQuery : String -> Subquery -> Cond
notInQuery col sub =
    subNest col True sub


subNest : String -> Bool -> Subquery -> Cond
subNest col negated (Subquery inner spec) =
    CondNest
        { kind = "in"
        , side = ""
        , col = col
        , subCol = inner
        , negated = negated
        , source = spec.source
        , pairs = []
        , inner = noCond
        , sub = spec
        }


-- A nest whose unused fields hold neutral values.
nestOf : String -> String -> Bool -> Source -> List ( String, String ) -> Cond -> Cond
nestOf kind side negated src pairs inner =
    CondNest
        { kind = kind
        , side = side
        , col = ""
        , subCol = ""
        , negated = negated
        , source = src
        , pairs = pairs
        , inner = inner
        , sub = baseSpec src
        }


-- | `EXISTS (SELECT 1 FROM inner WHERE <correlate pairs> AND (<cond>))`: true
-- when the other store has a row tied to the outer row that meets `cond`.
-- Names in `cond` are columns of the inner store; `correlate inner outer` ties
-- them to the outer row:
--
--     Store.query customers
--         |> Store.where_
--             (Store.notExists invoices
--                 (Store.correlate "customer_id" "id")
--                 (Store.gt "sent_at" (SqlInt since)))
--
-- Use `Store.and_ []` for no extra condition.
exists : Store b -> Correlate -> Cond -> Cond
exists store corr cond =
    nestOf "exists" "" False (sourceOf store) (correlatePairs corr) cond


-- | `NOT EXISTS (…)`: true when the other store has no such row.
notExists : Store b -> Correlate -> Cond -> Cond
notExists store corr cond =
    nestOf "exists" "" True (sourceOf store) (correlatePairs corr) cond


-- | Tie an inner column (of the `exists` store) to an outer column (of the
-- query, or of the store a write changes).
correlate : String -> String -> Correlate
correlate inner outer =
    Correlate [ ( inner, outer ) ]


-- | Several `correlate` pairs, all of which must be equal (a tenant column and
-- an id, for example).
correlateAll : List ( String, String ) -> Correlate
correlateAll pairs =
    Correlate pairs


correlatePairs : Correlate -> List ( String, String )
correlatePairs (Correlate pairs) =
    pairs


-- ── Ordering + paging ────────────────────────────────────────────────────────
-- | Append `ORDER BY col ASC` (chain for multi-column ordering). On a nullable
-- column NULLs come first, on both dialects.
orderAsc : String -> Query r -> Query r
orderAsc col q =
    mapSpec
        (\s -> { s | orders = { side = "", col = col, dir = "ASC" } :: s.orders })
        q


-- | Append `ORDER BY col DESC`. On a nullable column NULLs come last, on both
-- dialects. After `aggregate`, name a result field.
orderDesc : String -> Query r -> Query r
orderDesc col q =
    mapSpec
        (\s ->
            { s | orders = { side = "", col = col, dir = "DESC" } :: s.orders })
        q


-- | `LIMIT n`. A negative `n` makes the query fail before it runs.
limit : Int -> Query r -> Query r
limit n q =
    mapSpec (\s -> { s | limitN = Just n }) q


-- | `OFFSET n`, with or without `limit`. A negative `n` makes the query fail
-- before it runs.
offset : Int -> Query r -> Query r
offset n q =
    mapSpec (\s -> { s | offsetN = Just n }) q


-- ── Projection, DISTINCT, newest row per key ─────────────────────────────────
-- | Read only the columns of a smaller record: each field of `codec` takes the
-- store column of the same name. A nullable column needs a `Maybe` field.
--
--     Store.query orders |> Store.select summaryCodec |> Store.toList conn
select : Codec r -> Query a -> Query r
select codec q =
    selectAs codec [] q


-- | `select` with explicit sources: each `( field, source )` pair reads `source`
-- (a column or a `jsonText` reference) into `field`. Fields not listed take the
-- column of the same name.
selectAs : Codec r -> List ( String, String ) -> Query a -> Query r
selectAs codec pairs q =
    let
        spec = specOf q
    in
        Query
            { spec | out = OutCols pairs, outCols = codecColumns codec }
            (rowDecoder codec)


-- | Read one column into a list of plain values:
-- `Store.query orders |> Store.selectColumn "id" Codec.string |> Store.toList conn`
-- gives `List String`. `codec` must be a scalar codec (not a record).
selectColumn : String -> Codec c -> Query a -> Query c
selectColumn col codec q =
    let
        wrapped =
            Codec.object (\v -> v) |> Codec.field "value" (\v -> v) codec
                |> Codec.buildObject
        spec = specOf q
        source = spec.source
        problems =
            case Codec.shape codec of

                SRecord _ ->
                    source.problems
                        ++ [ "Store.selectColumn \"" ++ col
                                 ++ "\": the codec must be a scalar codec, not a record codec"
                           ]

                _ ->
                    source.problems
    in
        Query
            { spec
                | source = { source | problems = problems }
                , out = OutCols [ ( "value", col ) ]
                , outCols = codecColumns wrapped
            }
            (rowDecoder wrapped)


-- | `SELECT DISTINCT`: drop duplicate result rows. With `select`, every order
-- column must be one of the selected columns.
distinct : Query r -> Query r
distinct q =
    mapSpec (\s -> { s | distinct = True }) q


-- | Keep the newest row per key: for each distinct value of the `keys`
-- columns, the row with the largest `newestBy` (NULL is never the newest; ties
-- go to the larger primary key). Conditions apply before the pick:
--
--     Store.query orders
--         |> Store.where_ (Store.eq "status" (SqlString "open"))
--         |> Store.latestPer [ "customer_id" ] "created_at"
--         |> Store.toList conn
--
-- Not with `distinct`, `groupBy` or `aggregate`.
latestPer : List String -> String -> Query r -> Query r
latestPer keys newestBy q =
    mapSpec (\s -> { s | latest = Just ( keys, newestBy ) }) q


-- ── Grouped aggregates ───────────────────────────────────────────────────────
-- | `GROUP BY` these columns (or `jsonText` references). Use with `aggregate`.
groupBy : List String -> Query r -> Query r
groupBy cols q =
    mapSpec (\s -> { s | groups = s.groups ++ cols }) q


-- | Turn a query into one row per group, decoded by `codec`. Each field of the
-- result codec is covered by exactly one `Agg`:
--
--     Store.query invoices
--         |> Store.where_ (Store.gt "sent_at" (SqlInt since))
--         |> Store.groupBy [ "customer_id" ]
--         |> Store.aggregate tallyCodec
--             [ Store.key "customer_id"
--             , Store.countAs "sent"
--             , Store.countIfAs "opened" (Store.gt "opened_at" (SqlInt 0))
--             , Store.maxAs "last_sent_at" "sent_at"
--             ]
--         |> Store.having (Store.gte "sent" (SqlInt 2))
--         |> Store.orderDesc "sent"
--         |> Store.toRows conn
--
-- Without `groupBy` the result is one row over the whole selection (an empty
-- table gives zero counts and sums, and `Nothing` for `minAs` / `maxAs`).
aggregate : Codec r -> List Agg -> Query a -> Query r
aggregate codec aggs q =
    let
        spec = specOf q
    in
        Query
            { spec | out = OutAggs aggs, outCols = codecColumns codec }
            (rowDecoder codec)


noCond : Cond
noCond =
    CondAnd []


-- | The group column itself, into the result field of the same name. The
-- column must be in `groupBy`.
key : String -> Agg
key col =
    Agg "key" col col noCond


-- | A group column (or `jsonText` reference) into the named result field.
keyAs : String -> String -> Agg
keyAs field col =
    Agg "key" field col noCond


-- | `COUNT(*)` into an `Int` field.
countAs : String -> Agg
countAs field =
    Agg "count" field "" noCond


-- | The number of rows in the group that match `cond`, into an `Int` field (0
-- when none match).
countIfAs : String -> Cond -> Agg
countIfAs field cond =
    Agg "countIf" field "" cond


-- | `COUNT(DISTINCT col)` into an `Int` field (NULL is not counted).
countDistinctAs : String -> String -> Agg
countDistinctAs field col =
    Agg "countDistinct" field col noCond


-- | The sum of an `Int` or `Float` column into a field of the same kind (0 for
-- an empty group).
sumAs : String -> String -> Agg
sumAs field col =
    Agg "sum" field col noCond


-- | The smallest value of a column (not a `Bool` column). The field needs
-- `Maybe` when the column is nullable or there is no `groupBy`. Text compares
-- by the database collation, which can differ between SQLite and PostgreSQL.
minAs : String -> String -> Agg
minAs field col =
    Agg "min" field col noCond


-- | The largest value of a column (not a `Bool` column). The field needs
-- `Maybe` when the column is nullable or there is no `groupBy`.
maxAs : String -> String -> Agg
maxAs field col =
    Agg "max" field col noCond


-- | A condition on the aggregate results (`HAVING`). Name result fields:
-- `Store.having (Store.gte "sent" (SqlInt 2))`. Several `having` calls are
-- AND-combined.
having : Cond -> Query r -> Query r
having c q =
    mapSpec (\s -> { s | having = c :: s.having }) q


-- ── Joins of two stores ──────────────────────────────────────────────────────
-- | An inner join: every pair of a left row and a right row whose ON columns
-- are equal. Run it with `toPairs`:
--
--     Store.join invoices customers
--             (Store.onAll [ ( "region_id", "region_id" ), ( "customer_id", "id" ) ])
--         |> Store.whereLeft (Store.eq "region_id" (SqlString regionId))
--         |> Store.whereRight (Store.eq "archived" (SqlBool False))
--         |> Store.orderLeftDesc "sent_at"
--         |> Store.limit 50
--         |> Store.toPairs conn          -- Task Error (List ( Invoice, Customer ))
--
-- In SQL the left store is `a` and the right store is `b`. A name in
-- `where_`, `orderAsc`, `select`, `groupBy` or an `Agg` reads the store that
-- has that column. A column both stores have must be written `"a.col"` or
-- `"b.col"`, else the query is an `Err`. `whereLeft` / `whereRight` and
-- `orderLeft*` / `orderRight*` read one side. ON columns must be of one kind.
-- A join reads two stores only: a join of three tables is not expressible
-- (use `selectRaw`). `latestPer` does not take a join.
join : Store a -> Store b -> JoinOn -> Query ( a, b )
join left right ons =
    let
        l = storeRec left
        r = storeRec right
    in
        Query
            (joinSpec False (sourceOf left) (sourceOf right) (joinPairs ons))
            (pairDecoder l.codec r.codec)


-- | A left join: every left row, paired with `Just` its matching right row, or
-- with `Nothing` when no right row matches. Run it with `toPairsMaybe`:
--
--     Store.leftJoin invoices customers (Store.on "customer_id" "id")
--         |> Store.toPairsMaybe conn     -- Task Error (List ( Invoice, Maybe Customer ))
--
-- `whereRight` conditions go into the ON clause, so they choose the matching
-- right row and never drop a left row. A right column can be NULL in every
-- row, so `select` and an `Agg` need a `Maybe` field for it.
leftJoin : Store a -> Store b -> JoinOn -> Query ( a, Maybe b )
leftJoin left right ons =
    let
        l = storeRec left
        r = storeRec right
    in
        Query
            (joinSpec True (sourceOf left) (sourceOf right) (joinPairs ons))
            (pairMaybeDecoder l.codec r.codec)


-- | One ON pair: a left column and a right column that must be equal.
on : String -> String -> JoinOn
on leftCol rightCol =
    JoinOn [ ( leftCol, rightCol ) ]


-- | Several ON pairs, all of which must be equal. An empty list is an `Err`.
onAll : List ( String, String ) -> JoinOn
onAll pairs =
    JoinOn pairs


-- | A condition on the left store of a join. On a query that is not a join it
-- is an `Err` when the query runs.
whereLeft : Cond -> Query r -> Query r
whereLeft c q =
    mapSpec (\s -> { s | conds = sideNest "left" c :: s.conds }) q


-- | A condition on the right store of a join. On a `leftJoin` it goes into the
-- ON clause (it picks the right row and keeps every left row); on a `join` it
-- goes into WHERE. On a query that is not a join it is an `Err` when the query
-- runs.
whereRight : Cond -> Query r -> Query r
whereRight c q =
    mapSpec
        (\s ->
            if s.leftOuter then
                { s | onConds = c :: s.onConds }

            else
                { s | conds = sideNest "right" c :: s.conds })
        q


sideNest : String -> Cond -> Cond
sideNest side c =
    nestOf "side" side False emptySource [] c


emptySource : Source
emptySource =
    { table = "", pk = "", cols = [], problems = [] }


-- | `ORDER BY` a left column, ascending. Only on a join.
orderLeftAsc : String -> Query r -> Query r
orderLeftAsc col q =
    mapSpec
        (\s ->
            { s
                | orders = { side = "left", col = col, dir = "ASC" } :: s.orders
            })
        q


-- | `ORDER BY` a left column, descending. Only on a join.
orderLeftDesc : String -> Query r -> Query r
orderLeftDesc col q =
    mapSpec
        (\s ->
            { s
                | orders =
                    { side = "left", col = col, dir = "DESC" } :: s.orders
            })
        q


-- | `ORDER BY` a right column, ascending. Only on a join.
orderRightAsc : String -> Query r -> Query r
orderRightAsc col q =
    mapSpec
        (\s ->
            { s
                | orders =
                    { side = "right", col = col, dir = "ASC" } :: s.orders
            })
        q


-- | `ORDER BY` a right column, descending. Only on a join.
orderRightDesc : String -> Query r -> Query r
orderRightDesc col q =
    mapSpec
        (\s ->
            { s
                | orders =
                    { side = "right", col = col, dir = "DESC" } :: s.orders
            })
        q


joinPairs : JoinOn -> List ( String, String )
joinPairs (JoinOn pairs) =
    pairs


joinSpec : Bool -> Source -> Source -> List ( String, String ) -> QuerySpec
joinSpec isLeft l r pairs =
    let
        base = baseSpec l
    in
        { base | joined = True, leftOuter = isLeft, right = r, onPairs = pairs }


pairDecoder : Codec a -> Codec b -> List String -> Result Error ( a, b )
pairDecoder ca cb groups =
    case groups of

        [ ja, jb ] ->
            case Codec.fromJson ca ja of

                Err e ->
                    Err e

                Ok a ->
                    case Codec.fromJson cb jb of

                        Err e ->
                            Err e

                        Ok b ->
                            Ok ( a, b )

        _ ->
            Err (Error.decode "Store: a joined row needs two column groups")


pairMaybeDecoder : Codec a -> Codec b -> List String -> Result Error ( a, Maybe b )
pairMaybeDecoder ca cb groups =
    case groups of

        [ ja, jb ] ->
            case Codec.fromJson ca ja of

                Err e ->
                    Err e

                Ok a ->
                    if jb == "null" then
                        Ok ( a, Nothing )

                    else
                        case Codec.fromJson cb jb of

                            Err e ->
                                Err e

                            Ok b ->
                                Ok ( a, Just b )

        _ ->
            Err (Error.decode "Store: a joined row needs two column groups")


-- ── Terminals ────────────────────────────────────────────────────────────────
-- | Run the query, decoding every matching row.
toList : Db -> Query r -> Task Error (List r)
toList conn q =
    readRows conn (prepare (dialectOf conn) (specOf q)) (groupsOf (specOf q))
        |> Task.andThen
               (\rows -> Task.fromResult (decodeAll (decoderOf q) rows []))


-- | Run a `join`: each row is a ( left, right ) pair. The same as `toList`,
-- with the pair type written out.
toPairs : Db -> Query ( a, b ) -> Task Error (List ( a, b ))
toPairs conn q =
    toList conn q


-- | Run a `leftJoin`: each row is a left row and `Just` its right row, or
-- `Nothing` when no right row matched. The same as `toList`, with the pair
-- type written out.
toPairsMaybe : Db -> Query ( a, Maybe b ) -> Task Error (List ( a, Maybe b ))
toPairsMaybe conn q =
    toList conn q


-- | The same as `toList`. Reads well after `aggregate`.
toRows : Db -> Query r -> Task Error (List r)
toRows conn q =
    toList conn q


-- | Run the query with `LIMIT 1`, returning the first matching row or `Nothing`.
toMaybe : Db -> Query r -> Task Error (Maybe r)
toMaybe conn q =
    toList conn (limit 1 q) |> Task.map List.head


-- | Count result rows (filters apply; order and paging are ignored). After
-- `distinct`, `latestPer` or `aggregate` it counts the rows that query returns.
count : Db -> Query r -> Task Error Int
count conn q =
    readRows conn (prepareCount (dialectOf conn) (specOf q)) countGroups
        |> Task.andThen (\rows -> Task.fromResult (countOf rows))


-- | The SQL text and parameters a query renders on this connection's dialect,
-- with `?` placeholders (PostgreSQL's `$n` are numbered when it runs), or the
-- `Err` the query would fail with. For tests and logs.
toSql : Db -> Query r -> Result Error ( String, List SqlValue )
toSql conn q =
    prepare (dialectOf conn) (specOf q)


-- | Run a callback inside a DB transaction — Store operations compose by taking
-- the `tx` handle. Alias over `Db.withTransaction`, so read / write / transact
-- all stay in the `Store.*` namespace.
transaction : Db -> (Db -> Task Error a) -> Task Error a
transaction conn f =
    Db.withTransaction conn f


-- | Encode a TYPED value to a `SqlValue` via its codec, so a filter can compare
-- against an enum / `Money` / `Time` / `Codec.map` wrapper using the SAME encoding
-- the column stores — no manual `SqlString`/`SqlInt` wrapping, no drift:
-- `where_ (Store.eq "status" (Store.sqlOf statusCodec Shipped))`.
sqlOf : Codec a -> a -> SqlValue
sqlOf codec value =
    dbSqlOfValue (Codec.toValue codec value)


dbSqlOfValue : Value -> SqlValue
dbSqlOfValue =
    Ffi.kernel "Db_sqlOfValue"


-- ── The read and write runners ───────────────────────────────────────────────
-- The only call site of the read kernel and of `Db_exec` for Store SQL. Each
-- row comes back as one JSON text per column group (see `groupsOf`).
readRows : Db -> Result Error ( String, List SqlValue ) -> List ( String, String, List ( String, String ) ) -> Task Error (List (List String))
readRows conn prepared groups =
    case prepared of

        Err e ->
            Task.fail e

        Ok ( sql, params ) ->
            dbQueryObjectGroups conn sql params groups


-- The column groups of a result row: one for a plain query or a reshaped one,
-- two (`a__` and `b__` prefixes) for the rows of a join. On a LEFT join the
-- right group is `null` when its first ON column is NULL.
groupsOf : QuerySpec -> List ( String, String, List ( String, String ) )
groupsOf spec =
    case spec.out of

        OutStar ->
            if spec.joined then
                [ ( "a__", "", spec.source.cols )
                , ( "b__"
                  , if spec.leftOuter then
                        markerOf spec.right.cols spec.onPairs

                    else
                        ""
                  , spec.right.cols
                  )
                ]

            else
                [ ( "", "", spec.outCols ) ]

        _ ->
            [ ( "", "", spec.outCols ) ]


markerOf : List ( String, String ) -> List ( String, String ) -> String
markerOf rightCols pairs =
    case pairs of

        ( _, rc ) :: _ ->
            resolveCol rightCols (unqualified "b" rc)

        [] ->
            ""


-- `"b.col"` → `"col"`; any other name is returned as it is.
unqualified : String -> String -> String
unqualified q name =
    case String.split "." name of

        [ p, bare ] ->
            if p == q then
                bare

            else
                name

        _ ->
            name


countGroups : List ( String, String, List ( String, String ) )
countGroups =
    [ ( "", "", [ ( "n", "int" ) ] ) ]


runExec : Db -> Result Error ( String, List SqlValue ) -> Task Error Int
runExec conn prepared =
    case prepared of

        Err e ->
            Task.fail e

        Ok ( sql, params ) ->
            dbExecV conn sql params


decodeAll : (List String -> Result Error r) -> List (List String) -> List r -> Result Error (List r)
decodeAll dec rows acc =
    case rows of

        [] ->
            Ok (List.reverse acc)

        j :: rest ->
            case dec j of

                Ok x ->
                    decodeAll dec rest (x :: acc)

                Err e ->
                    Err e


countOf : List (List String) -> Result Error Int
countOf rows =
    case rows of

        (j :: _) :: _ ->
            Codec.fromJson countCodec j

        _ ->
            Ok 0


countCodec : Codec Int
countCodec =
    Codec.object (\n -> n) |> Codec.field "n" (\n -> n) Codec.int
        |> Codec.buildObject


dialectOf : Db -> Dialect
dialectOf conn =
    if dbDialect conn == "postgres" then
        Postgres

    else
        Sqlite


-- ── The prepare path ─────────────────────────────────────────────────────────
-- Checks every name, then renders text and parameters together, left to right
-- (SELECT list, WHERE, HAVING; GROUP BY, ORDER BY, LIMIT carry none). Nothing
-- reaches the database unless this returns `Ok`.
prepare : Dialect -> QuerySpec -> Result Error ( String, List SqlValue )
prepare d spec =
    let
        src = spec.source
        ctx = specCtx d 0 "" spec
    in
        case storeError src.table src.pk src.cols src.problems of

            Just e ->
                Err e

            Nothing ->
                case shapeError spec of

                    Just msg ->
                        Err <| storeErr msg

                    Nothing ->
                        case selectList ctx spec of

                            Err e ->
                                Err e

                            Ok ( selSql, selParams, aliases ) ->
                                case fromClause ctx spec of

                                    Err e ->
                                        Err e

                                    Ok ( fromSql, fromParams ) ->
                                        case whereClause ctx spec.conds of

                                            Err e ->
                                                Err e

                                            Ok ( whereSql, whereParams ) ->
                                                case clauseTail ctx spec aliases of

                                                    Err e ->
                                                        Err e

                                                    Ok ( tailSql, tailParams ) ->
                                                        case latestCheck
                                                                 ctx
                                                                 spec of

                                                            Err e ->
                                                                Err e

                                                            Ok window ->
                                                                Ok
                                                                    ( assemble
                                                                          spec
                                                                          window
                                                                          fromSql
                                                                          selSql
                                                                          whereSql
                                                                          tailSql
                                                                    , selParams
                                                                          ++ fromParams
                                                                          ++ whereParams
                                                                          ++ tailParams
                                                                    )


-- The FROM clause: the table, or `left a INNER|LEFT JOIN right b ON …`. On a
-- LEFT join the `whereRight` conditions are part of ON.
fromClause : Ctx -> QuerySpec -> Result Error ( String, List SqlValue )
fromClause ctx spec =
    if not spec.joined then
        Ok ( spec.source.table, noParams )

    else
        let
            r = spec.right
        in
            case storeError r.table r.pk r.cols r.problems of

                Just e ->
                    Err e

                Nothing ->
                    case onPairs ctx spec.onPairs [] of

                        Err e ->
                            Err e

                        Ok onSql ->
                            case onExtra ctx spec.onConds of

                                Err e ->
                                    Err e

                                Ok ( extraSql, extraParams ) ->
                                    Ok
                                        ( spec.source.table
                                              ++ (if spec.leftOuter then
                                                     " a LEFT JOIN "

                                                 else
                                                     " a INNER JOIN ")
                                              ++ r.table
                                              ++ " b ON "
                                              ++ onSql
                                              ++ extraSql
                                        , extraParams
                                        )


-- `a.x = b.y AND …`, each column checked on its own side, kinds equal.
onPairs : Ctx -> List ( String, String ) -> List String -> Result Error String
onPairs ctx pairs acc =
    case pairs of

        [] ->
            case acc of

                [] ->
                    Err <| storeErr "a join needs at least one ON pair"

                _ ->
                    Ok (String.join " AND " (List.reverse acc))

        ( lc, rc ) :: rest ->
            case colRef { ctx | side = "left" } lc of

                Err e ->
                    Err e

                Ok ( lSql, lk ) ->
                    case colRef { ctx | side = "right" } rc of

                        Err e ->
                            Err e

                        Ok ( rSql, rk ) ->
                            if kindBase lk /= kindBase rk then
                                Err
                                    <| storeErr
                                           ("join: ON \"" ++ lc ++ "\" is "
                                               ++ kindBase lk
                                               ++ " and \""
                                               ++ rc
                                               ++ "\" is "
                                               ++ kindBase rk
                                               ++ ": the ON columns must be of one kind")

                            else
                                onPairs
                                    ctx
                                    rest
                                    ((lSql ++ " = " ++ rSql) :: acc)


onExtra : Ctx -> List Cond -> Result Error ( String, List SqlValue )
onExtra ctx conds =
    case conds of

        [] ->
            Ok ( "", noParams )

        _ ->
            case renderCond
                     { ctx | side = "right" }
                     (CondAnd (List.reverse conds)) of

                Err e ->
                    Err e

                Ok ( sql, params ) ->
                    Ok ( " AND " ++ sql, params )


-- `count`: the plain form keeps its text (`SELECT COUNT(*) AS n FROM t …`). A
-- query that reshapes its rows is counted as a subquery.
prepareCount : Dialect -> QuerySpec -> Result Error ( String, List SqlValue )
prepareCount d spec =
    let
        trimmed =
            { spec | orders = [], limitN = Nothing, offsetN = Nothing }
    in
        if isPlain spec then
            prepare d { trimmed | out = OutCount }

        else
            case prepare d trimmed of

                Err e ->
                    Err e

                Ok ( sql, params ) ->
                    Ok
                        ( "SELECT COUNT(*) AS n FROM (" ++ sql ++ ") sky_c"
                        , params
                        )


isPlain : QuerySpec -> Bool
isPlain spec =
    case spec.out of

        OutStar ->
            not spec.distinct && List.isEmpty spec.groups
                && noLatest spec.latest

        _ ->
            False


-- A `case`, not `== Nothing`: the comparison is a run-time narrowing.
noLatest : Maybe ( List String, String ) -> Bool
noLatest latest =
    case latest of

        Nothing ->
            True

        Just _ ->
            False


isSetInt : Maybe Int -> Bool
isSetInt m =
    case m of

        Just _ ->
            True

        Nothing ->
            False


isAggregate : Output -> Bool
isAggregate out =
    case out of

        OutAggs _ ->
            True

        _ ->
            False


-- The combinations that have no single meaning.
shapeError : QuerySpec -> Maybe String
shapeError spec =
    let
        agg = isAggregate spec.out
    in
        if not agg && not (List.isEmpty spec.groups) then
            Just "groupBy needs aggregate"

        else if not agg && not (List.isEmpty spec.having) then
            Just "having needs aggregate"

        else
            case spec.latest of

                Nothing ->
                    Nothing

                Just _ ->
                    if agg || spec.distinct then
                        Just
                            "latestPer cannot be combined with distinct, groupBy or aggregate"

                    else if spec.joined then
                        Just "latestPer cannot be combined with a join"

                    else
                        Nothing


assemble : QuerySpec -> String -> String -> String -> String -> String -> String
assemble spec window fromSql selSql whereSql tailSql =
    let
        src = spec.source
        distinctKw =
            if spec.distinct then
                "DISTINCT "

            else
                ""
    in
        case spec.latest of

            Nothing ->
                "SELECT " ++ distinctKw ++ selSql ++ " FROM " ++ fromSql
                    ++ whereSql
                    ++ tailSql

            Just _ ->
                "SELECT " ++ selSql ++ " FROM (SELECT " ++ src.table
                    ++ ".*, ROW_NUMBER() OVER ("
                    ++ window
                    ++ ") AS sky_rn FROM "
                    ++ src.table
                    ++ whereSql
                    ++ ") sky_l WHERE sky_rn = 1"
                    ++ tailSql


-- PARTITION BY keys ORDER BY newest DESC NULLS LAST, pk DESC.
latestRendered : Ctx -> String -> List String -> String -> Result Error String
latestRendered ctx pk keys newestBy =
    case refList ctx keys [] of

        Err e ->
            Err e

        Ok keySqls ->
            case refOf ctx newestBy of

                Err e ->
                    Err e

                Ok ( nSql, _, _ ) ->
                    let
                        tie =
                            if pk == "" || pk == nSql then
                                ""

                            else
                                ", " ++ pk ++ " DESC"
                        partition =
                            case keySqls of

                                [] ->
                                    ""

                                _ ->
                                    "PARTITION BY " ++ String.join ", " keySqls
                                        ++ " "
                    in
                        Ok
                            (partition ++ "ORDER BY " ++ nSql
                                ++ " DESC NULLS LAST"
                                ++ tie)


-- ── The SELECT list ──────────────────────────────────────────────────────────
-- Returns the list text, its params, and the alias table HAVING reads.
selectList : Ctx -> QuerySpec -> Result Error ( String, List SqlValue, List ( String, Ref ) )
selectList ctx spec =
    case spec.out of

        OutStar ->
            if not spec.joined then
                Ok ( "*", [], [] )

            else
                case prefixedItems "a" spec.source.cols [] of

                    Err e ->
                        Err e

                    Ok leftItems ->
                        case prefixedItems "b" spec.right.cols [] of

                            Err e ->
                                Err e

                            Ok rightItems ->
                                Ok
                                    ( String.join ", " (leftItems ++ rightItems)
                                    , []
                                    , []
                                    )

        OutCount ->
            Ok ( "COUNT(*) AS n", [], [] )

        OutCols pairs ->
            case projection ctx spec.outCols pairs of

                Err e ->
                    Err e

                Ok ( items, _ ) ->
                    Ok ( String.join ", " items, [], [] )

        OutAggs aggs ->
            case refList ctx spec.groups [] of

                Err e ->
                    Err e

                Ok groupSqls ->
                    case aggItems
                             ctx
                             groupSqls
                             (not (List.isEmpty spec.groups))
                             spec.outCols
                             aggs
                             []
                             []
                             [] of

                        Err e ->
                            Err e

                        Ok ( items, params, aliases ) ->
                            case uncovered spec.outCols aliases of

                                Just col ->
                                    Err
                                        <| storeErr
                                               ("aggregate: result field \""
                                                   ++ col
                                                   ++ "\" has no Agg")

                                Nothing ->
                                    Ok
                                        ( String.join ", " items
                                        , params
                                        , aliases
                                        )


-- `a.col AS "a__col", …`: every column of one side of a join, under a quoted
-- alias so PostgreSQL keeps its case.
prefixedItems : String -> List ( String, String ) -> List String -> Result Error (List String)
prefixedItems q cols acc =
    case cols of

        [] ->
            Ok (List.reverse acc)

        ( c, _ ) :: rest ->
            let
                qname = q ++ "__" ++ c
            in
                if not (isIdent qname) then
                    Err
                        <| storeErr
                               ("join: the result name \"" ++ qname
                                   ++ "\" is longer than 63 bytes or not an identifier")

                else
                    prefixedItems
                        q
                        rest
                        ((q ++ "." ++ c ++ " AS " ++ quoteAlias qname) :: acc)


-- Each result column, read from the explicit source or the same-named column.
projection : Ctx -> List ( String, String ) -> List ( String, String ) -> Result Error ( List String, List String )
projection ctx outCols pairs =
    case pairsError outCols pairs [] of

        Just msg ->
            Err <| storeErr msg

        Nothing ->
            projectionItems ctx outCols pairs [] []


pairsError : List ( String, String ) -> List ( String, String ) -> List String -> Maybe String
pairsError outCols pairs seen =
    case pairs of

        [] ->
            Nothing

        ( field, _ ) :: rest ->
            let
                rc = resolveCol outCols field
            in
                case lookupKind rc outCols of

                    Nothing ->
                        Just
                            ("selectAs: \"" ++ field
                                ++ "\" is not a field of the result codec — fields are "
                                ++ colNames outCols)

                    Just _ ->
                        if List.member rc seen then
                            Just
                                ("selectAs: \"" ++ field ++ "\" is listed twice")

                        else
                            pairsError outCols rest (rc :: seen)


projectionItems : Ctx -> List ( String, String ) -> List ( String, String ) -> List String -> List String -> Result Error ( List String, List String )
projectionItems ctx outCols pairs items refs =
    case outCols of

        [] ->
            Ok ( List.reverse items, List.reverse refs )

        ( rc, rk ) :: rest ->
            let
                srcName = sourceFor outCols rc pairs
            in
                case refOf ctx srcName of

                    Err e ->
                        Err e

                    Ok ( rSql, _, sk ) ->
                        case fitError rc rk sk of

                            Just msg ->
                                Err <| storeErr ("select: " ++ msg)

                            Nothing ->
                                if isIdent rc then
                                    projectionItems
                                        ctx
                                        rest
                                        pairs
                                        ((rSql ++ " AS " ++ quoteAlias rc)
                                            :: items)
                                        (rSql :: refs)

                                else
                                    Err
                                        <| storeErr
                                               ("select: result field \"" ++ rc
                                                   ++ "\" is not a valid identifier")


sourceFor : List ( String, String ) -> String -> List ( String, String ) -> String
sourceFor outCols rc pairs =
    case pairs of

        [] ->
            rc

        ( field, src ) :: rest ->
            if resolveCol outCols field == rc then
                src

            else
                sourceFor outCols rc rest


-- A source of kind `sk` read into a result field of kind `rk`.
fitError : String -> String -> String -> Maybe String
fitError rc rk sk =
    if kindBase rk /= kindBase sk then
        Just
            ("field \"" ++ rc ++ "\" is " ++ kindBase rk ++ " but its source is "
                ++ kindBase sk)

    else if kindNullable sk && not (kindNullable rk) then
        Just
            ("field \"" ++ rc
                ++ "\" reads a nullable source, so it needs a Maybe type")

    else
        Nothing


-- One alias per result column, every result column covered once.
uncovered : List ( String, String ) -> List ( String, Ref ) -> Maybe String
uncovered outCols aliases =
    case outCols of

        [] ->
            Nothing

        ( rc, _ ) :: rest ->
            if aliasKnown rc aliases then
                uncovered rest aliases

            else
                Just rc


aliasKnown : String -> List ( String, Ref ) -> Bool
aliasKnown rc aliases =
    case aliases of

        [] ->
            False

        ( a, _ ) :: rest ->
            a == rc || aliasKnown rc rest


aggItems : Ctx -> List String -> Bool -> List ( String, String ) -> List Agg -> List String -> List SqlValue -> List ( String, Ref ) -> Result Error ( List String, List SqlValue, List ( String, Ref ) )
aggItems ctx groupSqls grouped outCols aggs items params aliases =
    case aggs of

        [] ->
            Ok ( List.reverse items, params, List.reverse aliases )

        (Agg kind field col cond) :: rest ->
            let
                rc = resolveCol outCols field
            in
                case lookupKind rc outCols of

                    Nothing ->
                        Err
                            <| storeErr
                                   ("aggregate: \"" ++ field
                                       ++ "\" is not a field of the result codec — fields are "
                                       ++ colNames outCols)

                    Just rk ->
                        if aliasKnown rc aliases then
                            Err
                                <| storeErr
                                       ("aggregate: result field \"" ++ rc
                                           ++ "\" has two Aggs")

                        else if not (isIdent rc) then
                            Err
                                <| storeErr
                                       ("aggregate: result field \"" ++ rc
                                           ++ "\" is not a valid identifier")

                        else
                            case aggExpr
                                     ctx
                                     groupSqls
                                     grouped
                                     kind
                                     rc
                                     rk
                                     col
                                     cond of

                                Err e ->
                                    Err e

                                Ok ( expr, exprParams ) ->
                                    aggItems
                                        ctx
                                        groupSqls
                                        grouped
                                        outCols
                                        rest
                                        ((expr ++ " AS " ++ quoteAlias rc)
                                            :: items)
                                        (params ++ exprParams)
                                        (( rc, ( expr, exprParams, rk ) )
                                            :: aliases)


aggExpr : Ctx -> List String -> Bool -> String -> String -> String -> String -> Cond -> Result Error ( String, List SqlValue )
aggExpr ctx groupSqls grouped kind rc rk col cond =
    if kind == "count" then
        intResult rc rk "COUNT(*)" noParams

    else if kind == "countIf" then
        case renderCond ctx cond of

            Err e ->
                Err e

            Ok ( cSql, cParams ) ->
                intResult
                    rc
                    rk
                    ("CAST(COALESCE(SUM(CASE WHEN " ++ cSql
                        ++ " THEN 1 ELSE 0 END), 0) AS BIGINT)")
                    cParams

    else
        case refOf ctx col of

            Err e ->
                Err e

            Ok ( rSql, rParams, sk ) ->
                if kind == "countDistinct" then
                    intResult rc rk ("COUNT(DISTINCT " ++ rSql ++ ")") rParams

                else if kind == "sum" then
                    if kindBase sk /= "int" && kindBase sk /= "real" then
                        Err
                            <| storeErr
                                   ("sumAs \"" ++ rc ++ "\": \"" ++ col
                                       ++ "\" is "
                                       ++ kindBase sk
                                       ++ ", not Int or Float")

                    else if kindBase rk /= kindBase sk then
                        Err
                            <| storeErr
                                   ("sumAs: field \"" ++ rc ++ "\" is "
                                       ++ kindBase rk
                                       ++ " but its source is "
                                       ++ kindBase sk)

                    else
                        Ok
                            ( "CAST(COALESCE(SUM(" ++ rSql ++ "), 0) AS "
                                  ++ (if kindBase sk == "int" then
                                         "BIGINT"

                                     else
                                         "DOUBLE PRECISION")
                                  ++ ")"
                            , rParams
                            )

                else if kind == "key" then
                    if List.member rSql groupSqls then
                        fitted rc rk sk rSql rParams

                    else
                        Err
                            <| storeErr
                                   ("key \"" ++ col
                                       ++ "\": the column is not in groupBy")

                else if kindBase sk == "bool" then
                    Err
                        <| storeErr
                               (kind ++ "As \"" ++ rc
                                   ++ "\": min and max of a Bool column are not portable (PostgreSQL has no max(boolean))")

                else if not grouped && not (kindNullable rk) then
                    Err
                        <| storeErr
                               (kind ++ "As: field \"" ++ rc
                                   ++ "\" needs a Maybe type without groupBy (an empty table gives NULL)")

                else if kind == "min" then
                    fitted rc rk sk ("MIN(" ++ rSql ++ ")") rParams

                else
                    fitted rc rk sk ("MAX(" ++ rSql ++ ")") rParams


intResult : String -> String -> String -> List SqlValue -> Result Error ( String, List SqlValue )
intResult rc rk sql params =
    if kindBase rk == "int" then
        Ok ( sql, params )

    else
        Err
            <| storeErr
                   ("aggregate: a count goes into an Int field, and \"" ++ rc
                       ++ "\" is "
                       ++ kindBase rk)


fitted : String -> String -> String -> String -> List SqlValue -> Result Error ( String, List SqlValue )
fitted rc rk sk sql params =
    case fitError rc rk sk of

        Just msg ->
            Err <| storeErr ("aggregate: " ++ msg)

        Nothing ->
            Ok ( sql, params )


-- ── WHERE, GROUP BY, HAVING, ORDER BY, LIMIT ─────────────────────────────────
whereClause : Ctx -> List Cond -> Result Error ( String, List SqlValue )
whereClause ctx conds =
    case conds of

        [] ->
            Ok ( "", [] )

        _ ->
            case renderCond ctx (CondAnd (List.reverse conds)) of

                Err e ->
                    Err e

                Ok ( sql, params ) ->
                    Ok ( " WHERE " ++ sql, params )


-- GROUP BY + HAVING + ORDER BY + LIMIT/OFFSET, after the WHERE.
clauseTail : Ctx -> QuerySpec -> List ( String, Ref ) -> Result Error ( String, List SqlValue )
clauseTail ctx spec aliases =
    case refList ctx spec.groups [] of

        Err e ->
            Err e

        Ok groupSqls ->
            case havingClause ctx spec.outCols aliases spec.having of

                Err e ->
                    Err e

                Ok ( havingSql, havingParams ) ->
                    case orderClause ctx spec of

                        Err e ->
                            Err e

                        Ok orderSql ->
                            case pageClause ctx.dialect spec.limitN spec.offsetN of

                                Err e ->
                                    Err e

                                Ok pageSql ->
                                    Ok
                                        ( groupClause groupSqls ++ havingSql
                                              ++ orderSql
                                              ++ pageSql
                                        , havingParams
                                        )


latestCheck : Ctx -> QuerySpec -> Result Error String
latestCheck ctx spec =
    case spec.latest of

        Nothing ->
            Ok ""

        Just ( keys, newestBy ) ->
            latestRendered ctx spec.source.pk keys newestBy


groupClause : List String -> String
groupClause groupSqls =
    case groupSqls of

        [] ->
            ""

        _ ->
            " GROUP BY " ++ String.join ", " groupSqls


havingClause : Ctx -> List ( String, String ) -> List ( String, Ref ) -> List Cond -> Result Error ( String, List SqlValue )
havingClause ctx outCols aliases conds =
    case conds of

        [] ->
            Ok ( "", [] )

        _ ->
            case renderCond
                     { ctx | cols = outCols, aliases = aliases, having = True }
                     (CondAnd (List.reverse conds)) of

                Err e ->
                    Err e

                Ok ( sql, params ) ->
                    Ok ( " HAVING " ++ sql, params )


orderClause : Ctx -> QuerySpec -> Result Error String
orderClause ctx spec =
    case spec.orders of

        [] ->
            Ok ""

        _ ->
            -- `orderAsc`/`orderDesc` PREPEND each term, so `orders` is in reverse
            -- call order. Reverse it so the FIRST call is the primary sort key:
            -- `q |> orderAsc "sort_order" |> orderAsc "id"` renders
            -- `ORDER BY sort_order ASC, id ASC`.
            case orderTerms ctx spec (List.reverse spec.orders) [] of

                Err e ->
                    Err e

                Ok terms ->
                    Ok (" ORDER BY " ++ String.join ", " terms)


orderTerms : Ctx -> QuerySpec -> List OrderTerm -> List String -> Result Error (List String)
orderTerms ctx spec orders acc =
    case orders of

        [] ->
            Ok (List.reverse acc)

        t :: rest ->
            case orderTerm { ctx | side = t.side } spec t.col t.dir of

                Err e ->
                    Err e

                Ok term ->
                    orderTerms ctx spec rest (term :: acc)


orderTerm : Ctx -> QuerySpec -> String -> String -> Result Error String
orderTerm ctx spec col dir =
    if ctx.side /= "" && not ctx.joined then
        Err <| storeErr (sideVerb ctx.side ++ " needs a join query")

    else if isAggregate spec.out then
        -- After aggregate, an order term names a result field.
        let
            rc = resolveCol spec.outCols col
        in
            case lookupKind rc spec.outCols of

                Nothing ->
                    Err
                        <| storeErr
                               ("order: \"" ++ col
                                   ++ "\" is not a field of the aggregate result — fields are "
                                   ++ colNames spec.outCols)

                Just rk ->
                    Ok (quoteAlias rc ++ " " ++ dir ++ nullsClause rk dir)

    else
        case refOf ctx col of

            Err e ->
                Err e

            Ok ( rSql, _, k ) ->
                if spec.distinct && not (List.member rSql (projectedRefs ctx spec)) then
                    Err
                        <| storeErr
                               ("order: with distinct, \"" ++ col
                                   ++ "\" must be a selected column")

                else
                    Ok (rSql ++ " " ++ dir ++ nullsClause k dir)


projectedRefs : Ctx -> QuerySpec -> List String
projectedRefs ctx spec =
    case spec.out of

        OutCols pairs ->
            case projection ctx spec.outCols pairs of

                Ok ( _, refs ) ->
                    refs

                Err _ ->
                    []

        _ ->
            if spec.joined then
                qualifiedNames "a" spec.source.cols
                    ++ qualifiedNames "b" spec.right.cols

            else
                colNamesList spec.source.cols


qualifiedNames : String -> List ( String, String ) -> List String
qualifiedNames q cols =
    case cols of

        [] ->
            []

        ( c, _ ) :: rest ->
            (q ++ "." ++ c) :: qualifiedNames q rest


-- NULLs sort first ascending and last descending on both dialects (SQLite's
-- own default, made explicit for PostgreSQL). Only on a nullable column, so a
-- query on required columns keeps its text.
nullsClause : String -> String -> String
nullsClause k dir =
    if kindNullable k then
        if dir == "ASC" then
            " NULLS FIRST"

        else
            " NULLS LAST"

    else
        ""


pageClause : Dialect -> Maybe Int -> Maybe Int -> Result Error String
pageClause d limitN offsetN =
    case ( limitN, offsetN ) of

        ( Just l, _ ) ->
            if l < 0 then
                Err <| storeErr ("limit " ++ String.fromInt l ++ " is negative")

            else
                case offsetN of

                    Just o ->
                        if o < 0 then
                            Err
                                <| storeErr
                                       ("offset " ++ String.fromInt o
                                           ++ " is negative")

                        else
                            Ok
                                (" LIMIT " ++ String.fromInt l ++ " OFFSET "
                                    ++ String.fromInt o)

                    Nothing ->
                        Ok (" LIMIT " ++ String.fromInt l)

        ( Nothing, Just o ) ->
            if o < 0 then
                Err
                    <| storeErr
                           ("offset " ++ String.fromInt o ++ " is negative")

            else
                case d of

                    Sqlite ->
                        -- SQLite accepts OFFSET only after a LIMIT; -1 is "no limit".
                        Ok (" LIMIT -1 OFFSET " ++ String.fromInt o)

                    Postgres ->
                        Ok (" OFFSET " ++ String.fromInt o)

        ( Nothing, Nothing ) ->
            Ok ""

-- ── Conditions: one walk resolves, checks and renders ────────────────────────
-- A resolved reference: SQL text, its params, and its colspec kind.
type alias Ref =
    ( String, List SqlValue, String )

-- `cols` is the store (the left store of a join), `right` the right store.
-- `qual` qualifies a column in SQL: "" at the top level, "a" in a join,
-- "sqN" in the subquery at depth N. `side` restricts a name to one side of a
-- join ("left" / "right", from `whereLeft` / `whereRight` / `orderLeft*` /
-- `orderRight*`). `table` names the top-level table for a correlated
-- subquery's outer column.
type alias Ctx =
    { dialect : Dialect
    , cols : List ( String, String )
    , aliases : List ( String, Ref )
    , having : Bool
    , table : String
    , qual : String
    , right : List ( String, String )
    , joined : Bool
    , rightNull : Bool
    , side : String
    , depth : Int
    }


plainCtx : Dialect -> String -> List ( String, String ) -> Ctx
plainCtx d table cols =
    { dialect = d
    , cols = cols
    , aliases = []
    , having = False
    , table = table
    , qual = ""
    , right = []
    , joined = False
    , rightNull = False
    , side = ""
    , depth = 0
    }


specCtx : Dialect -> Int -> String -> QuerySpec -> Ctx
specCtx d depth qual spec =
    let
        base = plainCtx d spec.source.table spec.source.cols
    in
        if spec.joined then
            { base
                | qual = "a"
                , right = spec.right.cols
                , joined = True
                , rightNull = spec.leftOuter
                , depth = depth
            }

        else
            { base | qual = qual, depth = depth }


renderCond : Ctx -> Cond -> Result Error ( String, List SqlValue )
renderCond ctx c =
    case c of

        CondOp col op v ->
            case refOf ctx col of

                Err e ->
                    Err e

                Ok ( rSql, rParams, _ ) ->
                    if isJsonRef col && not (isSqlString v) then
                        Err
                            <| storeErr
                                   ("a value compared with jsonText \"" ++ col
                                       ++ "\" must be SqlString")

                    else
                        Ok ( rSql ++ " " ++ op ++ " ?", rParams ++ [ v ] )

        CondNull col wantNull ->
            case refOf ctx col of

                Err e ->
                    Err e

                Ok ( rSql, rParams, _ ) ->
                    if wantNull then
                        Ok ( rSql ++ " IS NULL", rParams )

                    else
                        Ok ( rSql ++ " IS NOT NULL", rParams )

        CondIn col vs ->
            case refOf ctx col of

                Err e ->
                    Err e

                Ok ( rSql, rParams, _ ) ->
                    case vs of

                        [] ->
                            Ok ( "1 = 0", [] )

                        _ ->
                            if isJsonRef col && not (allSqlString vs) then
                                Err
                                    <| storeErr
                                           ("values compared with jsonText \""
                                               ++ col
                                               ++ "\" must be SqlString")

                            else
                                Ok
                                    ( rSql ++ " IN (" ++ placeholders vs ++ ")"
                                    , rParams ++ vs
                                    )

        CondAnd cs ->
            renderGroup ctx "1 = 1" " AND " cs

        CondOr cs ->
            renderGroup ctx "1 = 0" " OR " cs

        CondNot inner ->
            case renderCond ctx inner of

                Err e ->
                    Err e

                Ok ( s, p ) ->
                    Ok ( "NOT (" ++ s ++ ")", p )

        CondCol op left right ->
            case refOf ctx left of

                Err e ->
                    Err e

                Ok ( lSql, lParams, lk ) ->
                    case refOf ctx right of

                        Err e ->
                            Err e

                        Ok ( rSql, rParams, rk ) ->
                            if kindBase lk /= kindBase rk then
                                Err
                                    <| storeErr
                                           ("\"" ++ left ++ "\" is "
                                               ++ kindBase lk
                                               ++ " and \""
                                               ++ right
                                               ++ "\" is "
                                               ++ kindBase rk
                                               ++ ": compare columns of one kind")

                            else
                                Ok
                                    ( lSql ++ " " ++ op ++ " " ++ rSql
                                    , lParams ++ rParams
                                    )

        CondText kind col needle ->
            case refOf ctx col of

                Err e ->
                    Err e

                Ok ( rSql, rParams, k ) ->
                    if kindBase k /= "text" then
                        Err
                            <| storeErr
                                   (kind ++ " \"" ++ col ++ "\": the column is "
                                       ++ kindBase k
                                       ++ ", and only text has a case")

                    else
                        Ok (textMatch ctx.dialect kind rSql rParams needle)

        CondNest n ->
            if ctx.having then
                Err
                    <| storeErr
                           "having: whereLeft, whereRight, inQuery and exists do not apply"

            else if n.kind == "side" then
                if not ctx.joined then
                    Err <| storeErr (sideVerb n.side ++ " needs a join query")

                else
                    renderCond { ctx | side = n.side } n.inner

            else if n.kind == "in" then
                inSql ctx n.col n.negated n.subCol n.sub

            else
                existsSql ctx n.negated n.source n.pairs n.inner


-- `col [NOT] IN (SELECT …)`, the two columns of one kind.
inSql : Ctx -> String -> Bool -> String -> QuerySpec -> Result Error ( String, List SqlValue )
inSql ctx col negated subCol sub =
    case refOf ctx col of

        Err e ->
            Err e

        Ok ( oSql, oParams, ok ) ->
            case subSelect ctx subCol sub of

                Err e ->
                    Err e

                Ok ( sSql, sParams, ik ) ->
                    if kindBase ok /= kindBase ik then
                        Err
                            <| storeErr
                                   ("inQuery \"" ++ col ++ "\" is "
                                       ++ kindBase ok
                                       ++ " but the subquery column is "
                                       ++ kindBase ik)

                    else
                        Ok
                            ( oSql
                                  ++ (if negated then
                                         " NOT IN ("

                                     else
                                         " IN (")
                                  ++ sSql
                                  ++ ")"
                            , oParams ++ sParams
                            )


-- `SELECT sqN.col FROM t sqN WHERE (…) AND sqN.col IS NOT NULL …`, checked
-- against the inner store's codec. Returns the text, params and column kind.
subSelect : Ctx -> String -> QuerySpec -> Result Error ( String, List SqlValue, String )
subSelect ctx col spec =
    let
        depth = ctx.depth + 1
        qname = "sq" ++ String.fromInt depth
        src = spec.source
        ictx = specCtx ctx.dialect depth qname spec
    in
        case storeError src.table src.pk src.cols src.problems of

            Just e ->
                Err e

            Nothing ->
                case subShapeError spec of

                    Just msg ->
                        Err <| storeErr ("column \"" ++ col ++ "\": " ++ msg)

                    Nothing ->
                        case refOf ictx col of

                            Err e ->
                                Err e

                            Ok ( cSql, cParams, k ) ->
                                case whereClause ictx spec.conds of

                                    Err e ->
                                        Err e

                                    Ok ( whereSql, whereParams ) ->
                                        case orderClause ictx spec of

                                            Err e ->
                                                Err e

                                            Ok orderSql ->
                                                case pageClause
                                                         ctx.dialect
                                                         spec.limitN
                                                         spec.offsetN of

                                                    Err e ->
                                                        Err e

                                                    Ok pageSql ->
                                                        Ok
                                                            ( "SELECT " ++ cSql
                                                                  ++ " FROM "
                                                                  ++ src.table
                                                                  ++ " "
                                                                  ++ qname
                                                                  ++ (if whereSql
                                                                         == "" then
                                                                         " WHERE "

                                                                     else
                                                                         whereSql
                                                                             ++ " AND ")
                                                                  ++ cSql
                                                                  ++ " IS NOT NULL"
                                                                  ++ orderSql
                                                                  ++ pageSql
                                                            , cParams
                                                                  ++ whereParams
                                                                  ++ cParams
                                                            , k
                                                            )


-- What a subquery may hold: one store, `where_`, order and paging.
subShapeError : QuerySpec -> Maybe String
subShapeError spec =
    if spec.joined then
        Just "a subquery reads one store, not a join"

    else if not (isPlain spec) then
        Just
            "a subquery takes where_, orderAsc / orderDesc, limit and offset only (no select, aggregate, groupBy, distinct or latestPer)"

    else if (isSetInt spec.limitN || isSetInt spec.offsetN) && List.isEmpty spec.orders then
        Just
            "limit or offset in a subquery needs orderAsc / orderDesc, else the rows it keeps are not defined"

    else
        Nothing


-- `[NOT] EXISTS (SELECT 1 FROM t sqN WHERE sqN.x = outer.y AND (cond))`.
existsSql : Ctx -> Bool -> Source -> List ( String, String ) -> Cond -> Result Error ( String, List SqlValue )
existsSql ctx negated src pairs inner =
    let
        depth = ctx.depth + 1
        qname = "sq" ++ String.fromInt depth
        base = plainCtx ctx.dialect src.table src.cols
        ictx = { base | qual = qname, depth = depth }
        octx =
            if ctx.qual == "" && not ctx.joined then
                { ctx | qual = ctx.table }

            else
                ctx
    in
        case storeError src.table src.pk src.cols src.problems of

            Just e ->
                Err e

            Nothing ->
                case correlations ictx octx pairs [] of

                    Err e ->
                        Err e

                    Ok corrSql ->
                        case renderCond ictx inner of

                            Err e ->
                                Err e

                            Ok ( cSql, cParams ) ->
                                Ok
                                    ( (if negated then
                                          "NOT EXISTS (SELECT 1 FROM "

                                      else
                                          "EXISTS (SELECT 1 FROM ")
                                          ++ src.table
                                          ++ " "
                                          ++ qname
                                          ++ " WHERE "
                                          ++ corrSql
                                          ++ " AND ("
                                          ++ cSql
                                          ++ "))"
                                    , cParams
                                    )


-- `inner = outer AND …`: the inner column on the exists store, the outer
-- column on the query (or the written store), kinds equal.
correlations : Ctx -> Ctx -> List ( String, String ) -> List String -> Result Error String
correlations ictx octx pairs acc =
    case pairs of

        [] ->
            case acc of

                [] ->
                    Err <| storeErr "exists needs at least one correlate pair"

                _ ->
                    Ok (String.join " AND " (List.reverse acc))

        ( ic, oc ) :: rest ->
            case colRef ictx ic of

                Err e ->
                    Err e

                Ok ( iSql, ik ) ->
                    case colRef octx oc of

                        Err e ->
                            Err e

                        Ok ( oSql, ok ) ->
                            if kindBase ik /= kindBase ok then
                                Err
                                    <| storeErr
                                           ("correlate \"" ++ ic ++ "\" is "
                                               ++ kindBase ik
                                               ++ " and \""
                                               ++ oc
                                               ++ "\" is "
                                               ++ kindBase ok
                                               ++ ": correlate columns of one kind")

                            else
                                correlations
                                    ictx
                                    octx
                                    rest
                                    ((iSql ++ " = " ++ oSql) :: acc)


sideVerb : String -> String
sideVerb side =
    if side == "left" then
        "whereLeft / orderLeftAsc / orderLeftDesc"

    else
        "whereRight / orderRightAsc / orderRightDesc"


-- The text conditions. `%`, `_` and `!` in a needle are escaped with `!`
-- where LIKE is used. SQLite's LIKE ignores ASCII case, so its case-sensitive
-- forms use instr / substr instead.
textMatch : Dialect -> String -> String -> List SqlValue -> String -> ( String, List SqlValue )
textMatch d kind rSql rParams needle =
    if kind == "eqCi" then
        ( "LOWER(" ++ rSql ++ ") = LOWER(?)", rParams ++ [ SqlString needle ] )

    else if needle == "" then
        ( rSql ++ " IS NOT NULL", rParams )

    else if kind == "containsCi" then
        ( "LOWER(" ++ rSql ++ ") LIKE LOWER(?) ESCAPE '!'"
        , rParams ++ [ SqlString ("%" ++ likeEscape needle ++ "%") ]
        )

    else
        case d of

            Postgres ->
                if kind == "contains" then
                    ( rSql ++ " LIKE ? ESCAPE '!'"
                    , rParams ++ [ SqlString ("%" ++ likeEscape needle ++ "%") ]
                    )

                else if kind == "startsWith" then
                    ( rSql ++ " LIKE ? ESCAPE '!'"
                    , rParams ++ [ SqlString (likeEscape needle ++ "%") ]
                    )

                else
                    ( rSql ++ " LIKE ? ESCAPE '!'"
                    , rParams ++ [ SqlString ("%" ++ likeEscape needle) ]
                    )

            Sqlite ->
                if kind == "contains" then
                    ( "instr(" ++ rSql ++ ", ?) > 0"
                    , rParams ++ [ SqlString needle ]
                    )

                else if kind == "startsWith" then
                    ( "substr(" ++ rSql ++ ", 1, length(?)) = ?"
                    , rParams ++ [ SqlString needle, SqlString needle ]
                    )

                else
                    ( "substr(" ++ rSql ++ ", -length(?)) = ?"
                    , rParams ++ [ SqlString needle, SqlString needle ]
                    )


likeEscape : String -> String
likeEscape s =
    String.replace
        "_"
        "!_"
        (String.replace "%" "!%" (String.replace "!" "!!" s))


renderGroup : Ctx -> String -> String -> List Cond -> Result Error ( String, List SqlValue )
renderGroup ctx emptySql sep cs =
    case cs of

        [] ->
            Ok ( emptySql, [] )

        _ ->
            case renderConds ctx cs [] [] of

                Err e ->
                    Err e

                Ok ( parts, params ) ->
                    Ok ( "(" ++ String.join sep parts ++ ")", params )


renderConds : Ctx -> List Cond -> List String -> List SqlValue -> Result Error ( List String, List SqlValue )
renderConds ctx cs parts params =
    case cs of

        [] ->
            Ok ( List.reverse parts, params )

        c :: rest ->
            case renderCond ctx c of

                Err e ->
                    Err e

                Ok ( s, p ) ->
                    renderConds ctx rest (s :: parts) (params ++ p)


placeholders : List SqlValue -> String
placeholders vs =
    case vs of

        [] ->
            ""

        [ _ ] ->
            "?"

        _ :: rest ->
            "?, " ++ placeholders rest


isSqlString : SqlValue -> Bool
isSqlString v =
    case v of

        SqlString _ ->
            True

        _ ->
            False


allSqlString : List SqlValue -> Bool
allSqlString vs =
    case vs of

        [] ->
            True

        v :: rest ->
            isSqlString v && allSqlString rest


isJsonRef : String -> Bool
isJsonRef name =
    String.contains "->>" name


-- Resolve a name to SQL: a store column (field or snake name), a `jsonText`
-- reference, or (in HAVING) an aggregate result field.
refOf : Ctx -> String -> Result Error Ref
refOf ctx name =
    if ctx.having then
        let
            rc = resolveCol ctx.cols name
        in
            case aliasRef rc ctx.aliases of

                Just r ->
                    Ok r

                Nothing ->
                    Err
                        <| storeErr
                               ("having: \"" ++ name
                                   ++ "\" is not a field of the aggregate result — fields are "
                                   ++ colNames ctx.cols)

    else
        case String.split "->>" name of

            [ col, jsonKey ] ->
                case colRef ctx col of

                    Err e ->
                        Err e

                    Ok ( cSql, k ) ->
                        jsonRef ctx.dialect col cSql k jsonKey

            _ ->
                case colRef ctx name of

                    Err e ->
                        Err e

                    Ok ( cSql, k ) ->
                        Ok ( cSql, noParams, k )


-- A column name to its SQL and kind. In a join `"a.col"` / `"b.col"` pick a
-- side, `side` restricts a bare name to one side, and a bare name both sides
-- have is an `Err`. A right column of a LEFT join is nullable.
colRef : Ctx -> String -> Result Error ( String, String )
colRef ctx name =
    if not ctx.joined then
        sideCol ctx.qual ctx.cols False name name

    else
        case String.split "." name of

            [ q, bare ] ->
                if q == "a" then
                    sideCol "a" ctx.cols False name bare

                else if q == "b" then
                    sideCol "b" ctx.right ctx.rightNull name bare

                else
                    Err (unknownColErr name (ctx.cols ++ ctx.right))

            _ ->
                if ctx.side == "left" then
                    sideCol "a" ctx.cols False name name

                else if ctx.side == "right" then
                    sideCol "b" ctx.right ctx.rightNull name name

                else
                    let
                        inLeft = hasCol name ctx.cols
                        inRight = hasCol name ctx.right
                    in
                        if inLeft && inRight then
                            Err
                                <| storeErr
                                       ("column \"" ++ name
                                           ++ "\" is in both stores of the join: write \"a."
                                           ++ name
                                           ++ "\" or \"b."
                                           ++ name
                                           ++ "\"")

                        else if inRight then
                            sideCol "b" ctx.right ctx.rightNull name name

                        else if inLeft then
                            sideCol "a" ctx.cols False name name

                        else
                            Err (unknownColErr name (ctx.cols ++ ctx.right))


sideCol : String -> List ( String, String ) -> Bool -> String -> String -> Result Error ( String, String )
sideCol qual cols nullable name bare =
    let
        col = resolveCol cols bare
    in
        case lookupKind col cols of

            Nothing ->
                Err <| unknownColErr name cols

            Just k ->
                if not (isIdent col) then
                    Err
                        <| storeErr
                               ("column \"" ++ col
                                   ++ "\" is not a valid identifier")

                else if nullable && not (kindNullable k) then
                    Ok ( qualified qual col, kindBase k ++ "?" )

                else
                    Ok ( qualified qual col, k )


hasCol : String -> List ( String, String ) -> Bool
hasCol name cols =
    case lookupKind (resolveCol cols name) cols of

        Just _ ->
            True

        Nothing ->
            False


qualified : String -> String -> String
qualified q col =
    if q == "" then
        col

    else
        q ++ "." ++ col


aliasRef : String -> List ( String, Ref ) -> Maybe Ref
aliasRef rc aliases =
    case aliases of

        [] ->
            Nothing

        ( a, r ) :: rest ->
            if a == rc then
                Just r

            else
                aliasRef rc rest


-- A key of a JSON text column, `cSql` being the column's SQL.
jsonRef : Dialect -> String -> String -> String -> String -> Result Error Ref
jsonRef d name cSql k jsonKey =
    if kindBase k /= "text" && kindBase k /= "blob" then
        Err
            <| storeErr
                   ("jsonText \"" ++ name ++ "\": the column is " ++ kindBase k
                       ++ ", not a JSON text column")

    else if not (isIdent jsonKey) then
        Err
            <| storeErr
                   ("jsonText \"" ++ name ++ "\" \"" ++ jsonKey
                       ++ "\": the key is not a valid identifier")

    else
        case d of

            Postgres ->
                Ok
                    ( "(CAST(" ++ cSql ++ " AS jsonb) ->> '" ++ jsonKey ++ "')"
                    , noParams
                    , "text?"
                    )

            Sqlite ->
                -- json_type first, so a JSON boolean reads 'true' / 'false' as
                -- it does through PostgreSQL's ->>.
                let
                    path = "'$." ++ jsonKey ++ "'"
                in
                    Ok
                        ( "(CASE json_type(" ++ cSql ++ ", " ++ path
                              ++ ") WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' ELSE CAST(json_extract("
                              ++ cSql
                              ++ ", "
                              ++ path
                              ++ ") AS TEXT) END)"
                        , noParams
                        , "text?"
                        )


refList : Ctx -> List String -> List String -> Result Error (List String)
refList ctx names acc =
    case names of

        [] ->
            Ok (List.reverse acc)

        n :: rest ->
            case refOf ctx n of

                Err e ->
                    Err e

                Ok ( rSql, _, _ ) ->
                    refList ctx rest (rSql :: acc)


-- ── Writes ───────────────────────────────────────────────────────────────────
writeWhere : Dialect -> String -> String -> List ( String, String ) -> List String -> Cond -> Result Error ( String, List SqlValue )
writeWhere d name pk cols problems cond =
    case storeError name pk cols problems of

        Just e ->
            Err e

        Nothing ->
            renderCond (plainCtx d name cols) cond


-- `UPDATE t SET c = ? …` (or `c = c + ?` for `adjust`) `WHERE …`.
prepareSet : Dialect -> String -> String -> List ( String, String ) -> List String -> Cond -> Bool -> List ( String, SqlValue ) -> Result Error ( String, List SqlValue )
prepareSet d name pk cols problems cond relative sets =
    case writeWhere d name pk cols problems cond of

        Err e ->
            Err e

        Ok ( whereSql, whereParams ) ->
            case setItems cols relative sets [] [] of

                Err e ->
                    Err e

                Ok ( items, setParams ) ->
                    Ok
                        ( "UPDATE " ++ name ++ " SET " ++ String.join ", " items
                              ++ " WHERE "
                              ++ whereSql
                        , setParams ++ whereParams
                        )


setItems : List ( String, String ) -> Bool -> List ( String, SqlValue ) -> List String -> List SqlValue -> Result Error ( List String, List SqlValue )
setItems cols relative sets items params =
    case sets of

        [] ->
            Ok ( List.reverse items, List.reverse params )

        ( field, v ) :: rest ->
            let
                col = resolveCol cols field
            in
                case lookupKind col cols of

                    Nothing ->
                        Err <| unknownColErr field cols

                    Just _ ->
                        if not (isIdent col) then
                            Err
                                <| storeErr
                                       ("column \"" ++ col
                                           ++ "\" is not a valid identifier")

                        else if relative then
                            setItems
                                cols
                                relative
                                rest
                                ((col ++ " = " ++ col ++ " + ?") :: items)
                                (v :: params)

                        else
                            setItems
                                cols
                                relative
                                rest
                                ((col ++ " = ?") :: items)
                                (v :: params)


-- ── Names ────────────────────────────────────────────────────────────────────
-- The store check every verb runs first: the table name follows the identifier
-- rule, the primary key is empty or a column, and no builder recorded a problem.
storeError : String -> String -> List ( String, String ) -> List String -> Maybe Error
storeError name pk cols problems =
    if not (isIdent name) then
        Just
            (Error.invalidInput
                ("Store: invalid table name \"" ++ name
                    ++ "\": use letters, digits and _, not starting with a digit, at most 63 bytes"))

    else if pk /= "" && lookupKind pk cols == Nothing then
        Just
            (Error.invalidInput
                ("Store \"" ++ name ++ "\": primaryKey \"" ++ pk
                    ++ "\" is not a column — columns are "
                    ++ colNames cols))

    else
        case problems of

            p :: _ ->
                Just (Error.invalidInput ("Store \"" ++ name ++ "\": " ++ p))

            [] ->
                Nothing


-- `^[A-Za-z_][A-Za-z0-9_]*$`, at most 63 bytes (PostgreSQL's identifier
-- limit). No reserved-word list: a column named `user` works on SQLite, and a
-- reserved word stays a driver error.
isIdent : String -> Bool
isIdent s =
    case String.toList s of

        [] ->
            False

        c :: rest ->
            String.length s <= 63 && isIdentStart (Char.toCode c)
                && identRest rest


identRest : List Char -> Bool
identRest cs =
    case cs of

        [] ->
            True

        c :: rest ->
            let
                n = Char.toCode c
            in
                (isIdentStart n || (n >= 48 && n <= 57)) && identRest rest


isIdentStart : Int -> Bool
isIdentStart n =
    n == 95 || (n >= 65 && n <= 90) || (n >= 97 && n <= 122)


quoteAlias : String -> String
quoteAlias a =
    "\"" ++ a ++ "\""


-- A typed empty parameter list. A bare `[]` inside a returned tuple lowers
-- with an `any` element and costs a narrowing at the return.
noParams : List SqlValue
noParams =
    []


storeErr : String -> Error
storeErr msg =
    Error.invalidInput ("Store: " ++ msg)


unknownColErr : String -> List ( String, String ) -> Error
unknownColErr name cols =
    (Error.invalidInput
        ("Store: unknown column \"" ++ name ++ "\" — columns are "
            ++ colNames cols))


colNames : List ( String, String ) -> String
colNames cols =
    String.join ", " (colNamesList cols)


colNamesList : List ( String, String ) -> List String
colNamesList cols =
    case cols of

        [] ->
            []

        ( c, _ ) :: rest ->
            c :: colNamesList rest


-- | camelCase → snake_case. Delegates to the SAME runtime routine that derives
-- `Codec.auto` columns, so a filter written with the RECORD FIELD name
-- (`"priceMinor"`) resolves to exactly its snake column (`"price_minor"`).
snakeName : String -> String
snakeName =
    Ffi.kernel "Db_snakeName"


lookupKind : String -> List ( String, String ) -> Maybe String
lookupKind col cols =
    case cols of

        [] ->
            Nothing

        ( c, k ) :: rest ->
            if c == col then
                Just k

            else
                lookupKind col rest


-- | Resolve a name to a store column: use it verbatim when it IS a column,
-- else fall back to its snake_case form (so `"priceMinor"` finds `"price_minor"`),
-- else return it unchanged so the check reports it as unknown.
resolveCol : List ( String, String ) -> String -> String
resolveCol known col =
    case lookupKind col known of

        Just _ ->
            col

        Nothing ->
            let
                snake = snakeName col
            in
                case lookupKind snake known of

                    Just _ ->
                        snake

                    Nothing ->
                        col


-- Rule D1 for a required column whose zero is not the zero of its kind: give
-- it the `zero=` flag, from its OWN field's zero (`Codec.fieldZeros`), never
-- from the zero of the whole record, so a sibling field with no zero does not
-- take the zero away. A JSON (blob) column's flag is the JSON of the field's
-- zero (the blank record's field under `auto`, the field codec's zero under
-- `object`). An enum column (a `Codec.enum` field, or a nullary custom type
-- under `auto`) is TEXT, and the text zero `''` is not one of its names, so
-- its flag is the enum's zero name (the first name of a `Codec.enum`, the
-- witness's name under `auto`). A plain String column gets no flag: its zero
-- stays `''`. `migrate` and `toTable` (so `pushProject` and the
-- `sky db migrate --gen` schema dump) add the flag; the runtime's
-- renderAddColumn makes it the DEFAULT of the column added to a table with
-- rows. A column whose field has no zero gets no flag: a blob is then added
-- NOT NULL with no default, which a table with rows refuses.
withZeros : Codec a -> List ( String, String ) -> List ( String, String )
withZeros codec cols =
    let
        zeros = Codec.fieldZeros codec
    in
        List.map (\( c, k ) -> ( c, k ++ zeroFlag codec zeros c k )) cols


-- The `|zero=` flag of one column (see `withZeros`), or "".
zeroFlag : Codec a -> List ( String, Value ) -> String -> String -> String
zeroFlag codec zeros col kind =
    if kindNullable kind then
        ""

    else
        case ( kindBase kind, lookupZero col zeros ) of

            ( "blob", Just v ) ->
                "|zero=" ++ flagValue (JE.encode 0 v)

            ( "text", Just v ) ->
                case JD.decodeValue JD.string v of

                    Ok name ->
                        if isEnumColumn codec col then
                            "|zero=" ++ flagValue name

                        else
                            ""

                    Err _ ->
                        ""

            _ ->
                ""


-- The zero of column `col` in a `Codec.fieldZeros` list.
lookupZero : String -> List ( String, Value ) -> Maybe Value
lookupZero col zeros =
    case zeros of

        [] ->
            Nothing

        ( c, v ) :: rest ->
            if c == col then
                Just v

            else
                lookupZero col rest


-- True when the codec's JSON Schema gives column `col` a list of names: a
-- `Codec.enum` field, or a nullary custom type under `Codec.auto`.
isEnumColumn : Codec a -> String -> Bool
isEnumColumn codec col =
    let
        js = Codec.jsonSchema codec
        names = JD.at [ "properties", col, "enum" ] (JD.list JD.string)
    in
        case JD.decodeValue names js.schema of

            Ok _ ->
                True

            Err _ ->
                False


-- The base kind of a colspec kind: no `|` flags, no `!`, no `?`.
kindBase : String -> String
kindBase k =
    String.replace "?" "" (String.replace "!" "" (beforeFlags k))


kindNullable : String -> Bool
kindNullable k =
    String.contains "?" (beforeFlags k)


beforeFlags : String -> String
beforeFlags k =
    case String.split "|" k of

        b :: _ ->
            b

        [] ->
            k


-- ── Internal ─────────────────────────────────────────────────────────────────
-- | Drop the named columns from a (col, kind) spec (insert/update omit-lists).
colsExcluding : List String -> List ( String, String ) -> List ( String, String )
colsExcluding excl cols =
    case cols of

        [] ->
            []

        ( c, k ) :: rest ->
            if List.member c excl then
                colsExcluding excl rest

            else
                ( c, k ) :: colsExcluding excl rest


-- | The INSERT colspec: every column that is not `generated`, plus the `dnow`
-- columns (`defaultNow` / `touchOnUpdate`). The runtime binds the app clock to
-- a `dnow` column on SQLite and leaves it out on PostgreSQL.
insertCols : List String -> List ( String, String ) -> List ( String, String )
insertCols gen cols =
    colsExcluding gen cols ++ nowColsOf cols


nowColsOf : List ( String, String ) -> List ( String, String )
nowColsOf cols =
    case cols of

        [] ->
            []

        ( c, k ) :: rest ->
            if hasFlag "dnow" k then
                ( c, k ) :: nowColsOf rest

            else
                nowColsOf rest


-- Whether a colspec kind carries the `|`-delimited flag, compared exactly. A
-- default value cannot hold a literal `|` (flagValue encodes it), so the flag
-- is `|flag` at the end or `|flag|` inside.
hasFlag : String -> String -> Bool
hasFlag flag k =
    String.endsWith ("|" ++ flag) k || String.contains ("|" ++ flag ++ "|") k


-- | Columns carrying the `touch` flag (Store.touchOnUpdate) — set to `now()` on
-- every UPDATE by the runtime's codecSetClause. The flag is matched exactly: a
-- default value that contains the text "touch" is not the flag.
touchColsOf : List ( String, String ) -> List ( String, String )
touchColsOf cols =
    case cols of

        [] ->
            []

        ( c, k ) :: rest ->
            if hasFlag "touch" k then
                ( c, k ) :: touchColsOf rest

            else
                touchColsOf rest


-- | The SET column-spec for an update: every writable column (PK + `generated`
-- excluded) PLUS the `touch` columns re-added (they live in `generated` so INSERT
-- omits them, but UPDATE bumps them to `now()`).
setColspecOf : String -> List String -> List ( String, String ) -> List ( String, String )
setColspecOf pk gen cols =
    colsExcluding (pk :: gen) cols ++ touchColsOf cols


-- | The declared kind of a column (defaults to "text" when absent).
kindOf : String -> List ( String, String ) -> String
kindOf col cols =
    case lookupKind col cols of

        Just k ->
            k

        Nothing ->
            "text"


dbUpdateByPk : Db -> String -> List ( String, String ) -> String -> String -> Value -> Task Error Int
dbUpdateByPk =
    Ffi.kernel "Db_updateByPk"


dbUpdateWhere : Db -> String -> List ( String, String ) -> Value -> String -> List SqlValue -> Task Error Int
dbUpdateWhere =
    Ffi.kernel "Db_updateWhere"


codecColumns : Codec a -> List ( String, String )
codecColumns codec =
    case Codec.shape codec of

        SRecord cols ->
            colTypeStrs cols

        _ ->
            []


colTypeStrs : List ( String, ColType ) -> List ( String, String )
colTypeStrs cols =
    case cols of

        [] ->
            []

        ( n, ct ) :: rest ->
            ( n, colTypeStr ct ) :: colTypeStrs rest


colTypeStr : ColType -> String
colTypeStr ct =
    case ct of

        CText ->
            "text"

        CInt ->
            "int"

        CReal ->
            "real"

        CBool ->
            "bool"

        CBlob ->
            "blob"

        CNull inner ->
            colTypeStr inner ++ "?"


dbCreateCols : Db -> String -> List ( String, String ) -> String -> List IndexSpec -> Task Error ()
dbCreateCols =
    Ffi.kernel "Db_createCols"


dbAutoMigrate : Db -> String -> List ( String, String ) -> String -> List IndexSpec -> Task Error (List String)
dbAutoMigrate =
    Ffi.kernel "Db_autoMigrate"


dbExecObjectMany : Db -> String -> List ( String, String ) -> List Value -> Task Error Int
dbExecObjectMany =
    Ffi.kernel "Db_execObjectMany"


dbUpsertObject : Db -> String -> List ( String, String ) -> String -> Value -> String -> Task Error Int
dbUpsertObject =
    Ffi.kernel "Db_upsertObject"


dbExecObjectWith : Db -> String -> List ( String, String ) -> Value -> List ( String, SqlValue ) -> String -> String -> Task Error Int
dbExecObjectWith =
    Ffi.kernel "Db_execObjectWith"


dbQueryObjectGroups : Db -> String -> List SqlValue -> List ( String, String, List ( String, String ) ) -> Task Error (List (List String))
dbQueryObjectGroups =
    Ffi.kernel "Db_queryObjectGroups"


dbExecV : Db -> String -> List SqlValue -> Task Error Int
dbExecV =
    Ffi.kernel "Db_exec"


dbDialect : Db -> String
dbDialect =
    Ffi.kernel "Db_dialect"


dbObjectSqlValues : List ( String, String ) -> Value -> List SqlValue
dbObjectSqlValues =
    Ffi.kernel "Db_objectSqlValues"


dbWriteReturningObjects : Db -> String -> List SqlValue -> List ( String, String, List ( String, String ) ) -> Task Error (List (List String))
dbWriteReturningObjects =
    Ffi.kernel "Db_writeReturningObjects"
