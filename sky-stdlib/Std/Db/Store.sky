-- | Std.Db.Store — codec-driven persistence (Layer 3 Sky source).
--
-- A `Store a` is a table defined by ONE `Codec a` (Std.Codec): the codec drives
-- the schema (columns from its shape), the writes (record → columns), and the
-- reads (columns → record) — and the SAME codec serves JSON. No separate
-- decoder, no `SqlValue` lists.
--
-- Top-level scalar fields become typed columns; anything the codec marks as a
-- blob (ADT / tuple / list / nested record) is stored as a JSON TEXT column.
--
-- ```elm
-- import Std.Codec as Codec exposing (Codec)
-- import Std.Db.Store as Store exposing (Store)
--
-- userCodec : Codec User
-- userCodec = Codec.object User |> Codec.field "id" .id Codec.string |> ... |> Codec.buildObject
--
-- users : Store User
-- users = Store.fromCodec "users" userCodec |> Store.primaryKey "id"
--
-- -- Store.create conn users
-- -- Store.insert conn users user      : Task Error Int
-- -- Store.all conn users              : Task Error (List User)
-- -- Store.findBy conn users "id" "u1" : Task Error (Maybe User)
-- ```
--
-- Reads beyond one table's rows have builders too: `groupBy` + `aggregate`
-- (+ `having`) for grouped counts and sums, `select` / `selectColumn` /
-- `distinct` for a projection, `latestPer` for the newest row per key,
-- `contains` / `startsWith` / `endsWith` / `eqCi` / `containsCi` for text,
-- `eqCol` and friends to compare two columns, and `jsonText` to read a key
-- inside a JSON text column. `toSql` shows the SQL a query renders.
--
-- Every verb checks the store before any statement: the table name and every
-- column name follow `[A-Za-z_][A-Za-z0-9_]*` (at most 63 bytes), the primary
-- key is empty or a codec column, and a builder that named an unknown column
-- makes the first verb fail with that name. Values always bind as parameters.
module Std.Db.Store exposing
    ( Store
    , fromCodec
    , primaryKey
    , serial
    , unique
    , defaultNow
    , touchOnUpdate
    , defaultText
    , defaultInt
    , defaultBool
    , defaultWith
    , generated
    , create
    , migrate
    , insert
    , insertMany
    , upsert
    , update
    , updateWhere
    , updateFields
    , setFields
    , adjust
    , all
    , findBy
    , selectRaw
    , delete
    , deleteWhere
    , Table
    , toTable
    , Project
    , project
    , dumpSchema
    , pushProject
    , projectTableCount
    , resetProject
    , dropProject
    , resetTable
    , dropTable
    , Query
    , query
    , Cond
    , where_
    , eq
    , neq
    , gt
    , gte
    , lt
    , lte
    , like
    , eqCi
    , contains
    , containsCi
    , startsWith
    , endsWith
    , eqCol
    , neqCol
    , gtCol
    , gteCol
    , ltCol
    , lteCol
    , jsonText
    , isNull
    , notNull
    , inList
    , and_
    , or_
    , not_
    , orderAsc
    , orderDesc
    , limit
    , offset
    , select
    , selectAs
    , selectColumn
    , distinct
    , latestPer
    , groupBy
    , Agg
    , aggregate
    , key
    , keyAs
    , countAs
    , countIfAs
    , countDistinctAs
    , sumAs
    , minAs
    , maxAs
    , having
    , toList
    , toRows
    , toMaybe
    , count
    , toSql
    , sqlOf
    , transaction
    )

import Sky.Ffi as Ffi
import Sky.Core.Error as Error exposing (Error)
import Sky.Core.Task as Task
import Sky.Core.List as List
import Sky.Core.String as String
import Sky.Core.Char as Char
import Sky.Core.Json.Encode exposing (Value)
import Std.Codec as Codec exposing (Codec, ColType(..), Shape(..))
import Std.Db as Db exposing (SqlValue(..))

-- | A table described by one codec. Opaque: build it with `fromCodec` and the
-- builders below.
type Store a
    = Store (StoreRec a)

type alias StoreRec a =
    { name : String
    , codec : Codec a
    , pk : String
    , cols : List ( String, String )
    , generated : List String
    , computed : List ( String, () -> SqlValue )
    , problems : List String
    }


-- The ONE place a `Store` is taken apart. Every verb and builder reads the
-- record through here, so the payload is narrowed once per program, not once
-- per verb (coerce-floor lever a, doc 14 §5).
storeRec : Store a -> StoreRec a
storeRec (Store s) =
    s


-- | Define a store from a table name and its codec. The columns are derived
-- from the codec's record shape.
fromCodec : String -> Codec a -> Store a
fromCodec name codec =
    let
        cols = codecColumns codec
    in
        Store
            { name = name
            , codec = codec
            , pk = ""
            , cols = cols
            , generated = []
            , computed = []
            , problems =
                case cols of

                    [] ->
                        [ "Store.fromCodec \"" ++ name
                              ++ "\": the codec is not a record codec, so it has no columns"
                        ]

                    _ ->
                        []
            }


-- | Mark the primary-key column (NOT NULL; used by `findBy`/`delete`/`update`).
-- Accepts the record FIELD name or the snake column name (resolved either way).
-- An unknown name makes the first verb on the store fail.
primaryKey : String -> Store a -> Store a
primaryKey pk store =
    let
        s = storeRec store
        ( col, problems ) = builderCol "primaryKey" pk s.cols s.problems
    in
        Store { s | pk = col, problems = problems }


-- | Mark an INTEGER primary key as auto-increment (SQLite `INTEGER PRIMARY KEY
-- AUTOINCREMENT` / Postgres `BIGSERIAL`) — the database assigns it, so `insert`
-- OMITS the column and the DB fills the next id. Use this for the common
-- `id : Int` serial-PK table: `Store.fromCodec "todos" codec |> Store.serial "id"`.
-- (For a String/UUID PK you generate yourself, use `primaryKey` instead.)
serial : String -> Store a -> Store a
serial name store =
    let
        s = storeRec store
        ( col, problems ) = builderCol "serial" name s.cols s.problems
    in
        Store
            { s
                | pk = col
                , generated = col :: s.generated
                , cols = appendKind col "!" s.cols
                , problems = problems
            }


-- | Append a suffix to one column's colspec kind: `!` (serial) or a
-- `|`-delimited flag (see the runtime's codecColExtras). The flag drives the
-- CREATE-TABLE constraint/default; the base kind (hence every read/write path)
-- is unaffected.
appendKind : String -> String -> List ( String, String ) -> List ( String, String )
appendKind col suffix cols =
    case cols of

        [] ->
            []

        ( c, k ) :: rest ->
            if c == col then
                ( c, k ++ suffix ) :: appendKind col suffix rest

            else
                ( c, k ) :: appendKind col suffix rest


-- | One builder flag on one column. An unknown column is recorded as a
-- problem, and the first verb on the store fails with it.
withFlag : String -> String -> String -> Store a -> Store a
withFlag verb name flag store =
    let
        s = storeRec store
        ( col, problems ) = builderCol verb name s.cols s.problems
    in
        Store
            { s
                | cols = appendKind col ("|" ++ flag) s.cols
                , problems = problems
            }


-- | A default value inside a colspec flag. `%` and `|` are percent-encoded, so
-- a value can hold either one without ending the flag or injecting another
-- (the runtime's codecFlagValueDecoder reverses it).
flagValue : String -> String
flagValue v =
    String.replace "|" "%7C" (String.replace "%" "%25" v)


-- | Mark a column `UNIQUE` in the generated DDL (e.g. a login email):
-- `Store.fromCodec "users" codec |> Store.primaryKey "id" |> Store.unique "email"`.
-- A duplicate insert surfaces as a `Task.fail` from the driver.
unique : String -> Store a -> Store a
unique name store =
    withFlag "unique" name "u" store


-- | Give a column a `DEFAULT` of the current timestamp (`now()` on Postgres,
-- `datetime('now')` on SQLite) AND mark it `generated`, so `insert`/`update` OMIT
-- it and the database stamps it: `Store.defaultNow "created_at"`.
defaultNow : String -> Store a -> Store a
defaultNow name store =
    let
        s = storeRec store
        ( col, problems ) = builderCol "defaultNow" name s.cols s.problems
    in
        Store
            { s
                | cols = appendKind col "|dnow" s.cols
                , generated = col :: s.generated
                , problems = problems
            }


-- | Mark a timestamp column that the DB stamps on INSERT (`defaultNow`) AND that
-- `Store.update`/`updateWhere` auto-bump to the current time on EVERY update — the
-- classic `updated_at`: `Store.touchOnUpdate "updated_at"`. No read-modify-write and
-- no raw SQL: `Store.update` sets it to `now()` for you (a SQL DEFAULT alone only
-- fires on INSERT).
touchOnUpdate : String -> Store a -> Store a
touchOnUpdate name store =
    let
        s = storeRec store
        ( col, problems ) =
            builderCol "touchOnUpdate" name s.cols s.problems
    in
        Store
            { s
                | cols = appendKind col "|dnow" (appendKind col "|touch" s.cols)
                , generated = col :: s.generated
                , problems = problems
            }


-- | Give a column a `DEFAULT` text value in the generated DDL:
-- `Store.defaultText "content" ""`. (Does NOT mark the column generated — the
-- record's value is still written on insert; the DEFAULT only applies when the
-- column is omitted, e.g. via `Store.generated`.) The value is stored as given,
-- including `|` and `%`.
defaultText : String -> String -> Store a -> Store a
defaultText name val store =
    withFlag "defaultText" name ("dtext=" ++ flagValue val) store


-- | Give a column a `DEFAULT` integer value in the generated DDL:
-- `Store.defaultInt "verified" 0`.
defaultInt : String -> Int -> Store a -> Store a
defaultInt name val store =
    withFlag "defaultInt" name ("dint=" ++ String.fromInt val) store


-- | Give a column a `DEFAULT` boolean value in the generated DDL (`TRUE`/`FALSE`
-- on Postgres, `1`/`0` on SQLite): `Store.defaultBool "active" True`.
defaultBool : String -> Bool -> Store a -> Store a
defaultBool name val store =
    withFlag
        "defaultBool"
        name
        (if val then
            "dbool=true"

        else
            "dbool=false")
        store


-- | Give a column an APP-SIDE computed default: a `() -> SqlValue` the runtime
-- calls at INSERT time (the DB can't run Sky, so this complements the SQL-side
-- `default*`). The prime use is a UUID/String primary key you don't want to pass
-- on every insert — `Store.defaultWith "id" (\_ -> SqlString (newId ()))` (use the
-- unit-arg `Task.run` idiom inside for effectful generators like `Uuid.v4`). The
-- column is marked `generated`, so `insert` ignores the record's value and writes
-- the computed one instead.
defaultWith : String -> (() -> SqlValue) -> Store a -> Store a
defaultWith name gen store =
    let
        s = storeRec store
        ( col, problems ) = builderCol "defaultWith" name s.cols s.problems
    in
        Store
            { s
                | computed = ( col, gen ) :: s.computed
                , generated = col :: s.generated
                , problems = problems
            }


-- | Mark columns the DATABASE fills — a `serial` PK, a `DEFAULT`/`defaultNow`
-- timestamp — so `insert` and `update` OMIT them (the DB assigns/keeps them):
-- `Store.fromCodec "notes" codec |> Store.primaryKey "id" |> Store.generated [ "id", "created_at" ]`.
generated : List String -> Store a -> Store a
generated names store =
    let
        s = storeRec store
        ( cols, problems ) = builderCols "generated" names s.cols s.problems
    in
        Store { s | generated = cols, problems = problems }


-- | Resolve a builder's column name. An unknown name is recorded as a problem.
builderCol : String -> String -> List ( String, String ) -> List String -> ( String, List String )
builderCol verb name cols problems =
    let
        col = resolveCol cols name
    in
        case lookupKind col cols of

            Just _ ->
                ( col, problems )

            Nothing ->
                ( col
                , problems
                      ++ [ "Store." ++ verb ++ ": unknown column \"" ++ name
                               ++ "\" — columns are "
                               ++ colNames cols
                         ]
                )


builderCols : String -> List String -> List ( String, String ) -> List String -> ( List String, List String )
builderCols verb names cols problems =
    case names of

        [] ->
            ( [], problems )

        n :: rest ->
            let
                ( col, p1 ) = builderCol verb n cols problems
                ( more, p2 ) = builderCols verb rest cols p1
            in
                ( col :: more, p2 )


-- | Create the table (dialect-correct DDL derived from the codec).
create : Db -> Store a -> Task Error ()
create conn store =
    let
        s = storeRec store
    in
        case storeError s.name s.pk s.cols s.problems of

            Just e ->
                Task.fail e

            Nothing ->
                dbCreateCols conn s.name s.cols s.pk


-- | Safe additive migration: create the table if absent, and ADD any columns
-- the record type has gained (nullable). Never drops, renames, or retypes a
-- column — those stay manual (see docs/history/v0.19/auto-migration-architecture.md).
-- Idempotent; returns the SQL statements it applied (empty when up to date).
migrate : Db -> Store a -> Task Error (List String)
migrate conn store =
    let
        s = storeRec store
    in
        case storeError s.name s.pk s.cols s.problems of

            Just e ->
                Task.fail e

            Nothing ->
                dbAutoMigrate conn s.name s.cols s.pk


-- | Insert a record. Columns marked `generated` (a `serial` PK, `defaultNow`) are
-- OMITTED so the database assigns them.
--
-- Returns the PRIMARY KEY the database assigned when the PK is an Int (a
-- `Store.serial` id) — that value is the whole point, since a `generated` PK is
-- omitted from the INSERT and the caller has no other way to learn it. Wire
-- child rows to this id:
--
--     Store.insert conn entries header
--         |> Task.andThen (\entryId -> Store.insert conn lines { line | entryId = entryId })
--
-- For a caller-supplied PK (a String/UUID key) there is no DB-assigned integer,
-- so the result is the affected-row count.
insert : Db -> Store a -> a -> Task Error Int
insert conn store record =
    let
        s = storeRec store
    in
        case storeError s.name s.pk s.cols s.problems of

            Just e ->
                Task.fail e

            Nothing ->
                dbExecObjectWith
                    conn
                    s.name
                    (colsExcluding s.generated s.cols)
                    (Codec.toValue s.codec record)
                    (computedValues s.computed)
                    s.pk
                    (kindOf s.pk s.cols)


computedValues : List ( String, () -> SqlValue ) -> List ( String, SqlValue )
computedValues computed =
    case computed of

        [] ->
            []

        ( col, gen ) :: rest ->
            ( col, gen () ) :: computedValues rest


-- | Bulk-insert many records in ONE multi-row INSERT — for time-series / batch
-- writes where a per-row `insert` would be N round-trips. Columns marked
-- `generated` are omitted (the DB fills them). `defaultWith` computed columns are
-- NOT applied here — provide those values in the records. Returns rows affected.
insertMany : Db -> Store a -> List a -> Task Error Int
insertMany conn store records =
    let
        s = storeRec store
    in
        case storeError s.name s.pk s.cols s.problems of

            Just e ->
                Task.fail e

            Nothing ->
                dbExecObjectMany
                    conn
                    s.name
                    (colsExcluding s.generated s.cols)
                    (List.map (Codec.toValue s.codec) records)


-- | Insert the record, or UPDATE it in place if its primary key already exists
-- (`INSERT ... ON CONFLICT(pk) DO UPDATE`). The idempotent write for config rows
-- keyed by a natural/app id — `Store.upsert conn monitors monitor`. Requires a
-- non-generated PK (a String/UUID key you provide, not `serial`).
-- Returns the row's PK for an Int-keyed store (0 when an `ON CONFLICT DO
-- NOTHING` wrote nothing), and the affected-row count otherwise — the same
-- contract as `insert`.
upsert : Db -> Store a -> a -> Task Error Int
upsert conn store record =
    let
        s = storeRec store
    in
        case storeError s.name s.pk s.cols s.problems of

            Just e ->
                Task.fail e

            Nothing ->
                dbUpsertObject
                    conn
                    s.name
                    (colsExcluding s.generated s.cols)
                    s.pk
                    (Codec.toValue s.codec record)
                    (kindOf s.pk s.cols)


-- | Update the row identified by the record's PRIMARY KEY, setting every column
-- to the record's value (the PK and `generated` columns are never written). Read
-- a row, change fields, `update` it back. Returns rows affected.
update : Db -> Store a -> a -> Task Error Int
update conn store record =
    let
        s = storeRec store
    in
        case storeError s.name s.pk s.cols s.problems of

            Just e ->
                Task.fail e

            Nothing ->
                dbUpdateByPk
                    conn
                    s.name
                    (setColspecOf s.pk s.generated s.cols)
                    s.pk
                    (kindOf s.pk s.cols)
                    (Codec.toValue s.codec record)


-- | Update every row matching a `Cond` to the record's column values (PK +
-- `generated` columns excluded). For compound / ownership conditions the PK alone
-- can't express: `Store.updateWhere conn notes (Store.and_ [ Store.eq "id" (SqlInt id), Store.eq "user_id" (SqlString uid) ]) note`.
updateWhere : Db -> Store a -> Cond -> a -> Task Error Int
updateWhere conn store cond record =
    let
        s = storeRec store
    in
        case writeWhere (dialectOf conn) s.name s.pk s.cols s.problems cond of

            Err e ->
                Task.fail e

            Ok ( whereSql, whereParams ) ->
                dbUpdateWhere
                    conn
                    s.name
                    (setColspecOf s.pk s.generated s.cols)
                    (Codec.toValue s.codec record)
                    whereSql
                    whereParams


-- | PARTIAL-column update by `Cond`: `SET` only the named columns and leave the
-- rest untouched — unlike `update`/`updateWhere`, which rewrite the WHOLE record
-- from the codec. This is the PATCH primitive: set one or two columns without a
-- read-modify-write, and without needing them present in the codec's read shape.
-- Column names accept the record FIELD or the snake column; values bind as
-- `SqlValue` params (injection-safe). Example — mark an order shipped:
-- `Store.updateFields conn orders (eq "id" (SqlString oid))
--     [ ( "status", SqlString "shipped" ), ( "tracking", SqlString t ) ]`.
updateFields : Db -> Store a -> Cond -> List ( String, SqlValue ) -> Task Error Int
updateFields conn store cond sets =
    case sets of

        [] ->
            Task.succeed 0

        _ ->
            let
                s = storeRec store
            in
                runExec
                    conn
                    (prepareSet
                        (dialectOf conn)
                        s.name
                        s.pk
                        s.cols
                        s.problems
                        cond
                        False
                        sets)


-- | PARTIAL-column update by primary key — the everyday PATCH-by-id:
-- `Store.setFields conn users (SqlString uid) [ ( "verified", SqlBool True ) ]`.
setFields : Db -> Store a -> SqlValue -> List ( String, SqlValue ) -> Task Error Int
setFields conn store pkValue sets =
    updateFields conn store (eq (storeRec store).pk pkValue) sets


-- | Atomic relative adjustment of integer columns — `SET col = col + delta` per
-- entry, by `Cond`. The one write a value-based update can't express (the value
-- depends on the column's CURRENT value): a race-free counter/stock/balance
-- change without reading first. Negative deltas subtract:
-- `Store.adjust conn products (eq "id" (SqlString pid)) [ ( "stock", -qty ) ]`.
-- (For a clamped decrement like `max 0 (stock - qty)`, that's app logic — stay
-- with raw `Db.exec` inside a `Store.transaction`.)
adjust : Db -> Store a -> Cond -> List ( String, Int ) -> Task Error Int
adjust conn store cond deltas =
    case deltas of

        [] ->
            Task.succeed 0

        _ ->
            let
                s = storeRec store
            in
                runExec
                    conn
                    (prepareSet
                        (dialectOf conn)
                        s.name
                        s.pk
                        s.cols
                        s.problems
                        cond
                        True
                        (intSets deltas))


intSets : List ( String, Int ) -> List ( String, SqlValue )
intSets deltas =
    case deltas of

        [] ->
            []

        ( c, d ) :: rest ->
            ( c, SqlInt d ) :: intSets rest


-- | Every row, decoded via the codec.
all : Db -> Store a -> Task Error (List a)
all conn store =
    toList conn (query store)


-- | The single row where `col = value` (value bound as text), or Nothing.
-- `col` must be a codec column (field or snake name).
findBy : Db -> Store a -> String -> String -> Task Error (Maybe a)
findBy conn store col value =
    toMaybe conn (query store |> where_ (eq col (SqlString value)))


-- | Run ANY SQL and decode each row into a typed projection record via a codec.
-- The last escape hatch: `groupBy` + `aggregate`, `select`, `latestPer`,
-- `jsonText` and the text conditions cover grouped counts, projections and
-- per-key newest rows with checked names. Reach for this for a shape they do not
-- model (a join, until the join builders land; a window function; a CTE). You
-- own the SQL; the codec owns the mapping, so rows come back as records, not
-- `Dict String String`. The codec's columns must match the SELECT's output
-- columns (alias to snake_case):
--
--     type alias Tally = { ideaId : String, votes : Int }
--     tallyCodec = Codec.auto { ideaId = "", votes = 0 }
--     Store.selectRaw conn tallyCodec
--         "SELECT idea_id, COUNT(*) AS votes FROM votes GROUP BY idea_id"
--         []
selectRaw : Db -> Codec row -> String -> List SqlValue -> Task Error (List row)
selectRaw conn codec sql params =
    dbQueryObjectsV conn sql params (codecColumns codec)
        |> Task.andThen
               (\rows -> Task.fromResult (decodeAll (rowDecoder codec) rows []))


-- | Delete rows where `col = value` (single column). `col` must be a codec
-- column (field or snake name).
delete : Db -> Store a -> String -> String -> Task Error Int
delete conn store col value =
    deleteWhere conn store (eq col (SqlString value))


-- | Delete every row matching a `Cond` — for compound conditions the single-column
-- `delete` can't express: `Store.deleteWhere conn notes (Store.and_ [ Store.eq "id" (SqlInt id), Store.eq "user_id" (SqlString uid) ])`.
deleteWhere : Db -> Store a -> Cond -> Task Error Int
deleteWhere conn store cond =
    let
        s = storeRec store
    in
        runExec
            conn
            (case writeWhere (dialectOf conn) s.name s.pk s.cols s.problems cond of

                Err e ->
                    Err e

                Ok ( whereSql, whereParams ) ->
                    Ok
                        ( "DELETE FROM " ++ s.name ++ " WHERE " ++ whereSql
                        , whereParams
                        ))

-- ── Project (schema-dump for file-based migrations) ─────────────────────────
-- | A table's schema erased of its record type — name, primary key, and
-- (column, kind) list — for the migration schema-dump.
type alias Table =
    { name : String
    , pk : String
    , cols : List ( String, String )
    }


-- | Erase a store to its `Table` schema.
toTable : Store a -> Table
toTable store =
    let
        s = storeRec store
    in
        { name = s.name, pk = s.pk, cols = s.cols }

-- | A project's set of tables — the single declaration `sky db` reads to derive
-- the target schema: `db = Store.project [ Store.toTable users, Store.toTable orders ]`.
type Project
    = Project (List Table)


-- | Build a `Project` from a list of erased tables (via `toTable`). Expose the
-- result as `db : Store.Project` from your entry module for `sky db migrate --gen`.
project : List Table -> Project
project tables =
    Project tables


-- | How many tables the project declares — the count `sky db reset` / `sky db
-- drop` echo in their confirmation prompt.
projectTableCount : Project -> Int
projectTableCount (Project tables) =
    List.length tables


-- | Print the project's schema as JSON (between SKY_SCHEMA_* markers) and exit —
-- the pure, DB-free schema-dump that `sky db migrate --gen` captures to diff
-- against `db/schema.json`. Make this a project's `main` in the gen entry.
dumpSchema : Project -> Task Error ()
dumpSchema (Project tables) =
    dbDumpProject tables


dbDumpProject : List Table -> Task Error ()
dbDumpProject =
    Ffi.kernel "Db_dumpProject"


-- | Push the whole project's schema to the live DB — create each missing table
-- and ADD any new columns (nullable), for every store. The no-migration-files
-- "make my dev DB match my types" path (`sky db push`); production uses the
-- committed `db/migrations/` files via `sky db migrate`. Returns the SQL applied.
pushProject : Db -> Project -> Task Error (List String)
pushProject conn (Project tables) =
    pushTables conn tables


pushTables : Db -> List Table -> Task Error (List String)
pushTables conn tables =
    case tables of

        [] ->
            Task.succeed []

        t :: rest ->
            dbAutoMigrate conn t.name t.cols t.pk
                |> Task.andThen
                       (\applied ->
                           Task.map
                               (\more -> applied ++ more)
                               (pushTables conn rest))


-- | EMPTY the data from every table the project declares — keeps the schema and
-- the `_sky_migrations` ledger, resets autoincrement counters. The `sky db reset`
-- path. Returns the SQL executed.
resetProject : Db -> Project -> Task Error (List String)
resetProject conn (Project tables) =
    dbResetTables conn (List.map .name tables)


-- | DROP every table the project declares PLUS `_sky_migrations` — a fresh
-- "never ran migrate/push" state. The `sky db drop` path. Returns the SQL executed.
dropProject : Db -> Project -> Task Error (List String)
dropProject conn (Project tables) =
    dbDropTables conn (List.map .name tables ++ [ "_sky_migrations" ])


-- | EMPTY the data from a single named table (schema + ledger untouched).
resetTable : Db -> String -> Task Error (List String)
resetTable conn name =
    dbResetTables conn [ name ]


-- | DROP a single named table. Does NOT touch `_sky_migrations`.
dropTable : Db -> String -> Task Error (List String)
dropTable conn name =
    dbDropTables conn [ name ]


dbResetTables : Db -> List String -> Task Error (List String)
dbResetTables =
    Ffi.kernel "Db_resetTables"


dbDropTables : Db -> List String -> Task Error (List String)
dbDropTables =
    Ffi.kernel "Db_dropTables"

-- ── Query builder (compose conditions + ordering + paging, no raw SQL) ───────
-- A `Cond` is a composable boolean condition; `and_` / `or_` / `not_` nest them.
-- A `Query r` holds a description of the SELECT (pure data: the source table,
-- conditions, ORDER BY, LIMIT/OFFSET, an optional projection or aggregate) and
-- the decoder for one result row. A terminal (`toList` / `toRows` / `toMaybe` /
-- `count`) checks every name against the codecs, renders the SQL for the
-- connection's dialect and runs it. Every VALUE binds as a `SqlValue` param —
-- injection-safe. A column argument is a codec column (field or snake name) or a
-- `jsonText` reference. Never build a column argument from user input: a
-- `jsonText` reference can read any key of a JSON column.
--
-- | A composable WHERE condition — build a leaf with `eq` / `gt` / `like` / … and
-- combine with `and_` / `or_` / `not_`; apply to a query with `where_`. Opaque
-- (build it with the combinators; don't pattern-match).
type Cond
    = CondOp String String SqlValue
    | CondNull String Bool
    | CondIn String (List SqlValue)
    | CondAnd (List Cond)
    | CondOr (List Cond)
    | CondNot Cond
    | CondCol String String String
    | CondText String String String

type OrderTerm
    = OrderTerm String String

-- | One output column of `aggregate`. Build it with `key`, `keyAs`, `countAs`,
-- `countIfAs`, `countDistinctAs`, `sumAs`, `minAs` or `maxAs`. Opaque.
type Agg
    = Agg String String String Cond

type Output
    = OutStar
    | OutCols (List ( String, String ))
    | OutAggs (List Agg)
    | OutCount

type Dialect
    = Sqlite
    | Postgres

type alias Source =
    { table : String
    , pk : String
    , cols : List ( String, String )
    , problems : List String
    }

type alias QuerySpec =
    { source : Source
    , conds : List Cond
    , orders : List OrderTerm
    , limitN : Maybe Int
    , offsetN : Maybe Int
    , distinct : Bool
    , groups : List String
    , out : Output
    , outCols : List ( String, String )
    , having : List Cond
    , latest : Maybe ( List String, String )
    }

-- | An in-progress query whose rows decode to `r`. Start with `query`, add
-- conditions with `where_`, ordering with `orderAsc` / `orderDesc`, paging with
-- `limit` / `offset`, reshape with `select` / `aggregate`, then run a terminal
-- (`toList` / `toRows` / `toMaybe` / `count`).
type Query r
    = Query QuerySpec (List String -> Result Error r)


-- The ONE place a `Query` is taken apart (see `storeRec`).
specOf : Query r -> QuerySpec
specOf (Query spec _) =
    spec


decoderOf : Query r -> List String -> Result Error r
decoderOf (Query _ dec) =
    dec


mapSpec : (QuerySpec -> QuerySpec) -> Query r -> Query r
mapSpec f q =
    Query (f (specOf q)) (decoderOf q)


-- | Start a query over a store:
-- `Store.query products |> Store.where_ (Store.eq "active" (SqlBool True)) |> Store.toList conn`.
query : Store a -> Query a
query store =
    let
        s = storeRec store
    in
        Query
            { source =
                { table = s.name
                , pk = s.pk
                , cols = s.cols
                , problems = s.problems
                }
            , conds = []
            , orders = []
            , limitN = Nothing
            , offsetN = Nothing
            , distinct = False
            , groups = []
            , out = OutStar
            , outCols = s.cols
            , having = []
            , latest = Nothing
            }
            (rowDecoder s.codec)


rowDecoder : Codec r -> List String -> Result Error r
rowDecoder codec groups =
    case groups of

        j :: _ ->
            Codec.fromJson codec j

        [] ->
            Err (Error.decode "Store: a result row had no columns")


-- | Add a condition. Multiple `where_` calls are AND-combined; use `and_` / `or_`
-- / `not_` inside one call for grouped OR / negation:
-- `q |> where_ (eq "a" x) |> where_ (or_ [ gt "b" y, eq "c" z ])`.
where_ : Cond -> Query r -> Query r
where_ c q =
    mapSpec (\s -> { s | conds = c :: s.conds }) q


-- ── Condition leaves (each returns a `Cond`) ─────────────────────────────────
-- | `col = value`.
eq : String -> SqlValue -> Cond
eq col v =
    CondOp col "=" v


-- | `col <> value`.
neq : String -> SqlValue -> Cond
neq col v =
    CondOp col "<>" v


-- | `col > value`.
gt : String -> SqlValue -> Cond
gt col v =
    CondOp col ">" v


-- | `col >= value`.
gte : String -> SqlValue -> Cond
gte col v =
    CondOp col ">=" v


-- | `col < value`.
lt : String -> SqlValue -> Cond
lt col v =
    CondOp col "<" v


-- | `col <= value`.
lte : String -> SqlValue -> Cond
lte col v =
    CondOp col "<=" v


-- | `col LIKE pattern`. The pattern is used as given: `%` and `_` are
-- wildcards and there is no escape. It is case-sensitive on PostgreSQL and
-- ignores ASCII case on SQLite. For text a user typed, use `contains`,
-- `startsWith`, `endsWith`, `eqCi` or `containsCi`, which escape the needle
-- and match the same way on both dialects.
like : String -> String -> Cond
like col pat =
    CondOp col "LIKE" (SqlString pat)


-- | `col` equals `text`, ignoring case (`LOWER(col) = LOWER(?)`). A text column
-- only. SQLite's `LOWER` folds ASCII letters only; PostgreSQL folds all letters.
eqCi : String -> String -> Cond
eqCi col text =
    CondText "eqCi" col text


-- | `col` contains `needle`, case-sensitive on both dialects. `%`, `_` and `!`
-- in the needle are literal. An empty needle matches every non-NULL row.
contains : String -> String -> Cond
contains col needle =
    CondText "contains" col needle


-- | `col` contains `needle`, ignoring case. `%`, `_` and `!` in the needle are
-- literal. An empty needle matches every non-NULL row.
containsCi : String -> String -> Cond
containsCi col needle =
    CondText "containsCi" col needle


-- | `col` starts with `prefix`, case-sensitive on both dialects. An empty
-- prefix matches every non-NULL row.
startsWith : String -> String -> Cond
startsWith col prefix =
    CondText "startsWith" col prefix


-- | `col` ends with `suffix`, case-sensitive on both dialects:
-- `Store.endsWith "email" "@work.io"`. An empty suffix matches every non-NULL row.
endsWith : String -> String -> Cond
endsWith col suffix =
    CondText "endsWith" col suffix


-- | `left = right`, two columns of the same kind.
eqCol : String -> String -> Cond
eqCol left right =
    CondCol "=" left right


-- | `left <> right`, two columns of the same kind.
neqCol : String -> String -> Cond
neqCol left right =
    CondCol "<>" left right


-- | `left > right`, two columns of the same kind:
-- `Store.gtCol "last_staff_at" "customer_read_at"`.
gtCol : String -> String -> Cond
gtCol left right =
    CondCol ">" left right


-- | `left >= right`, two columns of the same kind.
gteCol : String -> String -> Cond
gteCol left right =
    CondCol ">=" left right


-- | `left < right`, two columns of the same kind.
ltCol : String -> String -> Cond
ltCol left right =
    CondCol "<" left right


-- | `left <= right`, two columns of the same kind.
lteCol : String -> String -> Cond
lteCol left right =
    CondCol "<=" left right


-- | A reference to one key of a JSON text column, usable wherever a column name
-- is (a condition, `groupBy`, `keyAs`, `selectAs`, an order term):
-- `Store.eq (Store.jsonText "props" "source") (SqlString "web")`. The value is
-- the key's text, or NULL when the key is missing: a JSON `true` reads `"true"`
-- on both dialects, a number reads as its text (which can differ between
-- SQLite and PostgreSQL, e.g. `1e2`). The column must be a text or blob column,
-- the key follows the identifier rule, and a compared value must be `SqlString`.
jsonText : String -> String -> String
jsonText col jsonKey =
    col ++ "->>" ++ jsonKey


-- | `col IS NULL`.
isNull : String -> Cond
isNull col =
    CondNull col True


-- | `col IS NOT NULL`.
notNull : String -> Cond
notNull col =
    CondNull col False


-- | `col IN (v1, v2, …)`. An empty list matches nothing.
inList : String -> List SqlValue -> Cond
inList col vs =
    CondIn col vs


-- ── Condition combinators ────────────────────────────────────────────────────
-- | All of the conditions (AND). An empty list is always true.
and_ : List Cond -> Cond
and_ conds =
    CondAnd conds


-- | Any of the conditions (OR). An empty list is always false.
or_ : List Cond -> Cond
or_ conds =
    CondOr conds


-- | Negate a condition (NOT).
not_ : Cond -> Cond
not_ cond =
    CondNot cond


-- ── Ordering + paging ────────────────────────────────────────────────────────
-- | Append `ORDER BY col ASC` (chain for multi-column ordering). On a nullable
-- column NULLs come first, on both dialects.
orderAsc : String -> Query r -> Query r
orderAsc col q =
    mapSpec (\s -> { s | orders = OrderTerm col "ASC" :: s.orders }) q


-- | Append `ORDER BY col DESC`. On a nullable column NULLs come last, on both
-- dialects. After `aggregate`, name a result field.
orderDesc : String -> Query r -> Query r
orderDesc col q =
    mapSpec (\s -> { s | orders = OrderTerm col "DESC" :: s.orders }) q


-- | `LIMIT n`. A negative `n` makes the query fail before it runs.
limit : Int -> Query r -> Query r
limit n q =
    mapSpec (\s -> { s | limitN = Just n }) q


-- | `OFFSET n`, with or without `limit`. A negative `n` makes the query fail
-- before it runs.
offset : Int -> Query r -> Query r
offset n q =
    mapSpec (\s -> { s | offsetN = Just n }) q


-- ── Projection, DISTINCT, newest row per key ─────────────────────────────────
-- | Read only the columns of a smaller record: each field of `codec` takes the
-- store column of the same name. A nullable column needs a `Maybe` field.
--
--     Store.query orders |> Store.select summaryCodec |> Store.toList conn
select : Codec r -> Query a -> Query r
select codec q =
    selectAs codec [] q


-- | `select` with explicit sources: each `( field, source )` pair reads `source`
-- (a column or a `jsonText` reference) into `field`. Fields not listed take the
-- column of the same name.
selectAs : Codec r -> List ( String, String ) -> Query a -> Query r
selectAs codec pairs q =
    let
        spec = specOf q
    in
        Query
            { spec | out = OutCols pairs, outCols = codecColumns codec }
            (rowDecoder codec)


-- | Read one column into a list of plain values:
-- `Store.query orders |> Store.selectColumn "id" Codec.string |> Store.toList conn`
-- gives `List String`. `codec` must be a scalar codec (not a record).
selectColumn : String -> Codec c -> Query a -> Query c
selectColumn col codec q =
    let
        wrapped =
            Codec.object (\v -> v) |> Codec.field "value" (\v -> v) codec
                |> Codec.buildObject
        spec = specOf q
        source = spec.source
        problems =
            case Codec.shape codec of

                SRecord _ ->
                    source.problems
                        ++ [ "Store.selectColumn \"" ++ col
                                 ++ "\": the codec must be a scalar codec, not a record codec"
                           ]

                _ ->
                    source.problems
    in
        Query
            { spec
                | source = { source | problems = problems }
                , out = OutCols [ ( "value", col ) ]
                , outCols = codecColumns wrapped
            }
            (rowDecoder wrapped)


-- | `SELECT DISTINCT`: drop duplicate result rows. With `select`, every order
-- column must be one of the selected columns.
distinct : Query r -> Query r
distinct q =
    mapSpec (\s -> { s | distinct = True }) q


-- | Keep the newest row per key: for each distinct value of the `keys`
-- columns, the row with the largest `newestBy` (NULL is never the newest; ties
-- go to the larger primary key). Conditions apply before the pick:
--
--     Store.query orders
--         |> Store.where_ (Store.eq "status" (SqlString "open"))
--         |> Store.latestPer [ "customer_id" ] "created_at"
--         |> Store.toList conn
--
-- Not with `distinct`, `groupBy` or `aggregate`.
latestPer : List String -> String -> Query r -> Query r
latestPer keys newestBy q =
    mapSpec (\s -> { s | latest = Just ( keys, newestBy ) }) q


-- ── Grouped aggregates ───────────────────────────────────────────────────────
-- | `GROUP BY` these columns (or `jsonText` references). Use with `aggregate`.
groupBy : List String -> Query r -> Query r
groupBy cols q =
    mapSpec (\s -> { s | groups = s.groups ++ cols }) q


-- | Turn a query into one row per group, decoded by `codec`. Each field of the
-- result codec is covered by exactly one `Agg`:
--
--     Store.query invoices
--         |> Store.where_ (Store.gt "sent_at" (SqlInt since))
--         |> Store.groupBy [ "customer_id" ]
--         |> Store.aggregate tallyCodec
--             [ Store.key "customer_id"
--             , Store.countAs "sent"
--             , Store.countIfAs "opened" (Store.gt "opened_at" (SqlInt 0))
--             , Store.maxAs "last_sent_at" "sent_at"
--             ]
--         |> Store.having (Store.gte "sent" (SqlInt 2))
--         |> Store.orderDesc "sent"
--         |> Store.toRows conn
--
-- Without `groupBy` the result is one row over the whole selection (an empty
-- table gives zero counts and sums, and `Nothing` for `minAs` / `maxAs`).
aggregate : Codec r -> List Agg -> Query a -> Query r
aggregate codec aggs q =
    let
        spec = specOf q
    in
        Query
            { spec | out = OutAggs aggs, outCols = codecColumns codec }
            (rowDecoder codec)


noCond : Cond
noCond =
    CondAnd []


-- | The group column itself, into the result field of the same name. The
-- column must be in `groupBy`.
key : String -> Agg
key col =
    Agg "key" col col noCond


-- | A group column (or `jsonText` reference) into the named result field.
keyAs : String -> String -> Agg
keyAs field col =
    Agg "key" field col noCond


-- | `COUNT(*)` into an `Int` field.
countAs : String -> Agg
countAs field =
    Agg "count" field "" noCond


-- | The number of rows in the group that match `cond`, into an `Int` field (0
-- when none match).
countIfAs : String -> Cond -> Agg
countIfAs field cond =
    Agg "countIf" field "" cond


-- | `COUNT(DISTINCT col)` into an `Int` field (NULL is not counted).
countDistinctAs : String -> String -> Agg
countDistinctAs field col =
    Agg "countDistinct" field col noCond


-- | The sum of an `Int` or `Float` column into a field of the same kind (0 for
-- an empty group).
sumAs : String -> String -> Agg
sumAs field col =
    Agg "sum" field col noCond


-- | The smallest value of a column (not a `Bool` column). The field needs
-- `Maybe` when the column is nullable or there is no `groupBy`. Text compares
-- by the database collation, which can differ between SQLite and PostgreSQL.
minAs : String -> String -> Agg
minAs field col =
    Agg "min" field col noCond


-- | The largest value of a column (not a `Bool` column). The field needs
-- `Maybe` when the column is nullable or there is no `groupBy`.
maxAs : String -> String -> Agg
maxAs field col =
    Agg "max" field col noCond


-- | A condition on the aggregate results (`HAVING`). Name result fields:
-- `Store.having (Store.gte "sent" (SqlInt 2))`. Several `having` calls are
-- AND-combined.
having : Cond -> Query r -> Query r
having c q =
    mapSpec (\s -> { s | having = c :: s.having }) q


-- ── Terminals ────────────────────────────────────────────────────────────────
-- | Run the query, decoding every matching row.
toList : Db -> Query r -> Task Error (List r)
toList conn q =
    readRows conn (prepare (dialectOf conn) (specOf q)) (specOf q).outCols
        |> Task.andThen
               (\rows -> Task.fromResult (decodeAll (decoderOf q) rows []))


-- | The same as `toList`. Reads well after `aggregate`.
toRows : Db -> Query r -> Task Error (List r)
toRows conn q =
    toList conn q


-- | Run the query with `LIMIT 1`, returning the first matching row or `Nothing`.
toMaybe : Db -> Query r -> Task Error (Maybe r)
toMaybe conn q =
    toList conn (limit 1 q) |> Task.map List.head


-- | Count result rows (filters apply; order and paging are ignored). After
-- `distinct`, `latestPer` or `aggregate` it counts the rows that query returns.
count : Db -> Query r -> Task Error Int
count conn q =
    readRows conn (prepareCount (dialectOf conn) (specOf q)) [ ( "n", "int" ) ]
        |> Task.andThen (\rows -> Task.fromResult (countOf rows))


-- | The SQL text and parameters a query renders on this connection's dialect,
-- with `?` placeholders (PostgreSQL's `$n` are numbered when it runs), or the
-- `Err` the query would fail with. For tests and logs.
toSql : Db -> Query r -> Result Error ( String, List SqlValue )
toSql conn q =
    prepare (dialectOf conn) (specOf q)


-- | Run a callback inside a DB transaction — Store operations compose by taking
-- the `tx` handle. Alias over `Db.withTransaction`, so read / write / transact
-- all stay in the `Store.*` namespace.
transaction : Db -> (Db -> Task Error a) -> Task Error a
transaction conn f =
    Db.withTransaction conn f


-- | Encode a TYPED value to a `SqlValue` via its codec, so a filter can compare
-- against an enum / `Money` / `Time` / `Codec.map` wrapper using the SAME encoding
-- the column stores — no manual `SqlString`/`SqlInt` wrapping, no drift:
-- `where_ (Store.eq "status" (Store.sqlOf statusCodec Shipped))`.
sqlOf : Codec a -> a -> SqlValue
sqlOf codec value =
    dbSqlOfValue (Codec.toValue codec value)


dbSqlOfValue : Value -> SqlValue
dbSqlOfValue =
    Ffi.kernel "Db_sqlOfValue"


-- ── The read and write runners ───────────────────────────────────────────────
-- The only call site of the read kernel and of `Db_exec` for Store SQL.
readRows : Db -> Result Error ( String, List SqlValue ) -> List ( String, String ) -> Task Error (List String)
readRows conn prepared colspec =
    case prepared of

        Err e ->
            Task.fail e

        Ok ( sql, params ) ->
            dbQueryObjectsV conn sql params colspec


runExec : Db -> Result Error ( String, List SqlValue ) -> Task Error Int
runExec conn prepared =
    case prepared of

        Err e ->
            Task.fail e

        Ok ( sql, params ) ->
            dbExecV conn sql params


decodeAll : (List String -> Result Error r) -> List String -> List r -> Result Error (List r)
decodeAll dec rows acc =
    case rows of

        [] ->
            Ok (List.reverse acc)

        j :: rest ->
            case dec [ j ] of

                Ok x ->
                    decodeAll dec rest (x :: acc)

                Err e ->
                    Err e


countOf : List String -> Result Error Int
countOf rows =
    case rows of

        j :: _ ->
            Codec.fromJson countCodec j

        [] ->
            Ok 0


countCodec : Codec Int
countCodec =
    Codec.object (\n -> n) |> Codec.field "n" (\n -> n) Codec.int
        |> Codec.buildObject


dialectOf : Db -> Dialect
dialectOf conn =
    if dbDialect conn == "postgres" then
        Postgres

    else
        Sqlite


-- ── The prepare path ─────────────────────────────────────────────────────────
-- Checks every name, then renders text and parameters together, left to right
-- (SELECT list, WHERE, HAVING; GROUP BY, ORDER BY, LIMIT carry none). Nothing
-- reaches the database unless this returns `Ok`.
prepare : Dialect -> QuerySpec -> Result Error ( String, List SqlValue )
prepare d spec =
    let
        src = spec.source
        ctx = plainCtx d src.cols
    in
        case storeError src.table src.pk src.cols src.problems of

            Just e ->
                Err e

            Nothing ->
                case shapeError spec of

                    Just msg ->
                        Err <| storeErr msg

                    Nothing ->
                        case selectList ctx spec of

                            Err e ->
                                Err e

                            Ok ( selSql, selParams, aliases ) ->
                                case whereClause ctx spec.conds of

                                    Err e ->
                                        Err e

                                    Ok ( whereSql, whereParams ) ->
                                        case clauseTail ctx spec aliases of

                                            Err e ->
                                                Err e

                                            Ok ( tailSql, tailParams ) ->
                                                case latestCheck ctx spec of

                                                    Err e ->
                                                        Err e

                                                    Ok window ->
                                                        Ok
                                                            ( assemble
                                                                  spec
                                                                  window
                                                                  selSql
                                                                  whereSql
                                                                  tailSql
                                                            , selParams
                                                                  ++ whereParams
                                                                  ++ tailParams
                                                            )


-- `count`: the plain form keeps its text (`SELECT COUNT(*) AS n FROM t …`). A
-- query that reshapes its rows is counted as a subquery.
prepareCount : Dialect -> QuerySpec -> Result Error ( String, List SqlValue )
prepareCount d spec =
    let
        trimmed =
            { spec | orders = [], limitN = Nothing, offsetN = Nothing }
    in
        if isPlain spec then
            prepare d { trimmed | out = OutCount }

        else
            case prepare d trimmed of

                Err e ->
                    Err e

                Ok ( sql, params ) ->
                    Ok
                        ( "SELECT COUNT(*) AS n FROM (" ++ sql ++ ") sky_c"
                        , params
                        )


isPlain : QuerySpec -> Bool
isPlain spec =
    case spec.out of

        OutStar ->
            not spec.distinct && List.isEmpty spec.groups
                && spec.latest == Nothing

        _ ->
            False


isAggregate : Output -> Bool
isAggregate out =
    case out of

        OutAggs _ ->
            True

        _ ->
            False


-- The combinations that have no single meaning.
shapeError : QuerySpec -> Maybe String
shapeError spec =
    let
        agg = isAggregate spec.out
    in
        if not agg && not (List.isEmpty spec.groups) then
            Just "groupBy needs aggregate"

        else if not agg && not (List.isEmpty spec.having) then
            Just "having needs aggregate"

        else
            case spec.latest of

                Nothing ->
                    Nothing

                Just _ ->
                    if agg || spec.distinct then
                        Just
                            "latestPer cannot be combined with distinct, groupBy or aggregate"

                    else
                        Nothing


assemble : QuerySpec -> String -> String -> String -> String -> String
assemble spec window selSql whereSql tailSql =
    let
        src = spec.source
        distinctKw =
            if spec.distinct then
                "DISTINCT "

            else
                ""
    in
        case spec.latest of

            Nothing ->
                "SELECT " ++ distinctKw ++ selSql ++ " FROM " ++ src.table
                    ++ whereSql
                    ++ tailSql

            Just _ ->
                "SELECT " ++ selSql ++ " FROM (SELECT " ++ src.table
                    ++ ".*, ROW_NUMBER() OVER ("
                    ++ window
                    ++ ") AS sky_rn FROM "
                    ++ src.table
                    ++ whereSql
                    ++ ") sky_l WHERE sky_rn = 1"
                    ++ tailSql


-- PARTITION BY keys ORDER BY newest DESC NULLS LAST, pk DESC.
latestRendered : Ctx -> String -> List String -> String -> Result Error String
latestRendered ctx pk keys newestBy =
    case refList ctx keys [] of

        Err e ->
            Err e

        Ok keySqls ->
            case refOf ctx newestBy of

                Err e ->
                    Err e

                Ok ( nSql, _, _ ) ->
                    let
                        tie =
                            if pk == "" || pk == nSql then
                                ""

                            else
                                ", " ++ pk ++ " DESC"
                        partition =
                            case keySqls of

                                [] ->
                                    ""

                                _ ->
                                    "PARTITION BY " ++ String.join ", " keySqls
                                        ++ " "
                    in
                        Ok
                            (partition ++ "ORDER BY " ++ nSql
                                ++ " DESC NULLS LAST"
                                ++ tie)


-- ── The SELECT list ──────────────────────────────────────────────────────────
-- Returns the list text, its params, and the alias table HAVING reads.
selectList : Ctx -> QuerySpec -> Result Error ( String, List SqlValue, List ( String, Ref ) )
selectList ctx spec =
    case spec.out of

        OutStar ->
            Ok ( "*", [], [] )

        OutCount ->
            Ok ( "COUNT(*) AS n", [], [] )

        OutCols pairs ->
            case projection ctx spec.outCols pairs of

                Err e ->
                    Err e

                Ok ( items, _ ) ->
                    Ok ( String.join ", " items, [], [] )

        OutAggs aggs ->
            case refList ctx spec.groups [] of

                Err e ->
                    Err e

                Ok groupSqls ->
                    case aggItems
                             ctx
                             groupSqls
                             (not (List.isEmpty spec.groups))
                             spec.outCols
                             aggs
                             []
                             []
                             [] of

                        Err e ->
                            Err e

                        Ok ( items, params, aliases ) ->
                            case uncovered spec.outCols aliases of

                                Just col ->
                                    Err
                                        <| storeErr
                                               ("aggregate: result field \""
                                                   ++ col
                                                   ++ "\" has no Agg")

                                Nothing ->
                                    Ok
                                        ( String.join ", " items
                                        , params
                                        , aliases
                                        )


-- Each result column, read from the explicit source or the same-named column.
projection : Ctx -> List ( String, String ) -> List ( String, String ) -> Result Error ( List String, List String )
projection ctx outCols pairs =
    case pairsError outCols pairs [] of

        Just msg ->
            Err <| storeErr msg

        Nothing ->
            projectionItems ctx outCols pairs [] []


pairsError : List ( String, String ) -> List ( String, String ) -> List String -> Maybe String
pairsError outCols pairs seen =
    case pairs of

        [] ->
            Nothing

        ( field, _ ) :: rest ->
            let
                rc = resolveCol outCols field
            in
                case lookupKind rc outCols of

                    Nothing ->
                        Just
                            ("selectAs: \"" ++ field
                                ++ "\" is not a field of the result codec — fields are "
                                ++ colNames outCols)

                    Just _ ->
                        if List.member rc seen then
                            Just
                                ("selectAs: \"" ++ field ++ "\" is listed twice")

                        else
                            pairsError outCols rest (rc :: seen)


projectionItems : Ctx -> List ( String, String ) -> List ( String, String ) -> List String -> List String -> Result Error ( List String, List String )
projectionItems ctx outCols pairs items refs =
    case outCols of

        [] ->
            Ok ( List.reverse items, List.reverse refs )

        ( rc, rk ) :: rest ->
            let
                srcName = sourceFor outCols rc pairs
            in
                case refOf ctx srcName of

                    Err e ->
                        Err e

                    Ok ( rSql, _, sk ) ->
                        case fitError rc rk sk of

                            Just msg ->
                                Err <| storeErr ("select: " ++ msg)

                            Nothing ->
                                if isIdent rc then
                                    projectionItems
                                        ctx
                                        rest
                                        pairs
                                        ((rSql ++ " AS " ++ quoteAlias rc)
                                            :: items)
                                        (rSql :: refs)

                                else
                                    Err
                                        <| storeErr
                                               ("select: result field \"" ++ rc
                                                   ++ "\" is not a valid identifier")


sourceFor : List ( String, String ) -> String -> List ( String, String ) -> String
sourceFor outCols rc pairs =
    case pairs of

        [] ->
            rc

        ( field, src ) :: rest ->
            if resolveCol outCols field == rc then
                src

            else
                sourceFor outCols rc rest


-- A source of kind `sk` read into a result field of kind `rk`.
fitError : String -> String -> String -> Maybe String
fitError rc rk sk =
    if kindBase rk /= kindBase sk then
        Just
            ("field \"" ++ rc ++ "\" is " ++ kindBase rk ++ " but its source is "
                ++ kindBase sk)

    else if kindNullable sk && not (kindNullable rk) then
        Just
            ("field \"" ++ rc
                ++ "\" reads a nullable source, so it needs a Maybe type")

    else
        Nothing


-- One alias per result column, every result column covered once.
uncovered : List ( String, String ) -> List ( String, Ref ) -> Maybe String
uncovered outCols aliases =
    case outCols of

        [] ->
            Nothing

        ( rc, _ ) :: rest ->
            if aliasKnown rc aliases then
                uncovered rest aliases

            else
                Just rc


aliasKnown : String -> List ( String, Ref ) -> Bool
aliasKnown rc aliases =
    case aliases of

        [] ->
            False

        ( a, _ ) :: rest ->
            a == rc || aliasKnown rc rest


aggItems : Ctx -> List String -> Bool -> List ( String, String ) -> List Agg -> List String -> List SqlValue -> List ( String, Ref ) -> Result Error ( List String, List SqlValue, List ( String, Ref ) )
aggItems ctx groupSqls grouped outCols aggs items params aliases =
    case aggs of

        [] ->
            Ok ( List.reverse items, params, List.reverse aliases )

        (Agg kind field col cond) :: rest ->
            let
                rc = resolveCol outCols field
            in
                case lookupKind rc outCols of

                    Nothing ->
                        Err
                            <| storeErr
                                   ("aggregate: \"" ++ field
                                       ++ "\" is not a field of the result codec — fields are "
                                       ++ colNames outCols)

                    Just rk ->
                        if aliasKnown rc aliases then
                            Err
                                <| storeErr
                                       ("aggregate: result field \"" ++ rc
                                           ++ "\" has two Aggs")

                        else if not (isIdent rc) then
                            Err
                                <| storeErr
                                       ("aggregate: result field \"" ++ rc
                                           ++ "\" is not a valid identifier")

                        else
                            case aggExpr
                                     ctx
                                     groupSqls
                                     grouped
                                     kind
                                     rc
                                     rk
                                     col
                                     cond of

                                Err e ->
                                    Err e

                                Ok ( expr, exprParams ) ->
                                    aggItems
                                        ctx
                                        groupSqls
                                        grouped
                                        outCols
                                        rest
                                        ((expr ++ " AS " ++ quoteAlias rc)
                                            :: items)
                                        (params ++ exprParams)
                                        (( rc, ( expr, exprParams, rk ) )
                                            :: aliases)


aggExpr : Ctx -> List String -> Bool -> String -> String -> String -> String -> Cond -> Result Error ( String, List SqlValue )
aggExpr ctx groupSqls grouped kind rc rk col cond =
    if kind == "count" then
        intResult rc rk "COUNT(*)" noParams

    else if kind == "countIf" then
        case renderCond ctx cond of

            Err e ->
                Err e

            Ok ( cSql, cParams ) ->
                intResult
                    rc
                    rk
                    ("CAST(COALESCE(SUM(CASE WHEN " ++ cSql
                        ++ " THEN 1 ELSE 0 END), 0) AS BIGINT)")
                    cParams

    else
        case refOf ctx col of

            Err e ->
                Err e

            Ok ( rSql, rParams, sk ) ->
                if kind == "countDistinct" then
                    intResult rc rk ("COUNT(DISTINCT " ++ rSql ++ ")") rParams

                else if kind == "sum" then
                    if kindBase sk /= "int" && kindBase sk /= "real" then
                        Err
                            <| storeErr
                                   ("sumAs \"" ++ rc ++ "\": \"" ++ col
                                       ++ "\" is "
                                       ++ kindBase sk
                                       ++ ", not Int or Float")

                    else if kindBase rk /= kindBase sk then
                        Err
                            <| storeErr
                                   ("sumAs: field \"" ++ rc ++ "\" is "
                                       ++ kindBase rk
                                       ++ " but its source is "
                                       ++ kindBase sk)

                    else
                        Ok
                            ( "CAST(COALESCE(SUM(" ++ rSql ++ "), 0) AS "
                                  ++ (if kindBase sk == "int" then
                                         "BIGINT"

                                     else
                                         "DOUBLE PRECISION")
                                  ++ ")"
                            , rParams
                            )

                else if kind == "key" then
                    if List.member rSql groupSqls then
                        fitted rc rk sk rSql rParams

                    else
                        Err
                            <| storeErr
                                   ("key \"" ++ col
                                       ++ "\": the column is not in groupBy")

                else if kindBase sk == "bool" then
                    Err
                        <| storeErr
                               (kind ++ "As \"" ++ rc
                                   ++ "\": min and max of a Bool column are not portable (PostgreSQL has no max(boolean))")

                else if not grouped && not (kindNullable rk) then
                    Err
                        <| storeErr
                               (kind ++ "As: field \"" ++ rc
                                   ++ "\" needs a Maybe type without groupBy (an empty table gives NULL)")

                else if kind == "min" then
                    fitted rc rk sk ("MIN(" ++ rSql ++ ")") rParams

                else
                    fitted rc rk sk ("MAX(" ++ rSql ++ ")") rParams


intResult : String -> String -> String -> List SqlValue -> Result Error ( String, List SqlValue )
intResult rc rk sql params =
    if kindBase rk == "int" then
        Ok ( sql, params )

    else
        Err
            <| storeErr
                   ("aggregate: a count goes into an Int field, and \"" ++ rc
                       ++ "\" is "
                       ++ kindBase rk)


fitted : String -> String -> String -> String -> List SqlValue -> Result Error ( String, List SqlValue )
fitted rc rk sk sql params =
    case fitError rc rk sk of

        Just msg ->
            Err <| storeErr ("aggregate: " ++ msg)

        Nothing ->
            Ok ( sql, params )


-- ── WHERE, GROUP BY, HAVING, ORDER BY, LIMIT ─────────────────────────────────
whereClause : Ctx -> List Cond -> Result Error ( String, List SqlValue )
whereClause ctx conds =
    case conds of

        [] ->
            Ok ( "", [] )

        _ ->
            case renderCond ctx (CondAnd (List.reverse conds)) of

                Err e ->
                    Err e

                Ok ( sql, params ) ->
                    Ok ( " WHERE " ++ sql, params )


-- GROUP BY + HAVING + ORDER BY + LIMIT/OFFSET, after the WHERE.
clauseTail : Ctx -> QuerySpec -> List ( String, Ref ) -> Result Error ( String, List SqlValue )
clauseTail ctx spec aliases =
    case refList ctx spec.groups [] of

        Err e ->
            Err e

        Ok groupSqls ->
            case havingClause ctx spec.outCols aliases spec.having of

                Err e ->
                    Err e

                Ok ( havingSql, havingParams ) ->
                    case orderClause ctx spec of

                        Err e ->
                            Err e

                        Ok orderSql ->
                            case pageClause ctx.dialect spec.limitN spec.offsetN of

                                Err e ->
                                    Err e

                                Ok pageSql ->
                                    Ok
                                        ( groupClause groupSqls ++ havingSql
                                              ++ orderSql
                                              ++ pageSql
                                        , havingParams
                                        )


latestCheck : Ctx -> QuerySpec -> Result Error String
latestCheck ctx spec =
    case spec.latest of

        Nothing ->
            Ok ""

        Just ( keys, newestBy ) ->
            latestRendered ctx spec.source.pk keys newestBy


groupClause : List String -> String
groupClause groupSqls =
    case groupSqls of

        [] ->
            ""

        _ ->
            " GROUP BY " ++ String.join ", " groupSqls


havingClause : Ctx -> List ( String, String ) -> List ( String, Ref ) -> List Cond -> Result Error ( String, List SqlValue )
havingClause ctx outCols aliases conds =
    case conds of

        [] ->
            Ok ( "", [] )

        _ ->
            case renderCond
                     { ctx | cols = outCols, aliases = aliases, having = True }
                     (CondAnd (List.reverse conds)) of

                Err e ->
                    Err e

                Ok ( sql, params ) ->
                    Ok ( " HAVING " ++ sql, params )


orderClause : Ctx -> QuerySpec -> Result Error String
orderClause ctx spec =
    case spec.orders of

        [] ->
            Ok ""

        _ ->
            -- `orderAsc`/`orderDesc` PREPEND each term, so `orders` is in reverse
            -- call order. Reverse it so the FIRST call is the primary sort key:
            -- `q |> orderAsc "sort_order" |> orderAsc "id"` renders
            -- `ORDER BY sort_order ASC, id ASC`.
            case orderTerms ctx spec (List.reverse spec.orders) [] of

                Err e ->
                    Err e

                Ok terms ->
                    Ok (" ORDER BY " ++ String.join ", " terms)


orderTerms : Ctx -> QuerySpec -> List OrderTerm -> List String -> Result Error (List String)
orderTerms ctx spec orders acc =
    case orders of

        [] ->
            Ok (List.reverse acc)

        (OrderTerm col dir) :: rest ->
            case orderTerm ctx spec col dir of

                Err e ->
                    Err e

                Ok term ->
                    orderTerms ctx spec rest (term :: acc)


orderTerm : Ctx -> QuerySpec -> String -> String -> Result Error String
orderTerm ctx spec col dir =
    if isAggregate spec.out then
        -- After aggregate, an order term names a result field.
        let
            rc = resolveCol spec.outCols col
        in
            case lookupKind rc spec.outCols of

                Nothing ->
                    Err
                        <| storeErr
                               ("order: \"" ++ col
                                   ++ "\" is not a field of the aggregate result — fields are "
                                   ++ colNames spec.outCols)

                Just rk ->
                    Ok (quoteAlias rc ++ " " ++ dir ++ nullsClause rk dir)

    else
        case refOf ctx col of

            Err e ->
                Err e

            Ok ( rSql, _, k ) ->
                if spec.distinct && not (List.member rSql (projectedRefs ctx spec)) then
                    Err
                        <| storeErr
                               ("order: with distinct, \"" ++ col
                                   ++ "\" must be a selected column")

                else
                    Ok (rSql ++ " " ++ dir ++ nullsClause k dir)


projectedRefs : Ctx -> QuerySpec -> List String
projectedRefs ctx spec =
    case spec.out of

        OutCols pairs ->
            case projection ctx spec.outCols pairs of

                Ok ( _, refs ) ->
                    refs

                Err _ ->
                    []

        _ ->
            colNamesList spec.source.cols


-- NULLs sort first ascending and last descending on both dialects (SQLite's
-- own default, made explicit for PostgreSQL). Only on a nullable column, so a
-- query on required columns keeps its text.
nullsClause : String -> String -> String
nullsClause k dir =
    if kindNullable k then
        if dir == "ASC" then
            " NULLS FIRST"

        else
            " NULLS LAST"

    else
        ""


pageClause : Dialect -> Maybe Int -> Maybe Int -> Result Error String
pageClause d limitN offsetN =
    case ( limitN, offsetN ) of

        ( Just l, _ ) ->
            if l < 0 then
                Err <| storeErr ("limit " ++ String.fromInt l ++ " is negative")

            else
                case offsetN of

                    Just o ->
                        if o < 0 then
                            Err
                                <| storeErr
                                       ("offset " ++ String.fromInt o
                                           ++ " is negative")

                        else
                            Ok
                                (" LIMIT " ++ String.fromInt l ++ " OFFSET "
                                    ++ String.fromInt o)

                    Nothing ->
                        Ok (" LIMIT " ++ String.fromInt l)

        ( Nothing, Just o ) ->
            if o < 0 then
                Err
                    <| storeErr
                           ("offset " ++ String.fromInt o ++ " is negative")

            else
                case d of

                    Sqlite ->
                        -- SQLite accepts OFFSET only after a LIMIT; -1 is "no limit".
                        Ok (" LIMIT -1 OFFSET " ++ String.fromInt o)

                    Postgres ->
                        Ok (" OFFSET " ++ String.fromInt o)

        ( Nothing, Nothing ) ->
            Ok ""

-- ── Conditions: one walk resolves, checks and renders ────────────────────────
-- A resolved reference: SQL text, its params, and its colspec kind.
type alias Ref =
    ( String, List SqlValue, String )

type alias Ctx =
    { dialect : Dialect
    , cols : List ( String, String )
    , aliases : List ( String, Ref )
    , having : Bool
    }


plainCtx : Dialect -> List ( String, String ) -> Ctx
plainCtx d cols =
    { dialect = d, cols = cols, aliases = [], having = False }


renderCond : Ctx -> Cond -> Result Error ( String, List SqlValue )
renderCond ctx c =
    case c of

        CondOp col op v ->
            case refOf ctx col of

                Err e ->
                    Err e

                Ok ( rSql, rParams, _ ) ->
                    if isJsonRef col && not (isSqlString v) then
                        Err
                            <| storeErr
                                   ("a value compared with jsonText \"" ++ col
                                       ++ "\" must be SqlString")

                    else
                        Ok ( rSql ++ " " ++ op ++ " ?", rParams ++ [ v ] )

        CondNull col wantNull ->
            case refOf ctx col of

                Err e ->
                    Err e

                Ok ( rSql, rParams, _ ) ->
                    if wantNull then
                        Ok ( rSql ++ " IS NULL", rParams )

                    else
                        Ok ( rSql ++ " IS NOT NULL", rParams )

        CondIn col vs ->
            case refOf ctx col of

                Err e ->
                    Err e

                Ok ( rSql, rParams, _ ) ->
                    case vs of

                        [] ->
                            Ok ( "1 = 0", [] )

                        _ ->
                            if isJsonRef col && not (allSqlString vs) then
                                Err
                                    <| storeErr
                                           ("values compared with jsonText \""
                                               ++ col
                                               ++ "\" must be SqlString")

                            else
                                Ok
                                    ( rSql ++ " IN (" ++ placeholders vs ++ ")"
                                    , rParams ++ vs
                                    )

        CondAnd cs ->
            renderGroup ctx "1 = 1" " AND " cs

        CondOr cs ->
            renderGroup ctx "1 = 0" " OR " cs

        CondNot inner ->
            case renderCond ctx inner of

                Err e ->
                    Err e

                Ok ( s, p ) ->
                    Ok ( "NOT (" ++ s ++ ")", p )

        CondCol op left right ->
            case refOf ctx left of

                Err e ->
                    Err e

                Ok ( lSql, lParams, lk ) ->
                    case refOf ctx right of

                        Err e ->
                            Err e

                        Ok ( rSql, rParams, rk ) ->
                            if kindBase lk /= kindBase rk then
                                Err
                                    <| storeErr
                                           ("\"" ++ left ++ "\" is "
                                               ++ kindBase lk
                                               ++ " and \""
                                               ++ right
                                               ++ "\" is "
                                               ++ kindBase rk
                                               ++ ": compare columns of one kind")

                            else
                                Ok
                                    ( lSql ++ " " ++ op ++ " " ++ rSql
                                    , lParams ++ rParams
                                    )

        CondText kind col needle ->
            case refOf ctx col of

                Err e ->
                    Err e

                Ok ( rSql, rParams, k ) ->
                    if kindBase k /= "text" then
                        Err
                            <| storeErr
                                   (kind ++ " \"" ++ col ++ "\": the column is "
                                       ++ kindBase k
                                       ++ ", and only text has a case")

                    else
                        Ok (textMatch ctx.dialect kind rSql rParams needle)


-- The text conditions. `%`, `_` and `!` in a needle are escaped with `!`
-- where LIKE is used. SQLite's LIKE ignores ASCII case, so its case-sensitive
-- forms use instr / substr instead.
textMatch : Dialect -> String -> String -> List SqlValue -> String -> ( String, List SqlValue )
textMatch d kind rSql rParams needle =
    if kind == "eqCi" then
        ( "LOWER(" ++ rSql ++ ") = LOWER(?)", rParams ++ [ SqlString needle ] )

    else if needle == "" then
        ( rSql ++ " IS NOT NULL", rParams )

    else if kind == "containsCi" then
        ( "LOWER(" ++ rSql ++ ") LIKE LOWER(?) ESCAPE '!'"
        , rParams ++ [ SqlString ("%" ++ likeEscape needle ++ "%") ]
        )

    else
        case d of

            Postgres ->
                if kind == "contains" then
                    ( rSql ++ " LIKE ? ESCAPE '!'"
                    , rParams ++ [ SqlString ("%" ++ likeEscape needle ++ "%") ]
                    )

                else if kind == "startsWith" then
                    ( rSql ++ " LIKE ? ESCAPE '!'"
                    , rParams ++ [ SqlString (likeEscape needle ++ "%") ]
                    )

                else
                    ( rSql ++ " LIKE ? ESCAPE '!'"
                    , rParams ++ [ SqlString ("%" ++ likeEscape needle) ]
                    )

            Sqlite ->
                if kind == "contains" then
                    ( "instr(" ++ rSql ++ ", ?) > 0"
                    , rParams ++ [ SqlString needle ]
                    )

                else if kind == "startsWith" then
                    ( "substr(" ++ rSql ++ ", 1, length(?)) = ?"
                    , rParams ++ [ SqlString needle, SqlString needle ]
                    )

                else
                    ( "substr(" ++ rSql ++ ", -length(?)) = ?"
                    , rParams ++ [ SqlString needle, SqlString needle ]
                    )


likeEscape : String -> String
likeEscape s =
    String.replace
        "_"
        "!_"
        (String.replace "%" "!%" (String.replace "!" "!!" s))


renderGroup : Ctx -> String -> String -> List Cond -> Result Error ( String, List SqlValue )
renderGroup ctx emptySql sep cs =
    case cs of

        [] ->
            Ok ( emptySql, [] )

        _ ->
            case renderConds ctx cs [] [] of

                Err e ->
                    Err e

                Ok ( parts, params ) ->
                    Ok ( "(" ++ String.join sep parts ++ ")", params )


renderConds : Ctx -> List Cond -> List String -> List SqlValue -> Result Error ( List String, List SqlValue )
renderConds ctx cs parts params =
    case cs of

        [] ->
            Ok ( List.reverse parts, params )

        c :: rest ->
            case renderCond ctx c of

                Err e ->
                    Err e

                Ok ( s, p ) ->
                    renderConds ctx rest (s :: parts) (params ++ p)


placeholders : List SqlValue -> String
placeholders vs =
    case vs of

        [] ->
            ""

        [ _ ] ->
            "?"

        _ :: rest ->
            "?, " ++ placeholders rest


isSqlString : SqlValue -> Bool
isSqlString v =
    case v of

        SqlString _ ->
            True

        _ ->
            False


allSqlString : List SqlValue -> Bool
allSqlString vs =
    case vs of

        [] ->
            True

        v :: rest ->
            isSqlString v && allSqlString rest


isJsonRef : String -> Bool
isJsonRef name =
    String.contains "->>" name


-- Resolve a name to SQL: a store column (field or snake name), a `jsonText`
-- reference, or (in HAVING) an aggregate result field.
refOf : Ctx -> String -> Result Error Ref
refOf ctx name =
    if ctx.having then
        let
            rc = resolveCol ctx.cols name
        in
            case aliasRef rc ctx.aliases of

                Just r ->
                    Ok r

                Nothing ->
                    Err
                        <| storeErr
                               ("having: \"" ++ name
                                   ++ "\" is not a field of the aggregate result — fields are "
                                   ++ colNames ctx.cols)

    else
        case String.split "->>" name of

            [ col, jsonKey ] ->
                jsonRef ctx col jsonKey

            _ ->
                let
                    col = resolveCol ctx.cols name
                in
                    case lookupKind col ctx.cols of

                        Nothing ->
                            Err <| unknownColErr name ctx.cols

                        Just k ->
                            if isIdent col then
                                Ok ( col, [], k )

                            else
                                Err
                                    <| storeErr
                                           ("column \"" ++ col
                                               ++ "\" is not a valid identifier")


aliasRef : String -> List ( String, Ref ) -> Maybe Ref
aliasRef rc aliases =
    case aliases of

        [] ->
            Nothing

        ( a, r ) :: rest ->
            if a == rc then
                Just r

            else
                aliasRef rc rest


jsonRef : Ctx -> String -> String -> Result Error Ref
jsonRef ctx name jsonKey =
    let
        col = resolveCol ctx.cols name
    in
        case lookupKind col ctx.cols of

            Nothing ->
                Err <| unknownColErr name ctx.cols

            Just k ->
                if kindBase k /= "text" && kindBase k /= "blob" then
                    Err
                        <| storeErr
                               ("jsonText \"" ++ name ++ "\": the column is "
                                   ++ kindBase k
                                   ++ ", not a JSON text column")

                else if not (isIdent col) || not (isIdent jsonKey) then
                    Err
                        <| storeErr
                               ("jsonText \"" ++ name ++ "\" \"" ++ jsonKey
                                   ++ "\": the key is not a valid identifier")

                else
                    case ctx.dialect of

                        Postgres ->
                            Ok
                                ( "(CAST(" ++ col ++ " AS jsonb) ->> '"
                                      ++ jsonKey
                                      ++ "')"
                                , noParams
                                , "text?"
                                )

                        Sqlite ->
                            -- json_type first, so a JSON boolean reads 'true' /
                            -- 'false' as it does through PostgreSQL's ->>.
                            let
                                path = "'$." ++ jsonKey ++ "'"
                            in
                                Ok
                                    ( "(CASE json_type(" ++ col ++ ", " ++ path
                                          ++ ") WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' ELSE CAST(json_extract("
                                          ++ col
                                          ++ ", "
                                          ++ path
                                          ++ ") AS TEXT) END)"
                                    , noParams
                                    , "text?"
                                    )


refList : Ctx -> List String -> List String -> Result Error (List String)
refList ctx names acc =
    case names of

        [] ->
            Ok (List.reverse acc)

        n :: rest ->
            case refOf ctx n of

                Err e ->
                    Err e

                Ok ( rSql, _, _ ) ->
                    refList ctx rest (rSql :: acc)


-- ── Writes ───────────────────────────────────────────────────────────────────
writeWhere : Dialect -> String -> String -> List ( String, String ) -> List String -> Cond -> Result Error ( String, List SqlValue )
writeWhere d name pk cols problems cond =
    case storeError name pk cols problems of

        Just e ->
            Err e

        Nothing ->
            renderCond (plainCtx d cols) cond


-- `UPDATE t SET c = ? …` (or `c = c + ?` for `adjust`) `WHERE …`.
prepareSet : Dialect -> String -> String -> List ( String, String ) -> List String -> Cond -> Bool -> List ( String, SqlValue ) -> Result Error ( String, List SqlValue )
prepareSet d name pk cols problems cond relative sets =
    case writeWhere d name pk cols problems cond of

        Err e ->
            Err e

        Ok ( whereSql, whereParams ) ->
            case setItems cols relative sets [] [] of

                Err e ->
                    Err e

                Ok ( items, setParams ) ->
                    Ok
                        ( "UPDATE " ++ name ++ " SET " ++ String.join ", " items
                              ++ " WHERE "
                              ++ whereSql
                        , setParams ++ whereParams
                        )


setItems : List ( String, String ) -> Bool -> List ( String, SqlValue ) -> List String -> List SqlValue -> Result Error ( List String, List SqlValue )
setItems cols relative sets items params =
    case sets of

        [] ->
            Ok ( List.reverse items, List.reverse params )

        ( field, v ) :: rest ->
            let
                col = resolveCol cols field
            in
                case lookupKind col cols of

                    Nothing ->
                        Err <| unknownColErr field cols

                    Just _ ->
                        if not (isIdent col) then
                            Err
                                <| storeErr
                                       ("column \"" ++ col
                                           ++ "\" is not a valid identifier")

                        else if relative then
                            setItems
                                cols
                                relative
                                rest
                                ((col ++ " = " ++ col ++ " + ?") :: items)
                                (v :: params)

                        else
                            setItems
                                cols
                                relative
                                rest
                                ((col ++ " = ?") :: items)
                                (v :: params)


-- ── Names ────────────────────────────────────────────────────────────────────
-- The store check every verb runs first: the table name follows the identifier
-- rule, the primary key is empty or a column, and no builder recorded a problem.
storeError : String -> String -> List ( String, String ) -> List String -> Maybe Error
storeError name pk cols problems =
    if not (isIdent name) then
        Just
            (Error.invalidInput
                ("Store: invalid table name \"" ++ name
                    ++ "\": use letters, digits and _, not starting with a digit, at most 63 bytes"))

    else if pk /= "" && lookupKind pk cols == Nothing then
        Just
            (Error.invalidInput
                ("Store \"" ++ name ++ "\": primaryKey \"" ++ pk
                    ++ "\" is not a column — columns are "
                    ++ colNames cols))

    else
        case problems of

            p :: _ ->
                Just (Error.invalidInput ("Store \"" ++ name ++ "\": " ++ p))

            [] ->
                Nothing


-- `^[A-Za-z_][A-Za-z0-9_]*$`, at most 63 bytes (PostgreSQL's identifier
-- limit). No reserved-word list: a column named `user` works on SQLite, and a
-- reserved word stays a driver error.
isIdent : String -> Bool
isIdent s =
    case String.toList s of

        [] ->
            False

        c :: rest ->
            String.length s <= 63 && isIdentStart (Char.toCode c)
                && identRest rest


identRest : List Char -> Bool
identRest cs =
    case cs of

        [] ->
            True

        c :: rest ->
            let
                n = Char.toCode c
            in
                (isIdentStart n || (n >= 48 && n <= 57)) && identRest rest


isIdentStart : Int -> Bool
isIdentStart n =
    n == 95 || (n >= 65 && n <= 90) || (n >= 97 && n <= 122)


quoteAlias : String -> String
quoteAlias a =
    "\"" ++ a ++ "\""


-- A typed empty parameter list. A bare `[]` inside a returned tuple lowers
-- with an `any` element and costs a narrowing at the return.
noParams : List SqlValue
noParams =
    []


storeErr : String -> Error
storeErr msg =
    Error.invalidInput ("Store: " ++ msg)


unknownColErr : String -> List ( String, String ) -> Error
unknownColErr name cols =
    (Error.invalidInput
        ("Store: unknown column \"" ++ name ++ "\" — columns are "
            ++ colNames cols))


colNames : List ( String, String ) -> String
colNames cols =
    String.join ", " (colNamesList cols)


colNamesList : List ( String, String ) -> List String
colNamesList cols =
    case cols of

        [] ->
            []

        ( c, _ ) :: rest ->
            c :: colNamesList rest


-- | camelCase → snake_case. Delegates to the SAME runtime routine that derives
-- `Codec.auto` columns, so a filter written with the RECORD FIELD name
-- (`"priceMinor"`) resolves to exactly its snake column (`"price_minor"`).
snakeName : String -> String
snakeName =
    Ffi.kernel "Db_snakeName"


lookupKind : String -> List ( String, String ) -> Maybe String
lookupKind col cols =
    case cols of

        [] ->
            Nothing

        ( c, k ) :: rest ->
            if c == col then
                Just k

            else
                lookupKind col rest


-- | Resolve a name to a store column: use it verbatim when it IS a column,
-- else fall back to its snake_case form (so `"priceMinor"` finds `"price_minor"`),
-- else return it unchanged so the check reports it as unknown.
resolveCol : List ( String, String ) -> String -> String
resolveCol known col =
    case lookupKind col known of

        Just _ ->
            col

        Nothing ->
            let
                snake = snakeName col
            in
                case lookupKind snake known of

                    Just _ ->
                        snake

                    Nothing ->
                        col


-- The base kind of a colspec kind: no `|` flags, no `!`, no `?`.
kindBase : String -> String
kindBase k =
    String.replace "?" "" (String.replace "!" "" (beforeFlags k))


kindNullable : String -> Bool
kindNullable k =
    String.contains "?" (beforeFlags k)


beforeFlags : String -> String
beforeFlags k =
    case String.split "|" k of

        b :: _ ->
            b

        [] ->
            k


-- ── Internal ─────────────────────────────────────────────────────────────────
-- | Drop the named columns from a (col, kind) spec (insert/update omit-lists).
colsExcluding : List String -> List ( String, String ) -> List ( String, String )
colsExcluding excl cols =
    case cols of

        [] ->
            []

        ( c, k ) :: rest ->
            if List.member c excl then
                colsExcluding excl rest

            else
                ( c, k ) :: colsExcluding excl rest


-- | Columns carrying the `touch` flag (Store.touchOnUpdate) — set to `now()` on
-- every UPDATE by the runtime's codecSetClause. The flag is matched exactly: a
-- default value that contains the text "touch" is not the flag.
touchColsOf : List ( String, String ) -> List ( String, String )
touchColsOf cols =
    case cols of

        [] ->
            []

        ( c, k ) :: rest ->
            if List.member "touch" (String.split "|" k) then
                ( c, k ) :: touchColsOf rest

            else
                touchColsOf rest


-- | The SET column-spec for an update: every writable column (PK + `generated`
-- excluded) PLUS the `touch` columns re-added (they live in `generated` so INSERT
-- omits them, but UPDATE bumps them to `now()`).
setColspecOf : String -> List String -> List ( String, String ) -> List ( String, String )
setColspecOf pk gen cols =
    colsExcluding (pk :: gen) cols ++ touchColsOf cols


-- | The declared kind of a column (defaults to "text" when absent).
kindOf : String -> List ( String, String ) -> String
kindOf col cols =
    case lookupKind col cols of

        Just k ->
            k

        Nothing ->
            "text"


dbUpdateByPk : Db -> String -> List ( String, String ) -> String -> String -> Value -> Task Error Int
dbUpdateByPk =
    Ffi.kernel "Db_updateByPk"


dbUpdateWhere : Db -> String -> List ( String, String ) -> Value -> String -> List SqlValue -> Task Error Int
dbUpdateWhere =
    Ffi.kernel "Db_updateWhere"


codecColumns : Codec a -> List ( String, String )
codecColumns codec =
    case Codec.shape codec of

        SRecord cols ->
            colTypeStrs cols

        _ ->
            []


colTypeStrs : List ( String, ColType ) -> List ( String, String )
colTypeStrs cols =
    case cols of

        [] ->
            []

        ( n, ct ) :: rest ->
            ( n, colTypeStr ct ) :: colTypeStrs rest


colTypeStr : ColType -> String
colTypeStr ct =
    case ct of

        CText ->
            "text"

        CInt ->
            "int"

        CReal ->
            "real"

        CBool ->
            "bool"

        CBlob ->
            "blob"

        CNull inner ->
            colTypeStr inner ++ "?"


dbCreateCols : Db -> String -> List ( String, String ) -> String -> Task Error ()
dbCreateCols =
    Ffi.kernel "Db_createCols"


dbAutoMigrate : Db -> String -> List ( String, String ) -> String -> Task Error (List String)
dbAutoMigrate =
    Ffi.kernel "Db_autoMigrate"


dbExecObjectMany : Db -> String -> List ( String, String ) -> List Value -> Task Error Int
dbExecObjectMany =
    Ffi.kernel "Db_execObjectMany"


dbUpsertObject : Db -> String -> List ( String, String ) -> String -> Value -> String -> Task Error Int
dbUpsertObject =
    Ffi.kernel "Db_upsertObject"


dbExecObjectWith : Db -> String -> List ( String, String ) -> Value -> List ( String, SqlValue ) -> String -> String -> Task Error Int
dbExecObjectWith =
    Ffi.kernel "Db_execObjectWith"


dbQueryObjectsV : Db -> String -> List SqlValue -> List ( String, String ) -> Task Error (List String)
dbQueryObjectsV =
    Ffi.kernel "Db_queryObjects"


dbExecV : Db -> String -> List SqlValue -> Task Error Int
dbExecV =
    Ffi.kernel "Db_exec"


dbDialect : Db -> String
dbDialect =
    Ffi.kernel "Db_dialect"
