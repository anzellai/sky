-- | Std.Db.Store — codec-driven persistence (Layer 3 Sky source).
--
-- A `Store a` is a table defined by ONE `Codec a` (Std.Codec): the codec drives
-- the schema (columns from its shape), the writes (record → columns), and the
-- reads (columns → record) — and the SAME codec serves JSON. No separate
-- decoder, no `SqlValue` lists.
--
-- Top-level scalar fields become typed columns; anything the codec marks as a
-- blob (ADT / tuple / list / nested record) is stored as a JSON TEXT column.
--
-- ```elm
-- import Std.Codec as Codec exposing (Codec)
-- import Std.Db.Store as Store exposing (Store)
--
-- userCodec : Codec User
-- userCodec = Codec.object User |> Codec.field "id" .id Codec.string |> ... |> Codec.buildObject
--
-- users : Store User
-- users = Store.fromCodec "users" userCodec |> Store.primaryKey "id"
--
-- -- Store.create conn users
-- -- Store.insert conn users user      : Task Error Int
-- -- Store.all conn users              : Task Error (List User)
-- -- Store.findBy conn users "id" "u1" : Task Error (Maybe User)
-- ```
module Std.Db.Store exposing
    ( Store
    , fromCodec
    , primaryKey
    , create
    , migrate
    , insert
    , all
    , select
    , findBy
    , delete
    , Table
    , toTable
    , Project
    , project
    , dumpSchema
    , pushProject
    , Query
    , query
    , eq
    , neq
    , gt
    , gte
    , lt
    , lte
    , like
    , isNull
    , notNull
    , inList
    , orderAsc
    , orderDesc
    , limit
    , offset
    , toList
    , toMaybe
    , count
    , transaction
    )

import Sky.Ffi as Ffi
import Sky.Core.Error exposing (Error)
import Sky.Core.Task as Task
import Sky.Core.List as List
import Sky.Core.String as String
import Sky.Core.Json.Encode exposing (Value)
import Std.Codec as Codec exposing (Codec, ColType(..), Shape(..))
import Std.Db as Db exposing (SqlValue)

type Store a
    = Store { name : String
, codec : Codec a
, pk : String
, cols : List ( String, String )
}


-- | Define a store from a table name and its codec. The columns are derived
-- from the codec's record shape.
fromCodec : String -> Codec a -> Store a
fromCodec name codec =
    Store { name = name, codec = codec, pk = "", cols = codecColumns codec }


-- | Mark the primary-key column (NOT NULL; used by `findBy`/`delete` defaults).
primaryKey : String -> Store a -> Store a
primaryKey pk (Store s) =
    Store { s | pk = pk }


-- | Create the table (dialect-correct DDL derived from the codec).
create : Db -> Store a -> Task Error ()
create conn (Store s) =
    dbCreateCols conn s.name s.cols s.pk


-- | Safe additive migration: create the table if absent, and ADD any columns
-- the record type has gained (nullable). Never drops, renames, or retypes a
-- column — those stay manual (see docs/v0.19/auto-migration-architecture.md).
-- Idempotent; returns the SQL statements it applied (empty when up to date).
migrate : Db -> Store a -> Task Error (List String)
migrate conn (Store s) =
    dbAutoMigrate conn s.name s.cols s.pk


-- | Insert a record.
insert : Db -> Store a -> a -> Task Error Int
insert conn (Store s) record =
    dbExecObject conn s.name s.cols (Codec.toValue s.codec record)


-- | Every row, decoded via the codec.
all : Db -> Store a -> Task Error (List a)
all conn store =
    selectTail conn store ""


-- | Rows matching a raw SQL tail (WHERE / ORDER BY / LIMIT), decoded.
select : Db -> Store a -> String -> Task Error (List a)
select conn store tail =
    selectTail conn store tail


selectTail : Db -> Store a -> String -> Task Error (List a)
selectTail conn (Store s) tail =
    let
        sql =
            if tail == "" then
                "SELECT * FROM " ++ s.name

            else
                "SELECT * FROM " ++ s.name ++ " " ++ tail
    in
        dbQueryObjects conn sql emptyParams s.cols
            |> Task.andThen (decodeRows s.codec)


-- | The single row where `col = value` (value bound as text), or Nothing.
findBy : Db -> Store a -> String -> String -> Task Error (Maybe a)
findBy conn (Store s) col value =
    dbQueryObjects
        conn
        ("SELECT * FROM " ++ s.name ++ " WHERE " ++ col ++ " = ? LIMIT 1")
        [ value ]
        s.cols
        |> Task.andThen (decodeRows s.codec)
        |> Task.map List.head


-- | Delete rows where `col = value`.
delete : Db -> Store a -> String -> String -> Task Error Int
delete conn (Store s) col value =
    dbExecRawParams
        conn
        ("DELETE FROM " ++ s.name ++ " WHERE " ++ col ++ " = ?")
        [ value ]

-- ── Project (schema-dump for file-based migrations) ─────────────────────────
-- | A table's schema erased of its record type — name, primary key, and
-- (column, kind) list — for the migration schema-dump.
type alias Table =
    { name : String
    , pk : String
    , cols : List ( String, String )
    }


-- | Erase a store to its `Table` schema.
toTable : Store a -> Table
toTable (Store s) =
    { name = s.name, pk = s.pk, cols = s.cols }

-- | A project's set of tables — the single declaration `sky db` reads to derive
-- the target schema: `db = Store.project [ Store.toTable users, Store.toTable orders ]`.
type Project
    = Project (List Table)


-- | Build a `Project` from a list of erased tables (via `toTable`). Expose the
-- result as `db : Store.Project` from your entry module for `sky db migrate --gen`.
project : List Table -> Project
project tables =
    Project tables


-- | Print the project's schema as JSON (between SKY_SCHEMA_* markers) and exit —
-- the pure, DB-free schema-dump that `sky db migrate --gen` captures to diff
-- against `db/schema.json`. Make this a project's `main` in the gen entry.
dumpSchema : Project -> Task Error ()
dumpSchema (Project tables) =
    dbDumpProject tables


dbDumpProject : List Table -> Task Error ()
dbDumpProject =
    Ffi.kernel "Db_dumpProject"


-- | Push the whole project's schema to the live DB — create each missing table
-- and ADD any new columns (nullable), for every store. The no-migration-files
-- "make my dev DB match my types" path (`sky db push`); production uses the
-- committed `db/migrations/` files via `sky db migrate`. Returns the SQL applied.
pushProject : Db -> Project -> Task Error (List String)
pushProject conn (Project tables) =
    pushTables conn tables


pushTables : Db -> List Table -> Task Error (List String)
pushTables conn tables =
    case tables of

        [] ->
            Task.succeed []

        t :: rest ->
            dbAutoMigrate conn t.name t.cols t.pk
                |> Task.andThen
                       (\applied ->
                           Task.map
                               (\more -> applied ++ more)
                               (pushTables conn rest))

-- ── Query builder (compose filters + ordering + paging, no raw SQL) ──────────
-- A `Query a` accumulates parameterised WHERE conditions + ORDER BY + LIMIT +
-- OFFSET over a `Store a`; a terminal (`toList` / `toMaybe` / `count`) runs it.
-- Every filter VALUE binds as a `SqlValue` param — injection-safe. Drop to
-- `Std.Db.query` only for joins / aggregates the builder doesn't model.
type Cond
    = CondOp String String SqlValue
    | CondNull String Bool
    | CondIn String (List SqlValue)

type OrderTerm
    = OrderTerm String String

-- | An in-progress query over a store. Build with the filter / order / paging
-- combinators below, then run a terminal (`toList` / `toMaybe` / `count`).
type Query a
    = Query { store : Store a
, conds : List Cond
, orders : List OrderTerm
, limitN : Maybe Int
, offsetN : Maybe Int
}


-- | Start a query over a store:
-- `Store.query products |> Store.eq "active" (SqlBool True) |> Store.toList conn`.
query : Store a -> Query a
query store =
    Query
        { store = store
        , conds = []
        , orders = []
        , limitN = Nothing
        , offsetN = Nothing
        }


addCond : Cond -> Query a -> Query a
addCond c (Query q) =
    Query
        { store = q.store
        , conds = c :: q.conds
        , orders = q.orders
        , limitN = q.limitN
        , offsetN = q.offsetN
        }


-- | Filter `col = value` (AND-combined with the other filters).
eq : String -> SqlValue -> Query a -> Query a
eq col v =
    addCond (CondOp col "=" v)


-- | Filter `col <> value`.
neq : String -> SqlValue -> Query a -> Query a
neq col v =
    addCond (CondOp col "<>" v)


-- | Filter `col > value`.
gt : String -> SqlValue -> Query a -> Query a
gt col v =
    addCond (CondOp col ">" v)


-- | Filter `col >= value`.
gte : String -> SqlValue -> Query a -> Query a
gte col v =
    addCond (CondOp col ">=" v)


-- | Filter `col < value`.
lt : String -> SqlValue -> Query a -> Query a
lt col v =
    addCond (CondOp col "<" v)


-- | Filter `col <= value`.
lte : String -> SqlValue -> Query a -> Query a
lte col v =
    addCond (CondOp col "<=" v)


-- | Filter `col LIKE pattern` (use `%` / `_` wildcards in the pattern).
like : String -> String -> Query a -> Query a
like col pat =
    addCond (CondOp col "LIKE" (Db.SqlString pat))


-- | Filter `col IS NULL`.
isNull : String -> Query a -> Query a
isNull col =
    addCond (CondNull col True)


-- | Filter `col IS NOT NULL`.
notNull : String -> Query a -> Query a
notNull col =
    addCond (CondNull col False)


-- | Filter `col IN (v1, v2, …)`. An empty list matches nothing.
inList : String -> List SqlValue -> Query a -> Query a
inList col vs =
    addCond (CondIn col vs)


-- | Append `ORDER BY col ASC` (chain for multi-column ordering).
orderAsc : String -> Query a -> Query a
orderAsc col (Query q) =
    Query
        { store = q.store
        , conds = q.conds
        , orders = OrderTerm col "ASC" :: q.orders
        , limitN = q.limitN
        , offsetN = q.offsetN
        }


-- | Append `ORDER BY col DESC`.
orderDesc : String -> Query a -> Query a
orderDesc col (Query q) =
    Query
        { store = q.store
        , conds = q.conds
        , orders = OrderTerm col "DESC" :: q.orders
        , limitN = q.limitN
        , offsetN = q.offsetN
        }


-- | `LIMIT n`.
limit : Int -> Query a -> Query a
limit n (Query q) =
    Query { q | limitN = Just n }


-- | `OFFSET n` (pair with `limit` for paging).
offset : Int -> Query a -> Query a
offset n (Query q) =
    Query { q | offsetN = Just n }


-- | Run the query, decoding every matching row via the store's codec.
toList : Db -> Query a -> Task Error (List a)
toList conn (Query q) =
    case q.store of

        Store s ->
            let
                ( whereTail, params ) = buildWhere q.conds
                sql =
                    "SELECT * FROM " ++ s.name ++ whereTail
                        ++ orderTail q.orders
                        ++ pageTail q.limitN q.offsetN
            in
                dbQueryObjects conn sql params s.cols
                    |> Task.andThen (decodeRows s.codec)


-- | Run the query with `LIMIT 1`, returning the first matching row or `Nothing`.
toMaybe : Db -> Query a -> Task Error (Maybe a)
toMaybe conn q =
    toList conn (limit 1 q) |> Task.map List.head


-- | Count matching rows via `SELECT COUNT(*)` (filters apply; order/paging ignored).
count : Db -> Query a -> Task Error Int
count conn (Query q) =
    case q.store of

        Store s ->
            let
                ( whereTail, params ) = buildWhere q.conds
            in
                Db.query
                    conn
                    ("SELECT COUNT(*) AS n FROM " ++ s.name ++ whereTail)
                    params
                    |> Task.map
                           (\rows ->
                               case rows of

                                   row :: _ ->
                                       Db.getInt "n" row

                                   [] ->
                                       0)


-- | Run a callback inside a DB transaction — Store operations compose by taking
-- the `tx` handle. Alias over `Db.withTransaction`, so read / write / transact
-- all stay in the `Store.*` namespace.
transaction : Db -> (Db -> Task Error a) -> Task Error a
transaction conn f =
    Db.withTransaction conn f


buildWhere : List Cond -> ( String, List SqlValue )
buildWhere conds =
    case conds of

        [] ->
            ( "", [] )

        _ ->
            let
                parts = List.map condSql conds
            in
                ( " WHERE "
                      ++ String.join " AND " (List.map (\( c, _ ) -> c) parts)
                , List.concat (List.map (\( _, p ) -> p) parts)
                )


condSql : Cond -> ( String, List SqlValue )
condSql c =
    case c of

        CondOp col op v ->
            ( col ++ " " ++ op ++ " ?", [ v ] )

        CondNull col wantNull ->
            ( col
                  ++ (if wantNull then
                         " IS NULL"

                     else
                         " IS NOT NULL")
            , []
            )

        CondIn col vs ->
            case vs of

                [] ->
                    ( "1 = 0", [] )

                _ ->
                    ( col ++ " IN ("
                          ++ String.join ", " (List.map (\_ -> "?") vs)
                          ++ ")"
                    , vs
                    )


orderTail : List OrderTerm -> String
orderTail orders =
    case orders of

        [] ->
            ""

        _ ->
            " ORDER BY "
                ++ String.join
                       ", "
                       (List.map
                           (\(OrderTerm col dir) -> col ++ " " ++ dir)
                           orders)


pageTail : Maybe Int -> Maybe Int -> String
pageTail limitN offsetN =
    let
        lim =
            case limitN of

                Just n ->
                    " LIMIT " ++ String.fromInt n

                Nothing ->
                    ""
        off =
            case offsetN of

                Just n ->
                    " OFFSET " ++ String.fromInt n

                Nothing ->
                    ""
    in
        lim ++ off


-- ── Internal ─────────────────────────────────────────────────────────────────
emptyParams : List String
emptyParams =
    []


decodeRows : Codec a -> List String -> Task Error (List a)
decodeRows codec rows =
    case rows of

        [] ->
            Task.succeed []

        j :: rest ->
            case Codec.fromJson codec j of

                Ok x ->
                    Task.map (\xs -> x :: xs) (decodeRows codec rest)

                Err e ->
                    Task.fail e


codecColumns : Codec a -> List ( String, String )
codecColumns codec =
    case Codec.shape codec of

        SRecord cols ->
            List.map (\( n, ct ) -> ( n, colTypeStr ct )) cols

        _ ->
            []


colTypeStr : ColType -> String
colTypeStr ct =
    case ct of

        CText ->
            "text"

        CInt ->
            "int"

        CReal ->
            "real"

        CBool ->
            "bool"

        CBlob ->
            "blob"

        CNull inner ->
            colTypeStr inner ++ "?"


dbCreateCols : Db -> String -> List ( String, String ) -> String -> Task Error ()
dbCreateCols =
    Ffi.kernel "Db_createCols"


dbAutoMigrate : Db -> String -> List ( String, String ) -> String -> Task Error (List String)
dbAutoMigrate =
    Ffi.kernel "Db_autoMigrate"


dbExecObject : Db -> String -> List ( String, String ) -> Value -> Task Error Int
dbExecObject =
    Ffi.kernel "Db_execObject"


dbQueryObjects : Db -> String -> List p -> List ( String, String ) -> Task Error (List String)
dbQueryObjects =
    Ffi.kernel "Db_queryObjects"


dbExecRawParams : Db -> String -> List p -> Task Error Int
dbExecRawParams =
    Ffi.kernel "Db_exec"
