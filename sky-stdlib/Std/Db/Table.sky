-- | Std.Db.Table — a reflection-based record↔row mapper (Layer 3 Sky source).
--
-- ONE `Table a` value per table is the single source of truth: it drives the
-- DDL, typed reads, and typed writes — no separate decoder, no `SqlValue`
-- lists. The record type declares the columns (field names + types); the
-- runtime reflects the Go struct it lowers to. Field ↔ column is
-- camelCase ↔ snake_case; type ↔ column is String→TEXT, Int→BIGINT,
-- Float→REAL, Bool→bool, `Maybe a`→nullable.
--
-- The boundary (the sqlx split): `Table` owns the record↔row MAPPING; SQL stays
-- SQL. `select` takes a raw WHERE/ORDER/JOIN/LIMIT tail, and joins decode into
-- any record whose fields match the projection. No relations / eager-loading.
--
-- ```elm
-- import Std.Db.Table as T exposing (Table)
--
-- type alias Product =
--     { id : String, slug : String, priceMinor : Int, active : Bool }
--
-- blankProduct : Product
-- blankProduct = { id = "", slug = "", priceMinor = 0, active = False }
--
-- products : Table Product
-- products =
--     T.table "products" blankProduct
--         |> T.primaryKey "id"
--         |> T.unique "slug"
--
-- -- setup:  T.createTable conn products
-- -- read:   T.all conn products                    : Task Error (List Product)
-- --         T.select conn products "WHERE active = ? ORDER BY slug" [ SqlBool True ]
-- --         T.findBy conn products "slug" "widget"  : Task Error (Maybe Product)
-- -- write:  T.insert conn products p
-- --         T.update conn products "id" p.id p
-- --         T.delete conn products "id" p.id
-- ```
module Std.Db.Table exposing
    ( Table
    , table
    , primaryKey
    , unique
    , index
    , enum
    , codec
    , createTable
    , all
    , select
    , findBy
    , insert
    , update
    , delete
    )

import Sky.Ffi as Ffi
import Sky.Core.Error exposing (Error)

-- | A typed table mapping, parameterised by its record type.
type Table a
    = Table_OPAQUE


-- | Define a table from a record type. The second argument is a zero-value
-- witness — a `blank` record — that hands the runtime the record's shape.
table : String -> a -> Table a
table =
    Ffi.kernel "Table_table"


-- | Mark the primary-key column.
primaryKey : String -> Table a -> Table a
primaryKey =
    Ffi.kernel "Table_primaryKey"


-- | Add a UNIQUE constraint on a column.
unique : String -> Table a -> Table a
unique =
    Ffi.kernel "Table_unique"


-- | Add a secondary index on a column.
index : String -> Table a -> Table a
index =
    Ffi.kernel "Table_index"


-- | Map a nullary-enum column to/from a stored TEXT name, as (value, name)
-- pairs: `enum "status" [ ( Pending, "pending" ), ( Paid, "paid" ) ]`. Explicit
-- names are stable across constructor reordering (unlike an ordinal). For
-- data-carrying variants or non-enum types, use `codec` instead.
enum : String -> List ( v, String ) -> Table a -> Table a
enum =
    Ffi.kernel "Table_enum"


-- | Custom column codec for any field type — encode to a String, decode back.
-- `codec "meta" encodeMeta decodeMeta`. The runtime calls your functions.
codec : String -> (v -> String) -> (String -> v) -> Table a -> Table a
codec =
    Ffi.kernel "Table_codec"


-- | Create the table — dialect-correct DDL derived from the record + the
-- constraints (idempotent, CREATE TABLE / INDEX IF NOT EXISTS).
createTable : Db -> Table a -> Task Error ()
createTable =
    Ffi.kernel "Table_create"


-- | Every row, decoded into records.
all : Db -> Table a -> Task Error (List a)
all =
    Ffi.kernel "Table_all"


-- | Rows matching a raw SQL tail (WHERE / ORDER BY / JOIN / LIMIT) + params.
-- The tail is appended to `SELECT * FROM <table>`.
select : Db -> Table a -> String -> List p -> Task Error (List a)
select =
    Ffi.kernel "Table_select"


-- | The single row where `col = value`, or Nothing.
findBy : Db -> Table a -> String -> p -> Task Error (Maybe a)
findBy =
    Ffi.kernel "Table_findBy"


-- | Insert a record (all columns).
insert : Db -> Table a -> a -> Task Error Int
insert =
    Ffi.kernel "Table_insert"


-- | Update a record by its key column: `update conn t "id" p.id p`.
update : Db -> Table a -> String -> p -> a -> Task Error Int
update =
    Ffi.kernel "Table_update"


-- | Delete the rows where `col = value`.
delete : Db -> Table a -> String -> p -> Task Error Int
delete =
    Ffi.kernel "Table_delete"
