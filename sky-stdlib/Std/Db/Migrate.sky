-- | Std.Db.Migrate — apply dialect-neutral typed migrations (Layer 3 Sky).
--
-- A migration is a JSON `{id, ops}` (the format committed in `db/migrations/`).
-- `migrateOps` renders each op to dialect-correct SQL and applies it through the
-- checksummed `_sky_migrations` ledger (the same engine `Db.migrate` uses), so
-- one migration file is correct on SQLite AND Postgres, applied at most once.
--
-- Ops: `createTable`, `addColumn`, `dropColumn`, `renameColumn`, `addIndex`,
-- `dropIndex`, `raw`. Generated by `sky db migrate --gen`; applied by
-- `sky db migrate` (or `sky run --db-migrate`).
module Std.Db.Migrate exposing (migrateOps, renderMigrations)

import Sky.Ffi as Ffi
import Sky.Core.Error exposing (Error)
import Sky.Core.Task as Task


-- | Apply a JSON array of `{id, ops}` migrations. Returns the ids applied this
-- run (already-applied ones are skipped by the ledger).
migrateOps : Db -> String -> Task Error (List String)
migrateOps conn json =
    Task.andThen (migrateApply conn) (renderMigrations conn json)


-- | Render a migration JSON into `(id, sql)` pairs (dialect-correct for the
-- connection), without applying — for inspection (`sky db migrate --sql`).
renderMigrations : Db -> String -> Task Error (List ( String, String ))
renderMigrations =
    Ffi.kernel "Db_renderMigrations"


migrateApply : Db -> List ( String, String ) -> Task Error (List String)
migrateApply =
    Ffi.kernel "Db_migrateApply"
