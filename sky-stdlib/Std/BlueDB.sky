module Std.BlueDB exposing
    ( Store
    , open
    , close
    , put
    , get
    , delete
    , has
    , keys
    , scan
    , scanFrom
    , scanValues
    , putValue
    , getValue
    , putIndexed
    , deleteIndexed
    , findByIndex
    , reindex
    , countByIndex
    )

{-| BlueDB — the embedded, durable, group-committed key-value store for a Sky
app's OWN data (see docs/bluedb/). The same engine that backs the Sky.Live
session store, here exposed as a typed KV an app opens and reads/writes directly.

    main =
        BlueDB.open "data/app.blue"
            |> Task.andThen
                (\store ->
                    BlueDB.putValue userCodec store "user:1" alice
                        |> Task.andThen (\_ -> BlueDB.getValue userCodec store "user:1")
                )
            |> Task.run

`open` is idempotent per path within a process (a second open of the same path
returns the SAME handle — never a second engine on one file); open it once and
share the handle.

Values are strings; pair with `Std.Codec` (`putValue` / `getValue`) to store
typed records as JSON — one codec drives both JSON and BlueDB, no drift.
Reliability + throughput: docs/bluedb/durability.md + capacity.md. For the
Sky.Live Model, prefer `Live.autoBlueDB` (persists the Model automatically);
this module is for arbitrary app data beyond the Model.
-}

import Sky.Ffi as Ffi
import Sky.Core.Error exposing (Error)
import Sky.Core.List as List
import Sky.Core.Maybe exposing (Maybe(..))
import Sky.Core.Task as Task
import Std.Codec as Codec exposing (Codec)

-- | An open BlueDB store handle.
type Store
    = Store Int


-- Open / close ----------------------------------------------------------------
openRaw : String -> Task Error Int
openRaw =
    Ffi.kernel "BlueDB_open"


{-| Open (creating if needed) an embedded BlueDB store at `path`. Durable,
crash-safe, group-committed. Open ONCE and share the handle — it is a memoised
connection, like a DB pool. -}
open : String -> Task Error Store
open path =
    Task.map Store (openRaw path)


closeRaw : Int -> Task Error ()
closeRaw =
    Ffi.kernel "BlueDB_close"


{-| Close the store (idempotent); flushes in-flight writes. -}
close : Store -> Task Error ()
close store =
    case store of

        Store raw ->
            closeRaw raw


-- String KV -------------------------------------------------------------------
putRaw : Int -> String -> String -> Task Error ()
putRaw =
    Ffi.kernel "BlueDB_put"


{-| Durably store a string `value` under `key` (returns after fsync). -}
put : Store -> String -> String -> Task Error ()
put store key value =
    case store of

        Store raw ->
            putRaw raw key value


getRaw : Int -> String -> Task Error (Maybe String)
getRaw =
    Ffi.kernel "BlueDB_get"


{-| Look up `key`: `Just value` on hit, `Nothing` if absent. -}
get : Store -> String -> Task Error (Maybe String)
get store key =
    case store of

        Store raw ->
            getRaw raw key


deleteRaw : Int -> String -> Task Error ()
deleteRaw =
    Ffi.kernel "BlueDB_delete"


{-| Durably remove `key`. -}
delete : Store -> String -> Task Error ()
delete store key =
    case store of

        Store raw ->
            deleteRaw raw key


hasRaw : Int -> String -> Task Error Bool
hasRaw =
    Ffi.kernel "BlueDB_has"


{-| Whether `key` is present. -}
has : Store -> String -> Task Error Bool
has store key =
    case store of

        Store raw ->
            hasRaw raw key


keysRaw : Int -> Task Error (List String)
keysRaw =
    Ffi.kernel "BlueDB_keys"


{-| Every key in the store (unordered snapshot). For a large store prefer a
key-prefix convention + your own filter over this full scan. -}
keys : Store -> Task Error (List String)
keys store =
    case store of

        Store raw ->
            keysRaw raw


-- Prefix scan (admin queries) -------------------------------------------------
scanRaw : Int -> String -> String -> Int -> Task Error (List ( String, String ))
scanRaw =
    Ffi.kernel "BlueDB_scan"


{-| Scan the key/value pairs whose key starts with `prefix`, in ASCENDING key
order, up to `limit` pairs (`limit <= 0` = no cap — only for small keyspaces).
Deterministic + bounded — the admin-query primitive. Namespace your keys
("user:1", "order:…") so a scan touches only what you want; this walks + sorts
the matching set in the running process (consistent snapshot, no torn read).

To PAGINATE, pass the last key you saw to `scanFrom` as the cursor. -}
scan : Store -> String -> Int -> Task Error (List ( String, String ))
scan store prefix limit =
    scanFrom store prefix "" limit


{-| `scan` with a cursor: returns pairs with key `> startAfter` (exclusive).
Page by feeding the last key of one page as the next `startAfter`. -}
scanFrom : Store -> String -> String -> Int -> Task Error (List ( String, String ))
scanFrom store prefix startAfter limit =
    case store of

        Store raw ->
            scanRaw raw prefix startAfter limit


{-| Typed prefix scan: decode each value via its `Codec`, keeping the key. A
value present but not decodable FAILS the task (schema drift surfaces rather
than silently dropping). Bounded by `limit`; paginate with `scan`/`scanFrom`
on the raw keys when you need cursors. -}
scanValues : Codec a -> Store -> String -> Int -> Task Error (List ( String, a ))
scanValues codec store prefix limit =
    scan store prefix limit
        |> Task.andThen
               (\pairs -> Task.sequence (List.map (decodePair codec) pairs))


decodePair : Codec a -> ( String, String ) -> Task Error ( String, a )
decodePair codec pair =
    case pair of

        ( key, raw ) ->
            case Codec.fromJson codec raw of

                Ok v ->
                    Task.succeed ( key, v )

                Err e ->
                    Task.fail e


-- Typed via Codec -------------------------------------------------------------
{-| Store a TYPED value via its `Codec` (encoded to JSON) — the seamless typed
put. Pair with `getValue`. -}
putValue : Codec a -> Store -> String -> a -> Task Error ()
putValue codec store key value =
    put store key (Codec.toJson codec value)


{-| Get + decode a typed value via its `Codec`. `Just v` on hit, `Nothing` when
the key is ABSENT. If the stored JSON is present but doesn't decode (schema
drift / corruption), this FAILS with the decode error rather than returning
`Nothing` — so a mismatch surfaces instead of masquerading as a miss (which,
paired with a "read → if Nothing, write default" idiom, would silently destroy
the old value). -}
getValue : Codec a -> Store -> String -> Task Error (Maybe a)
getValue codec store key =
    get store key
        |> Task.andThen
               (\m ->
                   case m of

                       Nothing ->
                           Task.succeed Nothing

                       Just s ->
                           case Codec.fromJson codec s of

                               Ok v ->
                                   Task.succeed (Just v)

                               Err e ->
                                   Task.fail e)


-- Secondary indexes (E2) -------------------------------------------------------
-- Opt-in per field. Maintained atomically with the primary (one WriteBatch), so
-- index + record never diverge across a crash. NON-unique (pk-in-key): findByIndex
-- returns every pk whose <field> == <value>. Higher layers (Std.Persist) compute
-- the pk / recordJson (via Codec) / (field,value) pairs and call these.
putIndexedRaw : Int -> String -> String -> List ( String, String ) -> Task Error ()
putIndexedRaw =
    Ffi.kernel "BlueDB_putIndexed"


{-| Upsert a record AND maintain its declared index entries in ONE atomic batch.
`pk` = the primary key; `recordJson` = the codec-encoded record; `fieldValues` =
`(indexField, value)` pairs (value = the field's key-string). -}
putIndexed : Store -> String -> String -> List ( String, String ) -> Task Error ()
putIndexed store pk recordJson fieldValues =
    case store of

        Store raw ->
            putIndexedRaw raw pk recordJson fieldValues


deleteIndexedRaw : Int -> String -> List String -> Task Error ()
deleteIndexedRaw =
    Ffi.kernel "BlueDB_deleteIndexed"


{-| Delete a record AND its index entries (for the given index fields) atomically. -}
deleteIndexed : Store -> String -> List String -> Task Error ()
deleteIndexed store pk indexFields =
    case store of

        Store raw ->
            deleteIndexedRaw raw pk indexFields


findByIndexRaw : Int -> String -> String -> Task Error (List String)
findByIndexRaw =
    Ffi.kernel "BlueDB_findByIndex"


{-| The primary keys whose indexed `field` equals `value` (two O(1)-ish lookups
away from the records). Non-unique: may return several. -}
findByIndex : Store -> String -> String -> Task Error (List String)
findByIndex store field value =
    case store of

        Store raw ->
            findByIndexRaw raw field value


reindexRaw : Int -> List String -> Task Error Int
reindexRaw =
    Ffi.kernel "BlueDB_reindex"


{-| Idempotent backfill of the declared index fields over existing records (call
at startup). Manifest-guarded — O(1) when the declared set is unchanged. Returns
the number of records (re)indexed. -}
reindex : Store -> List String -> Task Error Int
reindex store indexFields =
    case store of

        Store raw ->
            reindexRaw raw indexFields


countByIndexRaw : Int -> String -> String -> Task Error Int
countByIndexRaw =
    Ffi.kernel "BlueDB_countByIndex"


{-| Count the records whose indexed `field` equals `value` — counts index entries
(no record fetch). Exact as-of-snapshot. An O(N)-scan analytics op (cold path), not
a hot-path point read. -}
countByIndex : Store -> String -> String -> Task Error Int
countByIndex store field value =
    case store of

        Store raw ->
            countByIndexRaw raw field value
