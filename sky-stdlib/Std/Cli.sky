-- | Std.Cli — one-shot / interactive CLI backend (Layer 3 Sky source).
--
-- **DEPRECATED for direct use — write `Std.App` instead.** `Std.App` composes
-- this module for `--target terminal:cli`: an `App.app` `Std.Ui` view is
-- flattened to text, and an `App.cli` hand-authored `String` view is printed
-- verbatim (this module's `program`, now first-class on `Std.App`). Nothing in
-- user code needs to import `Std.Cli` directly any more — there is no remaining
-- escape hatch. Still functional because `Std.App` uses it. New code: `App.cli`
-- (String view) or `App.app` (Std.Ui) + `App.run`. See docs/skyapp/overview.md.
--
-- A TEA loop for command-line tools: `Cli.config { init, update, view,
-- subscriptions }` produces an opaque `AppConfig`; attach an stdin-line
-- handler with `Cli.withOnLine`. `view` renders a plain `String`. Every
-- binding is an `Ffi.kernel` alias carrying its real HM signature, so the
-- type-checker, LSP hover, and `sky doc` all read this ONE file.
--
-- ```elm
-- main =
--     Cli.program
--         (Cli.config
--             { init = init, update = update, view = view
--             , subscriptions = subscriptions
--             }
--             |> Cli.withOnLine onLine
--         )
--         |> Task.run
-- ```
module Std.Cli exposing
    ( AppConfig
    , program
    , config
    , withOnLine
    , withGuard
    , withDurable
    , readPassword
    )

import Sky.Ffi as Ffi
import Sky.Core.Error exposing (Error)
import Sky.Core.Secret exposing (Secret)

-- | The built Sky.Cli app configuration. Opaque — produced by `config`,
-- refined by `withOnLine`, consumed by `program`.
type AppConfig model msg
    = AppConfig_OPAQUE


-- | Build the app config from the four required fields. `view` renders a
-- plain `String` (polymorphic here so future render backends fit).
config : { init : a -> ( model, Cmd msg )
, update : msg -> model -> ( model, Cmd msg )
, view : model -> render
, subscriptions : model -> Sub msg
} -> AppConfig model msg
config =
    Ffi.kernel "Cli_config"


-- | Run the CLI TEA loop until it exits.
program : AppConfig model msg -> Task Error ()
program =
    Ffi.kernel "Cli_program"


-- | Attach a stdin-line handler — `onLine line` yields a `msg` per line read.
-- The program reads stdin until EOF, then exits once every in-flight
-- `Cmd.perform` has landed. WITHOUT a line handler the program reads no input:
-- it runs `init`, its Cmds and its `Sub.every` timers, and exits 0 when nothing
-- is left to happen.
withOnLine : (String -> msg) -> AppConfig model msg -> AppConfig model msg
withOnLine =
    Ffi.kernel "Cli_withOnLine"


-- | Attach a per-Msg guard — `guard msg model` returns `Err` to reject the
-- message before `update` runs (same contract as `Tui.withGuard` and
-- Sky.Live: a rejected Msg sets `notification` / `notificationType` on the
-- model when it has those fields).
withGuard : (msg -> model -> Result Error ()) -> AppConfig model msg -> AppConfig model msg
withGuard =
    Ffi.kernel "Cli_withGuard"


-- | Attach durable wiring (from `Std.App.withDurable`); the runtime restores the
-- model at start and snapshots it after each update. Polymorphic in the wiring
-- record so this module does not depend on `Std.App`.
withDurable : durable -> AppConfig model msg -> AppConfig model msg
withDurable =
    Ffi.kernel "Cli_withDurable"


-- | Read one line from stdin with terminal echo disabled (passwords never
-- land in scrollback). Returns an opaque `Secret`, so a password read here
-- cannot leak into a log or a `%v`. Feed it to a `Secret`-consuming API
-- (`Http.withBearer`, `Auth.signToken`) directly, or unwrap it with the
-- greppable `Secret.reveal` where a `String` is required (e.g.
-- `Auth.hashPassword (Secret.reveal pw)`). `readPassword ()`.
readPassword : () -> Task Error Secret
readPassword =
    Ffi.kernel "Cli_readPassword"
