{-| Std.Persist — the ONE front door for typed record persistence, over SQL
(`Std.Db.Store`) and the embedded KV (`Std.BlueDB`), on `Std.Codec`.

You define a record ONCE as a `Store` (codec = schema), wrap it in a `Collection`,
connect to a backend, and run the SAME universal verbs — the compiler refuses any
verb the backend can't do (a phantom backend tag, so it's a *compile* error, never
a runtime failure).

    import Std.Persist as Persist
    import Std.Db.Store as Store
    import Std.Codec as Codec

    users : Persist.Collection User
    users =
        Persist.collection
            (Store.fromCodec "users" (Codec.auto blankUser) |> Store.primaryKey "id")

    main =
        Persist.connectRelational ()             -- or connectKeyValue "data/app.blue"
            |> Task.andThen (\conn -> Persist.put conn users alice)

**Universal** (any backend): `get` / `put` / `delete` / `count` / `all` / `create`.
**KV-only**: `scan` (prefix). **Escape hatches**: `sql` → raw `Std.Db`, `kv` → raw
`BlueDB.Store` — for the backend-specific power (joins/aggregates via Store's query
builder; prefix ops) the universal verbs deliberately don't wrap.

The point is the **graduation story**: start embedded on BlueDB, later move the same
CRUD to SQL by changing ONLY the `connect` call — the universal verbs survive, and
anything backend-specific stops compiling at exactly the call sites that need power.
-}

import Sky.Ffi as Ffi
import Sky.Core.Prelude exposing (..)
import Sky.Core.Error as Error exposing (Error)
import Sky.Core.Task as Task
import Sky.Core.List as List
import Sky.Core.String as String
import Sky.Core.Json.Decode as Decode
import Std.Codec as Codec exposing (Codec, Shape(..), colTypeKind, shape)
import Std.Db as Db exposing (Db)
import Std.Db.Store as Store exposing (Store)
import Std.BlueDB as BlueDB
import Std.Sub as Sub exposing (Sub)

-- Backend capability markers (nullary phantom tags).
type Relational
    = Relational

type KeyValue
    = KeyValue

{-| An open connection, tagged by its backend capability. OPAQUE — the only way
to mint one is `connectRelational` / `connectKeyValue`, which pin the phantom, so
the capability guarantee can't be forged at construction. -}
type Conn cap
    = SqlConn Db
    | KvConn BlueDB.Store

{-| A named, codec-typed record set — backend-agnostic. Wraps a full `Store` so
every schema builder (serial / unique / defaults / touchOnUpdate) is reachable. -}
type Collection a
    = Collection { store : Store a
, keyField : String
, indexes : List String
}


{-| Define a collection from a `Store` (built with all its schema builders). The
key field defaults to "id"; override with `key`. -}
collection : Store a -> Collection a
collection store =
    Collection { store = store, keyField = "id", indexes = [] }


{-| Declare a secondary index on a record FIELD (KV backend). Maintained
atomically with the record; enables `findByIndex`/`findAllByIndex`. Call
`reindex` once at startup to backfill existing records. Pure (no I/O). -}
index : String -> Collection a -> Collection a
index field coll =
    case coll of

        Collection c ->
            Collection { c | indexes = c.indexes ++ [ field ] }


indexesOf : Collection a -> List String
indexesOf coll =
    case coll of

        Collection c ->
            c.indexes


{-| Set the record FIELD name that is the primary key (used to derive the KV key
from a record on `put`). Defaults to "id". -}
key : String -> Collection a -> Collection a
key k coll =
    case coll of

        Collection c ->
            Collection { c | keyField = k }


storeOf : Collection a -> Store a
storeOf coll =
    case coll of

        Collection c ->
            c.store


codecOf : Collection a -> Codec a
codecOf coll =
    Store.codecOf (storeOf coll)


-- The collection name — used to namespace the KV keyspace so one BlueDB store
-- holds many isolated collections (records + indexes scoped per collection).
collNameOf : Collection a -> String
collNameOf coll =
    Store.nameOf (storeOf coll)


keyFieldOf : Collection a -> String
keyFieldOf coll =
    case coll of

        Collection c ->
            c.keyField


-- Connect -----------------------------------------------------------------------
{-| Open a relational connection (sqlite/postgres — driver from `[database]` in
sky.toml). The static tag is `Relational` regardless of driver (dialect is a
runtime property of the handle), so capability stays known at compile time. -}
connectRelational : () -> Task Error (Conn Relational)
connectRelational _ =
    Task.map SqlConn (Db.connect ())


{-| Open an embedded key-value connection (a BlueDB store at `path`). -}
connectKeyValue : String -> Task Error (Conn KeyValue)
connectKeyValue path =
    Task.map KvConn (BlueDB.open path)


-- Universal verbs (compile on every backend) -----------------------------------
{-| Read a record by its primary key. -}
get : Conn cap -> Collection a -> String -> Task Error (Maybe a)
get conn coll keyStr =
    case conn of

        SqlConn db ->
            Store.getByKey db (storeOf coll) keyStr

        KvConn store ->
            BlueDB.collGetValue (codecOf coll) store (collNameOf coll) keyStr


{-| Upsert a record (by its self-assigned primary key). For a DB-assigned
(`serial`) key use the raw Store via `sql` + `Store.insert` — an auto-key has no
value to upsert on. -}
put : Conn cap -> Collection a -> a -> Task Error ()
put conn coll record =
    case conn of

        SqlConn db ->
            Store.upsert db (storeOf coll) record
                |> Task.andThen (\_ -> publishSqlPut coll record)

        KvConn store ->
            case persistKeyString (keyFieldOf coll) record of

                Ok pk ->
                    BlueDB.collPut
                        store
                        (collNameOf coll)
                        pk
                        (Codec.toJson (codecOf coll) record)
                        (indexFieldValues coll record)
                        (Store.colsOf (storeOf coll))
                        |> Task.andThen (\_ -> publishSqlPut coll record)

                Err e ->
                    Task.fail e


{-| Insert a record, returning it with DB-generated fields FILLED — a serial
(auto-increment) primary key and any `defaultNow` timestamps. Use this when the
PK is DB-assigned (`Store.serial`): `put` upserts by a self-assigned key, so it
has no id to return. On SQL uses the auto-assigned rowid; on KV assigns the next
per-collection serial id + stamps defaults, decoding the stored record back. -}
insert : Conn cap -> Collection a -> a -> Task Error a
insert conn coll record =
    case conn of

        SqlConn db ->
            Store.insert db (storeOf coll) record
                |> Task.andThen
                       (\rowid ->
                           Store.getByKey
                               db
                               (storeOf coll)
                               (String.fromInt rowid)
                               |> Task.andThen
                                      (\m ->
                                          case m of

                                              Just r ->
                                                  publishSqlPut coll r
                                                      |> Task.map (\_ -> r)

                                              Nothing ->
                                                  Task.fail
                                                      (Error.unexpected
                                                          "Persist.insert: inserted row not found")))

        KvConn store ->
            case persistKeyString (keyFieldOf coll) record of

                Ok pk ->
                    BlueDB.collPut
                        store
                        (collNameOf coll)
                        pk
                        (Codec.toJson (codecOf coll) record)
                        (indexFieldValues coll record)
                        (Store.colsOf (storeOf coll))
                        |> Task.andThen
                               (\storedJson ->
                                   case Codec.fromJson (codecOf coll) storedJson of

                                       Ok r ->
                                           publishSqlPut coll r
                                               |> Task.map (\_ -> r)

                                       Err e ->
                                           Task.fail e)

                Err e ->
                    Task.fail e


-- (field, value, colType) triples for the declared indexes; value = the field's
-- key-string, colType = the field's codec kind (drives order-preserving encoding).
indexFieldValues : Collection a -> a -> List ( String, String, String )
indexFieldValues coll record =
    List.foldr
        (\f acc ->
            case persistKeyString f record of

                Ok v ->
                    ( f, v, colTypeFor (codecOf coll) f ) :: acc

                Err _ ->
                    acc)
        []
        (indexesOf coll)


-- (field, colType) pairs for the declared indexes (delete / reindex paths).
indexFieldTypes : Collection a -> List ( String, String )
indexFieldTypes coll =
    List.map (\f -> ( f, colTypeFor (codecOf coll) f )) (indexesOf coll)


{-| The codec ColType kind ("int"/"bool"/"text"/…) of an index field, resolved from
the codec `shape`. Matches the index field name (camelCase) against the codec's
columns (snake_case by default) case- and underscore-insensitively; defaults to
"text" if the field isn't in the shape (a scalar/blob codec, or a typo). -}
colTypeFor : Codec a -> String -> String
colTypeFor codec field =
    let
        target = normalizeCol field
    in
        case shape codec of

            SRecord cols ->
                case List.find (\pair -> normalizeCol (fst pair) == target) cols of

                    Just pair ->
                        colTypeKind (snd pair)

                    Nothing ->
                        "text"

            _ ->
                "text"


normalizeCol : String -> String
normalizeCol s =
    String.toLower (String.replace "_" "" s)


boundHas : Maybe String -> Bool
boundHas m =
    case m of

        Just _ ->
            True

        Nothing ->
            False


boundVal : Maybe String -> String
boundVal m =
    case m of

        Just v ->
            v

        Nothing ->
            ""


{-| Delete a record by its primary key. -}
delete : Conn cap -> Collection a -> String -> Task Error ()
delete conn coll keyStr =
    case conn of

        SqlConn db ->
            Store.deleteByKey db (storeOf coll) keyStr
                |> Task.andThen
                       (\_ ->
                           publishChangeKernel
                               (collNameOf coll)
                               "delete"
                               keyStr
                               "")

        KvConn store ->
            BlueDB.collDelete
                store
                (collNameOf coll)
                keyStr
                (indexFieldTypes coll)
                (Store.colsOf (storeOf coll))
                |> Task.andThen
                       (\_ ->
                           publishChangeKernel
                               (collNameOf coll)
                               "delete"
                               keyStr
                               "")


{-| Count all records. (SQL: `COUNT(*)`; KV: a key scan — O(n), an analytics act.) -}
count : Conn cap -> Collection a -> Task Error Int
count conn coll =
    case conn of

        SqlConn db ->
            Store.count db (Store.query (storeOf coll))

        KvConn store ->
            BlueDB.collCount store (collNameOf coll)


{-| Every record. Bounded on SQL by nothing (whole table) and on KV by a large
scan cap — for large sets this is an analytics act, not a point op. -}
all : Conn cap -> Collection a -> Task Error (List a)
all conn coll =
    case conn of

        SqlConn db ->
            Store.all db (storeOf coll)

        KvConn store ->
            BlueDB.collAllValues (codecOf coll) store (collNameOf coll) 1000000


{-| Ensure the collection's storage exists. SQL: `CREATE TABLE IF NOT EXISTS`
(dialect-correct). KV: a no-op (BlueDB is schemaless). -}
create : Conn cap -> Collection a -> Task Error ()
create conn coll =
    case conn of

        SqlConn db ->
            Store.create db (storeOf coll)

        KvConn _ ->
            Task.succeed ()


-- KV-only verb (Conn KeyValue) --------------------------------------------------
{-| Prefix scan (key/value pairs). KV-only — SQL has no key-prefix notion; drop
to the query builder via `sql` for relational filters. -}
scan : Conn KeyValue -> Collection a -> String -> Int -> Task Error (List ( String, a ))
scan conn coll prefix limit =
    case conn of

        KvConn store ->
            -- Records are namespaced per collection now; scan the collection then
            -- keep only the pks matching `prefix`, decoding each kept value.
            BlueDB.collAll store (collNameOf coll) limit
                |> Task.andThen
                       (\pairs ->
                           Task.sequence
                               (List.foldr
                                   (\p acc ->
                                       if String.startsWith prefix (fst p) then
                                           decodeScanPair (codecOf coll) p
                                               :: acc

                                       else
                                           acc)
                                   []
                                   pairs))

        SqlConn _ ->
            -- unreachable: the type gates this to a KV connection
            Task.fail
                (Error.unexpected "Persist.scan: not a key-value connection")


decodeScanPair : Codec a -> ( String, String ) -> Task Error ( String, a )
decodeScanPair codec pair =
    case pair of

        ( pk, raw ) ->
            case Codec.fromJson codec raw of

                Ok v ->
                    Task.succeed ( pk, v )

                Err e ->
                    Task.fail e


{-| Backfill the declared indexes over existing records — call once at startup
(idempotent, manifest-guarded, so it's O(1) when nothing changed). KV-only; SQL
indexes are DDL. -}
reindex : Conn KeyValue -> Collection a -> Task Error ()
reindex conn coll =
    case conn of

        KvConn store ->
            BlueDB.collReindex store (collNameOf coll) (indexFieldTypes coll)
                |> Task.map (\_ -> ())

        SqlConn _ ->
            Task.fail
                (Error.unexpected "Persist.reindex: not a key-value connection")


{-| All records whose declared-index `field` equals `value` (KV-only). Non-unique:
returns every match. For a relational filter use the query builder via `sql`. -}
findAllByIndex : Conn KeyValue -> Collection a -> String -> String -> Task Error (List a)
findAllByIndex conn coll field value =
    case conn of

        KvConn store ->
            BlueDB.collFindByIndex
                store
                (collNameOf coll)
                field
                value
                (colTypeFor (codecOf coll) field)
                |> Task.andThen
                       (\pks ->
                           Task.sequence
                               (List.map
                                   (\pk ->
                                       BlueDB.collGetValue
                                           (codecOf coll)
                                           store
                                           (collNameOf coll)
                                           pk)
                                   pks))
                |> Task.map keepJusts

        SqlConn _ ->
            Task.fail
                (Error.unexpected
                    "Persist.findAllByIndex: not a key-value connection")


{-| The first record whose indexed `field` equals `value` (KV-only). Use for a
field you know is unique — BlueDB does not ENFORCE uniqueness (use a serial/UUID
PK or the SQL backend for a real constraint). -}
findByIndex : Conn KeyValue -> Collection a -> String -> String -> Task Error (Maybe a)
findByIndex conn coll field value =
    findAllByIndex conn coll field value |> Task.map List.head


{-| Count the records whose indexed `field` equals `value` (KV-only) — counts
index entries (no record fetch), exact as-of-snapshot. An O(N)-scan analytics op
(cold path), not a hot-path point read. (Ordered/numeric RANGE queries over the KV
index aren't offered: a lexical range over an int field would silently return wrong
rows — use the SQL backend's typed query builder via `sql` for typed ranges.) -}
countByIndex : Conn KeyValue -> Collection a -> String -> String -> Task Error Int
countByIndex conn coll field value =
    case conn of

        KvConn store ->
            BlueDB.collCountByIndex
                store
                (collNameOf coll)
                field
                value
                (colTypeFor (codecOf coll) field)

        SqlConn _ ->
            Task.fail
                (Error.unexpected
                    "Persist.countByIndex: not a key-value connection")


{-| Records whose indexed `field` is in the half-open range `[lo, hi)` (KV-only).
`lo`/`hi` are `Maybe String` bounds — `Nothing` = unbounded on that end (NOT `""`).
Values are the field's key-string form (`"18"`, `"2026-01-01"`, `"true"`); the
codec's field type makes the comparison CORRECT (a numeric field ranges numerically,
not lexically). Errors on real/blob/money fields — use the SQL backend's typed query
builder via `sql` for those. -}
findAllByIndexRange : Conn KeyValue -> Collection a -> String -> Maybe String -> Maybe String -> Task Error (List a)
findAllByIndexRange conn coll field lo hi =
    case conn of

        KvConn store ->
            BlueDB.collFindByIndexRange
                store
                (collNameOf coll)
                field
                (colTypeFor (codecOf coll) field)
                (boundHas lo)
                (boundVal lo)
                (boundHas hi)
                (boundVal hi)
                |> Task.andThen
                       (\pks ->
                           Task.sequence
                               (List.map
                                   (\pk ->
                                       BlueDB.collGetValue
                                           (codecOf coll)
                                           store
                                           (collNameOf coll)
                                           pk)
                                   pks))
                |> Task.map keepJusts

        SqlConn _ ->
            Task.fail
                (Error.unexpected
                    "Persist.findAllByIndexRange: not a key-value connection")


{-| Count the records whose indexed `field` is in `[lo, hi)` (KV-only) — counts
index entries (no record fetch). See `findAllByIndexRange` for the bound rules. -}
countByIndexRange : Conn KeyValue -> Collection a -> String -> Maybe String -> Maybe String -> Task Error Int
countByIndexRange conn coll field lo hi =
    case conn of

        KvConn store ->
            BlueDB.collCountByIndexRange
                store
                (collNameOf coll)
                field
                (colTypeFor (codecOf coll) field)
                (boundHas lo)
                (boundVal lo)
                (boundHas hi)
                (boundVal hi)

        SqlConn _ ->
            Task.fail
                (Error.unexpected
                    "Persist.countByIndexRange: not a key-value connection")


keepJusts : List (Maybe a) -> List a
keepJusts xs =
    List.foldr
        (\m acc ->
            case m of

                Just x ->
                    x :: acc

                Nothing ->
                    acc)
        []
        xs

-- ── Portable query builder (both backends) ───────────────────────────────────
--
-- Reuses Std.Db.Store's `Cond` builder. Build with `query`/`where_`/`orderAsc`/
-- `limit`, run with a terminal (`toList`/`toMaybe`/`toCount`) against EITHER
-- backend — SQL renders a WHERE clause; KV evaluates the SAME condition over each
-- record (a full-scan predicate: an analytics/cold-path op, never the reactive hot
-- path — reach for a declared `index` + `findAllByIndex` for point lookups).
--
-- Predicate value kinds String/Int/Float/Bool are exact on both backends.
type alias Cond =
    Store.Cond

type alias SqlValue =
    Db.SqlValue

type Query a
    = Query { coll : Collection a
, conds : List Cond
, orders : List ( String, String )
, limitN : Int
, offsetN : Int
}


{-| Start a portable query over a collection. -}
query : Collection a -> Query a
query coll =
    Query { coll = coll, conds = [], orders = [], limitN = 0, offsetN = 0 }


{-| AND another condition into the query (multiple `where_` AND together, so
OR/nesting is first-class via `or_`/`and_`). -}
where_ : Cond -> Query a -> Query a
where_ c (Query q) =
    Query { q | conds = q.conds ++ [ c ] }


{-| Order results ascending by a column (record field or snake column). On the KV
backend the sort happens in-memory after the scan. -}
orderAsc : String -> Query a -> Query a
orderAsc col (Query q) =
    Query { q | orders = q.orders ++ [ ( col, "asc" ) ] }


{-| Order results descending by a column. -}
orderDesc : String -> Query a -> Query a
orderDesc col (Query q) =
    Query { q | orders = q.orders ++ [ ( col, "desc" ) ] }


{-| Cap the number of returned rows. -}
limit : Int -> Query a -> Query a
limit n (Query q) =
    Query { q | limitN = n }


{-| Skip the first `n` rows. -}
offset : Int -> Query a -> Query a
offset n (Query q) =
    Query { q | offsetN = n }


{-| Run the query, returning every matching record (decoded via the codec). -}
toList : Conn cap -> Query a -> Task Error (List a)
toList conn (Query q) =
    case conn of

        SqlConn db ->
            Store.toList db (buildSqlQuery (Query q))

        KvConn store ->
            BlueDB.collQuery store (collNameOf q.coll) (kvPlan q)
                |> Task.andThen (decodeRows (codecOf q.coll))


{-| Run the query, returning the first matching record (adds `LIMIT 1`). -}
toMaybe : Conn cap -> Query a -> Task Error (Maybe a)
toMaybe conn q =
    toList conn (limit 1 q) |> Task.map List.head


{-| Count the matching records (no decode). -}
toCount : Conn cap -> Query a -> Task Error Int
toCount conn (Query q) =
    case conn of

        SqlConn db ->
            Store.count db (buildSqlQuery (Query q))

        KvConn store ->
            BlueDB.collQueryCount store (collNameOf q.coll) (kvPlan q)


-- Serialize the accumulated query to the KV plan JSON.
kvPlan : { coll : Collection a
, conds : List Cond
, orders : List ( String, String )
, limitN : Int
, offsetN : Int
} -> String
kvPlan q =
    Store.planJson
        (Store.colsOf (storeOf q.coll))
        (combinedCond q.conds)
        q.orders
        (indexFieldTypes q.coll)
        q.limitN
        q.offsetN


-- Fold the accumulated clauses onto a Store.Query for the SQL backend.
buildSqlQuery : Query a -> Store.Query a
buildSqlQuery (Query q) =
    let
        base =
            List.foldl Store.where_ (Store.query (storeOf q.coll)) q.conds
        ordered = List.foldl applyOrder base q.orders
        limited =
            if q.limitN > 0 then
                Store.limit q.limitN ordered

            else
                ordered
    in
        if q.offsetN > 0 then
            Store.offset q.offsetN limited

        else
            limited


applyOrder : ( String, String ) -> Store.Query a -> Store.Query a
applyOrder pair sq =
    case pair of

        ( col, "desc" ) ->
            Store.orderDesc col sq

        ( col, _ ) ->
            Store.orderAsc col sq


-- AND the accumulated conditions into one (empty → match-all).
combinedCond : List Cond -> Cond
combinedCond conds =
    case conds of

        [single] ->
            single

        many ->
            Store.and_ many


decodeRows : Codec a -> List ( String, String ) -> Task Error (List a)
decodeRows codec pairs =
    Task.sequence
        (List.map
            (\p ->
                case p of

                    ( _, raw ) ->
                        case Codec.fromJson codec raw of

                            Ok v ->
                                Task.succeed v

                            Err e ->
                                Task.fail e)
            pairs)


-- Condition leaves + combinators, re-exported from Std.Db.Store so a Persist app
-- builds queries from ONE import.
eq : String -> SqlValue -> Cond
eq =
    Store.eq


neq : String -> SqlValue -> Cond
neq =
    Store.neq


gt : String -> SqlValue -> Cond
gt =
    Store.gt


gte : String -> SqlValue -> Cond
gte =
    Store.gte


lt : String -> SqlValue -> Cond
lt =
    Store.lt


lte : String -> SqlValue -> Cond
lte =
    Store.lte


like : String -> String -> Cond
like =
    Store.like


isNull : String -> Cond
isNull =
    Store.isNull


notNull : String -> Cond
notNull =
    Store.notNull


inList : String -> List SqlValue -> Cond
inList =
    Store.inList


and_ : List Cond -> Cond
and_ =
    Store.and_


or_ : List Cond -> Cond
or_ =
    Store.or_


not_ : Cond -> Cond
not_ =
    Store.not_


-- Value constructors, re-exported from Std.Db so query values need ONE import.
string : String -> SqlValue
string =
    Db.SqlString


int : Int -> SqlValue
int =
    Db.SqlInt


float : Float -> SqlValue
float =
    Db.SqlFloat


bool : Bool -> SqlValue
bool =
    Db.SqlBool

-- ── Reactive change subscription (any backend) ───────────────────────────────
--
-- A live subscription to a collection's changes. When ANY session writes a record
-- (`put`/`insert`/`delete`) to `coll`, every session subscribed via
-- `watchCollection` receives a `Change` NUDGE — the reactive foundation: session A
-- writes, session B's UI updates with no polling. Rides the Sky.Live pub/sub
-- broker (works across replicas on a shared broker; KV + SQLite + Postgres via the
-- write-layer publish). Put it in the app's `subscriptions` and handle the `Change`
-- by RE-QUERYING (`Persist.toList` with your own filter).
{-| A change NOTIFICATION delivered to a `watchCollection` subscriber. `op` is
`"put"` / `"delete"` / `"resync"` (a feed overflow — re-read); `coll` + `pk`
identify what changed.

**`record` is always `""` — a nudge, not the row.** The record BODY is
deliberately NOT broadcast: the collection topic is shared by every session (all
tenants), so a record on it would leak one tenant's data to another. Respond by
**re-querying** with your OWN filter (`Persist.toList (query … |> where_ …)`) — the
result is correctly scoped to what THIS session may see. Re-querying on any
`Change` is always correct and covers all three ops. (`Persist.live` does exactly
this for you.) -}
type alias Change =
    { op : String
    , coll : String
    , pk : String
    , record : String
    }


{-| Subscribe to a collection's changes. Every write to `coll` (from ANY session)
delivers a `Change` nudge to `toMsg`. Reach for it in `subscriptions`:

    subscriptions model =
        Persist.watchCollection todos TodoChanged

Handle `TodoChanged` by **re-running your (filtered) query** — `record` is always
`""` (see `Change`; the row body is not broadcast, for cross-tenant safety). For a
fully-declarative binding that re-queries and folds into the Model for you, see
`Persist.live` (auto-refresh). -}
watchCollection : Collection a -> (Change -> msg) -> Sub msg
watchCollection coll toMsg =
    Sub.subscribeTopic
        (bluedbTopic (collNameOf coll))
        (\raw -> toMsg (parseChange raw))

{-| A REACTIVE QUERY — the magic. Declare a query and where its result goes in the
Model; the framework keeps it fresh forever: it runs the query at mount, and
whenever ANY session's write could change the result it re-runs and folds the rows
into the Model, so every session updates itself. NO `subscriptions`, NO Msg, NO
re-query, NO polling. Wire a list of these onto your app with `Live.withReactive`:

    reactiveQueries model =
        [ Persist.live db (Persist.query todos |> Persist.orderAsc "id")
            (\rows m -> { m | todos = rows })
        ]

    main = Live.app (config { … } |> Live.withReactive reactiveQueries)

Works on every backend (KV + SQLite + Postgres). For the 0.0001% that need custom
control (merge a change instead of re-query), drop to `Persist.watchCollection`. -}
type alias Live model =
    { coll : String
    , condPlan : String
    , run : Task Error ( model -> model, List String )
    , field : String
    , ephemeral : Bool
    }


{-| Build a reactive query (see `Live` / `Live.withReactive`). Opaque in practice
— you only ever build one with `live` and hand the list to `Live.withReactive`. -}
live : Conn cap -> Query a -> (List a -> model -> model) -> Live model
live conn q fold =
    liveNamed conn q fold ""


{-| Internal: `live` with the Model field name it fills carried along (the
`liveInto` lower arm passes the accessor's field name here). The field name is ""
for the fold-based `live` form — the fold can replace ANY part of the Model, so
there's no single known target field, and `ephemeral` on it is a no-op. Keeping
the field name at RUNTIME on the record (not a compile-time struct tag) lets the
session persister zero the ephemeral field with no lower→codegen tag channel. -}
liveNamed : Conn cap -> Query a -> (List a -> model -> model) -> String -> Live model
liveNamed conn q fold fieldName =
    case q of

        Query qr ->
            { coll = collNameOf qr.coll
            , condPlan =
                Store.condPlanJson
                    (Store.colsOf (storeOf qr.coll))
                    (combinedCond qr.conds)
            , run =
                toList conn q
                    |> Task.map
                           (\rows ->
                               ( \m -> fold rows m
                               , keepJusts
                                     (List.map
                                         (reactivePkOf (keyFieldOf qr.coll))
                                         rows)
                               ))
            , field = fieldName
            , ephemeral = False
            }


{-| Mark a reactive binding's Model field as EPHEMERAL — NOT persisted in the
Sky.Live session blob, re-derived by the reactive loop on reopen instead. The
huge-Model optimization: a session holding thousands of query-derived rows keeps
a small, dataset-independent session blob because the derived field is zeroed out
of the gob before persisting and re-filled on load.

Only meaningful on a binding built via `Persist.liveInto db .field query` (which
records the field name). On a fold-based `Persist.live … fold` (no single known
field) it is a no-op — the runtime keeps persisting the whole Model.

    reactiveQueries model =
        [ Persist.liveInto db .todos (Persist.query todos) |> Persist.ephemeral ]
-}
ephemeral : Live model -> Live model
ephemeral lr =
    { lr | ephemeral = True }


{-| Like `live`, but you name the Model field with a bare accessor instead of
writing the replace-fold by hand. These two are exactly equivalent:

    Persist.liveInto db .todos (Persist.query todos |> Persist.orderAsc "id")

    Persist.live db (Persist.query todos |> Persist.orderAsc "id")
        (\rows m -> { m | todos = rows })

The compiler reads the field name off the `.todos` accessor at the call site and
synthesises the `\rows m -> { m | todos = rows }` fold for you — so there's no
place to typo the field, and the fold can never drift from the query. The 2nd
argument MUST be a bare field accessor (`.field`); a named function there is a
compile error (reach for `Persist.live` when you need a custom fold). -}
liveInto : Conn cap -> (model -> List a) -> Query a -> Live model
liveInto =
    Ffi.kernel "Persist_liveInto"


reactivePkOf : String -> a -> Maybe String
reactivePkOf field record =
    case persistKeyString field record of

        Ok pk ->
            Just pk

        Err _ ->
            Nothing


-- Must match the runtime's bluedbCollTopic (rt/bluedb_reactive.go) byte-for-byte.
bluedbTopic : String -> String
bluedbTopic coll =
    "__bluedb:" ++ coll


-- Publish a record change to the reactive broker. The KV backend publishes via
-- the BlueDB engine change-feed (all writes, at the source); the SQL backends
-- (SQLite + Postgres) have no engine feed, so the Persist SQL write arms call
-- this after a successful write — making `watchCollection` / reactive queries
-- work the SAME on SQLite and Postgres. On a Redis broker it crosses replicas.
publishChangeKernel : String -> String -> String -> String -> Task Error ()
publishChangeKernel =
    Ffi.kernel "Persist_publishChange"


-- Best-effort put-notify from a record: a pk-extraction failure just skips the
-- notify (the write already succeeded — never fail a write on a notify problem).
publishSqlPut : Collection a -> a -> Task Error ()
publishSqlPut coll record =
    case persistKeyString (keyFieldOf coll) record of

        Ok pk ->
            -- Nudge only: the record body is NOT broadcast (cross-tenant safety),
            -- so don't waste a JSON serialization on it — pass "".
            publishChangeKernel (collNameOf coll) "put" pk ""

        Err _ ->
            Task.succeed ()


changeDecoder : Decode.Decoder Change
changeDecoder =
    Decode.map4
        (\op coll pk record -> { op = op, coll = coll, pk = pk, record = record })
        (Decode.field "op" Decode.string)
        (Decode.field "coll" Decode.string)
        (Decode.field "pk" Decode.string)
        (Decode.field "record" Decode.string)


parseChange : String -> Change
parseChange raw =
    case Decode.decodeString changeDecoder raw of

        Ok c ->
            c

        Err _ ->
            { op = "", coll = "", pk = "", record = "" }


-- Escape hatches (Task-typed; the dead arm is a Task.fail, never a panic) --------
{-| Drop to the raw `Std.Db` connection for SQL power the universal verbs don't
wrap (joins, `Store` query builder, `selectRaw`, transactions). -}
sql : Conn Relational -> Task Error Db
sql conn =
    case conn of

        SqlConn db ->
            Task.succeed db

        KvConn _ ->
            Task.fail
                (Error.unexpected "Persist.sql: not a relational connection")


{-| Drop to the raw `Std.BlueDB` store for KV power the universal verbs don't wrap. -}
kv : Conn KeyValue -> Task Error BlueDB.Store
kv conn =
    case conn of

        KvConn store ->
            Task.succeed store

        SqlConn _ ->
            Task.fail
                (Error.unexpected "Persist.kv: not a key-value connection")


-- Reflective key extraction (no JSON round-trip) --------------------------------
persistKeyString : String -> a -> Result Error String
persistKeyString =
    Ffi.kernel "Persist_keyString"
