-- | Std.Persist — one persistence surface over the BlueDB embedded engine AND
-- over SQLite/Postgres.
--
-- A `Collection a` pairs a `Std.Codec` with a primary key + declared indexes;
-- `connectKeyValue` mints an embedded `Conn` (`connectRelational` a SQL one),
-- and the universal verbs
-- (`get`/`put`/`insert`/`delete`/`query`/`count`/`transaction`) persist records
-- through it. The codec drives BOTH JSON and the storage column mapping —
-- write it once, persist it everywhere. Column names are the CODEC's names
-- (`Codec.auto` snake_cases: `priceMinor` → `price_minor`).
--
-- ```elm
-- import Std.Persist as P
-- import Std.Codec as Codec
--
-- todos : P.Collection Todo
-- todos =
--     P.collection "todos" todoCodec |> P.key "id" |> P.index "priority"
--
-- store : P.Conn P.KeyValue
-- store =
--     P.connectKeyValueSync "data/app.bluedb"
--
-- P.insert store todos { id = "t1", title = "buy milk", priority = 2, done = False }
-- P.query todos |> P.where_ (P.eq "done" (P.bool False)) |> P.orderAsc "priority" |> P.toList store
-- ```
--
-- The same verbs run on the embedded engine (`connectKeyValue`), SQLite, and
-- PostgreSQL (`connectRelational`); the portable subset is asserted by
-- `examples/57-persist-parity`. Commit-path reactivity (`liveInto` +
-- `Std.Live.withReactive`) is EMBEDDED-ONLY.
--
-- Full guide, backend matrix, and limitations: `docs/skypersist/overview.md`.
module Std.Persist exposing
    ( Conn
    , KeyValue
    , Relational
    , Collection
    , collection
    , key
    , index
    , connectKeyValue
    , connectKeyValueSync
    , connectRelational
    , get
    , put
    , insert
    , delete
    , all
    , count
    , selectRaw
    , transaction
    , LiveBinding
    , liveInto
    , Query
    , Cond
    , query
    , where_
    , orderAsc
    , orderDesc
    , limit
    , offset
    , toList
    , toMaybe
    , toCount
    , eq
    , neq
    , gt
    , gte
    , lt
    , lte
    , like
    , isNull
    , notNull
    , inList
    , and_
    , or_
    , not_
    , string
    , int
    , float
    , bool
    )

import Sky.Ffi as Ffi
import Sky.Core.Prelude exposing (..)
import Sky.Core.Error as Error exposing (Error)
import Sky.Core.Task as Task exposing (Task)
import Sky.Core.List as List
import Sky.Core.String as String
import Sky.Core.Char as Char
import Sky.Core.Json.Encode as E exposing (Value)
import Std.Codec as Codec exposing (Codec, ColType(..), Shape(..))
import Std.Db as Db exposing (SqlValue(..))
import Std.Db.Store as Store
import Std.Decimal as Decimal
import Std.Money as Money

-- ── Capability phantom tag ────────────────────────────────────────────────────
-- | The phantom capability marking a key-value (embedded) connection.
type KeyValue
    = KeyValue

-- | The phantom capability marking a relational (SQLite / Postgres) connection.
type Relational
    = Relational

-- | A backend-invisible connection, tagged with its capability `cap`. The embedded
-- arm wraps a runtime handle id (a registry-backed `*bluedb.EmbeddedBackend`, or the
-- tx surface inside a `transaction` body); the relational arm wraps a `Std.Db` handle
-- (SQLite / Postgres, or the tx handle inside a `transaction` body). Neither payload is
-- destructured by user code — the constructors are not exposed.
type Conn cap
    = KvConn Int
    | SqlConn Db

-- ── Collection ────────────────────────────────────────────────────────────────
-- | A persisted collection of `a`: a name, its codec (drives JSON + the engine's
-- column/index mapping), its primary-key column, and its declared secondary
-- indexes (single-column ascending, v1 — §2.5).
type Collection a
    = Collection { name : String
, codec : Codec a
, keyField : String
, indexes : List String
}


-- | Declare a collection from a name + codec. Defaults the primary key to `"id"`;
-- override with `key`, add indexes with `index`.
collection : String -> Codec a -> Collection a
collection name codec =
    Collection { name = name, codec = codec, keyField = "id", indexes = [] }


-- | Set the primary-key column (the record field the engine keys rows by).
key : String -> Collection a -> Collection a
key k (Collection c) =
    Collection { c | keyField = k }


-- | Declare a secondary index on a column (single-column ascending; no compound,
-- unique, or partial indexes).
--
-- NOTE what this does and does not buy you. It does NOT yet speed up embedded
-- reads — an embedded query is a primary-key-ordered scan of the collection with
-- the predicate evaluated in memory. What a declared index gives you is
-- TRANSACTIONAL PRECISION (a range-optimized column — int/text/bool — lets a
-- serializable transaction record a tight index-range read-set instead of a
-- coarse one, so fewer false conflicts) plus reactive change-feed matching. A
-- not-order-preserving column (Money/`Codec.map`/blob) routes to the
-- conservative witness. On the relational arm the database plans as usual.
--
-- A column name that is not in the codec does NOT error — it degrades silently
-- to the conservative path. Use the CODEC's column names (`Codec.auto`
-- snake_cases: `priceMinor` → `price_minor`).
index : String -> Collection a -> Collection a
index f (Collection c) =
    Collection { c | indexes = c.indexes ++ [ f ] }


codecOf : Collection a -> Codec a
codecOf (Collection c) =
    c.codec


collNameOf : Collection a -> String
collNameOf (Collection c) =
    c.name


keyFieldOf : Collection a -> String
keyFieldOf (Collection c) =
    c.keyField


indexesOf : Collection a -> List String
indexesOf (Collection c) =
    c.indexes


-- ── Connect ───────────────────────────────────────────────────────────────────
-- | Open (or reuse) the embedded engine at `path` (a directory) and mint a
-- key-value connection. A memoised top-level binding shares ONE engine per path.
connectKeyValue : String -> Task Error (Conn KeyValue)
connectKeyValue path =
    Task.map KvConn (openEmbedded path)


-- | Open (or reuse) the embedded engine at `path` and return a ready-to-use
-- key-value connection, FORCING the open at binding-init time — the memoised
-- "handle" CAF pattern. Use this for the top-level `store` a Sky.Live app +
-- `Live.withReactive` needs (a `liveInto` binding needs a concrete `Conn` when
-- the app config is built, before `init`). On open failure it yields an INERT
-- handle whose verbs return `Err`, so `store = connectKeyValueSync "…"` always
-- type-checks as a `Conn KeyValue`. Prefer the `connectKeyValue` Task form
-- inside a Task pipeline.
connectKeyValueSync : String -> Conn KeyValue
connectKeyValueSync path =
    case Task.run (connectKeyValue path) of

        Ok conn ->
            conn

        Err _ ->
            KvConn (-1)


-- | Open a relational connection (SQLite / Postgres) from the project's `[data]`
-- (or legacy `[database]`) config and mint a relational connection. The same
-- universal verbs then persist records through `Std.Db`/`Std.Db.Store` —
-- dialect-safe and codec-driven. The DSN SHAPE selects the driver: a
-- `postgres://` URL opens Postgres, anything else is a SQLite path.
connectRelational : () -> Task Error (Conn Relational)
connectRelational _ =
    Task.map SqlConn (Db.connect ())


-- ── Universal verbs ───────────────────────────────────────────────────────────
-- | Fetch a record by primary key. `Nothing` when absent.
get : Conn cap -> Collection a -> String -> Task Error (Maybe a)
get conn coll keyStr =
    case conn of

        KvConn store ->
            embeddedGet store (schemaJson coll) keyStr
                |> Task.andThen (decodeMaybe (codecOf coll))

        SqlConn db ->
            ensureSqlTable db coll
                |> Task.andThen
                       (\_ ->
                           Store.findBy
                               db
                               (sqlStoreOf coll)
                               (keyFieldOf coll)
                               keyStr)


-- | Upsert a record by its self-assigned primary key.
put : Conn cap -> Collection a -> a -> Task Error ()
put conn coll record =
    case conn of

        KvConn store ->
            embeddedPut
                store
                (schemaJson coll)
                (Codec.toJson (codecOf coll) record)

        SqlConn db ->
            ensureSqlTable db coll
                |> Task.andThen (\_ -> Store.upsert db (sqlStoreOf coll) record)
                |> Task.map (\_ -> ())


-- | Insert a record. A duplicate primary key is rejected on every backend.
-- RETURN VALUE DIFFERS BY BACKEND: the embedded arm returns the PERSISTED row
-- (so engine-filled columns come back); the relational arm returns the record
-- you passed in, unchanged — re-read with `get` if you need a DB-filled default.
insert : Conn cap -> Collection a -> a -> Task Error a
insert conn coll record =
    case conn of

        KvConn store ->
            embeddedInsert
                store
                (schemaJson coll)
                (Codec.toJson (codecOf coll) record)
                |> Task.andThen (decodeOne (codecOf coll))

        SqlConn db ->
            ensureSqlTable db coll
                |> Task.andThen (\_ -> Store.insert db (sqlStoreOf coll) record)
                |> Task.map (\_ -> record)


-- | Delete a record by primary key. Idempotent (a missing key is a no-op).
delete : Conn cap -> Collection a -> String -> Task Error ()
delete conn coll keyStr =
    case conn of

        KvConn store ->
            embeddedDelete store (schemaJson coll) keyStr

        SqlConn db ->
            ensureSqlTable db coll
                |> Task.andThen
                       (\_ ->
                           Store.delete
                               db
                               (sqlStoreOf coll)
                               (keyFieldOf coll)
                               keyStr)
                |> Task.map (\_ -> ())


-- | Every record in the collection.
all : Conn cap -> Collection a -> Task Error (List a)
all conn coll =
    toList conn (query coll)


-- | Count every record in the collection.
count : Conn cap -> Collection a -> Task Error Int
count conn coll =
    toCount conn (query coll)


-- | Escape hatch: run arbitrary SQL (JOIN / GROUP BY / aggregate) and decode each
-- row into a projection via `codec`. RELATIONAL ONLY — the embedded engine has no
-- cross-collection join and returns an error for SQL text. Unlike the other
-- verbs it does NOT create the collection's table first, so call it only after a
-- verb that does.
selectRaw : Conn cap -> Codec row -> String -> List SqlValue -> Task Error (List row)
selectRaw conn codec sql params =
    case conn of

        KvConn store ->
            embeddedSelectRaw store sql params
                |> Task.andThen (decodeRows codec)

        SqlConn db ->
            Store.selectRaw db codec sql params


-- | Run `fn` inside a serializable transaction with bounded conflict-retry —
-- the SAME guarantee on every backend:
--
--   * embedded (`connectKeyValue`) → SSI (the BlueDB engine's Decision-4
--     commit-time validation);
--   * Postgres (`connectRelational`) → `BEGIN … SERIALIZABLE` (= SSI, exact
--     parity with embedded);
--   * SQLite (`connectRelational`) → `BEGIN IMMEDIATE` (upfront write lock +
--     the connect-time single-writer clamp).
--
-- Retries are bounded and automatic; a retry-exhausted conflict surfaces as the
-- SAME typed `Conflict` error on every backend, so one handler spans all three.
-- NOTE `Error.isRetryable` does NOT cover `Conflict` (only Timeout/Network/
-- Unavailable) — match the kind yourself. The body is handed a `Conn` bound to
-- the transaction; its `get`/`put`/`query` compose atomically (a txn-scoped
-- `query` records a read-set). A body that returns `Task.fail` rolls the
-- transaction back and propagates the error.
transaction : Conn cap -> (Conn cap -> Task Error a) -> Task Error a
transaction conn fn =
    case conn of

        KvConn store ->
            embeddedTransaction store (\txStore -> fn (KvConn txStore))

        SqlConn db ->
            sqlSerializableTransaction db (\tx -> fn (SqlConn tx))

-- ── Reactive (Phase 4b) ───────────────────────────────────────────────────────
-- | A registered reactive binding: keeps a Model `List a` live from a
-- collection's commit-path change feed. Build one with `liveInto` and register
-- it on a Sky.Live app with `Std.Live.withReactive`. The element type `a` is
-- hidden inside `run`, so a heterogeneous `List (LiveBinding model)` (bindings
-- over different collections) type-checks.
type alias LiveBinding model =
    { store : Int
    , coll : String
    , schema : String
    , plan : String
    , run : () -> Task Error (model -> model)
    }


-- | Build a reactive binding: run `qry` on `conn`/`coll` for its baseline, and
-- whenever a same-tenant write changes the query's result set, re-run it and
-- install the fresh `List a` into the Model via `setter`. Register the result
-- with `Std.Live.withReactive`.
--
-- EMBEDDED ONLY. `connectKeyValue`/`connectKeyValueSync` backends get precise
-- commit-path live updates, scoped to the session's verified tenant. A binding
-- on a RELATIONAL conn (or on an inert failed-open handle) cannot live-deliver:
-- it paints once and never updates. That is gated, not silent — in dev the
-- runtime warns; outside dev the process exits rather than serve a frozen list.
-- Reactive on a local store is also SINGLE-INSTANCE only and needs
-- `SKY_DATA_REACTIVE_SCOPE=single-instance` (or `[data] reactiveScope`) outside
-- dev. See `docs/skypersist/overview.md` §Reactivity.
--
--     Live.config { … }
--         |> Live.withReactive
--                (\_ ->
--                    [ P.liveInto store todos (P.query todos)
--                          (\rows model -> { model | todos = rows })
--                    ]
--                )
liveInto : Conn cap -> Collection a -> Query a -> (List a -> model -> model) -> LiveBinding model
liveInto conn coll qry setter =
    { store = connStoreId conn
    , coll = collNameOf coll
    , schema = schemaJson coll
    , plan = planJson qry
    , run = \_ -> Task.map setter (toList conn qry)
    }


-- The embedded store handle id a reactive loop watches. A relational connection
-- yields -1 — the loop fills once but opens no commit-path subscription (4c).
connStoreId : Conn cap -> Int
connStoreId conn =
    case conn of

        KvConn store ->
            store

        SqlConn _ ->
            -1

-- ── Query builder ─────────────────────────────────────────────────────────────
-- | A composable WHERE condition — build a leaf (`eq` / `gt` / `like` / …) and
-- combine with `and_` / `or_` / `not_`; apply with `where_`.
type Cond
    = CondLeaf String String SqlValue
    | CondNullC String Bool
    | CondInC String (List SqlValue)
    | CondAndC (List Cond)
    | CondOrC (List Cond)
    | CondNotC Cond

-- | An in-progress query over a collection.
type Query a
    = Query { coll : Collection a
, conds : List Cond
, orders : List ( String, String )
, limitN : Int
, offsetN : Int
}


-- | Start a query over a collection.
query : Collection a -> Query a
query coll =
    Query { coll = coll, conds = [], orders = [], limitN = -1, offsetN = 0 }


-- | Add a condition (multiple `where_` calls AND together).
where_ : Cond -> Query a -> Query a
where_ c (Query q) =
    Query { q | conds = c :: q.conds }


-- | Order ascending by a column (priority order across calls).
orderAsc : String -> Query a -> Query a
orderAsc col (Query q) =
    Query { q | orders = q.orders ++ [ ( col, "asc" ) ] }


-- | Order descending by a column.
orderDesc : String -> Query a -> Query a
orderDesc col (Query q) =
    Query { q | orders = q.orders ++ [ ( col, "desc" ) ] }


-- | Cap the number of rows returned.
limit : Int -> Query a -> Query a
limit n (Query q) =
    Query { q | limitN = n }


-- | Skip the first `n` rows.
offset : Int -> Query a -> Query a
offset n (Query q) =
    Query { q | offsetN = n }


-- | Run the query, decoding each matching row via the collection's codec.
toList : Conn cap -> Query a -> Task Error (List a)
toList conn (Query q) =
    guardIdents (Query q) |> Task.andThen (\_ -> toListRun conn (Query q))


toListRun : Conn cap -> Query a -> Task Error (List a)
toListRun conn (Query q) =
    case conn of

        KvConn store ->
            embeddedQuery store (schemaJson q.coll) (planJson (Query q))
                |> Task.andThen (decodeRows (codecOf q.coll))

        SqlConn db ->
            let
                ( whereSql, params ) = sqlWhere (Db.dialect db) q.conds
                sql =
                    "SELECT * FROM " ++ collNameOf q.coll ++ whereSql
                        ++ orderTailSql q.orders
                        ++ pageTailSql q.limitN q.offsetN
            in
                ensureSqlTable db q.coll
                    |> Task.andThen
                           (\_ -> sqlQueryObjects db sql params (sqlCols q.coll))
                    |> Task.andThen (decodeRows (codecOf q.coll))


-- | Run the query and return the first matching row (if any).
toMaybe : Conn cap -> Query a -> Task Error (Maybe a)
toMaybe conn qr =
    Task.map List.head (toList conn qr)


-- | Run the query's predicate and return the matching row count.
toCount : Conn cap -> Query a -> Task Error Int
toCount conn (Query q) =
    guardIdents (Query q) |> Task.andThen (\_ -> toCountRun conn (Query q))


toCountRun : Conn cap -> Query a -> Task Error Int
toCountRun conn (Query q) =
    case conn of

        KvConn store ->
            embeddedCount store (schemaJson q.coll) (planJson (Query q))

        SqlConn db ->
            let
                ( whereSql, params ) = sqlWhere (Db.dialect db) q.conds
            in
                ensureSqlTable db q.coll
                    |> Task.andThen
                           (\_ ->
                               Db.query
                                   db
                                   ("SELECT COUNT(*) AS n FROM "
                                       ++ collNameOf q.coll
                                       ++ whereSql)
                                   params)
                    |> Task.map
                           (\rows ->
                               case rows of

                                   row :: _ ->
                                       Db.getInt "n" row

                                   [] ->
                                       0)


-- ── Condition leaves + combinators ────────────────────────────────────────────
-- | `col = value`.
eq : String -> SqlValue -> Cond
eq col v =
    CondLeaf col "eq" v


-- | `col <> value`.
neq : String -> SqlValue -> Cond
neq col v =
    CondLeaf col "ne" v


-- | `col > value`.
gt : String -> SqlValue -> Cond
gt col v =
    CondLeaf col "gt" v


-- | `col >= value`.
gte : String -> SqlValue -> Cond
gte col v =
    CondLeaf col "gte" v


-- | `col < value`.
lt : String -> SqlValue -> Cond
lt col v =
    CondLeaf col "lt" v


-- | `col <= value`.
lte : String -> SqlValue -> Cond
lte col v =
    CondLeaf col "lte" v


-- | `col LIKE pattern` (SQL `%` / `_` wildcards). Case-INsensitive for ASCII on
-- every backend (forced: `LIKE` on SQLite, `ILIKE` on Postgres, ASCII folding in
-- the embedded engine). Non-ASCII case-folding is backend-specific and is NOT
-- part of the cross-backend guarantee.
like : String -> String -> Cond
like col pat =
    CondLeaf col "like" (SqlString pat)


-- | `col IS NULL`.
isNull : String -> Cond
isNull col =
    CondNullC col True


-- | `col IS NOT NULL`.
notNull : String -> Cond
notNull col =
    CondNullC col False


-- | `col IN (v1, v2, …)`. An empty list matches nothing.
inList : String -> List SqlValue -> Cond
inList col vs =
    CondInC col vs


-- | All of the conditions (AND).
and_ : List Cond -> Cond
and_ conds =
    CondAndC conds


-- | Any of the conditions (OR).
or_ : List Cond -> Cond
or_ conds =
    CondOrC conds


-- | Negation.
not_ : Cond -> Cond
not_ c =
    CondNotC c


-- ── Typed value constructors (injection-safe params) ─────────────────────────
-- | A `String` value.
string : String -> SqlValue
string s =
    SqlString s


-- | An `Int` value.
int : Int -> SqlValue
int n =
    SqlInt n


-- | A `Float` value.
float : Float -> SqlValue
float f =
    SqlFloat f


-- | A `Bool` value.
bool : Bool -> SqlValue
bool b =
    SqlBool b


-- ── Kernels (Ffi.kernel "Embedded_*" → rt.Embedded_*, §6) ────────────────────
openEmbedded : String -> Task Error Int
openEmbedded =
    Ffi.kernel "Embedded_open"


embeddedGet : Int -> String -> String -> Task Error (Maybe String)
embeddedGet =
    Ffi.kernel "Embedded_get"


embeddedPut : Int -> String -> String -> Task Error ()
embeddedPut =
    Ffi.kernel "Embedded_put"


embeddedInsert : Int -> String -> String -> Task Error String
embeddedInsert =
    Ffi.kernel "Embedded_insert"


embeddedDelete : Int -> String -> String -> Task Error ()
embeddedDelete =
    Ffi.kernel "Embedded_delete"


embeddedQuery : Int -> String -> String -> Task Error (List String)
embeddedQuery =
    Ffi.kernel "Embedded_query"


embeddedCount : Int -> String -> String -> Task Error Int
embeddedCount =
    Ffi.kernel "Embedded_count"


embeddedTransaction : Int -> (Int -> Task Error a) -> Task Error a
embeddedTransaction =
    Ffi.kernel "Embedded_transaction"


embeddedSelectRaw : Int -> String -> List SqlValue -> Task Error (List String)
embeddedSelectRaw =
    Ffi.kernel "Embedded_selectRaw"


-- Reused from the proven `Std.Db` surface: build column rows into codec-decodable
-- JSON blobs (§4.1 — the relational arm reuses `Std.Db`, never re-rendered in Go).
sqlQueryObjects : Db -> String -> List SqlValue -> List ( String, String ) -> Task Error (List String)
sqlQueryObjects =
    Ffi.kernel "Db_queryObjects"


-- The SERIALIZABLE transaction the SQL arm uses (pg SERIALIZABLE / SQLite BEGIN
-- IMMEDIATE + bounded conflict-retry → typed `Conflict`), matching the embedded
-- SSI arm. Distinct from `Db.withTransaction`, which keeps DEFAULT isolation for
-- raw `Std.Db` users (§ Batch-1 / A1-A3).
sqlSerializableTransaction : Db -> (Db -> Task Error a) -> Task Error a
sqlSerializableTransaction =
    Ffi.kernel "Db_withSerializableTransaction"


-- ── Relational (SQL) arm — dialect-aware, forced-semantics rendering (§4.1) ──
-- The SQL arm reuses `Std.Db`/`Std.Db.Store` for schema + CRUD; queries render a
-- dialect-aware, forced-semantics SQL here (§0.6): NULLs sort FIRST ascending /
-- LAST descending on BOTH dialects (matching the embedded `orderAndPage`), and
-- `LIKE` is case-insensitive ASCII on every backend (`LIKE` on SQLite — already
-- ASCII-case-insensitive; `ILIKE` on Postgres; the embedded `likeMatch` folds
-- ASCII case). Values bind as `?` params — injection-safe.
-- Build a `Store a` view of a collection for the codec-driven schema + CRUD verbs.
sqlStoreOf : Collection a -> Store.Store a
sqlStoreOf coll =
    Store.fromCodec (collNameOf coll) (codecOf coll)
        |> Store.primaryKey (keyFieldOf coll)


-- Create the collection's table if absent (idempotent DDL derived from the codec).
ensureSqlTable : Db -> Collection a -> Task Error ()
ensureSqlTable db coll =
    Store.create db (sqlStoreOf coll)


-- The collection's (column, DDL-kind) descriptors — the schema `Db_queryObjects`
-- uses to shape each row's JSON. Uses the codec's PHYSICAL kind (like `Std.Db.Store`),
-- not the engine kind the embedded indexer needs.
sqlCols : Collection a -> List ( String, String )
sqlCols coll =
    case Codec.shape (codecOf coll) of

        SRecord cols ->
            List.map (\pair -> ( fst pair, Codec.colTypeKind (snd pair) )) cols

        _ ->
            []


-- ── Identifier validation (F6 — injection gate) ───────────────────────────────
-- Column/table identifiers are interpolated into SQL text (values always bind as
-- `?` params, so THEY are safe; identifiers are the surface). A dynamic or
-- typo'd sort/filter column MUST fail fast with a clear error BEFORE it reaches
-- the database — mirrors the Std.Db.Store fast-fail convention (Store.sky
-- guardCols). Applies on BOTH arms: the embedded arm doesn't build SQL, but a
-- bad identifier is still a bug worth catching uniformly.
guardIdents : Query a -> Task Error ()
guardIdents (Query q) =
    let
        idents =
            collNameOf q.coll
                :: (List.concatMap condIdents q.conds ++ List.map fst q.orders)
    in
        case List.find (\s -> not (isSafeIdent s)) idents of

            Just bad ->
                Task.fail
                    (Error.invalidInput
                        ("Std.Persist: invalid SQL identifier \"" ++ bad
                            ++ "\" — column/table names must match [A-Za-z0-9_.]"))

            Nothing ->
                Task.succeed ()


condIdents : Cond -> List String
condIdents c =
    case c of

        CondLeaf col _ _ ->
            [ col ]

        CondNullC col _ ->
            [ col ]

        CondInC col _ ->
            [ col ]

        CondAndC kids ->
            List.concatMap condIdents kids

        CondOrC kids ->
            List.concatMap condIdents kids

        CondNotC k ->
            condIdents k


isSafeIdent : String -> Bool
isSafeIdent s =
    not (String.isEmpty s) && List.all isSafeIdentChar (String.toList s)


isSafeIdentChar : Char -> Bool
isSafeIdentChar c =
    Char.isAlpha c || Char.isDigit c || c == '_' || c == '.'


sqlWhere : String -> List Cond -> ( String, List SqlValue )
sqlWhere dia conds =
    case conds of

        [] ->
            ( "", [] )

        _ ->
            let
                ( s, p ) = renderCondSql dia (combined conds)
            in
                ( " WHERE " ++ s, p )


renderCondSql : String -> Cond -> ( String, List SqlValue )
renderCondSql dia cond =
    case cond of

        CondLeaf col op v ->
            ( col ++ " " ++ sqlOp dia op ++ " ?", [ v ] )

        CondNullC col wantNull ->
            ( col
                  ++ (if wantNull then
                         " IS NULL"

                     else
                         " IS NOT NULL")
            , []
            )

        CondInC col vs ->
            case vs of

                [] ->
                    ( "1 = 0", [] )

                _ ->
                    ( col ++ " IN ("
                          ++ String.join ", " (List.map (\_ -> "?") vs)
                          ++ ")"
                    , vs
                    )

        CondAndC kids ->
            renderGroupSql dia "1 = 1" " AND " kids

        CondOrC kids ->
            renderGroupSql dia "1 = 0" " OR " kids

        CondNotC k ->
            let
                ( s, p ) = renderCondSql dia k
            in
                ( "NOT (" ++ s ++ ")", p )


-- The comparison operator token. `like` forces case-insensitive ASCII: `LIKE` on
-- SQLite (already case-insensitive ASCII) / `ILIKE` on Postgres (§0.6).
sqlOp : String -> String -> String
sqlOp dia op =
    case op of

        "eq" ->
            "="

        "ne" ->
            "<>"

        "gt" ->
            ">"

        "gte" ->
            ">="

        "lt" ->
            "<"

        "lte" ->
            "<="

        "like" ->
            if dia == "postgres" then
                "ILIKE"

            else
                "LIKE"

        _ ->
            "="


renderGroupSql : String -> String -> String -> List Cond -> ( String, List SqlValue )
renderGroupSql dia emptySql sep cs =
    case cs of

        [] ->
            ( emptySql, [] )

        _ ->
            let
                parts = List.map (renderCondSql dia) cs
            in
                ( "(" ++ String.join sep (List.map fst parts) ++ ")"
                , List.concat (List.map snd parts)
                )


-- ORDER BY with FORCED null placement: NULLs FIRST ascending, LAST descending, on
-- BOTH dialects — matching the embedded `orderAndPage` (§0.6). `orders` is already
-- in priority order (orderAsc/orderDesc APPEND).
orderTailSql : List ( String, String ) -> String
orderTailSql orders =
    case orders of

        [] ->
            ""

        _ ->
            " ORDER BY " ++ String.join ", " (List.map orderTermSql orders)


orderTermSql : ( String, String ) -> String
orderTermSql pair =
    if snd pair == "desc" then
        fst pair ++ " DESC NULLS LAST"

    else
        fst pair ++ " ASC NULLS FIRST"


pageTailSql : Int -> Int -> String
pageTailSql limitN offsetN =
    (if limitN >= 0 then
        " LIMIT " ++ String.fromInt limitN

    else
        "")
        ++ (if offsetN > 0 then
               " OFFSET " ++ String.fromInt offsetN

           else
               "")


-- ── Decode helpers ────────────────────────────────────────────────────────────
decodeMaybe : Codec a -> Maybe String -> Task Error (Maybe a)
decodeMaybe codec m =
    case m of

        Nothing ->
            Task.succeed Nothing

        Just jsonStr ->
            case Codec.fromJson codec jsonStr of

                Ok v ->
                    Task.succeed (Just v)

                Err e ->
                    Task.fail e


decodeOne : Codec a -> String -> Task Error a
decodeOne codec jsonStr =
    case Codec.fromJson codec jsonStr of

        Ok v ->
            Task.succeed v

        Err e ->
            Task.fail e


decodeRows : Codec a -> List String -> Task Error (List a)
decodeRows codec rows =
    case rows of

        [] ->
            Task.succeed []

        jsonStr :: rest ->
            case Codec.fromJson codec jsonStr of

                Ok v ->
                    Task.map (\vs -> v :: vs) (decodeRows codec rest)

                Err e ->
                    Task.fail e


-- ── Schema descriptor (Sky → the Go kernel's CollSchema, §3.4) ───────────────
schemaJson : Collection a -> String
schemaJson coll =
    E.encode
        0
        (E.object
            [ ( "name", E.string (collNameOf coll) )
            , ( "key", E.string (keyFieldOf coll) )
            , ( "cols", E.list encCol (colDescriptors coll) )
            , ( "indexes", E.list (encIndex coll) (indexesOf coll) )
            ])


encCol : ( String, String ) -> Value
encCol pair =
    E.object
        [ ( "name", E.string (fst pair) )
        , ( "type", E.string (snd pair) )
        , ( "unique", E.bool False )
        , ( "generated", E.bool False )
        ]


encIndex : Collection a -> String -> Value
encIndex coll field =
    E.object
        [ ( "name", E.string field )
        , ( "col", E.string field )
        , ( "type", E.string (colTypeFor (codecOf coll) field) )
        , ( "unique", E.bool False )
        ]


-- The collection's (column, engineKind) descriptors, from the codec's shape. A
-- non-record codec (scalar collection) has no columns to enumerate here.
colDescriptors : Collection a -> List ( String, String )
colDescriptors coll =
    case Codec.shape (codecOf coll) of

        SRecord cols ->
            List.map
                (\pair -> ( fst pair, Codec.colEngineKind (snd pair) ))
                cols

        _ ->
            []


-- The engine kind string for a field (§2.3). An unresolved field routes to the
-- non-order-preserving fallback, NEVER range-optimized text.
colTypeFor : Codec a -> String -> String
colTypeFor codec field =
    case Codec.shape codec of

        SRecord cols ->
            case List.find
                     (\pair -> normalizeCol (fst pair) == normalizeCol field)
                     cols of

                Just pair ->
                    Codec.colEngineKind (snd pair)

                Nothing ->
                    "notorderable"

        _ ->
            "notorderable"


normalizeCol : String -> String
normalizeCol s =
    String.toLower (String.replace "_" "" s)


-- ── Plan descriptor (Sky → the Go kernel's QueryPlan, §4) ────────────────────
planJson : Query a -> String
planJson (Query q) =
    E.encode
        0
        (E.object
            [ ( "where", condJson (codecOf q.coll) (combined q.conds) )
            , ( "orders", E.list orderJson q.orders )
            , ( "limit", E.int q.limitN )
            , ( "offset", E.int q.offsetN )
            ])


-- Fold the accumulated conditions into one node. A single leaf passes through bare
-- (so a txn-scoped query can record a PRECISE index range, §2.6); multiple AND.
combined : List Cond -> Cond
combined conds =
    case List.reverse conds of

        [] ->
            CondAndC []

        [one] ->
            one

        many ->
            CondAndC many


condJson : Codec a -> Cond -> Value
condJson codec cond =
    case cond of

        CondLeaf col op v ->
            E.object
                [ ( "op", E.string op )
                , ( "col", E.string col )
                , ( "type", E.string (colTypeFor codec col) )
                , ( "val", valJson (colTypeFor codec col) v )
                ]

        CondNullC col isN ->
            E.object
                [ ( "op"
                  , E.string
                        (if isN then
                            "isnull"

                        else
                            "notnull")
                  )
                , ( "col", E.string col )
                ]

        CondInC col vs ->
            E.object
                [ ( "op", E.string "in" )
                , ( "col", E.string col )
                , ( "type", E.string (colTypeFor codec col) )
                , ( "vals", E.list (valJson (colTypeFor codec col)) vs )
                ]

        CondAndC kids ->
            E.object
                [ ( "op", E.string "and" )
                , ( "kids", E.list (condJson codec) kids )
                ]

        CondOrC kids ->
            E.object
                [ ( "op", E.string "or" )
                , ( "kids", E.list (condJson codec) kids )
                ]

        CondNotC k ->
            E.object
                [ ( "op", E.string "not" )
                , ( "kids", E.list (condJson codec) [ k ] )
                ]


valJson : String -> SqlValue -> Value
valJson kind v =
    E.object [ ( "type", E.string kind ), ( "v", E.string (sqlValueStr v) ) ]


orderJson : ( String, String ) -> Value
orderJson pair =
    E.object
        [ ( "col", E.string (fst pair) )
        , ( "desc", E.bool (snd pair == "desc") )
        ]


-- The textual form of a bound value (the byte form the engine normalizes under the
-- column's engine kind, §2.3). Every SqlValue variant is covered.
sqlValueStr : SqlValue -> String
sqlValueStr v =
    case v of

        SqlString s ->
            s

        SqlInt n ->
            String.fromInt n

        SqlFloat f ->
            String.fromFloat f

        SqlBool b ->
            if b then
                "true"

            else
                "false"

        SqlBytes s ->
            s

        SqlDecimal d ->
            Decimal.toString d

        SqlTime t ->
            String.fromInt t

        SqlMoney m ->
            Money.formatWithCode m

        SqlNull inner ->
            sqlValueStr inner
