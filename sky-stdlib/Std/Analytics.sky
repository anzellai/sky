-- | Std.Analytics — typed product analytics (Layer 3 Sky source).
--
-- Capture page views, actions, and e-commerce events with typed
-- properties. The foundation is an OPEN typed-payload builder — any
-- code (your app OR a reusable library) can emit an event without
-- coupling to a central union:
--
--     Analytics.track
--         (Analytics.event "product_viewed"
--             [ Analytics.string "sku" "SKU-42"
--             , Analytics.int "qty" 1
--             ])
--
-- The differentiator vs every stringly-typed SDK: property VALUES are
-- Sky-typed (an `Int` is an `Int`, identity is a `Pii`, not a stray
-- `String`), and PII is a distinct type the pipeline can redact by
-- construction (see `Pii`).
--
-- STATUS: data layer complete. Shipped: the open builder + typed props
-- (incl. `Money`), `trackEvent` reflective derive, load-bearing `Pii`
-- redaction, the default-safe identity/consent backbone (`identify`,
-- `setConsent`, anonymous-by-default, session-scoped so one Sky.Live user's
-- identity never bleeds into another's), opt-in Sky.Live auto page-views,
-- device + IP-anonymised context, pluggable `Sink`s (`configure`: stderr /
-- JSONL file / a `Custom` userland handler for any provider), a SQLite
-- store (reuse the console DB or a `[analytics] dbPath` override), `erase`,
-- and the aggregate queries (`totalEvents` / `uniqueUsers` / `eventCounts`
-- / `recentEvents`). Landing later: per-sink Pii clearance, first-class
-- provider wrappers, the console dashboard tab — see
-- docs/rfcs/std-analytics.md. PII stays redacted across every sink.
module Std.Analytics exposing
    ( Event
    , Prop
    , PropValue(..)
    , Pii(..)
    , Consent(..)
    , Sink(..)
    , event
    , string
    , int
    , float
    , bool
    , money
    , pii
    , piiEmail
    , piiRaw
    , track
    , trackEvent
    , identify
    , setConsent
    , configure
    , erase
    , totalEvents
    , uniqueUsers
    , eventCounts
    , recentEvents
    )

import Sky.Ffi as Ffi
import Sky.Core.Error exposing (Error)
import Std.Money exposing (Money)

-- | A typed property value. New scalar kinds (e.g. `Time`) are added as
-- variants; the pipeline renders each per its type — `Money`, in
-- particular, serialises losslessly as "ISO_CODE AMOUNT" rather than a
-- lossy float, so revenue maths stays exact downstream.
type PropValue
    = VString String
    | VInt Int
    | VFloat Float
    | VBool Bool
    | VMoney Money
    | VPii Pii

-- | One event property: a key and a typed value.
type alias Prop =
    { key : String
    , value : PropValue
    }

-- | Personally-identifiable information. Identity (email, a raw
-- identifier) may enter an event ONLY through this type, never as a
-- bare `String` prop. That makes redaction load-bearing: a sink or
-- context not cleared for PII strips or hashes `Pii` props by type,
-- and the reflective payload deriver (later phase) never emits a plain
-- `String` as PII by accident. In P1 all `Pii` props are redacted.
type Pii
    = PiiEmail String
    | PiiRaw String

-- | An event: a name plus typed properties. This is the open wire
-- shape — a library emits `event "auth.login_succeeded" [...]` with no
-- coupling to the app's own event types. Namespace library event names
-- (`auth.*`, `datepicker.*`).
type alias Event =
    { name : String
    , props : List Prop
    }


-- | Build an event from a name and a list of typed properties.
event : String -> List Prop -> Event
event name props =
    { name = name, props = props }


-- | A `String` property.
string : String -> String -> Prop
string k v =
    { key = k, value = VString v }


-- | An `Int` property.
int : String -> Int -> Prop
int k v =
    { key = k, value = VInt v }


-- | A `Float` property.
float : String -> Float -> Prop
float k v =
    { key = k, value = VFloat v }


-- | A `Bool` property.
bool : String -> Bool -> Prop
bool k v =
    { key = k, value = VBool v }


-- | A `Money` property — the right type for prices, revenue, and cart
-- totals. Serialises losslessly (never as a float), so downstream
-- revenue aggregation stays exact.
money : String -> Money -> Prop
money k v =
    { key = k, value = VMoney v }


-- | A PII property — the only way identity enters an event. Pair with
-- `piiEmail` / `piiRaw` (or the `Pii` constructors) so the value is
-- typed as `Pii` and the pipeline can redact it.
pii : String -> Pii -> Prop
pii k v =
    { key = k, value = VPii v }


-- | Tag a value as an email address (PII).
piiEmail : String -> Pii
piiEmail v =
    PiiEmail v


-- | Tag an arbitrary identifier as PII (a phone number, a raw user id
-- you consider sensitive).
piiRaw : String -> Pii
piiRaw v =
    PiiRaw v


-- | Emit an event built with `event` + the typed prop builders. Writes a
-- structured `[analytics]` line (the default local sink) with PII redacted;
-- later phases route it through the consent gate, context enrichment, and the
-- configured sinks.
track : Event -> Task Error ()
track =
    Ffi.kernel "Analytics_track"


-- | Track a value of your app's OWN typed event union — the ergonomic path.
-- The payload is DERIVED reflectively, so no encoder is needed for the common
-- case: the constructor name becomes a snake_case event name
-- (`ProductViewed` → `"product_viewed"`) and the variant's record fields
-- become typed props (`Money` lossless, a `Pii` field redacted, a plain
-- `String` NEVER treated as PII). Reach for `track` + `event` when you want to
-- rename / reshape / redact a payload by hand.
--
--     type Event
--         = ProductViewed { id : String, price : Money }
--         | Purchased { orderId : String, total : Money }
--
--     Analytics.trackEvent (ProductViewed { id = "SKU-42", price = p })
trackEvent : a -> Task Error ()
trackEvent =
    Ffi.kernel "Analytics_trackEvent"

-- | Consent posture for the current session. The DEFAULT is `Anonymous`, and
-- the module ships default-safe: until you `setConsent Granted`, events are
-- captured with a random anonymous id and NO identity — `identify` records the
-- user but does not attach or send it. `Denied` drops all capture.
type Consent
    = Anonymous
    | Granted
    | Denied


-- | Attach a user id (+ typed traits) to the CURRENT session — the ONLY way
-- identity enters analytics; it is never automatic. The user id is attached to
-- subsequent events, and the traits are sent as an `identify` profile, ONLY
-- once consent is `Granted`. Before that, `identify` just records the id
-- locally, so calling it early (e.g. right after sign-in) is safe.
--
--     Analytics.identify user.id [ Analytics.pii "email" (Analytics.piiEmail user.email) ]
identify : String -> List Prop -> Task Error ()
identify =
    Ffi.kernel "Analytics_identify"


-- | Set the current session's consent posture (see `Consent`). Wire it to your
-- consent banner: `setConsent Granted` on accept, `setConsent Denied` on
-- reject. The default until you call this is `Anonymous`.
setConsent : Consent -> Task Error ()
setConsent =
    Ffi.kernel "Analytics_setConsent"

-- | Where captured events are written. Destinations are app-wide (process
-- global), so `configure` them once at startup. `StderrSink` is the default
-- local/debug sink; `FileSink path` appends JSONL (one event per line, ready
-- for `jq` / DuckDB); `Custom` hands each rendered JSON line to your own Sky
-- function — so ANY destination (a provider POST, a queue) lives in your code
-- without the stdlib pinning a vendor.
--
--     Analytics.configure
--         [ Analytics.FileSink "events.jsonl"
--         , Analytics.Custom (\line -> Http.post "https://collector/ingest" line)
--         ]
type Sink
    = StderrSink
    | FileSink String
    | Custom (String -> Task Error ())


-- | Set the process-global sink list (default `[ StderrSink ]`). Call once at
-- startup, before tracking. An empty list falls back to `StderrSink`.
configure : List Sink -> Task Error ()
configure =
    Ffi.kernel "Analytics_configure"


-- | Right-to-erasure: delete every STORED event for an anonymous or user id,
-- returning the number of rows removed. Deletes from the local store only —
-- events already exported to a provider must be erased there. A no-op (returns
-- 0) when no store is configured.
--
--     Analytics.erase user.id
erase : String -> Task Error Int
erase =
    Ffi.kernel "Analytics_erase"


-- ── query / aggregate helpers (read the store) ─────────────────────────────
-- Common aggregates over the local store — enough for an admin view or the
-- console's "verify + counts". Deep questions (funnels at scale, retention,
-- cohorts) are an export concern: send events to a warehouse and query there.
-- Each returns an empty / zero result when no store is configured.
-- | Total number of captured events in the store.
totalEvents : () -> Task Error Int
totalEvents =
    Ffi.kernel "Analytics_totalEvents"


-- | Count of DISTINCT identified users (events captured after `identify` under
-- `Granted` consent).
uniqueUsers : () -> Task Error Int
uniqueUsers =
    Ffi.kernel "Analytics_uniqueUsers"


-- | Count per event name, most frequent first — e.g. `[ ("page_view", 128),
-- ("product_viewed", 42), ... ]`.
eventCounts : () -> Task Error (List ( String, Int ))
eventCounts =
    Ffi.kernel "Analytics_eventCounts"


-- | The last N events, each a JSON object string (ts, event, and any of
-- anonymous_id / user_id / props / context). Decode with `Sky.Core.Json.Decode`
-- or render as-is; the newest event is first.
recentEvents : Int -> Task Error (List String)
recentEvents =
    Ffi.kernel "Analytics_recentEvents"
