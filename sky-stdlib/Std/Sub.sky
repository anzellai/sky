-- | Std.Sub — TEA-side inbound subscriptions (Layer 3 Sky source).
--
-- A `Sub msg` represents an ongoing stream of `msg` values
-- delivered to `update`.  Use `Sub.every` for periodic ticks
-- (animation, polling, …) and `Sub.none` when there's nothing
-- to subscribe to.
module Std.Sub exposing
    ( none
    , every
    , everyWithTime
    , batch
    , subscribeTopic
    , onFragment
    , ConnectionState(..)
    , connection
    )

import Sky.Ffi as Ffi


none : Sub msg
none =
    Ffi.kernel "Sub_none"


-- | `every intervalMillis msg` — dispatch `msg` every
-- `intervalMillis` milliseconds. A tick is a wake-up, not a clock: a browser
-- or webview throttles timers in a background tab, so read the time the tick
-- carries (`everyWithTime`) instead of counting ticks. In a Sky.Spa client a
-- tick whose update calls the server is coalesced while its previous call is unsettled,
-- and while the page is hidden only the first such call goes out; on return
-- one fresh tick runs at once.
every : Int -> msg -> Sub msg
every =
    Ffi.kernel "Sub_every"


-- | `everyWithTime intervalMillis toMsg` — like `every`, but each tick's Msg
-- carries the time of the tick, in epoch milliseconds. The form for a clock,
-- a stopwatch or a countdown: derive the elapsed time from the time the tick
-- carries, so a throttled background tab cannot make it drift.
--
--     subscriptions _ =
--         Sub.everyWithTime 100 Tick -- Tick : Int -> Msg
everyWithTime : Int -> (Int -> msg) -> Sub msg
everyWithTime =
    Ffi.kernel "Sub_every"


-- | `batch subs` — combine multiple subscriptions into one. Composes
-- `Sub.every` with `Sub.subscribeTopic` so a session can tick on a
-- timer AND receive pub/sub broadcasts in a single `subscriptions`
-- evaluation.
batch : List (Sub msg) -> Sub msg
batch =
    Ffi.kernel "Sub_batch"


-- | `subscribeTopic topic toMsg` — receive pub/sub broadcasts on
-- `topic`. The `toMsg : any -> msg` decoder is called with each
-- incoming payload; its result is dispatched to `update` exactly
-- like any other Msg.
--
-- Subscriptions are exact-match by topic name (no wildcards). Use
-- string concatenation to build per-room / per-user topics, e.g.
-- `("chat-" ++ roomId)` or `("user:" ++ userId)`. A user-scoped
-- topic is the same-user cross-session sync primitive: every one of
-- a signed-in user's sessions subscribes to `("user:" ++ userId)`,
-- and a publish reaches them all — across devices AND, on a
-- multi-instance deploy, across instances via the Redis broker.
--
-- The runtime cleans up subscriptions automatically when:
--
--  * The next `subscriptions model` evaluation no longer mentions
--    this topic (diff-mode update).
--  * The session is evicted (TTL or explicit `markDone`).
--
-- See `docs/skylive/pubsub-design.md` §3.3 + §4 for the lifecycle.
subscribeTopic : String -> (any -> msg) -> Sub msg
subscribeTopic =
    Ffi.kernel "Sub_subscribeTopic"


-- | `onFragment toMsg` — receive the URL fragment (the text after `#`, as
-- written in the URL, without the `#`) on Sky.Live, Sky.Spa and every
-- `Std.App` web / desktop / mobile target. The fragment arrives when the page
-- loads with one, and on every change of it in the browser (`hashchange`: a
-- link to `#section`, Back, or a script setting `location.hash`); a removed
-- fragment arrives as `""`. A browser never sends the fragment to the server,
-- so it is not known to `init`: keep a default in the model and let this
-- subscription fill it. A terminal app has no URL; there it never fires.
--
--     subscriptions _ =
--         Sub.onFragment FragmentChanged
onFragment : (String -> msg) -> Sub msg
onFragment =
    Ffi.kernel "Sub_onFragment"

-- | The client's connection to its server, as `connection` reports it.
-- `Online`: requests reach the server. `Reconnecting`: a request failed for a
-- moment (no network, a timeout, a 502 / 503 / 504 during a deploy) and the
-- runtime is re-sending it by itself. `Offline { pending }`: the runtime gave
-- up after its retry budget; `pending` requests wait for the connection to
-- return (or for the Retry button).
type ConnectionState
    = Online
    | Reconnecting
    | Offline { pending : Int }


-- | `connection toMsg` — receive the client's `ConnectionState` on every
-- change, for an app that wants its own indicator. Optional: a Sky.Spa client
-- already re-sends a transiently failing request by itself and shows a quiet
-- "Reconnecting…" indicator after 3 seconds, then the "Can't reach the
-- server" bar once its retry budget is spent. A change of state reaches
-- `update` even while a server call holds the queue. Sky.Live and terminal
-- apps keep their own connection handling: there it never fires, so keep
-- `Online` as the model's default.
--
--     subscriptions _ =
--         Sub.connection ConnectionChanged
connection : (ConnectionState -> msg) -> Sub msg
connection toMsg =
    connectionCodes (\code pending -> toMsg (connectionStateOf code pending))


connectionStateOf : Int -> Int -> ConnectionState
connectionStateOf code pending =
    if code == 1 then
        Reconnecting

    else if code == 2 then
        Offline { pending = pending }

    else
        Online


connectionCodes : (Int -> Int -> msg) -> Sub msg
connectionCodes =
    Ffi.kernel "Sub_connectionCodes"
