-- | Std.Tui — terminal UI backend (Layer 3 Sky source).
--
-- **DEPRECATED for direct use — write `Std.App` instead.** `Std.App` composes
-- this module for `--target terminal:tui`: an `App.app` `Std.Ui` `Element` view
-- renders via `Tui.app`, and an `App.tui` hand-authored `String` view renders
-- full-screen via `Tui.program` (now first-class on `Std.App`). Nothing in user
-- code needs to import `Std.Tui` directly any more — there is no remaining
-- escape hatch. Still functional because `Std.App` uses it. New code: `App.tui`
-- (String view) or `App.app` (Std.Ui) + `App.run`. See docs/skyapp/overview.md.
--
-- The same TEA shape as `Live.app` / `Webview.app`, rendered to ANSI cells.
-- `Tui.config { init, update, view, subscriptions }` produces an opaque
-- `AppConfig`; attach the optional key handler / guard / canvas size with the
-- `withX` builders. Two entry points share the one config: `app` (the
-- Std.Ui-rendered full-screen app) and `program` (a lighter loop that
-- requires an `onKey` handler). Every binding is an `Ffi.kernel` alias
-- carrying its real HM signature, so the type-checker, LSP hover, and
-- `sky doc` all read this ONE file.
--
-- ```elm
-- main =
--     Tui.app
--         (Tui.config
--             { init = init, update = update, view = view
--             , subscriptions = subscriptions
--             }
--             |> Tui.withOnKey onKey
--         )
--         |> Task.run
-- ```
module Std.Tui exposing
    ( AppConfig
    , app
    , program
    , config
    , withOnKey
    , withGuard
    , withCanvasWidth
    , withCanvasHeight
    )

import Sky.Ffi as Ffi
import Sky.Core.Error exposing (Error)

-- | The built Sky.Tui app configuration. Opaque — produced by `config`,
-- refined by the `withX` builders, consumed by `app` / `program`.
type AppConfig model msg
    = AppConfig_OPAQUE


-- | Build the app config from the four required fields. `view` is
-- polymorphic in its render type — `app` renders a `Std.Ui.Element msg`
-- tree, `program` renders a plain `String`.
config : { init : a -> ( model, Cmd msg )
, update : msg -> model -> ( model, Cmd msg )
, view : model -> render
, subscriptions : model -> Sub msg
} -> AppConfig model msg
config =
    Ffi.kernel "Tui_config"


-- | Run a full-screen Std.Ui-rendered terminal app.
app : AppConfig model msg -> Task Error ()
app =
    Ffi.kernel "Tui_app"


-- | Run the lighter terminal loop (string `view`); requires an `onKey`
-- handler attached via `withOnKey`.
program : AppConfig model msg -> Task Error ()
program =
    Ffi.kernel "Tui_program"


-- | Attach a raw key-event handler — `onKey keyEvent` yields a `msg`. The
-- key-event type is whatever your handler declares (examples define a local
-- `KeyEvent` record alias).
withOnKey : (key -> msg) -> AppConfig model msg -> AppConfig model msg
withOnKey =
    Ffi.kernel "Tui_withOnKey"


-- | Attach a per-Msg guard — `guard msg model` returns `Err` to reject the
-- message before `update` runs.
withGuard : (msg -> model -> Result Error ()) -> AppConfig model msg -> AppConfig model msg
withGuard =
    Ffi.kernel "Tui_withGuard"


-- | Override the logical design width in pixels (default 1280).
withCanvasWidth : Int -> AppConfig model msg -> AppConfig model msg
withCanvasWidth =
    Ffi.kernel "Tui_withCanvasWidth"


-- | Override the logical design height in pixels (default 720).
withCanvasHeight : Int -> AppConfig model msg -> AppConfig model msg
withCanvasHeight =
    Ffi.kernel "Tui_withCanvasHeight"
