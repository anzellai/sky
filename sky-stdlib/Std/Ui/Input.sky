-- | Std.Ui.Input — typed form controls for `Std.Ui`.
--
-- `button / text / multiline / email / username / search /
-- currentPassword / newPassword / checkbox / radio / radioRow /
-- slider` build typed `Element msg` form widgets with labels and
-- typed event slots.  Password fields obey the v0.15 best-practice
-- pattern — pair with `Ui.form` + `onSubmit DoSignIn` rather than
-- per-keystroke `onInput`, so the secret never lands in Model and
-- the browser password manager doesn't re-prompt on every render.
module Std.Ui.Input exposing
    ( button
    , text
    , multiline
    , email
    , username
    , search
    , currentPassword
    , newPassword
    , checkbox
    , radio
    , radioRow
    , slider
    , option
    , labelAbove
    , labelBelow
    , labelLeft
    , labelRight
    , labelHidden
    , placeholder
    , Label
    , Placeholder
    , RadioOption
    )

-- Std.Ui.Input — typed form controls.
--
-- Each control takes a record with the relevant config (onChange,
-- label, value, etc.) and returns an Element. Labels are first-class
-- (`labelAbove` / `labelLeft` / `labelHidden`) so accessible
-- labelling is built in by construction.
--
-- The radio surface uses string-valued options (`RadioOption msg =
-- RadioOption String (Element msg)`) rather than a fully polymorphic
-- option type. This is a deliberate trade-off: a polymorphic
-- `RadioOption option msg` triggers Sky's HM cross-branch friction
-- (deeply nested polymorphic record arguments holding parameterised
-- ADTs in field positions), and the string-keyed shape works with
-- the typed-Msg dispatch boundary that Sky.Live's `update` function
-- already uses for form data.
import Sky.Core.Prelude exposing (..)
import Sky.Core.String as String
import Sky.Core.List as List
import Std.Ui as Ui
import Std.Ui exposing (Element, Attribute(..))

-- A label paired with an Element. `labelAbove` / `labelBelow` /
-- `labelLeft` / `labelRight` set the position; `labelHidden` keeps
-- the label semantically present (for screen readers) but visually
-- hidden.
type Label msg
    = Label LabelPosition (List (Attribute msg)) (Element msg)
    | LabelHidden String

type LabelPosition
    = AbovePos
    | BelowPos
    | LeftPos
    | RightPos

-- Placeholder text shown inside an empty input. Wrap a `Ui.text "..."`
-- to set the placeholder string; non-`Text` placeholders are
-- silently ignored (HTML's `placeholder` attr is text-only).
type Placeholder msg
    = Placeholder (List (Attribute msg)) (Element msg)

-- A single choice in a `radio` / `radioRow` group: a string value
-- (sent back via the typed onChange callback when this option is
-- selected) and a visible label Element.
type RadioOption msg
    = RadioOption String (Element msg)


labelAbove : List (Attribute msg) -> Element msg -> Label msg
labelAbove attrs el =
    Label AbovePos attrs el


labelBelow : List (Attribute msg) -> Element msg -> Label msg
labelBelow attrs el =
    Label BelowPos attrs el


labelLeft : List (Attribute msg) -> Element msg -> Label msg
labelLeft attrs el =
    Label LeftPos attrs el


labelRight : List (Attribute msg) -> Element msg -> Label msg
labelRight attrs el =
    Label RightPos attrs el


labelHidden : String -> Label msg
labelHidden s =
    LabelHidden s


placeholder : List (Attribute msg) -> Element msg -> Placeholder msg
placeholder attrs el =
    Placeholder attrs el


-- Construct a single radio option from its string value + label
-- Element.
option : String -> Element msg -> RadioOption msg
option value labelEl =
    RadioOption value labelEl


-- ─── Controls ────────────────────────────────────────────────────

-- Button. Set `onPress = Nothing` to render a disabled button (the
-- runtime adds `disabled="true"` so the browser greys it out and
-- ignores clicks).
button : List (Attribute msg) -> { onPress : Maybe msg
, label : Element msg
} -> Element msg
button attrs cfg =
    Ui.button attrs cfg


-- Single-line text input. The change handler fires on every
-- keystroke per Sky.Live's input-event semantics.
text : List (Attribute msg) -> { onChange : String -> msg
, text : String
, placeholder : Maybe (Placeholder msg)
, label : Label msg
} -> Element msg
text attrs cfg =
    inputBase "text" attrs cfg


-- Email-typed text input. Renders as `<input type="email">` so
-- mobile browsers show the @-aware keyboard and HTML5 form
-- validation kicks in.
email : List (Attribute msg) -> { onChange : String -> msg
, text : String
, placeholder : Maybe (Placeholder msg)
, label : Label msg
} -> Element msg
email attrs cfg =
    inputBase "email" attrs cfg


-- Username-typed text input — identical to `text` plus
-- `autocomplete="username"` so password managers recognise it as a
-- sign-in field.
username : List (Attribute msg) -> { onChange : String -> msg
, text : String
, placeholder : Maybe (Placeholder msg)
, label : Label msg
} -> Element msg
username attrs cfg =
    inputBase "text" (Ui.htmlAttribute "autocomplete" "username" :: attrs) cfg


-- Search input. Renders as `<input type="search">` (mobile clear
-- button + dedicated search keyboard on some platforms).
search : List (Attribute msg) -> { onChange : String -> msg
, text : String
, placeholder : Maybe (Placeholder msg)
, label : Label msg
} -> Element msg
search attrs cfg =
    inputBase "search" attrs cfg


-- Password input — current-password autocomplete (sign-in flows).
-- Per Sky.Live's "Forms with passwords" doctrine in CLAUDE.md you
-- normally want `Ui.form` + `onSubmit` rather than wiring `onChange`
-- on every keystroke; this control is here for cases where you do
-- need per-keystroke updates (validation feedback, strength meters).
currentPassword : List (Attribute msg) -> { onChange : String -> msg
, text : String
, placeholder : Maybe (Placeholder msg)
, label : Label msg
, show : Bool
} -> Element msg
currentPassword attrs cfg =
    let
        passType =
            if cfg.show then
                "text"

            else
                "password"
        baseAttrs =
            Ui.htmlAttribute "autocomplete" "current-password" :: attrs
    in
        inputBase
            passType
            baseAttrs
            { onChange = cfg.onChange
            , text = cfg.text
            , placeholder = cfg.placeholder
            , label = cfg.label
            }


-- Password input — new-password autocomplete (sign-up / change-password
-- flows). Same `show` toggle as `currentPassword`.
newPassword : List (Attribute msg) -> { onChange : String -> msg
, text : String
, placeholder : Maybe (Placeholder msg)
, label : Label msg
, show : Bool
} -> Element msg
newPassword attrs cfg =
    let
        passType =
            if cfg.show then
                "text"

            else
                "password"
        baseAttrs = Ui.htmlAttribute "autocomplete" "new-password" :: attrs
    in
        inputBase
            passType
            baseAttrs
            { onChange = cfg.onChange
            , text = cfg.text
            , placeholder = cfg.placeholder
            , label = cfg.label
            }


-- Multi-line `<textarea>`. Same shape as `text` but the underlying
-- HTML element is `<textarea>`, not `<input>`. `<input type="textarea">`
-- is NOT a valid HTML form control — every browser silently falls
-- back to a single-line text input, so routing through `inputBase
-- "textarea"` (which builds a `Ui.input` element) silently broke
-- multi-line editing in the browser. Pre-fix symptom: the
-- `<textarea>` mini-notion needs (page body editor, multi-paragraph
-- forms) rendered as a one-line field that swallowed every Enter
-- keystroke into form submit. TUI was unaffected (it inspects the
-- `type` attr directly and has its own textarea editor).
--
-- The textarea's value lives between the tags as text content, not
-- as a `value` attribute. Sky.Live's renderer already strips the
-- `value` attr and splices it as text content, so we pass `cfg.text`
-- via the value attr for codegen uniformity; the renderer's textarea
-- branch in `runtime-go/rt/live.go` handles the dance. The TUI side
-- still consults the `type="textarea"` attr for its multiline-editor
-- code path, so keep it on the attribute list.
multiline : List (Attribute msg) -> { onChange : String -> msg
, text : String
, placeholder : Maybe (Placeholder msg)
, label : Label msg
, spellcheck : Bool
} -> Element msg
multiline attrs cfg =
    let
        spellAttr =
            if cfg.spellcheck then
                Ui.htmlAttribute "spellcheck" "true"

            else
                Ui.htmlAttribute "spellcheck" "false"
        placeholderAttr =
            case cfg.placeholder of

                Just (Placeholder _ el) ->
                    placeholderTextOf el

                Nothing ->
                    []
        layoutAndControl = splitLayoutAttrs attrs
        layoutAttrs = fst layoutAndControl
        controlAttrs = snd layoutAndControl
        baseAttrs =
            Ui.htmlAttribute "type" "textarea"
                :: Ui.htmlAttribute "value" cfg.text
                :: spellAttr
                :: Ui.onInput cfg.onChange
                :: placeholderAttr
                ++ controlAttrs
                ++ implicitFillIfHoisted layoutAttrs
        textareaEl = Ui.TaggedNode "textarea" Ui.NoDescription baseAttrs []
    in
        wrapWithLabel cfg.label layoutAttrs textareaEl


-- Checkbox. The icon is the visual checkmark element (use a simple
-- unicode tick for now or a custom Element).
checkbox : List (Attribute msg) -> { onChange : Bool -> msg
, icon : Bool -> Element msg
, checked : Bool
, label : Label msg
} -> Element msg
checkbox attrs cfg =
    let
        layoutAndControl = splitLayoutAttrs attrs
        layoutAttrs = fst layoutAndControl
        controlAttrs = snd layoutAndControl
        checkInput =
            inputElement
                "checkbox"
                (cfg.onChange (not cfg.checked))
                (if cfg.checked then
                    "true"

                else
                    "false")
        iconEl = cfg.icon cfg.checked
        rowBaseAttrs =
            Ui.spacing 8 :: controlAttrs ++ implicitFillIfHoisted layoutAttrs
    in
        wrapWithLabel
            cfg.label
            layoutAttrs
            (Ui.row rowBaseAttrs [ checkInput, iconEl ])


-- Radio button group — vertical layout. Each `RadioOption value
-- labelEl` becomes one selectable choice; clicking dispatches
-- `onChange value`. `selected` is the currently-active value.
radio : List (Attribute msg) -> { onChange : String -> msg
, options : List (RadioOption msg)
, selected : String
, label : Label msg
} -> Element msg
radio attrs cfg =
    let
        layoutAndControl = splitLayoutAttrs attrs
        layoutAttrs = fst layoutAndControl
        controlAttrs = snd layoutAndControl
        renderedOptions =
            List.map (renderRadioOption cfg.onChange cfg.selected) cfg.options
        columnBaseAttrs =
            Ui.spacing 6 :: controlAttrs ++ implicitFillIfHoisted layoutAttrs
    in
        wrapWithLabel
            cfg.label
            layoutAttrs
            (Ui.column columnBaseAttrs renderedOptions)


-- Radio button group — horizontal layout. Same args as `radio`,
-- children flow left-to-right.
radioRow : List (Attribute msg) -> { onChange : String -> msg
, options : List (RadioOption msg)
, selected : String
, label : Label msg
} -> Element msg
radioRow attrs cfg =
    let
        layoutAndControl = splitLayoutAttrs attrs
        layoutAttrs = fst layoutAndControl
        controlAttrs = snd layoutAndControl
        renderedOptions =
            List.map (renderRadioOption cfg.onChange cfg.selected) cfg.options
        rowBaseAttrs =
            Ui.spacing 12 :: controlAttrs ++ implicitFillIfHoisted layoutAttrs
    in
        wrapWithLabel
            cfg.label
            layoutAttrs
            (Ui.row rowBaseAttrs renderedOptions)


-- Range slider — `<input type="range">`. The change handler receives
-- the slider's value as a String (it round-trips through the DOM as
-- text); use `String.toFloat` or `String.toInt` to parse. `min`,
-- `max`, `step`, and `value` are pre-rendered as Strings so the
-- handler can stay String-typed.
slider : List (Attribute msg) -> { onChange : String -> msg
, value : String
, min : String
, max : String
, step : String
, label : Label msg
} -> Element msg
slider attrs cfg =
    let
        layoutAndControl = splitLayoutAttrs attrs
        layoutAttrs = fst layoutAndControl
        controlAttrs = snd layoutAndControl
        baseAttrs =
            Ui.htmlAttribute "type" "range"
                :: Ui.htmlAttribute "value" cfg.value
                :: Ui.htmlAttribute "min" cfg.min
                :: Ui.htmlAttribute "max" cfg.max
                :: Ui.htmlAttribute "step" cfg.step
                :: Ui.onInput cfg.onChange
                :: controlAttrs
                ++ implicitFillIfHoisted layoutAttrs
    in
        wrapWithLabel cfg.label layoutAttrs (Ui.input baseAttrs)


-- ─── Internals ───────────────────────────────────────────────────

-- Build the bare input element with type, change handler, value.
-- Renders as a real <input> via `Ui.input` (Ui.el would render
-- as <div> and the browser would ignore the type/value attrs and
-- never fire input events).
inputBase : String -> List (Attribute msg) -> { onChange : String -> msg
, text : String
, placeholder : Maybe (Placeholder msg)
, label : Label msg
} -> Element msg
inputBase inputType attrs cfg =
    let
        placeholderAttr =
            case cfg.placeholder of

                Just (Placeholder _ el) ->
                    placeholderTextOf el

                Nothing ->
                    []
        layoutAndControl = splitLayoutAttrs attrs
        layoutAttrs = fst layoutAndControl
        controlAttrs = snd layoutAndControl
        baseAttrs =
            Ui.htmlAttribute "type" inputType
                :: Ui.htmlAttribute "value" cfg.text
                :: Ui.onInput cfg.onChange
                :: placeholderAttr
                ++ controlAttrs
                ++ implicitFillIfHoisted layoutAttrs
        inputEl = Ui.input baseAttrs
    in
        wrapWithLabel cfg.label layoutAttrs inputEl


-- Render a single radio option — a clickable `<input type="radio">`
-- + its visible label, wrapped in a `<label>` element so clicking
-- the text also activates the radio.
renderRadioOption : (String -> msg) -> String -> RadioOption msg -> Element msg
renderRadioOption onChange selected RadioOption value labelEl =
    let
        isChecked = value == selected
        checkedAttr =
            if isChecked then
                [Ui.htmlAttribute "checked" "checked"]

            else
                []
        radioInput =
            Ui.input
                ([ Ui.htmlAttribute "type" "radio"
                , Ui.htmlAttribute "value" value
                , Ui.onClick (onChange value)
                ]
                    ++ checkedAttr)
    in
        Ui.row [ Ui.spacing 6, Ui.pointer ] [ radioInput, labelEl ]


-- Internal: extract a single placeholder string from the Element
-- inside a `Placeholder` value. HTML's `placeholder` attribute is
-- text-only, so non-`Text` Elements are silently ignored.
placeholderTextOf : Element msg -> List (Attribute msg)
placeholderTextOf el =
    let
        s = extractText el
    in
        if String.isEmpty s then
            []

        else
            [Ui.htmlAttribute "placeholder" s]


extractText : Element msg -> String
extractText el =
    Ui.elementText el


-- Internal: build a bare input element by tag for fixed-msg controls
-- like checkbox toggle (the change handler is `msg`, not (String -> msg),
-- because the user clicked rather than typed).
inputElement : String -> msg -> String -> Element msg
inputElement inputType msg val =
    Ui.input
        [ Ui.htmlAttribute "type" inputType
        , Ui.htmlAttribute "value" val
        , Ui.onClick msg
        ]


-- Internal: partition user `attrs` into (layoutAttrs, controlAttrs).
-- Layout / size / alignment attrs hoist to the wrapWithLabel
-- wrapper so a user's `Ui.width fill` / `Ui.height fill` /
-- `Ui.padding 16` / `Ui.alignTop` etc. apply to the outer
-- container (the `Ui.el` / `Ui.row` / `Ui.column` `wrapWithLabel`
-- emits). Form / input / event / visual-style attrs stay on the
-- inner control (`<textarea>`, `<input>`, ...) where they belong.
--
-- Without this split, the wrapper has no layout attrs at all, so
-- inside `Ui.row [Ui.height fill, Ui.width fill] [Input.multiline ...]`
-- the wrapper collapses at `flex: 0 0 auto` while the user's
-- intent (let the textarea fill the row) silently drops on the
-- floor. Closes the v0.15.55 follow-up to GitHub #63.
splitLayoutAttrs : List (Attribute msg) -> ( List (Attribute msg), List (Attribute msg) )
splitLayoutAttrs attrs =
    splitLayoutAttrsHelp attrs [] []


splitLayoutAttrsHelp : List (Attribute msg) -> List (Attribute msg) -> List (Attribute msg) -> ( List (Attribute msg), List (Attribute msg) )
splitLayoutAttrsHelp attrs layoutAcc controlAcc =
    case attrs of

        [] ->
            ( List.reverse layoutAcc, List.reverse controlAcc )

        a :: rest ->
            if isLayoutAttr a then
                splitLayoutAttrsHelp rest (a :: layoutAcc) controlAcc

            else
                splitLayoutAttrsHelp rest layoutAcc (a :: controlAcc)


-- Layout / size / alignment attrs that should land on the wrapper
-- div, not on the underlying form control. Visual-style attrs
-- (AttrFontSize / AttrBgColor / AttrBorderWidth etc.) STAY on the
-- control — they style the input itself, not the wrapper.
isLayoutAttr : Attribute msg -> Bool
isLayoutAttr attr =
    case attr of

        AttrWidth _ ->
            True

        AttrHeight _ ->
            True

        AttrAlignX _ ->
            True

        AttrAlignY _ ->
            True

        AttrPadding _ _ _ _ ->
            True

        AttrSpacing _ ->
            True

        AttrNearby _ _ ->
            True

        AttrPointer ->
            True

        AttrOverflow _ _ ->
            True

        _ ->
            False


-- When at least one layout attr was hoisted to the wrapper, the
-- inner control becomes implicit `Ui.fill` of the wrapper so the
-- hoisted layout flows through. Without this, `Ui.width fill` on
-- the wrapper has nothing to stretch against (the textarea sits
-- at content-line height). When NO layout attrs are supplied —
-- the default for compact / shrink-to-content inputs — we emit no
-- implicit fill so the inputs keep their natural intrinsic size.
implicitFillIfHoisted : List (Attribute msg) -> List (Attribute msg)
implicitFillIfHoisted layoutAttrs =
    if List.isEmpty layoutAttrs then
        []

    else
        [ Ui.width Ui.fill, Ui.height Ui.fill ]


-- Wrap a control in its label according to LabelPosition. Hidden
-- labels emit aria-label on the wrapper for screen-reader access.
wrapWithLabel : Label msg -> List (Attribute msg) -> Element msg -> Element msg
wrapWithLabel lbl wrapperAttrs control =
    case lbl of

        LabelHidden text ->
            Ui.el (Ui.htmlAttribute "aria-label" text :: wrapperAttrs) control

        Label pos labelAttrs labelEl ->
            case pos of

                AbovePos ->
                    Ui.column wrapperAttrs [ Ui.el labelAttrs labelEl, control ]

                BelowPos ->
                    Ui.column wrapperAttrs [ control, Ui.el labelAttrs labelEl ]

                LeftPos ->
                    Ui.row wrapperAttrs [ Ui.el labelAttrs labelEl, control ]

                RightPos ->
                    Ui.row wrapperAttrs [ control, Ui.el labelAttrs labelEl ]
