-- | Std.Ui.Terminal — an interactive terminal element bound to a PTY process
-- (v0.27.0, Sky.Live).
--
-- The element is a widget island (`Ui.island`) with a built-in widget that
-- draws the terminal on a canvas and ships inside the Sky client files (no
-- script to load, strict-CSP clean). The process is a `Sky.Core.Process`
-- spawned with `withPty`. The terminal itself is emulated on the server
-- (`Process.screen`): the runtime runs every output byte through a VT100 /
-- xterm screen as the process writes it, and the widget only draws what the
-- screen says. This module wires the two together:
--
--   * the screen streams to the widget as screen-diff frames: scrolls,
--     changed row spans with their colours, the cursor, the title, the bell
--     (`Process.screen`, then `Cmd.toIsland` "frame"). A flood of output is
--     one frame per paint at most: the bytes in between coalesce;
--   * a key press in the widget reaches `Process.write` as typed input;
--   * a size change of the widget reaches `Process.resize`;
--   * a remount (a reload, a lost connection, a navigation back) repaints
--     from the current screen and its scrollback (the last 1000 lines), not
--     by replaying the output bytes; a widget that sees a frame was lost on
--     the way asks for the same repaint.
--
-- The app code is three calls: keep a `Terminal` in the model, forward its
-- messages to `update`, and render `view`:
--
--     import Sky.Core.Process as Process
--     import Std.Ui.Terminal as Terminal
--
--     type Msg
--         = Spawned (Result Error Process.Process)
--         | Term Terminal.Msg
--
--     init _ =
--         ( { term = Terminal.init "shell" }
--         , Cmd.perform
--             (Process.command "sh"
--                 |> Process.withPty { cols = 80, rows = 24 }
--                 |> Process.spawn)
--             Spawned
--         )
--
--     update msg model =
--         case msg of
--             Spawned (Ok p) ->
--                 Terminal.attach Term p model.term
--                     |> Tuple.mapFirst (\t -> { model | term = t })
--             Spawned (Err _) ->
--                 ( model, Cmd.none )
--             Term m ->
--                 Terminal.update Term m model.term
--                     |> Tuple.mapFirst (\t -> { model | term = t })
--
--     view model =
--         Terminal.view Term model.term [ Ui.height (Ui.px 400) ]
--
-- No subscription is needed: the screen is read by a chain of `Cmd.perform`
-- reads.
--
-- Targets. Sky.Live (`--target web`, and the `desktop` window) is supported.
-- A Sky.Spa build (`web:app` and the native client targets) refuses a
-- program that uses this module: the PTY lives on the server, and Sky.Spa
-- cannot send a widget command from a server branch. A terminal target
-- renders the empty element.
module Std.Ui.Terminal exposing (Terminal, Msg, init, attach, update, view, process, exitStatus)

import Sky.Core.Prelude exposing (..)
import Sky.Core.Error exposing (Error)
import Sky.Core.Json.Encode as Encode
import Sky.Core.Json.Decode as Decode
import Sky.Core.Process as Process exposing (Process, Screen, ExitStatus)
import Std.Cmd as Cmd
import Std.Ui as Ui exposing (Element, Attribute)

-- | The state of one terminal element. Opaque.
type Terminal
    = Terminal State

type alias State =
    { id : String
    , proc : Maybe Process
    , gen : Int
    , cols : Int
    , rows : Int
    , exit : Maybe ExitStatus
    }

-- | A terminal message. Forward it to `update`.
type Msg
    = Ready
    | Input String
    | Resized Int Int
    | Frame Int (Result Error Screen)
    | Waited Int (Result Error ExitStatus)
    | Done (Result Error ())


-- | A terminal element with this id (unique on the page) and no process yet.
init : String -> Terminal
init id =
    Terminal
        { id = id, proc = Nothing, gen = 0, cols = 0, rows = 0, exit = Nothing }


-- | The process shown in the terminal, if one is attached.
process : Terminal -> Maybe Process
process term =
    case term of

        Terminal st ->
            st.proc


-- | How the attached process ended, once it has.
exitStatus : Terminal -> Maybe ExitStatus
exitStatus term =
    case term of

        Terminal st ->
            st.exit


-- | Show `proc` in the terminal (a process spawned with `Process.withPty`).
-- The widget is repainted from the process's screen. When the widget has
-- already reported its size, the PTY is resized to it.
attach : (Msg -> msg) -> Process -> Terminal -> ( Terminal, Cmd msg )
attach toMsg proc term =
    case term of

        Terminal st ->
            let
                next =
                    { st | proc = Just proc, gen = st.gen + 1, exit = Nothing }
                resizeCmd =
                    if st.cols > 0 && st.rows > 0 then
                        [ Cmd.perform
                              (Process.resize
                                  proc
                                  { cols = st.cols, rows = st.rows })
                              (\r -> toMsg (Done r))
                        ]

                    else
                        []
            in
                ( Terminal next
                , Cmd.batch (readCmd toMsg next True proc :: resizeCmd)
                )


-- | Handle a terminal message.
update : (Msg -> msg) -> Msg -> Terminal -> ( Terminal, Cmd msg )
update toMsg msg term =
    case term of

        Terminal st ->
            case msg of

                Ready ->
                    -- A (re)mounted widget holds nothing: repaint it from the
                    -- screen. A new generation retires the read in flight.
                    let
                        next = { st | gen = st.gen + 1 }
                    in
                        case st.proc of

                            Just p ->
                                ( Terminal next, readCmd toMsg next True p )

                            Nothing ->
                                ( Terminal next, Cmd.none )

                Input data ->
                    case st.proc of

                        Just p ->
                            ( term
                            , Cmd.perform
                                  (Process.write p data)
                                  (\r -> toMsg (Done r))
                            )

                        Nothing ->
                            ( term, Cmd.none )

                Resized rawCols rawRows ->
                    let
                        -- The widget clamps its size to the PTY bound; a
                        -- crafted event may not, so clamp here too.
                        cols = clampDim maxCols rawCols
                        rows = clampDim maxRows rawRows
                        next = Terminal { st | cols = cols, rows = rows }
                    in
                        case st.proc of

                            Just p ->
                                ( next
                                , Cmd.perform
                                      (Process.resize
                                          p
                                          { cols = cols, rows = rows })
                                      (\r -> toMsg (Done r))
                                )

                            Nothing ->
                                ( next, Cmd.none )

                Frame gen result ->
                    if gen /= st.gen then
                        -- A read of an earlier generation: the current one
                        -- repaints.
                        ( term
                        , Cmd.none
                        )

                    else
                        case ( result, st.proc ) of

                            ( Ok screen, Just p ) ->
                                let
                                    frame =
                                        if screen.changed then
                                            [ Cmd.toIsland
                                                  st.id
                                                  "frame"
                                                  screen.frame
                                            ]

                                        else
                                            []
                                    follow =
                                        if screen.eof then
                                            Cmd.perform
                                                (Process.wait p)
                                                (\r -> toMsg (Waited gen r))

                                        else
                                            readCmd toMsg st False p
                                in
                                    ( term, Cmd.batch (frame ++ [ follow ]) )

                            ( Err _, Just _ ) ->
                                -- The process is not live in this server any
                                -- more (closed, its session ended, or the
                                -- server restarted): drop it, so `process`
                                -- is Nothing and the app can spawn and
                                -- attach a new one.
                                ( ended st, Cmd.none )

                            _ ->
                                ( term, Cmd.none )

                Waited gen result ->
                    case result of

                        Ok status ->
                            ( Terminal { st | exit = Just status }, Cmd.none )

                        Err _ ->
                            if gen == st.gen then
                                ( ended st, Cmd.none )

                            else
                                ( term, Cmd.none )

                Done _ ->
                    ( term, Cmd.none )


-- | The terminal element. It fills the width of its parent and is 360 px
-- tall unless the attributes say otherwise; the widget fits as many columns
-- and rows as the box holds and resizes the PTY to them.
view : (Msg -> msg) -> Terminal -> List (Attribute msg) -> Element msg
view toMsg term attrs =
    case term of

        Terminal st ->
            Ui.island
                { name = "sky-terminal"
                , id = st.id
                , props =
                    Encode.object
                        [ ( "label", Encode.string ("Terminal " ++ st.id) ) ]
                }
                ([ Ui.width Ui.fill
                , Ui.height (Ui.px 360)
                , Ui.onIslandEvent
                      "ready"
                      (Decode.succeed ())
                      (\_ -> toMsg Ready)
                , Ui.onIslandEvent
                      "input"
                      (Decode.field "data" Decode.string)
                      (\s -> toMsg (Input s))
                , Ui.onIslandEvent
                      "resize"
                      (Decode.map2
                          (\c r -> ( c, r ))
                          (Decode.field "cols" Decode.int)
                          (Decode.field "rows" Decode.int))
                      (\( c, r ) -> toMsg (Resized c r))
                ]
                    ++ attrs)


-- The attached process is gone: forget it, and retire the reads in flight.
ended : State -> Terminal
ended st =
    Terminal { st | proc = Nothing, gen = st.gen + 1 }


-- The largest PTY the runtime accepts (Process.resize refuses a larger one).
maxCols : Int
maxCols =
    500


maxRows : Int
maxRows =
    200


clampDim : Int -> Int -> Int
clampDim hi n =
    if n < 1 then
        1

    else if n > hi then
        hi

    else
        n


-- Read the next screen frame for this widget: wait up to 20 s for a change,
-- so an idle terminal costs one read every 20 s (a short check frame follows
-- the last frame of a burst; see Process.screen).
readCmd : (Msg -> msg) -> State -> Bool -> Process -> Cmd msg
readCmd toMsg st full p =
    Cmd.perform
        (Process.screen
            { view = st.id, gen = st.gen, full = full, waitMs = 20000 }
            p)
        (\r -> toMsg (Frame st.gen r))
