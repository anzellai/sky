module Std.Bundle exposing
    ( Bundle
    , default
    , withName
    , withId
    , withIcon
    , withVersion
    , withAsset
    , withAssetDir
    , assetUrl
    , withBuild
    , Permission(..)
    , withPermission
    , withUsage
    , Entitlement(..)
    , PushEnvironment(..)
    , withEntitlement
    )

-- | `Std.Bundle` — everything a Sky app ships WITH: its cross-platform identity
-- (display name, reverse-DNS id, icon, version) and, in a later phase, the
-- static assets embedded alongside the binary.
--
-- Declared once as a top-level `bundle` binding using the `withX` builder, so
-- `sky.toml` stays lean and packaging lives in code next to the app:
--
--     module Main exposing (main, bundle)
--
--     import Std.Bundle as Bundle exposing (Bundle)
--
--     bundle : Bundle
--     bundle =
--         Bundle.default                         -- name = project name, default icon
--             |> Bundle.withId "com.acme.notes"  -- YOUR reverse-DNS id (owned domain)
--             |> Bundle.withIcon "assets/icon.png"
--
--     main =
--         Spa.app (Spa.config { ... })
--
-- `sky build --target ios|android|desktop` reads these values to fill the
-- generated Info.plist / AndroidManifest / desktop shell. Every field has a
-- sane default (the app name falls back to the project name, the icon to a
-- shipped Sky mark), so a `bundle` binding is entirely OPTIONAL — a project with
-- none still packages, under a default id. A real store submission needs an id
-- tied to a domain you own, so set `withId` before publishing.

import Sky.Core.Prelude exposing (..)

-- | The shipped-with-the-app manifest. Opaque: build it from `default` and the
-- `withX` setters so a new field can be added without breaking callers. Each
-- field is `Maybe`, so "unset" is distinct from "set to empty" and the packager
-- can supply its own default for the ones left `Nothing`.
type Bundle
    = Bundle { name : Maybe String
, id : Maybe String
, icon : Maybe String
, version : Maybe String
, build : Maybe Int
, assets : List String
, permissions : List Permission
, usages : List ( Permission, String )
, entitlements : List Entitlement
}


-- | The empty manifest: every field defaulted by the packager (app name → the
-- project name, id → a dev placeholder, icon → the shipped Sky mark, version →
-- the project version) and no extra assets.
default : Bundle
default =
    Bundle
        { name = Nothing
        , id = Nothing
        , icon = Nothing
        , version = Nothing
        , build = Nothing
        , assets = []
        , permissions = []
        , usages = []
        , entitlements = []
        }


-- | Set the human display name — CFBundleDisplayName / `android:label` / the
-- desktop window title. Defaults to the project name.
withName : String -> Bundle -> Bundle
withName name (Bundle fields) =
    Bundle { fields | name = Just name }


-- | Set the reverse-DNS identifier — CFBundleIdentifier / the Android package
-- (e.g. `"com.acme.notes"`). Two or more dot-separated segments, each starting
-- with a letter. Defaults to a dev placeholder; set your own (an id tied to a
-- domain you own) before submitting to a store.
withId : String -> Bundle -> Bundle
withId id (Bundle fields) =
    Bundle { fields | id = Just id }


-- | Set the app icon — a path (relative to the project) to a source PNG the
-- packager renders into each platform's icon set. Defaults to a shipped Sky
-- mark.
withIcon : String -> Bundle -> Bundle
withIcon path (Bundle fields) =
    Bundle { fields | icon = Just path }


-- | Set the marketing version — CFBundleShortVersionString / `android:versionName`.
-- Defaults to the project version.
withVersion : String -> Bundle -> Bundle
withVersion version (Bundle fields) =
    Bundle { fields | version = Just version }


-- | Set the store build number — CFBundleVersion / `android:versionCode`. A
-- positive integer the store requires to rise with every upload (the marketing
-- `withVersion` may stay the same across builds). Defaults to 1. The build
-- reads it statically, so write an integer literal: `Bundle.withBuild 7`.
withBuild : Int -> Bundle -> Bundle
withBuild n (Bundle fields) =
    Bundle { fields | build = Just n }


-- | Ship a single asset FILE with the app (a path relative to the project, e.g.
-- `"images/logo.png"`). `sky build` stages it into the served bundle under
-- `/assets/<basename>`, so `Bundle.assetUrl "logo.png"` resolves it — e.g.
-- `Ui.image [] { src = Bundle.assetUrl "logo.png", description = "logo" }`.
withAsset : String -> Bundle -> Bundle
withAsset path (Bundle fields) =
    Bundle { fields | assets = fields.assets ++ [ path ] }


-- | Ship a whole DIRECTORY of assets with the app (a path relative to the
-- project, e.g. `"assets"`). Its contents are staged under `/assets/…` keeping
-- their names, so `assets/logo.png` becomes `Bundle.assetUrl "logo.png"`. The
-- common case: keep every image/font/data file in one `assets/` folder.
withAssetDir : String -> Bundle -> Bundle
withAssetDir dir (Bundle fields) =
    Bundle { fields | assets = fields.assets ++ [ dir ] }


-- | The URL a shipped asset is served at — `Bundle.assetUrl "logo.png"` →
-- `"/assets/logo.png"`. Use it wherever a URL is expected (an `Ui.image` source,
-- a CSS background). Same-origin, so it works on web, desktop, and mobile
-- webviews alike.
assetUrl : String -> String
assetUrl path =
    "/assets/" ++ path

-- | A native device permission an app needs. Declaring one with
-- `withPermission` (or `withUsage`, which also sets the text the OS shows)
-- makes the packager wire the OS-level plumbing so a `Std.Native` capability can
-- actually be granted on a native shell: the iOS / macOS `Info.plist`
-- purpose-string key, the Android `<uses-permission>` (and its run-time request
-- where Android needs one), and the web view prompt handling. In a plain browser
-- these are a no-op (the browser owns the prompt).
--
--   * `Location` — iOS NSLocationWhenInUseUsageDescription; Android
--     ACCESS_FINE_LOCATION + ACCESS_COARSE_LOCATION.
--   * `LocationAlways` — adds NSLocationAlwaysAndWhenInUseUsageDescription and
--     ACCESS_BACKGROUND_LOCATION.
--   * `Camera` — NSCameraUsageDescription; CAMERA.
--   * `Microphone` — NSMicrophoneUsageDescription; RECORD_AUDIO.
--   * `Notifications` — no iOS key; POST_NOTIFICATIONS.
--   * `PhotoLibrary` — NSPhotoLibraryUsageDescription (+ the Add variant);
--     READ_MEDIA_IMAGES.
--   * `Contacts` — NSContactsUsageDescription; READ_CONTACTS.
--   * `FaceId` — NSFaceIDUsageDescription; USE_BIOMETRIC. Needed by
--     `Std.Native.authenticate`.
--   * `LocalNetwork` — NSLocalNetworkUsageDescription; no Android permission.
--   * `Bluetooth` — NSBluetoothAlwaysUsageDescription; BLUETOOTH_CONNECT +
--     BLUETOOTH_SCAN.
--
-- The macOS desktop `.app` carries the same keys where macOS has one (Face ID
-- has none on a Mac: Touch ID needs no purpose string).
type Permission
    = Location
    | LocationAlways
    | Camera
    | Microphone
    | Notifications
    | PhotoLibrary
    | Contacts
    | FaceId
    | LocalNetwork
    | Bluetooth


-- | Declare that the app needs a native `Permission` (e.g.
-- `Bundle.withPermission Bundle.Location` for `Std.Native.geolocation`), with a
-- generic purpose string. Without it the OS denies the request and the
-- capability's `Task` returns `Err`. A development build accepts the generic
-- text; `sky package --release` refuses it for a permission whose prompt shows
-- text, because App Review rejects a generic purpose string — use `withUsage`.
withPermission : Permission -> Bundle -> Bundle
withPermission perm (Bundle fields) =
    Bundle { fields | permissions = fields.permissions ++ [ perm ] }


-- | Declare a `Permission` AND the purpose string the OS shows in its prompt
-- (the iOS / macOS `NS…UsageDescription` value). Say why the app needs it, in
-- the user's terms:
--
--     bundle =
--         Bundle.default
--             |> Bundle.withId "com.acme.pair"
--             |> Bundle.withUsage Bundle.Camera "Scans the QR code on your other device to pair it."
--             |> Bundle.withUsage Bundle.FaceId "Unlocks your saved sign-in."
--
-- The build reads the text statically, so write a string literal. A call to a
-- capability that needs a permission the app has not declared
-- (`Native.authenticate` without `FaceId`, `Native.capturePhoto` without
-- `Camera`, `Native.geolocation` without `Location`) is a build error for the
-- iOS and Android shells, naming this builder.
withUsage : Permission -> String -> Bundle -> Bundle
withUsage perm text (Bundle fields) =
    Bundle
        { fields | permissions = fields.permissions ++ [ perm ]
        , usages = fields.usages ++ [ ( perm, text ) ]
        }

-- | Which Apple Push Notification service environment a build registers with.
-- Development builds use `PushDevelopment`; a store build `PushProduction`.
type PushEnvironment
    = PushDevelopment
    | PushProduction

-- | A typed Apple entitlement (iOS and the macOS `.app`). The build writes these
-- into the signed app's `.entitlements` file, merged with any
-- `native/ios/app.entitlements` fragment the project or a library ships, and a
-- signed release checks each one against the provisioning profile.
--
-- * `KeychainAccessGroup "TEAMID.com.acme.shared"` — `keychain-access-groups`,
--   to share `Native.secureSet` items between your apps (the team prefix is part
--   of the value).
-- * `AppGroup "group.com.acme.app"` — `com.apple.security.application-groups`.
-- * `AssociatedDomain "applinks:acme.com"` —
--   `com.apple.developer.associated-domains` (universal links,
--   `webcredentials:` for password autofill). The iOS and Android shells open
--   a link to the host on the link's page.
-- * `PushNotifications PushProduction` — `aps-environment`.
-- * `ICloudContainer "iCloud.com.acme.app"` —
--   `com.apple.developer.icloud-container-identifiers` (CloudKit).
--
-- Android has no entitlements file. An `applinks:` domain becomes an App Links
-- intent filter there, and a `webcredentials:` domain the app's
-- `asset_statements`; the build writes the site's `assetlinks.json`. Any other
-- entitlement has no Android equivalent, and an `activitycontinuation:` or
-- `appclips:` domain is left out with a build note.
type Entitlement
    = KeychainAccessGroup String
    | AppGroup String
    | AssociatedDomain String
    | PushNotifications PushEnvironment
    | ICloudContainer String


-- | Declare an `Entitlement` the signed app carries:
--
--     bundle =
--         Bundle.default
--             |> Bundle.withEntitlement (Bundle.AppGroup "group.com.acme.app")
--             |> Bundle.withEntitlement (Bundle.AssociatedDomain "applinks:acme.com")
--
-- The build reads the constructor and its string literal statically; a computed
-- value is a build error. Use this instead of a hand-written
-- `native/ios/app.entitlements` file (which still works, and is merged
-- structurally: arrays are unioned, and a key two sources set differently is
-- reported).
withEntitlement : Entitlement -> Bundle -> Bundle
withEntitlement ent (Bundle fields) =
    Bundle { fields | entitlements = fields.entitlements ++ [ ent ] }
