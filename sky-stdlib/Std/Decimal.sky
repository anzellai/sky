-- | Std.Decimal — arbitrary-precision decimal arithmetic (Layer 3 Sky source).
--
-- Backed by `shopspring/decimal` in the runtime; safe for money,
-- accounting, and any domain where binary floating-point rounding
-- would corrupt totals.  Banker's rounding by default; percent /
-- ratio helpers for fee calculations.  All arithmetic is exact
-- within the decimal type — no implicit precision loss across
-- chains of `mul` / `div` / `add` / `sub`.
--
-- For currency-typed amounts, prefer `Std.Money` (built on Decimal)
-- so the ISO-4217 currency code rides alongside the magnitude.
module Std.Decimal exposing
    ( Decimal
    , fromString, fromInt, fromFloat, fromMinor
    , zero, one, oneHundred
    , toString, toStringFixed, toFloat, toInt, toMinor
    , add, sub, mul, div, mod
    , neg, abs
    , round, roundHalfUp, truncate, floor, ceil
    , compare, eq, neq, lt, lte, gt, gte
    , min, max
    , isZero, isPositive, isNegative
    , percentOf, addPercent, subPercent
    , formatWith
    , sum
    )

-- | Std.Decimal — arbitrary-precision decimal arithmetic.
--
-- Use for money, invoices, billing, tax, anything where exact
-- fractional value matters. Backed by shopspring/decimal at the
-- runtime — no precision loss on add/sub/mul, configurable
-- rounding on div.
--
-- `Decimal` is opaque: construct with `fromString` / `fromInt` /
-- `fromFloat`, never pattern-match. Arithmetic and comparison only.
--
-- Layer 3 design: every function below is a Sky-source thin wrapper
-- around a `Ffi.callPure` boundary call to the runtime kernels in
-- runtime-go/rt/decimal_kernel.go. The Sky `Decimal` ADT carries a
-- phantom `Float` field — at runtime, the actual `decimal.Decimal`
-- value lives in the SkyADT box; the Sky-source `Float` is purely
-- a type-shape so the constructor has a slot.

import Sky.Core.Prelude exposing (..)
import Sky.Core.Error exposing (Error)
import Sky.Ffi as Ffi


-- ─── The opaque type ───────────────────────────────────────────────
-- The constructor is intentionally NOT exposed.

type Decimal
    = Decimal__Internal Float


-- ─── Construction ──────────────────────────────────────────────────

fromString : String -> Result Error Decimal
fromString s =
    Ffi.callPure "Decimal_fromString" [ s ]


fromInt : Int -> Decimal
fromInt n =
    Ffi.callPure "Decimal_fromInt" [ n ]


fromFloat : Float -> Decimal
fromFloat f =
    Ffi.callPure "Decimal_fromFloat" [ f ]


-- | `fromMinor 2 12345` → 123.45  (cents → dollars).
fromMinor : Int -> Int -> Decimal
fromMinor places minor =
    Ffi.callPure "Decimal_fromMinor" [ places, minor ]


-- ─── Constants ─────────────────────────────────────────────────────

zero : Decimal
zero =
    Ffi.callPure "Decimal_zero" []


one : Decimal
one =
    Ffi.callPure "Decimal_one" []


oneHundred : Decimal
oneHundred =
    Ffi.callPure "Decimal_oneHundred" []


-- ─── Conversion ────────────────────────────────────────────────────

toString : Decimal -> String
toString d =
    Ffi.callPure "Decimal_toString" [ d ]


toStringFixed : Int -> Decimal -> String
toStringFixed places d =
    Ffi.callPure "Decimal_toStringFixed" [ Ffi.toAny places, Ffi.toAny d ]


toFloat : Decimal -> Float
toFloat d =
    Ffi.callPure "Decimal_toFloat" [ d ]


toInt : Decimal -> Int
toInt d =
    Ffi.callPure "Decimal_toInt" [ d ]


toMinor : Int -> Decimal -> Int
toMinor places d =
    Ffi.callPure "Decimal_toMinor" [ Ffi.toAny places, Ffi.toAny d ]


-- ─── Arithmetic ────────────────────────────────────────────────────

add : Decimal -> Decimal -> Decimal
add a b =
    Ffi.callPure "Decimal_add" [ a, b ]


sub : Decimal -> Decimal -> Decimal
sub a b =
    Ffi.callPure "Decimal_sub" [ a, b ]


mul : Decimal -> Decimal -> Decimal
mul a b =
    Ffi.callPure "Decimal_mul" [ a, b ]


div : Decimal -> Decimal -> Result Error Decimal
div a b =
    Ffi.callPure "Decimal_div" [ a, b ]


mod : Decimal -> Decimal -> Result Error Decimal
mod a b =
    Ffi.callPure "Decimal_mod" [ a, b ]


neg : Decimal -> Decimal
neg d =
    Ffi.callPure "Decimal_neg" [ d ]


abs : Decimal -> Decimal
abs d =
    Ffi.callPure "Decimal_abs" [ d ]


-- ─── Rounding ──────────────────────────────────────────────────────

-- | Banker's rounding (round-half-to-even).
round : Int -> Decimal -> Decimal
round places d =
    Ffi.callPure "Decimal_round" [ Ffi.toAny places, Ffi.toAny d ]


roundHalfUp : Int -> Decimal -> Decimal
roundHalfUp places d =
    Ffi.callPure "Decimal_roundHalfUp" [ Ffi.toAny places, Ffi.toAny d ]


truncate : Int -> Decimal -> Decimal
truncate places d =
    Ffi.callPure "Decimal_truncate" [ Ffi.toAny places, Ffi.toAny d ]


floor : Decimal -> Decimal
floor d =
    Ffi.callPure "Decimal_floor" [ d ]


ceil : Decimal -> Decimal
ceil d =
    Ffi.callPure "Decimal_ceil" [ d ]


-- ─── Comparison ────────────────────────────────────────────────────

compare : Decimal -> Decimal -> Int
compare a b =
    Ffi.callPure "Decimal_compare" [ a, b ]


eq : Decimal -> Decimal -> Bool
eq a b =
    Ffi.callPure "Decimal_eq" [ a, b ]


neq : Decimal -> Decimal -> Bool
neq a b =
    Ffi.callPure "Decimal_neq" [ a, b ]


lt : Decimal -> Decimal -> Bool
lt a b =
    Ffi.callPure "Decimal_lt" [ a, b ]


lte : Decimal -> Decimal -> Bool
lte a b =
    Ffi.callPure "Decimal_lte" [ a, b ]


gt : Decimal -> Decimal -> Bool
gt a b =
    Ffi.callPure "Decimal_gt" [ a, b ]


gte : Decimal -> Decimal -> Bool
gte a b =
    Ffi.callPure "Decimal_gte" [ a, b ]


min : Decimal -> Decimal -> Decimal
min a b =
    Ffi.callPure "Decimal_min" [ a, b ]


max : Decimal -> Decimal -> Decimal
max a b =
    Ffi.callPure "Decimal_max" [ a, b ]


-- ─── Predicates ────────────────────────────────────────────────────

isZero : Decimal -> Bool
isZero d =
    Ffi.callPure "Decimal_isZero" [ d ]


isPositive : Decimal -> Bool
isPositive d =
    Ffi.callPure "Decimal_isPositive" [ d ]


isNegative : Decimal -> Bool
isNegative d =
    Ffi.callPure "Decimal_isNegative" [ d ]


-- ─── Percent helpers ───────────────────────────────────────────────

percentOf : Decimal -> Decimal -> Decimal
percentOf pct of_ =
    Ffi.callPure "Decimal_percentOf" [ pct, of_ ]


addPercent : Decimal -> Decimal -> Decimal
addPercent pct base =
    Ffi.callPure "Decimal_addPercent" [ pct, base ]


subPercent : Decimal -> Decimal -> Decimal
subPercent pct base =
    Ffi.callPure "Decimal_subPercent" [ pct, base ]


-- ─── Formatting ────────────────────────────────────────────────────

-- | `formatWith thousandsSep decimalSep places d`
--   `formatWith "," "." 2 d` → "1,234,567.89"  (US)
--   `formatWith "." "," 2 d` → "1.234.567,89"  (EU)
formatWith : String -> String -> Int -> Decimal -> String
formatWith thousandsSep decimalSep places d =
    Ffi.callPure "Decimal_formatWith"
        [ Ffi.toAny thousandsSep
        , Ffi.toAny decimalSep
        , Ffi.toAny places
        , Ffi.toAny d
        ]


-- ─── List operations ───────────────────────────────────────────────

-- | Sum a list of Decimals.
sum : List Decimal -> Decimal
sum xs =
    sumHelp xs zero


sumHelp : List Decimal -> Decimal -> Decimal
sumHelp xs acc =
    case xs of
        [] ->
            acc

        first :: rest ->
            sumHelp rest (add acc first)
