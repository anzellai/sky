module Main exposing (main)

{-| The program behind `sky ai`. The CLI holds no logic of its own: it builds
this program once per Sky version and runs it with the verb's arguments, and
each verb is a call to the Std.Ai API a user's own program can make.

    sky ai provision [--variant cpu|metal] [--dev-model] [--model <ref>]
                                                 Local.provision, Local.fetch
    sky ai pull <org>/<repo> <file>              Local.pull
    sky ai ps [--all]                            Local.engines
    sky ai start <slot> [--model <ref>] [--context <n>] [--embeddings]
                                                 Endpoint.warm, then hold
    sky ai stop <slot> | --all                   Local.stopSlot
    sky ai promote <name> <version> --to <alias> [--min-pass-rate <x>]
                   [--expect <n>|none] [--force --reason <text>]
                                                 Registry.promoteCompared,
                                                 promoteIf, forcePromote
    sky ai rollback <name>@<alias>               Registry.rollback
    sky ai registry publish <name>               Registry.publishPointers
    sky ai lineage <name>@<alias>|<name>@v<n>    Registry.lineage
    sky ai lineage --dataset <sha256>|<name>@<n> Registry.trainedOn
    sky ai data freeze <file.jsonl> [--name <n>] [--out <dir>] [--key <field>]
                [--split <train>/<eval>/<test>] [--seed <n>]
                [--consent <basis>] [--retention <period>]
                                                 Dataset.fromJsonLines, split, freezeJson
    sky ai provision --train … | train … | export …
                                                 sky-bundled/ai-train

The registry verbs open the registry on the database `--db <dsn>` names, else
the app's own (`SKY_DB_PATH`, else `DATABASE_URL`; in a project with a
pipeline the CLI runs these verbs through it instead), with the artefact
store at `--registry <url>` (it wins over the variable), else
`SKY_AI_REGISTRY`, else `file://.sky/ai/registry`.

Every verb takes `--format json`.
-}

import Sky.Core.Prelude exposing (..)
import Sky.Core.Task as Task
import Sky.Core.Error as Error exposing (Error)
import Sky.Core.List as List
import Sky.Core.String as String
import Sky.Core.Maybe as Maybe
import Sky.Core.System as System
import Sky.Core.Time as Time
import Sky.Core.Json.Encode as JsonE
import Std.Log exposing (println)
import Std.Ai.Endpoint as Endpoint
import Std.Ai.Local as Local
import Std.Ai.Eval as Eval
import Std.Ai.Registry as Registry
import Std.Ai.Store as Store
import Std.Db as Db exposing (Db)
import Std.Ai.Dataset as Dataset
import Sky.Core.Json.Decode as JsonD
import Sky.Core.Result as Result


main : Task Error ()
main =
    System.args () |> Task.andThen run


run : List String -> Task Error ()
run args =
    let
        json = List.member "--format" args && List.member "json" args
        rest = List.filter (\a -> a /= "--format" && a /= "json") args
    in
        case rest of

            "provision" :: opts ->
                provision json opts

            ["pull", repo, file] ->
                pull json repo file

            "ps" :: opts ->
                ps json (List.member "--all" opts)

            "start" :: slot :: opts ->
                start json slot opts

            ["stop", "--all"] ->
                stop json ""

            ["stop", slot] ->
                stop json slot

            "promote" :: name :: number :: opts ->
                promote json name number opts

            "rollback" :: ref :: opts ->
                rollback json ref opts

            "registry" :: "publish" :: name :: opts ->
                publish json name opts

            "lineage" :: "--dataset" :: digest :: opts ->
                trainedOn json digest opts

            "lineage" :: ref :: opts ->
                lineage json ref opts

            "data" :: "freeze" :: file :: opts ->
                freeze json file opts

            _ ->
                Task.fail (Error.invalidInput usage)


usage : String
usage =
    "usage: sky ai provision [--variant cpu|metal] [--dev-model] [--model <ref>] | pull <org>/<repo> <file> | ps [--all] | start <slot> [--model <ref>] [--context <n>] [--embeddings] | stop <slot>|--all | promote <name> <version> --to <alias> | rollback <name>@<alias> | lineage <name>@<alias> | lineage --dataset <sha256>|<name>@<n> | data freeze <file.jsonl> [--name <n>] [--out <dir>] [--key <field>] [--split 80/10/10] [--seed <n>] [--consent <basis>] [--retention <period>]  (each takes --format json; the registry verbs take --db <dsn> and --registry <url>)"


-- The value after a flag, if the flag is there.
flag : String -> List String -> Maybe String
flag name opts =
    case opts of

        a :: b :: more ->
            if a == name then
                Just b

            else
                flag name (b :: more)

        _ ->
            Nothing


-- Every value given to a repeatable flag.
flags : String -> List String -> List String
flags name opts =
    case opts of

        a :: b :: more ->
            if a == name then
                b :: flags name more

            else
                flags name (b :: more)

        _ ->
            []


emit : Bool -> JsonE.Value -> String -> Task Error ()
emit json value text =
    if json then
        println (JsonE.encode 0 value)

    else
        println text


-- ─── provision ──────────────────────────────────────────────────────────
provision : Bool -> List String -> Task Error ()
provision json opts =
    let
        models =
            flags "--model" opts
                ++ (if List.member "--dev-model" opts then
                       [ Local.reference Local.devModel ]

                   else
                       [])
    in
        Local.provision ()
            |> Task.andThen (checkVariant (flag "--variant" opts))
            |> Task.andThen
                   (\p -> fetchModels models |> Task.map (\paths -> ( p, paths )))
            |> Task.andThen (\( p, paths ) -> reportProvision json p paths)


checkVariant : Maybe String -> Local.Provisioned -> Task Error Local.Provisioned
checkVariant wanted p =
    case wanted of

        Just v ->
            if v == p.variant then
                Task.succeed p

            else
                Task.fail
                    (Error.invalidInput
                        ("sky ai provision: there is no pinned " ++ v
                            ++ " build for "
                            ++ p.platform
                            ++ "; the pinned build here is "
                            ++ p.variant))

        Nothing ->
            Task.succeed p


fetchModels : List String -> Task Error (List String)
fetchModels refs =
    refs |> List.map (\r -> Local.fetch (Local.fromReference r))
        |> Task.sequence


reportProvision : Bool -> Local.Provisioned -> List String -> Task Error ()
reportProvision json p paths =
    emit
        json
        (JsonE.object
            [ ( "engine", JsonE.string p.path )
            , ( "build", JsonE.string p.build )
            , ( "variant", JsonE.string p.variant )
            , ( "platform", JsonE.string p.platform )
            , ( "home", JsonE.string p.home )
            , ( "models", JsonE.list JsonE.string paths )
            ])
        (String.join
            "\n"
            (("llama-server " ++ p.build ++ " (" ++ p.variant ++ ", "
                ++ p.platform
                ++ ") at "
                ++ p.path)
                :: List.map (\m -> "model at " ++ m) paths))


-- ─── pull ───────────────────────────────────────────────────────────────
pull : Bool -> String -> String -> Task Error ()
pull json repo file =
    Local.pull repo file
        |> Task.andThen
               (\p ->
                   emit
                       json
                       (JsonE.object
                           [ ( "repo", JsonE.string p.repo )
                           , ( "file", JsonE.string p.file )
                           , ( "path", JsonE.string p.path )
                           , ( "sha256", JsonE.string p.sha256 )
                           , ( "bytes", JsonE.int p.bytes )
                           ])
                       (String.join
                           "\n"
                           [ "stored " ++ String.fromInt p.bytes ++ " bytes at "
                                 ++ p.path
                           , ""
                           , "Local.huggingFace"
                           , "    { repo = \"" ++ p.repo ++ "\""
                           , "    , file = \"" ++ p.file ++ "\""
                           , "    , sha256 = \"" ++ p.sha256 ++ "\""
                           , "    }"
                           ]))


-- ─── ps ─────────────────────────────────────────────────────────────────
ps : Bool -> Bool -> Task Error ()
ps json all =
    Local.engines () |> Task.map (List.filter (\e -> all || e.state /= "stale"))
        |> Task.andThen
               (\es -> emit json (JsonE.list engineValue es) (engineTable es))


engineValue : Local.EngineInfo -> JsonE.Value
engineValue e =
    JsonE.object
        [ ( "slot", JsonE.string e.slot )
        , ( "state", JsonE.string e.state )
        , ( "pid", JsonE.int e.pid )
        , ( "holderPid", JsonE.int e.holderPid )
        , ( "port", JsonE.int e.port )
        , ( "model", JsonE.string e.model )
        , ( "build", JsonE.string e.build )
        , ( "accelerator", JsonE.string e.accelerator )
        , ( "context", JsonE.int e.context )
        , ( "startedAt", JsonE.string e.startedAt )
        ]


engineTable : List Local.EngineInfo -> String
engineTable es =
    if List.isEmpty es then
        "no engines are running"

    else
        String.join
            "\n"
            ("SLOT        STATE     PID     PORT   ACCEL  CTX    MODEL"
                :: List.map engineRow es)


engineRow : Local.EngineInfo -> String
engineRow e =
    String.join
        " "
        [ String.padRight 11 ' ' (orDash e.slot)
        , String.padRight 9 ' ' e.state
        , String.padRight 7 ' ' (String.fromInt e.pid)
        , String.padRight 6 ' ' (String.fromInt e.port)
        , String.padRight 6 ' ' e.accelerator
        , String.padRight 6 ' ' (String.fromInt e.context)
        , e.model
        ]


orDash : String -> String
orDash s =
    if s == "" then
        "-"

    else
        s


-- ─── start / stop ───────────────────────────────────────────────────────
start : Bool -> String -> List String -> Task Error ()
start json slot opts =
    let
        model =
            flag "--model" opts |> Maybe.map Local.fromReference
                |> Maybe.withDefault Local.devModel
        sized =
            case Maybe.andThen String.toInt (flag "--context" opts) of

                Just n ->
                    Local.withContext n

                Nothing ->
                    identity
        embedding =
            if List.member "--embeddings" opts then
                Local.withEmbeddings

            else
                identity
        adapter =
            case flag "--adapter" opts of

                Just ref ->
                    Local.withAdapter (Local.fromReference ref)

                Nothing ->
                    identity
        spec =
            Local.model model |> sized |> embedding |> adapter
                |> Local.withIdleUnload 0
    in
        Endpoint.endpoint slot |> Endpoint.withLocal spec |> Endpoint.warm
            |> Task.andThen (\d -> emit json (describeValue d) (describeText d))
            |> Task.andThen (\_ -> Task.forever (Time.sleep 3600000))


describeValue : Endpoint.Description -> JsonE.Value
describeValue d =
    JsonE.object
        [ ( "slot", JsonE.string d.slot )
        , ( "mode", JsonE.string d.mode )
        , ( "target", JsonE.string d.target )
        , ( "state", JsonE.string "ready" )
        ]


describeText : Endpoint.Description -> String
describeText d =
    "slot " ++ d.slot ++ " ready (" ++ d.mode ++ ", " ++ d.target
        ++ "). Programs on this machine that use the same model and settings share this engine. Stop it with `sky ai stop "
        ++ d.slot
        ++ "` or Ctrl-C."


stop : Bool -> String -> Task Error ()
stop json slot =
    Local.stopSlot slot
        |> Task.andThen
               (\n ->
                   emit
                       json
                       (JsonE.object
                           [ ( "slot", JsonE.string slot )
                           , ( "stopped", JsonE.int n )
                           ])
                       ("stopped " ++ String.fromInt n ++ " engine(s)"))


-- ─── the registry: promote / rollback / lineage ─────────────────────────
openRegistry : List String -> Task Error Registry.Registry
openRegistry opts =
    let
        db =
            case flag "--db" opts of

                Just dsn ->
                    if String.startsWith "postgres://" dsn
                        || String.startsWith "postgresql://" dsn then
                        Db.open "postgres" dsn

                    else
                        Db.open "sqlite" dsn

                Nothing ->
                    Db.connect ()
    in
        db
            |> Task.andThen
                   (\conn ->
                       case flag "--registry" opts of

                           Just url ->
                               Task.fromResult (Store.fromUrl url)
                                   |> Task.andThen (Registry.open conn)

                           Nothing ->
                               Registry.openConfigured conn "")


versionNumber : String -> Task Error Int
versionNumber text =
    let
        digits =
            if String.startsWith "v" text then
                String.dropLeft 1 text

            else
                text
    in
        case String.toInt digits of

            Just n ->
                Task.succeed n

            Nothing ->
                Task.fail
                    (Error.invalidInput
                        ("sky ai promote: " ++ text
                            ++ " is not a version number (write 3 or v3)"))


thresholdsFrom : List String -> Task Error Eval.Thresholds
thresholdsFrom opts =
    case flag "--min-pass-rate" opts of

        Just text ->
            case String.toFloat text of

                Just x ->
                    Task.succeed (Eval.thresholds |> Eval.withMinPassRate x)

                Nothing ->
                    Task.fail
                        (Error.invalidInput
                            ("sky ai promote: --min-pass-rate " ++ text
                                ++ " is not a number from 0 to 1"))

        Nothing ->
            Task.succeed Eval.thresholds


promote : Bool -> String -> String -> List String -> Task Error ()
promote json name number opts =
    case flag "--to" opts of

        Nothing ->
            Task.fail
                (Error.invalidInput
                    "sky ai promote: name the alias with --to <alias>")

        Just aliasName ->
            Task.map3
                (\reg n t -> ( reg, n, t ))
                (openRegistry opts)
                (versionNumber number)
                (thresholdsFrom opts)
                |> Task.andThen
                       (\( reg, n, t ) ->
                           Registry.version reg name n
                               |> Task.andThen
                                      (\v -> promoteHow reg aliasName v t opts))
                |> Task.andThen
                       (\ev ->
                           emit
                               json
                               (Registry.eventValue ev)
                               (eventText name ev))


promoteHow : Registry.Registry -> String -> Registry.Version -> Eval.Thresholds -> List String -> Task Error Registry.AliasEvent
promoteHow reg aliasName v t opts =
    if List.member "--force" opts then
        Registry.forcePromote
            reg
            aliasName
            v
            (Maybe.withDefault "" (flag "--reason" opts))

    else
        case flag "--expect" opts of

            Just "none" ->
                promoteExpecting reg aliasName Nothing v t

            Just text ->
                versionNumber text
                    |> Task.andThen (\n -> Registry.version reg v.name n)
                    |> Task.andThen
                           (\expected ->
                               promoteExpecting
                                   reg
                                   aliasName
                                   (Just expected)
                                   v
                                   t)

            Nothing ->
                Registry.promoteCompared reg aliasName v (\_ -> t)


-- `--expect`: promote only while the alias still points where the caller
-- saw it (`promoteIf`), on the attached evidence compared against the
-- version the alias serves now.
promoteExpecting : Registry.Registry -> String -> Maybe Registry.Version -> Registry.Version -> Eval.Thresholds -> Task Error Registry.AliasEvent
promoteExpecting reg aliasName expected v t =
    Registry.evidenceAgainst reg aliasName v (\_ -> t)
        |> Task.andThen
               (\found ->
                   case found of

                       ( passed, _ ) ->
                           Registry.promoteIf reg aliasName expected v passed)


eventText : String -> Registry.AliasEvent -> String
eventText name ev =
    name ++ "@" ++ ev.aliasName ++ ": " ++ ev.action ++ " "
        ++ (if ev.from == 0 then
               "(none)"

           else
               "v" ++ String.fromInt ev.from)
        ++ " -> v"
        ++ String.fromInt ev.to
        ++ (if ev.reason == "" then
               ""

           else
               " (reason: " ++ ev.reason ++ ")")
        ++ (if ev.report == "" then
               ""

           else
               " (report " ++ ev.report ++ ")")


-- `sky ai registry publish <name>`: Registry.publishPointers.
publish : Bool -> String -> List String -> Task Error ()
publish json name opts =
    openRegistry opts
        |> Task.andThen (\reg -> Registry.publishPointers reg name)
        |> Task.andThen
               (\n ->
                   emit
                       json
                       (JsonE.object
                           [ ( "name", JsonE.string name )
                           , ( "written", JsonE.int n )
                           ])
                       ("published " ++ name ++ ": " ++ String.fromInt n
                           ++ " pointer objects written"))


rollback : Bool -> String -> List String -> Task Error ()
rollback json ref opts =
    openRegistry opts |> Task.andThen (\reg -> Registry.rollback reg ref)
        |> Task.andThen
               (\ev ->
                   emit
                       json
                       (Registry.eventValue ev)
                       (eventText
                           (Maybe.withDefault
                               ref
                               (List.head (String.split "@" ref)))
                           ev))


lineage : Bool -> String -> List String -> Task Error ()
lineage json ref opts =
    openRegistry opts |> Task.andThen (\reg -> Registry.lineage reg ref)
        |> Task.andThen
               (\l -> emit json (Registry.lineageValue l) (lineageText l))


lineageText : Registry.LineageReport -> String
lineageText l =
    let
        v = l.version
    in
        String.join
            "\n"
            ([ Registry.label v ++ "  (" ++ v.method ++ " adapter, " ++ v.format
                  ++ ", "
                  ++ String.fromInt v.size
                  ++ " bytes)"
            , "  served as   " ++ Registry.servedName v
            , "  adapter     sha256:" ++ v.digest
            , "  base        " ++ v.base
            , "  dataset     " ++ v.dataset ++ "  sha256:" ++ v.datasetDigest
            , "  aliases     "
                  ++ (if List.isEmpty l.aliases then
                         "(none)"

                     else
                         String.join ", " l.aliases)
            ]
                ++ (case v.blocked of

                       Just why ->
                           [ "  BLOCKED     " ++ why ]

                       Nothing ->
                           [])
                ++ List.map
                       (\( k, value ) ->
                           "  " ++ String.padRight 11 ' ' k ++ " " ++ value)
                       v.metadata
                ++ ("  reports" :: List.map reportLine l.reports)
                ++ ("  events"
                       :: List.map (\e -> "    " ++ eventText v.name e) l.events))


reportLine : Registry.ReportLink -> String
reportLine r =
    "    " ++ r.suite ++ "  " ++ r.verdict ++ "  pass rate "
        ++ String.fromInt (Math.round (r.passRate * 100.0))
        ++ "%  ("
        ++ String.fromInt r.passed
        ++ " passed, "
        ++ String.fromInt r.failed
        ++ " failed)  digest "
        ++ r.digest


trainedOn : Bool -> String -> List String -> Task Error ()
trainedOn json digest opts =
    openRegistry opts |> Task.andThen (\reg -> Registry.trainedOn reg digest)
        |> Task.andThen
               (\vs ->
                   emit
                       json
                       (JsonE.list Registry.versionValue vs)
                       (if List.isEmpty vs then
                           "no version was trained on "
                               ++ (if String.contains "@" digest then
                                      digest

                                  else
                                      "sha256:" ++ digest)

                       else
                           String.join
                               "\n"
                               (List.map
                                   (\v ->
                                       Registry.label v
                                           ++ (case v.blocked of

                                                  Just why ->
                                                      "  (blocked: " ++ why
                                                          ++ ")"

                                                  Nothing ->
                                                      ""))
                                   vs)))


-- ─── data freeze ────────────────────────────────────────────────────────
-- Freeze a JSONL file into a content-addressed dataset version: canonical
-- rows, a seeded split by a key field (or by the whole row), the SHA-256 of
-- the data and a manifest. The same rows give the same digest.
freeze : Bool -> String -> List String -> Task Error ()
freeze json file opts =
    case splitSpec opts of

        Err e ->
            Task.fail e

        Ok spec ->
            let
                name =
                    Maybe.withDefault (baseName file) (flag "--name" opts)
                out =
                    Maybe.withDefault ".sky/ai/datasets" (flag "--out" opts)
                withConsent =
                    case flag "--consent" opts of

                        Just c ->
                            Dataset.withConsentBasis c

                        Nothing ->
                            identity
                withRetention =
                    case flag "--retention" opts of

                        Just r ->
                            Dataset.withRetention r

                        Nothing ->
                            identity
                tgt =
                    Dataset.folder out name |> withConsent |> withRetention
            in
                Dataset.fromJsonLines file
                    |> Dataset.split spec (keyOf (flag "--key" opts))
                    |> Dataset.freezeJson tgt
                    |> Task.andThen (\v -> reportFreeze json out v)


-- The split key: a top-level string field when --key names one (a row
-- without it uses its whole text), else the whole canonical row.
keyOf : Maybe String -> String -> String
keyOf field row =
    case field of

        Just f ->
            Result.withDefault
                row
                (JsonD.decodeString (JsonD.field f JsonD.string) row)

        Nothing ->
            row


splitSpec : List String -> Result Error Dataset.SplitSpec
splitSpec opts =
    let
        seed =
            Maybe.withDefault
                0
                (Maybe.andThen String.toInt (flag "--seed" opts))
    in
        case flag "--split" opts of

            Nothing ->
                Ok { train = 80, eval = 10, test = 10, seed = seed }

            Just text ->
                case List.map String.toInt (String.split "/" text) of

                    [Just t, Just e, Just x] ->
                        if t < 0 || e < 0 || x < 0 || t + e + x == 0 then
                            Err
                                (Error.invalidInput
                                    ("sky ai data freeze: --split " ++ text
                                        ++ " needs three non-negative weights, not all 0"))

                        else
                            Ok { train = t, eval = e, test = x, seed = seed }

                    _ ->
                        Err
                            (Error.invalidInput
                                ("sky ai data freeze: --split takes <train>/<eval>/<test>, for example 80/10/10, not "
                                    ++ text))


baseName : String -> String
baseName path =
    let
        last =
            Maybe.withDefault
                path
                (List.head (List.reverse (String.split "/" path)))
    in
        if String.endsWith ".jsonl" last then
            String.dropRight 6 last

        else
            last


reportFreeze : Bool -> String -> Dataset.Version String -> Task Error ()
reportFreeze json out v =
    let
        m = Dataset.manifest v
    in
        emit
            json
            (JsonE.object
                [ ( "name", JsonE.string m.name )
                , ( "digest", JsonE.string m.digest )
                , ( "rows", JsonE.int m.rows )
                , ( "train", JsonE.int m.train )
                , ( "eval", JsonE.int m.eval )
                , ( "test", JsonE.int m.test )
                , ( "seed", JsonE.int m.splitSeed )
                , ( "data", JsonE.string (Dataset.blobPath v) )
                , ( "manifest"
                  , JsonE.string
                        (out ++ "/" ++ m.name ++ "/" ++ m.digest ++ ".json")
                  )
                ])
            (String.join
                "\n"
                [ "froze " ++ m.name ++ ": " ++ String.fromInt m.rows
                      ++ " rows (train "
                      ++ String.fromInt m.train
                      ++ ", eval "
                      ++ String.fromInt m.eval
                      ++ ", test "
                      ++ String.fromInt m.test
                      ++ ", seed "
                      ++ String.fromInt m.splitSeed
                      ++ ")"
                , "sha256:" ++ m.digest
                , "data     " ++ Dataset.blobPath v
                , "manifest " ++ out ++ "/" ++ m.name ++ "/" ++ m.digest
                      ++ ".json"
                ])
