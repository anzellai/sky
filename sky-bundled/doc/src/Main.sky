module Main exposing (main)

-- | sky-doc-server — serves a pre-rendered doc-site directory on
-- a localhost port. The `sky doc --serve` command in the
-- compiler:
--   1. Builds the doc index from the user's project (via
--      Sky.Doc.Index in the compiler-side Haskell).
--   2. Renders static HTML + JSON to a temp directory.
--   3. Spawns this binary with SKY_DOC_DIR + SKY_LIVE_PORT set.
--
-- Implementation notes:
--   * Sky.Http.Server's path-param routing (`/m/:name`) is
--     currently a no-op (Go's stdlib ServeMux treats `:name` as
--     a literal). Sidestep with a single `Server.any "/"`
--     catch-all + URL-path inspection.
--   * `Server.text` hard-sets Content-Type to text/plain in the
--     runtime's response writer — use `Server.html` /
--     `Server.json` for those types and fall back to header
--     override (with empty body builder) for CSS/JS.

import Sky.Core.Prelude exposing (..)
import Sky.Core.Task as Task
import Sky.Core.String as String
import Sky.Core.Error as Error
import Sky.Http.Server as Server
import Sky.Http.Server exposing (Request, Response)
import Sky.Core.File as File
import Std.Log exposing (println)
import System


main =
    let
        dir =
            System.getenvOr "SKY_DOC_DIR" ""

        port =
            case System.getenvInt "SKY_LIVE_PORT" |> Task.run of
                Ok n -> n
                Err _ -> 8030

        _ =
            println
                ("sky doc-server: " ++ dir ++ " on :" ++ String.fromInt port)
    in
        if dir == "" then
            Task.fail
                (Error.unexpected
                    "SKY_DOC_DIR not set — run via `sky doc --serve`.")
        else
            Server.listen port
                [ Server.any "/" (dispatch dir)
                ]


-- ─── Dispatch ──────────────────────────────────────────────────

dispatch : String -> Request -> Task Error Response
dispatch dir req =
    let
        path = Server.path req
        -- Hard-fail on path traversal: refuse any URL containing
        -- ".." anywhere. A doc server doesn't accept user-supplied
        -- POSTs so the attack surface is small, but defence in
        -- depth is cheap.
        safe = not (String.contains ".." path)
    in
        if not safe then
            Task.succeed
                (Server.withStatus 400 (Server.text "bad request"))
        else if path == "/" then
            serveHtml (dir ++ "/index.html")
        else if String.startsWith "/m/" path then
            let
                modName = String.slice 3 (String.length path) path
            in
                serveHtml (dir ++ "/m/" ++ modName ++ ".html")
        else if path == "/api/symbols.json" then
            serveJson (dir ++ "/api/symbols.json")
        else
            Task.succeed
                (Server.withStatus 404
                    (Server.text ("not found: " ++ path)))


-- ─── Helpers ────────────────────────────────────────────────────

serveHtml : String -> Task Error Response
serveHtml path =
    File.readFile path
        |> Task.andThen (\body -> Task.succeed (Server.html body))
        |> Task.onError (notFoundFor path)


serveJson : String -> Task Error Response
serveJson path =
    File.readFile path
        |> Task.andThen (\body -> Task.succeed (Server.json body))
        |> Task.onError (notFoundFor path)


notFoundFor : String -> Error -> Task Error Response
notFoundFor path _ =
    Task.succeed
        (Server.withStatus 404
            (Server.text ("not found: " ++ path)))
