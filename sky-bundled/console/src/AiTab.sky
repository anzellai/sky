module AiTab exposing (aiView)

-- The AI tab (v0.28.0): the Std.Ai slots, local engines, recent model calls
-- and eval runs of the host process. Data comes from the parent's
-- /_sky/console/api/ai endpoint (runtime-go/rt/ai_console.go), which holds no
-- prompt, no answer and no secret.
--
-- Controls (each part of the console URL):
--   * a slot's name filters the recent calls to that slot (`slot=`), and
--     "All slots" clears it;
--   * "All" / "Failed" chips filter the recent calls by outcome
--     (`calls=failed`);
--   * an eval run's row opens its cases (`eval=<id>`), and a second click
--     closes them;
--   * a registry model's row opens its versions, alias log and eval history
--     (`model=<name>`), and a second click closes them.
--
-- The Training section lists the Std.Ai.Train runs (status, steps, losses,
-- relaunches, the registered version) with a small loss curve. It has no
-- control and holds no dataset text.
--
-- Palette mirrors ErrorsTab.sky so the tab is visually consistent with the
-- rest of the console.

import Sky.Core.Prelude exposing (..)
import Sky.Core.List as List
import Sky.Core.String as String
import Sky.Core.Math as Math
import Std.Ui as Ui
import Std.Ui exposing (Element)
import Std.Ui.Background as Background
import Std.Ui.Border as Border
import Std.Ui.Font as Font
import Std.Ui.Chart as Chart
import State exposing (..)


bgRaised : Ui.Color
bgRaised =
    Ui.rgb 20 23 28


bgCode : Ui.Color
bgCode =
    Ui.rgb 44 50 60


border_ : Ui.Color
border_ =
    Ui.rgb 53 59 70


borderSoft : Ui.Color
borderSoft =
    Ui.rgb 42 47 56


textPrimary : Ui.Color
textPrimary =
    Ui.rgb 240 243 247


textSecondary : Ui.Color
textSecondary =
    Ui.rgb 197 203 212


textMuted : Ui.Color
textMuted =
    Ui.rgb 141 150 163


accent : Ui.Color
accent =
    Ui.rgb 126 182 255


ok : Ui.Color
ok =
    Ui.rgb 120 220 150


err : Ui.Color
err =
    Ui.rgb 255 117 117


-- ─── Entry point ────────────────────────────────────────────────
aiView : AiFilter -> AiData -> List (Element Msg)
aiView filter data =
    [ slotsPanel filter data.slots
    , enginesPanel data.engines
    , callsPanel filter data.calls
    , evalsPanel filter data.evals
    , trainingPanel data.training
    , tiersPanel data.tiers
    , registryPanel filter data.registry
    ]


-- ─── Slots ──────────────────────────────────────────────────────
slotsPanel : AiFilter -> List AiSlot -> Element Msg
slotsPanel filter slots =
    panel
        "Model slots"
        (if List.isEmpty slots then
            [ emptyState "No Std.Ai slot has been used by this process yet." ]

        else
            List.map (slotRow filter) slots)


slotRow : AiFilter -> AiSlot -> Element Msg
slotRow filter s =
    Ui.column
        [ Ui.width Ui.fill
        , Ui.paddingXY 0 8
        , Ui.spacing 4
        , Border.widthEach { top = 0, right = 0, bottom = 1, left = 0 }
        , Border.color borderSoft
        , Ui.htmlAttribute "data-ai-slot" s.slot
        ]
        [ Ui.row
              [ Ui.spacing 12, Ui.width Ui.fill ]
              [ chip
                    (filter.slot == s.slot)
                    ("slot " ++ s.slot)
                    (AiPickSlot s.slot)
              , muted s.mode
              , mono s.target
              , Ui.el [ Ui.width Ui.fill ] (Ui.text "")
              , muted
                    (String.fromInt s.inFlight ++ "/"
                        ++ String.fromInt s.maxInFlight
                        ++ " in flight · "
                        ++ String.fromInt s.waiting
                        ++ "/"
                        ++ String.fromInt s.queue
                        ++ " waiting")
              ]
        , muted
              (String.fromInt s.calls ++ " calls · " ++ String.fromInt s.failures
                  ++ " failed · "
                  ++ String.fromInt s.overloaded
                  ++ " overloaded · p50 "
                  ++ String.fromInt s.p50Ms
                  ++ " ms · p95 "
                  ++ String.fromInt s.p95Ms
                  ++ " ms")
        , Ui.paragraph
              [ Font.size 12, Font.color textMuted ]
              [ Ui.text (String.join " · " (List.map settingText s.settings)) ]
        ]


settingText : AiSetting -> String
settingText st =
    st.key ++ "=" ++ st.value ++ " (" ++ st.source ++ ")"


-- ─── Engines ────────────────────────────────────────────────────
enginesPanel : List AiEngine -> Element Msg
enginesPanel engines =
    panel
        "Local engines"
        (if List.isEmpty engines then
            [ emptyState "No local engine is running in this process." ]

        else
            List.map engineRow engines)


engineRow : AiEngine -> Element Msg
engineRow e =
    Ui.column
        [ Ui.width Ui.fill
        , Ui.paddingXY 0 6
        , Ui.spacing 4
        , Border.widthEach { top = 0, right = 0, bottom = 1, left = 0 }
        , Border.color borderSoft
        ]
        [ Ui.row
              [ Ui.spacing 12 ]
              [ Ui.el [ Font.bold, Font.size 13 ] (Ui.text e.slot)
              , Ui.el
                    [ Font.size 12
                    , Font.color
                          (if e.state == "ready" then
                              ok

                          else
                              textSecondary)
                    ]
                    (Ui.text e.state)
              , mono e.model
              ]
        , muted
              (e.accelerator ++ " · context " ++ String.fromInt e.contextTokens
                  ++ " · GPU layers "
                  ++ String.fromInt e.gpuLayers
                  ++ " · restarts "
                  ++ String.fromInt e.restarts
                  ++ " · idle "
                  ++ String.fromInt e.idleSeconds
                  ++ " s")
        , if e.lastCrash == "" then
              Ui.none

          else
              Ui.paragraph
                  [ Font.size 12, Font.color err ]
                  [ Ui.text ("last crash: " ++ e.lastCrash) ]
        ]


-- ─── Recent calls ───────────────────────────────────────────────
callsPanel : AiFilter -> List AiCall -> Element Msg
callsPanel filter calls =
    panel
        "Recent model calls"
        (Ui.row
            [ Ui.spacing 8 ]
            [ chip (not filter.failedOnly) "All" (AiShowFailed False)
            , chip filter.failedOnly "Failed" (AiShowFailed True)
            , if filter.slot == "" then
                  Ui.none

              else
                  chip False "All slots" (AiPickSlot "")
            ]
            :: (if List.isEmpty calls then
                   [ emptyState "No model call matches." ]

               else
                   List.map callRow calls))


callRow : AiCall -> Element Msg
callRow c =
    Ui.row
        [ Ui.width Ui.fill
        , Ui.paddingXY 0 5
        , Ui.spacing 12
        , Border.widthEach { top = 0, right = 0, bottom = 1, left = 0 }
        , Border.color borderSoft
        , Ui.htmlAttribute "data-ai-call" c.outcome
        ]
        [ Ui.el
              [ Ui.width (Ui.px 90), Font.size 12, Font.color textMuted ]
              (Ui.text (clock c.ts))
        , Ui.el [ Ui.width (Ui.px 80), Font.size 13 ] (Ui.text c.slot)
        , Ui.el
              [ Ui.width (Ui.px 50), Font.size 12, Font.color textMuted ]
              (Ui.text c.kind)
        , Ui.el
              [ Ui.width (Ui.px 130)
              , Font.size 12
              , Font.bold
              , Font.color
                    (if c.outcome == "ok" then
                        ok

                    else
                        err)
              ]
              (Ui.text c.outcome)
        , Ui.el
              [ Ui.width (Ui.px 80), Font.size 12 ]
              (Ui.text (String.fromInt c.latencyMs ++ " ms"))
        , Ui.el
              [ Ui.width (Ui.px 110), Font.size 12, Font.color textMuted ]
              (Ui.text
                  (String.fromInt c.promptTokens ++ " in · "
                      ++ String.fromInt c.completionTokens
                      ++ " out"))
        , mono c.model
        ]


-- ─── Eval runs ──────────────────────────────────────────────────
evalsPanel : AiFilter -> List AiEval -> Element Msg
evalsPanel filter evals =
    panel
        "Eval runs"
        (if List.isEmpty evals then
            [ emptyState
                  "No Std.Ai.Eval run in this process or in the app's database yet."
            ]

        else
            List.map (evalRow filter) evals)


evalRow : AiFilter -> AiEval -> Element Msg
evalRow filter e =
    let
        open = filter.openEval == e.id
    in
        Ui.column
            [ Ui.width Ui.fill
            , Ui.paddingXY 0 6
            , Ui.spacing 4
            , Border.widthEach { top = 0, right = 0, bottom = 1, left = 0 }
            , Border.color borderSoft
            , Ui.htmlAttribute "data-ai-eval" e.id
            ]
            (Ui.row
                [ Ui.spacing 12
                , Ui.width Ui.fill
                , Ui.pointer
                , Ui.onClick (AiOpenEval e.id)
                ]
                [ Ui.el
                      [ Font.bold, Font.size 13 ]
                      (Ui.text ("eval " ++ e.suite))
                , muted e.model
                , evalSource e.source
                , Ui.el
                      [ Font.size 12 ]
                      (Ui.text (percent e.passRate ++ " passed"))
                , muted
                      (String.fromInt e.passed ++ " passed · "
                          ++ String.fromInt e.failed
                          ++ " failed · "
                          ++ String.fromInt e.errors
                          ++ " errors · p95 "
                          ++ String.fromInt e.p95LatencyMs
                          ++ " ms")
                , Ui.el [ Ui.width Ui.fill ] (Ui.text "")
                , Ui.el
                      [ Font.size 12
                      , Font.bold
                      , Font.color
                            (if e.verdict == "passed" then
                                ok

                            else
                                err)
                      ]
                      (Ui.text ("gate " ++ e.verdict))
                , muted
                      (if open then
                          "hide cases"

                      else
                          "show cases")
                ]
                :: (if open then
                       List.map failureLine e.failures
                           ++ List.map caseRow e.caseResults

                   else
                       []))


-- Where a run came from: "from database" for a run read from the app's
-- database (another process's, such as `sky ai eval` in CI or a terminal),
-- "this process" for one this process made.
evalSource : String -> Element Msg
evalSource source =
    Ui.el
        [ Font.size 11
        , Font.color textMuted
        , Ui.paddingXY 6 1
        , Border.rounded 8
        , Border.width 1
        , Border.color borderSoft
        , Ui.htmlAttribute "data-ai-eval-source" source
        ]
        (Ui.text
            (if source == "database" then
                "from database"

            else
                "this process"))


failureLine : String -> Element Msg
failureLine f =
    Ui.paragraph [ Font.size 12, Font.color err ] [ Ui.text ("gate: " ++ f) ]


caseRow : AiEvalCase -> Element Msg
caseRow c =
    Ui.row
        [ Ui.spacing 12
        , Ui.paddingXY 12 2
        , Ui.htmlAttribute "data-ai-case" c.id
        ]
        [ Ui.el
              [ Ui.width (Ui.px 60)
              , Font.size 12
              , Font.bold
              , Font.color
                    (if c.passed then
                        ok

                    else
                        err)
              ]
              (Ui.text
                  (if c.passed then
                      "pass"

                  else
                      "fail"))
        , Ui.el
              [ Ui.width (Ui.px 140), Font.size 12 ]
              (Ui.text ("case " ++ c.id))
        , Ui.el
              [ Ui.width (Ui.px 70), Font.size 12, Font.color textMuted ]
              (Ui.text (String.fromInt c.latencyMs ++ " ms"))
        , Ui.paragraph
              [ Font.size 12, Font.color textSecondary ]
              [ Ui.text c.reason ]
        ]


-- ─── Training runs ──────────────────────────────────────────────
trainingPanel : List AiTrainingRun -> Element Msg
trainingPanel runs =
    panel
        "Training"
        (if List.isEmpty runs then
            [ emptyState
                  "No Std.Ai.Train run in this process or in .sky/ai/runs yet."
            ]

        else
            List.map trainingRow runs)


trainingRow : AiTrainingRun -> Element Msg
trainingRow r =
    Ui.row
        [ Ui.width Ui.fill
        , Ui.paddingXY 0 6
        , Ui.spacing 12
        , Border.widthEach { top = 0, right = 0, bottom = 1, left = 0 }
        , Border.color borderSoft
        , Ui.htmlAttribute "data-ai-training" r.run
        ]
        [ Ui.column
              [ Ui.width Ui.fill, Ui.spacing 4 ]
              [ Ui.row
                    [ Ui.spacing 12, Ui.width Ui.fill ]
                    [ Ui.el
                          [ Font.bold, Font.size 13 ]
                          (Ui.text ("run " ++ r.run))
                    , Ui.el
                          [ Font.size 12
                          , Font.bold
                          , Font.color (statusColour r.status)
                          , Ui.htmlAttribute "data-ai-train-status" r.status
                          ]
                          (Ui.text r.status)
                    , muted
                          (if r.backend == "" then
                              "backend pending"

                          else
                              "backend " ++ r.backend)
                    , Ui.el
                          [ Font.size 12
                          , Ui.htmlAttribute
                                "data-ai-train-step"
                                (String.fromInt r.step)
                          ]
                          (Ui.text (stepText r))
                    ]
              , Ui.row
                    [ Ui.spacing 12 ]
                    [ muted ("loss " ++ maybeLoss r.loss)
                    , muted ("eval loss " ++ maybeLoss r.valLoss)
                    , muted (relaunchText r)
                    , if r.peakBytes > 0 then
                          Ui.el
                              [ Font.size 12
                              , Ui.htmlAttribute
                                    "data-ai-train-peak"
                                    (String.fromInt r.peakBytes)
                              ]
                              (Ui.text ("peak memory " ++ bytesText r.peakBytes))

                      else
                          Ui.none
                    , if r.cloud == "" then
                          Ui.none

                      else
                          Ui.el
                              [ Font.size 12
                              , Ui.htmlAttribute
                                    "data-ai-train-cloud"
                                    r.cloudState
                              ]
                              (Ui.text
                                  (r.cloud ++ " · " ++ r.cloudState
                                      ++ " · spent "
                                      ++ r.spent
                                      ++ " of "
                                      ++ r.budget))
                    , muted
                          (if r.lastCheckpoint > 0 then
                              "checkpoint at step "
                                  ++ String.fromInt r.lastCheckpoint

                          else
                              "no checkpoint")
                    , if r.registered == "" then
                          Ui.none

                      else
                          Ui.el
                              [ Font.size 12
                              , Font.color ok
                              , Ui.htmlAttribute
                                    "data-ai-train-registered"
                                    r.registered
                              ]
                              (Ui.text ("registered " ++ r.registered))
                    ]
              , if r.message /= ""
                    && (r.status == "failed" || r.status == "cancelled") then
                    Ui.paragraph
                        [ Font.size 12, Font.color err ]
                        [ Ui.text r.message ]

                else
                    Ui.none
              ]
        , lossCurve r.losses
        ]


-- ─── GPU tiers ──────────────────────────────────────────────────
tiersPanel : List AiTier -> Element Msg
tiersPanel tiers =
    if List.isEmpty tiers then
        Ui.none

    else
        panel "GPU tiers" (List.map tierRow tiers)


tierRow : AiTier -> Element Msg
tierRow t =
    Ui.column
        [ Ui.width Ui.fill
        , Ui.paddingXY 0 6
        , Ui.spacing 4
        , Border.widthEach { top = 0, right = 0, bottom = 1, left = 0 }
        , Border.color borderSoft
        , Ui.htmlAttribute "data-ai-tier" t.bind
        ]
        [ Ui.row
              [ Ui.spacing 12 ]
              [ Ui.el
                    [ Font.bold, Font.size 13 ]
                    (Ui.text ("tier " ++ t.bind ++ " · " ++ t.base))
              , Ui.el
                    [ Font.size 12
                    , Font.bold
                    , Font.color
                          (if t.ready then
                              ok

                          else
                              err)
                    ]
                    (Ui.text
                        (if t.ready then
                            "ready"

                        else
                            "not ready: " ++ t.reason))
              ]
        , Ui.row
              [ Ui.spacing 12 ]
              [ muted ("adapters " ++ String.join ", " t.resident)
              , muted ("in flight " ++ String.fromInt t.inFlight)
              , muted
                    ("engine running " ++ String.fromFloat t.running
                        ++ ", waiting "
                        ++ String.fromFloat t.waiting)
              , muted
                    ("KV cache "
                        ++ String.fromInt (Math.round (100.0 * t.kvCache))
                        ++ " %")
              , muted
                    ("loads " ++ String.fromInt t.loads ++ ", unloads "
                        ++ String.fromInt t.unloads)
              ]
        ]


stepText : AiTrainingRun -> String
stepText r =
    if r.totalSteps > 0 then
        "step " ++ String.fromInt r.step ++ " of "
            ++ String.fromInt r.totalSteps

    else
        "step " ++ String.fromInt r.step


relaunchText : AiTrainingRun -> String
relaunchText r =
    if r.relaunches == 0 then
        "no relaunch"

    else
        String.fromInt r.relaunches
            ++ (if r.relaunches == 1 then
                   " relaunch"

               else
                   " relaunches")
            ++ ", resumed from step "
            ++ String.fromInt r.resumedFrom


statusColour : String -> Ui.Color
statusColour status =
    if status == "done" then
        ok

    else if status == "failed" then
        err

    else if status == "cancelled" then
        textMuted

    else
        accent


-- A byte count for a person: 1089914008 → "1.09 GB", 52428800 → "52.4 MB".
bytesText : Int -> String
bytesText n =
    if n >= 1000000000 then
        fixed 100 (toFloat n / 1.0e9) ++ " GB"

    else
        fixed 10 (toFloat n / 1000000.0) ++ " MB"


-- f rounded to 1 / scale (scale 10 or 100): fixed 100 1.0899 → "1.09".
fixed : Int -> Float -> String
fixed scale f =
    let
        scaled = Math.round (f * toFloat scale)
        width =
            if scale == 100 then
                2

            else
                1
    in
        String.fromInt (scaled // scale) ++ "."
            ++ String.padLeft width '0' (String.fromInt (modBy scale scaled))


maybeLoss : Maybe Float -> String
maybeLoss m =
    case m of

        Just v ->
            lossText v

        Nothing ->
            "-"


-- A loss with four decimals: 0.0042 → "0.0042", 2 → "2.0000".
lossText : Float -> String
lossText f =
    let
        scaled = Math.round (f * 10000.0)
        whole = scaled // 10000
        frac = modBy 10000 scaled
    in
        String.fromInt whole ++ "."
            ++ String.padLeft 4 '0' (String.fromInt frac)


-- The training loss over the run's steps (the runtime thins it to at most
-- 200 points). A run with fewer than two points has no curve yet.
lossCurve : List Float -> Element Msg
lossCurve values =
    let
        cfg =
            Chart.defaultCfg |> Chart.withWidth 160 |> Chart.withHeight 36
                |> Chart.withColor accent
                |> Chart.withGridLines False
    in
        if List.length values < 2 then
            Ui.el
                [ Ui.width (Ui.px 164)
                , Background.color bgCode
                , Border.rounded 3
                , Ui.paddingXY 6 6
                , Font.color textMuted
                , Font.size 10
                ]
                (Ui.text "no loss curve yet")

        else
            Ui.el
                [ Ui.width (Ui.px 164)
                , Background.color bgCode
                , Border.rounded 3
                , Ui.padding 2
                , Ui.htmlAttribute
                      "data-ai-train-curve"
                      (String.fromInt (List.length values))
                ]
                (Chart.sparkline cfg values)


-- ─── Model registry ─────────────────────────────────────────────
registryPanel : AiFilter -> List AiModel -> Element Msg
registryPanel filter models =
    panel
        "Model registry"
        (if List.isEmpty models then
            [ emptyState
                  "No Std.Ai.Registry model has been read or changed by this process yet."
            ]

        else
            List.map (modelRow filter) models)


modelRow : AiFilter -> AiModel -> Element Msg
modelRow filter m =
    let
        open = filter.openModel == m.name
    in
        Ui.column
            [ Ui.width Ui.fill
            , Ui.paddingXY 0 6
            , Ui.spacing 4
            , Border.widthEach { top = 0, right = 0, bottom = 1, left = 0 }
            , Border.color borderSoft
            , Ui.htmlAttribute "data-ai-model" m.name
            ]
            (Ui.row
                [ Ui.spacing 12
                , Ui.width Ui.fill
                , Ui.pointer
                , Ui.onClick (AiOpenModel m.name)
                ]
                ([ Ui.el
                      [ Font.bold, Font.size 13 ]
                      (Ui.text ("model " ++ m.name))
                ]
                    ++ List.map aliasChip m.aliases
                    ++ [ Ui.el [ Ui.width Ui.fill ] (Ui.text "")
                       , muted m.store
                       , muted
                             (if open then
                                 "hide versions"

                             else
                                 "show versions")
                       ])
                :: (if open then
                       List.concat
                           [ sectionTitle "versions"
                                 :: List.map versionRow m.versions
                           , sectionTitle "alias log"
                                 :: List.map eventRow m.events
                           , sectionTitle "eval history"
                                 :: List.map reportRow m.reports
                           ]

                   else
                       []))


aliasChip : AiAlias -> Element Msg
aliasChip a =
    Ui.el
        [ Ui.paddingXY 8 2
        , Border.rounded 10
        , Border.width 1
        , Border.color accent
        , Font.size 12
        , Font.color accent
        , Ui.htmlAttribute "data-ai-alias" a.aliasName
        ]
        (Ui.text (a.aliasName ++ " → v" ++ String.fromInt a.number))


sectionTitle : String -> Element Msg
sectionTitle t =
    Ui.el
        [ Font.size 11, Font.bold, Font.color textMuted, Ui.paddingXY 12 4 ]
        (Ui.text (String.toUpper t))


versionRow : AiVersion -> Element Msg
versionRow v =
    Ui.row
        [ Ui.spacing 12
        , Ui.paddingXY 12 2
        , Ui.htmlAttribute "data-ai-version" v.label
        ]
        [ Ui.el
              [ Ui.width (Ui.px 150), Font.size 12, Font.bold ]
              (Ui.text v.label)
        , Ui.el
              [ Ui.width (Ui.px 110), Font.size 12, Font.color textMuted ]
              (Ui.text (v.method ++ " · " ++ v.format))
        , mono ("sha256:" ++ String.left 12 v.digest)
        , muted ("base " ++ String.left 12 v.baseDigest)
        , muted ("data " ++ v.dataset)
        , if v.blocked == "" then
              Ui.none

          else
              Ui.el
                  [ Font.size 12, Font.color err ]
                  (Ui.text ("blocked: " ++ v.blocked))
        ]


eventRow : AiAliasEvent -> Element Msg
eventRow e =
    Ui.row
        [ Ui.spacing 12
        , Ui.paddingXY 12 2
        , Ui.htmlAttribute
              "data-ai-event"
              (e.aliasName ++ "#" ++ String.fromInt e.seq)
        ]
        [ Ui.el
              [ Ui.width (Ui.px 150), Font.size 12 ]
              (Ui.text (e.aliasName ++ " #" ++ String.fromInt e.seq))
        , Ui.el
              [ Ui.width (Ui.px 70)
              , Font.size 12
              , Font.bold
              , Font.color
                    (if e.action == "promote" then
                        ok

                    else
                        textSecondary)
              ]
              (Ui.text e.action)
        , Ui.el
              [ Font.size 12 ]
              (Ui.text
                  ((if e.from == 0 then
                      "(none)"

                  else
                      "v" ++ String.fromInt e.from)
                      ++ " → v"
                      ++ String.fromInt e.to))
        , muted
              (if e.reason /= "" then
                  "reason: " ++ e.reason

              else if e.report /= "" then
                  "report " ++ e.report

              else
                  "")
        ]


reportRow : AiReportLink -> Element Msg
reportRow r =
    Ui.row
        [ Ui.spacing 12
        , Ui.paddingXY 12 2
        , Ui.htmlAttribute "data-ai-report" r.digest
        ]
        [ Ui.el
              [ Ui.width (Ui.px 150), Font.size 12 ]
              (Ui.text (r.suite ++ " on v" ++ String.fromInt r.number))
        , Ui.el [ Font.size 12 ] (Ui.text (percent r.passRate ++ " passed"))
        , Ui.el
              [ Font.size 12
              , Font.bold
              , Font.color
                    (if r.verdict == "passed" then
                        ok

                    else
                        err)
              ]
              (Ui.text ("gate " ++ r.verdict))
        , muted r.digest
        ]


-- ─── Primitives ─────────────────────────────────────────────────
panel : String -> List (Element Msg) -> Element Msg
panel title children =
    Ui.column
        [ Background.color bgRaised
        , Border.width 1
        , Border.color border_
        , Border.rounded 6
        , Ui.padding 14
        , Ui.spacing 6
        , Ui.width Ui.fill
        ]
        (Ui.el
            [ Font.size 12
            , Font.bold
            , Font.color textMuted
            , Font.letterSpacing 5.0e-2
            , Ui.paddingXY 0 4
            ]
            (Ui.text (String.toUpper title))
            :: children)


chip : Bool -> String -> Msg -> Element Msg
chip active label msg =
    Ui.el
        [ Ui.paddingXY 10 4
        , Border.rounded 12
        , Border.width 1
        , Border.color
              (if active then
                  accent

              else
                  border_)
        , Background.color
              (if active then
                  accent

              else
                  bgRaised)
        , Font.size 12
        , Font.color
              (if active then
                  Ui.rgb 20 23 28

              else
                  textSecondary)
        , Ui.pointer
        , Ui.onClick msg
        ]
        (Ui.text label)


muted : String -> Element Msg
muted s =
    Ui.el [ Font.size 12, Font.color textMuted ] (Ui.text s)


mono : String -> Element Msg
mono s =
    Ui.el
        [ Background.color bgCode
        , Border.rounded 3
        , Ui.paddingXY 6 2
        , Font.family "ui-monospace, Menlo, monospace"
        , Font.size 12
        , Font.color textPrimary
        ]
        (Ui.text s)


emptyState : String -> Element Msg
emptyState message =
    Ui.el
        [ Ui.padding 20, Ui.centerX, Font.color textMuted, Font.italic ]
        (Ui.text message)


-- "2026-10-11T18:04:05.123Z" → "18:04:05".
clock : String -> String
clock ts =
    String.left 8 (String.dropLeft 11 ts)


percent : Float -> String
percent x =
    String.fromInt (Math.round (x * 100.0)) ++ "%"
