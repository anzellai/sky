module View exposing (view)

import Sky.Core.Prelude exposing (..)
import Sky.Core.List as List
import Sky.Core.String as String
import Std.Ui as Ui
import Std.Ui exposing (Element)
import Std.Ui.Background as Background
import Std.Ui.Border as Border
import Std.Ui.Font as Font
import State exposing (..)
import Overview exposing (viewOverview)
import LogsTab exposing (viewLogsTab)
import MetricsTab exposing (viewMetricsTab)
import TracesTab exposing (viewTracesTab)
import ErrorsTab exposing (viewErrorsTab)


-- ─── Palette ─────────────────────────────────────────────────────
-- Single palette helper module so every surface flows through named
-- colours, not scattered hex literals. Native dark theme — the
-- console targets developer eyes in long sessions.

-- Page + raised surfaces share the same dark canvas; panels are
-- distinguished by border, not by a contrasting block. This avoids
-- the "empty band below the panel" visual gap when content is
-- short — the area below a panel reads as page chrome, not as a
-- missing content tier. Header / tab strip use bgSurface (a hair
-- lighter) for the chrome separation.
bgPage : Ui.Color
bgPage =
    Ui.rgb 20 23 28


bgSurface : Ui.Color
bgSurface =
    Ui.rgb 28 32 39


bgRaised : Ui.Color
bgRaised =
    Ui.rgb 20 23 28


bgCode : Ui.Color
bgCode =
    Ui.rgb 44 50 60


border_ : Ui.Color
border_ =
    Ui.rgb 53 59 70


borderSoft : Ui.Color
borderSoft =
    Ui.rgb 42 47 56


textPrimary : Ui.Color
textPrimary =
    Ui.rgb 240 243 247


textSecondary : Ui.Color
textSecondary =
    Ui.rgb 197 203 212


textMuted : Ui.Color
textMuted =
    Ui.rgb 141 150 163


accent : Ui.Color
accent =
    Ui.rgb 126 182 255


warn : Ui.Color
warn =
    Ui.rgb 255 178 77


err : Ui.Color
err =
    Ui.rgb 255 117 117


-- ─── Top-level view ──────────────────────────────────────────────
view : Model -> Element Msg
view model =
    Ui.column
        [ Ui.width Ui.fill
        , Ui.height Ui.fill
        , Background.color bgPage
        , Font.color textPrimary
        , Font.family "system-ui, -apple-system, sans-serif"
        ]
        -- Title takes all available width — naturally pushes the
        -- meta to the right. Without `width fill` here the two
        -- siblings collapse to content and the meta crashes into
        -- the title with no breathing room.
        [ header model, tabStrip model.tab, content model ]


-- ─── Header ──────────────────────────────────────────────────────
header : Model -> Element Msg
header model =
    Ui.row
        [ Ui.width Ui.fill
        , Ui.paddingXY 20 12
        , Ui.spacing 20
        , Background.color bgSurface
        , Border.widthEach { top = 0, right = 0, bottom = 1, left = 0 }
        , Border.color border_
        ]
        [ Ui.el
              [ Ui.width Ui.fill, Font.size 16, Font.bold ]
              (Ui.text "Sky Console")
        , Ui.el
              [ Font.color textSecondary
              , Font.size 12
              , Font.family "ui-monospace, Menlo, monospace"
              ]
              (Ui.text (headerMeta model.overview))
        ]


headerMeta : Overview -> String
headerMeta o =
    let
        -- Histograms show count + sum/count (avg); counters / gauges
        -- show the raw value. Picks the most useful single number
        -- per metric type.
        mode =
            if o.productionMode then
                "prod"

            else
        -- Show first 8 chars of the session id (full sids are too
        -- long for the column). Click → pivot all logs to this
        -- session via LogFilterPickSession Msg.
                "dev"
    in
        "Sky " ++ o.skyVersion ++ " · " ++ mode ++ " · uptime "
            ++ formatUptime o.uptimeSeconds


formatUptime : Int -> String
formatUptime s =
    if s < 60 then
        String.fromInt s ++ "s"

    else if s < 3600 then
        String.fromInt (s // 60) ++ "m"

    else
        String.fromInt (s // 3600) ++ "h"


-- ─── Tab strip ───────────────────────────────────────────────────
tabStrip : Tab -> Element Msg
tabStrip active =
    Ui.row
        [ Ui.width Ui.fill
        , Ui.paddingXY 20 0
        , Background.color bgSurface
        , Border.widthEach { top = 0, right = 0, bottom = 1, left = 0 }
        , Border.color border_
        ]
        (List.map
            (tabButton active)
            [ OverviewTab, MetricsTab, LogsTab, TracesTab, ErrorsTab ])


tabButton : Tab -> Tab -> Element Msg
tabButton active tab =
    let
        -- Keep a whole trace when ANY of its spans matches the query
        -- (by span name or trace id) — so filtering on "db" still
        -- shows the parent msg / cmd spans for context.
        isActive = active == tab
        underlineColor =
            if isActive then
                accent

            else
                bgSurface
        textColor =
            if isActive then
                accent

            else
                textSecondary
    in
        Ui.el
            [ Ui.paddingXY 14 10
            , Font.size 13
            , Font.color textColor
            , Border.widthEach { top = 0, right = 0, bottom = 2, left = 0 }
            , Border.color underlineColor
            , Ui.pointer
            , Ui.onClick (SelectTab tab)
            ]
            (Ui.text (tabLabel tab))


-- ─── Content router ──────────────────────────────────────────────
content : Model -> Element Msg
content model =
    Ui.column
        [ Ui.width Ui.fill, Ui.padding 20, Ui.spacing 16 ]
        (case model.tab of

            OverviewTab ->
                -- v0.16.4 B5: hub mode shows the multi-service
                -- dashboard (Overview.viewOverview).  Embedded /
                -- standalone modes (no SKY_CONSOLE_HUB_DB) keep
                -- the single-service Overview that's shipped since
                -- v0.16.0 — byte-identical output for embedded
                -- consoles.
                if model.hubDbPath /= "" then
                    viewOverview model

                else
                    overviewView model.overview

            MetricsTab ->
                -- v0.16.4 B6: hub-mode drill-down. When a service
                -- is selected in the multi-service Overview the
                -- new MetricsTab page renders a scope banner +
                -- pre-filtered metrics. Embedded / standalone
                -- consoles keep the existing single-service view.
                if model.hubDbPath /= "" then
                    viewMetricsTab model

                else
                    metricsView model.metrics

            LogsTab ->
                if model.hubDbPath /= "" then
                    viewLogsTab model

                else
                    logsView model

            TracesTab ->
                if model.hubDbPath /= "" then
                    viewTracesTab model

                else
                    tracesView model.traceQuery model.traces

            ErrorsTab ->
                if model.hubDbPath /= "" then
                    viewErrorsTab model

                else
                    errorsView model.errors)


-- ─── Overview tab ────────────────────────────────────────────────
overviewView : Overview -> List (Element Msg)
overviewView o =
    [ kpiRow o, systemPanel o ]


kpiRow : Overview -> Element Msg
kpiRow o =
    Ui.grid
        [ Ui.gridColumns 220, Ui.spacing 12, Ui.width Ui.fill ]
        [ kpiCard "Requests total" (String.fromInt o.requestsTotal)
        , kpiCard "5xx error rate" (formatPercent o.errorRate5xx)
        , kpiCard "Log buffer" (String.fromInt o.bufferLogUsed)
        , kpiCard "Trace buffer" (String.fromInt o.bufferTraceUsed)
        ]


kpiCard : String -> String -> Element Msg
kpiCard label valueText =
    Ui.column
        [ Background.color bgRaised
        , Border.width 1
        , Border.color border_
        , Border.rounded 6
        , Ui.padding 14
        , Ui.spacing 4
        ]
        [ Ui.el
              [ Font.size 11, Font.color textMuted, Font.letterSpacing 5.0e-2 ]
              (Ui.text (String.toUpper label))
        , Ui.el
              [ Font.size 24, Font.bold, Font.color textPrimary ]
              (Ui.text valueText)
        ]


systemPanel : Overview -> Element Msg
systemPanel o =
    panel
        "System"
        [ infoRow "Sky version" o.skyVersion
        , infoRow "Commit" o.commit
        , infoRow "Built at" o.builtAt
        , infoRow "Uptime" (formatUptime o.uptimeSeconds)
        , infoRow
              "Production mode"
              (if o.productionMode then
                  "yes"

              else
                  "no")
        ]


infoRow : String -> String -> Element Msg
infoRow label value =
    Ui.row
        [ Ui.width Ui.fill
        , Ui.paddingXY 0 8
        , Ui.spacing 12
        , Border.widthEach { top = 0, right = 0, bottom = 1, left = 0 }
        , Border.color borderSoft
        ]
        [ Ui.el
              [ Ui.width (Ui.px 180), Font.color textMuted, Font.size 12 ]
              (Ui.text (String.toUpper label))
        , codeBadge value
        ]


-- ─── Logs tab ────────────────────────────────────────────────────
logsView : Model -> List (Element Msg)
logsView model =
    let
        filtered = List.filter (matchFilter model.logFilter) model.logs
    in
        [ logsFilterPanel model.logFilter
        , panel
              "Recent log entries"
              (if List.isEmpty filtered then
                  [emptyState "No log entries match the current filter."]

              else
                  List.map logRow filtered)
        ]


matchFilter : LogFilter -> LogEntry -> Bool
matchFilter f e =
    let
        levelOk =
            case e.level of

                "debug" ->
                    f.showDebug

                "info" ->
                    f.showInfo

                "warn" ->
                    f.showWarn

                "error" ->
                    f.showError

                _ ->
                    True
        sessionOk = f.session == "" || f.session == e.sessionId
        queryOk =
            f.query == ""
                || String.contains
                       (String.toLower f.query)
                       (String.toLower
                           (e.message ++ " " ++ e.route ++ " " ++ e.subapp))
    in
        levelOk && sessionOk && queryOk


logsFilterPanel : LogFilter -> Element Msg
logsFilterPanel f =
    Ui.column
        [ Background.color bgRaised
        , Border.width 1
        , Border.color border_
        , Border.rounded 6
        , Ui.padding 12
        , Ui.spacing 8
        , Ui.width Ui.fill
        ]
        [ Ui.row
              [ Ui.width Ui.fill, Ui.spacing 8 ]
              [ Ui.input
                    [ Ui.htmlAttribute "type" "search"
                    , Ui.htmlAttribute
                          "placeholder"
                          "Search message / route / subapp…"
                    , Ui.htmlAttribute "value" f.query
                    , Ui.onInput LogFilterQuery
                    , Ui.width Ui.fill
                    , Background.color bgCode
                    , Border.width 1
                    , Border.color border_
                    , Border.rounded 4
                    , Ui.paddingXY 8 6
                    , Font.color textPrimary
                    , Font.size 12
                    , Font.family "ui-monospace, Menlo, monospace"
                    ]
              , levelToggle "debug" f.showDebug
              , levelToggle "info" f.showInfo
              , levelToggle "warn" f.showWarn
              , levelToggle "error" f.showError
              , Ui.el
                    [ Ui.paddingXY 8 6
                    , Background.color bgCode
                    , Border.rounded 4
                    , Ui.pointer
                    , Ui.onClick LogFilterClear
                    , Font.color textSecondary
                    , Font.size 11
                    ]
                    (Ui.text "clear")
              ]
        , if f.session == "" then
              Ui.text ""

          else
              Ui.row
                  [ Ui.spacing 6, Font.size 11, Font.color textMuted ]
                  [ Ui.text "Filtering by session: "
                  , Ui.el
                        [ Font.family "ui-monospace, Menlo, monospace"
                        , Font.color accent
                        ]
                        (Ui.text f.session)
                  ]
        ]


levelToggle : String -> Bool -> Element Msg
levelToggle lvl on =
    let
        bg =
            if on then
                bgCode

            else
                bgSurface
        fg =
            if on then
                levelColor lvl

            else
                textMuted
    in
        Ui.el
            [ Background.color bg
            , Border.width 1
            , Border.color border_
            , Border.rounded 4
            , Ui.paddingXY 8 6
            , Ui.pointer
            , Ui.onClick (LogFilterToggleLevel lvl)
            , Font.color fg
            , Font.bold
            , Font.size 11
            ]
            (Ui.text (String.toUpper lvl))


logRow : LogEntry -> Element Msg
logRow e =
    Ui.row
        [ Ui.width Ui.fill
        , Ui.paddingXY 0 6
        , Ui.spacing 12
        , Border.widthEach { top = 0, right = 0, bottom = 1, left = 0 }
        , Border.color borderSoft
        ]
        [ Ui.el
              [ Ui.width (Ui.px 80)
              , Font.color textMuted
              , Font.family "ui-monospace, Menlo, monospace"
              , Font.size 12
              ]
              (Ui.text (compactTime e.time))
        , Ui.el
              [ Ui.width (Ui.px 50)
              , Font.color (levelColor e.level)
              , Font.bold
              , Font.size 12
              ]
              (Ui.text (String.toUpper e.level))
        , subappBadge e.subapp
        , sessionBadge e.sessionId
        , traceBadge e.reqId
        , Ui.el
              [ Ui.width Ui.fill
              , Font.color (levelTextColor e.level)
              , Font.size 13
              ]
              (Ui.text e.message)
        ]


sessionBadge : String -> Element Msg
sessionBadge sid =
    if sid == "" then
        -- Same width as the populated badge so message column
        -- alignment is stable whether session id is present.
        Ui.el [Ui.width (Ui.px 80)] (Ui.text "")

    else
        Ui.el
            [ Ui.width (Ui.px 80)
            , Background.color bgCode
            , Border.rounded 3
            , Ui.paddingXY 6 2
            , Ui.pointer
            , Ui.onClick (LogFilterPickSession sid)
            , Font.family "ui-monospace, Menlo, monospace"
            , Font.size 11
            , Font.color accent
            ]
            (Ui.text (String.left 8 sid))


-- Trace-id badge on a log row. reqId is unified with the OTEL
-- trace id, so its first 8 chars match the `trace <id>` chip on
-- the Traces tab. Click → jump to the filtered Traces tab.
traceBadge : String -> Element Msg
traceBadge tid =
    if tid == "" then
        Ui.el [Ui.width (Ui.px 92)] (Ui.text "")

    else
        Ui.el
            [ Ui.width (Ui.px 92)
            , Background.color bgCode
            , Border.rounded 3
            , Ui.paddingXY 6 2
            , Ui.pointer
            , Ui.onClick (PivotToTrace tid)
            , Font.family "ui-monospace, Menlo, monospace"
            , Font.size 11
            , Font.color textSecondary
            ]
            (Ui.text ("trace " ++ String.left 8 tid))


subappBadge : String -> Element Msg
subappBadge sub =
    if sub == "" then
        -- Same width as the populated badge so the message column
        -- aligns whether the badge is present or not.
        Ui.el [Ui.width (Ui.px 70)] (Ui.text "")

    else
        Ui.el
            [ Ui.width (Ui.px 70)
            , Background.color bgCode
            , Border.rounded 3
            , Ui.paddingXY 6 2
            , Font.family "ui-monospace, Menlo, monospace"
            , Font.size 11
            , Font.color textSecondary
            ]
            (Ui.text sub)


-- Compact a wire timestamp like "2026-05-18T17:34:55.413+01:00" to
-- "17:34:55" so the log row stays one line. Falls back to the
-- input untouched if the string doesn't have the expected ISO
-- shape (e.g. "—" placeholder before first fetch).
compactTime : String -> String
compactTime ts =
    case String.split "T" ts of

        [_date, rest] ->
            String.left 8 rest

        _ ->
            ts


levelColor : String -> Ui.Color
levelColor level =
    case level of

        "warn" ->
            warn

        "error" ->
            err

        _ ->
            textMuted


levelTextColor : String -> Ui.Color
levelTextColor level =
    case level of

        "warn" ->
            warn

        "error" ->
            err

        _ ->
            textPrimary


-- ─── Metrics tab ─────────────────────────────────────────────────
metricsView : List MetricRow -> List (Element Msg)
metricsView rows =
    [panel
        "Metrics snapshot"
        (if List.isEmpty rows then
            [emptyState "No metrics collected yet."]

        else
            List.map metricRowView rows)]


metricRowView : MetricRow -> Element Msg
metricRowView r =
    let
        valueStr =
            case r.typ of

                "histogram" ->
                    "n=" ++ formatFloat r.count ++ " avg="
                        ++ formatAvg r.sum r.count

                _ ->
                    formatFloat r.value
    in
        Ui.row
            [ Ui.width Ui.fill
            , Ui.paddingXY 0 6
            , Ui.spacing 12
            , Border.widthEach { top = 0, right = 0, bottom = 1, left = 0 }
            , Border.color borderSoft
            ]
            [ Ui.el
                  [ Ui.width (Ui.px 60)
                  , Font.size 10
                  , Font.color textMuted
                  , Font.family "ui-monospace, Menlo, monospace"
                  ]
                  (Ui.text (String.toUpper r.typ))
            , Ui.el
                  [ Ui.width (Ui.px 260)
                  , Font.family "ui-monospace, Menlo, monospace"
                  , Font.size 12
                  , Font.color textPrimary
                  ]
                  (Ui.text r.name)
            , Ui.el
                  [ Ui.width (Ui.px 180)
                  , Font.family "ui-monospace, Menlo, monospace"
                  , Font.size 11
                  , Font.color textMuted
                  ]
                  (Ui.text r.labels)
            , codeBadge valueStr
            ]


-- Render a Float as a compact human-readable string. Two decimal
-- places — enough resolution for typical metric values, no
-- scientific-notation surprises.
formatFloat : Float -> String
formatFloat f =
    let
        scaled = Math.round (f * 100.0)
        whole = scaled // 100
        frac = modBy 100 scaled
        fracS =
            if frac < 10 then
                "0" ++ String.fromInt frac

            else
                String.fromInt frac
    in
        if frac == 0 then
            String.fromInt whole

        else
            String.fromInt whole ++ "." ++ fracS


formatAvg : Float -> Float -> String
formatAvg sum count =
    if count == 0.0 then
        "—"

    else
        formatFloat (sum / count)


-- ─── Traces tab ──────────────────────────────────────────────────
tracesView : String -> List TraceRow -> List (Element Msg)
tracesView query rows =
    let
        lq = String.toLower (String.trim query)
        matches r =
            String.contains lq (String.toLower r.name)
                || String.contains lq (String.toLower r.traceId)
        keepTrace tid = List.any (\r -> r.traceId == tid && matches r) rows
        visibleIds =
            if lq == "" then
                distinctTraceIds rows

            else
                List.filter keepTrace (distinctTraceIds rows)
    in
        [ tracesFilterPanel query
        , panel
              "Recent traces"
              (if List.isEmpty rows then
                  [emptyState "No traces captured yet."]

              else if List.isEmpty visibleIds then
                  [emptyState "No traces match the filter."]

              else
                  List.map (traceGroupView rows) visibleIds)
        ]


tracesFilterPanel : String -> Element Msg
tracesFilterPanel query =
    Ui.row
        [ Background.color bgRaised
        , Border.width 1
        , Border.color border_
        , Border.rounded 6
        , Ui.padding 12
        , Ui.spacing 8
        , Ui.width Ui.fill
        ]
        [ Ui.input
              [ Ui.htmlAttribute "type" "search"
              , Ui.htmlAttribute
                    "placeholder"
                    "Filter traces by span name or trace id…"
              , Ui.htmlAttribute "value" query
              , Ui.onInput TraceFilterQuery
              , Ui.width Ui.fill
              , Background.color bgCode
              , Border.width 1
              , Border.color border_
              , Border.rounded 4
              , Ui.paddingXY 8 6
              , Font.color textPrimary
              , Font.size 12
              , Font.family "ui-monospace, Menlo, monospace"
              ]
        , Ui.el
              [ Ui.paddingXY 8 6
              , Background.color bgCode
              , Border.rounded 4
              , Ui.pointer
              , Ui.onClick (TraceFilterQuery "")
              , Font.color textSecondary
              , Font.size 11
              ]
              (Ui.text "clear")
        ]


-- Distinct trace ids in first-seen order (no List.sortBy in the
-- Sky stdlib — fold preserving insertion order).
distinctTraceIds : List TraceRow -> List String
distinctTraceIds rows =
    List.foldl
        (\r acc ->
            if r.traceId == "" || List.member r.traceId acc then
                acc

            else
                acc ++ [r.traceId])
        []
        rows


-- Depth of a span in its trace: count parentId hops up to the root.
-- Fuel-capped so a malformed parent cycle can't loop forever.
spanDepth : List TraceRow -> Int -> String -> Int
spanDepth rows fuel parentId =
    if fuel <= 0 || parentId == "" then
        0

    else
        case List.find (\r -> r.spanId == parentId) rows of

            Just parent ->
                1 + spanDepth rows (fuel - 1) parent.parentId

            Nothing ->
                0


-- One trace = its own little tree block: a header carrying the
-- short trace id, then each span indented by its depth.
traceGroupView : List TraceRow -> String -> Element Msg
traceGroupView allRows tid =
    let
        spans = List.filter (\r -> r.traceId == tid) allRows
        shortId =
            if String.length tid >= 8 then
                String.slice 0 8 tid

            else
                tid
        rootName =
            case List.find (\r -> r.parentId == "") spans of

                Just root ->
                    root.name

                Nothing ->
                    case List.head spans of

                        Just s ->
                            s.name

                        Nothing ->
                            "(trace)"
    in
        Ui.column
            [ Ui.width Ui.fill
            , Ui.paddingXY 0 8
            , Ui.spacing 2
            , Border.widthEach { top = 0, right = 0, bottom = 1, left = 0 }
            , Border.color borderSoft
            ]
            (Ui.row
                [ Ui.spacing 8, Ui.paddingXY 0 2 ]
                [ Ui.el
                      [ Font.family "ui-monospace, Menlo, monospace"
                      , Font.size 11
                      , Font.color accent
                      , Background.color bgCode
                      , Ui.paddingXY 6 2
                      , Border.rounded 3
                      ]
                      (Ui.text ("trace " ++ shortId))
                , Ui.el
                      [ Font.size 12, Font.color textSecondary ]
                      (Ui.text
                          (rootName ++ " · "
                              ++ String.fromInt (List.length spans)
                              ++ " spans"))
                ]
                :: List.map (spanRowView allRows) spans)


spanRowView : List TraceRow -> TraceRow -> Element Msg
spanRowView allRows r =
    let
        statusErr = r.status == "error"
        depth = spanDepth allRows 32 r.parentId
        indent = depth * 18
    in
        Ui.row
            [ Ui.width Ui.fill
            , Ui.paddingEach { top = 3, right = 0, bottom = 3, left = indent }
            , Ui.spacing 10
            ]
            [ Ui.el
                  [ Ui.width (Ui.px 76)
                  , Font.color textMuted
                  , Font.family "ui-monospace, Menlo, monospace"
                  , Font.size 11
                  ]
                  (Ui.text (compactTime r.startTime))
            , Ui.el
                  [ Ui.width (Ui.px 40)
                  , Font.color
                        (if statusErr then
                            err

                        else
                            textMuted)
                  , Font.bold
                  , Font.size 10
                  ]
                  (Ui.text
                      (if statusErr then
                          "ERR"

                      else
                          "OK"))
            , Ui.el
                  [ Ui.width Ui.fill
                  , Font.size 13
                  , Font.color textPrimary
                  , Font.family "ui-monospace, Menlo, monospace"
                  ]
                  (Ui.text
                      ((if depth > 0 then
                          "└ "

                      else
                          "")
                          ++ r.name))
            , Ui.el
                  [ Font.color textSecondary
                  , Font.family "ui-monospace, Menlo, monospace"
                  , Font.size 12
                  ]
                  (Ui.text (formatFloat r.durationMs ++ "ms"))
            ]


-- ─── Errors tab ──────────────────────────────────────────────────
errorsView : List ErrorRow -> List (Element Msg)
errorsView rows =
    [panel
        "Top errors by frequency"
        (if List.isEmpty rows then
            [emptyState "No errors recorded — nice work."]

        else
            List.map errorRowView rows)]


errorRowView : ErrorRow -> Element Msg
errorRowView r =
    Ui.row
        [ Ui.width Ui.fill
        , Ui.paddingXY 0 6
        , Ui.spacing 12
        , Border.widthEach { top = 0, right = 0, bottom = 1, left = 0 }
        , Border.color borderSoft
        ]
        [ Ui.el
              [ Ui.width (Ui.px 60)
              , Font.color err
              , Font.bold
              , Font.size 13
              , Font.family "ui-monospace, Menlo, monospace"
              ]
              (Ui.text ("×" ++ String.fromInt r.count))
        , Ui.el [ Font.size 13, Font.color textPrimary ] (Ui.text r.message)
        ]


-- ─── Shared primitives ───────────────────────────────────────────
panel : String -> List (Element Msg) -> Element Msg
panel title children =
    Ui.column
        [ Background.color bgRaised
        , Border.width 1
        , Border.color border_
        , Border.rounded 6
        , Ui.padding 14
        , Ui.spacing 6
        , Ui.width Ui.fill
        ]
        (Ui.el
            [ Font.size 12
            , Font.bold
            , Font.color textMuted
            , Font.letterSpacing 5.0e-2
            , Ui.paddingXY 0 4
            ]
            (Ui.text (String.toUpper title))
            :: children)


codeBadge : String -> Element Msg
codeBadge value =
    Ui.el
        [ Background.color bgCode
        , Border.rounded 3
        , Ui.paddingXY 6 2
        , Font.family "ui-monospace, Menlo, monospace"
        , Font.size 12
        , Font.color textPrimary
        ]
        (Ui.text value)


emptyState : String -> Element Msg
emptyState message =
    Ui.el
        [ Ui.padding 20, Ui.centerX, Font.color textMuted, Font.italic ]
        (Ui.text message)


-- ─── Format helpers ──────────────────────────────────────────────

-- Render a Float in [0, 1] as a percentage with 2dp — `0.012` →
-- `1.20%`. Avoids the float-to-string precision artefacts that
-- String.fromFloat introduces (would emit `1.2000004%`) by
-- scaling via `f * 10000`, rounding to Int, then splitting into
-- whole/fraction parts.
formatPercent : Float -> String
formatPercent f =
    let
        scaled = Math.round (f * 10000.0)
        whole = scaled // 100
        frac = modBy 100 scaled
        fracStr =
            if frac < 10 then
                "0" ++ String.fromInt frac

            else
                String.fromInt frac
    in
        String.fromInt whole ++ "." ++ fracStr ++ "%"


formatRatio : Int -> Int -> String
formatRatio used max_ =
    let
        suffix =
            if max_ >= 1000 then
                String.fromInt (max_ // 1000) ++ "k"

            else
                String.fromInt max_
    in
        String.fromInt used ++ "/" ++ suffix
