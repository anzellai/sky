module MetricsTab exposing (viewMetricsTab)

-- v0.16.4 B6 — per-service drill-down Metrics page. Rendered by
-- View.sky's content router when `Model.hubDbPath /= ""` AND the
-- active tab is `MetricsTab`. Embedded / standalone consoles keep
-- View.sky's existing `metricsView`.
--
-- Layout: scope banner → metrics table (one row per series, sorted
-- by name). Rows are pre-filtered server-side by service name so
-- the table is already scoped to whatever `model.selectedService`
-- is at the time of the fetch.
import Sky.Core.Prelude exposing (..)
import Sky.Core.List as List
import Sky.Core.String as String
import Std.Ui as Ui
import Std.Ui exposing (Element)
import Std.Ui.Background as Background
import Std.Ui.Border as Border
import Std.Ui.Font as Font
import State exposing (..)


bgPage : Ui.Color
bgPage =
    Ui.rgb 20 23 28


bgRaised : Ui.Color
bgRaised =
    Ui.rgb 20 23 28


bgCode : Ui.Color
bgCode =
    Ui.rgb 44 50 60


border_ : Ui.Color
border_ =
    Ui.rgb 53 59 70


borderSoft : Ui.Color
borderSoft =
    Ui.rgb 42 47 56


textPrimary : Ui.Color
textPrimary =
    Ui.rgb 240 243 247


textSecondary : Ui.Color
textSecondary =
    Ui.rgb 197 203 212


textMuted : Ui.Color
textMuted =
    Ui.rgb 141 150 163


accent : Ui.Color
accent =
    Ui.rgb 126 182 255


-- ─── Entry point ────────────────────────────────────────────────
viewMetricsTab : Model -> List (Element Msg)
viewMetricsTab model =
    [ scopeBanner model.selectedService, metricsPanel model.metrics ]


scopeBanner : String -> Element Msg
scopeBanner selected =
    let
        label =
            if selected == "" then
                "All services"

            else
                selected
    in
        Ui.row
            [ Ui.width Ui.fill
            , Ui.spacing 10
            , Background.color bgRaised
            , Border.width 1
            , Border.color border_
            , Border.rounded 6
            , Ui.paddingXY 14 10
            ]
            [ Ui.el
                  [ Font.size 11
                  , Font.color textMuted
                  , Font.letterSpacing 5.0e-2
                  ]
                  (Ui.text "SCOPE")
            , Ui.el
                  [ Font.size 14, Font.bold, Font.color textPrimary ]
                  (Ui.text label)
            , Ui.el [Ui.width Ui.fill] (Ui.text "")
            , allServicesChip (selected == "")
            ]


allServicesChip : Bool -> Element Msg
allServicesChip isActive =
    let
        bg =
            if isActive then
                accent

            else
                bgCode
        fg =
            if isActive then
                bgPage

            else
                textSecondary
    in
        Ui.el
            [ Ui.paddingXY 10 6
            , Background.color bg
            , Border.rounded 4
            , Ui.pointer
            , Ui.onClick (SelectService "")
            , Font.color fg
            , Font.size 12
            , Font.bold
            ]
            (Ui.text "All services")


metricsPanel : List MetricRow -> Element Msg
metricsPanel rows =
    panel
        "Metrics snapshot"
        (if List.isEmpty rows then
            [emptyState
                "No metrics for this service yet — exporters typically push every 2 s."]

        else
            List.map metricRowView rows)


metricRowView : MetricRow -> Element Msg
metricRowView r =
    let
        valueStr =
            case r.typ of

                "histogram" ->
                    "n=" ++ formatFloat r.count ++ " avg="
                        ++ formatAvg r.sum r.count

                _ ->
                    formatFloat r.value
    in
        Ui.row
            [ Ui.width Ui.fill
            , Ui.paddingXY 0 6
            , Ui.spacing 12
            , Border.widthEach { top = 0, right = 0, bottom = 1, left = 0 }
            , Border.color borderSoft
            ]
            [ Ui.el
                  [ Ui.width (Ui.px 60)
                  , Font.size 10
                  , Font.color textMuted
                  , Font.family "ui-monospace, Menlo, monospace"
                  ]
                  (Ui.text (String.toUpper r.typ))
            , Ui.el
                  [ Ui.width (Ui.px 260)
                  , Font.family "ui-monospace, Menlo, monospace"
                  , Font.size 12
                  , Font.color textPrimary
                  ]
                  (Ui.text r.name)
            , Ui.el
                  [ Ui.width (Ui.px 180)
                  , Font.family "ui-monospace, Menlo, monospace"
                  , Font.size 11
                  , Font.color textMuted
                  ]
                  (Ui.text r.labels)
            , codeBadge valueStr
            ]


-- ─── Format helpers ──────────────────────────────────────────────
formatFloat : Float -> String
formatFloat f =
    let
        scaled = Math.round (f * 100.0)
        whole = scaled // 100
        frac = modBy 100 scaled
        fracS =
            if frac < 10 then
                "0" ++ String.fromInt frac

            else
                String.fromInt frac
    in
        if frac == 0 then
            String.fromInt whole

        else
            String.fromInt whole ++ "." ++ fracS


formatAvg : Float -> Float -> String
formatAvg sum count =
    if count == 0.0 then
        "—"

    else
        formatFloat (sum / count)


-- ─── Shared primitives ──────────────────────────────────────────
panel : String -> List (Element Msg) -> Element Msg
panel title children =
    Ui.column
        [ Background.color bgRaised
        , Border.width 1
        , Border.color border_
        , Border.rounded 6
        , Ui.padding 14
        , Ui.spacing 6
        , Ui.width Ui.fill
        ]
        (Ui.el
            [ Font.size 12
            , Font.bold
            , Font.color textMuted
            , Font.letterSpacing 5.0e-2
            , Ui.paddingXY 0 4
            ]
            (Ui.text (String.toUpper title))
            :: children)


codeBadge : String -> Element Msg
codeBadge value =
    Ui.el
        [ Background.color bgCode
        , Border.rounded 3
        , Ui.paddingXY 6 2
        , Font.family "ui-monospace, Menlo, monospace"
        , Font.size 12
        , Font.color textPrimary
        ]
        (Ui.text value)


emptyState : String -> Element Msg
emptyState message =
    Ui.el
        [ Ui.padding 20, Ui.centerX, Font.color textMuted, Font.italic ]
        (Ui.text message)
