module Main exposing (main)

-- Sky Console — Sky.Live entry. Auto-mounted at /_sky/console on
-- every Sky.Live + Sky.Http.Server app in dev mode (see
-- runtime-go/rt/subapp.go::maybeAutoMountConsole); also runs
-- standalone via `sky console [--port N]`.
--
-- When running as a sub-app, the parent passes SKY_PARENT_URL +
-- SKY_LIVE_BASE_PATH + SKY_INGEST_TOKEN. The console reads
-- SKY_PARENT_URL at init time and uses it to fetch real telemetry
-- (overview + logs) from the parent's /_sky/console/api/* JSON
-- endpoints every 2s. Standalone runs leave parentUrl empty and
-- the view shows a short "no parent" placeholder.
--
-- No hand-written JS in this source — every interaction is
-- onClick → Msg → update → re-render via Sky.Live's framework
-- wire. Multi-module split so the type-checker stays well below
-- the heap-exhaustion limit (CLAUDE.md Limitation #17).
import Sky.Core.Prelude exposing (..)
import Sky.Core.System as System
import Sky.Core.Http as Http
import Sky.Core.Json.Decode as Decode
import Sky.Core.Json.Decode.Pipeline as Pipeline
import Sky.Core.Task as Task
import Sky.Core.Maybe as Maybe
import Sky.Core.Dict as Dict
import Std.Cmd as Cmd
import Std.Sub as Sub
import Std.Live exposing (app, route)
import Std.Ui as Ui
import State exposing (..)
import View exposing (view)
import HubStore exposing (hubStore, hubCurrentIdentity)


-- ─── Decoders for the parent's /_sky/console/api/* JSON ──────────

overviewDecoder : Decode.Decoder Overview
overviewDecoder =
    Decode.succeed Overview
        |> Pipeline.optional "skyVersion"      Decode.string "—"
        |> Pipeline.optional "commit"          Decode.string "—"
        |> Pipeline.optional "builtAt"         Decode.string "—"
        |> Pipeline.optional "uptimeSeconds"   intFromFloat 0
        |> Pipeline.optional "requestsTotal"   intFromFloat 0
        |> Pipeline.optional "errorRate5xx"    Decode.float 0.0
        |> Pipeline.optional "bufferLogUsed"   intFromFloat 0
        |> Pipeline.optional "bufferTraceUsed" intFromFloat 0
        |> Pipeline.optional "productionMode"  Decode.bool False


-- Cast Float → Int at the decode boundary so the Model holds
-- whole numbers (Go's JSON encoder emits every numeric as a
-- JSON Number, which Sky's Decode.float reads — but for display
-- purposes we want Int). Math.round handles the float-to-int
-- conversion explicitly.
intFromFloat : Decode.Decoder Int
intFromFloat =
    Decode.map (\f -> Math.round f) Decode.float


logsDecoder : Decode.Decoder (List LogEntry)
logsDecoder =
    Decode.list logEntryDecoder


-- Wire shape: telemetry.LogEntry serialised by Go's JSON encoder.
-- Field names use PascalCase (Go convention). Numeric fields arrive
-- as JSON Number (decoded as Float). SessionID lives in
-- Fields["session_id"] when the entry came from a Sky.Live dispatch.
logEntryDecoder : Decode.Decoder LogEntry
logEntryDecoder =
    Decode.succeed LogEntry
        |> Pipeline.optional "TS"        Decode.string "—"
        |> Pipeline.optional "Level"     Decode.string "info"
        |> Pipeline.optional "Message"   Decode.string ""
        |> Pipeline.optional "Subapp"    Decode.string ""
        |> Pipeline.optional "ReqID"     Decode.string ""
        |> Pipeline.custom (fieldFromFields "session_id")
        |> Pipeline.custom (fieldFromFields "user_label")
        |> Pipeline.optional "Route"     Decode.string ""
        |> Pipeline.optional "Status"    Decode.float 0.0
        |> Pipeline.optional "LatencyMS" Decode.float 0.0


-- Pluck a single field from the entry's `Fields` object (the
-- free-form attrs bag the runtime fills with msg name, session id,
-- user label, etc.). Falls back to "" when the entry doesn't carry
-- the field — common for HTTP-only access logs and non-Live
-- emissions.
fieldFromFields : String -> Decode.Decoder String
fieldFromFields name =
    Decode.oneOf
        [ Decode.at [ "Fields", name ] Decode.string
        , Decode.succeed ""
        ]


-- ─── Metrics / Traces / Errors decoders ─────────────────────────

metricsDecoder : Decode.Decoder (List MetricRow)
metricsDecoder =
    Decode.list metricRowDecoder


metricRowDecoder : Decode.Decoder MetricRow
metricRowDecoder =
    Decode.succeed MetricRow
        |> Pipeline.optional "name"   Decode.string ""
        |> Pipeline.optional "type"   Decode.string ""
        -- `labels` arrives pre-flattened to a "k=v, k=v" string by
        -- HandleConsoleMetricsSummary — decode it directly. (It used
        -- to be a JSON object the pipeline punted on with
        -- `succeed ""`, which is why distinct label-series rendered
        -- as indistinguishable rows.)
        |> Pipeline.optional "labels" Decode.string ""
        |> Pipeline.optional "value"  Decode.float 0.0
        |> Pipeline.optional "sum"    Decode.float 0.0
        |> Pipeline.optional "count"  Decode.float 0.0


tracesDecoder : Decode.Decoder (List TraceRow)
tracesDecoder =
    Decode.list traceRowDecoder


traceRowDecoder : Decode.Decoder TraceRow
traceRowDecoder =
    Decode.succeed TraceRow
        |> Pipeline.optional "traceId"    Decode.string ""
        |> Pipeline.optional "spanId"     Decode.string ""
        |> Pipeline.optional "parentId"   Decode.string ""
        |> Pipeline.optional "name"       Decode.string ""
        |> Pipeline.optional "kind"       Decode.string ""
        |> Pipeline.optional "startTime"  Decode.string "—"
        |> Pipeline.optional "durationMs" Decode.float 0.0
        |> Pipeline.optional "status"     Decode.string ""


errorsDecoder : Decode.Decoder (List ErrorRow)
errorsDecoder =
    Decode.list errorRowDecoder


errorRowDecoder : Decode.Decoder ErrorRow
errorRowDecoder =
    Decode.succeed ErrorRow
        |> Pipeline.optional "count"   Decode.int 0
        |> Pipeline.optional "message" Decode.string ""


-- ─── Store factory (v0.16.4 B3) ─────────────────────────────────


-- Build the HTTP-backed Store the embedded console uses.  Each
-- field closes over the parent URL + the locally-defined decoder
-- and delegates to the same Http.get + Decode.decodeString pipeline
-- as before.  v0.16.4 hub mounts will plug in `hubStore` instead
-- (B4) — same shape, SQLite-backed.
httpStore : String -> Store
httpStore parent =
    { readOverview = \_ -> fetchOverview parent
    , readLogs     = \filter -> fetchLogs parent filter
    , readMetrics  = \_ -> fetchMetrics parent
    , readTraces   = \_ -> fetchTraces parent
    , readErrors   = \_ -> fetchErrors parent
    , listServices = \_ -> Task.succeed [ "" ]
    -- v0.16.4 B5: the embedded console fetches its telemetry from
    -- the parent app's /_sky/console/api/* endpoints which only
    -- model a single service (the host).  Return an empty list so
    -- the multi-service Overview never fires when running in
    -- embedded mode — the View router falls through to the
    -- single-service `overviewView` automatically (it gates on
    -- `hubDbPath /= ""`).
    , readServiceStats = \_ -> Task.succeed []
    -- v0.16.4 B6: per-service drill-down reads. Embedded mode has
    -- only one service (the host app); ignore the `svc` arg and
    -- forward to the existing single-service reader. Drill-down
    -- UI is hub-mode-only, but the Store typed-alias still
    -- requires every field so we wire reasonable no-ops here.
    , readFilteredLogs = \_svc filter -> fetchLogs parent filter
    , readFilteredMetrics = \_svc -> fetchMetrics parent
    , readFilteredTraces = \_svc -> fetchTraces parent
    , readFilteredErrors = \_svc -> fetchErrors parent
    }


-- ─── Init / update / subscriptions / view ────────────────────────

init : a -> ( Model, Cmd Msg )
init _req =
    let
        parent = System.getenvOr "SKY_PARENT_URL" ""
        hubDbPath = System.getenvOr "SKY_CONSOLE_HUB_DB" ""

        -- v0.16.4 Option B B4: when SKY_CONSOLE_HUB_DB is set the
        -- console is running IN-PROCESS with the hub daemon and
        -- reads telemetry via direct SQLite kernels (HubStore.sky)
        -- against the hub's console-hot.db.  Otherwise stick with
        -- the embedded-mode HTTP-backed Store (httpStore) that
        -- shipped in B3.  Either factory returns the same Store
        -- typed record; downstream code (fetchForTab,
        -- fetchLogsOnly, …) doesn't change.
        chosenStore =
            if hubDbPath /= "" then
                hubStore hubDbPath
            else
                httpStore parent

        -- When the hub mode is active we always render against
        -- real data — the parent-url-empty placeholder text is
        -- specific to standalone `sky console` invocations that
        -- have NEITHER a parent NOR a hub DB.
        isStandalone =
            parent == "" && hubDbPath == ""

        -- v0.16.4 B5: pick up `?service=<name>` from the request's
        -- query string so the selection persists across reloads
        -- and `sky-nav` fetches. `init`'s first argument is the
        -- `Request` row-poly value Sky.Live feeds in; we field-
        -- access it via `req.query` (a Dict String String). The
        -- standalone `sky console` path passes `()` instead of a
        -- request, so we guard against missing fields by falling
        -- back to "" via `Dict.get`-returning Maybe.withDefault.
        startModel =
            { tab       = OverviewTab
            , parentUrl = parent
            , hubDbPath = hubDbPath
            , store     = chosenStore
            , overview  = if isStandalone then mockOverview else emptyOverview
            , logs      = if isStandalone then mockLogs else []
            , metrics   = []
            , traces    = []
            , errors    = []
            , lastError = ""
            , logFilter = emptyLogFilter
            , traceQuery = ""
            , selectedService = ""
            , serviceStats = []
            -- v0.16.6 #493 part 2c: identity is fetched async from
            -- the hub via Hub_currentIdentity; until the response
            -- arrives it stays Nothing and tenantPrefix stays "" so
            -- the per-tab queries see all data the operator's gate
            -- let in.
            , identity = Nothing
            , tenantPrefix = ""
            }

        -- Fetch the signed-in identity on boot. Only meaningful
        -- when running in hub mode (hubDbPath != "") with the
        -- auth-gate active; standalone runs and embedded-without-
        -- hub runs both get an Err which the GotIdentity arm
        -- silently absorbs (identity stays Nothing).
        identityCmd =
            if hubDbPath /= "" then
                Cmd.perform (hubCurrentIdentity hubDbPath) GotIdentity
            else
                Cmd.none
    in
    -- Fire one immediate fetch so the initial render isn't empty;
    -- the 3 s Sub.every then keeps it fresh.  When in hub mode the
    -- batch picks up the multi-service stats too via fetchForTab's
    -- OverviewTab branch.  identityCmd lands a single Hub_currentIdentity
    -- result; subsequent update sets model.identity + tenantPrefix.
    ( startModel
    , Cmd.batch
        [ fetchForTab startModel startModel.tab startModel.logFilter
        , identityCmd
        ]
    )


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of
        SelectTab tab ->
            -- Fire a fetch for the newly-active tab IMMEDIATELY
            -- (otherwise the user sees stale / empty data until the
            -- next 3 s Sub.every tick). Tab-scoped to keep wire +
            -- re-render cost bounded — previously fetchAll fired
            -- 5 endpoints every tick which piled up "context canceled"
            -- proxy errors when re-renders ran longer than 3 s on
            -- larger Metrics / Traces datasets.
            ( { model | tab = tab }
            , fetchForTab model tab model.logFilter
            )

        Tick ->
            ( model, fetchForTab model model.tab model.logFilter )

        GotOverview (Ok ov) ->
            ( { model | overview = ov, lastError = "" }, Cmd.none )

        GotOverview (Err e) ->
            ( { model | lastError = errorToString e }, Cmd.none )

        GotLogs (Ok ls) ->
            ( { model | logs = ls, lastError = "" }, Cmd.none )

        GotLogs (Err e) ->
            ( { model | lastError = errorToString e }, Cmd.none )

        GotMetrics (Ok ms) ->
            ( { model | metrics = ms, lastError = "" }, Cmd.none )

        GotMetrics (Err e) ->
            ( { model | lastError = errorToString e }, Cmd.none )

        GotTraces (Ok ts) ->
            ( { model | traces = ts, lastError = "" }, Cmd.none )

        GotTraces (Err e) ->
            ( { model | lastError = errorToString e }, Cmd.none )

        GotErrors (Ok es) ->
            ( { model | errors = es, lastError = "" }, Cmd.none )

        GotErrors (Err e) ->
            ( { model | lastError = errorToString e }, Cmd.none )

        LogFilterQuery q ->
            let
                f = model.logFilter
                f2 = { f | query = q }
            in
            ( { model | logFilter = f2 }
            , fetchLogsOnly model f2
            )

        LogFilterToggleLevel lvl ->
            let
                f = model.logFilter
                f2 =
                    case lvl of
                        "debug" -> { f | showDebug = not f.showDebug }
                        "info"  -> { f | showInfo = not f.showInfo }
                        "warn"  -> { f | showWarn = not f.showWarn }
                        "error" -> { f | showError = not f.showError }
                        _       -> f
            in
            ( { model | logFilter = f2 }
            , fetchLogsOnly model f2
            )

        LogFilterPickSession sid ->
            let
                f = model.logFilter
                f2 = { f | session = sid }
            in
            ( { model | logFilter = f2, tab = LogsTab }
            , fetchLogsOnly model f2
            )

        LogFilterClear ->
            ( { model | logFilter = emptyLogFilter }
            , fetchLogsOnly model emptyLogFilter
            )

        -- Traces filter is purely client-side — every span is
        -- already in model.traces, so no re-fetch is needed.
        TraceFilterQuery q ->
            ( { model | traceQuery = q }, Cmd.none )

        -- Log → trace pivot: clicking a log row's trace-id badge
        -- jumps to the Traces tab pre-filtered to that id, and
        -- fetches traces if they aren't loaded yet.
        PivotToTrace tid ->
            ( { model | tab = TracesTab, traceQuery = tid }
            , Cmd.perform (model.store.readTraces ()) GotTraces
            )

        -- v0.16.4 B5: Multi-service Overview selector. Empty
        -- name = "All services" (aggregate). Selection is
        -- model-only — the URL stays at /_sky/console; the
        -- service is part of in-app state, not the route, so a
        -- shareable link still drops everyone on the same
        -- aggregate landing.
        SelectService name ->
            ( { model | selectedService = name }, Cmd.none )

        GotServiceStats (Ok stats) ->
            ( { model | serviceStats = stats, lastError = "" }, Cmd.none )

        GotServiceStats (Err e) ->
            ( { model | lastError = errorToString e }, Cmd.none )

        -- v0.16.6 #493 part 2c.  Identity arrived from
        -- Hub_currentIdentity.  Success: derive the tenant filter
        -- from the `tenant` claim (operator convention — same
        -- pattern as SkyDeploy).  Failure: silently leave identity
        -- + tenantPrefix at their defaults — the per-tab queries
        -- already use "" as the no-filter sentinel.  We do NOT
        -- surface the Err on `model.lastError` because the
        -- standalone-no-hub path always fails this call and would
        -- otherwise paint a permanent error banner on /_sky/console.
        GotIdentity (Ok identity) ->
            let
                tenant =
                    Maybe.withDefault "" (Dict.get "tenant" identity.claims)
            in
            ( { model
                | identity = Just identity
                , tenantPrefix = tenant
              }
            , Cmd.none
            )

        GotIdentity (Err _) ->
            ( model, Cmd.none )


fetchLogsOnly : Model -> LogFilter -> Cmd Msg
fetchLogsOnly model filter =
    if hasStoreSource model then
        -- v0.16.4 B6: in hub mode the Logs tab is scoped to the
        -- currently-selected service. Route through the filtered
        -- reader so the wire payload is pre-narrowed; embedded
        -- mode (httpStore) ignores the service arg and falls
        -- through to the un-filtered fetch.
        if model.hubDbPath /= "" then
            Cmd.perform
                (model.store.readFilteredLogs model.selectedService filter)
                GotLogs

        else
            Cmd.perform (model.store.readLogs filter) GotLogs

    else
        Cmd.none


-- True when a real data source is wired (embedded mode via SKY_PARENT_URL
-- OR hub mode via SKY_CONSOLE_HUB_DB). Standalone mode (neither set) keeps
-- the mock-data placeholders and skips fetches.
hasStoreSource : Model -> Bool
hasStoreSource model =
    model.parentUrl /= "" || model.hubDbPath /= ""


-- Fetch ONLY what the currently-active tab needs (+ overview,
-- which the header always renders). Pre-2026-05-18 this was
-- `fetchAll` firing all five endpoints every Tick — at 2 s
-- interval with a Metrics tab holding 30+ series, the
-- re-render queue piled up faster than it drained, flooding
-- the server with "context canceled" proxy errors and hanging
-- the browser tab.
--
-- Now: overview always (cheap; needed for the header's uptime
-- + request counter), PLUS exactly one of the current tab's
-- endpoints. Tick interval also bumped to 3 s to give larger
-- re-renders breathing room.
fetchForTab : Model -> Tab -> LogFilter -> Cmd Msg
fetchForTab model tab filter =
    if hasStoreSource model then
        Cmd.batch
            (Cmd.perform (model.store.readOverview ()) GotOverview
                :: tabFetches model tab filter)
    else
        Cmd.none


tabFetches : Model -> Tab -> LogFilter -> List (Cmd Msg)
tabFetches model tab filter =
    -- v0.16.4 B6: in hub mode every drill-down tab routes through
    -- the filtered reader (model.selectedService); embedded mode
    -- ignores the service arg and falls through to the un-filtered
    -- single-service variants. The branching keeps embedded
    -- behaviour byte-identical to pre-B6.
    if model.hubDbPath /= "" then
        case tab of
            OverviewTab ->
                [ Cmd.perform
                    (model.store.readServiceStats ())
                    GotServiceStats
                ]

            LogsTab ->
                [ Cmd.perform
                    (model.store.readFilteredLogs
                        model.selectedService
                        filter)
                    GotLogs
                ]

            MetricsTab ->
                [ Cmd.perform
                    (model.store.readFilteredMetrics
                        model.selectedService)
                    GotMetrics
                ]

            TracesTab ->
                [ Cmd.perform
                    (model.store.readFilteredTraces
                        model.selectedService)
                    GotTraces
                ]

            ErrorsTab ->
                [ Cmd.perform
                    (model.store.readFilteredErrors
                        model.selectedService)
                    GotErrors
                ]

    else
        case tab of
            OverviewTab ->
                -- v0.16.4 B5: in hub mode (Model.hubDbPath /= "") the
                -- Overview tab renders the multi-service dashboard,
                -- which needs per-service rollups.  In embedded mode
                -- (httpStore) `readServiceStats ()` returns
                -- `Task.succeed []` so the dispatch is a no-op for the
                -- rollup state — cheap, no extra wire round-trip.
                [ Cmd.perform (model.store.readServiceStats ()) GotServiceStats ]
            LogsTab     -> [ Cmd.perform (model.store.readLogs filter) GotLogs ]
            MetricsTab  -> [ Cmd.perform (model.store.readMetrics ()) GotMetrics ]
            TracesTab   -> [ Cmd.perform (model.store.readTraces ()) GotTraces ]
            ErrorsTab   -> [ Cmd.perform (model.store.readErrors ()) GotErrors ]


fetchOverview : String -> Task Error Overview
fetchOverview parent =
    Http.get (parent ++ "/_sky/console/api/overview")
        |> Task.andThenResult (\resp -> Decode.decodeString overviewDecoder resp.body)


fetchLogs : String -> LogFilter -> Task Error (List LogEntry)
fetchLogs parent filter =
    Http.get (parent ++ "/_sky/console/api/logs?limit=200" ++ buildLogQuery filter)
        |> Task.andThenResult (\resp -> Decode.decodeString logsDecoder resp.body)


-- Build the level= query string from the filter. Server-side filter
-- on level is precise; query (free-text) and session (pivot) are
-- applied client-side to avoid widening the API surface.
buildLogQuery : LogFilter -> String
buildLogQuery f =
    let
        levels =
            (if f.showDebug then [ "debug" ] else [])
                ++ (if f.showInfo then [ "info" ] else [])
                ++ (if f.showWarn then [ "warn" ] else [])
                ++ (if f.showError then [ "error" ] else [])
    in
    -- All four levels selected = no level filter (don't add a query
    -- param at all so the server returns everything).
    if List.length levels == 4 then
        ""
    else
        "&level=" ++ String.join "," levels


fetchMetrics : String -> Task Error (List MetricRow)
fetchMetrics parent =
    Http.get (parent ++ "/_sky/console/api/metrics-summary")
        |> Task.andThenResult (\resp -> Decode.decodeString metricsDecoder resp.body)


fetchTraces : String -> Task Error (List TraceRow)
fetchTraces parent =
    Http.get (parent ++ "/_sky/console/api/traces?limit=100")
        |> Task.andThenResult (\resp -> Decode.decodeString tracesDecoder resp.body)


fetchErrors : String -> Task Error (List ErrorRow)
fetchErrors parent =
    Http.get (parent ++ "/_sky/console/api/errors")
        |> Task.andThenResult (\resp -> Decode.decodeString errorsDecoder resp.body)


subscriptions : Model -> Sub Msg
subscriptions model =
    if hasStoreSource model then
        -- v0.16.4 B6: per-tab refresh cadence (HUB-UI.md
        -- §"Implementation milestones"). Logs tail at 1.5 s for
        -- responsiveness; Metrics + Traces at 3 s (typical exporter
        -- push cadence); Errors at 5 s (low-frequency signal, no
        -- need to hammer SQLite). Each tick fires overview + the
        -- active tab's endpoint (see `fetchForTab`) — typically
        -- 2 fetches per tick.
        --
        -- Cadence picked to keep the dispatcher unblocked: the
        -- previous 3 s blanket cadence over-fetched on Errors
        -- (rare changes) and under-served Logs (users want the
        -- tail to feel live). Embedded mode keeps the 3 s blanket
        -- — its single-service surface doesn't need the tuning.
        Sub.every (tickIntervalMs model.tab) Tick

    else
        Sub.none


-- Per-tab refresh interval in milliseconds. Embedded mode (no
-- selected tab routing) keeps the historical 3 s. Hub mode
-- shortens Logs to 1.5 s for live-tail responsiveness and
-- lengthens Errors to 5 s (low-frequency rollup).
tickIntervalMs : Tab -> Int
tickIntervalMs tab =
    case tab of

        LogsTab ->
            1500

        ErrorsTab ->
            5000

        _ ->
            3000


viewWrapped : Model -> any
viewWrapped model =
    Ui.layout [] (view model)


main =
    app
        { init          = init
        , update        = update
        , view          = viewWrapped
        , subscriptions = subscriptions
        , routes        = [ route "/" () ]
        , notFound      = ()
        }
