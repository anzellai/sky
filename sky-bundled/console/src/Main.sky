module Main exposing (main)

-- Sky Console — Sky.Live entry. Auto-mounted at /_sky/console on
-- every Sky.Live + Sky.Http.Server app in dev mode (see
-- runtime-go/rt/subapp.go::maybeAutoMountConsole); also runs
-- standalone via `sky console [--port N]`.
--
-- When running as a sub-app, the parent passes SKY_PARENT_URL +
-- SKY_LIVE_BASE_PATH + SKY_INGEST_TOKEN. The console reads
-- SKY_PARENT_URL at init time and uses it to fetch real telemetry
-- (overview + logs) from the parent's /_sky/console/api/* JSON
-- endpoints every 2s. Standalone runs leave parentUrl empty and
-- the view shows a short "no parent" placeholder.
--
-- No hand-written JS in this source — every interaction is
-- onClick → Msg → update → re-render via Sky.Live's framework
-- wire. Multi-module split so the type-checker stays well below
-- the heap-exhaustion limit (CLAUDE.md Limitation #17).

import Sky.Core.Prelude exposing (..)
import Sky.Core.System as System
import Sky.Core.Http as Http
import Sky.Core.Json.Decode as Decode
import Sky.Core.Json.Decode.Pipeline as Pipeline
import Sky.Core.Task as Task
import Sky.Core.Maybe as Maybe
import Sky.Core.Dict as Dict
import Sky.Core.Encoding as Encoding
import Sky.Core.Error as Error
import Sky.Core.Secret as Secret
import Std.Cmd as Cmd
import Std.Sub as Sub
import Std.App as App
import Std.Html exposing (Html)
import Std.Ui as Ui
import State exposing (..)
import View exposing (view)
import HubStore exposing (hubStore, hubCurrentIdentity)


-- ─── Decoders for the parent's /_sky/console/api/* JSON ──────────
overviewDecoder : Decode.Decoder Overview
overviewDecoder =
    Decode.succeed Overview |> Pipeline.optional "skyVersion" Decode.string "—"
        |> Pipeline.optional "commit" Decode.string "—"
        |> Pipeline.optional "builtAt" Decode.string "—"
        |> Pipeline.optional "uptimeSeconds" intFromFloat 0
        |> Pipeline.optional "requestsTotal" intFromFloat 0
        |> Pipeline.optional "errorRate5xx" Decode.float 0.0
        |> Pipeline.optional "bufferLogUsed" intFromFloat 0
        |> Pipeline.optional "bufferTraceUsed" intFromFloat 0
        |> Pipeline.optional "productionMode" Decode.bool False


-- Cast Float → Int at the decode boundary so the Model holds
-- whole numbers (Go's JSON encoder emits every numeric as a
-- JSON Number, which Sky's Decode.float reads — but for display
-- purposes we want Int). Math.round handles the float-to-int
-- conversion explicitly.
intFromFloat : Decode.Decoder Int
intFromFloat =
    Decode.map (\f -> Math.round f) Decode.float


logsDecoder : Decode.Decoder (List LogEntry)
logsDecoder =
    Decode.list logEntryDecoder


-- Wire shape: telemetry.LogEntry serialised by Go's JSON encoder.
-- Field names use PascalCase (Go convention). Numeric fields arrive
-- as JSON Number (decoded as Float). SessionID lives in
-- Fields["session_id"] when the entry came from a Sky.Live dispatch.
logEntryDecoder : Decode.Decoder LogEntry
logEntryDecoder =
    Decode.succeed LogEntry |> Pipeline.optional "TS" Decode.string "—"
        |> Pipeline.optional "Level" Decode.string "info"
        |> Pipeline.optional "Message" Decode.string ""
        |> Pipeline.optional "Subapp" Decode.string ""
        |> Pipeline.optional "ReqID" Decode.string ""
        |> Pipeline.custom (fieldFromFields "session_id")
        |> Pipeline.custom (fieldFromFields "user_label")
        |> Pipeline.optional "Route" Decode.string ""
        |> Pipeline.optional "Status" Decode.float 0.0
        |> Pipeline.optional "LatencyMS" Decode.float 0.0


-- Pluck a single field from the entry's `Fields` object (the
-- free-form attrs bag the runtime fills with msg name, session id,
-- user label, etc.). Falls back to "" when the entry doesn't carry
-- the field — common for HTTP-only access logs and non-Live
-- emissions.
fieldFromFields : String -> Decode.Decoder String
fieldFromFields name =
    Decode.oneOf
        [ Decode.at [ "Fields", name ] Decode.string, Decode.succeed "" ]


-- ─── Metrics / Traces / Errors decoders ─────────────────────────
metricsDecoder : Decode.Decoder (List MetricRow)
metricsDecoder =
    Decode.list metricRowDecoder


metricRowDecoder : Decode.Decoder MetricRow
metricRowDecoder =
    Decode.succeed MetricRow |> Pipeline.optional "name" Decode.string ""
        |> Pipeline.optional "type" Decode.string ""
        |> Pipeline.optional "labels" Decode.string ""
        |> Pipeline.optional "value" Decode.float 0.0
        |> Pipeline.optional "sum" Decode.float 0.0
        |> Pipeline.optional "count" Decode.float 0.0
        -- `labels` arrives pre-flattened to a "k=v, k=v" string by
        -- HandleConsoleMetricsSummary — decode it directly. (It used
        -- to be a JSON object the pipeline punted on with
        -- `succeed ""`, which is why distinct label-series rendered
        -- as indistinguishable rows.)


tracesDecoder : Decode.Decoder (List TraceRow)
tracesDecoder =
    Decode.list traceRowDecoder


traceRowDecoder : Decode.Decoder TraceRow
traceRowDecoder =
    Decode.succeed TraceRow |> Pipeline.optional "traceId" Decode.string ""
        |> Pipeline.optional "spanId" Decode.string ""
        |> Pipeline.optional "parentId" Decode.string ""
        |> Pipeline.optional "name" Decode.string ""
        |> Pipeline.optional "kind" Decode.string ""
        |> Pipeline.optional "startTime" Decode.string "—"
        |> Pipeline.optional "durationMs" Decode.float 0.0
        |> Pipeline.optional "status" Decode.string ""


errorsDecoder : Decode.Decoder (List ErrorRow)
errorsDecoder =
    Decode.list errorRowDecoder


errorRowDecoder : Decode.Decoder ErrorRow
errorRowDecoder =
    Decode.succeed ErrorRow |> Pipeline.optional "count" Decode.int 0
        |> Pipeline.optional "message" Decode.string ""


analyticsDecoder : Decode.Decoder Analytics
analyticsDecoder =
    Decode.succeed Analytics |> Pipeline.optional "total" Decode.int 0
        |> Pipeline.optional "uniqueUsers" Decode.int 0
        |> Pipeline.optional "counts" (Decode.list eventCountDecoder) []
        |> Pipeline.optional "recent" (Decode.list analyticsEventDecoder) []
        |> Pipeline.optional "revenue" (Decode.list currencyTotalDecoder) []
        |> Pipeline.optional "windowDays" Decode.int 0
        |> Pipeline.optional "windowLabel" Decode.string ""
        |> Pipeline.optional "rowCapHit" Decode.bool False
        |> Pipeline.optional "rowCap" Decode.int 0


currencyTotalDecoder : Decode.Decoder CurrencyTotal
currencyTotalDecoder =
    Decode.succeed CurrencyTotal
        |> Pipeline.optional "currency" Decode.string ""
        |> Pipeline.optional "amount" Decode.string "0"
        |> Pipeline.optional "count" Decode.int 0


eventCountDecoder : Decode.Decoder EventCount
eventCountDecoder =
    Decode.succeed EventCount |> Pipeline.optional "event" Decode.string ""
        |> Pipeline.optional "count" Decode.int 0


analyticsEventDecoder : Decode.Decoder AnalyticsEvent
analyticsEventDecoder =
    Decode.succeed AnalyticsEvent |> Pipeline.optional "ts" Decode.int 0
        |> Pipeline.optional "event" Decode.string ""
        |> Pipeline.optional "userId" Decode.string ""
        |> Pipeline.optional "path" Decode.string ""


-- ─── Store factory (v0.16.4 B3) ─────────────────────────────────
-- Build the HTTP-backed Store the embedded console uses.  Each
-- field closes over the parent URL + the locally-defined decoder
-- and delegates to the same apiGet + Decode.decodeString pipeline
-- as before.  v0.16.4 hub mounts will plug in `hubStore` instead
-- (B4) — same shape, SQLite-backed.
httpStore : String -> Store
httpStore parent =
    { readOverview = \_ -> fetchOverview parent
    , readLogs = \scope filter -> fetchLogs parent scope filter
    , readMetrics = \_ -> fetchMetrics parent
    , readTraces = \scope q -> fetchTraces parent scope q
    , readErrors = \scope -> fetchErrors parent scope
    -- v0.16.4 B5: the embedded console fetches its telemetry from
    -- the parent app's /_sky/console/api/* endpoints which only
    -- model a single service (the host).  Return an empty list so
    -- the multi-service Overview never fires when running in
    -- embedded mode — the View router falls through to the
    -- single-service `overviewView` automatically (it gates on
    -- `hubDbPath /= ""`).
    , readServiceStats = \_ -> Task.succeed []
    , readAnalytics = \scope -> fetchAnalytics parent scope
    }


-- ─── Init / update / subscriptions / view ────────────────────────
-- `init` ignores its argument; `initWith` is the real init. The
-- embedded mount (runtime-go/rt/console_app/register_v3.go) calls
-- `initWith` with the raw query string of the page request, so a
-- console URL (`?tab=logs&range=7d&q=checkout`) opens on the state it
-- names: a shared link or a bookmark. The view writes the same
-- parameters back on every render (View.urlSync). Before v0.27.8 the
-- URL was written and never read: a link opened on the defaults.
init : a -> ( Model, Cmd Msg )
init _ =
    initWith ""


initWith : String -> ( Model, Cmd Msg )
initWith rawQuery =
    let
        parent = System.getenvOr "SKY_PARENT_URL" ""
        hubDbPath = System.getenvOr "SKY_CONSOLE_HUB_DB" ""
        -- Set by the runtime's embedded mount path (console.go) ONLY
        -- when the console has a sign-in to end (SKY_CONSOLE_AUTH=token):
        -- then a __Host-sky_console cookie + a /_sky/console/_logout
        -- route exist. Empty otherwise (dev-open, app auth, hub), and the
        -- header renders no "Sign out" link.
        logoutUrl = System.getenvOr "SKY_CONSOLE_LOGOUT_URL" ""
        params = Http.parseQuery rawQuery
        param name = Maybe.withDefault "" (Dict.get name params)
        -- v0.16.4 Option B B4: when SKY_CONSOLE_HUB_DB is set the
        -- console is running IN-PROCESS with the hub daemon and
        -- reads telemetry via direct SQLite kernels (HubStore.sky)
        -- against the hub's console-hot.db.  Otherwise stick with
        -- the embedded-mode HTTP-backed Store (httpStore).
        chosenStore =
            if hubDbPath /= "" then
                hubStore hubDbPath

            else
                httpStore parent
        -- When the hub mode is active we always render against
        -- real data — the parent-url-empty placeholder text is
        -- specific to standalone `sky console` invocations that
        -- have NEITHER a parent NOR a hub DB.
        isStandalone = parent == "" && hubDbPath == ""
        startModel =
            { tab = parseTab (param "tab")
            , parentUrl = parent
            , hubDbPath = hubDbPath
            , store = chosenStore
            , overview =
                if isStandalone then
                    mockOverview

                else
                    emptyOverview
            , logs =
                if isStandalone then
                    mockLogs

                else
                    []
            , metrics = []
            , traces = []
            , errors = []
            , lastError = ""
            , errorFrom = ""
            , logFilter = emptyLogFilter
            , traceQuery = ""
            , selectedService = param "service"
            , serviceStats = []
            -- v0.16.6 #493 part 2c: identity is fetched async from
            -- the hub via Hub_currentIdentity; until the response
            -- arrives it stays Nothing and tenantPrefix stays "" so
            -- the per-tab queries see all data the operator's gate
            -- let in.
            , identity = Nothing
            , tenantPrefix = ""
            -- Last24h is the typical "what's been happening today"
            -- default; an unknown or missing `range=` falls back to it.
            , range = parseRange (param "range")
            , gen = 0
            , globalQuery = param "q"
            , analytics = emptyAnalytics
            , logoutUrl = logoutUrl
            }
        -- Fetch the signed-in identity on boot. Only meaningful
        -- when running in hub mode (hubDbPath != "") with the
        -- auth-gate active; standalone runs and embedded-without-
        -- hub runs both get an Err which the GotIdentity arm
        -- silently absorbs (identity stays Nothing).
        identityCmd =
            if hubDbPath /= "" then
                Cmd.perform (hubCurrentIdentity hubDbPath) GotIdentity

            else
                Cmd.none
        -- Fire one immediate fetch so the initial render isn't empty;
        -- the Sub.every tick then keeps it fresh.
    in
        ( startModel
        , Cmd.batch [ fetchForTab startModel startModel.tab, identityCmd ]
        )


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of

        SelectTab tab ->
            -- Fire a fetch for the newly-active tab IMMEDIATELY
            -- (otherwise the user sees stale / empty data until the
            -- next Sub.every tick). Tab-scoped to keep wire +
            -- re-render cost bounded.
            refetch { model | tab = tab }

        Tick ->
            ( model, fetchForTab model model.tab )

        GotOverview (Ok ov) ->
            ( cleared "overview" { model | overview = ov }, Cmd.none )

        GotOverview (Err e) ->
            ( failed "overview" e model, Cmd.none )

        -- A tab answer is used only when it was asked under the current
        -- `gen` (see State.Model): an answer to a previous range, search
        -- or filter that arrives late is dropped.
        GotLogs g (Ok ls) ->
            if g == model.gen then
                ( cleared "logs" { model | logs = ls }, Cmd.none )

            else
                ( model, Cmd.none )

        GotLogs _ (Err e) ->
            ( failed "logs" e model, Cmd.none )

        GotMetrics g (Ok ms) ->
            if g == model.gen then
                ( cleared "metrics" { model | metrics = ms }, Cmd.none )

            else
                ( model, Cmd.none )

        GotMetrics _ (Err e) ->
            ( failed "metrics" e model, Cmd.none )

        GotTraces g (Ok ts) ->
            if g == model.gen then
                ( cleared "traces" { model | traces = ts }, Cmd.none )

            else
                ( model, Cmd.none )

        GotTraces _ (Err e) ->
            ( failed "traces" e model, Cmd.none )

        GotErrors g (Ok es) ->
            if g == model.gen then
                ( cleared "errors" { model | errors = es }, Cmd.none )

            else
                ( model, Cmd.none )

        GotErrors _ (Err e) ->
            ( failed "errors" e model, Cmd.none )

        GotAnalytics g (Ok a) ->
            if g == model.gen then
                ( cleared "analytics" { model | analytics = a }, Cmd.none )

            else
                ( model, Cmd.none )

        GotAnalytics _ (Err e) ->
            ( failed "analytics" e model, Cmd.none )

        LogFilterQuery q ->
            let
                f = model.logFilter
            in
                refetch { model | logFilter = { f | query = q } }

        LogFilterToggleLevel lvl ->
            let
                f = model.logFilter
                f2 =
                    case lvl of

                        "debug" ->
                            { f | showDebug = not f.showDebug }

                        "info" ->
                            { f | showInfo = not f.showInfo }

                        "warn" ->
                            { f | showWarn = not f.showWarn }

                        "error" ->
                            { f | showError = not f.showError }

                        _ ->
                            f
            in
                refetch { model | logFilter = f2 }

        LogFilterPickSession sid ->
            let
                f = model.logFilter
            in
                refetch
                    { model | logFilter = { f | session = sid }, tab = LogsTab }

        LogFilterClear ->
            refetch { model | logFilter = emptyLogFilter }

        -- The Traces tab's search is sent to the server, which keeps
        -- every span of each trace in which a span matches, over its
        -- whole store.
        TraceFilterQuery q ->
            refetch { model | traceQuery = q }

        -- Log → trace pivot: clicking a log row's trace-id badge
        -- jumps to the Traces tab searched for that id. The server
        -- finds the trace however many spans came after it.
        PivotToTrace tid ->
            refetch { model | tab = TracesTab, traceQuery = tid }

        -- v0.16.4 B5: Multi-service Overview selector. Empty
        -- name = "All services" (aggregate). The selection is part of
        -- the console URL (`service=`), and every tab read is scoped
        -- to it.
        SelectService name ->
            refetch { model | selectedService = name }

        GotServiceStats (Ok stats) ->
            ( cleared "services" { model | serviceStats = stats }, Cmd.none )

        GotServiceStats (Err e) ->
            ( failed "services" e model, Cmd.none )

        -- v0.16.6 #493 part 2c.  Identity arrived from
        -- Hub_currentIdentity.  Success: derive the tenant filter
        -- from the `tenant` claim (operator convention).  Failure:
        -- silently leave identity + tenantPrefix at their defaults —
        -- the per-tab queries already use "" as the no-filter
        -- sentinel.  We do NOT surface the Err on `model.lastError`
        -- because the standalone-no-hub path always fails this call
        -- and would otherwise paint a permanent error banner.
        GotIdentity (Ok identity) ->
            let
                tenant =
                    Maybe.withDefault "" (Dict.get "tenant" identity.claims)
            in
                ( { model | identity = Just identity, tenantPrefix = tenant }
                , Cmd.none
                )

        GotIdentity (Err _) ->
            ( model, Cmd.none )

        -- The global range and search: the active tab is read again at
        -- once, under the new scope.
        SelectRange r ->
            refetch { model | range = r }

        GlobalQuery q ->
            refetch { model | globalQuery = q }


-- The error bar shows the last failed read. A read's answer clears it only
-- when that read put it there: the overview read, which succeeds on every
-- tick, used to clear a failing tab read's error a moment after it showed.
failed : String -> Error -> Model -> Model
failed src e model =
    { model | lastError = errorToString e, errorFrom = src }


cleared : String -> Model -> Model
cleared src model =
    if model.errorFrom == src then
        { model | lastError = "", errorFrom = "" }

    else
        model


-- What the tabs read changed: start a new `gen` (older answers are
-- dropped) and read the active tab now, not at the next tick.
refetch : Model -> ( Model, Cmd Msg )
refetch model =
    let
        next = { model | gen = model.gen + 1 }
    in
        ( next, fetchForTab next next.tab )


-- The Scope every tab read carries (State.Scope).
scopeOf : Model -> Scope
scopeOf model =
    { service = model.selectedService
    , range = rangeKey model.range
    , search = model.globalQuery
    }


-- True when a real data source is wired (embedded mode via SKY_PARENT_URL
-- OR hub mode via SKY_CONSOLE_HUB_DB). Standalone mode (neither set) keeps
-- the mock-data placeholders and skips fetches.
hasStoreSource : Model -> Bool
hasStoreSource model =
    model.parentUrl /= "" || model.hubDbPath /= ""


-- Fetch ONLY what the currently-active tab needs (+ overview,
-- which the header always renders). Pre-2026-05-18 this was
-- `fetchAll` firing all five endpoints every Tick — at 2 s
-- interval with a Metrics tab holding 30+ series, the
-- re-render queue piled up faster than it drained.
fetchForTab : Model -> Tab -> Cmd Msg
fetchForTab model tab =
    if hasStoreSource model then
        Cmd.batch
            (Cmd.perform (model.store.readOverview ()) GotOverview
                :: tabFetches model tab)

    else
        Cmd.none


-- One read for the tab, scoped and tagged with the current gen. The
-- Store decides how: the embedded console asks the host app's
-- /_sky/console/api/*, the hub reads its SQLite store.
tabFetches : Model -> Tab -> List (Cmd Msg)
tabFetches model tab =
    let
        scope = scopeOf model
        g = model.gen
    in
        case tab of

            OverviewTab ->
                -- Hub mode renders the multi-service dashboard from the
                -- per-service rollups; the embedded store answers [].
                [ Cmd.perform (model.store.readServiceStats ()) GotServiceStats
                ]

            LogsTab ->
                [ Cmd.perform
                      (model.store.readLogs scope model.logFilter)
                      (GotLogs g)
                ]

            MetricsTab ->
                [ Cmd.perform (model.store.readMetrics scope) (GotMetrics g) ]

            TracesTab ->
                [ Cmd.perform
                      (model.store.readTraces scope model.traceQuery)
                      (GotTraces g)
                ]

            ErrorsTab ->
                [ Cmd.perform (model.store.readErrors scope) (GotErrors g) ]

            AnalyticsTab ->
                [ Cmd.perform (model.store.readAnalytics scope) (GotAnalytics g)
                ]


-- Every embedded-console read is a loopback GET to the host app's
-- /_sky/console/api/* endpoints. Those endpoints admit the in-process
-- console ONLY by the per-boot internal token the host mints and publishes
-- as SKY_CONSOLE_INTERNAL_TOKEN (runtime-go/rt/console_internal_token.go),
-- sent as a Bearer. It is read at each call, so a token minted after this
-- session started is still used.
--
-- The reads used to be a bare Http.get. With console auth on
-- (SKY_CONSOLE_AUTH=token or app, and always under ENV=production) every
-- read answered 401 with the login page, the JSON decode of that page
-- failed, the error landed in lastError (which nothing rendered), and the
-- console showed its empty start model for ever. A non-200 answer is now a
-- named error, and View renders lastError.
apiGet : String -> String -> Decode.Decoder a -> Task Error a
apiGet parent path decoder =
    Http.defaultRequest (parent ++ path)
        |> Http.withBearer (Secret.fromEnv "SKY_CONSOLE_INTERNAL_TOKEN")
        |> Http.withFollowRedirects False
        |> Http.withTimeout 5000
        |> Http.request
        |> Task.andThenResult (\resp -> decodeApiResponse path decoder resp)


decodeApiResponse : String -> Decode.Decoder a -> Http.HttpResponse -> Result Error a
decodeApiResponse path decoder resp =
    if resp.status == 200 then
        Decode.decodeString decoder resp.body

    else
        Err
            (Error.unavailable
                ("console API " ++ path ++ " answered HTTP "
                    ++ String.fromInt resp.status))


fetchOverview : String -> Task Error Overview
fetchOverview parent =
    apiGet parent "/_sky/console/api/overview" overviewDecoder


-- The scope's query parameters: the range key and the global search.
-- The server filters by them over its whole store, before its limit.
scopeQuery : Scope -> String
scopeQuery scope =
    "range=" ++ Encoding.urlEncode scope.range ++ searchParam scope.search


-- `&q=<text>`, or "" for no text. The server ANDs repeated `q` terms.
searchParam : String -> String
searchParam text =
    if String.trim text == "" then
        ""

    else
        "&q=" ++ Encoding.urlEncode (String.trim text)


fetchLogs : String -> Scope -> LogFilter -> Task Error (List LogEntry)
fetchLogs parent scope filter =
    apiGet
        parent
        ("/_sky/console/api/logs?limit=200&" ++ scopeQuery scope
            ++ buildLogQuery filter)
        logsDecoder


-- The Logs tab's own filter as query parameters: the level set (all
-- four = no level parameter), its search box and the session pivot.
-- Every one is applied by the server, before its limit.
buildLogQuery : LogFilter -> String
buildLogQuery f =
    let
        levels =
            (if f.showDebug then
                [ "debug" ]

            else
                [])
                ++ (if f.showInfo then
                       [ "info" ]

                   else
                       [])
                ++ (if f.showWarn then
                       [ "warn" ]

                   else
                       [])
                ++ (if f.showError then
                       [ "error" ]

                   else
                       [])
        levelPart =
            if List.length levels == 4 then
                ""

            else if List.isEmpty levels then
                "&level=none"

            else
                -- Every level toggled off: ask for a level no entry has,
                -- so the answer is empty, as the toggles say.
                "&level=" ++ String.join "," levels
        sessionPart =
            if f.session == "" then
                ""

            else
                "&session=" ++ Encoding.urlEncode f.session
    in
        levelPart ++ searchParam f.query ++ sessionPart


fetchMetrics : String -> Task Error (List MetricRow)
fetchMetrics parent =
    apiGet parent "/_sky/console/api/metrics-summary" metricsDecoder


fetchTraces : String -> Scope -> String -> Task Error (List TraceRow)
fetchTraces parent scope traceQuery =
    apiGet
        parent
        ("/_sky/console/api/traces?limit=100&" ++ scopeQuery scope
            ++ searchParam traceQuery)
        tracesDecoder


fetchErrors : String -> Scope -> Task Error (List ErrorRow)
fetchErrors parent scope =
    apiGet
        parent
        ("/_sky/console/api/errors?" ++ scopeQuery scope)
        errorsDecoder


fetchAnalytics : String -> Scope -> Task Error Analytics
fetchAnalytics parent scope =
    apiGet
        parent
        ("/_sky/console/api/analytics?range=" ++ Encoding.urlEncode scope.range)
        analyticsDecoder


subscriptions : Model -> Sub Msg
subscriptions model =
    if hasStoreSource model then
        Sub.every (tickIntervalMs model.tab) Tick

    else
        -- v0.16.4 B6: per-tab refresh cadence (HUB-UI.md
        -- §"Implementation milestones"). Logs tail at 1.5 s for
        -- responsiveness; Metrics + Traces at 3 s (typical exporter
        -- push cadence); Errors at 5 s (low-frequency signal, no
        -- need to hammer SQLite). Each tick fires overview + the
        -- active tab's endpoint (see `fetchForTab`) — typically
        -- 2 fetches per tick.
        --
        -- Cadence picked to keep the dispatcher unblocked: the
        -- previous 3 s blanket cadence over-fetched on Errors
        -- (rare changes) and under-served Logs (users want the
        -- tail to feel live). Embedded mode keeps the 3 s blanket
        -- — its single-service surface doesn't need the tuning.
        Sub.none


-- Per-tab refresh interval in milliseconds. Embedded mode (no
-- selected tab routing) keeps the historical 3 s. Hub mode
-- shortens Logs to 1.5 s for live-tail responsiveness and
-- lengthens Errors to 5 s (low-frequency rollup).
tickIntervalMs : Tab -> Int
tickIntervalMs tab =
    case tab of

        LogsTab ->
            1500

        ErrorsTab ->
            5000

        _ ->
            3000


-- The Live view: the shared `View.view` Element wrapped into a page-tall
-- Html document. It is a NAMED binding, and `appDef` routes the view
-- through it, on purpose. The embedded console is mounted by hand-written
-- glue (runtime-go/rt/console_app/register_v3.go). That glue hands `init`,
-- `update`, `viewWrapped` and `subscriptions` to the Sky.Live mount of the
-- host app. The compiler drops every binding that `main` does not reach,
-- and it cannot see a reference from Go glue. So each binding that the
-- glue names must be reachable from `main`. With `App.app` and the bare
-- `view`, `viewWrapped` is not emitted and the regenerated console_app
-- package does not build. scripts/regenerate-console.sh builds the package
-- after it writes it, so a break here fails the generator itself.
viewWrapped : Model -> Html Msg
viewWrapped model =
    Ui.layout [] (view model)


appDef =
    App.web
        { init = init
        , update = update
        , view = viewWrapped
        , subscriptions = subscriptions
        }
        |> App.withRoutes [ App.route "/" () ]
        |> App.withNotFound ()
        |> App.withConfig (App.WebConfig { App.webDefaults | port = 8025 })


main =
    App.runLive appDef
