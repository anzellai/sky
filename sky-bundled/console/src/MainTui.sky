module Main exposing (main)

-- Sky Console — Sky.Tui entry point (Phase D).
--
-- Reuses the same State.sky + View.sky as the Sky.Live entry point
-- in Main.sky. The only differences:
--   * Tui.app instead of Live.app (no routes / notFound)
--   * init takes () instead of a request record
--   * onKey for terminal hotkeys (tab numbers + q for quit)
--
-- The shared View.sky calls only Std.Ui primitives, so it renders
-- identically here — the Sky.Tui runtime walks the same Element
-- tree, computes character-cell layout, paints to the terminal.

import Sky.Core.Prelude exposing (..)
import Std.App as App
import Std.Cmd as Cmd
import Std.Sub as Sub
import State exposing (..)
import View exposing (view)


-- Offline mock Store for the terminal backend — the Sky.Tui console
-- has no HTTP wire, so every reader resolves synchronously to the
-- same mock telemetry the Live variant falls back to when standalone.
-- Keeps the shared Store contract satisfied (every field present) so
-- View.sky renders identically.
tuiStore : Store
tuiStore =
    { readOverview = \_ -> Task.succeed mockOverview
    , readLogs = \_ -> Task.succeed mockLogs
    , readMetrics = \_ -> Task.succeed mockMetrics
    , readTraces = \_ -> Task.succeed mockTraces
    , readErrors = \_ -> Task.succeed mockErrors
    , listServices = \_ -> Task.succeed []
    , readServiceStats = \_ -> Task.succeed []
    , readFilteredLogs = \_ _ -> Task.succeed mockLogs
    , readFilteredMetrics = \_ -> Task.succeed mockMetrics
    , readFilteredTraces = \_ -> Task.succeed mockTraces
    , readFilteredErrors = \_ -> Task.succeed mockErrors
    , readAnalytics = \_ -> Task.succeed emptyAnalytics
    }


init : () -> ( Model, Cmd Msg )
init _ =
    ( { tab = OverviewTab
      , parentUrl = ""
      , hubDbPath = ""
      , store = tuiStore
      , overview = mockOverview
      , logs = mockLogs
      , metrics = mockMetrics
      , traces = mockTraces
      , errors = mockErrors
      , lastError = ""
      , logFilter = emptyLogFilter
      , traceQuery = ""
      , selectedService = ""
      , serviceStats = []
      , identity = Nothing
      , tenantPrefix = ""
      , range = Last24h
      , nowMs = 0
      , globalQuery = ""
      , analytics = emptyAnalytics

      -- The TUI console is always standalone: a terminal UI has no
      -- __Host-sky_console login cookie to clear, so there is no logout
      -- route to point at. "" is the documented "render no Sign out"
      -- value (View.sky renders Ui.none for it), the same value the
      -- standalone hub uses.
      , logoutUrl = ""
      }
    , Cmd.none
    )


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of

        SelectTab tab ->
            ( { model | tab = tab }, Cmd.none )

        Tick ->
            ( model, Cmd.none )

        -- Tui variant doesn't fetch (no HTTP wire in terminal mode);
        -- ignore the response Msgs that the Live variant uses.
        GotOverview _ ->
            ( model, Cmd.none )

        -- Tui variant has no HTTP wire + no filter UI — every other
        -- Msg (GotMetrics/Traces/Errors, LogFilter*, TraceFilterQuery)
        -- is a no-op here.
        GotLogs _ ->
            ( model, Cmd.none )

        _ ->
            ( model, Cmd.none )


subscriptions : Model -> Sub Msg
subscriptions _ =
    Sub.none


-- No `onKey` field: the Sky.Tui runtime hard-exits on Ctrl-C when
-- onKey is absent, which is exactly what we want for a dashboard.
-- Tab / Shift-Tab cycles focus through the tab buttons, Enter or
-- space activates the focused one (handled by the runtime focus ring
-- before reaching user code).
appDef =
    App.app
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        }


main =
    App.runTui appDef
