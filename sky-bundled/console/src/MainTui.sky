module Main exposing (main)

-- Sky Console — Sky.Tui entry point (Phase D).
--
-- Reuses the same State.sky + View.sky as the Sky.Live entry point
-- in Main.sky. The only differences:
--   * Tui.app instead of Live.app (no routes / notFound)
--   * init takes () instead of a request record
--   * onKey for terminal hotkeys (tab numbers + q for quit)
--
-- The shared View.sky calls only Std.Ui primitives, so it renders
-- identically here — the Sky.Tui runtime walks the same Element
-- tree, computes character-cell layout, paints to the terminal.
import Sky.Core.Prelude exposing (..)
import Sky.Core.Task as Task
import Std.Tui as Tui
import Std.Cmd as Cmd
import Std.Sub as Sub
import State exposing (..)
import View exposing (view)


init : () -> ( Model, Cmd Msg )
init _ =
    ( { tab = OverviewTab
      , parentUrl = ""
      , overview = mockOverview
      , logs = mockLogs
      , metrics = mockMetrics
      , traces = mockTraces
      , errors = mockErrors
      , lastError = ""
      , logFilter = emptyLogFilter
      , traceQuery = ""
      }
    , Cmd.none
    )


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of

        SelectTab tab ->
            ( { model | tab = tab }, Cmd.none )

        Tick ->
            ( model, Cmd.none )
        -- Tui variant doesn't fetch (no HTTP wire in terminal mode);
        -- ignore the response Msgs that the Live variant uses.

        GotOverview _ ->
            ( model, Cmd.none )
        -- Tui variant has no HTTP wire + no filter UI — every other
        -- Msg (GotMetrics/Traces/Errors, LogFilter*, TraceFilterQuery)
        -- is a no-op here.

        GotLogs _ ->
            ( model, Cmd.none )

        _ ->
            ( model, Cmd.none )


subscriptions : Model -> Sub Msg
subscriptions _ =
    Sub.none


-- No `onKey` field: the Sky.Tui runtime hard-exits on Ctrl-C when
-- onKey is absent, which is exactly what we want for a dashboard.
-- Tab / Shift-Tab cycles focus through the tab buttons, Enter or
-- space activates the focused one (handled by the runtime focus ring
-- before reaching user code).
main =
    Tui.app
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        }
        |> Task.run
