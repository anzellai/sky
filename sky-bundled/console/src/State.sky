module State exposing (..)

-- Pure types + same-shape helpers. No Std.Ui imports here so the
-- type-checker stays well below the heap-exhaustion limit
-- (CLAUDE.md Limitation #17).

import Sky.Core.Prelude exposing (..)
import Sky.Core.Dict exposing (Dict)

-- ─── Tabs ────────────────────────────────────────────────────────
-- The console has 5 tabs. Active tab is part of Model so navigation
-- is just a Msg dispatch (no client-side router).
--
-- Variants suffixed `Tab_` to avoid collision with the `Overview`
-- record type alias below (Sky's auto-generated record constructor
-- shares the type-name as a value, so an unsuffixed `Overview`
-- variant would shadow it in expression position).
type Tab
    = OverviewTab
    | MetricsTab
    | LogsTab
    | TracesTab
    | ErrorsTab
    | AnalyticsTab


tabLabel : Tab -> String
tabLabel tab =
    case tab of

        OverviewTab ->
            "Overview"

        MetricsTab ->
            "Metrics"

        LogsTab ->
            "Logs"

        TracesTab ->
            "Traces"

        ErrorsTab ->
            "Errors"

        AnalyticsTab ->
            "Analytics"

-- ─── Data shapes (mirror /_sky/console/api/* JSON) ──────────────
-- Overview tab payload — wire shape mirrors `OverviewResponse`
-- in `runtime-go/rt/console.go`. Fetched periodically from
-- `GET <parent>/_sky/console/api/overview` when running as the
-- bundled sub-app (SKY_PARENT_URL set). Falls back to a small
-- mock for standalone `sky console` invocations.
type alias Overview =
    { skyVersion : String
    , commit : String
    , builtAt : String
    , uptimeSeconds : Int
    , requestsTotal : Int
    , errorRate5xx : Float
    , bufferLogUsed : Int
    , bufferTraceUsed : Int
    , productionMode : Bool
    }

-- Log entry shown in the Logs tab — wire shape mirrors
-- `telemetry.LogEntry` JSON serialisation. Extra context fields
-- (reqId, sessionId, route, status, latencyMs) let the Logs tab
-- correlate entries that share a request or a session — click a
-- badge → filter to "everything this session did".
type alias LogEntry =
    { time : String
    , level : String
    , message : String
    , subapp : String
    , reqId : String
    , sessionId : String
    , userLabel : String
    , route : String
    , status : Float
    , latencyMs : Float
    }

type alias MetricRow =
    { name : String
    , typ : String
    , labels : String
    , value : Float
    , sum : Float
    , count : Float
    }

type alias TraceRow =
    { traceId : String
    , spanId : String
    , parentId : String
    , name : String
    , kind : String
    , startTime : String
    , durationMs : Float
    , status : String
    }

type alias ErrorRow =
    { count : Int
    , message : String
    }

-- Std.Analytics tab payloads — wire shape mirrors the parent's
-- `GET /_sky/console/api/analytics` handler (HandleConsoleAnalytics
-- in runtime-go/rt/console_analytics.go). Because the embedded
-- console runs IN-PROCESS with the host app, that handler reads the
-- SAME analytics store the app writes — no separate DB, no env
-- plumbing. `total` / `uniqueUsers` are scalar aggregates; `counts`
-- is per-event-name frequency (most frequent first); `recent` is the
-- newest events for the live stream.
type alias EventCount =
    { event : String
    , count : Int
    }

type alias AnalyticsEvent =
    { ts : Int
    , event : String
    , userId : String
    , path : String
    }

-- One currency's summed revenue. Money props are stored losslessly as
-- "ISO_CODE AMOUNT", so revenue is summed WITHIN a currency, never
-- across — `amount` is the exact decimal total as a String (formatted
-- server-side via shopspring/decimal so cents never drift).
type alias CurrencyTotal =
    { currency : String
    , amount : String
    , count : Int
    }

-- `windowDays` / `rowCapHit` / `rowCap` are the HONESTY fields. Every
-- figure above is computed over the last `windowDays` days and over at
-- most `rowCap` events, because an unbounded scan of the analytics
-- table ran on a connection pool shared with the session store — the
-- observability surface degrading the thing it observes. The tab
-- renders the window in its labels rather than presenting a windowed
-- number under an all-time one; `rowCapHit` says the revenue total is
-- a floor (rendered "≥"), not a complete sum.
type alias Analytics =
    { total : Int
    , uniqueUsers : Int
    , counts : List EventCount
    , recent : List AnalyticsEvent
    , revenue : List CurrencyTotal
    , windowDays : Int
    , windowLabel : String
    , rowCapHit : Bool
    , rowCap : Int
    }


emptyAnalytics : Analytics
emptyAnalytics =
    { total = 0
    , uniqueUsers = 0
    , counts = []
    , recent = []
    , revenue = []
    , windowDays = 0
    , windowLabel = ""
    , rowCapHit = False
    , rowCap = 0
    }

-- Per-service rollup row consumed by the multi-service Overview
-- (v0.16.4 B5). One ServiceStat per distinct service_name in the
-- hub's `console-hot.db`. `status` is a 3-state pill mapped from
-- the recent error rate: "ok" (green, < 1%), "warn" (amber, 1-5%),
-- "err" (red, > 5%). `sparkRps` / `sparkP95` carry the last ~60s
-- of req-per-second + p95-latency samples so the card can render
-- a sparkline without round-tripping the full log table.
type alias ServiceStat =
    { name : String
    , status : String
    , reqsPerSec : Float
    , p95Ms : Float
    , errorRate : Float
    , sparkRps : List Float
    , sparkP95 : List Float
    }

-- ─── Time-range filter (v0.16.18 #558-PR1) ──────────────────────
--
-- Global time-range for the Logs, Traces, Errors and Analytics tabs.
-- The range travels to the server as its key (`range=1h`) and the
-- server filters its whole store BEFORE its row limit (v0.27.8). It
-- used to be applied here, in the view, to the newest 200 rows the
-- console had fetched, as a string compare between a UTC threshold
-- and times stamped in the server's zone: the wider ranges showed the
-- same rows and every range was off by the zone offset.
--
-- Default is `Last24h` — matches the typical "what's been happening
-- today" question.
type Range
    = Last15m
    | Last1h
    | Last24h
    | Last7d
    | RangeAll


rangeLabel : Range -> String
rangeLabel r =
    case r of

        Last15m ->
            "15m"

        Last1h ->
            "1h"

        Last24h ->
            "24h"

        Last7d ->
            "7d"

        RangeAll ->
            "All"


-- v0.16.18 #558-PR4 — URL token (lowercase) for Range. Symmetric
-- with parseRange: a token round-trips through both. Distinct from
-- rangeLabel because "All" displays Title-case but URLs prefer
-- lowercase.
rangeKey : Range -> String
rangeKey r =
    case r of

        Last15m ->
            "15m"

        Last1h ->
            "1h"

        Last24h ->
            "24h"

        Last7d ->
            "7d"

        RangeAll ->
            "all"


-- Parse a URL token back into the Range ADT. Unknown / missing
-- tokens fall back to the Last24h default so a malformed URL
-- doesn't break boot.
parseRange : String -> Range
parseRange s =
    case s of

        "15m" ->
            Last15m

        "1h" ->
            Last1h

        "24h" ->
            Last24h

        "7d" ->
            Last7d

        "all" ->
            RangeAll

        _ ->
            Last24h


-- The tabs whose data has a time axis: the range chips show on these
-- only. Overview and Metrics are process-lifetime snapshots, where a
-- range would change nothing.
rangeApplies : Tab -> Bool
rangeApplies tab =
    case tab of

        LogsTab ->
            True

        TracesTab ->
            True

        ErrorsTab ->
            True

        AnalyticsTab ->
            True

        _ ->
            False


-- The tabs the global search box filters.
searchApplies : Tab -> Bool
searchApplies tab =
    case tab of

        LogsTab ->
            True

        TracesTab ->
            True

        ErrorsTab ->
            True

        _ ->
            False


-- URL token for a Tab (the `tab=` query parameter). Symmetric with
-- parseTab.
tabKey : Tab -> String
tabKey tab =
    case tab of

        OverviewTab ->
            "overview"

        MetricsTab ->
            "metrics"

        LogsTab ->
            "logs"

        TracesTab ->
            "traces"

        ErrorsTab ->
            "errors"

        AnalyticsTab ->
            "analytics"


parseTab : String -> Tab
parseTab s =
    case s of

        "metrics" ->
            MetricsTab

        "logs" ->
            LogsTab

        "traces" ->
            TracesTab

        "errors" ->
            ErrorsTab

        "analytics" ->
            AnalyticsTab

        _ ->
            OverviewTab

-- ─── Read scope ─────────────────────────────────────────────────
-- What every tab read carries to its Store: the selected service
-- (hub mode; "" = every service, ignored by the embedded console),
-- the range key (`rangeKey`) and the global search text. The server
-- applies all of it before its row limit.
type alias Scope =
    { service : String
    , range : String
    , search : String
    }

-- ─── Logs filter ────────────────────────────────────────────────
-- Multi-axis filter: free-text search + level toggles + session id
-- pivot. UI-side state; serialises into the /_sky/console/api/logs
-- query string on every refresh.
type alias LogFilter =
    { query : String
    , session : String
    , showDebug : Bool
    , showInfo : Bool
    , showWarn : Bool
    , showError : Bool
    }


-- Debug entries are off by default — they're the noisy ones (every
-- noop dispatch). Users opt in via the filter pill on the Logs tab.
emptyLogFilter : LogFilter
emptyLogFilter =
    { query = ""
    , session = ""
    , showDebug = False
    , showInfo = True
    , showWarn = True
    , showError = True
    }

-- ─── Store interface (v0.16.4 B3) ───────────────────────────────
-- Read-only data plane for the console UI.  Each field is a
-- Task-returning function that fetches one slice of telemetry.
-- The bundled console doesn't care how the bytes are produced —
-- only that the typed shape comes back.
--
-- Two implementations ship in v0.16.4:
--   * `httpStore` (Main.sky) — closes over `parentUrl`, issues
--     `GET <parent>/_sky/console/api/*` for each read.  This is
--     the embedded-mode behaviour (every Sky.Live app's auto-
--     mounted /_sky/console/ subpath).
--   * `hubStore` (v0.16.4 B4) — backed by direct SQLite reads
--     over the hub's `console-hot.db` schema.  Same shape as
--     httpStore; one source ↔ three deployment shapes
--     (embedded / hub-single / hub-multi).
--
-- Every tab read takes the `Scope` (service, range, search); the
-- Logs read adds the Logs tab's filter and the Traces read the
-- Traces tab's own search. Embedded mode ignores the service (it
-- only knows the host app).
type alias Store =
    { readOverview : () -> Task Error Overview
    , readLogs : Scope -> LogFilter -> Task Error (List LogEntry)
    , readMetrics : Scope -> Task Error (List MetricRow)
    , readTraces : Scope -> String -> Task Error (List TraceRow)
    , readErrors : Scope -> Task Error (List ErrorRow)
    , readServiceStats : () -> Task Error (List ServiceStat)
    , readAnalytics : Scope -> Task Error Analytics
    }

-- ─── Model + Msg ─────────────────────────────────────────────────
--
-- `parentUrl` (SKY_PARENT_URL) is set when running as the embedded
-- console; `hubDbPath` (SKY_CONSOLE_HUB_DB) is set when running
-- in-process with the hub daemon. Either being non-empty enables
-- live fetches via the Store; both empty = standalone mode with
-- mock data.
type alias Model =
    { tab : Tab
    , parentUrl : String
    , hubDbPath : String
    , store : Store
    , overview : Overview
    , logs : List LogEntry
    , metrics : List MetricRow
    , traces : List TraceRow
    , errors : List ErrorRow
    , lastError : String
    , errorFrom : String
    , logFilter : LogFilter
    , traceQuery : String
    , selectedService : String
    , serviceStats : List ServiceStat
    , identity : Maybe Identity
    , tenantPrefix : String
    , range : Range
    , gen : Int
    , globalQuery : String
    , analytics : Analytics
    , logoutUrl : String
    }
    -- Non-empty ONLY in embedded mode, where the runtime mounts a
    -- __Host-sky_console cookie + a /_sky/console/_logout route and
    -- injects SKY_CONSOLE_LOGOUT_URL. Standalone hub / aggregator
    -- consoles have no login cookie, so the value stays "" and the
    -- header renders no "Sign out" link.
    -- `range` / `globalQuery`: the global range and search, sent to
    -- the server with every tab read (see Scope).
    -- `gen` counts the changes of what the tabs read (range, search,
    -- service, a tab filter). Each read is tagged with the gen it was
    -- sent under; an answer for an older gen is dropped, so a slow
    -- answer to the previous range or search cannot overwrite the
    -- current one.

-- Identity threaded from the hub auth-gate via Hub_currentIdentity
-- (v0.16.6 / #493 part 2c).  Match Std.Live.Console.Identity's
-- record shape exactly so the existing record-narrowing path
-- (rt.Coerce[State_Identity_R]) round-trips cleanly.
--
-- Identity is populated asynchronously: the bundled console issues
-- `Cmd.perform Hub.currentIdentity GotIdentity` in init; the response
-- flows through update.  Until the response arrives `identity` is
-- Nothing — every per-tab fetch uses the empty tenant prefix (i.e.
-- it sees all data the operator's gate let in).
type alias Identity =
    { subject : String
    , email : String
    , claims : Dict String String
    }

-- Msg covers tab switches + scheduled refresh + each per-endpoint
-- response. Result-typed responses use the canonical Sky.Core.Error
-- shape so a failure surfaces as model.lastError without crashing
-- the tick.
type Msg
    = SelectTab Tab
    | Tick
    | GotOverview (Result Error Overview)
    | GotLogs Int (Result Error (List LogEntry))
    | GotMetrics Int (Result Error (List MetricRow))
    | GotTraces Int (Result Error (List TraceRow))
    | GotErrors Int (Result Error (List ErrorRow))
    | GotAnalytics Int (Result Error Analytics)
    | LogFilterQuery String
    | LogFilterToggleLevel String
    | LogFilterPickSession String
    | LogFilterClear
    | TraceFilterQuery String
    | PivotToTrace String
    | SelectService String
    | GotServiceStats (Result Error (List ServiceStat))
    | GotIdentity (Result Error Identity)
    | SelectRange Range
    | GlobalQuery String
    -- v0.16.6 #493 part 2c: identity from the auth-gate.  Populated
    -- by `Cmd.perform Hub.currentIdentity GotIdentity` in init.
    -- A successful response with a tenant claim derives the
    -- tenantPrefix used to filter service-name queries.
    -- v0.16.18 #558-PR1
    -- v0.16.18 #558-PR3


-- ─── Defaults ────────────────────────────────────────────────────
emptyOverview : Overview
emptyOverview =
    { skyVersion = "—"
    , commit = "—"
    , builtAt = "—"
    , uptimeSeconds = 0
    , requestsTotal = 0
    , errorRate5xx = 0.0
    , bufferLogUsed = 0
    , bufferTraceUsed = 0
    , productionMode = False
    }


-- Mock overview used by standalone `sky console` (no parent URL).
mockOverview : Overview
mockOverview =
    emptyOverview


mockLogs : List LogEntry
mockLogs =
    [ { time = "—"
      , level = "info"
      , message = "Standalone mode — no parent URL configured."
      , subapp = ""
      , reqId = ""
      , sessionId = ""
      , userLabel = ""
      , route = ""
      , status = 0.0
      , latencyMs = 0.0
      }
    , { time = "—"
      , level = "info"
      , message = "Run from a host app to see live telemetry."
      , subapp = ""
      , reqId = ""
      , sessionId = ""
      , userLabel = ""
      , route = ""
      , status = 0.0
      , latencyMs = 0.0
      }
    ]


mockMetrics : List MetricRow
mockMetrics =
    []


mockTraces : List TraceRow
mockTraces =
    []


mockErrors : List ErrorRow
mockErrors =
    []
