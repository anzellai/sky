module AnalyticsTab exposing (analyticsView)

-- Std.Analytics tab — the product-analytics view for the embedded
-- console. Rendered by View.sky's content router when the active tab
-- is `AnalyticsTab`, in BOTH embedded and hub modes (the data is the
-- host app's own event store, not per-service hub telemetry).
--
-- Layout: a scope note → two summary stat cards (events, identified
-- users) → an "events by name" frequency panel → a recent-event
-- stream. Data comes from the parent's /_sky/console/api/analytics
-- endpoint (see Main.sky fetchAnalytics), which reads the SAME
-- Std.Analytics store the app writes — the console runs in-process
-- with the host, so there is no second DB and no env plumbing.
--
-- EVERY figure here is windowed and row-capped, and every label says
-- so. The queries behind them were all-time, unindexed scans on a
-- connection pool shared with the session store, so the tab degraded
-- the app it observes. Bounding them changed what the numbers MEAN,
-- and a windowed number under an all-time label is a wrong number,
-- not a fast one — hence `scopeNote` and the `· last N days` suffixes.
--
-- Palette mirrors ErrorsTab.sky so the tab is visually consistent
-- with the rest of the console.

import Sky.Core.Prelude exposing (..)
import Sky.Core.List as List
import Sky.Core.String as String
import Std.Ui as Ui
import Std.Ui exposing (Element)
import Std.Ui.Background as Background
import Std.Ui.Border as Border
import Std.Ui.Font as Font
import State exposing (..)


bgPage : Ui.Color
bgPage =
    Ui.rgb 20 23 28


bgRaised : Ui.Color
bgRaised =
    Ui.rgb 20 23 28


bgCode : Ui.Color
bgCode =
    Ui.rgb 44 50 60


border_ : Ui.Color
border_ =
    Ui.rgb 53 59 70


borderSoft : Ui.Color
borderSoft =
    Ui.rgb 42 47 56


textPrimary : Ui.Color
textPrimary =
    Ui.rgb 240 243 247


textSecondary : Ui.Color
textSecondary =
    Ui.rgb 197 203 212


textMuted : Ui.Color
textMuted =
    Ui.rgb 141 150 163


accent : Ui.Color
accent =
    Ui.rgb 126 182 255


mono : String
mono =
    "ui-monospace, Menlo, monospace"


-- ─── Entry point ────────────────────────────────────────────────
analyticsView : Analytics -> List (Element Msg)
analyticsView a =
    [ scopeNote a, statRow a, revenuePanel a, eventsPanel a, recentPanel a ]


-- ── scope note ──────────────────────────────────────────────────
-- Every figure on this tab is windowed and row-capped (see
-- consoleAnalyticsWindow / consoleAnalyticsRowCap in
-- runtime-go/rt/console_analytics.go). Those queries used to be
-- all-time, unindexed scans running on the connection pool the session
-- store uses. Bounding them changed WHAT THE NUMBERS MEAN, so the tab
-- says so: a windowed number shown under an all-time label is a wrong
-- number, not a fast one.
scopeNote : Analytics -> Element Msg
scopeNote a =
    Ui.el
        [ Ui.width Ui.fill, Font.size 12, Font.color textMuted ]
        (Ui.text (scopeText a))


scopeText : Analytics -> String
scopeText a =
    let
        base =
            "Scope: the last " ++ windowLabel a ++ ", newest "
                ++ String.fromInt a.rowCap
                ++ " events — not an all-time total."
    in
        if a.rowCapHit then
            base
                ++ " The row cap was reached, so revenue is a floor (≥), not a full sum."

        else
            base


windowLabel : Analytics -> String
windowLabel a =
    if a.windowDays == 1 then
        "day"

    else
        String.fromInt a.windowDays ++ " days"


-- ── revenue (Money summed per currency) ─────────────────────────
revenuePanel : Analytics -> Element Msg
revenuePanel a =
    panel
        ("Revenue by currency · last " ++ windowLabel a)
        (if List.isEmpty a.revenue then
            [ emptyState
                  "No revenue captured — track a Money prop to see totals."
            ]

        else
            List.map (currencyRowView a.rowCapHit) a.revenue)


-- `capped` prefixes the amount with "≥": the rollup stopped at the row
-- cap, so the total is a floor over the window rather than the whole of
-- it. Rendering a capped sum as if it were complete is the same class
-- of error as rendering a windowed total under an all-time label.
currencyRowView : Bool -> CurrencyTotal -> Element Msg
currencyRowView capped r =
    Ui.row
        [ Ui.width Ui.fill
        , Ui.paddingXY 0 6
        , Ui.spacing 12
        , Border.widthEach { top = 0, right = 0, bottom = 1, left = 0 }
        , Border.color borderSoft
        ]
        [ Ui.el
              [ Ui.width (Ui.px 60)
              , Font.size 13
              , Font.bold
              , Font.color textMuted
              , Font.family mono
              ]
              (Ui.text r.currency)
        , Ui.el
              [ Ui.width Ui.fill
              , Font.size 15
              , Font.bold
              , Font.color textPrimary
              , Font.family mono
              ]
              (Ui.text
                  (if capped then
                      "≥ " ++ r.amount

                  else
                      r.amount))
        , Ui.el
              [ Font.size 12, Font.color textMuted, Font.family mono ]
              (Ui.text (String.fromInt r.count ++ "×"))
        ]


-- ── summary stat cards ──────────────────────────────────────────
statRow : Analytics -> Element Msg
statRow a =
    Ui.row
        [ Ui.width Ui.fill, Ui.spacing 12 ]
        -- The labels name the WINDOW. They used to read "TOTAL EVENTS"
        -- and "IDENTIFIED USERS" against `count(*)` over all of history;
        -- the figures are now windowed, so the labels are too.
        [ statCard ("EVENTS · LAST " ++ windowLabel a) (String.fromInt a.total)
        , statCard
              ("IDENTIFIED USERS · LAST " ++ windowLabel a)
              (String.fromInt a.uniqueUsers)
        ]


statCard : String -> String -> Element Msg
statCard label value =
    Ui.column
        [ Ui.width Ui.fill
        , Ui.spacing 8
        , Background.color bgRaised
        , Border.width 1
        , Border.color border_
        , Border.rounded 6
        , Ui.padding 16
        ]
        [ Ui.el
              [ Font.size 11, Font.color textMuted, Font.letterSpacing 5.0e-2 ]
              (Ui.text label)
        , Ui.el
              [ Font.size 28
              , Font.bold
              , Font.color textPrimary
              , Font.family mono
              ]
              (Ui.text value)
        ]


-- ── events by name ──────────────────────────────────────────────
eventsPanel : Analytics -> Element Msg
eventsPanel a =
    panel
        ("Events by name · last " ++ windowLabel a)
        (if List.isEmpty a.counts then
            [ emptyState "No events captured yet." ]

        else
            List.map eventCountView a.counts)


eventCountView : EventCount -> Element Msg
eventCountView r =
    Ui.row
        [ Ui.width Ui.fill
        , Ui.paddingXY 0 6
        , Ui.spacing 12
        , Border.widthEach { top = 0, right = 0, bottom = 1, left = 0 }
        , Border.color borderSoft
        ]
        [ Ui.el
              [ Ui.width Ui.fill
              , Font.size 13
              , Font.color textPrimary
              , Font.family mono
              ]
              (Ui.text r.event)
        , Ui.el
              [ Font.size 13, Font.bold, Font.color accent, Font.family mono ]
              (Ui.text (String.fromInt r.count))
        ]


-- ── recent event stream ─────────────────────────────────────────
recentPanel : Analytics -> Element Msg
recentPanel a =
    panel
        ("Recent events · last " ++ windowLabel a)
        (if List.isEmpty a.recent then
            [ emptyState "Nothing recent to show." ]

        else
            List.map recentRowView a.recent)


recentRowView : AnalyticsEvent -> Element Msg
recentRowView e =
    let
        who =
            if e.userId == "" then
                "anonymous"

            else
                e.userId
    in
        Ui.row
            [ Ui.width Ui.fill
            , Ui.paddingXY 0 5
            , Ui.spacing 12
            , Border.widthEach { top = 0, right = 0, bottom = 1, left = 0 }
            , Border.color borderSoft
            ]
            [ Ui.row
                  [ Ui.width Ui.fill, Ui.spacing 8 ]
                  [ Ui.el
                        [ Font.size 13
                        , Font.color textSecondary
                        , Font.family mono
                        ]
                        (Ui.text e.event)
                  , if e.path == "" then
                        Ui.none

                    else
                        Ui.el
                            [ Font.size 12
                            , Font.color textMuted
                            , Font.family mono
                            ]
                            (Ui.text e.path)
                  ]
            , Ui.el
                  [ Font.size 12, Font.color textMuted, Font.family mono ]
                  (Ui.text who)
            ]


-- ── shared panel + empty-state helpers (mirror ErrorsTab.sky) ────
panel : String -> List (Element Msg) -> Element Msg
panel title children =
    Ui.column
        [ Background.color bgRaised
        , Border.width 1
        , Border.color border_
        , Border.rounded 6
        , Ui.padding 14
        , Ui.spacing 6
        , Ui.width Ui.fill
        ]
        (Ui.el
            [ Font.size 12
            , Font.bold
            , Font.color textMuted
            , Font.letterSpacing 5.0e-2
            , Ui.paddingXY 0 4
            ]
            (Ui.text (String.toUpper title))
            :: children)


emptyState : String -> Element Msg
emptyState message =
    Ui.el
        [ Ui.padding 20, Ui.centerX, Font.color textMuted, Font.italic ]
        (Ui.text message)
