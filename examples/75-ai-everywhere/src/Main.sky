module Main exposing (main, bundle, config)

{-| examples/75-ai-everywhere: private notes whose assistant runs on the
user's own device.

One `App.app` for every target: the web (`web`, server-rendered), the browser
client (`web:app`), the Mac (`desktop:mac`), the iPhone (`mobile:ios`) and
Android (`mobile:android`). A note's summary comes from the `notes` slot
through `Device.provider`: on the device once the user agreed to download the
model (the consent card), on the server until then and on a device that cannot
run it. The badge under each summary says where it was made. The Help page
asks the server-only `help` slot. The Self-check page runs one eval suite on
the device and on the server and compares them.

    sky run src/Main.sky                         the web app on http://localhost:8075
    sky build --target web:app src/Main.sky      the browser client (WebGPU and CPU engines)
    sky test tests/NotesTest.sky                 the server side, offline (tests/mocks/)

See README.md for each target.
-}

import Sky.Core.Prelude exposing (..)
import Sky.Core.Task as Task
import Sky.Core.Error as Error exposing (Error)
import Sky.Core.List as List
import Sky.Core.String as String
import Sky.Core.Maybe as Maybe
import Sky.Config as Config
import Std.App as App
import Std.Bundle as Bundle exposing (Bundle)
import Std.Cmd as Cmd
import Std.Sub as Sub
import Std.Ui as Ui exposing (Element)
import Std.Ui.Input as Input
import Std.Ui.Background as Background
import Std.Ui.Border as Border
import Std.Ui.Font as Font
import Std.Ai.Provider as Provider
import Std.Ai.Device as Device
import Std.Ai.Eval as Eval
import Notes exposing (Note)
import Assist
import Suites


-- | The database, in code (Notes.database).
config : Config.Config
config =
    Notes.database


-- | The native apps: an id, and the memory an on-device model needs on iOS.
bundle : Bundle
bundle =
    Bundle.default |> Bundle.withName "Private Notes"
        |> Bundle.withId "org.skylang.privatenotes"
        |> Bundle.withEntitlement Bundle.IncreasedMemoryLimit

-- ── Model ───────────────────────────────────────────────────────────
type alias Model =
    { page : String
    , notes : List Note
    , title : String
    , body : String
    , device : String
    , downloading : Bool
    , summaries : List ( Int, String )
    , question : String
    , answer : String
    , check : String
    , notice : String
    }

type Msg
    = Navigated String
    | NotesLoaded (Result Error (List Note))
    | TitleChanged String
    | BodyChanged String
    | Save String String
    | Delete Int
    | DeviceRead (Result Error String)
    | Download
    | Downloaded (Result Error String)
    | Tick
    | Forget
    | Forgotten (Result Error ())
    | Summarise Int String
    | Summarised Int String (Result Error Provider.Stream)
    | SummaryPiece Int String (Result Error Provider.StreamStep)
    | QuestionChanged String
    | AskHelp String
    | HelpAnswered (Result Error String)
    | SelfCheck
    | Recorded (Result Error Device.Recording)
    | Score (Result Error String)
    | Checked (Result Error String)


init : () -> ( Model, Cmd.Cmd Msg )
init _ =
    ( { page = "notes"
      , notes = []
      , title = ""
      , body = ""
      , device = "checking this device"
      , downloading = False
      , summaries = []
      , question = ""
      , answer = ""
      , check = ""
      , notice = ""
      }
    , Cmd.perform Notes.all NotesLoaded
    )


-- ── The device ──────────────────────────────────────────────────────
describe : Device.Status -> String
describe s =
    case s of

        Device.Ready r ->
            "ready on this device (" ++ Device.backendText r.backend ++ ")"

        Device.NotDownloaded r ->
            "can run on this device after a download of " ++ megabytes r.bytes

        Device.Downloading r ->
            "downloading " ++ megabytes r.doneBytes ++ " of "
                ++ megabytes r.totalBytes

        Device.ServerSide reason ->
            "answers from the server (" ++ reasonText reason ++ ")"

        Device.Unsupported _ ->
            "this device cannot run the model"


reasonText : Device.Reason -> String
reasonText r =
    case r of

        Device.OperatorChoice ->
            "the operator chose the server"

        Device.OnTheServer ->
            "server-rendered page"

        Device.OfferRefused why ->
            why

        Device.NoBackend why ->
            why

        Device.NoStorage ->
            "not enough storage"

        Device.NotStored ->
            "not downloaded"

        Device.PromptTooLong ->
            "the note is too long for the device"


megabytes : Int -> String
megabytes n =
    String.fromInt (n // 1000000) ++ " MB"


isReady : Device.Status -> Bool
isReady s =
    case s of

        Device.Ready _ ->
            True

        _ ->
            False


-- The device's status, as the card shows it. It runs in the client: a
-- device's status is the device's.
deviceText : Task Error String
deviceText =
    Device.status "notes" |> Task.map describe


-- Summarise on the device or the server, and say which: the badge, and the
-- stream the summary is read from as it is written.
summarise : String -> Task Error ( String, Provider.Stream )
summarise body =
    Device.status "notes"
        |> Task.andThen
               (\s ->
                   Provider.stream
                       Assist.summaryOptions
                       Assist.assistant
                       (Assist.summaryPrompt body)
                       |> Task.map
                              (\st ->
                                  ( if isReady s then
                                        "made on this device"

                                    else
                                        "made on the server"
                                  , st
                                  )))


-- The summary of note `id` so far.
setSummary : Int -> String -> Model -> Model
setSummary id text model =
    { model
        | summaries =
            ( id, text ) :: List.filter (\( i, _ ) -> i /= id) model.summaries
    }


-- Record the device's answers to the self-check suite.
recordHere : Task Error Device.Recording
recordHere =
    Device.status "notes"
        |> Task.andThen
               (\s ->
                   Device.record
                       (if isReady s then
                           "device"

                       else
                           "device (answered by the server)")
                       Assist.assistant
                       (Eval.prompts Suites.summaries))


-- ── Update ──────────────────────────────────────────────────────────
update : Msg -> Model -> ( Model, Cmd.Cmd Msg )
update msg model =
    case msg of

        Navigated p ->
            ( { model | page = p }, Cmd.none )

        NotesLoaded (Ok ns) ->
            ( { model | notes = ns }, Cmd.perform deviceText DeviceRead )

        NotesLoaded (Err e) ->
            ( { model | notice = Error.toString e }, Cmd.none )

        TitleChanged t ->
            ( { model | title = t }, Cmd.none )

        BodyChanged b ->
            ( { model | body = b }, Cmd.none )

        Save title body ->
            ( { model | title = "", body = "" }
            , Cmd.perform (Notes.add title body) NotesLoaded
            )

        Delete id ->
            ( model, Cmd.perform (Notes.remove id) NotesLoaded )

        DeviceRead (Ok s) ->
            ( { model
                  | device = s
                  , downloading =
                      model.downloading && not (String.startsWith "ready" s)
              }
            , Cmd.none
            )

        DeviceRead (Err e) ->
            ( { model | device = Error.toString e }, Cmd.none )

        Download ->
            ( { model | downloading = True, device = "starting the download" }
            , Cmd.perform
                  (Device.prepare "notes" |> Task.map describe)
                  Downloaded
            )

        Downloaded (Ok s) ->
            ( { model | downloading = False, device = s }, Cmd.none )

        Downloaded (Err e) ->
            ( { model
                  | downloading = False
                  , device = "the download failed: " ++ Error.toString e
              }
            , Cmd.none
            )

        Tick ->
            ( model, Cmd.perform deviceText DeviceRead )

        Forget ->
            ( model, Cmd.perform (Device.evict "notes") Forgotten )

        Forgotten _ ->
            ( model, Cmd.perform deviceText DeviceRead )

        Summarise id body ->
            ( setSummary id "" model
            , Cmd.perform
                  (summarise body)
                  (\r ->
                      case r of

                          Ok ( badge, st ) ->
                              Summarised id badge (Ok st)

                          Err e ->
                              Summarised id "" (Err e))
            )

        Summarised id badge (Ok st) ->
            ( model, Cmd.perform (Provider.read st) (SummaryPiece id badge) )

        Summarised _ _ (Err e) ->
            ( { model | notice = Error.toString e }, Cmd.none )

        -- The summary grows as the model writes it; the badge comes last.
        SummaryPiece id badge (Ok (Provider.Piece text next)) ->
            ( setSummary id (summaryOf model id ++ text) model
            , Cmd.perform (Provider.read next) (SummaryPiece id badge)
            )

        SummaryPiece id badge (Ok (Provider.Finished r)) ->
            ( setSummary id (r.content ++ "  [" ++ badge ++ "]") model
            , Cmd.none
            )

        SummaryPiece _ _ (Err e) ->
            ( { model | notice = Error.toString e }, Cmd.none )

        QuestionChanged q ->
            ( { model | question = q }, Cmd.none )

        AskHelp q ->
            ( { model | answer = "asking the server" }
            , Cmd.perform
                  (Provider.chatWith
                      Assist.summaryOptions
                      Assist.help
                      [ Provider.system
                            "You help people use a private notes app. Answer in two sentences."
                      , Provider.user q
                      ]
                      |> Task.map .content)
                  HelpAnswered
            )

        HelpAnswered (Ok a) ->
            ( { model | answer = a }, Cmd.none )

        HelpAnswered (Err e) ->
            ( { model | answer = Error.toString e }, Cmd.none )

        SelfCheck ->
            ( { model | check = "asking the device" }
            , Cmd.perform recordHere Recorded
            )

        Recorded (Ok rec) ->
            -- The recording crosses to the server as its JSON text.
            ( { model | check = "scoring on the server" }
            , Cmd.perform (Task.succeed (Device.encodeRecording rec)) Score
            )

        Recorded (Err e) ->
            ( { model | check = Error.toString e }, Cmd.none )

        Score (Ok text) ->
            ( model, Cmd.perform (Suites.scoreText text) Checked )

        Score (Err e) ->
            ( { model | check = Error.toString e }, Cmd.none )

        Checked (Ok text) ->
            ( { model | check = text }, Cmd.none )

        Checked (Err e) ->
            ( { model | check = Error.toString e }, Cmd.none )


-- While the model downloads, the page reads the progress every second.
subscriptions : Model -> Sub Msg
subscriptions model =
    if model.downloading then
        Sub.every 1000 Tick

    else
        Sub.none


-- ── View ────────────────────────────────────────────────────────────
accent : Ui.Color
accent =
    Ui.rgb255 37 99 235


button : String -> String -> Msg -> Element Msg
button id label msg =
    Input.button
        [ Ui.htmlAttribute "id" id
        , Background.color accent
        , Font.color (Ui.rgb255 255 255 255)
        , Ui.paddingXY 12 8
        , Border.rounded 6
        ]
        { onPress = Just msg, label = Ui.text label }


nav : Element Msg
nav =
    Ui.row
        [ Ui.spacing 16 ]
        [ Ui.link [ Font.color accent ] { url = "/", label = Ui.text "Notes" }
        , Ui.link
              [ Font.color accent ]
              { url = "/help", label = Ui.text "Help" }
        , Ui.link
              [ Font.color accent ]
              { url = "/selfcheck", label = Ui.text "Self-check" }
        ]


deviceCard : Model -> Element Msg
deviceCard model =
    Ui.column
        [ Ui.padding 12
        , Ui.spacing 8
        , Border.rounded 8
        , Background.color (Ui.rgb255 241 245 249)
        , Ui.width Ui.fill
        ]
        [ Ui.el
              [ Ui.htmlAttribute "id" "device" ]
              (Ui.text ("Assistant: " ++ model.device))
        , if String.startsWith "can run on this device" model.device then
              Ui.column
                  [ Ui.spacing 6 ]
                  [ Ui.paragraph
                        []
                        [ Ui.text
                              "Download the assistant to this device? Your notes are then summarised here and never sent for it. The model comes from this app's server and is checked before use."
                        ]
                  , button "download" "Download" Download
                  ]

          else if String.startsWith "ready" model.device then
              button "forget" "Remove from this device" Forget

          else
              Ui.none
        ]


summaryOf : Model -> Int -> String
summaryOf model id =
    List.filter (\( i, _ ) -> i == id) model.summaries |> List.head
        |> Maybe.map (\( _, s ) -> s)
        |> Maybe.withDefault ""


noteView : Model -> Note -> Element Msg
noteView model n =
    Ui.column
        [ Ui.spacing 6
        , Ui.padding 10
        , Border.width 1
        , Border.color (Ui.rgb255 226 232 240)
        , Border.rounded 6
        , Ui.width Ui.fill
        ]
        [ Ui.el [ Font.bold ] (Ui.text n.title)
        , Ui.paragraph [] [ Ui.text n.body ]
        , Ui.row
              [ Ui.spacing 8 ]
              [ button
                    ("summarise-" ++ String.fromInt n.id)
                    "Summarise"
                    (Summarise n.id n.body)
              , button ("delete-" ++ String.fromInt n.id) "Delete" (Delete n.id)
              ]
        , Ui.el
              [ Ui.htmlAttribute "id" ("summary-" ++ String.fromInt n.id)
              , Font.italic
              ]
              (Ui.text (summaryOf model n.id))
        ]


notesPage : Model -> Element Msg
notesPage model =
    Ui.column
        [ Ui.spacing 12, Ui.width Ui.fill ]
        [ deviceCard model
        , Input.text
              [ Ui.htmlAttribute "id" "title" ]
              { onChange = TitleChanged
              , text = model.title
              , placeholder = Just (Input.placeholder [] (Ui.text "Title"))
              , label = Input.labelAbove [] (Ui.text "Title")
              }
        , Input.multiline
              [ Ui.htmlAttribute "id" "body" ]
              { onChange = BodyChanged
              , text = model.body
              , placeholder = Just (Input.placeholder [] (Ui.text "Your note"))
              , label = Input.labelAbove [] (Ui.text "Note")
              , spellcheck = True
              }
        , button "save" "Save" (Save model.title model.body)
        , Ui.column
              [ Ui.spacing 8, Ui.width Ui.fill ]
              (List.map (noteView model) model.notes)
        ]


helpPage : Model -> Element Msg
helpPage model =
    Ui.column
        [ Ui.spacing 12, Ui.width Ui.fill ]
        [ Ui.paragraph
              []
              [ Ui.text "Ask how the app works. The server's own model answers."
              ]
        , Input.text
              [ Ui.htmlAttribute "id" "question" ]
              { onChange = QuestionChanged
              , text = model.question
              , placeholder = Nothing
              , label = Input.labelAbove [] (Ui.text "Question")
              }
        , button "ask" "Ask" (AskHelp model.question)
        , Ui.paragraph
              [ Ui.htmlAttribute "id" "answer" ]
              [ Ui.text model.answer ]
        ]


checkPage : Model -> Element Msg
checkPage model =
    Ui.column
        [ Ui.spacing 12, Ui.width Ui.fill ]
        [ Ui.paragraph
              []
              [ Ui.text
                    "One eval suite, three short notes: the device answers, the server scores its answers and its own."
              ]
        , Ui.el
              [ Ui.htmlAttribute "id" "device" ]
              (Ui.text ("Assistant: " ++ model.device))
        , button "selfcheck" "Run the self-check" SelfCheck
        , Ui.paragraph [ Ui.htmlAttribute "id" "check" ] [ Ui.text model.check ]
        ]


view : Model -> Element Msg
view model =
    Ui.column
        [ Ui.padding 24
        , Ui.spacing 16
        , Ui.width (Ui.fill |> Ui.maximum 720)
        , Ui.centerX
        ]
        [ Ui.el [ Font.size 24, Font.bold ] (Ui.text "Private Notes")
        , nav
        , if model.notice == "" then
              Ui.none

          else
              Ui.el [ Font.color (Ui.rgb255 185 28 28) ] (Ui.text model.notice)
        , case model.page of

              "help" ->
                  helpPage model

              "selfcheck" ->
                  checkPage model

              _ ->
                  notesPage model
        ]


appDef =
    App.app
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        }
        |> App.withRoutes
               [ App.route "/" "notes"
               , App.route "/help" "help"
               , App.route "/selfcheck" "selfcheck"
               ]
        |> App.withNotFound "notes"
        |> App.withOnNavigate Navigated
        |> App.withConfig (App.WebConfig { App.webDefaults | port = 8075 })


main =
    App.run appDef
