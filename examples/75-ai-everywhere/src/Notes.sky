module Notes exposing
    ( Note
    , store
    , database
    , connect
    , open
    , all
    , add
    , remove
    )

{-| The notes: a `Std.Db.Store` on the app's own SQLite file. The database is
set in code (`database`); `SKY_DB_PATH` moves it (a SQLite file, or a
`postgres://` URL).
-}

import Sky.Core.Prelude exposing (..)
import Sky.Core.Task as Task
import Sky.Core.Error exposing (Error)
import Sky.Core.List as List
import Sky.Core.String as String
import Std.Codec as Codec
import Sky.Config as Config
import Std.Db as Db exposing (Db)
import Std.Db.Store as Store exposing (Store)

type alias Note =
    { id : Int
    , title : String
    , body : String
    }


store : Store Note
store =
    Store.fromCodec "notes" (Codec.auto { id = 0, title = "", body = "" })
        |> Store.serial "id"


-- | The app's database, in code: `notes.db` in the working directory.
database : Config.Config
database =
    Config.default |> Config.withDatabase (Config.Sqlite "notes.db")


connect : Task Error Db
connect =
    Config.apply database |> Task.andThen (\_ -> Db.connect ())


-- | The database with the notes table created (idempotent).
open : Task Error Db
open =
    connect |> Task.andThen (\db -> Store.create db store |> Task.map (\_ -> db))


-- | Every note, newest first.
all : Task Error (List Note)
all =
    open
        |> Task.andThen (\db -> Store.all db store)
        |> Task.map (List.sortBy (\n -> 0 - n.id))


add : String -> String -> Task Error (List Note)
add title body =
    open
        |> Task.andThen (\db -> Store.insert db store { id = 0, title = title, body = body })
        |> Task.andThen (\_ -> all)


remove : Int -> Task Error (List Note)
remove id =
    open
        |> Task.andThen (\db -> Store.delete db store "id" (String.fromInt id))
        |> Task.andThen (\_ -> all)
