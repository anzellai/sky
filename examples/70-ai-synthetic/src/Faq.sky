module Faq exposing (generator, rubric, versions)

{-| A synthetic FAQ dataset for a support assistant, generated by a teacher
model and filtered by a judge. `Main` and the tests share it.

The teacher is the `"teacher"` slot and the judge the `"judge"` slot: both are
the local pinned development model by default, and an operator moves either
to a larger or remote model with `SKY_AI_TEACHER_*` / `SKY_AI_JUDGE_*`.
-}

import Sky.Core.Prelude exposing (..)
import Sky.Core.String as String
import Std.Ai.Eval as Eval
import Std.Ai.Dataset as Dataset exposing (Instruction)
import Std.Ai.Dataset.Synthetic as Synthetic


rubric : String
rubric =
    "The answer is correct for an online shop, polite, and tells the customer what to do next."


generator : Synthetic.Generator Instruction
generator =
    Synthetic.generator "support-faq" Dataset.instructionCodec
        |> Synthetic.withTopics [ "refunds", "delivery", "passwords" ]
        |> Synthetic.withPersonas
               [ "a first-time customer", "a busy shop owner" ]
        |> Synthetic.withExamples
               [ { prompt = "How do I change my email address?"
                 , completion =
                     "Open Settings, choose Account and enter the new address. We send a link to confirm it."
                 }
               ]
        |> Synthetic.withPerCall 4
        |> Synthetic.withTarget 6
        |> Synthetic.withSeed 7
        |> Synthetic.withMaxCalls 12
        |> Synthetic.withDedupe (\r -> String.toLower (String.trim r.prompt))
        |> Synthetic.withFilter
               "answer too short"
               (\r -> String.length r.completion >= 30)
        |> Synthetic.withJudge
               Eval.defaultJudge
               rubric
               (\r -> ( r.prompt, r.completion ))


versions : Dataset.Target
versions =
    Dataset.target ".sky/ai/datasets" "support-faq"
