module Migrations exposing (all)

-- Versioned schema migrations for the composite todo+auth service.
-- One migration per logical change; checksums of the SQL body are
-- guarded by `Db.migrate` so an edit-after-apply is rejected.
import Sky.Core.Prelude exposing (..)
import Std.Db as Db


all : List Db.Migration
all =
    [ usersTable, todosTable, todosUserIdIndex ]


usersTable : Db.Migration
usersTable =
    { name = "0001_users"
    , sql = """
        CREATE TABLE users (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            email TEXT UNIQUE NOT NULL,
            password_hash TEXT NOT NULL,
            created_at INTEGER NOT NULL
        )
      """
    }


todosTable : Db.Migration
todosTable =
    { name = "0002_todos"
    , sql = """
        CREATE TABLE todos (
            id TEXT PRIMARY KEY,
            user_id INTEGER NOT NULL,
            text TEXT NOT NULL,
            done INTEGER NOT NULL DEFAULT 0,
            created_at INTEGER NOT NULL
        )
      """
    }


todosUserIdIndex : Db.Migration
todosUserIdIndex =
    { name = "0003_todos_user_id_idx"
    , sql = "CREATE INDEX todos_user_id_idx ON todos(user_id)"
    }
