module Routes.Todos exposing
    ( handleList
    , handleCreate
    , handleDelete
    , todoCreateDecoder
    , encodeTodo
    , todosStore
    )

-- Authenticated CRUD over the `todos` table.  Exercises:
--   * Sky.Http.Server.param (URL captures)
--   * Sky.Http.Server.header (Authorization)
--   * Std.Codec + Std.Db.Store — ONE codec drives reads + writes over a
--     typed `Store Todo`; no hand-written SQL, no Dict row-mapper. (The
--     table itself is created by the versioned `Migrations.all` at boot,
--     which stays the schema source of truth — so no `Store.create` here.)
--   * Std.PubSub.publish (fired on every new todo — Task-shaped pub
--     from inside a Sky.Http.Server handler, NOT a Sky.Live update
--     return)
--   * Sky.Core.Crypto.randomToken (per-todo id)

import Sky.Core.Prelude exposing (..)
import Sky.Core.Dict as Dict
import Sky.Core.String as String
import Sky.Core.Task as Task
import Sky.Core.Time as Time
import Sky.Core.Error as Error exposing (Error)
import Sky.Core.Json.Decode as JsonDec
import Sky.Core.Json.Encode as JsonEnc
import Sky.Core.Crypto as Crypto
import Sky.Http.Server as Server
import Sky.Http.Server exposing (Request, Response)
import Std.Codec as Codec
import Std.Db as Db exposing (SqlValue(..))
import Std.Db.Store as Store exposing (Store)
import Std.Log as Log
import Std.PubSub as PubSub
import Auth
import State exposing (Config, Todo, TodoCreate, AuthClaims)


-- ONE codec derives the column mapping (Codec.auto → snake_case:
-- id, user_id, text, done, created_at) and drives every read + write. The
-- `id` is an app-generated token (Crypto.randomToken), so it's a plain
-- `primaryKey`, not `serial`. The DDL is owned by Migrations.all.
todosStore : Store Todo
todosStore =
    Store.fromCodec
        "todos"
        (Codec.auto
            { id = "", userId = 0, text = "", done = False, createdAt = 0 })
        |> Store.primaryKey "id"


todoCreateDecoder : JsonDec.Decoder TodoCreate
todoCreateDecoder =
    JsonDec.map (\text -> { text = text }) (JsonDec.field "text" JsonDec.string)


encodeTodo : Todo -> JsonEnc.Value
encodeTodo todo =
    JsonEnc.object
        [ ( "id", JsonEnc.string todo.id )
        , ( "userId", JsonEnc.int todo.userId )
        , ( "text", JsonEnc.string todo.text )
        , ( "done", JsonEnc.bool todo.done )
        , ( "createdAt", JsonEnc.int todo.createdAt )
        ]


handleList : Config -> Db -> Request -> Task Error Response
handleList cfg db req =
    withAuth
        cfg
        req
        (\claims ->
            Store.query todosStore
                |> Store.where_ (Store.eq "user_id" (SqlInt claims.userId))
                |> Store.orderDesc "created_at"
                |> Store.toList db
                |> Task.andThen
                       (\todos ->
                           let
                               body =
                                   JsonEnc.encode
                                       0
                                       (JsonEnc.list encodeTodo todos)
                           in
                               Task.succeed (Server.json body)))


handleCreate : Config -> Db -> Request -> Task Error Response
handleCreate cfg db req =
    withAuth
        cfg
        req
        (\claims ->
            case JsonDec.decodeString todoCreateDecoder req.body of

                Err _ ->
                    Task.succeed (errorJson 400 "expected {text}")

                Ok payload ->
                    insertTodo db claims payload)


insertTodo : Db -> AuthClaims -> TodoCreate -> Task Error Response
insertTodo db claims payload =
    Crypto.randomToken 12
        |> Task.andThen
               (\todoId ->
                   Time.unixMillis ()
                       |> Task.andThen
                              (\nowMs ->
                                  let
                                      todo =
                                          { id = todoId
                                          , userId = claims.userId
                                          , text = payload.text
                                          , done = False
                                          , createdAt = nowMs
                                          }
                                  in
                                      Store.insert db todosStore todo
                                          |> Task.andThen
                                                 (\_ -> publishTodoCreated todo)))


-- Task-shaped publish.  Returns the subscriber count, but the route
-- never refuses the request when no Live.app is listening — the
-- publish failure is logged + swallowed via Task.onError.
publishTodoCreated : Todo -> Task Error Response
publishTodoCreated todo =
    PubSub.publish "todos.created" (encodeTodo todo)
        |> Task.onError
               (\e ->
                   let
                       _ =
                           Log.warnWith
                               "publish.todoCreated"
                               [ ( "error", Error.toString e ) ]
                   in
                       Task.succeed 0)
        |> Task.andThen
               (\_ ->
                   Task.succeed
                       (Server.json (JsonEnc.encode 0 (encodeTodo todo))))


handleDelete : Config -> Db -> Request -> Task Error Response
handleDelete cfg db req =
    withAuth
        cfg
        req
        (\claims ->
            case Server.param "id" req of

                Nothing ->
                    Task.succeed (errorJson 400 "missing :id path param")

                Just todoId ->
                    deleteIfOwned db claims todoId)


deleteIfOwned : Db -> AuthClaims -> String -> Task Error Response
deleteIfOwned db claims todoId =
    Store.findBy db todosStore "id" todoId
        |> Task.andThen
               (\maybeTodo ->
                   case maybeTodo of

                       Nothing ->
                           Task.succeed (errorJson 404 "todo not found")

                       Just todo ->
                           if todo.userId /= claims.userId then
                               Task.succeed (errorJson 403 "not your todo")

                           else
                               Store.delete db todosStore "id" todoId
                                   |> Task.andThen
                                          (\_ ->
                                              Task.succeed
                                                  (Server.json
                                                      "{\"deleted\":true}")))


-- ─── Helpers ───────────────────────────────────────────────────────
-- Authenticated-route gate.  Pulls Authorization, verifies the JWT,
-- routes to `kont` on success or a 401 on failure.  Threads the
-- current unix-seconds via Time so the JWT exp check sees realtime.
withAuth : Config -> Request -> (AuthClaims -> Task Error Response) -> Task Error Response
withAuth cfg req kont =
    case Server.header "Authorization" req of

        Nothing ->
            Task.succeed (errorJson 401 "missing Authorization header")

        Just authHeader ->
            Time.unixMillis ()
                |> Task.andThen
                       (\nowMs ->
                           case Auth.verifyBearer
                                    cfg.jwtSecret
                                    (nowMs // 1000)
                                    authHeader of

                               Ok claims ->
                                   kont claims

                               Err _ ->
                                   Task.succeed (errorJson 401 "invalid token"))


-- Build a typed Response record directly.  Going via
-- `Server.json |> Server.withStatus` triggers a runtime
-- coerce panic — the kernel returns `rt.SkyResponse` but
-- the typed codegen expects `Sky_Http_Server_Response_R`
-- (record alias).  A record literal lowers cleanly.
errorJson : Int -> String -> Response
errorJson status message =
    { status = status
    , body =
        JsonEnc.encode
            0
            (JsonEnc.object [ ( "error", JsonEnc.string message ) ])
    , headers = Dict.empty
    , contentType = "application/json"
    }
