module Middleware exposing (withCors, withLogging, withRateLimit, withBasicAuth)

-- The middleware stack this server composes, re-exported from the stdlib
-- `Sky.Http.Middleware` under the project's own `Handler` alias.
--
-- `Handler` is `Sky.Http.Server.Handler` (`Request -> Task Error Response`),
-- so each helper here is the stdlib function with its declared signature.
-- Application code does not bind runtime kernels itself: `Ffi.kernel` is
-- stdlib-only (`[E1011]`), because the checker cannot compare a hand-written
-- annotation with the kernel's real signature.

import Sky.Core.Error exposing (Error)
import Sky.Http.Middleware as Mw
import Sky.Http.Server exposing (Request, Response)

type alias Handler =
    Request -> Task Error Response


withCors : List String -> Handler -> Handler
withCors origins handler =
    Mw.withCors origins handler


withLogging : Handler -> Handler
withLogging handler =
    Mw.withLogging handler


withRateLimit : String -> Int -> Int -> Handler -> Handler
withRateLimit name capacity refillPerSec handler =
    Mw.withRateLimit name capacity refillPerSec handler


withBasicAuth : String -> String -> Handler -> Handler
withBasicAuth user password handler =
    Mw.withBasicAuth user password handler
