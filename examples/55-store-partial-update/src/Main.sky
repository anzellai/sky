module Main exposing (main)

-- Regression + demo for Store partial-column update: `Store.setFields` sets ONE
-- column without clobbering the others, and `Store.adjust` does an atomic
-- relative change (SET col = col + delta) — the two ops a whole-record
-- `Store.update` cannot express.

import Sky.Core.Prelude exposing (..)
import Sky.Core.Task as Task
import Std.Log exposing (println)
import Std.Codec as Codec
import Std.Db as Db exposing (SqlValue(..))
import Std.Db.Store as Store exposing (Store)
import Modernc.Org.Sqlite as _


type alias Product =
    { id : String, name : String, imageUrl : String, stock : Int }


products : Store Product
products =
    Store.fromCodec "products" (Codec.auto { id = "", name = "", imageUrl = "", stock = 0 })
        |> Store.primaryKey "id"


main : Task Error ()
main =
    Db.connect ()
        |> Task.andThen (\conn -> Store.create conn products |> Task.map (\_ -> conn))
        -- Reset to a known seed row first. Without this the example is
        -- single-shot: the second run's `Store.insert` hits the duplicate
        -- primary key "p1", the Task chain short-circuits, and the program
        -- prints NOTHING while still exiting 0. That is what the CI gate
        -- captured into a 1-byte golden, which then matched itself green.
        |> Task.andThen (\conn -> Store.delete conn products "id" "p1" |> Task.map (\_ -> conn))
        |> Task.andThen (\conn -> Store.insert conn products { id = "p1", name = "Mug", imageUrl = "mug.png", stock = 10 } |> Task.map (\_ -> conn))
        -- partial update: change name ONLY, must NOT touch imageUrl/stock
        |> Task.andThen (\conn -> Store.setFields conn products (SqlString "p1") [ ( "name", SqlString "Big Mug" ) ] |> Task.map (\_ -> conn))
        -- atomic decrement stock by 3
        |> Task.andThen (\conn -> Store.adjust conn products (Store.eq "id" (SqlString "p1")) [ ( "stock", -3 ) ] |> Task.map (\_ -> conn))
        |> Task.andThen (\conn -> Store.findBy conn products "id" "p1")
        |> Task.andThen
            (\mp ->
                case mp of
                    Just p ->
                        println ("name=" ++ p.name ++ " imageUrl=" ++ p.imageUrl ++ " stock=" ++ String.fromInt p.stock)

                    Nothing ->
                        println "not found"
            )
