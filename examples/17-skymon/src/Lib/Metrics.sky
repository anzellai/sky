module Lib.Metrics exposing (..)

import Sky.Core.Prelude exposing (..)
import Sky.Core.List as List
import Sky.Core.Dict as Dict
import Sky.Core.String as String
import Sky.Core.Result as Result
import Sky.Core.Http as Http
import Sky.Core.Task as Task
import Sky.Core.Crypto as Crypto
import Std.Db exposing (SqlValue(..))
import Std.Db as RawDb
import Std.Db.Store as Store
import Std.Log exposing (println)
import Lib.Database as Db exposing (Metric, MetricSample)
import Lib.SafeQuery as SafeQuery
import Sky.Core.Error as Error exposing (Error(..), ErrorKind(..))


reportWrite : String -> Result Error a -> ()
reportWrite label result =
    case result of

        Ok _ ->
            ()

        Err e ->
            let
                _ =
                    println
                        ("[DB ERROR] Metrics." ++ label ++ ": "
                            ++ Error.toString e)
            in
                ()


createMetric : String -> String -> String -> String -> String
createMetric name sourceType configJson visibility =
    let
        metId =
            String.slice 0 12 (Crypto.sha256 (name ++ ":" ++ sourceType))
        metric =
            { id = metId
            , name = name
            , sourceType = sourceType
            , configJson = configJson
            , lastValue = ""
            , lastUpdated = ""
            , visibility = visibility
            , createdAt = ""
            }
        _ =
            reportWrite
                "createMetric"
                (Task.run (Store.upsert Db.conn Db.metricStore metric))
    in
        metId


deleteMetric : String -> ()
deleteMetric metId =
    let
        _ =
            reportWrite
                "deleteMetric/history"
                (Task.run
                    (Store.deleteWhere
                        Db.conn
                        Db.metricHistoryStore
                        (Store.eq "metricId" (SqlString metId))))
        _ =
            reportWrite
                "deleteMetric/alerts"
                (Task.run
                    (Store.deleteWhere
                        Db.conn
                        Db.alertStore
                        (Store.eq "metricId" (SqlString metId))))
        _ =
            reportWrite
                "deleteMetric/row"
                (Task.run (Store.delete Db.conn Db.metricStore "id" metId))
    in
        ()


getMetrics : () -> List Metric
getMetrics _ =
    Result.withDefault
        []
        (Task.run
            (Store.query Db.metricStore |> Store.orderAsc "name"
                |> Store.toList Db.conn))


runMetric : Metric -> String
runMetric metric =
    if metric.sourceType == "sql" then
        runSqlMetric metric

    else if metric.sourceType == "http" then
        runHttpMetric metric

    else if metric.sourceType == "api" then
        runApiMetric metric

    else
        "error: unknown source type"


runSqlMetric : Metric -> String
runSqlMetric metric =
    let
        dsn = extractJsonField "dsn" metric.configJson
        query = extractJsonField "query" metric.configJson
    in
        if String.isEmpty dsn || String.isEmpty query then
            "error: missing dsn or query in config"

        else
            runSafeQuery dsn query


-- runSafeQuery / runSafeQueryWithConn stay RAW BY DESIGN: they run an operator's
-- own SQL against an EXTERNAL Postgres DSN (SafeQuery gates it to SELECT-only).
-- Store models this app's tables, not arbitrary external queries.
runSafeQuery : String -> String -> String
runSafeQuery dsn query =
    case Task.run (RawDb.open "postgres" dsn) of

        Err e ->
            let
                _ =
                    println
                        ("[METRIC ERROR] runSafeQuery/open: " ++ Error.toString e)
            in
                "error: " ++ Error.toString e

        Ok extConn ->
            runSafeQueryWithConn extConn query


runSafeQueryWithConn extConn query =
    case SafeQuery.runReadOnly extConn query [] of

        Err e ->
            let
                _ =
                    println
                        ("[METRIC ERROR] runSafeQuery: " ++ Error.toString e)
            in
                "error: " ++ Error.toString e

        Ok rows ->
            extractFirstValue rows


extractFirstValue : List (Dict String String) -> String
extractFirstValue rows =
    case rows of

        row :: _ ->
            let
                values = Dict.values row
            in
                case values of

                    v :: _ ->
                        v

                    [] ->
                        "0"

        [] ->
            "0"


runHttpMetric : Metric -> String
runHttpMetric metric =
    let
        url = extractJsonField "url" metric.configJson
    in
        if String.isEmpty url then
            "error: missing url"

        else
            case Task.run (Http.get url) of

                Ok resp ->
                    String.fromInt resp.status

                Err e ->
                    let
                        _ =
                            println
                                ("[METRIC ERROR] runHttpMetric " ++ url ++ ": "
                                    ++ Error.toString e)
                    in
                        "error: " ++ Error.toString e


runApiMetric : Metric -> String
runApiMetric metric =
    let
        url = extractJsonField "url" metric.configJson
        fieldPath = extractJsonField "field" metric.configJson
    in
        if String.isEmpty url then
            "error: missing url"

        else
            case Task.run (Http.get url) of

                Ok resp ->
                    if String.isEmpty fieldPath then
                        resp.body

                    else
                        extractJsonField fieldPath resp.body

                Err e ->
                    let
                        _ =
                            println
                                ("[METRIC ERROR] runApiMetric " ++ url ++ ": "
                                    ++ Error.toString e)
                    in
                        "error: " ++ Error.toString e


-- recordMetricValue : update the metric's live value (touchOnUpdate bumps
-- last_updated) + append a history sample.
recordMetricValue : String -> String -> ()
recordMetricValue metId value =
    let
        _ =
            case Task.run (Store.findBy Db.conn Db.metricStore "id" metId) of

                Ok (Just met) ->
                    reportWrite
                        "recordMetricValue/update"
                        (Task.run
                            (Store.update
                                Db.conn
                                Db.metricStore
                                { met | lastValue = value }))

                _ ->
                    ()
        sample =
            { id = 0, metricId = metId, value = value, recordedAt = "" }
        _ =
            reportWrite
                "recordMetricValue/history"
                (Task.run (Store.insert Db.conn Db.metricHistoryStore sample))
    in
        ()


getMetricHistory : String -> Int -> List MetricSample
getMetricHistory metId limit =
    Result.withDefault
        []
        (Task.run
            (Store.query Db.metricHistoryStore
                |> Store.where_ (Store.eq "metricId" (SqlString metId))
                |> Store.orderDesc "recordedAt"
                |> Store.limit limit
                |> Store.toList Db.conn))


extractJsonField : String -> String -> String
extractJsonField key json =
    let
        searchKey = "\"" ++ key ++ "\""
        parts = String.split searchKey json
    in
        case List.drop 1 parts of

            after :: _ ->
                extractJsonValue (String.trim (dropUntilColon after))

            [] ->
                ""


dropUntilColon : String -> String
dropUntilColon s =
    if String.isEmpty s then
        ""

    else if String.startsWith ":" s then
        String.trim (String.slice 1 (String.length s) s)

    else
        dropUntilColon (String.slice 1 (String.length s) s)


extractJsonValue : String -> String
extractJsonValue s =
    if String.startsWith "\"" s then
        let
            rest = String.slice 1 (String.length s) s
            endQuote = findCharIndex '"' rest 0
        in
            if endQuote > 0 then
                String.slice 0 endQuote rest

            else
                rest

    else
        let
            endIdx = findEndOfValue s 0
        in
            String.trim (String.slice 0 endIdx s)


findCharIndex : Char -> String -> Int -> Int
findCharIndex ch s idx =
    if idx >= String.length s then
        -1

    else if String.slice idx (idx + 1) s == String.fromChar ch then
        idx

    else
        findCharIndex ch s (idx + 1)


findEndOfValue : String -> Int -> Int
findEndOfValue s idx =
    if idx >= String.length s then
        idx

    else
        let
            ch = String.slice idx (idx + 1) s
        in
            if ch == "," || ch == "}" || ch == "]" then
                idx

            else
                findEndOfValue s (idx + 1)
