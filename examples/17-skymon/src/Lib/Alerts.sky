module Lib.Alerts exposing (..)

import Sky.Core.Prelude exposing (..)
import Sky.Core.List as List
import Sky.Core.Dict as Dict
import Sky.Core.String as String
import Sky.Core.Result as Result
import Sky.Core.Http as Http
import Sky.Core.Task as Task
import Sky.Core.Crypto as Crypto
import Std.Db exposing (SqlValue(..))
import Std.Db.Store as Store
import Std.Log exposing (println)
import Lib.Database as Database exposing (Alert, Metric, AlertEvent)
import Sky.Core.Error as Error exposing (Error(..), ErrorKind(..))


reportWrite : String -> Result Error a -> ()
reportWrite label result =
    case result of

        Ok _ ->
            ()

        Err e ->
            let
                _ =
                    println
                        ("[DB ERROR] Alerts." ++ label ++ ": "
                            ++ Error.toString e)
            in
                ()


createAlert : String -> String -> String -> String -> String -> String
createAlert metricId condition threshold notifyType notifyTarget =
    let
        alertId =
            String.slice
                0
                12
                (Crypto.sha256 (metricId ++ ":" ++ condition ++ ":" ++ threshold))
        alert =
            { id = alertId
            , metricId = metricId
            , condition = condition
            , threshold = threshold
            , notifyType = notifyType
            , notifyTarget = notifyTarget
            , enabled = 1
            , createdAt = ""
            }
        _ =
            reportWrite
                "createAlert"
                (Task.run (Store.upsert Database.conn Database.alertStore alert))
    in
        alertId


deleteAlert : String -> ()
deleteAlert alertId =
    let
        _ =
            reportWrite
                "deleteAlert"
                (Task.run
                    (Store.delete Database.conn Database.alertStore "id" alertId))
    in
        ()


getAlerts : () -> List Alert
getAlerts _ =
    Result.withDefault
        []
        (Task.run
            (Store.query Database.alertStore |> Store.orderDesc "createdAt"
                |> Store.toList Database.conn))


getAlertsForMetric : String -> List Alert
getAlertsForMetric metricId =
    Result.withDefault
        []
        (Task.run
            (Store.query Database.alertStore
                |> Store.where_ (Store.eq "metricId" (SqlString metricId))
                |> Store.orderDesc "createdAt"
                |> Store.toList Database.conn))


-- Check all alerts against current metric values and fire notifications
checkAlerts : List Alert -> List Metric -> ()
checkAlerts alerts metrics =
    case alerts of

        [] ->
            ()

        alert :: rest ->
            let
                _ = checkOneAlert alert metrics
            in
                checkAlerts rest metrics


checkOneAlert : Alert -> List Metric -> ()
checkOneAlert alert metrics =
    let
        metricId = alert.metricId
        condition = alert.condition
        threshold = alert.threshold
        enabled = alert.enabled
        metric = findMetricById metricId metrics
    in
        if enabled /= 1 then
            ()

        else
            checkAlertCondition alert metric condition threshold


checkAlertCondition : Alert -> Maybe Metric -> String -> String -> ()
checkAlertCondition alert maybeMetric condition threshold =
    case maybeMetric of

        Nothing ->
            ()

        Just metric ->
            let
                value = metric.lastValue
                triggered = evaluateCondition value condition threshold
            in
                if triggered then
                    fireAlert alert value

                else
                    ()


evaluateCondition : String -> String -> String -> Bool
evaluateCondition valueStr condition thresholdStr =
    let
        value = parseFloat valueStr
        threshold = parseFloat thresholdStr
    in
        if condition == ">" then
            value > threshold

        else if condition == "<" then
            value < threshold

        else if condition == ">=" then
            value >= threshold

        else if condition == "<=" then
            value <= threshold

        else if condition == "==" then
            value == threshold

        else if condition == "!=" then
            value /= threshold

        else if condition == "contains" then
            String.contains thresholdStr valueStr

        else if condition == "down" then
            valueStr == "down" || valueStr == "0"
                || String.startsWith "error" valueStr

        else
            False


fireAlert : Alert -> String -> ()
fireAlert alert currentValue =
    let
        alertId = alert.id
        notifyType = alert.notifyType
        notifyTarget = alert.notifyTarget
        metricId = alert.metricId
        condition = alert.condition
        threshold = alert.threshold
        message =
            "SkyMon Alert: metric " ++ metricId ++ " value " ++ currentValue
                ++ " "
                ++ condition
                ++ " "
                ++ threshold
        _ =
            recordAlertFired
                alertId
                metricId
                currentValue
                condition
                threshold
                notifyType
        _ = println ("[ALERT] " ++ message)
    in
        if notifyType == "webhook" then
            logFireResult
                "webhook"
                notifyTarget
                (fireWebhook notifyTarget message)

        else if notifyType == "slack" then
            logFireResult "slack" notifyTarget (fireSlack notifyTarget message)

        else
            ()
        -- Centralised delivery logging so every notify variant uses the same
        -- "[ALERT ERROR] kind target: typedErr" format.


logFireResult : String -> String -> Result Error () -> ()
logFireResult kind target result =
    case result of

        Ok _ ->
            ()

        Err e ->
            let
                _ =
                    println
                        ("[ALERT ERROR] " ++ kind ++ " " ++ target ++ ": "
                            ++ Error.toString e)
            in
                ()


recordAlertFired : String -> String -> String -> String -> String -> String -> ()
recordAlertFired alertId metricId value condition threshold notifyType =
    let
        event =
            { id = 0
            , alertId = alertId
            , metricId = metricId
            , metricValue = value
            , condition = condition
            , threshold = threshold
            , notifyType = notifyType
            , firedAt = ""
            }
        _ =
            reportWrite
                "recordAlertFired"
                (Task.run
                    (Store.insert Database.conn Database.alertHistoryStore event))
    in
        ()


getAlertHistory : Int -> List AlertEvent
getAlertHistory limit =
    Result.withDefault
        []
        (Task.run
            (Store.query Database.alertHistoryStore |> Store.orderDesc "firedAt"
                |> Store.limit limit
                |> Store.toList Database.conn))


getAlertHistoryForMetric : String -> Int -> List AlertEvent
getAlertHistoryForMetric metricId limit =
    Result.withDefault
        []
        (Task.run
            (Store.query Database.alertHistoryStore
                |> Store.where_ (Store.eq "metricId" (SqlString metricId))
                |> Store.orderDesc "firedAt"
                |> Store.limit limit
                |> Store.toList Database.conn))


-- fireWebhook / fireSlack now return `Result Error ()`. Empty URL is
-- Ok () (no-op is a success), transport failures are NetworkError.
fireWebhook : String -> String -> Result Error ()
fireWebhook url message =
    if String.isEmpty url then
        Ok ()

    else
        let
            body = "{\"text\":\"" ++ escapeJson message ++ "\"}"
        in
            case Task.run (Http.post url body) of

                Ok _ ->
                    Ok ()

                Err e ->
                    Err e


fireSlack : String -> String -> Result Error ()
fireSlack webhookUrl message =
    if String.isEmpty webhookUrl then
        Ok ()

    else
        let
            body = "{\"text\":\"" ++ escapeJson message ++ "\"}"
        in
            case Task.run (Http.post webhookUrl body) of

                Ok _ ->
                    Ok ()

                Err e ->
                    Err e


findMetricById : String -> List Metric -> Maybe Metric
findMetricById metricId metrics =
    case metrics of

        [] ->
            Nothing

        m :: rest ->
            if m.id == metricId then
                Just m

            else
                findMetricById metricId rest


escapeJson : String -> String
escapeJson s =
    String.replace "\"" "\\\"" (String.replace "\\" "\\\\" s)


parseFloat : String -> Float
parseFloat s =
    case String.toFloat s of

        Just f ->
            f

        Nothing ->
            0.0
