module Lib.Monitors exposing (..)

import Sky.Core.Prelude exposing (..)
import Sky.Core.List as List
import Sky.Core.String as String
import Sky.Core.Result as Result
import Sky.Core.Http as Http
import Sky.Core.Task as Task
import Sky.Core.Crypto as Crypto
import Std.Db exposing (SqlValue(..))
import Std.Db.Store as Store
import Std.Log exposing (println)
import Lib.Database as Db exposing (Monitor, MonitorSample)
import Sky.Core.Error as Error exposing (Error(..), ErrorKind(..))


reportWrite : String -> Result Error a -> ()
reportWrite label result =
    case result of

        Ok _ ->
            ()

        Err e ->
            let
                _ =
                    println
                        ("[DB ERROR] Monitors." ++ label ++ ": "
                            ++ Error.toString e)
            in
                ()


-- createMonitor : upsert by natural id (name+url hash) — re-creating the same
-- monitor updates it in place.
createMonitor : String -> String -> Int -> String -> String
createMonitor name url interval visibility =
    let
        monId = String.slice 0 12 (Crypto.sha256 (name ++ ":" ++ url))
        monitor =
            { id = monId
            , name = name
            , url = url
            , intervalSecs = interval
            , status = "unknown"
            , responseTime = 0
            , lastChecked = ""
            , visibility = visibility
            , createdAt = ""
            }
        _ =
            reportWrite
                "createMonitor"
                (Task.run (Store.upsert Db.conn Db.monitorStore monitor))
    in
        monId


deleteMonitor : String -> ()
deleteMonitor monId =
    let
        _ =
            reportWrite
                "deleteMonitor/history"
                (Task.run
                    (Store.deleteWhere
                        Db.conn
                        Db.monitorHistoryStore
                        (Store.eq "monitorId" (SqlString monId))))
        _ =
            reportWrite
                "deleteMonitor/row"
                (Task.run (Store.delete Db.conn Db.monitorStore "id" monId))
    in
        ()


getMonitors : List Monitor
getMonitors =
    Result.withDefault
        []
        (Task.run
            (Store.query Db.monitorStore |> Store.orderAsc "name"
                |> Store.toList Db.conn))


checkEndpoint : String -> ( String, Int )
checkEndpoint url =
    case Task.run (Http.get url) of

        Ok resp ->
            checkResponseStatus resp

        Err e ->
            let
                _ =
                    println
                        ("[MONITOR ERROR] checkEndpoint " ++ url ++ ": "
                            ++ Error.toString e)
            in
                ( "down", 0 )


checkResponseStatus resp =
    let
        status = resp.status
    in
        if status >= 200 && status < 400 then
            ( "healthy", 0 )

        else if status >= 400 && status < 500 then
            ( "degraded", 0 )

        else
            ( "down", 0 )


-- recordCheck : update the monitor's live status (read-modify-write; touchOnUpdate
-- bumps last_checked) + append a history sample.
recordCheck : String -> String -> Int -> ()
recordCheck monId status responseTime =
    let
        _ =
            case Task.run (Store.findBy Db.conn Db.monitorStore "id" monId) of

                Ok (Just mon) ->
                    reportWrite
                        "recordCheck/update"
                        (Task.run
                            (Store.update
                                Db.conn
                                Db.monitorStore
                                { mon | status = status
                                , responseTime = responseTime
                                }))

                _ ->
                    ()
        sample =
            { id = 0
            , monitorId = monId
            , status = status
            , responseTime = responseTime
            , checkedAt = ""
            }
        _ =
            reportWrite
                "recordCheck/history"
                (Task.run (Store.insert Db.conn Db.monitorHistoryStore sample))
    in
        ()


getMonitorHistory : String -> Int -> List MonitorSample
getMonitorHistory monId limit =
    Result.withDefault
        []
        (Task.run
            (Store.query Db.monitorHistoryStore
                |> Store.where_ (Store.eq "monitorId" (SqlString monId))
                |> Store.orderDesc "checkedAt"
                |> Store.limit limit
                |> Store.toList Db.conn))
