module Lib.Schema exposing (initDb)

import Sky.Core.Prelude exposing (..)
import Sky.Core.Task as Task
import Std.Db.Store as Store
import Std.Log exposing (println)
import Sky.Core.Error as Error exposing (Error)
import Lib.Database as Db


runInit label result =
    case result of

        Ok _ ->
            ()

        Err e ->
            let
                _ =
                    println
                        ("[SCHEMA ERROR] " ++ label ++ ": " ++ Error.toString e)
            in
                ()


-- Schema derived from the codecs — one `Store.create` per store (TEXT/serial PKs,
-- DEFAULTs, timestamps). Time-series tables (metric/monitor/alert history) use a
-- serial id + defaultNow.
initDb =
    let
        _ =
            runInit "monitors" (Task.run (Store.create Db.conn Db.monitorStore))
        _ =
            runInit "metrics" (Task.run (Store.create Db.conn Db.metricStore))
        _ = runInit "alerts" (Task.run (Store.create Db.conn Db.alertStore))
        _ =
            runInit "sessions" (Task.run (Store.create Db.conn Db.sessionStore))
        _ =
            runInit
                "metric_history"
                (Task.run (Store.create Db.conn Db.metricHistoryStore))
        _ =
            runInit
                "monitor_history"
                (Task.run (Store.create Db.conn Db.monitorHistoryStore))
        _ =
            runInit
                "alert_history"
                (Task.run (Store.create Db.conn Db.alertHistoryStore))
    in
        ()
