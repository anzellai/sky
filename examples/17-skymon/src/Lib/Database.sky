module Lib.Database exposing
    ( conn
    , Monitor
    , Metric
    , Alert
    , Session
    , MetricSample
    , MonitorSample
    , AlertEvent
    , monitorStore
    , metricStore
    , alertStore
    , sessionStore
    , metricHistoryStore
    , monitorHistoryStore
    , alertHistoryStore
    )

import Sky.Core.Prelude exposing (..)
import Sky.Core.System as System
import Sky.Core.Task as Task
import Std.Codec as Codec exposing (Codec)
import Std.Db as Db
import Std.Db.Store as Store exposing (Store)
import Std.Log exposing (println)
import Sky.Core.Error as Error exposing (Error)


-- One memoised connection shared by every Store op (reads SKY_DB_PATH).
conn =
    case Task.run (Db.connect ()) of

        Ok c ->
            c

        Err e ->
            let
                _ =
                    println
                        ("[FATAL] Cannot open the database: " ++ Error.toString e)
            in
                System.exit 1

-- ── Config rows (natural/app TEXT ids → upsert; numeric fields typed) ──
type alias Monitor =
    { id : String
    , name : String
    , url : String
    , intervalSecs : Int
    , status : String
    , responseTime : Int
    , lastChecked : String
    , visibility : String
    , createdAt : String
    }

type alias Metric =
    { id : String
    , name : String
    , sourceType : String
    , configJson : String
    , lastValue : String
    , lastUpdated : String
    , visibility : String
    , createdAt : String
    }

type alias Alert =
    { id : String
    , metricId : String
    , condition : String
    , threshold : String
    , notifyType : String
    , notifyTarget : String
    , enabled : Int
    , createdAt : String
    }

type alias Session =
    { id : String
    , username : String
    , avatarUrl : String
    , role : String
    , createdAt : String
    }

-- ── Time-series rows (serial id → insert / insertMany) ──────────────
type alias MetricSample =
    { id : Int
    , metricId : String
    , value : String
    , recordedAt : String
    }

type alias MonitorSample =
    { id : Int
    , monitorId : String
    , status : String
    , responseTime : Int
    , checkedAt : String
    }

type alias AlertEvent =
    { id : Int
    , alertId : String
    , metricId : String
    , metricValue : String
    , condition : String
    , threshold : String
    , notifyType : String
    , firedAt : String
    }


-- ── Stores ──────────────────────────────────────────────────────────
monitorStore : Store Monitor
monitorStore =
    Store.fromCodec
        "monitors"
        (Codec.auto
            { id = ""
            , name = ""
            , url = ""
            , intervalSecs = 30
            , status = "unknown"
            , responseTime = 0
            , lastChecked = ""
            , visibility = "user"
            , createdAt = ""
            })
        |> Store.primaryKey "id"
        |> Store.defaultInt "intervalSecs" 30
        |> Store.defaultNow "createdAt"
        |> Store.touchOnUpdate "lastChecked"


metricStore : Store Metric
metricStore =
    Store.fromCodec
        "metrics"
        (Codec.auto
            { id = ""
            , name = ""
            , sourceType = ""
            , configJson = "{}"
            , lastValue = ""
            , lastUpdated = ""
            , visibility = "user"
            , createdAt = ""
            })
        |> Store.primaryKey "id"
        |> Store.defaultNow "createdAt"
        |> Store.touchOnUpdate "lastUpdated"


alertStore : Store Alert
alertStore =
    Store.fromCodec
        "alerts"
        (Codec.auto
            { id = ""
            , metricId = ""
            , condition = ""
            , threshold = ""
            , notifyType = "webhook"
            , notifyTarget = ""
            , enabled = 1
            , createdAt = ""
            })
        |> Store.primaryKey "id"
        |> Store.defaultInt "enabled" 1
        |> Store.defaultNow "createdAt"


sessionStore : Store Session
sessionStore =
    Store.fromCodec
        "sessions"
        (Codec.auto
            { id = ""
            , username = ""
            , avatarUrl = ""
            , role = "user"
            , createdAt = ""
            })
        |> Store.primaryKey "id"
        |> Store.defaultNow "createdAt"


metricHistoryStore : Store MetricSample
metricHistoryStore =
    Store.fromCodec
        "metric_history"
        (Codec.auto { id = 0, metricId = "", value = "", recordedAt = "" })
        |> Store.serial "id"
        |> Store.defaultNow "recordedAt"


monitorHistoryStore : Store MonitorSample
monitorHistoryStore =
    Store.fromCodec
        "monitor_history"
        (Codec.auto
            { id = 0
            , monitorId = ""
            , status = ""
            , responseTime = 0
            , checkedAt = ""
            })
        |> Store.serial "id"
        |> Store.defaultNow "checkedAt"


alertHistoryStore : Store AlertEvent
alertHistoryStore =
    Store.fromCodec
        "alert_history"
        (Codec.auto
            { id = 0
            , alertId = ""
            , metricId = ""
            , metricValue = ""
            , condition = ""
            , threshold = ""
            , notifyType = ""
            , firedAt = ""
            })
        |> Store.serial "id"
        |> Store.defaultNow "firedAt"
