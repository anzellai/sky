module Main exposing (main)

-- examples/39-hub-demo / frontend-app — sibling of billing-app in
-- the same tenant (customer-42-*).  See ../billing-app/src/Main.sky
-- for the full convention writeup.
--
-- Service-name: `customer-42-frontend`.  Behaviour: tick every 2 s
-- (faster than billing so both apps' sparklines show on the hub
-- Overview), emit a page-view log line carrying a path and a
-- pseudo-random session id.
import Sky.Core.Prelude exposing (..)
import Sky.Core.Random as Random
import Sky.Core.Task as Task
import Std.Cmd as Cmd
import Std.Html exposing (..)
import Std.Html.Attributes exposing (..)
import Std.Live exposing (app, route)
import Std.Log as Log
import Std.Sub as Sub

type Page
    = HomePage

type Msg
    = Tick
    | EmittedLog (Result Error String)

type alias Model =
    { tickCount : Int
    , lastPath : String
    }


init : a -> ( Model, Cmd Msg )
init _req =
    ( { tickCount = 0, lastPath = "" }, Cmd.none )


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of

        Tick ->
            ( { model | tickCount = model.tickCount + 1 }
            , Cmd.perform (emitPageviewLog model.tickCount) EmittedLog
            )

        EmittedLog (Ok path) ->
            ( { model | lastPath = path }, Cmd.none )

        EmittedLog (Err _) ->
            ( model, Cmd.none )


emitPageviewLog : Int -> Task Error String
emitPageviewLog seq =
    let
        paths =
            [ "/", "/products", "/cart", "/checkout", "/account", "/help" ]
        pick = modBy 6 seq
    in
        Random.range 1000 9999
            |> Task.andThen
                   (\sid ->
                       let
                           path =
                               case List.drop pick paths of

                                   p :: _ ->
                                       p

                                   _ ->
                                       "/"
                       in
                           Log.infoWith
                               "frontend.pageview"
                               [ "request_id"
                               , "req-" ++ String.fromInt seq
                               , "path"
                               , path
                               , "session_id"
                               , "sess-" ++ String.fromInt sid
                               , "user_agent"
                               , "Mozilla/5.0 (Sky.Live)"
                               ]
                               |> Task.map (\_ -> path))


view : Model -> Html Msg
view model =
    div
        [style "font-family: system-ui, sans-serif; padding: 24px"]
        [ h1 [] [text "customer-42 / frontend-app"]
        , p [] [text "Sky.Live app pushing telemetry to the hub."]
        , p [] [ text "Ticks: ", text (String.fromInt model.tickCount) ]
        , p [] [ text "Last pageview path: ", text model.lastPath ]
        , p
              [style "color: #888"]
              [ text "Open the hub at "
              , a
                    [href "http://localhost:8025/"]
                    [text "http://localhost:8025/"]
              , text " to see this app's logs alongside the billing-app."
              ]
        ]


subscriptions : Model -> Sub Msg
subscriptions _model =
    Sub.every 2000 Tick


main =
    app
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        , routes = [route "/" HomePage]
        , notFound = HomePage
        }
