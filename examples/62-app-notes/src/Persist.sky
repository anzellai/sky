module Persist exposing (loadNotes, createNote, updateNote, deleteNote)

-- The EFFECTFUL persistence layer — every def here reaches a `Db_*` kernel, so
-- the auto-split marks the WHOLE module server-tainted and routes it to the
-- backend ONLY (docs/skyspa/auto-split.md §17). It is never emitted into the
-- wasm frontend and never imported by it, so no database handle, connection
-- string, or store ever reaches the browser — the security spine of the split.
--
-- The four exported helpers are the effect surface the entry module's server
-- branches call. Each answers with the FULL authoritative list, freshly re-read
-- from the store, so the client replaces its cached projection wholesale.
--
-- SECURITY: the client is untrusted. `sanitize` trims + clamps every title
-- server-side; the store assigns ids (a serial PK), so a client-sent id or an
-- oversized title can never dictate durable state.

import Sky.Core.Prelude exposing (..)
import Sky.Core.Task as Task
import Sky.Core.String as String
import Sky.Core.System as System
import Sky.Core.Error as Error exposing (Error)
import Std.Log exposing (println)
import Std.Codec as Codec
import Std.Db as Db exposing (Db)
import Std.Db.Store as Store exposing (Store)
import Domain exposing (Note)


-- `Codec.auto` reflects the record into columns (id, title, body);
-- `Store.serial "id"` makes id an auto-increment PK the DATABASE fills, so
-- `insert` omits it and a client-sent id is structurally impossible to honour.
notesStore : Store Note
notesStore =
    Store.fromCodec "notes" (Codec.auto { id = 0, title = "", body = "" })
        |> Store.serial "id"


-- A memoised CAF: `Db.connect ()` opens exactly one shared pool for the whole
-- process, and — the first time it is forced — creates the `notes` table
-- (idempotent), so the generated backend needs no separate boot step.
dbConn : Db
dbConn =
    case Task.run (Db.connect ()) of

        Ok c ->
            let
                _ = Task.run (Store.create c notesStore)
            in
                c

        Err e ->
            let
                _ =
                    println
                        ("[FATAL] spa-notes: cannot open db: "
                            ++ Error.toString e)
            in
                System.exit 1


-- Server-side validation: trim + clamp. The server never stores a client string
-- verbatim.
sanitize : String -> String
sanitize raw =
    String.left 120 (String.trim raw)


-- Re-read the authoritative, ordered list from the store.
loadNotes : () -> List Note
loadNotes _ =
    case Task.run
             (Store.query notesStore |> Store.orderAsc "id"
                 |> Store.toList dbConn) of

        Ok rows ->
            rows

        Err _ ->
            []


-- Insert a new note from the drafts; answer with the fresh list.
createNote : String -> String -> List Note
createNote title body =
    let
        _ =
            Task.run
                (Store.insert
                    dbConn
                    notesStore
                    { id = 0, title = sanitize title, body = body })
    in
        loadNotes ()


-- Update the note with the given id; answer with the fresh list.
updateNote : Int -> String -> String -> List Note
updateNote id title body =
    let
        _ =
            Task.run
                (Store.update
                    dbConn
                    notesStore
                    { id = id, title = sanitize title, body = body })
    in
        loadNotes ()


-- Delete the note with the given id; answer with the fresh list.
deleteNote : Int -> List Note
deleteNote id =
    let
        _ =
            Task.run (Store.delete dbConn notesStore "id" (String.fromInt id))
    in
        loadNotes ()
