module Main exposing (main)

-- 07-todo-cli: A TODO app with SQLite persistence using Std.Db.Store.
--
-- Usage:
--   ./app add "Buy groceries"     Add a new todo
--   ./app list                    List all todos
--   ./app done 1                  Mark todo #1 as done
--   ./app undone 1                Mark todo #1 as not done
--   ./app remove 1                Delete todo #1
--   ./app clear                   Remove all completed todos
--
-- This example demonstrates the codec-driven persistence layer
-- (Std.Codec + Std.Db.Store): ONE `Codec Todo` drives the schema,
-- the writes, and the reads — no hand-written SQL, no stringly-typed
-- `Db.getField` row access. The table is a typed `Store Todo`; every
-- op returns `Task Error a` and failures propagate to the top-level
-- reporter which prints to stderr and `System.exit 1`s.

import Sky.Core.Prelude exposing (..)
import Sky.Core.List as List
import Sky.Core.Maybe as Maybe
import Sky.Core.String as String
import Sky.Core.Task as Task
import Std.Codec as Codec exposing (Codec)
import Std.Db as Db exposing (SqlValue(..))
import Std.Db.Store as Store exposing (Store)
import Sky.Core.Error as Error exposing (Error)
import System
import Std.Log exposing (println)

-- A todo row. `id` is a DB-assigned auto-increment key (Store.serial),
-- `done` is 0/1 (SQLite has no native bool for this legacy shape).
type alias Todo =
    { id : Int
    , title : String
    , done : Int
    }


-- ONE codec derives everything. `Codec.auto` reflects the record's
-- fields into snake_case columns (id, title, done); `Store.serial "id"`
-- marks the integer PK auto-increment so `insert` omits it.
todos : Store Todo
todos =
    Store.fromCodec "todos" (Codec.auto { id = 0, title = "", done = 0 })
        |> Store.serial "id"


-- Top-level pipeline:
--   1. Open the DB (Task Error Db).
--   2. Hand the conn to runApp which runs the user's chosen command.
--   3. Anything that fails along the way lands in reportError, which
--      writes a human-readable message and exits non-zero.
main =
    let
        pipeline =
            Db.connect () |> Task.andThen runApp |> Task.onError reportError
        _ = Task.run pipeline
    in
        ()


runApp : Db -> Task Error ()
runApp conn =
    Store.create conn todos
        |> Task.andThen
               (\_ ->
                   let
                       userArgs =
                           System.args () |> Task.run |> Result.withDefault []
                       cmd = getArg userArgs
                       cmdArg = getArg (List.drop 1 userArgs)
                   in
                       runCommand conn cmd cmdArg)


-- Top-level error reporter for the CLI. Prints the user-facing
-- message to stderr (via Slog so it's structured for log scrapers
-- too) then exits non-zero so shell wrappers (`./app foo && next`)
-- see the failure.
reportError : Error -> Task Error ()
reportError e =
    let
        _ = Log.errorWith "todo-cli" [ "error", Error.toString e ]
        _ = println ("Error: " ++ Error.toString e)
    in
        System.exit 1


addTodo : Db -> String -> Task Error ()
addTodo conn todoTitle =
    Store.insert conn todos { id = 0, title = todoTitle, done = 0 }
        |> Task.map
               (\_ ->
                   let
                       _ = Log.infoWith "Action" [ "Added:", todoTitle ]
                       _ = println ("Added: " ++ todoTitle)
                   in
                       ())


listTodos : Db -> Task Error ()
listTodos conn =
    Store.query todos |> Store.orderAsc "id" |> Store.toList conn
        |> Task.map
               (\rows ->
                   if List.isEmpty rows then
                       let
                           _ =
                               println
                                   "No todos yet. Add one with: ./app add \"My task\""
                       in
                           ()

                   else
                       let
                           _ = println "Your TODOs:"
                           lines = List.map formatTodo rows
                           _ = println (String.join "\n" lines)
                           _ = println ""
                       in
                           ())


formatTodo : Todo -> String
formatTodo todo =
    let
        status =
            if todo.done == 1 then
                "[x]"

            else
                "[ ]"
    in
        "  " ++ String.fromInt todo.id ++ ". " ++ status ++ " " ++ todo.title


-- Read-modify-write: fetch the row by id, flip `done`, write it back
-- through the codec. `Store.update` keys on the PK and never touches
-- the auto-increment column.
setDone : Db -> String -> Int -> String -> Task Error ()
setDone conn idStr doneVal okMsg =
    Store.findBy conn todos "id" idStr
        |> Task.andThen
               (\found ->
                   case found of

                       Just todo ->
                           Store.update conn todos { todo | done = doneVal }
                               |> Task.map
                                      (\_ ->
                                          let
                                              _ = println okMsg
                                          in
                                              ())

                       Nothing ->
                           let
                               _ = println ("No todo with id " ++ idStr)
                           in
                               Task.succeed ())


markDone : Db -> String -> Task Error ()
markDone conn idStr =
    setDone conn idStr 1 ("Marked as done: " ++ idStr)


markUndone : Db -> String -> Task Error ()
markUndone conn idStr =
    setDone conn idStr 0 ("Marked as not done: " ++ idStr)


removeTodo : Db -> String -> Task Error ()
removeTodo conn idStr =
    Store.delete conn todos "id" idStr
        |> Task.map
               (\_ ->
                   let
                       _ = println ("Removed todo: " ++ idStr)
                   in
                       ())


clearDone : Db -> Task Error ()
clearDone conn =
    Store.deleteWhere conn todos (Store.eq "done" (SqlInt 1))
        |> Task.map
               (\_ ->
                   let
                       _ = println "Cleared completed todos"
                   in
                       ())


showUsage : Task Error ()
showUsage =
    let
        _ = Log.info "Sky TODO - A simple todo manager"
        _ = println ""
        _ = println "Usage:"
        _ = println "  ./app add <title>     Add a new todo"
        _ = println "  ./app list            List all todos"
        _ = println "  ./app done <id>       Mark a todo as done"
        _ = println "  ./app undone <id>     Mark a todo as not done"
        _ = println "  ./app remove <id>     Delete a todo"
        _ = println "  ./app clear           Remove all completed todos"
        _ = println ""
    in
        Task.succeed ()


getArg argList =
    Maybe.withDefault "" (List.head argList)


runCommand : Db -> String -> String -> Task Error ()
runCommand conn cmd cmdArg =
    case cmd of

        "add" ->
            if cmdArg == "" then
                let
                    _ = println "Usage: ./app add <title>"
                in
                    Task.succeed ()

            else
                addTodo conn cmdArg

        "list" ->
            listTodos conn

        "done" ->
            if cmdArg == "" then
                let
                    _ = println "Usage: ./app done <id>"
                in
                    Task.succeed ()

            else
                markDone conn cmdArg

        "undone" ->
            if cmdArg == "" then
                let
                    _ = println "Usage: ./app undone <id>"
                in
                    Task.succeed ()

            else
                markUndone conn cmdArg

        "remove" ->
            if cmdArg == "" then
                let
                    _ = println "Usage: ./app remove <id>"
                in
                    Task.succeed ()

            else
                removeTodo conn cmdArg

        "clear" ->
            clearDone conn

        "help" ->
            showUsage

        _ ->
            showUsage
