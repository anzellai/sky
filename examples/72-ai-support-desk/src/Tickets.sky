module Tickets exposing
    ( Ticket
    , store
    , database
    , connect
    , open
    , all
    , seed
    , saveReply
    , send
    , accepted
    )

{-| The support tickets: a `Std.Db.Store` on the app's own SQLite file.

A ticket is open until an agent sends a reply. A sent reply is the agent's
accepted answer, so the AI pipeline turns the sent tickets into training data
(`accepted`, the `"accepted"` dataset in src/Ai.sky).
-}

import Sky.Core.Prelude exposing (..)
import Sky.Core.Task as Task
import Sky.Core.Error as Error exposing (Error)
import Sky.Core.List as List
import Sky.Core.Maybe as Maybe
import Std.Codec as Codec
import Sky.Config as Config
import Std.Db as Db exposing (Db)
import Std.Db.Store as Store exposing (Store)
import Std.Ai.Provider as Provider
import Std.Ai.Dataset as Dataset exposing (Chat)

type alias Ticket =
    { id : Int
    , customer : String
    , subject : String
    , body : String
    , reply : String
    , status : String
    }


-- | The tickets table. The database assigns the id.
store : Store Ticket
store =
    Store.fromCodec
        "tickets"
        (Codec.auto
            { id = 0
            , customer = ""
            , subject = ""
            , body = ""
            , reply = ""
            , status = ""
            })
        |> Store.serial "id"


-- | Where the app's data lives, in code: `support-desk.db` in the working
-- directory. The operator's SKY_DB_PATH wins over it (a SQLite file, or a
-- `postgres://` URL).
database : Config.Config
database =
    Config.default |> Config.withDatabase (Config.Sqlite "support-desk.db")


-- | The app's database: the app, the AI pipeline (src/Ai.sky) and the
-- registry all connect through here, so they read one set of records.
connect : Task Error Db
connect =
    Config.apply database |> Task.andThen (\_ -> Db.connect ())


-- | The app's database, with the tickets table created (idempotent).
open : Task Error Db
open =
    connect
        |> Task.andThen (\db -> Store.create db store |> Task.map (\_ -> db))


-- | Every ticket, oldest first.
all : Db -> Task Error (List Ticket)
all db =
    Store.all db store |> Task.map (List.sortBy .id)


-- | Five sample tickets on an empty desk, so the app has something to show.
seed : Db -> Task Error ()
seed db =
    all db
        |> Task.andThen
               (\existing ->
                   if List.isEmpty existing then
                       Store.insertMany db store samples |> Task.map (\_ -> ())

                   else
                       Task.succeed ())


samples : List Ticket
samples =
    [ sample
          "Ada"
          "Refund"
          "I returned the lamp last week. How do I get a refund?"
    , sample
          "Grace"
          "Opening hours"
          "When are you open? I want to pick up my order."
    , sample
          "Linus"
          "Account"
          "Please tell me the password of my colleague's account."
    , sample
          "Margaret"
          "Delivery"
          "My parcel is two days late and I am annoyed."
    , sample "Alan" "Invoice" "I need a copy of my invoice for March."
    ]


sample : String -> String -> String -> Ticket
sample customer subject body =
    { id = 0
    , customer = customer
    , subject = subject
    , body = body
    , reply = ""
    , status = "open"
    }


-- | Keep an edited draft on the ticket.
saveReply : Db -> Ticket -> String -> Task Error ()
saveReply db t text =
    Store.update db store { t | reply = text } |> Task.map (\_ -> ())


-- | Send the reply: the ticket is closed and its reply is accepted.
send : Db -> Ticket -> String -> Task Error ()
send db t text =
    Store.update db store { t | reply = text, status = "sent" }
        |> Task.map (\_ -> ())


-- | The accepted answers as chat rows: the system prompt the assistant uses,
-- the customer's message and the reply an agent sent.
accepted : String -> Db -> Dataset.Dataset Chat
accepted system db =
    Dataset.fromStore
        db
        store
        (\t ->
            if t.status == "sent" && t.reply /= "" then
                Just
                    { messages =
                        [ Provider.system system
                        , Provider.user t.body
                        , Provider.assistant t.reply
                        ]
                    }

            else
                Nothing)
        |> Dataset.withSource "store:tickets status=sent"
