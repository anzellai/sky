module Data exposing (generator, rubric, support, accepted, userText)

{-| The support desk's training data, in two datasets.

`support` is synthetic: a teacher model writes questions and answers for each
topic and customer, a judge keeps the answers that meet the rubric, and the
rows are scrubbed (e-mail addresses, phone and card numbers, secrets),
deduped and split by a hash of the question, so a question stays in the same
split in every version. `sky ai data freeze support` freezes it into a
content-addressed version and registers it as `support@<n>`.

`accepted` is the replies agents sent from the app, as chat rows: real data,
recorded with its consent basis and retention period.

Both teacher and judge calls go through a journal in the app's database
(`Synthetic.withJournal`): freezing again with unchanged inputs makes no model
call and gives the same digest.
-}

import Sky.Core.Prelude exposing (..)
import Sky.Core.Task as Task
import Sky.Core.Error exposing (Error)
import Sky.Core.List as List
import Sky.Core.String as String
import Sky.Core.Maybe as Maybe
import Std.Db.Store as Store
import Std.Ai.Provider as Provider
import Std.Ai.Eval as Eval
import Std.Ai.Dataset as Dataset exposing (Chat, Instruction)
import Std.Ai.Dataset.Scrub as Scrub
import Std.Ai.Dataset.Synthetic as Synthetic
import Std.Ai.Pipeline as Pipeline
import Assist
import Tickets


-- | What the judge keeps.
rubric : String
rubric =
    "The answer is correct for an online shop, polite, and tells the customer what to do next."


-- | The teacher's plan: three topics for two kinds of customer, three rows a
-- call, six rows kept.
generator : Synthetic.Generator Instruction
generator =
    Synthetic.generator "support" Dataset.instructionCodec
        |> Synthetic.withTopics [ "refunds", "opening hours", "delivery" ]
        |> Synthetic.withPersonas
               [ "a first-time customer", "a busy shop owner" ]
        |> Synthetic.withExamples
               [ { prompt = "Can I change my delivery address?"
                 , completion =
                     "Yes. Open your order, choose Change address and save it before the parcel ships."
                 }
               ]
        |> Synthetic.withPerCall 3
        |> Synthetic.withTarget 6
        |> Synthetic.withSeed 11
        |> Synthetic.withMaxCalls 9
        |> Synthetic.withDedupe (\r -> String.toLower (String.trim r.prompt))
        |> Synthetic.withFilter
               "answer too short"
               (\r -> String.length r.completion >= 30)
        |> Synthetic.withJudge
               Eval.defaultJudge
               rubric
               (\r -> ( r.prompt, r.completion ))


-- | The user's message of a chat row: its split key.
userText : Chat -> String
userText c =
    c.messages |> List.filter (\m -> m.role == "user") |> List.head
        |> Maybe.map .content
        |> Maybe.withDefault ""


-- | The synthetic dataset, journalled in the pipeline's database.
support : Pipeline.Context -> Task Error (Dataset.Splits Chat)
support ctx =
    Synthetic.run (generator |> Synthetic.withJournal ctx.db)
        |> Task.map
               (\gen ->
                   Synthetic.toDataset gen
                       |> Dataset.scrub (Scrub.forInstruction Scrub.defaults)
                       |> Dataset.dedupeBy (\r -> String.toLower r.prompt)
                       |> Dataset.toChat
                              (\r ->
                                  { messages =
                                      Assist.messagesFor r.prompt
                                          ++ [ Provider.assistant r.completion ]
                                  })
                       |> Dataset.split Dataset.defaultSplit userText)


-- | The replies agents accepted in the app.
accepted : Pipeline.Context -> Task Error (Dataset.Splits Chat)
accepted ctx =
    Store.create ctx.db Tickets.store
        |> Task.map
               (\_ ->
                   Tickets.accepted Assist.systemPrompt ctx.db
                       |> Dataset.scrub (Scrub.forChat Scrub.defaults)
                       |> Dataset.dedupeBy userText
                       |> Dataset.split Dataset.defaultSplit userText)
