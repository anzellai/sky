# SkyShop Environment Configuration
ENV=local
DOMAIN=localhost
SKY_LIVE_PORT=4000

# Stripe
# STRIPE_API_KEY is read by src/Lib/Stripe.sky:48; DOMAIN above by :60.
# STRIPE_WEBHOOK_SECRET was scaffolded here and REMOVED: this example has no
# webhook route at all (repo-wide grep for "webhook" found only this file), so
# there was nothing for the value to verify a signature against.
STRIPE_API_KEY=sk_test_your_stripe_key_here

# Admin emails (comma-separated) — read by src/Lib/Auth.sky:29
ADMIN_EMAILS=admin@example.com

# Email notifications
# src/Lib/Notify.sky reads exactly these two (:68, :70) and uses them as a
# PRESENCE check: with both set it logs "[NOTIFY] Would send email to …" and
# marks the notification sent. It opens no SMTP connection.
# SMTP_PORT / SMTP_USER / SMTP_PASS were scaffolded here and REMOVED — nothing
# in the repo read them, and there is no transport for them to configure. If
# this example ever grows a real sender, they come back with the code.
SMTP_HOST=smtp.gmail.com
NOTIFY_TO=admin@example.com

# Session
# These mirror sky.toml's [live] store / storePath. Env wins over sky.toml,
# so setting them here overrides the file; omit them to use sky.toml's values.
# Without either, the session store falls back to memory — every session is
# lost on restart.
SKY_LIVE_STORE=sqlite
SKY_LIVE_STORE_PATH=skyshop_sessions.db
SKY_LIVE_TTL=86400

# Static files
SKY_LIVE_STATIC_DIR=static
