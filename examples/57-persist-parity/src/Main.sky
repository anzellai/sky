-- | Std.Persist SQL≡KV parity gate (BlueDB Phase 3c, docs/bluedb/phase3-api-design.md §8).
--
-- The SAME `Collection` + `Cond`/`Query`/CRUD source runs on BOTH backends —
-- `connectKeyValue` (the embedded BlueDB engine) and `connectRelational` (SQLite
-- or Postgres) — and asserts the results are byte-identical on the FORCED-
-- SEMANTICS SUBSET (§0.6): equality, non-null AND nullable `ORDER BY` (forced
-- NULLS FIRST), integer ranges over DISCRIMINATING values (2/10/42/100 — lexical
-- ≠ numeric, so a text-vs-numeric collation bug is visible), `inList`,
-- `isNull`/`isNotNull` over a nullable column, ASCII case-insensitive `LIKE`
-- under the forced collation, count, and insert. A single logical query renders
-- to ONE semantics on both backends (dialect-aware renderer + the mirroring
-- embedded `bluedbEvalCond`).
--
-- ASCII-LIKE SCOPE (F3): the forced `LIKE` collation is case-insensitive for
-- ASCII ONLY. Non-ASCII case-folding is OUT of the forced subset and is
-- backend-specific (Postgres `ILIKE` unicode-folds `É`↔`é`; SQLite's LIKE and
-- the embedded `likeMatch` do NOT). The seed here is ASCII, so the three
-- backends agree; a non-ASCII `LIKE` is deliberately not part of the parity
-- contract. See phase3-status.md §"F3".
--
-- FAIL-CLOSED (F1): a KV≠SQL divergence — or ANY error — prints `PARITY FAIL`
-- and exits NON-ZERO via `System.exit 1` (a bare `Task.fail` at `main` is
-- swallowed by the runtime's `rt.AnyTaskRun` and would exit 0). `run.sh`
-- additionally asserts `PARITY PASS` is present AND the exit code is 0.
module Main exposing (main)

import Sky.Core.Prelude exposing (..)
import Sky.Core.Task as Task exposing (Task)
import Sky.Core.Error as Error exposing (Error)
import Sky.Core.List as List
import Sky.Core.String as String
import Sky.Core.System as System
import Std.Log exposing (println)
import Std.Persist as P
import Std.Codec as Codec exposing (Codec)

type alias Person =
    { id : String
    , name : String
    , age : Int
    , active : Bool
    , city : String
    , nickname : Maybe String
    }


blankPerson : Person
blankPerson =
    { id = ""
    , name = ""
    , age = 0
    , active = False
    , city = ""
    , nickname = Nothing
    }


personCodec : Codec Person
personCodec =
    Codec.auto blankPerson


people : P.Collection Person
people =
    P.collection "people" personCodec |> P.key "id" |> P.index "age"


-- Ages 2/10/42/100 are DISCRIMINATING (F5): lexical order ("10","100","2","42")
-- differs from numeric (2,10,42,100), so an int ORDER BY / range surfaces a
-- text-vs-numeric collation bug. `nickname` is nullable (F4): Bob + Dan are NULL.
seed : List Person
seed =
    [ { id = "1"
      , name = "Alice"
      , age = 2
      , active = True
      , city = "London"
      , nickname = Just "Ally"
      }
    , { id = "2"
      , name = "Bob"
      , age = 100
      , active = False
      , city = "Boston"
      , nickname = Nothing
      }
    , { id = "3"
      , name = "Cara"
      , age = 10
      , active = True
      , city = "Berlin"
      , nickname = Just "C"
      }
    , { id = "4"
      , name = "Dan"
      , age = 42
      , active = False
      , city = "Boston"
      , nickname = Nothing
      }
    ]


-- ── The probe matrix (the documented forced-semantics subset, §0.6/§8) ────────
probes : P.Conn cap -> List (Task Error String)
probes conn =
    [ namesWhere
          conn
          "eq+orderAsc(name)"
          (P.query people |> P.where_ (P.eq "active" (P.bool True))
              |> P.orderAsc "name")
    , namesWhere conn "int-order(age)" (P.query people |> P.orderAsc "age")
    , namesWhere
          conn
          "int-range(10<=age<=100)+orderAsc(age)"
          (P.query people |> P.where_ (P.gte "age" (P.int 10))
              |> P.where_ (P.lte "age" (P.int 100))
              |> P.orderAsc "age")
    , namesWhere
          conn
          "inList(city)+orderAsc(name)"
          (P.query people
              |> P.where_
                     (P.inList "city" [ P.string "Boston", P.string "Berlin" ])
              |> P.orderAsc "name")
    , namesWhere
          conn
          "like(name %A%, ASCII case-insensitive)+orderAsc(name)"
          (P.query people |> P.where_ (P.like "name" "%A%") |> P.orderAsc "name")
    , namesWhere
          conn
          "isNull(nickname)+orderAsc(name)"
          (P.query people |> P.where_ (P.isNull "nickname") |> P.orderAsc "name")
    , namesWhere
          conn
          "notNull(nickname)+orderAsc(name)"
          (P.query people |> P.where_ (P.notNull "nickname") |> P.orderAsc "name")
    , namesWhere
          conn
          "orderAsc(nickname NULLS FIRST)+orderAsc(name)"
          (P.query people |> P.orderAsc "nickname" |> P.orderAsc "name")
    , namesWhere
          conn
          "or_(age>50 | city=Berlin)+orderDesc(age)"
          (P.query people
              |> P.where_
                     (P.or_
                         [ P.gt "age" (P.int 50)
                         , P.eq "city" (P.string "Berlin")
                         ])
              |> P.orderDesc "age")
    , countProbe
          conn
          "count(active)"
          (P.query people |> P.where_ (P.eq "active" (P.bool True)))
    ]


namesWhere : P.Conn cap -> String -> P.Query Person -> Task Error String
namesWhere conn label q =
    P.toList conn q
        |> Task.map
               (\rows -> label ++ " => " ++ String.join "," (List.map .name rows))


countProbe : P.Conn cap -> String -> P.Query Person -> Task Error String
countProbe conn label q =
    P.toCount conn q |> Task.map (\n -> label ++ " => " ++ String.fromInt n)


insertAll : P.Conn cap -> List Person -> Task Error ()
insertAll conn ps =
    case ps of

        [] ->
            Task.succeed ()

        x :: rest ->
            P.insert conn people x |> Task.andThen (\_ -> insertAll conn rest)


runBackend : P.Conn cap -> Task Error (List String)
runBackend conn =
    insertAll conn seed |> Task.andThen (\_ -> Task.sequence (probes conn))


printLines : List String -> ()
printLines lines =
    case lines of

        [] ->
            ()

        x :: rest ->
            let
                _ = println x
            in
                printLines rest


runParity : Task Error ()
runParity =
    P.connectKeyValue "data/kv"
        |> Task.andThen
               (\kv ->
                   P.connectRelational ()
                       |> Task.andThen
                              (\sql ->
                                  runBackend kv
                                      |> Task.andThen
                                             (\kvOut ->
                                                 runBackend sql
                                                     |> Task.andThen
                                                            (\sqlOut ->
                                                                report
                                                                    kvOut
                                                                    sqlOut))))


-- FAIL-CLOSED (F1): any failure — a real KV≠SQL divergence surfaced by `report`,
-- or a connect/insert/query error — prints PARITY FAIL and exits NON-ZERO. A
-- bare `Task.fail` at `main` returns Ok/Err through `rt.AnyTaskRun` and exits 0,
-- so the gate would be a no-op in CI; `System.exit 1` is the explicit non-zero.
main : Task Error ()
main =
    runParity
        |> Task.onError
               (\e ->
                   let
                       _ = println ("PARITY FAIL — " ++ Error.toString e)
                       _ = System.exit 1
                   in
                       Task.fail e)


report : List String -> List String -> Task Error ()
report kvOut sqlOut =
    let
        _ = println "── KV  (embedded BlueDB) ──"
        _ = printLines kvOut
        _ = println "── SQL (relational) ──"
        _ = printLines sqlOut
    in
        if kvOut == sqlOut then
            let
                _ =
                    println
                        "PARITY PASS — embedded ≡ relational byte-identical on the forced-semantics subset"
            in
                Task.succeed ()

        else
            Task.fail
                (Error.unexpected
                    "PARITY FAIL — embedded and relational diverged on the subset")
