module Main exposing (main, config)

-- examples/38-composite-ui-multibackend — ONE Sky source rendering
-- IDENTICALLY across Sky.Live (web), Sky.Tui (terminal), and
-- Sky.Webview (desktop). The shared View module owns Model + view;
-- this file's sole job is to argv-dispatch into the right backend
-- entry point.
--
--   ./sky-out/app             →  Sky.Live  on  :8006  (default)
--   ./sky-out/app --tui       →  Sky.Tui   (ANSI cells, full screen)
--   ./sky-out/app --webview   →  Sky.Webview (macOS only; stub
--                                elsewhere returns Err Error at
--                                runtime per CLAUDE.md §Webview).
--
-- Per CLAUDE.md, `sky build` flips to CGO_ENABLED=1 when it sees
-- `rt.Webview_app` in the emitted Go — so this app builds with
-- cgo on macOS and falls back to the stub on other platforms.

import Sky.Core.Prelude exposing (..)
import Sky.Core.List as List
import Sky.Core.System as System
import Sky.Core.Task as Task
import Sky.Core.Time as Time
import Std.Cmd as Cmd
import Std.App as App
import Std.Sub as Sub
import Std.Sub exposing (Sub)
import Head
import State exposing (..)
import Update exposing (update)
import View exposing (viewElement)
import Sky.Config as Config exposing (Sessions(..))


-- ─── Init ───────────────────────────────────────────────────────────
--
-- `init` accepts a polymorphic argument (Live passes a request
-- record; Tui + Webview pass unit). The body never touches it, so
-- the same function satisfies every backend.
init : a -> ( Model, Cmd Msg )
init _ =
    let
        today = todayIndex ()
    in
        ( { habits = seedHabits today
          , draft = ""
          , nextId = nextHabitId (seedHabits today)
          , todayIndex = today
          , viewport = { width = 1280, height = 720 }
          }
        , Cmd.none
        )


subscriptions : Model -> Sub Msg
subscriptions _ =
    Sub.none


-- Read the clock FRESH per call. `todayIndex ()` is a function, not a
-- memoised CAF: a zero-arg top-level binding is evaluated once and
-- cached for the whole process, which would freeze the clock at
-- process start (a session started on a later day would show the
-- process-start day). `todayIndex ()` is `unix-millis / 86_400_000`,
-- i.e. a whole-day count since the Unix epoch, computed at call time.
todayIndex : () -> Int
todayIndex _ =
    let
        nowMs = currentMillis ()
        millisPerDay = 86400000
    in
        nowMs // millisPerDay


currentMillis : () -> Int
currentMillis _ =
    Result.withDefault 0 (Task.run (Time.unixMillis ()))


-- ─── main ───────────────────────────────────────────────────────────
-- ONE app value; the build's `--target` picks the backend (default web).
--   sky build              → web (Sky.Live)
--   sky build --target terminal:tui   → Sky.Tui
--   sky build --target desktop         → Sky.Live in a native window
appDef =
    App.app
        { init = init
        , update = update
        , view = viewElement
        , subscriptions = subscriptions
        }
        |> App.withRoutes [ App.route "/" HomePage ]
        |> App.withNotFound HomePage
        |> App.withConfig (App.WebConfig { App.webDefaults | port = 8006 })
        |> App.withHead Head.headFor
        |> App.withOnKey onKey
        |> App.withWindow "Sky Habits" 960 720


main =
    App.run appDef

-- Single page constructor — the Live branch uses Page (an ADT
-- with one variant) so Live.app's `routes` field stays well-typed.
-- Tui + Webview ignore routing.
type Page
    = HomePage

-- Tui-only key handler. `q` exits the process (runtime's
-- top-level recover handles cleanup); everything else falls
-- through to Tick (the harmless model-touch Msg). In-tree
-- button + checkbox events arrive via Tab+Enter as usual.
type alias KeyEvent =
    { kind : String
    , value : String
    }


onKey : KeyEvent -> Msg
onKey k =
    if k.kind == "char" && k.value == "q" then
        QuitTui

    else if k.kind == "ctrl" && k.value == "c" then
        QuitTui

    else
        NoOp


config : Config.Config
config =
    Config.default |> Config.withSessions Memory
