module Lib.Games exposing (..)

import Sky.Core.Prelude exposing (..)
import Sky.Core.Result as Result
import Sky.Core.Maybe as Maybe
import Sky.Core.List as List
import Sky.Core.String as String
import Sky.Core.Dict as Dict
import Sky.Core.Crypto as Crypto
import Sky.Core.Task as Task
import Std.Codec as Codec exposing (Codec)
import Std.Db as Db exposing (SqlValue(..))
import Std.Db.Store as Store exposing (Store)
import Std.Log exposing (println)
import Sky.Core.System as System
import Sky.Core.Error as Error exposing (Error(..), ErrorKind(..))


-- Db.connect returns Task Error a per the effect-boundary doctrine, but
-- this Lib layer is consumed from inside `update` branches that need a
-- synchronous answer (the user-input handlers can't yield mid-tick), so
-- each wrapper bridges through Task.run and hands back a Result.
--
-- DB story: this module is FULLY on Std.Db.Store — one `Codec.auto` per
-- table drives the DDL, the typed reads (`Store.all`/`findBy`/query
-- builder → `Game`/`Move` records), and the typed writes
-- (`insert`/`update`/`delete`). `Store.touchOnUpdate "updatedAt"` bumps
-- the timestamp on every UPDATE with no raw SQL. No hand-written SQL, no
-- `Dict String String` rows.
dbConn =
    case Task.run (Db.connect ()) of

        Ok conn ->
            conn

        Err e ->
            let
                _ =
                    println
                        ("[FATAL] Cannot open skychess.db: " ++ Error.toString e)
            in
                System.exit 1


getConn _ =
    dbConn

-- ── Store definitions (schema + reads + writes) ─────────────────────
type alias Game =
    { id : String
    , playerName : String
    , status : String
    , result : String
    , moveCount : Int
    , createdAt : String
    , updatedAt : String
    }

type alias Move =
    { id : Int
    , gameId : String
    , moveNumber : Int
    , fromSquare : Int
    , toSquare : Int
    , algebraic : String
    , colour : String
    , createdAt : String
    }


-- One codec each drives the dialect-correct DDL + typed inserts.
-- `Store.defaultNow` stamps created_at/updated_at at the DB; games use
-- an app-generated TEXT id as the primary key, moves an auto-increment id.
gamesStore : Store Game
gamesStore =
    Store.fromCodec
        "games"
        (Codec.auto
            { id = ""
            , playerName = ""
            , status = ""
            , result = ""
            , moveCount = 0
            , createdAt = ""
            , updatedAt = ""
            })
        |> Store.primaryKey "id"
        |> Store.defaultText "status" "playing"
        |> Store.defaultText "result" ""
        |> Store.defaultInt "moveCount" 0
        |> Store.defaultNow "createdAt"
        |> Store.touchOnUpdate "updatedAt"


movesStore : Store Move
movesStore =
    Store.fromCodec
        "moves"
        (Codec.auto
            { id = 0
            , gameId = ""
            , moveNumber = 0
            , fromSquare = 0
            , toSquare = 0
            , algebraic = ""
            , colour = ""
            , createdAt = ""
            })
        |> Store.serial "id"
        |> Store.defaultNow "createdAt"


initSchema conn =
    let
        _ = Task.run (Store.create conn gamesStore)
        _ = Task.run (Store.create conn movesStore)
    in
        ()


-- createGame : Result Error String — returns new gameId or typed error.
createGame : String -> Result Error String
createGame playerName =
    let
        existing = Result.withDefault [] (getGames playerName)
        count = String.fromInt (List.length existing)
        gameId =
            String.slice 0 12 (Crypto.sha256 (playerName ++ ":game:" ++ count))
        newGame =
            { id = gameId
            , playerName = playerName
            , status = "playing"
            , result = ""
            , moveCount = 0
            , createdAt = ""
            , updatedAt = ""
            }
    in
        case Task.run (Store.insert dbConn gamesStore newGame) of

            Ok _ ->
                Ok gameId

            Err e ->
                Err e


-- saveMove : Result Error () — inserts the move row, then bumps the
-- game's move_count via a typed read-modify-write. `touchOnUpdate`
-- refreshes updated_at for us; no raw SQL.
saveMove : String -> Int -> Int -> Int -> String -> String -> Result Error ()
saveMove gameId moveNum from to algebraic colour =
    let
        newMove =
            { id = 0
            , gameId = gameId
            , moveNumber = moveNum
            , fromSquare = from
            , toSquare = to
            , algebraic = algebraic
            , colour = colour
            , createdAt = ""
            }
    in
        case Task.run (Store.insert dbConn movesStore newMove) of

            Err e ->
                Err e

            Ok _ ->
                bumpGame gameId (\g -> { g | moveCount = moveNum })


updateGameStatus : String -> String -> String -> Result Error ()
updateGameStatus gameId status result =
    bumpGame gameId (\g -> { g | status = status, result = result })


-- bumpGame : read the game by PK, apply a typed change, write it back.
-- Store.update bumps updated_at automatically (touchOnUpdate).
bumpGame : String -> (Game -> Game) -> Result Error ()
bumpGame gameId change =
    case Task.run (Store.findBy dbConn gamesStore "id" gameId) of

        Err e ->
            Err e

        Ok Nothing ->
            Ok ()

        Ok (Just g) ->
            case Task.run (Store.update dbConn gamesStore (change g)) of

                Err e ->
                    Err e

                Ok _ ->
                    Ok ()


-- Typed reads through the query builder → `Game` / `Move` records.
getGames : String -> Result Error (List Game)
getGames playerName =
    Task.run
        (Store.query gamesStore
            |> Store.where_ (Store.eq "playerName" (SqlString playerName))
            |> Store.orderDesc "createdAt"
            |> Store.limit 20
            |> Store.toList dbConn)


getGameMoves : String -> Result Error (List Move)
getGameMoves gameId =
    Task.run
        (Store.query movesStore
            |> Store.where_ (Store.eq "gameId" (SqlString gameId))
            |> Store.orderAsc "moveNumber"
            |> Store.toList dbConn)


getGame : String -> Result Error (Maybe Game)
getGame gameId =
    Task.run (Store.findBy dbConn gamesStore "id" gameId)


deleteGame : String -> Result Error ()
deleteGame gameId =
    case Task.run (Store.delete dbConn movesStore "game_id" gameId) of

        Err e ->
            Err e

        Ok _ ->
            case Task.run (Store.delete dbConn gamesStore "id" gameId) of

                Err e ->
                    Err e

                Ok _ ->
                    Ok ()
