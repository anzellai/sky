module Main exposing (main)

import Sky.Core.Prelude exposing (..)
import Sky.Core.Task as Task
import Sky.Core.List as List
import Sky.Core.String as String
import Std.Log exposing (println)
import Std.Ui as Ui exposing (Element)
import Std.Ui.Font as Font
import Std.Ui.Border as Border
import Std.Ui.Background as Background
import Std.Ui.Input as Input
import Std.Live as Live exposing (app, config, route)
import Std.Cmd as Cmd
import Std.Sub as Sub
import Std.Codec as Codec
import Std.Db.Store as Store
import Std.Persist as Persist

-- The SAME shared todo list as example 56 — but FULLY DECLARATIVE. The `todos`
-- field is backed by a reactive query (`Persist.live`, wired with
-- `Live.withReactive`): the framework keeps it fresh forever. There is NO
-- subscription, NO change Msg, NO re-query, NO coalescing — compare `update`
-- below to example 56. That's the whole feature: declare the query + where its
-- result goes, and it stays live across every session.
type alias Todo =
    { id : Int
    , text : String
    }


blankTodo : Todo
blankTodo =
    { id = 0, text = "" }


todos : Persist.Collection Todo
todos =
    Persist.collection
        (Store.fromCodec "todos" (Codec.auto blankTodo) |> Store.serial "id")


db : Persist.Conn Persist.KeyValue
db =
    case Task.run (Persist.connectKeyValue "data/todos.blue") of

        Ok conn ->
            conn

        Err e ->
            let
                _ =
                    println
                        ("[FATAL] cannot open todos.blue: " ++ errorToString e)
            in
                System.exit 1

type alias Model =
    { todos : List Todo
    , draft : String
    }

type Page
    = HomePage

type Msg
    = UpdateDraft String
    | AddTodo
    | Added (Result Error Todo)


init : a -> ( Model, Cmd Msg )
init _ =
    ( { todos = [], draft = "" }, Cmd.none )


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of

        UpdateDraft s ->
            ( { model | draft = s }, Cmd.none )

        AddTodo ->
            if String.trim model.draft == "" then
                ( model, Cmd.none )

            else
                ( { model | draft = "" }
                , Cmd.perform
                      (Persist.insert
                          db
                          todos
                          { id = 0, text = String.trim model.draft })
                      Added
                )

        Added _ ->
            ( model, Cmd.none )


-- No subscriptions, no re-query Msg — the reactive query below handles it all.
subscriptions : Model -> Sub Msg
subscriptions _ =
    Sub.none


-- THE ONLY reactive wiring: `todos` stays fresh from this query, forever.
reactiveQueries : Model -> List (Persist.Live Model)
reactiveQueries _ =
    [ Persist.liveInto
          db
          .todos
          (Persist.query todos |> Persist.orderAsc "id")
    ]


view : Model -> any
view model =
    Ui.layout
        []
        (Ui.column
            [ Ui.spacing 16
            , Ui.padding 32
            , Ui.width (Ui.maximum 560 Ui.fill)
            , Ui.centerX
            ]
            [ Ui.el
                  [ Font.size 28, Font.bold ]
                  (Ui.text "Shared todos (declarative)")
            , Ui.row
                  [ Ui.spacing 8, Ui.width Ui.fill ]
                  [ Input.text
                        [ Ui.width Ui.fill ]
                        { onChange = UpdateDraft
                        , text = model.draft
                        , placeholder = Nothing
                        , label = Input.labelHidden "New todo"
                        }
                  , Ui.button
                        [ Ui.paddingXY 16 10
                        , Background.color (Ui.rgb 40 100 220)
                        , Font.color Ui.white
                        , Border.rounded 6
                        ]
                        { onPress = Just AddTodo, label = Ui.text "Add" }
                  ]
            , Ui.column
                  [ Ui.spacing 6, Ui.width Ui.fill ]
                  (List.map todoRow model.todos)
            ])


todoRow : Todo -> Element Msg
todoRow t =
    Ui.el
        [ Ui.padding 10
        , Ui.width Ui.fill
        , Background.color (Ui.rgb 245 245 248)
        , Border.rounded 6
        ]
        (Ui.text (String.fromInt t.id ++ ". " ++ t.text))


main =
    app
        (config
            { init = init
            , update = update
            , view = view
            , subscriptions = subscriptions
            , routes = [ route "/" HomePage ]
            , notFound = HomePage
            }
            |> Live.withReactive reactiveQueries)
