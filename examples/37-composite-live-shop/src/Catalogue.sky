sortProducts : Sort -> List Product -> List Product
sortProducts sort products =
    case sort of

        SortName ->
            sortByName products

        SortPriceAsc ->
            sortByPriceAsc products

        SortPriceDesc ->
            sortByPriceDesc products


-- Insertion sort: 12 items, no need for anything fancy and we sidestep
-- a stdlib that doesn't expose List.sortBy yet.
sortByName : List Product -> List Product
sortByName xs =
    List.foldl (\p acc -> insertByName p acc) [] xs


insertByName : Product -> List Product -> List Product
insertByName p acc =
    case acc of

        [] ->
            [p]

        h :: rest ->
            if p.name <= h.name then
                p :: acc

            else
                h :: insertByName p rest


sortByPriceAsc : List Product -> List Product
sortByPriceAsc xs =
    List.foldl (\p acc -> insertByPriceAsc p acc) [] xs


insertByPriceAsc : Product -> List Product -> List Product
insertByPriceAsc p acc =
    case acc of

        [] ->
            [p]

        h :: rest ->
            if p.priceCents <= h.priceCents then
                p :: acc

            else
                h :: insertByPriceAsc p rest


sortByPriceDesc : List Product -> List Product
sortByPriceDesc xs =
    List.foldl (\p acc -> insertByPriceDesc p acc) [] xs


insertByPriceDesc : Product -> List Product -> List Product
insertByPriceDesc p acc =
    case acc of

        [] ->
            [p]

        h :: rest ->
            if p.priceCents >= h.priceCents then
                p :: acc

            else
                h :: insertByPriceDesc p rest


filterProducts : String -> Int -> List Product -> List Product
filterProducts needle maxCents products =
    let
        priceCap =
            if maxCents <= 0 then
                999999

            else
                maxCents
    in
        List.filter
            (\p ->
                containsCaseInsensitive needle p.name && p.priceCents
                    <= priceCap)
            products
