module Main exposing (main)

-- 11-fyne-stopwatch: a desktop stopwatch with the Fyne toolkit.
--
-- Sky opens the app and the window through the generated Fyne bindings.
-- The stopwatch itself (a time display, Start / Pause and Reset) is the
-- local Go module in ./stopwatch, added with `sky add ./stopwatch`: its
-- clock needs a goroutine and a mutex, which is Go's job.
--
-- Every Go call returns `Result Error a`, so the steps chain with
-- Result.andThen and the first failure is reported once.
--
-- Requirements: Go and a C compiler (Xcode command line tools on macOS,
-- gcc plus the OpenGL / X11 headers on Linux).
--
-- Usage:
--   sky install
--   sky build src/Main.sky
--   ./sky-out/app

import Sky.Core.Prelude exposing (..)
import Sky.Core.Result as Result
import Std.Log exposing (println)
import Fyne.Io.Fyne.V2 as Fyne
import Fyne.Io.Fyne.V2.App as FyneApp
import Example.Local.Stopwatch as Stopwatch


-- Put the stopwatch in the window, size it, and run until it is closed.
showStopwatch window =
    Stopwatch.content () |> Result.andThen (Fyne.windowSetContent window)
        |> Result.andThen (\_ -> Fyne.newSize 320.0 140.0)
        |> Result.andThen (Fyne.windowResize window)
        |> Result.andThen (\_ -> Fyne.windowShowAndRun window)


openStopwatch : () -> Result Error ()
openStopwatch _ =
    FyneApp.new ()
        |> Result.andThen (\app -> Fyne.appNewWindow app "Sky Stopwatch")
        |> Result.andThen showStopwatch


main =
    case openStopwatch () of

        Ok _ ->
            ()

        Err e ->
            let
                _ =
                    println
                        ("The stopwatch could not start: " ++ errorToString e)
            in
                ()
