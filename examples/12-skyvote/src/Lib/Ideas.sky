module Lib.Ideas exposing
    ( createIdea
    , getIdeas
    , getIdea
    , getIdeasByStatus
    , toggleVote
    , hasVoted
    , getVoteCount
    , updateStatus
    )

import Sky.Core.Prelude exposing (..)
import Sky.Core.Maybe exposing (..)
import Sky.Core.List as List
import Sky.Core.String as String
import Std.Log exposing (println)
import Sky.Core.Crypto as Crypto
import Sky.Core.Task as Task
import Std.Db exposing (SqlValue(..))
import Std.Db.Store as Store
import Lib.Db as Db exposing (IdeaRow)
import Sky.Core.Error as Error exposing (Error)


createIdea : String -> String -> String -> String -> Result Error String
createIdea title description category authorId =
    let
        id = String.slice 0 12 (Crypto.sha256 (title ++ ":" ++ authorId))
        idea =
            { id = id
            , title = title
            , description = description
            , authorId = authorId
            , category = category
            , status = "open"
            , createdAt = ""
            , updatedAt = ""
            }
    in
        case Task.run (Store.insert Db.conn Db.ideaStore idea) of

            Ok _ ->
                let
                    _ =
                        println
                            ("[IDEA] Created: " ++ title ++ " by " ++ authorId)
                in
                    Ok id

            Err e ->
                Err e


-- The board query: idea + author name (LEFT JOIN) + vote/comment counts
-- (correlated subqueries) — a single-table Store can't express it, so
-- Store.selectRaw runs the SQL and decodes each row into a typed IdeaRow.
-- The search term binds as a PARAMETER (the pre-migration string-interpolated
-- LIKE was a SQL-injection hole).
ideaSelect : String
ideaSelect =
    "SELECT i.id, i.title, i.description, i.category, i.status, i.author_id, i.created_at, u.username as author_name, (SELECT COUNT(*) FROM votes v WHERE v.idea_id = i.id) as vote_count, (SELECT COUNT(*) FROM comments c WHERE c.idea_id = i.id) as comment_count FROM ideas i LEFT JOIN users u ON i.author_id = u.id"


getIdeas : String -> String -> String -> Result Error (List IdeaRow)
getIdeas sortBy filterCategory searchQuery =
    let
        like = "%" ++ searchQuery ++ "%"
        ( whereClause, params ) =
            if filterCategory == "all" then
                if searchQuery == "" then
                    ( "", [] )

                else
                    ( " WHERE (i.title LIKE ? OR i.description LIKE ?)"
                    , [ SqlString like, SqlString like ]
                    )

            else if searchQuery == "" then
                ( " WHERE i.category = ?", [ SqlString filterCategory ] )

            else
                ( " WHERE i.category = ? AND (i.title LIKE ? OR i.description LIKE ?)"
                , [ SqlString filterCategory, SqlString like, SqlString like ]
                )
        orderClause =
            if sortBy == "votes" then
                " ORDER BY vote_count DESC, i.created_at DESC"

            else if sortBy == "comments" then
                " ORDER BY comment_count DESC, i.created_at DESC"

            else
                " ORDER BY i.created_at DESC"
    in
        Task.run
            (Store.selectRaw
                Db.conn
                Db.ideaRowCodec
                (ideaSelect ++ whereClause ++ orderClause)
                params)


getIdea : String -> Result Error (Maybe IdeaRow)
getIdea ideaId =
    case Task.run
             (Store.selectRaw
                 Db.conn
                 Db.ideaRowCodec
                 (ideaSelect ++ " WHERE i.id = ? LIMIT 1")
                 [ SqlString ideaId ]) of

        Err e ->
            Err e

        Ok rows ->
            Ok (List.head rows)


getIdeasByStatus : String -> Result Error (List IdeaRow)
getIdeasByStatus status =
    Task.run
        (Store.selectRaw
            Db.conn
            Db.ideaRowCodec
            (ideaSelect ++ " WHERE i.status = ? ORDER BY vote_count DESC")
            [ SqlString status ])


-- toggleVote : existence check via the query builder, then insert/delete.
toggleVote : String -> String -> Result Error ()
toggleVote ideaId userId =
    case Task.run (voteOf ideaId userId) of

        Err e ->
            Err e

        Ok (Just _) ->
            let
                cond =
                    Store.and_
                        [ Store.eq "ideaId" (SqlString ideaId)
                        , Store.eq "userId" (SqlString userId)
                        ]
            in
                case Task.run (Store.deleteWhere Db.conn Db.voteStore cond) of

                    Err e ->
                        Err e

                    Ok _ ->
                        Ok ()

        Ok Nothing ->
            let
                voteId =
                    String.slice 0 12 (Crypto.sha256 (ideaId ++ ":" ++ userId))
                vote =
                    { id = voteId
                    , ideaId = ideaId
                    , userId = userId
                    , createdAt = ""
                    }
            in
                case Task.run (Store.insert Db.conn Db.voteStore vote) of

                    Err e ->
                        Err e

                    Ok _ ->
                        Ok ()


voteOf : String -> String -> Task Error (Maybe Db.Vote)
voteOf ideaId userId =
    Store.query Db.voteStore
        |> Store.where_ (Store.eq "ideaId" (SqlString ideaId))
        |> Store.where_ (Store.eq "userId" (SqlString userId))
        |> Store.toMaybe Db.conn


hasVoted : String -> String -> Bool
hasVoted ideaId userId =
    case Task.run (voteOf ideaId userId) of

        Err e ->
            let
                _ =
                    println ("[DB ERROR] Ideas.hasVoted: " ++ Error.toString e)
            in
                False

        Ok maybeVote ->
            case maybeVote of

                Just _ ->
                    True

                Nothing ->
                    False


getVoteCount : String -> String
getVoteCount ideaId =
    case Task.run
             (Store.query Db.voteStore
                 |> Store.where_ (Store.eq "ideaId" (SqlString ideaId))
                 |> Store.count Db.conn) of

        Err e ->
            let
                _ =
                    println
                        ("[DB ERROR] Ideas.getVoteCount: " ++ Error.toString e)
            in
                "0"

        Ok n ->
            String.fromInt n


-- updateStatus : typed read-modify-write; touchOnUpdate bumps updated_at.
updateStatus : String -> String -> Result Error ()
updateStatus ideaId newStatus =
    case Task.run (Store.findBy Db.conn Db.ideaStore "id" ideaId) of

        Err e ->
            Err e

        Ok Nothing ->
            Ok ()

        Ok (Just idea) ->
            case Task.run
                     (Store.update
                         Db.conn
                         Db.ideaStore
                         { idea | status = newStatus }) of

                Err e ->
                    Err e

                Ok _ ->
                    let
                        _ =
                            println
                                ("[IDEA] Status changed: " ++ ideaId ++ " -> "
                                    ++ newStatus)
                    in
                        Ok ()
