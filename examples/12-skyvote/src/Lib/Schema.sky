module Lib.Schema exposing (initDb)

import Sky.Core.Prelude exposing (..)
import Sky.Core.Task as Task
import Std.Db as Db
import Std.Db.Store as Store
import Std.Log exposing (println)
import Lib.Db as Db2
import Sky.Core.Error as Error exposing (Error)


runInit label result =
    case result of

        Ok _ ->
            ()

        Err e ->
            let
                _ =
                    println
                        ("[SCHEMA ERROR] " ++ label ++ ": " ++ Error.toString e)
            in
                ()


-- Schema is derived from the codecs — one `Store.create` per store emits the
-- dialect-correct DDL (TEXT PK, UNIQUE, DEFAULTs, touchOnUpdate timestamps).
-- The votes table's COMPOUND uniqueness (idea_id, user_id) is a compound UNIQUE
-- INDEX — a single-table Store models single-column UNIQUE, so a compound index
-- is a one-line raw DDL (the standard "indexes are separate DDL" split).
initDb =
    let
        _ = runInit "users" (Task.run (Store.create Db2.conn Db2.userStore))
        _ = runInit "ideas" (Task.run (Store.create Db2.conn Db2.ideaStore))
        _ = runInit "votes" (Task.run (Store.create Db2.conn Db2.voteStore))
        _ =
            runInit
                "comments"
                (Task.run (Store.create Db2.conn Db2.commentStore))
        _ =
            runInit
                "activity"
                (Task.run (Store.create Db2.conn Db2.activityStore))
        _ =
            runInit
                "votes_unique"
                (Task.run
                    (Db.execRaw
                        Db2.conn
                        "CREATE UNIQUE INDEX IF NOT EXISTS votes_idea_user ON votes(idea_id, user_id)"))
    in
        ()
