module Lib.Auth exposing (hashPassword, verifyPassword, createUser, authenticateUser, getUserById)

import Sky.Core.Prelude exposing (..)
import Sky.Core.Maybe exposing (..)
import Sky.Core.List as List
import Sky.Core.Result as Result
import Sky.Core.String as String
import Std.Log exposing (println)
import Sky.Core.Crypto as Crypto
import Sky.Core.Task as Task
import Std.Auth as Auth
import Std.Db exposing (SqlValue(..))
import Std.Db.Store as Store
import Lib.Db as Db exposing (User)
import Sky.Core.Error as Error exposing (Error)


hashPassword : String -> String
hashPassword password =
    case Auth.hashPassword password of

        Ok hash ->
            hash

        Err _ ->
            ""


verifyPassword : String -> String -> Bool
verifyPassword password storedHash =
    Result.withDefault False (Auth.verifyPassword password storedHash)


-- createUser : Result Error UserId. The UNIQUE username/email constraints turn
-- a duplicate into a driver error, surfaced as InvalidInput for the form.
createUser : String -> String -> String -> Result Error String
createUser username email password =
    let
        id = String.slice 0 12 (Crypto.sha256 (username ++ ":" ++ email))
        passHash = hashPassword password
        user =
            { id = id
            , username = username
            , email = email
            , passwordHash = passHash
            , createdAt = ""
            }
    in
        case Task.run (Store.insert Db.conn Db.userStore user) of

            Ok _ ->
                let
                    _ =
                        println
                            ("[AUTH] User created: " ++ username ++ " (" ++ email
                                ++ ")")
                in
                    Ok id

            Err _ ->
                Err (Error.invalidInput "Username or email already taken.")


-- authenticateUser : Result Error User. Wrong password / unknown email both
-- Unauthorised (same UI text — no user-enumeration leak). The password check is
-- SEPARATE from `Ok user` so subset-record inference doesn't narrow the Ok.
authenticateUser : String -> String -> Result Error User
authenticateUser email password =
    case Task.run (Store.findBy Db.conn Db.userStore "email" email) of

        Err e ->
            Err e

        Ok Nothing ->
            let
                _ = println ("[AUTH] Sign-in failed (not found): " ++ email)
            in
                Err
                    (Error.permissionDenied
                        |> Error.withMessage "Invalid email or password.")

        Ok (Just user) ->
            if passwordOk password user then
                let
                    _ = println ("[AUTH] Sign-in success: " ++ email)
                in
                    Ok user

            else
                let
                    _ =
                        println
                            ("[AUTH] Sign-in failed (bad password): " ++ email)
                in
                    Err
                        (Error.permissionDenied
                            |> Error.withMessage "Invalid email or password.")


passwordOk : String -> User -> Bool
passwordOk password user =
    verifyPassword password user.passwordHash


-- getUserById : Result Error (Maybe User).
getUserById : String -> Result Error (Maybe User)
getUserById userId =
    Task.run (Store.findBy Db.conn Db.userStore "id" userId)
