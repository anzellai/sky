module Grammar exposing (Slots, Template, tasks, rows, perTask)

{-| The template grammar: task x tool x platform.

A task has several ways to ask for it and one command per platform. The slots
(a file, a word, a number ...) come from small pools, so every row is a real
request with real names. Each task gives `perTask` rows on each of the four
platforms (macOS or Linux, with or without `fd` and `rg`), and the command
follows the platform: `stat -f %z` against `stat -c %s`, `sed -i ''` against
`sed -i`, `fd` and `rg` only where they are installed.

The phrasings here are not the ones the eval asks (src/Cases.sky): the eval
measures whether the model generalises, not whether it remembers.
-}

import Sky.Core.Prelude exposing (..)
import Sky.Core.String as String
import Sky.Core.List as List
import Sky.Core.Maybe as Maybe exposing (Maybe(..))
import Prompt exposing (Os(..), Platform)

-- | The values a template fills in.
type alias Slots =
    { file : String
    , name : String
    , ext : String
    , word : String
    , word2 : String
    , dir : String
    , n : Int
    , col : Int
    , size : Int
    , lang : String
    }

-- | A task: its phrasings and its command on a platform.
type alias Template =
    { id : String
    , asks : List (Slots -> String)
    , command : Platform -> Slots -> String
    , weight : Int
    }


-- | Rows per task and platform.
perTask : Int
perTask =
    24


files : List String
files =
    [ "notes.txt"
    , "logs/server.log"
    , "data/orders.csv"
    , "src/app.js"
    , "docs/notes.md"
    , "config/settings.yaml"
    , "reports/q3.txt"
    , "web/index.html"
    , "report.md"
    , "server.log"
    , "data.csv"
    , "main.go"
    , "index.html"
    , "config.yaml"
    , "todo.txt"
    , "readme.md"
    , "app.py"
    , "schedule.csv"
    , "errors.log"
    , "people.csv"
    ]


names : List String
names =
    [ "xyz.csv"
    , "budget.xlsx"
    , "photo.jpg"
    , "invoice.pdf"
    , "main.rs"
    , "setup.py"
