page : String -> String -> String -> Page
page folder program sha =
    { folder = folder, program = program, sha256 = sha }


url : Page -> String
url p =
    "https://raw.githubusercontent.com/tldr-pages/tldr/" ++ commit ++ "/pages/"
        ++ p.folder
        ++ "/"
        ++ p.program
        ++ ".md"


cachePath : String -> Page -> String
cachePath dir p =
    dir ++ "/" ++ commit ++ "/" ++ p.folder ++ "-" ++ p.program ++ ".md"


-- | Every page, from the cache or fetched and checked: `(page, markdown)`.
fetchAll : String -> Task Error (List ( Page, String ))
fetchAll dir =
    File.mkdirAll (dir ++ "/" ++ commit)
        |> Task.andThen
               (\_ ->
                   Task.sequence
                       (List.map
                           (\p ->
                               fetchOne dir p |> Task.map (\text -> ( p, text )))
                           pages))


fetchOne : String -> Page -> Task Error String
fetchOne dir p =
    let
        path = cachePath dir p
    in
        File.exists path
            |> Task.andThen
                   (\cached ->
                       if cached then
                           File.readFile path |> Task.andThen (checked p)

                       else
                           Http.get (url p)
                               |> Task.andThen
                                      (\r ->
                                          if r.status == 200 then
                                              checked p r.body

                                          else
                                              Task.fail
                                                  (Error.network
                                                      ("tldr page " ++ p.folder
                                                          ++ "/"
                                                          ++ p.program
                                                          ++ ": HTTP "
                                                          ++ String.fromInt
                                                                 r.status)))
                               |> Task.andThen
                                      (\text ->
                                          File.writeFile path text
                                              |> Task.map (\_ -> text)))


checked : Page -> String -> Task Error String
checked p text =
    if Crypto.sha256 text == p.sha256 then
        Task.succeed text

    else
        Task.fail
            (Error.invalidInput
                ("tldr page " ++ p.folder ++ "/" ++ p.program
                    ++ " does not match its pinned SHA-256"))


-- | The examples of a page: `(description, command)`, placeholders still in.
parse : String -> List ( String, String )
parse markdown =
    collect (String.lines markdown) Nothing [] |> List.reverse


collect : List String -> Maybe String -> List ( String, String ) -> List ( String, String )
collect lines pending acc =
    case lines of

        [] ->
            acc

        line :: rest ->
            if String.startsWith "- " line then
                collect rest (Just (String.dropLeft 2 line)) acc

            else if String.startsWith "`" line && String.endsWith "`" line then
                case pending of

                    Just description ->
                        collect
                            rest
                            Nothing
                            (( description
                            , String.slice 1 (String.length line - 1) line
                            )
                                :: acc)

                    Nothing ->
                        collect rest Nothing acc

            else
                collect rest pending acc


-- | Fill the placeholders: an option written `{{[-r|--recursive]}}` becomes
-- its short form, a choice `{{f|d}}` its first option,
-- `{{path/to/directory}}` the current folder and `{{path/to/file}}` a file
-- name. `Nothing` for a command that needs another command
-- (`{{command}} | ...`).
fill : String -> Maybe String
fill command =
    if String.contains "{{command" command || String.contains "{{program" command then
        Nothing

    else
        let
            filled =
                replaceAll (Regex.findAll "\\{\\{[^}]*\\}\\}" command) command
        in
            -- A nested placeholder (`{{path/to/{a,b}}}`) is left out.
            if String.contains "{{" filled || String.contains "}}" filled then
                Nothing

            else
                Just filled


replaceAll : List String -> String -> String
replaceAll found command =
    case found of

        [] ->
            command

        p :: rest ->
            replaceAll
                rest
                (String.replace
                    p
                    (placeholder (String.slice 2 (String.length p - 2) p))
                    command)


placeholder : String -> String
placeholder inner =
    let
        choice =
            if String.startsWith "[" inner && String.endsWith "]" inner then
                String.slice 1 (String.length inner - 1) inner
                    |> String.split "|"
                    |> List.head
                    |> Maybe.withDefault inner

            else if String.contains "|" inner then
                String.split "|" inner |> List.head |> Maybe.withDefault inner

            else
                inner
    in
        choice |> String.words |> List.filter (\w -> w /= "...")
            |> List.map pathWord
            |> String.join " "


pathWord : String -> String
pathWord word =
    if word == "path/to/directory" || word == "path/to/directory/" then
        "."

    else if String.startsWith "path/to/" word then
        String.dropLeft 8 word

    else
        word


-- | The rows of every page for each platform: `(platform, request, command)`.
rows : List ( Page, String ) -> List ( Prompt.Platform, String, String )
rows fetched =
    List.concatMap
        (\platform ->
            fetched |> List.filter (\( p, _ ) -> usedOn platform p)
                |> List.concatMap (\( _, text ) -> parse text)
                |> List.filterMap
                       (\( description, command ) ->
                           fill command
                               |> Maybe.map
                                      (\c -> ( platform, request description, c ))))
        Prompt.platforms


usedOn : Prompt.Platform -> Page -> Bool
usedOn platform p =
    let
        own =
            case platform.os of

                MacOs ->
                    "osx"

                Linux ->
                    "linux"
    in
        if p.program == "fd" && not platform.fd then
            False

        else if p.program == "rg" && not platform.rg then
            False

        else if p.folder == own then
            True

        else if p.folder == "common" then
            not
                (List.any (\q -> q.folder == own && q.program == p.program) pages)

        else
            False


-- "Find files by [e]xtension:" -> "find files by extension"
request : String -> String
request description =
    let
        text =
            description |> String.replace "[" "" |> String.replace "]" ""
                |> String.replace "`" ""
                |> String.trim
        trimmed =
            if String.endsWith ":" text then
                String.dropRight 1 text

            else
                text
    in
        String.toLower (String.left 1 trimmed) ++ String.dropLeft 1 trimmed
