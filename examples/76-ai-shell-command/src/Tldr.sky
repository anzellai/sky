module Tldr exposing (Page, commit, pages, fetchAll, parse, fill, rows)

{-| Training rows from tldr-pages (https://github.com/tldr-pages/tldr),
licensed CC BY 4.0. Copyright (c) 2014 the tldr-pages team and contributors.

The pages are fetched at one pinned commit, and each file is checked against
its SHA-256 before it is used. They are cached under `.sky/tldr/` and never
committed. Each example of a page becomes one row: its description is the
request and its command (with the placeholders filled in) is the answer.

A page under `common/` is used on both platforms, unless the platform has a
page of its own for the same program (`osx/stat`, `linux/sed` ...): that page
wins there, as it does in the tldr clients.
-}

import Sky.Core.Prelude exposing (..)
import Sky.Core.Task as Task
import Sky.Core.Error as Error exposing (Error)
import Sky.Core.String as String
import Sky.Core.List as List
import Sky.Core.Maybe as Maybe exposing (Maybe(..))
import Sky.Core.Regex as Regex
import Sky.Core.Crypto as Crypto
import Sky.Core.File as File
import Sky.Core.Http as Http
import Prompt exposing (Os(..))


-- | The tldr-pages commit the pages are read at (2026-09-30).
commit : String
commit =
    "25f7dbe55d03efa3ca1a27c21eea571cb86bd601"

-- | A page: its folder (`common`, `osx` or `linux`), the program, and the
-- SHA-256 of the file at the pinned commit.
type alias Page =
    { folder : String
    , program : String
    , sha256 : String
    }


pages : List Page
pages =
    [ page
          "common"
