module Main exposing (main)

-- Sky Console (Phase A — Std.Ui Sky.Live mini-app).
--
-- Phase A: standalone Sky.Live example that proves the Std.Ui UI
-- works typed end-to-end with mocked data. Once green, the same
-- source moves to sky-stdlib/Sky/Internal/Console/ in Phase B and
-- the runtime auto-mounts it under /_sky/console.
--
-- No hand-written JS in this source — every interaction is
-- onClick → Msg → update → re-render via Sky.Live's framework
-- wire (SSE + POST /_sky/event). Multi-module split so the
-- type-checker stays well below the heap-exhaustion limit
-- (CLAUDE.md Limitation #17).

import Sky.Core.Prelude exposing (..)
import Std.Cmd as Cmd
import Std.Sub as Sub
import Std.App as App
import Std.Ui as Ui
import Std.Ui exposing (Element)
import State exposing (..)
import View exposing (view)


init : a -> ( Model, Cmd Msg )
init _req =
    ( { tab = Overview
      , overview = mockOverview
      , logs = mockLogs
      , metrics = mockMetrics
      , traces = mockTraces
      , errors = mockErrors
      }
    , Cmd.none
    )


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of

        SelectTab tab ->
            ( { model | tab = tab }, Cmd.none )

        Tick ->
            -- Phase B: re-fetch overview / logs / etc. from runtime.
            -- Phase A: tick is a no-op so the polling sub still
            -- exercises the wire path end-to-end.
            ( model, Cmd.none )


subscriptions : Model -> Sub Msg
subscriptions _ =
    Sub.none


appDef =
    App.app
        { init = init
        , update = update

        -- App.app (Std.Ui family) takes a bare `Element` view directly; the
        -- Std.App runner supplies the `Ui.layout` document shell. Wrapping in
        -- `Ui.layout` here returns an `Html` document into an `Element` slot
        -- (a compile error; formerly a silently-empty page).
        , view = view
        , subscriptions = subscriptions
        }
        |> App.withRoutes [ App.route "/" () ]
        |> App.withNotFound ()
        |> App.withConfig (App.WebConfig { App.webDefaults | port = 8025 })


main =
    App.run appDef
