module State exposing (..)

-- Pure types + same-shape helpers. No Std.Ui imports here so the
-- type-checker stays well below the heap-exhaustion limit
-- (CLAUDE.md Limitation #17).

import Sky.Core.Prelude exposing (..)

-- ─── Tabs ────────────────────────────────────────────────────────
-- The console has 5 tabs. Active tab is part of Model so navigation
-- is just a Msg dispatch (no client-side router).
type Tab
    = Overview
    | Metrics
    | Logs
    | Traces
    | Errors


tabLabel : Tab -> String
tabLabel tab =
    case tab of

        Overview ->
            "Overview"

        Metrics ->
            "Metrics"

        Logs ->
            "Logs"

        Traces ->
            "Traces"

        Errors ->
            "Errors"

-- ─── Data shapes ─────────────────────────────────────────────────
-- Overview tab payload. Phase A: hand-mocked in init for the
-- standalone example. Phase B: populated via Cmd.perform from
-- runtime helpers (rt.consoleOverview / rt.consoleMetrics / ...).
type alias Overview =
    { skyVersion : String
    , commit : String
    , builtAt : String
    , uptimeSeconds : Int
    , requestsTotal : Int
    , errorRate5xx : Float
    , logBufferUsed : Int
    , logBufferMax : Int
    , traceBufferUsed : Int
    , traceBufferMax : Int
    , runtimeMode : String
    , authMode : String
    }

-- Log entry shown in the Logs tab.
type alias LogEntry =
    { time : String
    , level : String
    , message : String
    }

type alias MetricRow =
    { name : String
    , value : String
    , help : String
    }

type alias TraceRow =
    { time : String
    , name : String
    , durationMs : Int
    , statusOk : Bool
    }

type alias ErrorRow =
    { count : Int
    , message : String
    }

-- ─── Model + Msg ─────────────────────────────────────────────────
type alias Model =
    { tab : Tab
    , overview : Overview
    , logs : List LogEntry
    , metrics : List MetricRow
    , traces : List TraceRow
    , errors : List ErrorRow
    }

type Msg
    = SelectTab Tab
    | Tick


