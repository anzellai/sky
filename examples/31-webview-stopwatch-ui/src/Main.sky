module Main exposing (main)

-- 31-webview-stopwatch-ui — desktop stopwatch via Sky.Webview.
--
-- Same Model / update / subscriptions / view as
-- `22-tui-stopwatch-ui`, but `main` calls `Webview.app` instead of
-- `Tui.app`. The runtime opens a native window (WKWebView on macOS),
-- renders the Std.Ui Element tree to HTML, and dispatches DOM events
-- back through the in-process bridge — no HTTP, no SSE, no extra
-- processes.
import Sky.Core.Prelude exposing (..)
import Sky.Core.String as String
import Sky.Core.Task as Task
import Std.Webview as Webview
import Std.Cmd as Cmd
import Std.Sub as Sub
import Std.Ui as Ui
import Std.Ui.Background as Background
import Std.Ui.Font as Font

-- ═══════════════════════════════════════════════════════════════════
-- Model + Msg
-- ═══════════════════════════════════════════════════════════════════
type alias Model =
    { running : Bool
    , elapsedMs : Int
    }

type Msg
    = Tick
    | Toggle
    | Reset


init : () -> ( Model, Cmd Msg )
init _ =
    ( { running = False, elapsedMs = 0 }, Cmd.none )


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of

        Tick ->
            if model.running then
                ( { model | elapsedMs = model.elapsedMs + 100 }, Cmd.none )

            else
                ( model, Cmd.none )

        Toggle ->
            ( { model | running = not model.running }, Cmd.none )

        Reset ->
            ( { running = False, elapsedMs = 0 }, Cmd.none )


subscriptions : Model -> Sub Msg
subscriptions model =
    if model.running then
        Sub.every 100 Tick

    else
        Sub.none


-- ═══════════════════════════════════════════════════════════════════
-- View — same Std.Ui tree as 22-tui-stopwatch-ui's
-- ═══════════════════════════════════════════════════════════════════
view : Model -> Html
view model =
    Ui.layout
        [Background.color (Ui.rgb 24 28 48), Font.color (Ui.rgb 220 220 230)]
        (Ui.column
            [Ui.padding 32, Ui.spacing 16]
            [ Ui.el
                  [ Font.color (Ui.rgb 142 200 168), Font.size 24 ]
                  (Ui.text "Sky Webview Stopwatch")
            , Ui.el
                  [ Font.size 48, Font.color (Ui.rgb 240 240 240) ]
                  (Ui.text (formatElapsed model.elapsedMs))
            , Ui.el [Font.color (Ui.rgb 150 150 170)] (Ui.text (statusLine model))
            , Ui.row
                  [Ui.spacing 16]
                  [ Ui.button
                        [ Background.color (Ui.rgb 60 90 70)
                        , Font.color (Ui.rgb 240 240 240)
                        , Ui.paddingXY 16 8
                        ]
                        { onPress = Just Toggle
                        , label = Ui.text (toggleLabel model)
                        }
                  , Ui.button
                        [ Background.color (Ui.rgb 90 60 60)
                        , Font.color (Ui.rgb 240 240 240)
                        , Ui.paddingXY 16 8
                        ]
                        { onPress = Just Reset, label = Ui.text "Reset" }
                  ]
            , Ui.el
                  [Font.color (Ui.rgb 120 120 140)]
                  (Ui.text "Click the buttons or close the window to quit.")
            ])


toggleLabel : Model -> String
toggleLabel model =
    if model.running then
        "Pause"

    else
        "Start"


statusLine : Model -> String
statusLine model =
    if model.running then
        "[ running ]"

    else
        "[ paused  ]"


formatElapsed : Int -> String
formatElapsed totalMs =
    let
        totalSec = totalMs // 1000
        minutes = totalSec // 60
        seconds = modBy 60 totalSec
        deciSec = modBy 10 (totalMs // 100)
    in
        pad2 minutes ++ ":" ++ pad2 seconds ++ "." ++ String.fromInt deciSec


pad2 : Int -> String
pad2 n =
    let
        s = String.fromInt n
    in
        if String.length s < 2 then
            "0" ++ s

        else
            s


-- ═══════════════════════════════════════════════════════════════════
-- Main
-- ═══════════════════════════════════════════════════════════════════
main =
    Webview.app
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        , window = { title = "Sky Webview Stopwatch", size = ( 800, 500 ) }
        }
        |> Task.run
