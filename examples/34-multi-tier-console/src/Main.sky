module Main exposing (main)

import Sky.Core.Prelude exposing (..)
import Sky.Core.String as String
import Std.Cmd as Cmd
import Std.Css exposing (..)
import Std.Html exposing (..)
import Std.Html.Attributes exposing (..)
import Std.Html.Events exposing (onClick)
import Std.Live exposing (app, route)
import Std.Log as Log
import Std.Sub as Sub



-- MULTI-TIER CONSOLE SHOWCASE
--
-- A single Sky.Live binary with four logical tiers:
--
--   /         host       — overview + nav
--   /billing  billing    — emits Stripe-style log lines
--   /jobs     jobs       — emits background-task logs
--   /auth     auth       — emits sign-in / token logs
--
-- Each tier tags its log emissions with a service.namespace label
-- so the inline /_sky/console can filter signals per-tier. The
-- console aggregates all tiers' emissions out of
-- telemetry.Default() — no per-tier wiring required.


type Page
    = HostPage
    | BillingPage
    | JobsPage
    | AuthPage


type Msg
    = Navigate Page
    | EmitBillingLog
    | EmitJobsLog
    | EmitAuthLog
    | EmitErrorLog
    | Tick


type alias Model =
    { page : Page
    , billingHits : Int
    , jobsHits : Int
    , authHits : Int
    , ticks : Int
    }


init : a -> ( Model, Cmd Msg )
init _req =
    ( { page = HostPage
      , billingHits = 0
      , jobsHits = 0
      , authHits = 0
      , ticks = 0
      }
    , Cmd.none
    )


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of
        Navigate page ->
            let
                _ =
                    Log.infoWith "navigate"
                        [ "from", pageLabel model.page
                        , "to", pageLabel page
                        ]
            in
            ( { model | page = page }, Cmd.none )

        EmitBillingLog ->
            let
                _ =
                    Log.infoWith "billing.charge"
                        [ "service.namespace", "/billing"
                        , "customer", "cus_demo_42"
                        , "amount_cents", "1200"
                        , "currency", "usd"
                        ]
            in
            ( { model | billingHits = model.billingHits + 1 }, Cmd.none )

        EmitJobsLog ->
            let
                _ =
                    Log.infoWith "jobs.enqueue"
                        [ "service.namespace", "/jobs"
                        , "queue", "email-blast"
                        , "job_id", "job_demo_" ++ String.fromInt (model.jobsHits + 1)
                        ]
            in
            ( { model | jobsHits = model.jobsHits + 1 }, Cmd.none )

        EmitAuthLog ->
            let
                _ =
                    Log.infoWith "auth.signin"
                        [ "service.namespace", "/auth"
                        , "user_id", "u_demo_99"
                        , "method", "oauth.google"
                        ]
            in
            ( { model | authHits = model.authHits + 1 }, Cmd.none )

        EmitErrorLog ->
            let
                _ =
                    Log.errorWith "billing.charge.failed"
                        [ "service.namespace", "/billing"
                        , "customer", "cus_demo_42"
                        , "stripe_error", "card_declined"
                        ]
            in
            ( { model | billingHits = model.billingHits + 1 }, Cmd.none )

        Tick ->
            ( { model | ticks = model.ticks + 1 }, Cmd.none )


pageLabel : Page -> String
pageLabel page =
    case page of
        HostPage ->
            "host"

        BillingPage ->
            "billing"

        JobsPage ->
            "jobs"

        AuthPage ->
            "auth"


view : Model -> Html Msg
view model =
    div [ style "max-width: 720px; margin: 40px auto; padding: 24px; font-family: ui-sans-serif, system-ui, -apple-system, sans-serif; color: #1c1c1c;" ]
        [ h1 [] [ text "Multi-Tier Console Showcase" ]
        , p [ style "color: #555; line-height: 1.5;" ]
            [ text "Single Sky.Live binary serving four logical tiers. Each tier emits logs tagged with "
            , code [] [ text "service.namespace" ]
            , text "; the inline console at "
            , a [ href "/_sky/console" ] [ text "/_sky/console" ]
            , text " aggregates and filters by namespace."
            ]
        , div [ style "margin: 24px 0;" ] (viewNav model)
        , div [ style "margin-top: 32px;" ] [ viewPage model ]
        ]


viewNav : Model -> List (Html Msg)
viewNav model =
    [ navButton model HostPage "Host"
    , navButton model BillingPage "Billing"
    , navButton model JobsPage "Jobs"
    , navButton model AuthPage "Auth"
    , a [ href "/_sky/console", style ("margin-left: 16px; padding: 8px 14px; background: #ff6600; color: #fff; text-decoration: none; border-radius: 4px; font-weight: 600; display: inline-block;") ]
        [ text "Sky Console -" ]
    ]


navButton : Model -> Page -> String -> Html Msg
navButton model page label =
    let
        isActive =
            model.page == page

        bg =
            if isActive then
                "#1c1c1c"

            else
                "#e8e8e8"

        fg =
            if isActive then
                "#fff"

            else
                "#1c1c1c"
    in
    button
        [ onClick (Navigate page)
        , style ("margin-right: 8px; padding: 8px 14px; background: " ++ bg ++ "; color: " ++ fg ++ "; border: 1px solid #ccc; cursor: pointer; border-radius: 4px;")
        ]
        [ text label ]


viewPage : Model -> Html Msg
viewPage model =
    case model.page of
        HostPage ->
            viewHost model

        BillingPage ->
            viewBilling model

        JobsPage ->
            viewJobs model

        AuthPage ->
            viewAuth model


viewHost : Model -> Html Msg
viewHost model =
    div []
        [ h2 [] [ text "Host" ]
        , p [ style "color: #555; line-height: 1.5;" ]
            [ text "The host tier serves the overview. It logs page navigations under the default (host) namespace." ]
        , statsCard model
        ]


viewBilling : Model -> Html Msg
viewBilling model =
    tierCard "Billing"
        ("Stripe-style charge events tagged service.namespace=/billing. " ++
            String.fromInt model.billingHits ++ " hits this session.")
        [ tierButton EmitBillingLog "Emit charge.success"
        , tierButton EmitErrorLog "Emit charge.failed (error)"
        ]


viewJobs : Model -> Html Msg
viewJobs model =
    tierCard "Jobs"
        ("Background-task events tagged service.namespace=/jobs. " ++
            String.fromInt model.jobsHits ++ " hits this session.")
        [ tierButton EmitJobsLog "Emit enqueue"
        ]


viewAuth : Model -> Html Msg
viewAuth model =
    tierCard "Auth"
        ("Sign-in / token events tagged service.namespace=/auth. " ++
            String.fromInt model.authHits ++ " hits this session.")
        [ tierButton EmitAuthLog "Emit sign-in"
        ]


statsCard : Model -> Html Msg
statsCard model =
    div [ style "margin-top: 16px; padding: 16px; background: #f6f6f6; border-radius: 4px;" ]
        [ div [] [ text ("Billing hits: " ++ String.fromInt model.billingHits) ]
        , div [] [ text ("Jobs hits:    " ++ String.fromInt model.jobsHits) ]
        , div [] [ text ("Auth hits:    " ++ String.fromInt model.authHits) ]
        , div [] [ text ("Ticks:        " ++ String.fromInt model.ticks) ]
        ]


tierCard : String -> String -> List (Html Msg) -> Html Msg
tierCard label descr buttons =
    div []
        [ h2 [] [ text label ]
        , p [ style "color: #555; line-height: 1.5;" ] [ text descr ]
        , div [ style "margin-top: 16px;" ] buttons
        , p [ style "color: #888; margin-top: 24px; font-size: 13px;" ]
            [ text "After emitting some events, visit "
            , a [ href "/_sky/console" ] [ text "/_sky/console" ]
            , text " and filter the Logs tab by this tier's namespace."
            ]
        ]


tierButton : Msg -> String -> Html Msg
tierButton msg label =
    button
        [ onClick msg
        , style "margin-right: 8px; padding: 8px 14px; background: #ff6600; color: #fff; border: none; cursor: pointer; border-radius: 4px;"
        ]
        [ text label ]


subscriptions : Model -> Sub Msg
subscriptions _ =
    Sub.none


main =
    app
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        , routes =
            [ route "/" HostPage
            , route "/billing" BillingPage
            , route "/jobs" JobsPage
            , route "/auth" AuthPage
            ]
        , notFound = HostPage
        }
