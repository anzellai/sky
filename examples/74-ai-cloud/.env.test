# Test mode: under `sky test` every Google Cloud call (OAuth, the metadata
# server, Vertex AI, Cloud Run, Cloud Storage, Artifact Registry) is answered
# by the runtime's built-in emulator, statefully, so a whole cloud training
# run and a deployment run offline. The values below are placeholders the
# emulator accepts; none is a real project, image or token.
SKY_AI_GCP_ENDPOINT=http://sky-gcp.invalid
SKY_AI_TRAIN_PROJECT=demo-project
SKY_AI_TRAIN_STAGING=gs://demo-bucket/sky
SKY_AI_TRAIN_IMAGE=us-central1-docker.pkg.dev/demo-project/sky/sky-ai-trainer@sha256:1111111111111111111111111111111111111111111111111111111111111111
SKY_AI_SERVE_PROJECT=demo-project
SKY_AI_SERVE_IMAGE=us-central1-docker.pkg.dev/demo-project/sky/sky-ai-tier@sha256:2222222222222222222222222222222222222222222222222222222222222222
SKY_AI_SUPPORT_URL=https://support-tier-fake.a.run.app/v1
SKY_AI_SUPPORT_KEY=test-only-token
