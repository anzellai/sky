module Main exposing (main, config)

{-| Train a support adapter on Google Cloud, serve it from a private GPU
tier, and ask it, from one web page.

1.  The page freezes data/support.jsonl into a dataset version.
2.  "Train on Vertex AI" starts the durable training run (`Train.start`): the
    job is checked, priced and budgeted before anything launches, then runs
    the Unsloth trainer on one NVIDIA L4 as a Vertex AI custom job. A tick
    advances the run (`Train.poll`) and shows its step, losses, job state and
    spend against the budget.
3.  The adapter comes back, is converted to GGUF, and is registered with its
    lineage; the page points `dev` at it. `sky ai eval support --candidate
    support@v1 --against prod --promote-to prod` gates it on the eval suite
    and promotes it (src/Ai.sky).
4.  "Deploy the tier" puts the GPU tier on Cloud Run (`Serve.deploy`): vLLM
    with one L4 that scales to zero, which loads `support@prod` and hot-loads
    each promotion. The "Ask" box calls the tier through the `support` slot.

`sky run src/Main.sky`, then open http://localhost:8074. README.md has the
one-time Google Cloud setup and what each step costs.
-}

import Sky.Core.Prelude exposing (..)
import Sky.Core.Task as Task
import Sky.Core.Error as Error exposing (Error)
import Sky.Core.String as String
import Sky.Core.List as List
import Sky.Core.Maybe as Maybe exposing (Maybe(..))
import Sky.Core.Math as Math
import Sky.Core.System as System
import Std.App as App
import Std.Cmd as Cmd
import Std.Sub as Sub
import Std.Money as Money
import Std.Ui as Ui exposing (Element)
import Std.Ui.Background as Background
import Std.Ui.Border as Border
import Std.Ui.Font as Font
import Std.Ui.Input as Input
import Std.Ai.Dataset as Dataset
import Std.Ai.Endpoint as Endpoint
import Std.Ai.Provider as Provider
import Std.Ai.Serve as Serve
import Std.Ai.Train as Train exposing (Status(..))
import Sky.Config as Config exposing (Database(..), Sessions(..))
import Cloud

-- ── Model ───────────────────────────────────────────────────────────
type alias Model =
    { dataset : String
    , progress : Maybe Train.Progress
    , cloud : Maybe Train.CloudStatus
    , adapter : Maybe Train.Adapter
    , promoted : String
    , tierUrl : String
    , deploying : Bool
    , polling : Bool
    , question : String
    , answer : String
    , error : String
    }

type Msg
    = Loaded (Result Error Dataset.Manifest)
    | StartTraining
    | Started (Result Error String)
    | Tick
    | Advanced (Result Error Bool)
    | Read (Result Error ( Train.Progress, Maybe Train.CloudStatus ))
    | Finished (Result Error (Maybe Train.Adapter))
    | Promoted (Result Error String)
    | CancelTraining
    | CancelSent (Result Error Bool)
    | Deploy
    | Deployed (Result Error Serve.Deployment)
    | Question String
    | Ask
    | Answered (Result Error String)


init : () -> ( Model, Cmd Msg )
init _ =
    ( { dataset = ""
      , progress = Nothing
      , cloud = Nothing
      , adapter = Nothing
      , promoted = ""
      , tierUrl = ""
      , deploying = False
      , polling = False
      , question = "How do I get a refund?"
      , answer = ""
      , error = ""
      }
    , Cmd.perform
          (Cloud.open |> Task.map (\w -> Dataset.manifest w.version))
          Loaded
    )


-- ── Commands ────────────────────────────────────────────────────────
withJob : (Cloud.World -> Train.Job -> Task Error a) -> Task Error a
withJob f =
    Cloud.open |> Task.andThen (\w -> f w (Cloud.trainJob w))


readProgress : () -> Cmd Msg
readProgress _ =
    Cmd.perform
        (withJob
            (\_ job ->
                Task.map2
                    (\p c -> ( p, c ))
                    (Train.progress job)
                    (Train.cloudStatus job)))
        Read


advance : () -> Cmd Msg
advance _ =
    Cmd.perform (withJob (\w job -> Train.poll w.db [ job ])) Advanced


finished : Status -> Bool
finished s =
    s == Done || s == Failed || s == Cancelled


active : Model -> Bool
active model =
    case model.progress of

        Just p ->
            not (finished p.status)

        Nothing ->
            False


-- ── Update ──────────────────────────────────────────────────────────
update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of

        Loaded (Ok m) ->
            ( { model
                  | dataset =
                      m.name ++ "@" ++ String.left 12 m.digest ++ " · "
                          ++ String.fromInt m.train
                          ++ " train rows, "
                          ++ String.fromInt m.eval
                          ++ " eval rows"
              }
            , readProgress ()
            )

        Loaded (Err e) ->
            ( { model | error = Error.toString e }, Cmd.none )

        StartTraining ->
            ( { model | error = "", adapter = Nothing, promoted = "" }
            , Cmd.perform (withJob (\w job -> Train.start w.db job)) Started
            )

        Started (Ok id) ->
            ( { model | progress = Just (Train.emptyProgress id) }, advance () )

        Started (Err e) ->
            ( { model | error = Error.toString e }, Cmd.none )

        Tick ->
            if active model && not model.polling then
                ( { model | polling = True }
                , Cmd.batch [ advance (), readProgress () ]
                )

            else
                ( model, Cmd.none )

        Advanced (Ok _) ->
            ( { model | polling = False }, readProgress () )

        Advanced (Err e) ->
            ( { model | polling = False, error = Error.toString e }
            , readProgress ()
            )

        Read (Ok ( p, c )) ->
            if p.status == Done && model.adapter == Nothing then
                ( { model | progress = Just p, cloud = c }
                , Cmd.perform (withJob (\_ job -> Train.result job)) Finished
                )

            else
                ( { model | progress = Just p, cloud = c }, Cmd.none )

        Read (Err e) ->
            ( { model | error = Error.toString e }, Cmd.none )

        Finished (Ok (Just a)) ->
            ( { model | adapter = Just a }
            , Cmd.perform
                  (Cloud.open |> Task.andThen (\w -> Cloud.promoteDev w a))
                  Promoted
            )

        Finished (Ok Nothing) ->
            ( model, Cmd.none )

        Finished (Err e) ->
            ( { model | error = Error.toString e }, Cmd.none )

        Promoted (Ok label) ->
            ( { model | promoted = label }, Cmd.none )

        Promoted (Err e) ->
            ( { model | error = Error.toString e }, Cmd.none )

        CancelTraining ->
            ( model
            , Cmd.perform (withJob (\_ job -> Train.cancel job)) CancelSent
            )

        CancelSent _ ->
            ( model, readProgress () )

        Deploy ->
            ( { model | deploying = True, error = "" }
            , Cmd.perform
                  (Serve.deploy
                      (Cloud.target (System.getenvOr "SKY_AI_REGISTRY" ""))
                      Cloud.tier)
                  Deployed
            )

        Deployed (Ok d) ->
            ( { model | deploying = False, tierUrl = d.url }, Cmd.none )

        Deployed (Err e) ->
            ( { model | deploying = False, error = Error.toString e }
            , Cmd.none
            )

        Question q ->
            ( { model | question = q }, Cmd.none )

        Ask ->
            ( { model | answer = "…" }
            , Cmd.perform
                  (Provider.chat
                      (Endpoint.provider (Cloud.supportSlot ()))
                      [ Provider.user model.question ]
                      |> Task.map .content)
                  Answered
            )

        Answered (Ok text) ->
            ( { model | answer = text }, Cmd.none )

        Answered (Err e) ->
            ( { model | answer = "", error = Error.toString e }, Cmd.none )


subscriptions : Model -> Sub.Sub Msg
subscriptions model =
    if active model then
        Sub.every 2000 Tick

    else
        Sub.none


-- ── View ────────────────────────────────────────────────────────────
ink : Ui.Color
ink =
    Ui.rgb 28 30 38


muted : Ui.Color
muted =
    Ui.rgb 110 114 128


accent : Ui.Color
accent =
    Ui.rgb 44 94 196


card : String -> List (Element Msg) -> Element Msg
card title body =
    Ui.column
        [ Ui.width Ui.fill
        , Ui.padding 20
        , Ui.spacing 12
        , Background.color (Ui.rgb 255 255 255)
        , Border.rounded 10
        , Border.width 1
        , Border.color (Ui.rgb 224 226 232)
        ]
        (Ui.el [ Font.size 18, Font.bold ] (Ui.text title) :: body)


line : String -> String -> Element Msg
line label value =
    Ui.row
        [ Ui.spacing 12 ]
        [ Ui.el [ Font.color muted, Ui.width (Ui.px 140) ] (Ui.text label)
        , Ui.text value
        ]


button : String -> Msg -> Bool -> Element Msg
button label msg enabled =
    Ui.button
        [ Ui.paddingXY 16 8
        , Border.rounded 6
        , Background.color
              (if enabled then
                  accent

              else
                  Ui.rgb 170 176 190)
        , Font.color (Ui.rgb 255 255 255)
        ]
        { onPress =
            if enabled then
                Just msg

            else
                Nothing
        , label = Ui.text label
        }


bar : Int -> Int -> Element Msg
bar done total =
    let
        width =
            if total <= 0 then
                0

            else
                400 * done // total
    in
        Ui.el
            [ Ui.width (Ui.px 400)
            , Ui.height (Ui.px 10)
            , Background.color (Ui.rgb 230 232 238)
            , Border.rounded 5
            ]
            (Ui.el
                [ Ui.width (Ui.px width)
                , Ui.height (Ui.px 10)
                , Background.color accent
                , Border.rounded 5
                ]
                Ui.none)


lossText : Maybe Float -> String
lossText l =
    case l of

        Just v ->
            String.left 6 (String.fromFloat v)

        Nothing ->
            "–"


cloudLines : Maybe Train.CloudStatus -> List (Element Msg)
cloudLines c =
    case c of

        Just s ->
            [ line "where" ("Vertex AI " ++ s.region ++ " · " ++ s.machine)
            , line
                  "job"
                  (s.state ++ " (attempt " ++ String.fromInt s.attempt ++ ")")
            , line
                  "spend"
                  (Money.formatWithCode s.spent ++ " of "
                      ++ Money.formatWithCode s.budget)
            ]

        Nothing ->
            []


trainingCard : Model -> Element Msg
trainingCard model =
    case model.progress of

        Nothing ->
            card
                "Training on Vertex AI"
                [ Ui.paragraph
                      [ Font.color muted ]
                      [ Ui.text
                            "No run yet. The job is QLoRA on one NVIDIA L4 for at most USD 2; set SKY_AI_TRAIN_PROJECT, _STAGING and _IMAGE first (README.md)."
                      ]
                , button
                      "Train on Vertex AI"
                      StartTraining
                      (model.dataset /= "")
                ]

        Just p ->
            card
                "Training on Vertex AI"
                ([ line "run" p.runId
                , line "status" (Train.statusText p.status)
                , line
                      "step"
                      (String.fromInt p.step ++ " of "
                          ++ String.fromInt p.totalSteps)
                , bar p.step p.totalSteps
                , line "train loss" (lossText p.loss)
                , line "eval loss" (lossText p.valLoss)
                ]
                    ++ cloudLines model.cloud
                    ++ [ if active model then
                             button "Cancel" CancelTraining True

                         else
                             button "Train again" StartTraining True
                       ])


adapterCard : Model -> Element Msg
adapterCard model =
    case model.adapter of

        Nothing ->
            Ui.none

        Just a ->
            card
                "Adapter"
                [ line "trained" (Cloud.describe a)
                , line "registered" (Maybe.withDefault "–" a.registered)
                , line
                      "dev"
                      (if String.isEmpty model.promoted then
                          "–"

                      else
                          model.promoted)
                , Ui.paragraph
                      [ Font.color muted ]
                      [ Ui.text
                            "Gate it and promote it: sky ai eval support --candidate support@v1 --against prod --promote-to prod"
                      ]
                ]


tierCard : Model -> Element Msg
tierCard model =
    card
        "GPU tier on Cloud Run"
        [ line
              "service"
              (if String.isEmpty model.tierUrl then
                  "not deployed from this page"

              else
                  model.tierUrl)
        , button
              (if model.deploying then
                  "Deploying…"

              else
                  "Deploy the tier")
              Deploy
              (not model.deploying)
        ]


askCard : Model -> Element Msg
askCard model =
    card
        "Ask support@prod"
        [ Input.text
              [ Ui.width Ui.fill ]
              { onChange = Question
              , text = model.question
              , placeholder = Nothing
              , label =
                  Input.labelAbove [ Font.color muted ] (Ui.text "Question")
              }
        , button "Ask" Ask (not (String.isEmpty model.question))
        , Ui.paragraph [] [ Ui.text model.answer ]
        ]


view : Model -> Element Msg
view model =
    Ui.column
        [ Ui.width (Ui.maximum 760 Ui.fill)
        , Ui.centerX
        , Ui.padding 24
        , Ui.spacing 16
        , Background.color (Ui.rgb 246 247 250)
        , Font.color ink
        , Font.family "system-ui, -apple-system, sans-serif"
        , Font.size 14
        ]
        [ Ui.el
              [ Font.size 24, Font.bold ]
              (Ui.text "Train in the cloud, serve from a GPU tier")
        , card
              "Dataset"
              [ line
                    "version"
                    (if String.isEmpty model.dataset then
                        "freezing data/support.jsonl…"

                    else
                        model.dataset)
              ]
        , trainingCard model
        , adapterCard model
        , tierCard model
        , askCard model
        , if String.isEmpty model.error then
              Ui.none

          else
              Ui.paragraph
                  [ Font.color (Ui.rgb 178 34 34) ]
                  [ Ui.text model.error ]
        ]


appDef =
    App.app
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        }
        |> App.withNotFound ()
        |> App.withConfig (App.WebConfig { App.webDefaults | port = 8074 })


-- The app's database: the durable training runs and the registry's records.
-- SQLite here; `Config.withDatabase (Postgres …)` or SKY_DB_PATH /
-- DATABASE_URL move it without another change.
config : Config.Config
config =
    Config.default |> Config.withDatabase (Sqlite "cloud.db")
        |> Config.withSessions Memory


main =
    App.run appDef
