module Main exposing (main)

-- Regression for two Rust-codegen bugs surfaced by the skydeploy control-plane,
-- fixed in v0.18.1. Both type-check fine in BOTH compilers; both broke `go
-- build` under the Rust primary before v0.18.1. (Built Rust-only by the
-- `build-run` gate — NOT oracle-matched: Bug A is a Rust codegen improvement the
-- Haskell oracle's codegen never had, so the oracle cannot build this example.
-- See docs/rust-rewrite/known-divergences.md.)
--
--   Bug B (regression vs oracle, now re-matched) — an OPEN record row whose
--   unresolved tail dropped a field lowered a closure parameter to a lossy
--   SUBSET struct. A `List.find` predicate that reads a field NONE of the result
--   branches read (`\c -> c.primary`, while the `Just` branch reads `.email`)
--   emitted `struct{Email;Verified}` and then `v.Primary` on it → "undefined
--   field". Fixed by widening such a closure param to `any` (the field access
--   routes through `rt.Field`).
--
--   Bug A (Rust beyond oracle) — a GENERIC kernel used as a first-class VALUE
--   (`JsonEnc.list identity` over a `List Value`) emitted the Go generic
--   `rt.Basics_identity` uninstantiated → "cannot use generic function without
--   instantiation". Fixed by instantiating value-position references
--   (`rt.Basics_identity[any]`). The oracle's codegen emits it bare and go build
--   rejects it too — so this is a capability the Rust primary gained, not a
--   regression it repaired.

import Sky.Core.Prelude exposing (..)
import Sky.Core.List as List
import Sky.Core.Json.Encode as JsonEnc
import Std.Log exposing (println)

type alias Contact =
    { email : String
    , primary : Bool
    , verified : Bool
    }


-- Bug B: `primary` is read ONLY by the `List.find` predicate; the `Just`
-- branches read `.email`. The element row's tail must not be dropped.
pickPrimary : List Contact -> String
pickPrimary contacts =
    case List.find (\c -> c.primary) contacts of

        Just c ->
            c.email

        Nothing ->
            case List.find (\c -> c.verified) contacts of

                Just v ->
                    v.email

                Nothing ->
                    "none"


-- Bug A: `identity` (a generic kernel) handed to `JsonEnc.list : (a -> Value) ->
-- List a -> Value` as a bare value, over an already-encoded `List Value`.
encodeVals : String
encodeVals =
    let
        vals = List.map JsonEnc.string [ "one", "two", "three" ]
    in
        JsonEnc.encode 0 (JsonEnc.list identity vals)


main =
    let
        contacts =
            [ { email = "a@x.com", primary = False, verified = True }
            , { email = "b@x.com", primary = True, verified = True }
            ]
        _ = println (pickPrimary contacts)
        _ = println encodeVals
    in
        println "done"
