# Production config for the blog — copy to `.env` (gitignored) and edit.
# Sky loads `.env` via System.loadEnv at startup; precedence is
# process env > .env > sky.toml. Dev needs none of this.

# Production gate: locks the dev console/banner off + metrics behind auth.
ENV=production

# ── ONE database for everything ──────────────────────────────────────────────
# This single URL wires the app DB (Std.Db), Sky.Live sessions, Std.Analytics,
# AND console telemetry into one Postgres (started by docker-compose.yml on
# host port 5452). No separate paths needed — each store falls back to it.
DATABASE_URL=postgres://blog:blog@localhost:5452/blog?sslmode=disable

# Put sessions in Postgres too (falls back to DATABASE_URL when no storePath).
SKY_LIVE_STORE=postgres

# Analytics retention — prune events older than this so the table stays bounded.
SKY_ANALYTICS_RETENTION=180d

# ── Secrets (never commit real values) ───────────────────────────────────────
# >= 32 bytes. Generate: openssl rand -hex 32
SKY_AUTH_TOKEN_SECRET=change-me-to-a-32-byte-random-secret-000000

# Admin password for the blog's /admin (this example reads BLOG_ADMIN_PASSWORD).
BLOG_ADMIN_PASSWORD=change-me
