module Lib.Db exposing
    ( conn
    , User
    , Session
    , Note
    , SessionUser
    , userStore
    , sessionStore
    , noteStore
    , sessionUserCodec
    )

import Sky.Core.Prelude exposing (..)
import Sky.Core.System as System
import Sky.Core.Task as Task
import Sky.Core.Error as Error exposing (Error)
import Std.Log exposing (println)
import Std.Codec as Codec exposing (Codec)
import Std.Db as Db
import Std.Db.Store as Store exposing (Store)


-- One memoised connection (CAF) shared by every Store op. Db.connect reads
-- SKY_DB_PATH (default skynotes.db).
conn =
    case Task.run (Db.connect ()) of

        Ok c ->
            c

        Err e ->
            let
                _ =
                    println
                        ("[FATAL] Cannot open the database: " ++ Error.toString e)
            in
                System.exit 1

-- ── Typed rows ──────────────────────────────────────────────────────
type alias User =
    { id : Int
    , email : String
    , passwordHash : String
    , verified : Int
    , verificationToken : String
    , createdAt : String
    }

type alias Session =
    { id : Int
    , userId : Int
    , token : String
    , createdAt : String
    }

type alias Note =
    { id : Int
    , userId : Int
    , title : String
    , content : String
    , createdAt : String
    , updatedAt : String
    }


-- ── Stores (one Codec.auto each drives DDL + reads + writes) ─────────
userStore : Store User
userStore =
    Store.fromCodec
        "users"
        (Codec.auto
            { id = 0
            , email = ""
            , passwordHash = ""
            , verified = 0
            , verificationToken = ""
            , createdAt = ""
            })
        |> Store.serial "id"
        |> Store.unique "email"
        |> Store.defaultInt "verified" 0
        |> Store.defaultNow "createdAt"


sessionStore : Store Session
sessionStore =
    Store.fromCodec
        "sessions"
        (Codec.auto { id = 0, userId = 0, token = "", createdAt = "" })
        |> Store.serial "id"
        |> Store.unique "token"
        |> Store.defaultNow "createdAt"


noteStore : Store Note
noteStore =
    Store.fromCodec
        "notes"
        (Codec.auto
            { id = 0
            , userId = 0
            , title = ""
            , content = ""
            , createdAt = ""
            , updatedAt = ""
            })
        |> Store.serial "id"
        |> Store.defaultText "content" ""
        |> Store.defaultNow "createdAt"
        |> Store.touchOnUpdate "updatedAt"

-- ── JOIN projection (users ⋈ sessions), decoded by Store.selectRaw ──
type alias SessionUser =
    { id : Int
    , email : String
    , createdAt : String
    }


sessionUserCodec : Codec SessionUser
sessionUserCodec =
    Codec.auto { id = 0, email = "", createdAt = "" }
