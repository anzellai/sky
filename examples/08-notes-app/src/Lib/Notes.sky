module Lib.Notes exposing (createNote, updateNote, deleteNote, getNotes, getNote)

import Sky.Core.Prelude exposing (..)
import Sky.Core.Maybe exposing (..)
import Sky.Core.List as List
import Sky.Core.Task as Task
import Sky.Core.Error as Error exposing (Error)
import Std.Db exposing (SqlValue(..))
import Std.Db.Store as Store
import Lib.Db as Db exposing (Note)


-- createNote : Result Error () — DB stamps id/created_at/updated_at.
createNote : Int -> String -> String -> Result Error ()
createNote userId title content =
    let
        newNote =
            { id = 0
            , userId = userId
            , title = title
            , content = content
            , createdAt = ""
            , updatedAt = ""
            }
    in
        case Task.run (Store.insert Db.conn Db.noteStore newNote) of

            Ok _ ->
                Ok ()

            Err e ->
                Err e


-- updateNote : ownership-scoped update. Store.updateWhere sets the record's
-- columns WHERE id = ? AND user_id = ? (so one user can't edit another's
-- note); touchOnUpdate bumps updated_at with no raw SQL.
updateNote : String -> Int -> String -> String -> Result Error ()
updateNote noteId userId title content =
    case Task.run (getNoteTask noteId userId) of

        Err e ->
            Err e

        Ok Nothing ->
            Ok ()

        Ok (Just note) ->
            let
                changed = { note | title = title, content = content }
                cond =
                    Store.and_
                        [ Store.eq "id" (SqlInt note.id)
                        , Store.eq "userId" (SqlInt userId)
                        ]
            in
                case Task.run
                         (Store.updateWhere Db.conn Db.noteStore cond changed) of

                    Ok _ ->
                        Ok ()

                    Err e ->
                        Err e


deleteNote : String -> Int -> Result Error ()
deleteNote noteId userId =
    let
        cond =
            Store.and_
                [ Store.eq "id" (SqlString noteId)
                , Store.eq "userId" (SqlInt userId)
                ]
    in
        case Task.run (Store.deleteWhere Db.conn Db.noteStore cond) of

            Ok _ ->
                Ok ()

            Err e ->
                Err e


-- getNotes : Result Error (List Note) — this user's notes, newest edit first.
getNotes : Int -> Result Error (List Note)
getNotes userId =
    Task.run
        (Store.query Db.noteStore
            |> Store.where_ (Store.eq "userId" (SqlInt userId))
            |> Store.orderDesc "updatedAt"
            |> Store.toList Db.conn)


getNote : String -> Int -> Result Error (Maybe Note)
getNote noteId userId =
    Task.run (getNoteTask noteId userId)


getNoteTask : String -> Int -> Task Error (Maybe Note)
getNoteTask noteId userId =
    Store.query Db.noteStore |> Store.where_ (Store.eq "id" (SqlString noteId))
        |> Store.where_ (Store.eq "userId" (SqlInt userId))
        |> Store.toMaybe Db.conn
