module Lib.Auth exposing
    ( hashPassword
    , verifyPassword
    , generateToken
    , createUser
    , authenticateUser
    , createSession
    , getSessionUser
    , verifyEmail
    )

import Sky.Core.Prelude exposing (..)
import Sky.Core.Maybe exposing (..)
import Sky.Core.Result as Result
import Sky.Core.List as List
import Sky.Core.String as String
import Sky.Core.Task as Task
import Sky.Core.Error as Error exposing (Error)
import Std.Log exposing (println)
import Github.Com.Google.Uuid as Uuid
import Std.Auth as Auth
import Std.Db exposing (SqlValue(..))
import Std.Db.Store as Store
import Lib.Db as Db exposing (User, SessionUser)


hashPassword : String -> String
hashPassword password =
    case Auth.hashPassword password of

        Ok hash ->
            hash

        Err _ ->
            ""


verifyPassword : String -> String -> Bool
verifyPassword password storedHash =
    Result.withDefault False (Auth.verifyPassword password storedHash)


generateToken _ =
    Result.withDefault "" (Uuid.newString ())


-- createUser : Result Error String (verification token). The UNIQUE email
-- constraint (Store.unique "email") turns a duplicate into a driver error,
-- which we present as InvalidInput so the form renders it inline.
createUser : String -> String -> Result Error String
createUser email password =
    let
        passHash = hashPassword password
        token = generateToken ()
        _ = println ""
        _ = println "=========================================="
        _ = println "[Email Service] New user registration"
        _ = println ("[Email Service] To: " ++ email)
        _ = println "[Email Service] Verify your email at:"
        _ = println ("  http://localhost:8000/auth/verify?token=" ++ token)
        _ = println "=========================================="
        _ = println ""
        newUser =
            { id = 0
            , email = email
            , passwordHash = passHash
            , verified = 0
            , verificationToken = token
            , createdAt = ""
            }
    in
        case Task.run (Store.insert Db.conn Db.userStore newUser) of

            Ok _ ->
                Ok token

            Err _ ->
                Err
                    (Error.invalidInput
                        "That email is already registered, or a server error occurred.")


-- Verifies the password + verified flag, returning the whole user on success.
checkCredentials : String -> User -> Result Error User
checkCredentials password user =
    if verifyPassword password user.passwordHash then
        if user.verified == 1 then
            Ok user

        else
            Err
                (Error.permissionDenied
                    |> Error.withMessage
                           "Email not verified yet. Please check the server console for your verification link.")

    else
        Err
            (Error.permissionDenied
                |> Error.withMessage "Invalid email or password.")


-- authenticateUser : Result Error User. Wrong email / wrong password both
-- PermissionDenied; DB errors surface upstream.
authenticateUser : String -> String -> Result Error User
authenticateUser email password =
    case Task.run (Store.findBy Db.conn Db.userStore "email" email) of

        Err e ->
            Err e

        Ok Nothing ->
            Err
                (Error.permissionDenied
                    |> Error.withMessage "Invalid email or password.")

        Ok (Just user) ->
            checkCredentials password user


-- createSession : Result Error String — generates a token, inserts the row,
-- returns the token for the cookie.
createSession : Int -> Result Error String
createSession userId =
    let
        token = generateToken ()
        newSession =
            { id = 0, userId = userId, token = token, createdAt = "" }
    in
        case Task.run (Store.insert Db.conn Db.sessionStore newSession) of

            Ok _ ->
                Ok token

            Err e ->
                Err e


-- getSessionUser : Result Error (Maybe SessionUser). A JOIN (users ⋈
-- sessions) — a single-table Store can't express it, so `Store.selectRaw`
-- runs the SQL and decodes each row into the typed `SessionUser` projection.
getSessionUser : String -> Result Error (Maybe SessionUser)
getSessionUser sessionToken =
    case Task.run
             (Store.selectRaw
                 Db.conn
                 Db.sessionUserCodec
                 "SELECT u.id, u.email, u.created_at FROM users u INNER JOIN sessions s ON u.id = s.user_id WHERE s.token = ? LIMIT 1"
                 [ SqlString sessionToken ]) of

        Err e ->
            Err e

        Ok rows ->
            Ok (List.head rows)


-- verifyEmail : Result Error String — flip verified=1 for the row matching the
-- verification token (only while still unverified), via a typed read-write.
verifyEmail : String -> Result Error String
verifyEmail token =
    case Task.run (findByToken token) of

        Err e ->
            Err e

        Ok Nothing ->
            Ok "Your email has been verified! You can now sign in."

        Ok (Just user) ->
            case Task.run
                     (Store.update Db.conn Db.userStore { user | verified = 1 }) of

                Err e ->
                    Err e

                Ok _ ->
                    Ok "Your email has been verified! You can now sign in."


findByToken : String -> Task Error (Maybe User)
findByToken token =
    Store.query Db.userStore
        |> Store.where_ (Store.eq "verificationToken" (SqlString token))
        |> Store.where_ (Store.eq "verified" (SqlInt 0))
        |> Store.toMaybe Db.conn
