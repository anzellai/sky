module Main exposing (main)

import Sky.Core.Prelude exposing (..)
import Sky.Core.String as String
import Sky.Core.Error exposing (Error)
import Std.Spa as Spa
import Std.Sub as Sub
import Std.Html as Html exposing (Html)
import Std.Html.Attributes as Attr
import Std.Html.Events as Events


-- P4 client-side routing acceptance app. Three routes + a notFound page, plus a
-- pure client-side counter to prove navigation does NOT reload the app (the
-- count survives a route change — zero round-trip). `withOnNavigate Navigated`
-- records a nav count so the hook is exercised too. The model has a `page`
-- field the runtime owns (the Sky.Live convention).


type Page
    = Home
    | About
    | NotFound


type alias Model =
    { page : Page
    , count : Int
    , navs : Int
    }


type Msg
    = Increment
    | Navigated Page


init : a -> ( Model, Cmd Msg )
init _ =
    ( { page = Home, count = 0, navs = 0 }, Cmd.none )


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of
        Increment ->
            ( { model | count = model.count + 1 }, Cmd.none )

        Navigated _ ->
            ( { model | navs = model.navs + 1 }, Cmd.none )


pageName : Page -> String
pageName page =
    case page of
        Home ->
            "home"

        About ->
            "about"

        NotFound ->
            "notfound"


view : Model -> Html Msg
view model =
    Html.div []
        [ Html.h1 [ Attr.id "page" ] [ Html.text (pageName model.page) ]
        , Html.p [ Attr.id "count" ] [ Html.text (String.fromInt model.count) ]
        , Html.p [ Attr.id "navs" ] [ Html.text (String.fromInt model.navs) ]
        , Html.a [ Attr.id "to-home", Attr.href "/" ] [ Html.text "Home" ]
        , Html.a [ Attr.id "to-about", Attr.href "/about" ] [ Html.text "About" ]
        , Html.a
            [ Attr.id "to-ext"
            , Attr.href "https://example.com/x"
            ]
            [ Html.text "External" ]
        , Html.button [ Attr.id "inc", Events.onClick Increment ]
            [ Html.text "+" ]
        ]


subscriptions : Model -> Sub Msg
subscriptions _ =
    Sub.none


main : Task Error ()
main =
    Spa.app
        (Spa.config
            { init = init
            , update = update
            , view = view
            , subscriptions = subscriptions
            }
            |> Spa.withRoutes
                [ Spa.route "/" Home
                , Spa.route "/about" About
                ]
            |> Spa.withNotFound NotFound
            |> Spa.withOnNavigate Navigated
        )
