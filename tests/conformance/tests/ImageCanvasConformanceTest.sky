module ImageCanvasConformanceTest exposing (main, tests)

-- Behavioural conformance for Std.Image.Canvas (v0.29.0) through the Sky API:
-- every output format at the canvas size, the drawing steps (seen through
-- pixelDiff), a persistent display list, text and measure with the built-in
-- font, masks and pasting, and the refusals (a colour channel out of range, a
-- canvas too large, a 400-megapixel paste, a missing or bad font, images of
-- different sizes). The use case beyond the request: an Open Graph card with
-- an initials avatar in a round mask and a QR code drawn from Std.Qr.
--
-- The pixel arithmetic (shapes, blur, the phone-frame reference, measure
-- against the font tables, WebP pixel-exact) is checked in
-- runtime-go/rt/canvas_kernels_test.go.

import Sky.Core.Prelude exposing (..)
import Sky.Core.Encoding as Encoding
import Sky.Core.Error as Error exposing (Error, ErrorKind(..))
import Sky.Core.Task as Task
import Std.Image as Image
import Std.Image.Canvas as Canvas exposing (Canvas, Paint(..))
import Std.Qr as Qr
import Sky.Test as Test exposing (Test)


white : Canvas.Rgba
white =
    Canvas.rgba 255 255 255 255


black : Canvas.Rgba
black =
    Canvas.rgba 0 0 0 255


blue : Canvas.Rgba
blue =
    Canvas.rgba 70 110 220 255


hugePng : String
hugePng =
    Result.withDefault
        ""
        (Encoding.base64Decode
            "iVBORw0KGgoAAAANSUhEUgAATiAAAE4gCAYAAADjcEY5AAAAEUlEQVR4nGJiYGBgAAQAAP//AA8AA/6P688AAAAASUVORK5CYII=")


png : Canvas -> String
png c =
    Result.withDefault "" (Task.run (Canvas.encode Image.Png c))


sizeOf : Task Error String -> String
sizeOf t =
    case Task.run (t |> Task.andThen Image.dimensions) of

        Ok d ->
            String.fromInt d.width ++ "x" ++ String.fromInt d.height

        Err _ ->
            "err"


codeOf : Task Error a -> String
codeOf t =
    case Task.run t of

        Ok _ ->
            "ok"

        Err e ->
            case Error.failureOf e of

                Just f ->
                    Error.failureDomain f ++ "/" ++ Error.failureCode f

                Nothing ->
                    "no-domain"


diff : Canvas -> Canvas -> Result Error Int
diff a b =
    Task.run (Canvas.pixelDiff 0 (png a) (png b))


base : Canvas
base =
    Canvas.blank 30 20 white


qrCanvas : String -> Canvas
qrCanvas url =
    case Qr.encode Qr.Medium url of

        Ok code ->
            Qr.rows code
                |> List.indexedMap
                       (\y row -> List.indexedMap (\x dark -> ( x, y, dark )) row)
                |> List.concat
                |> List.foldl
                       (\( x, y, dark ) c ->
                           if dark then
                               Canvas.rect
                                   ((x + 4) * 4)
                                   ((y + 4) * 4)
                                   4
                                   4
                                   (Fill black)
                                   c

                           else
                               c)
                       (Canvas.blank
                           ((Qr.size code + 8) * 4)
                           ((Qr.size code + 8) * 4)
                           white)

        Err _ ->
            Canvas.blank 1 1 white


avatar : String -> Canvas
avatar initials =
    let
        m = Canvas.measure Canvas.defaultFont 72.0 initials
    in
        Canvas.blank 160 160 blue
            |> Canvas.text
                   { font = Canvas.defaultFont, size = 72.0, colour = white }
                   ((160 - m.width) // 2)
                   ((160 - m.height) // 2)
                   initials


ogCard : String -> String -> Canvas
ogCard title url =
    let
        qr = qrCanvas url
    in
        Canvas.blank 1200 630 (Canvas.rgba 250 250 252 255)
            |> Canvas.rect 0 0 1200 12 (Fill blue)
            |> Canvas.pasteCanvas
                   80
                   80
                   (Just (Canvas.ellipseMask 160 160))
                   (avatar "AL")
            |> Canvas.text
                   { font = Canvas.defaultFont, size = 64.0, colour = black }
                   80
                   300
                   title
            |> Canvas.pasteCanvas 900 330 Nothing qr


tests : List Test
tests =
    [ Test.test
          "every format writes the canvas size"
          (\_ ->
              Test.equal
                  [ "30x20", "30x20", "30x20", "30x20", "30x20" ]
                  (List.map
                      (\f -> sizeOf (Canvas.encode f base))
                      [ Image.Png
                      , Image.Jpeg 92
                      , Image.Gif
                      , Image.WebpLossless
                      , Image.Preserve
                      ]))
    , Test.test
          "WebpLossless writes a lossless WebP"
          (\_ ->
              Test.equal
                  "WEBPVP8L"
                  (Result.withDefault
                      ""
                      (Task.run (Canvas.encode Image.WebpLossless base))
                      |> String.slice 8 16))
    , Test.test
          "a 3 x 3 filled rectangle changes 9 pixels, an outline of 5 x 5 changes 16"
          (\_ ->
              Test.equal
                  ( Ok 9, Ok 16 )
                  ( diff base (Canvas.rect 2 2 3 3 (Fill black) base)
                  , diff base (Canvas.rect 2 2 5 5 (Stroke 1 black) base)
                  ))
    , Test.test
          "lossless WebP decodes to the same pixels as PNG"
          (\_ ->
              let
                  c =
                      base
                          |> Canvas.ellipse
                                 3
                                 3
                                 20
                                 12
                                 (Fill (Canvas.rgba 200 30 30 180))
              in
                  Test.equal
                      (Ok 0)
                      (Task.run
                          (Canvas.pixelDiff
                              0
                              (png c)
                              (Result.withDefault
                                  ""
                                  (Task.run (Canvas.encode Image.WebpLossless c))))))
    , Test.test
          "drawing on a canvas leaves the canvas it started from unchanged"
          (\_ ->
              let
                  a = Canvas.rect 0 0 5 5 (Fill black) base
                  b = Canvas.ellipse 10 5 10 10 (Fill black) base
              in
                  Test.equal ( Ok 0, True ) ( diff base base, diff a b /= Ok 0 ))
    , Test.test
          "text draws, measure gives ascent + descent as the height"
          (\_ ->
              let
                  m = Canvas.measure Canvas.defaultFont 32.0 "Sky"
              in
                  Test.equal
                      ( True, m.ascent + m.descent, True )
                      ( m.width > 30 && m.width < 80
                      , m.height
                      , diff
                            base
                            (Canvas.text
                                { font = Canvas.defaultFont
                                , size = 12.0
                                , colour = black
                                }
                                1
                                1
                                "Hi"
                                base)
                            /= Ok 0
                      ))
    , Test.test
          "arc, line, roundedRect, blur and resize draw"
          (\_ ->
              Test.equal
                  [ True, True, True, True, True ]
                  [ diff base (Canvas.arc 15 10 8 0.0 90.0 (Fill black) base)
                        /= Ok 0
                  , diff base (Canvas.line 0 0 29 19 2 black base) /= Ok 0
                  , diff
                        base
                        (Canvas.roundedRect 2 2 20 12 4 (Stroke 2 black) base)
                        /= Ok 0
                  , diff
                        (Canvas.rect 10 0 10 20 (Fill black) base)
                        (Canvas.rect 10 0 10 20 (Fill black) base
                            |> Canvas.blur 2.0)
                        /= Ok 0
                  , sizeOf
                        (Canvas.encode
                            Image.Png
                            (Canvas.resize Canvas.Lanczos 15 10 base))
                        == "15x10"
                  ])
    , Test.test
          "fromImage and paste through masks"
          (\_ ->
              let
                  photo = png (Canvas.blank 20 20 blue)
              in
                  Test.equal
                      ( "20x20", True, True )
                      ( sizeOf
                            (Canvas.encode Image.Png (Canvas.fromImage photo))
                      , diff
                            (Canvas.paste 5 0 Nothing photo base)
                            (Canvas.paste
                                5
                                0
                                (Just (Canvas.ellipseMask 20 20))
                                photo
                                base)
                            /= Ok 0
                      , diff
                            (Canvas.paste
                                5
                                0
                                (Just (Canvas.roundedMask 20 20 6))
                                photo
                                base)
                            (Canvas.paste
                                5
                                0
                                (Just
                                    (Canvas.alphaMask
                                        (png (Canvas.blank 20 20 white))))
                                photo
                                base)
                            /= Ok 0
                      ))
    , Test.test
          "an Rgba channel outside 0..255 fails at encode with colour_range"
          (\_ ->
              Test.equal
                  "image/colour_range"
                  (codeOf
                      (Canvas.encode
                          Image.Png
                          (Canvas.rect
                              0
                              0
                              2
                              2
                              (Fill (Canvas.rgba 256 0 0 255))
                              base))))
    , Test.test
          "a canvas over 16384 on a side or over 100 megapixels is refused"
          (\_ ->
              Test.equal
                  [ "image/canvas_too_large", "image/too_many_pixels" ]
                  [ codeOf
                        (Canvas.encode Image.Png (Canvas.blank 16385 1 white))
                  , codeOf
                        (Canvas.encode
                            Image.Png
                            (Canvas.resize Canvas.Nearest 12000 12000 base))
                  ])
    , Test.test
          "a paste of a tiny PNG that claims 400 megapixels is refused"
          (\_ ->
              Test.equal
                  "image/too_many_pixels"
                  (codeOf
                      (Canvas.encode
                          Image.Png
                          (Canvas.paste 0 0 Nothing hugePng base))))
    , Test.test
          "a corrupt pasted image is InvalidInput at encode"
          (\_ ->
              Test.expectErrorKind
                  InvalidInput
                  (Task.run
                      (Canvas.encode
                          Image.Png
                          (Canvas.paste 0 0 Nothing "not an image" base))))
    , Test.test
          "a missing font file is NotFound"
          (\_ ->
              Test.expectErrorKind
                  NotFound
                  (Task.run (Canvas.loadFont "/no/such/font.ttf" 0)))
    , Test.test
          "bytes that are not a font fail with font_parse"
          (\_ ->
              Test.equal
                  "image/font_parse"
                  (case Canvas.fontFromBytes "not a font" 0 of

                      Ok _ ->
                          "ok"

                      Err e ->
                          Maybe.withDefault
                              "none"
                              (Maybe.map
                                  (\f ->
                                      Error.failureDomain f ++ "/"
                                          ++ Error.failureCode f)
                                  (Error.failureOf e))))
    , Test.test
          "pixelDiff of images of different sizes fails with size_mismatch"
          (\_ ->
              Test.equal
                  "image/size_mismatch"
                  (codeOf
                      (Canvas.pixelDiff
                          0
                          (png base)
                          (png (Canvas.blank 3 3 white)))))
    , Test.test
          "an Open Graph card with an initials avatar and a QR code from Std.Qr"
          (\_ ->
              let
                  card = ogCard "Sky on the server" "https://sky-lang.org/"
              in
                  Test.equal
                      ( "1200x630", Ok 0, True )
                      ( sizeOf (Canvas.encode Image.WebpLossless card)
                      , diff
                            card
                            (ogCard "Sky on the server" "https://sky-lang.org/")
                      , diff
                            card
                            (ogCard "Sky on the server" "https://example.org/")
                            /= Ok 0
                      ))
    ]


main : Program
main =
    Test.runMain tests
