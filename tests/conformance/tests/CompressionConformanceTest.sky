module CompressionConformanceTest exposing (main, tests)

-- Behavioral conformance for Std.Compression — gzip (RFC 1952) + zstd
-- (RFC 8478). Std.Compression had ZERO tests at any layer before this suite.
--
-- Every entry point is Task-typed (`String -> Task Error String`), so these
-- assertions drive them through `Task.run` (which executes a Task synchronously
-- to a `Result Error String`) inside pure `sky test` thunks — the same pattern
-- StoreCrudConformanceTest uses. There is NO pure/Result variant and NO
-- compression-level parameter on the surface, so those axes are documented as
-- gaps below rather than fabricated.
--
-- Inputs are ADVERSARIAL: empty, plain ASCII, multibyte Unicode + emoji,
-- embedded NUL / high control bytes, and a large highly-repetitive payload.
-- The CRITICAL robustness case is corrupt/invalid input on decompress: it must
-- surface `Err` (via the FFI runWithRecover boundary), NEVER a process-aborting
-- panic.

import Sky.Core.Prelude exposing (..)
import Sky.Core.String as String
import Sky.Core.Task as Task
import Sky.Core.Error exposing (Error)
import Std.Compression as Compression
import Sky.Test as Test exposing (Test)


-- gzip round-trip as a single Result: compress, then decompress the payload.
gzipRT : String -> Result Error String
gzipRT s =
    case Task.run (Compression.gzip s) of
        Err e ->
            Err e

        Ok compressed ->
            Task.run (Compression.gunzip compressed)


-- zstd round-trip as a single Result.
zstdRT : String -> Result Error String
zstdRT s =
    case Task.run (Compression.zstdCompress s) of
        Err e ->
            Err e

        Ok compressed ->
            Task.run (Compression.zstdDecompress compressed)


gz : String -> Result Error String
gz s =
    Task.run (Compression.gzip s)


zc : String -> Result Error String
zc s =
    Task.run (Compression.zstdCompress s)


-- Length of a compressed payload (empty on Err — a smaller-than-input assertion
-- on an Err would then read as 0, still failing loudly rather than masking).
clen : Result Error String -> Int
clen r =
    String.length (Result.withDefault "" r)


-- Test payloads.
ascii : String
ascii =
    "Hello, World! The quick brown fox jumps over the lazy dog. 0123456789"


unicode : String
unicode =
    "café ☕ 日本語テスト 🚀🔥 Ω≈ç√∫ñµ — smart quotes “test” 𝕊𝕜𝕪"


-- Embedded NUL (\0), low control bytes, and high bytes. Exercises the
-- "bytes are not necessarily valid UTF-8" contract in the module doc.
binary : String
binary =
    "\x00\x01\x02\x03head\x00\x7f\x1b\x00mid\xfe\xfftail\x00"


-- ~40k chars, extremely repetitive → must compress to a fraction of its size.
large : String
large =
    String.repeat 10000 "sky "


tests : List Test
tests =
    [ -- ── gzip round-trip fidelity (gunzip (gzip s) == s) ──
      Test.test "gzip round-trip: empty string"
        (\_ -> Test.equal (Ok "") (gzipRT ""))
    , Test.test "gzip round-trip: ASCII text"
        (\_ -> Test.equal (Ok ascii) (gzipRT ascii))
    , Test.test "gzip round-trip: multibyte Unicode + emoji"
        (\_ -> Test.equal (Ok unicode) (gzipRT unicode))
    , Test.test "gzip round-trip: embedded NUL + high/control bytes"
        (\_ -> Test.equal (Ok binary) (gzipRT binary))
    , Test.test "gzip round-trip: large highly-repetitive payload"
        (\_ -> Test.equal (Ok large) (gzipRT large))

      -- ── zstd round-trip fidelity (zstdDecompress (zstdCompress s) == s) ──
    , Test.test "zstd round-trip: empty string"
        (\_ -> Test.equal (Ok "") (zstdRT ""))
    , Test.test "zstd round-trip: ASCII text"
        (\_ -> Test.equal (Ok ascii) (zstdRT ascii))
    , Test.test "zstd round-trip: multibyte Unicode + emoji"
        (\_ -> Test.equal (Ok unicode) (zstdRT unicode))
    , Test.test "zstd round-trip: embedded NUL + high/control bytes"
        (\_ -> Test.equal (Ok binary) (zstdRT binary))
    , Test.test "zstd round-trip: large highly-repetitive payload"
        (\_ -> Test.equal (Ok large) (zstdRT large))

      -- ── Compressed output is framed/compressed, NOT the raw input ──
    , Test.test "gzip output differs from input (it is framed + compressed)"
        (\_ -> Test.notEqual (Ok ascii) (gz ascii))
    , Test.test "zstd output differs from input (it is framed + compressed)"
        (\_ -> Test.notEqual (Ok ascii) (zc ascii))
    , Test.test "gzip carries the RFC 1952 magic first byte 0x1f"
        (\_ -> Test.isTrue (String.startsWith "\x1f" (Result.withDefault "" (gz ascii))))

      -- ── Actually compresses: repetitive 40k payload shrinks a lot ──
    , Test.test "gzip shrinks the repetitive payload (< 10% of original)"
        (\_ -> Test.isTrue (clen (gz large) * 10 < String.length large))
    , Test.test "zstd shrinks the repetitive payload (< 10% of original)"
        (\_ -> Test.isTrue (clen (zc large) * 10 < String.length large))

      -- ── CRITICAL robustness: corrupt/invalid input -> Err, never a panic ──
    , Test.test "gunzip of non-gzip text -> Err (no panic)"
        (\_ -> Test.err (Task.run (Compression.gunzip "not gzip data at all")))
    , Test.test "gunzip of empty input -> Err (truncated stream)"
        (\_ -> Test.err (Task.run (Compression.gunzip "")))
    , Test.test "zstdDecompress of garbage -> Err (no panic)"
        (\_ -> Test.err (Task.run (Compression.zstdDecompress "garbage that is not zstd")))
      -- Codec difference by construction (NOT a bug): zstdDecompress "" -> Ok ""
      -- (zero-frame), which is REQUIRED because zstdCompress "" is itself "" — so
      -- the empty round-trip `zstdDecompress (zstdCompress "")` holds. gunzip ""
      -- -> Err only because gzip has a mandatory frame header (gzipCompress "" is
      -- ~20 non-empty bytes). The asymmetry follows each codec's framing, not a
      -- defect; both preserve data and neither panics.
    , Test.test "zstdDecompress of empty input -> Ok \"\" (zero-frame; required for empty round-trip)"
        (\_ -> Test.equal (Ok "") (Task.run (Compression.zstdDecompress "")))

      -- ── Cross-format: each decompressor rejects the other's frame ──
    , Test.test "gunzip rejects a zstd frame -> Err"
        (\_ -> Test.err (Task.run (Compression.gunzip (Result.withDefault "" (zc ascii)))))
    , Test.test "zstdDecompress rejects a gzip frame -> Err"
        (\_ -> Test.err (Task.run (Compression.zstdDecompress (Result.withDefault "" (gz ascii)))))

      -- ── Truncated-frame robustness: chop a valid frame, decompress -> Err ──
    , Test.test "gunzip of a truncated gzip frame -> Err (no panic)"
        (\_ ->
            Test.err
                (Task.run
                    (Compression.gunzip
                        (String.slice 0 5 (Result.withDefault "" (gz large)))
                    )
                )
        )
    ]


main : Program
main =
    Test.runMain tests
