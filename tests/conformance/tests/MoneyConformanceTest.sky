module MoneyConformanceTest exposing (main, tests)

-- Behavioral conformance for Std.Money — currency-typed money built on
-- Std.Decimal. These assertions drive the SKY-SOURCE Money API (through the
-- compiled binary), NOT the Go kernel directly. Inputs are ADVERSARIAL:
-- fair-split residue exactness, minor-unit boundaries across 0/2/3/8/18-dp
-- currencies, cross-currency Results, explicit exchange-rate round-trips, and negative amounts.
--
-- Every expectation below is anchored to a DOCUMENTED behaviour (the `-- |`
-- doc comments in sky-stdlib/Std/Money.sky and the kernel contract in
-- runtime-go/rt/money_kernel.go), never a guess.

import Sky.Core.Prelude exposing (..)
import Sky.Core.List as List
import Sky.Core.Result as Result
import Sky.Core.Maybe as Maybe
import Sky.Core.String as String
import Sky.Core.Error as Error exposing (Error)
import Std.Decimal as Dec
import Std.Money as Money
import Sky.Test as Test exposing (Test)


-- Parse helper for Decimal literals (rates, percentages, scalars). Adversarial
-- suites assume these literals are well-formed, so a parse failure surfaces as
-- a wrong result rather than a silent zero masking a bug.
dec : String -> Dec.Decimal
dec s =
    Result.withDefault (Dec.fromInt -999999) (Dec.fromString s)


-- Format the head of an allocation list with its ISO code, or a sentinel.
headFmt : List Money.Money -> String
headFmt xs =
    case List.head xs of

        Just m ->
            Money.formatWithCode m

        Nothing ->
            "EMPTY"


-- Does a Money list sum EXACTLY to `target` (currency + amount)?
sumsTo : Money.Currency -> List Money.Money -> Money.Money -> Bool
sumsTo c xs target =
    case Money.sum c xs of

        Ok total ->
            Money.eq total target

        Err _ ->
            False


-- An Err whose message names both currency codes.
mismatchNames : String -> String -> Result Error a -> Test.TestResult
mismatchNames a b r =
    case r of

        Err e ->
            if String.contains a (Error.toString e) && String.contains b (Error.toString e) then
                Test.pass

            else
                Test.fail ("the Err does not name " ++ a ++ " and " ++ b ++ ": " ++ Error.toString e)

        Ok _ ->
            Test.fail "expected an Err for two currencies"


isErr : Result e a -> Bool
isErr r =
    case r of

        Err _ ->
            True

        Ok _ ->
            False


tests : List Test
tests =
    [ -- ── allocate: fair-split EXACTNESS (doc: "sum of returned parts
      --    equals the input exactly", residue lands on the front) ──
      Test.test "allocate 3 of $100.00 sums EXACTLY to $100.00 (not 99.99)"
        (\_ -> Test.equal True (sumsTo Money.USD (Money.allocate 3 (Money.fromMajor Money.USD 100)) (Money.fromMajor Money.USD 100)))
    , Test.test "allocate 3 of $100.00 puts the extra cent on the FRONT -> 33.34"
        (\_ -> Test.equal "33.34 USD" (headFmt (Money.allocate 3 (Money.fromMajor Money.USD 100))))
    , Test.test "allocate 7 of $100.00 sums EXACTLY to $100.00"
        (\_ -> Test.equal True (sumsTo Money.USD (Money.allocate 7 (Money.fromMajor Money.USD 100)) (Money.fromMajor Money.USD 100)))
    , Test.test "allocate 3 of $0.10 (10 cents) sums EXACTLY -> [0.04,0.03,0.03]"
        (\_ -> Test.equal True (sumsTo Money.USD (Money.allocate 3 (Money.fromMinor Money.USD 10)) (Money.fromMinor Money.USD 10)))
    , Test.test "allocate 3 of $0.10 front-loads the residue -> 0.04"
        (\_ -> Test.equal "0.04 USD" (headFmt (Money.allocate 3 (Money.fromMinor Money.USD 10))))
    , Test.test "allocate 3 of ¥100 (0-dp) sums EXACTLY -> [34,33,33]"
        (\_ -> Test.equal True (sumsTo Money.JPY (Money.allocate 3 (Money.fromMajor Money.JPY 100)) (Money.fromMajor Money.JPY 100)))
    , Test.test "allocate 3 of ¥100 front residue -> 34 JPY"
        (\_ -> Test.equal "34 JPY" (headFmt (Money.allocate 3 (Money.fromMajor Money.JPY 100))))
    , Test.test "allocate 3 of 1.000 BHD (3-dp) sums EXACTLY -> [0.334,0.333,0.333]"
        (\_ -> Test.equal True (sumsTo Money.BHD (Money.allocate 3 (Money.fromMajor Money.BHD 1)) (Money.fromMajor Money.BHD 1)))
    , Test.test "allocate 3 of 1.000 BHD front residue -> 0.334 BHD"
        (\_ -> Test.equal "0.334 BHD" (headFmt (Money.allocate 3 (Money.fromMajor Money.BHD 1))))
    , Test.test "allocate 1 of $100 returns the whole [100.00]"
        (\_ -> Test.equal "100.00 USD" (headFmt (Money.allocate 1 (Money.fromMajor Money.USD 100))))
    , Test.test "allocate 0 of $100 returns the empty list (no parts)"
        (\_ ->
            case List.head (Money.allocate 0 (Money.fromMajor Money.USD 100)) of

                Nothing ->
                    Test.pass

                Just _ ->
                    Test.fail "expected empty allocation for 0 parts"
        )

      -- ── SUSPECTED REAL BUG — allocate of a NEGATIVE amount ──
      --    Doc: "The sum of returned parts equals the input exactly." The
      --    kernel only distributes a POSITIVE remainder (`if i < remInt`),
      --    so -$100.00 / 3 yields [-33.33,-33.33,-33.33] summing to -99.99.
      --    Kept RED to capture the contract violation.
    , Test.test "allocate 3 of -$100.00 sums EXACTLY to -$100.00 (doc: exact sum)"
        (\_ -> Test.equal True (sumsTo Money.USD (Money.allocate 3 (Money.neg (Money.fromMajor Money.USD 100))) (Money.neg (Money.fromMajor Money.USD 100))))

      -- ── Minor-unit correctness across currency decimal places ──
    , Test.test "minorUnits USD == 2"
        (\_ -> Test.equal 2 (Money.minorUnits Money.USD))
    , Test.test "minorUnits JPY == 0 (no fractional minor unit)"
        (\_ -> Test.equal 0 (Money.minorUnits Money.JPY))
    , Test.test "minorUnits KRW == 0"
        (\_ -> Test.equal 0 (Money.minorUnits Money.KRW))
    , Test.test "minorUnits BHD == 3"
        (\_ -> Test.equal 3 (Money.minorUnits Money.BHD))
    , Test.test "minorUnits KWD == 3"
        (\_ -> Test.equal 3 (Money.minorUnits Money.KWD))
    , Test.test "minorUnits BTC == 8 (satoshi precision)"
        (\_ -> Test.equal 8 (Money.minorUnits Money.BTC))
    , Test.test "minorUnits ETH == 18 (wei precision)"
        (\_ -> Test.equal 18 (Money.minorUnits Money.ETH))
    , Test.test "minorUnits USDC == 6"
        (\_ -> Test.equal 6 (Money.minorUnits Money.USDC))
    , Test.test "minorUnits of CurrencyRaw unknown falls back to 2"
        (\_ -> Test.equal 2 (Money.minorUnits (Money.CurrencyRaw "XYZ")))

      -- ── fromMinor / toMinor round-trips per currency ──
    , Test.test "USD fromMinor 12345 -> 123.45"
        (\_ -> Test.equal "123.45 USD" (Money.formatWithCode (Money.fromMinor Money.USD 12345)))
    , Test.test "USD toMinor of 123.45 -> 12345"
        (\_ -> Test.equal 12345 (Money.toMinor (Money.fromMinor Money.USD 12345)))
    , Test.test "USD minor round-trip fromMinor . toMinor == id"
        (\_ -> Test.equal 99999 (Money.toMinor (Money.fromMinor Money.USD 99999)))
    , Test.test "JPY fromMinor 1234 -> 1234 (0-dp: minor == major)"
        (\_ -> Test.equal "1234 JPY" (Money.formatWithCode (Money.fromMinor Money.JPY 1234)))
    , Test.test "JPY toMinor of ¥1234 -> 1234"
        (\_ -> Test.equal 1234 (Money.toMinor (Money.fromMinor Money.JPY 1234)))
    , Test.test "BHD fromMinor 1234 -> 1.234 (3-dp)"
        (\_ -> Test.equal "1.234 BHD" (Money.formatWithCode (Money.fromMinor Money.BHD 1234)))
    , Test.test "BHD toMinor of 1.234 -> 1234"
        (\_ -> Test.equal 1234 (Money.toMinor (Money.fromMinor Money.BHD 1234)))
    , Test.test "BTC fromMinor 100000000 (1e8 sat) -> 1 BTC"
        (\_ -> Test.equal "1.00000000 BTC" (Money.formatWithCode (Money.fromMinor Money.BTC 100000000)))
    , Test.test "BTC toMinor of 1 BTC -> 100000000 sat"
        (\_ -> Test.equal 100000000 (Money.toMinor (Money.fromMinor Money.BTC 100000000)))
    , Test.test "negative toMinor: -12.34 USD -> -1234"
        (\_ -> Test.equal -1234 (Money.toMinor (Money.neg (Money.fromMinor Money.USD 1234))))

      -- ── One rule (v0.29.2): every operation that combines two Money
      --    values by arithmetic or order is a Result, an Err (InvalidInput,
      --    naming both currencies) for two currencies. eq / neq stay Bool.
    , Test.test "add USD+EUR -> Err naming both currencies"
        (\_ -> mismatchNames "USD" "EUR" (Money.add (Money.fromMajor Money.USD 100) (Money.fromMajor Money.EUR 50)))
    , Test.test "sub USD-EUR -> Err naming both currencies"
        (\_ -> mismatchNames "USD" "EUR" (Money.sub (Money.fromMajor Money.USD 100) (Money.fromMajor Money.EUR 50)))
    , Test.test "add in one currency -> Ok sum"
        (\_ -> Test.equal (Ok "3.00 GBP") (Money.add (Money.fromMajor Money.GBP 1) (Money.fromMajor Money.GBP 2) |> Result.map Money.formatWithCode))
    , Test.test "sub in one currency -> Ok difference"
        (\_ -> Test.equal (Ok "50.00 USD") (Money.sub (Money.fromMajor Money.USD 100) (Money.fromMajor Money.USD 50) |> Result.map Money.formatWithCode))
    , Test.test "compare USD EUR -> Err"
        (\_ -> mismatchNames "USD" "EUR" (Money.compare (Money.fromMajor Money.USD 1) (Money.fromMajor Money.EUR 2)))
    , Test.test "compare in one currency -> Ok -1"
        (\_ -> Test.equal (Ok -1) (Money.compare (Money.fromMajor Money.USD 1) (Money.fromMajor Money.USD 2)))
    , Test.test "lt / lte / gt / gte across two currencies -> Err each"
        (\_ ->
            Test.equal
                [ True, True, True, True ]
                (List.map
                    (\f -> isErr (f (Money.fromMajor Money.USD 1) (Money.fromMajor Money.EUR 1)))
                    [ Money.lt, Money.lte, Money.gt, Money.gte ]))
    , Test.test "lt / lte / gt / gte in one currency -> Ok answers"
        (\_ ->
            Test.equal
                [ Ok True, Ok True, Ok False, Ok False ]
                (List.map
                    (\f -> f (Money.fromMajor Money.USD 1) (Money.fromMajor Money.USD 2))
                    [ Money.lt, Money.lte, Money.gt, Money.gte ]))
    , Test.test "sum with a value in another currency -> Err"
        (\_ -> mismatchNames "USD" "EUR" (Money.sum Money.USD [ Money.fromMajor Money.USD 1, Money.fromMajor Money.EUR 2 ]))
    , Test.test "eq is currency-aware and total: $100 /= €100"
        (\_ -> Test.equal ( False, True ) ( Money.eq (Money.fromMajor Money.USD 100) (Money.fromMajor Money.EUR 100), Money.neq (Money.fromMajor Money.USD 100) (Money.fromMajor Money.EUR 100) ))
    , Test.test "eq same currency + amount -> True"
        (\_ -> Test.equal True (Money.eq (Money.fromMajor Money.USD 100) (Money.fromMajor Money.USD 100)))

      -- ── Exchange rates: an explicit Rates value, no global table ──
    , Test.test "convert same currency is identity (no rate needed)"
        (\_ -> Test.equal (Ok "100.00 USD") (Money.convert (Money.rates []) Money.USD (Money.fromMajor Money.USD 100) |> Result.map Money.formatWithCode))
    , Test.test "convert forward @0.92: $100 USD -> €92.00"
        (\_ -> Test.equal (Ok "92.00 EUR") (Money.convert (Money.rates [ ( Money.USD, Money.EUR, dec "0.92" ) ]) Money.EUR (Money.fromMajor Money.USD 100) |> Result.map Money.formatWithCode))
    , Test.test "convert round-trip @2: USD->EUR->USD == $100.00 (inverse from the table)"
        (\_ ->
            let
                fx = Money.rates [ ( Money.USD, Money.EUR, dec "2" ) ]
            in
                Test.equal
                    (Ok "100.00 USD")
                    (Money.convert fx Money.EUR (Money.fromMajor Money.USD 100)
                        |> Result.andThen (Money.convert fx Money.USD)
                        |> Result.map Money.formatWithCode))
    , Test.test "rate reads the inverse: EUR->USD == 0.5"
        (\_ -> Test.equal (Just "0.5") (Money.rate Money.EUR Money.USD (Money.rates [ ( Money.USD, Money.EUR, dec "2" ) ]) |> Maybe.map Dec.toString))
    , Test.test "a zero or negative rate is left out: no rate"
        (\_ -> Test.equal ( Nothing, Nothing ) ( Money.rate Money.USD Money.EUR (Money.rates [ ( Money.USD, Money.EUR, dec "0" ) ]), Money.rate Money.USD Money.EUR (Money.rates [ ( Money.USD, Money.EUR, dec "-1.5" ) ]) ))
    , Test.test "convert with no rate -> Err naming both currencies (never panic)"
        (\_ -> mismatchNames "USD" "JPY" (Money.convert (Money.rates []) Money.JPY (Money.fromMajor Money.USD 100)))
    , Test.test "a later rate for the same pair wins"
        (\_ -> Test.equal (Just "3") (Money.rate Money.USD Money.EUR (Money.rates [ ( Money.USD, Money.EUR, dec "2" ), ( Money.USD, Money.EUR, dec "3" ) ]) |> Maybe.map Dec.toString))

      -- ── Percent helpers (percentOf pct m ; addPercent pct m) ──
    , Test.test "percentOf 10% of $200 -> $20.00"
        (\_ -> Test.equal "20.00 USD" (Money.formatWithCode (Money.percentOf (dec "10") (Money.fromMajor Money.USD 200))))
    , Test.test "addPercent 8.875% NYC tax on $100 -> $108.88 (banker's round)"
        (\_ -> Test.equal "108.88 USD" (Money.formatWithCode (Money.percentOf (dec "108.875") (Money.fromMajor Money.USD 100))))
    , Test.test "addPercent 10% of $200 -> $220.00"
        (\_ -> Test.equal "220.00 USD" (Money.formatWithCode (Money.addPercent (dec "10") (Money.fromMajor Money.USD 200))))
    , Test.test "subPercent 10% of $200 -> $180.00"
        (\_ -> Test.equal "180.00 USD" (Money.formatWithCode (Money.subPercent (dec "10") (Money.fromMajor Money.USD 200))))
    , Test.test "mul scalar 3 x $10 -> $30.00 (currency carries)"
        (\_ -> Test.equal "30.00 USD" (Money.formatWithCode (Money.mul (dec "3") (Money.fromMajor Money.USD 10))))

      -- ── Negative / zero / formatting ──
    , Test.test "format $100.00 -> $100.00 (symbol prefix)"
        (\_ -> Test.equal "$100.00" (Money.format (Money.fromMajor Money.USD 100)))
    , Test.test "format ¥1000 -> ¥1000 (0-dp, no decimal point)"
        (\_ -> Test.equal "¥1000" (Money.format (Money.fromMajor Money.JPY 1000)))
    , Test.test "format negative -> -$12.00 (sign before symbol)"
        (\_ -> Test.equal "-$12.00" (Money.format (Money.neg (Money.fromMajor Money.USD 12))))
    , Test.test "formatWithCode $100 -> 100.00 USD (B2B suffix form)"
        (\_ -> Test.equal "100.00 USD" (Money.formatWithCode (Money.fromMajor Money.USD 100)))
    , Test.test "abs of -$5 -> $5.00"
        (\_ -> Test.equal "5.00 USD" (Money.formatWithCode (Money.abs (Money.neg (Money.fromMajor Money.USD 5)))))
    , Test.test "isNegative (neg $5) -> True"
        (\_ -> Test.equal True (Money.isNegative (Money.neg (Money.fromMajor Money.USD 5))))
    , Test.test "isPositive $5 -> True"
        (\_ -> Test.equal True (Money.isPositive (Money.fromMajor Money.USD 5)))
    , Test.test "isZero (zero USD) -> True"
        (\_ -> Test.equal True (Money.isZero (Money.zero Money.USD)))
    , Test.test "isZero $5 -> False"
        (\_ -> Test.equal False (Money.isZero (Money.fromMajor Money.USD 5)))
    , Test.test "sum of an empty list -> zero of currency"
        (\_ -> Test.equal (Ok "0.00 USD") (Money.sum Money.USD [] |> Result.map Money.formatWithCode))
    , Test.test "sum [10,20,30] USD -> $60.00"
        (\_ -> Test.equal (Ok "60.00 USD") (Money.sum Money.USD [ Money.fromMajor Money.USD 10, Money.fromMajor Money.USD 20, Money.fromMajor Money.USD 30 ] |> Result.map Money.formatWithCode))

      -- ── Parse / construction round-trips ──
    , Test.test "fromString USD \"12.34\" -> Ok, formats 12.34 USD"
        (\_ ->
            case Money.fromString Money.USD "12.34" of

                Ok m ->
                    Test.equal "12.34 USD" (Money.formatWithCode m)

                Err _ ->
                    Test.fail "fromString of a valid literal should succeed"
        )
    , Test.test "fromString USD \"abc\" -> Err (malformed)"
        (\_ -> Test.err (Money.fromString Money.USD "abc"))
    , Test.test "currencyFromCode reads a code in any case: \"eur\" -> EUR"
        (\_ -> Test.equal (Just "EUR") (Money.currencyFromCode "eur" |> Maybe.map Money.currencyCode))
    , Test.test "currencyFromCode of a code Sky does not name -> CurrencyRaw"
        (\_ -> Test.equal (Just "ZZZ") (Money.currencyFromCode "zzz" |> Maybe.map Money.currencyCode))
    , Test.test "currencyFromCode is strict: empty, spaces, punctuation, too long -> Nothing"
        (\_ -> Test.equal [ Nothing, Nothing, Nothing, Nothing, Nothing ] (List.map Money.currencyFromCode [ "", " EUR", "GB P", "E$R", "ABCDEFGHIJK" ]))
    , Test.test "currencyFromCode of a named code -> its variant (eqCurrency USD)"
        (\_ -> Test.equal (Just True) (Money.currencyFromCode "USD" |> Maybe.map (Money.eqCurrency Money.USD)))
    ]


main : Program
main =
    Test.runMain tests
