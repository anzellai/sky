module StoreConformanceTest exposing (main, tests)

{-| Behavioral conformance for Std.Db.Store — asserts documented SEMANTICS with
ADVERSARIAL data (not happy-path). Every case here would FAIL on a naive/buggy
implementation. Runs against an in-process sqlite DB via `sky test`. -}

import Sky.Core.Prelude exposing (..)
import Sky.Core.List as List
import Sky.Core.Task as Task
import Sky.Core.Result as Result
import Std.Db as Db
import Std.Db.Store as Store exposing (Store)
import Std.Codec as Codec exposing (Codec)
import Sky.Test as Test exposing (Test)

type alias Row =
    { id : String
    , sortPos : Int
    , label : String
    }


rowCodec : Codec Row
rowCodec =
    Codec.auto { id = "", sortPos = 0, label = "" }


rowsStore : Store Row
rowsStore =
    Store.fromCodec "conf_rows" rowCodec |> Store.primaryKey "id"

-- Gap A (rule D1): a required JSON (blob) field gives a NOT NULL column. A
-- column `migrate` adds to a table with rows takes the JSON of the codec's
-- blank value as its DEFAULT, so the old rows decode. The blank holds a quote,
-- so the SQL literal must escape it.
type alias Tagged =
    { id : String
    , tags : List String
    }


taggedAuto : Store Tagged
taggedAuto =
    Store.fromCodec "conf_blob_auto" (Codec.auto { id = "", tags = [ "it's" ] })
        |> Store.primaryKey "id"


-- A hand-built record codec: the zero of a `list` field is `[]`.
taggedObject : Store Tagged
taggedObject =
    Store.fromCodec
        "conf_blob_obj"
        (Codec.object Tagged |> Codec.field "id" .id Codec.string
            |> Codec.field "tags" .tags (Codec.list Codec.string)
            |> Codec.buildObject)
        |> Store.primaryKey "id"

type Shade
    = Plain
    | Mixed Int

type alias Painted =
    { id : String
    , shade : Shade
    }


-- A `taggedUnion` field has no zero value: the column is NOT NULL with no
-- default, so `migrate` refuses it on a table with a row.
paintedStore : Store Painted
paintedStore =
    Store.fromCodec
        "conf_blob_union"
        (Codec.object Painted |> Codec.field "id" .id Codec.string
            |> Codec.field
                   "shade"
                   .shade
                   (Codec.taggedUnion
                       (\v ->
                           case v of

                               Plain ->
                                   ( "Plain", [] )

                               Mixed n ->
                                   ( "Mixed", [ Codec.toValue Codec.int n ] ))
                       [ Codec.var0 "Plain" Plain
                       , Codec.var1 "Mixed" Mixed Codec.int
                       ])
            |> Codec.buildObject)
        |> Store.primaryKey "id"


-- A table with one row and only an `id` column, then `migrate` on the store.
migrateOldTable : Db -> String -> Store a -> Result Error (List String)
migrateOldTable db table store =
    let
        _ = Task.run (Db.exec db ("DROP TABLE IF EXISTS " ++ table) [])
        _ =
            Task.run
                (Db.exec
                    db
                    ("CREATE TABLE " ++ table ++ " (id TEXT PRIMARY KEY)")
                    [])
        _ =
            Task.run
                (Db.exec
                    db
                    ("INSERT INTO " ++ table ++ " (id) VALUES ('old')")
                    [])
    in
        Task.run (Store.migrate db store)


{-| Fresh sqlite DB with adversarial rows: the `id` collates OPPOSITE to
`sort_pos`, so a query that confuses the two order keys returns the wrong order.
    id "aaa" -> sort_pos 2  (id-first, sort-last)
    id "mmm" -> sort_pos 1
    id "zzz" -> sort_pos 0  (id-last, sort-first)
Ordered by id ASC   -> aaa, mmm, zzz
Ordered by sort_pos -> zzz, mmm, aaa   (the CORRECT display order)
-}
setup : () -> Result Error Db
setup _ =
    case Task.run (Db.open "sqlite" "/tmp/sky-store-conformance.db") of

        Err e ->
            Err e

        Ok db ->
            let
                _ =
                    Task.run (Db.exec db "DROP TABLE IF EXISTS conf_rows" [])
                _ =
                    Task.run
                        (Db.exec
                            db
                            "CREATE TABLE conf_rows (id TEXT PRIMARY KEY, sort_pos INTEGER, label TEXT)"
                            [])
                _ =
                    Task.run
                        (Store.insert
                            db
                            rowsStore
                            { id = "aaa", sortPos = 2, label = "A" })
                _ =
                    Task.run
                        (Store.insert
                            db
                            rowsStore
                            { id = "mmm", sortPos = 1, label = "M" })
                _ =
                    Task.run
                        (Store.insert
                            db
                            rowsStore
                            { id = "zzz", sortPos = 0, label = "Z" })
            in
                Ok db


idsOf : List Row -> List String
idsOf rows =
    List.map (\r -> r.id) rows


runQuery : Db -> Store.Query Row -> List String
runQuery db q =
    idsOf (Result.withDefault [] (Task.run (Store.toList db q)))


tests : List Test
tests =
    case setup () of

        Err e ->
            [ Test.test
                  "setup"
                  (\_ -> Test.fail ("DB setup failed: " ++ errorToString e))
            ]

        Ok db ->
            [ Test.test
                  "multi-column order: FIRST orderAsc is the PRIMARY key (regression #5)"
                  (\_ ->
                      -- orderAsc "sort_pos" |> orderAsc "id"  ==>  ORDER BY sort_pos, id
                      -- CORRECT: [zzz, mmm, aaa]  (by sort_pos)
                      -- BUG:     [aaa, mmm, zzz]  (by id — last call became primary)
                      Test.equal
                          [ "zzz", "mmm", "aaa" ]
                          (runQuery
                              db
                              (Store.query rowsStore |> Store.orderAsc "sort_pos"
                                  |> Store.orderAsc "id")))
            , Test.test
                  "single orderAsc unaffected"
                  (\_ ->
                      Test.equal
                          [ "aaa", "mmm", "zzz" ]
                          (runQuery
                              db
                              (Store.query rowsStore |> Store.orderAsc "id")))
            , Test.test
                  "migrate: a required blob field (Codec.auto) is NOT NULL DEFAULT the blank's JSON"
                  (\_ ->
                      Test.equal
                          (Ok
                              [ "ALTER TABLE conf_blob_auto ADD COLUMN tags TEXT NOT NULL DEFAULT '[\"it''s\"]'"
                              ])
                          (migrateOldTable db "conf_blob_auto" taggedAuto))
            , Test.test
                  "migrate: the old row decodes the blank's value (Codec.auto)"
                  (\_ ->
                      Test.equal
                          (Ok [ { id = "old", tags = [ "it's" ] } ])
                          (Task.run (Store.all db taggedAuto)))
            , Test.test
                  "migrate: a required list field of a Codec.object codec defaults to []"
                  (\_ ->
                      case migrateOldTable db "conf_blob_obj" taggedObject of

                          Err e ->
                              Test.fail (errorToString e)

                          Ok _ ->
                              Test.equal
                                  (Ok [ { id = "old", tags = [] } ])
                                  (Task.run (Store.all db taggedObject)))
            , Test.test
                  "migrate: a required blob with no zero value is Err on a table with a row"
                  (\_ ->
                      Test.err
                          (migrateOldTable db "conf_blob_union" paintedStore))
            , Test.test
                  "orderDesc primary key precedence"
                  (\_ ->
                      -- orderDesc "sort_pos" |> orderAsc "id" ==> sort_pos DESC first
                      Test.equal
                          [ "aaa", "mmm", "zzz" ]
                          (runQuery
                              db
                              (Store.query rowsStore
                                  |> Store.orderDesc "sort_pos"
                                  |> Store.orderAsc "id")))
            ]


main =
    Test.runMain tests
