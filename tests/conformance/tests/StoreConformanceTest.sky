module StoreConformanceTest exposing (main, tests)

{-| Behavioral conformance for Std.Db.Store — asserts documented SEMANTICS with
ADVERSARIAL data (not happy-path). Every case here would FAIL on a naive/buggy
implementation. Runs against an in-process sqlite DB via `sky test`. -}

import Sky.Core.Prelude exposing (..)
import Sky.Core.List as List
import Sky.Core.Task as Task
import Sky.Core.Result as Result
import Std.Db as Db
import Std.Db.Store as Store exposing (Store)
import Std.Codec as Codec exposing (Codec)
import Sky.Test as Test exposing (Test)


type alias Row =
    { id : String
    , sortPos : Int
    , label : String
    }


rowCodec : Codec Row
rowCodec =
    Codec.auto { id = "", sortPos = 0, label = "" }


rowsStore : Store Row
rowsStore =
    Store.fromCodec "conf_rows" rowCodec |> Store.primaryKey "id"


{-| Fresh sqlite DB with adversarial rows: the `id` collates OPPOSITE to
`sort_pos`, so a query that confuses the two order keys returns the wrong order.
    id "aaa" -> sort_pos 2  (id-first, sort-last)
    id "mmm" -> sort_pos 1
    id "zzz" -> sort_pos 0  (id-last, sort-first)
Ordered by id ASC   -> aaa, mmm, zzz
Ordered by sort_pos -> zzz, mmm, aaa   (the CORRECT display order)
-}
setup : () -> Result Error Db
setup _ =
    case Task.run (Db.open "sqlite" "/tmp/sky-store-conformance.db") of
        Err e ->
            Err e

        Ok db ->
            let
                _ = Task.run (Db.exec db "DROP TABLE IF EXISTS conf_rows" [])
                _ =
                    Task.run
                        (Db.exec db "CREATE TABLE conf_rows (id TEXT PRIMARY KEY, sort_pos INTEGER, label TEXT)" [])
                _ = Task.run (Store.insert db rowsStore { id = "aaa", sortPos = 2, label = "A" })
                _ = Task.run (Store.insert db rowsStore { id = "mmm", sortPos = 1, label = "M" })
                _ = Task.run (Store.insert db rowsStore { id = "zzz", sortPos = 0, label = "Z" })
            in
                Ok db


idsOf : List Row -> List String
idsOf rows =
    List.map (\r -> r.id) rows


runQuery : Db -> Store.Query Row -> List String
runQuery db q =
    idsOf (Result.withDefault [] (Task.run (Store.toList db q)))


tests : List Test
tests =
    case setup () of
        Err e ->
            [ Test.test "setup" (\_ -> Test.fail ("DB setup failed: " ++ errorToString e)) ]

        Ok db ->
            [ Test.test
                  "multi-column order: FIRST orderAsc is the PRIMARY key (regression #5)"
                  (\_ ->
                      -- orderAsc "sort_pos" |> orderAsc "id"  ==>  ORDER BY sort_pos, id
                      -- CORRECT: [zzz, mmm, aaa]  (by sort_pos)
                      -- BUG:     [aaa, mmm, zzz]  (by id — last call became primary)
                      Test.equal
                          [ "zzz", "mmm", "aaa" ]
                          (runQuery db
                              (Store.query rowsStore
                                  |> Store.orderAsc "sort_pos"
                                  |> Store.orderAsc "id")))
            , Test.test
                  "single orderAsc unaffected"
                  (\_ ->
                      Test.equal
                          [ "aaa", "mmm", "zzz" ]
                          (runQuery db (Store.query rowsStore |> Store.orderAsc "id")))
            , Test.test
                  "orderDesc primary key precedence"
                  (\_ ->
                      -- orderDesc "sort_pos" |> orderAsc "id" ==> sort_pos DESC first
                      Test.equal
                          [ "aaa", "mmm", "zzz" ]
                          (runQuery db
                              (Store.query rowsStore
                                  |> Store.orderDesc "sort_pos"
                                  |> Store.orderAsc "id")))
            ]


main =
    Test.runMain tests
