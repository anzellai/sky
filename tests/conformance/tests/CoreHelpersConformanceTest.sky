module CoreHelpersConformanceTest exposing (main, tests)

-- Behavioral conformance for the small core helpers added in v0.27.0:
-- `Result.toMaybe`, `Result.fromMaybe`, `Maybe.toResult` and the
-- `Sky.Core.Tuple` module.
--
-- This suite deliberately does NOT import `Sky.Core.Result` or
-- `Sky.Core.Maybe`: a bare `Result.toMaybe` resolves through the kernel
-- qualifier to `rt.Result_toMaybe` (likewise `rt.Result_fromMaybe`,
-- `rt.Maybe_toResult`). The imported path (the Sky definitions in
-- `Sky/Core/Result.sky` and `Sky/Core/Maybe.sky`) is exercised by
-- JsonConformanceTest, which imports both. Both paths must agree.

import Sky.Core.Prelude exposing (..)
import Sky.Core.String as String
import Sky.Core.List as List
import Sky.Core.Tuple as Tuple
import Sky.Core.Error as Error
import Sky.Test as Test exposing (Test)


-- A Result whose Ok type is a record, so the Maybe that comes back is typed
-- by the record, not by a primitive.
type alias Point =
    { x : Int
    , y : Int
    }


parsePoint : String -> Result Error Point
parsePoint s =
    case String.split "," s of
        [ a, b ] ->
            case ( String.toInt a, String.toInt b ) of
                ( Just x, Just y ) ->
                    Ok { x = x, y = y }

                _ ->
                    Err (Error.invalidInput "not numbers")

        _ ->
            Err (Error.invalidInput "not a pair")


tests : List Test
tests =
    [ -- ─── Result.toMaybe ────────────────────────────────────────
      Test.test
        "Result.toMaybe: Ok becomes Just"
        (\_ -> Test.equal (Just 5) (Result.toMaybe (Ok 5)))
    , Test.test
        "Result.toMaybe: Err becomes Nothing"
        (\_ -> Test.equal Nothing (Result.toMaybe (parsePoint "1;2")))
    , Test.test
        "Result.toMaybe: a record payload survives"
        (\_ -> Test.equal (Just { x = 1, y = 2 }) (Result.toMaybe (parsePoint "1,2")))
    , Test.test
        "Result.toMaybe: in List.filterMap keeps only the Ok values"
        (\_ ->
            Test.equal
                [ 3, 4 ]
                (List.filterMap (\s -> Result.toMaybe (parsePoint s) |> Maybe.map (\p -> p.x + p.y)) [ "1,2", "x", "2,2" ])
        )

    -- ─── Result.fromMaybe / Maybe.toResult ─────────────────────
    , Test.test
        "Result.fromMaybe: Just becomes Ok"
        (\_ -> Test.equal (Ok 5) (Result.fromMaybe (Error.invalidInput "none") (Just 5)))
    , Test.test
        "Result.fromMaybe: Nothing becomes Err with the given error"
        (\_ -> Test.equal (Err (Error.invalidInput "not a number")) (Result.fromMaybe (Error.invalidInput "not a number") (String.toInt "x")))
    , Test.test
        "Maybe.toResult: a record payload survives"
        (\_ -> Test.equal (Ok { x = 1, y = 2 }) (Maybe.toResult Error.notFound (Result.toMaybe (parsePoint "1,2"))))
    , Test.test
        "Maybe.toResult: Nothing becomes Err with the given error"
        (\_ -> Test.equal (Err Error.notFound) (Maybe.toResult Error.notFound (List.head [])))
    , Test.test
        "Maybe.toResult and Result.fromMaybe agree, and undo Result.toMaybe on Ok"
        (\_ ->
            Test.equal
                (List.map (\s -> Maybe.toResult Error.notFound (String.toInt s)) [ "1", "x", "3" ])
                (List.map (\s -> Result.fromMaybe Error.notFound (String.toInt s)) [ "1", "x", "3" ])
        )
    , Test.test
        "Result.fromMaybe in a pipeline, partially applied"
        (\_ ->
            Test.equal
                (Ok 43)
                (String.toInt "42" |> Result.fromMaybe Error.notFound |> Result.map (\n -> n + 1))
        )

    -- ─── Sky.Core.Tuple ────────────────────────────────────────
    , Test.test
        "Tuple.pair builds a pair"
        (\_ -> Test.equal ( 1, "one" ) (Tuple.pair 1 "one"))
    , Test.test
        "Tuple.pair partially applied, as a function value"
        (\_ -> Test.equal [ ( "k", 1 ), ( "k", 2 ) ] (List.map (Tuple.pair "k") [ 1, 2 ]))
    , Test.test
        "Tuple.first / Tuple.second"
        (\_ -> Test.equal ( "a", 2 ) ( Tuple.first ( "a", 1 ), Tuple.second ( "b", 2 ) ))
    , Test.test
        "Tuple.first agrees with Basics.fst, Tuple.second with snd"
        (\_ -> Test.equal ( fst ( 7, "z" ), snd ( 7, "z" ) ) ( Tuple.first ( 7, "z" ), Tuple.second ( 7, "z" ) ))
    , Test.test
        "Tuple.mapFirst changes the type of the first element only"
        (\_ -> Test.equal ( "1", True ) (Tuple.mapFirst String.fromInt ( 1, True )))
    , Test.test
        "Tuple.mapSecond changes the type of the second element only"
        (\_ -> Test.equal ( 1, 3 ) (Tuple.mapSecond String.length ( 1, "abc" )))
    , Test.test
        "Tuple.mapBoth applies one function to each side"
        (\_ -> Test.equal ( "A", -1 ) (Tuple.mapBoth String.toUpper negate ( "a", 1 )))
    , Test.test
        "Tuple helpers compose in a pipeline"
        (\_ ->
            Test.equal
                ( 4, "xx" )
                (( 2, "x" ) |> Tuple.mapFirst (\n -> n * 2) |> Tuple.mapSecond (\s -> s ++ s))
        )
    ]


main =
    Test.runMain tests
