module ListConformanceTest exposing (main, tests)

{-| Behavioral conformance for Sky.Core.List — asserts documented SEMANTICS
with ADVERSARIAL inputs (empty lists, boundary n, unequal lengths, and a
200k-element stack-safety sweep). Every case here would FAIL on a naive/buggy
implementation. Runs via `sky test`. -}

import Sky.Core.Prelude exposing (..)
import Sky.Core.List as List
import Sky.Core.String as String
import Sky.Test as Test exposing (Test)


-- | Typed empty lists — avoids ambiguous `[]` at assertion sites.
emptyInts : List Int
emptyInts =
    []


-- | A large list to exercise the constant-stack (CPS/TCO) contract and value
-- correctness of the recursive list ops at scale.
--
-- SIZE CAP — READ THIS. The intended sweep size for this section is 200_000
-- (per the "1M-element input runs in constant Go stack" claim in the stdlib
-- docs). It is capped at 20_000 here because the runtime has a PERFORMANCE
-- DEFECT that makes 200_000 take ~7.5 MINUTES for `List.range` alone:
--
--   `rt.List_cons` (runtime-go/rt/rt.go:1881-1893) rebuilds the ENTIRE
--   accumulator slice on every cons — `make([]any, 0, len+1)` + copy — so a
--   prepend is O(n), not O(1). Every CPS/accumulator op in Sky.Core.List
--   (range/map/filter/reverse/append/concat/zip/indexedMap) builds its result
--   via repeated `x :: acc`, which makes each op O(n^2) IN TIME even though it
--   is O(1) in STACK. Measured `List.range` timings (clean quadratic — each
--   doubling of n ~4x the time): 5k=291ms, 10k=1.2s, 20k=4.7s, 40k=18s.
--
-- The CPS rewrites did fix stack growth, but the underlying `[]any`
-- (slice) list representation makes cons O(n), so the ops are quadratic. This
-- is a real, reportable stdlib/runtime bug (see the task report). 20_000 still
-- proves constant-stack + correctness while keeping the suite runnable (~20s).
big : List Int
big =
    List.range 1 20000


tests : List Test
tests =
    [ -- map / filter on empty + singleton
      Test.test "map on empty list yields empty"
        (\_ -> Test.equal emptyInts (List.map (\n -> n + 1) emptyInts))
    , Test.test "map on singleton applies fn"
        (\_ -> Test.equal [ 10 ] (List.map (\n -> n * 2) [ 5 ]))
    , Test.test "filter on empty yields empty"
        (\_ -> Test.equal emptyInts (List.filter (\n -> n > 0) emptyInts))
    , Test.test "filter that keeps nothing yields empty (not the input)"
        (\_ -> Test.equal emptyInts (List.filter (\n -> n > 100) [ 1, 2, 3 ]))
    , Test.test "filter keeps only matching, order preserved"
        (\_ -> Test.equal [ 2, 4 ] (List.filter (\n -> modBy 2 n == 0) [ 1, 2, 3, 4, 5 ]))

    -- foldl vs foldr direction (adversarial: non-commutative accumulator)
    , Test.test "foldl folds left-to-right (prepend gives reversed)"
        (\_ -> Test.equal "321" (List.foldl (\x acc -> String.fromInt x ++ acc) "" [ 1, 2, 3 ]))
    , Test.test "foldr folds right-to-left (prepend keeps order)"
        (\_ -> Test.equal "123" (List.foldr (\x acc -> String.fromInt x ++ acc) "" [ 1, 2, 3 ]))
    , Test.test "foldl on empty returns the initial accumulator"
        (\_ -> Test.equal 42 (List.foldl (\x acc -> x + acc) 42 emptyInts))
    , Test.test "foldr on empty returns the initial accumulator"
        (\_ -> Test.equal 42 (List.foldr (\x acc -> x + acc) 42 emptyInts))

    -- take / drop boundary conditions
    , Test.test "take 0 yields empty"
        (\_ -> Test.equal emptyInts (List.take 0 [ 1, 2, 3 ]))
    , Test.test "take n > length yields whole list"
        (\_ -> Test.equal [ 1, 2, 3 ] (List.take 10 [ 1, 2, 3 ]))
    , Test.test "take negative yields empty"
        (\_ -> Test.equal emptyInts (List.take (-3) [ 1, 2, 3 ]))
    , Test.test "drop 0 yields whole list"
        (\_ -> Test.equal [ 1, 2, 3 ] (List.drop 0 [ 1, 2, 3 ]))
    , Test.test "drop n > length yields empty"
        (\_ -> Test.equal emptyInts (List.drop 10 [ 1, 2, 3 ]))
    , Test.test "drop negative yields whole list"
        (\_ -> Test.equal [ 1, 2, 3 ] (List.drop (-2) [ 1, 2, 3 ]))

    -- reverse
    , Test.test "reverse of empty is empty"
        (\_ -> Test.equal emptyInts (List.reverse emptyInts))
    , Test.test "reverse of singleton is itself"
        (\_ -> Test.equal [ 7 ] (List.reverse [ 7 ]))
    , Test.test "reverse of multiple flips order"
        (\_ -> Test.equal [ 3, 2, 1 ] (List.reverse [ 1, 2, 3 ]))

    -- append / concat with empties
    , Test.test "append with empty left side"
        (\_ -> Test.equal [ 1, 2 ] (List.append emptyInts [ 1, 2 ]))
    , Test.test "append with empty right side"
        (\_ -> Test.equal [ 1, 2 ] (List.append [ 1, 2 ] emptyInts))
    , Test.test "concat of nested empties yields empty"
        (\_ -> Test.equal emptyInts (List.concat [ emptyInts, emptyInts, emptyInts ]))
    , Test.test "concat flattens nested lists in order"
        (\_ -> Test.equal [ 1, 2, 3, 4 ] (List.concat [ [ 1, 2 ], [ 3, 4 ] ]))

    -- member / any / all — empty-list identity elements
    , Test.test "member present"
        (\_ -> Test.isTrue (List.member 2 [ 1, 2, 3 ]))
    , Test.test "member absent"
        (\_ -> Test.isFalse (List.member 9 [ 1, 2, 3 ]))
    , Test.test "all [] is True (vacuous truth)"
        (\_ -> Test.isTrue (List.all (\n -> n > 0) emptyInts))
    , Test.test "any [] is False (no witness)"
        (\_ -> Test.isFalse (List.any (\n -> n > 0) emptyInts))
    , Test.test "any finds a matching element"
        (\_ -> Test.isTrue (List.any (\n -> n == 2) [ 1, 2, 3 ]))
    , Test.test "all fails when one element fails"
        (\_ -> Test.isFalse (List.all (\n -> n < 3) [ 1, 2, 3 ]))

    -- zip / range / indexedMap / concatMap
    , Test.test "zip truncates to the shorter list"
        (\_ -> Test.equal [ ( 1, "a" ), ( 2, "b" ) ] (List.zip [ 1, 2, 3 ] [ "a", "b" ]))
    , Test.test "range with start > end is empty"
        (\_ -> Test.equal emptyInts (List.range 5 1))
    , Test.test "range with start == end is a singleton"
        (\_ -> Test.equal [ 3 ] (List.range 3 3))
    , Test.test "indexedMap threads correct zero-based indices"
        (\_ -> Test.equal [ "0a", "1b", "2c" ] (List.indexedMap (\i x -> String.fromInt i ++ x) [ "a", "b", "c" ]))
    , Test.test "concatMap maps then flattens"
        (\_ -> Test.equal [ 1, 1, 2, 2 ] (List.concatMap (\n -> [ n, n ]) [ 1, 2 ]))

    -- head / tail on empty vs non-empty
    , Test.test "head of empty is Nothing"
        (\_ -> Test.equal Nothing (List.head emptyInts))
    , Test.test "head returns the first element"
        (\_ -> Test.equal (Just 1) (List.head [ 1, 2, 3 ]))
    , Test.test "tail of empty is Nothing"
        (\_ -> Test.equal Nothing (List.tail emptyInts))
    , Test.test "tail returns everything but the head"
        (\_ -> Test.equal (Just [ 2, 3 ]) (List.tail [ 1, 2, 3 ]))

    -- STACK SAFETY + large-list correctness (20k elements; see `big` note)
    , Test.test "STACK: length of 20k list (constant-stack, non-consing traversal)"
        (\_ -> Test.equal 20000 (List.length big))
    , Test.test "STACK: foldl sum over 20k list = 20000*20001/2"
        (\_ -> Test.equal 200010000 (List.foldl (\x acc -> x + acc) 0 big))
    , Test.test "STACK: map + foldl over 20k list (value correctness)"
        (\_ -> Test.equal 200030000 (List.foldl (\x acc -> x + acc) 0 (List.map (\n -> n + 1) big)))
    , Test.test "STACK: filter over 20k list keeps the 10k evens"
        (\_ -> Test.equal 10000 (List.length (List.filter (\n -> modBy 2 n == 0) big)))
    , Test.test "STACK: reverse of 20k list has the max at its head"
        (\_ -> Test.equal (Just 20000) (List.head (List.reverse big)))
    ]


main =
    Test.runMain tests
