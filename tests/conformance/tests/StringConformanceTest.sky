module StringConformanceTest exposing (main, tests)

{-| Behavioral conformance for Sky.Core.String — asserts documented SEMANTICS
with ADVERSARIAL inputs (unicode code-point counting, empty/absent
separators, out-of-range + negative rune indices, junk parses). Every case
here would FAIL on a byte-oriented or naive implementation. Runs via `sky test`.

Note: `String.toInt` / `toFloat` return `Maybe`, not `Result`, so the
rejection cases assert `Test.equal Nothing (...)` rather than `Test.err`. -}

import Sky.Core.Prelude exposing (..)
import Sky.Core.String as String
import Sky.Test as Test exposing (Test)


-- | Typed empty string list — avoids ambiguous `[]` at assertion sites.
emptyStrs : List String
emptyStrs =
    []


tests : List Test
tests =
    [ -- length counts UNICODE CODE POINTS, not bytes
      Test.test "length counts code points: 世界 == 2 (6 UTF-8 bytes)"
        (\_ -> Test.equal 2 (String.length "世界"))
    , Test.test "length of a single emoji is 1 code point"
        (\_ -> Test.equal 1 (String.length "😀"))
    , Test.test "length of mixed ASCII + multibyte"
        (\_ -> Test.equal 3 (String.length "aΩb"))
    , Test.test "length of ASCII string"
        (\_ -> Test.equal 5 (String.length "hello"))

    -- reverse is rune-aware
    , Test.test "reverse of empty string is empty"
        (\_ -> Test.equal "" (String.reverse ""))
    , Test.test "reverse of ASCII"
        (\_ -> Test.equal "cba" (String.reverse "abc"))
    , Test.test "reverse of unicode preserves whole code points"
        (\_ -> Test.equal "界世" (String.reverse "世界"))

    -- split / join
    , Test.test "split on absent separator yields the whole string as one element"
        (\_ -> Test.equal [ "hello" ] (String.split "," "hello"))
    , Test.test "split on present separator"
        (\_ -> Test.equal [ "a", "b", "c" ] (String.split "," "a,b,c"))
    , Test.test "split on empty separator splits into code points (unicode)"
        (\_ -> Test.equal [ "世", "界" ] (String.split "" "世界"))
    , Test.test "split then join round-trips"
        (\_ -> Test.equal "a,b,c" (String.join "," (String.split "," "a,b,c")))
    , Test.test "join of empty list is empty string"
        (\_ -> Test.equal "" (String.join "," emptyStrs))

    -- slice — rune-based, negative counts from end, start>end -> ""
    , Test.test "slice extracts a rune range"
        (\_ -> Test.equal "ell" (String.slice 1 4 "hello"))
    , Test.test "slice with negative start counts from the end"
        (\_ -> Test.equal "lo" (String.slice (-2) 5 "hello"))
    , Test.test "slice start > end yields empty"
        (\_ -> Test.equal "" (String.slice 3 1 "hello"))
    , Test.test "slice end past the length clamps"
        (\_ -> Test.equal "llo" (String.slice 2 100 "hello"))
    , Test.test "slice on unicode counts runes, not bytes"
        (\_ -> Test.equal "世界" (String.slice 0 2 "世界🎉"))

    -- dropLeft / dropRight — Elm rune semantics
    , Test.test "dropLeft negative returns the string unchanged"
        (\_ -> Test.equal "hello" (String.dropLeft (-1) "hello"))
    , Test.test "dropLeft n >= length returns empty"
        (\_ -> Test.equal "" (String.dropLeft 10 "hello"))
    , Test.test "dropLeft on unicode drops whole code points"
        (\_ -> Test.equal "界" (String.dropLeft 1 "世界"))
    , Test.test "dropRight negative returns the string unchanged"
        (\_ -> Test.equal "hello" (String.dropRight (-1) "hello"))
    , Test.test "dropRight n >= length returns empty"
        (\_ -> Test.equal "" (String.dropRight 10 "hello"))
    , Test.test "dropRight drops trailing runes"
        (\_ -> Test.equal "hel" (String.dropRight 2 "hello"))

    -- trim family
    , Test.test "trim removes leading AND trailing whitespace"
        (\_ -> Test.equal "hi" (String.trim "  hi  "))
    , Test.test "trimStart removes only leading whitespace"
        (\_ -> Test.equal "hi  " (String.trimStart "  hi  "))
    , Test.test "trimEnd removes only trailing whitespace"
        (\_ -> Test.equal "  hi" (String.trimEnd "  hi  "))

    -- pad
    , Test.test "padLeft pads to the target width"
        (\_ -> Test.equal "007" (String.padLeft 3 '0' "7"))
    , Test.test "padLeft is a no-op when already long enough"
        (\_ -> Test.equal "12345" (String.padLeft 3 '0' "12345"))
    , Test.test "padRight pads on the right"
        (\_ -> Test.equal "7  " (String.padRight 3 ' ' "7"))

    -- contains / startsWith / endsWith — empty + oversize needles
    , Test.test "contains empty needle is True"
        (\_ -> Test.isTrue (String.contains "" "hello"))
    , Test.test "contains needle longer than haystack is False"
        (\_ -> Test.isFalse (String.contains "hello world" "hi"))
    , Test.test "contains a present substring"
        (\_ -> Test.isTrue (String.contains "ell" "hello"))
    , Test.test "startsWith empty prefix is True"
        (\_ -> Test.isTrue (String.startsWith "" "hello"))
    , Test.test "startsWith prefix longer than haystack is False"
        (\_ -> Test.isFalse (String.startsWith "hello!" "hi"))
    , Test.test "endsWith empty suffix is True"
        (\_ -> Test.isTrue (String.endsWith "" "hello"))
    , Test.test "endsWith a present suffix"
        (\_ -> Test.isTrue (String.endsWith "lo" "hello"))
    , Test.test "endsWith an absent suffix is False"
        (\_ -> Test.isFalse (String.endsWith "hi" "hello"))

    -- toInt / toFloat — reject junk, trim spaces
    , Test.test "toInt rejects non-numeric junk"
        (\_ -> Test.equal Nothing (String.toInt "abc"))
    , Test.test "toInt accepts a valid integer"
        (\_ -> Test.equal (Just 42) (String.toInt "42"))
    -- FIXED (finding L2): `String.toInt` now trims surrounding whitespace,
    -- consistent with `String.toFloat` and the typed `String_toIntT`
    -- companion. Previously the any-typed path did not trim, so trimming
    -- silently depended on the codegen path. This asserts the FIX.
    , Test.test "toInt trims surrounding whitespace (consistent with toFloat)"
        (\_ -> Test.equal (Just 42) (String.toInt "  42  "))
    , Test.test "toInt rejects a float-shaped string"
        (\_ -> Test.equal Nothing (String.toInt "4.5"))
    , Test.test "toInt rejects the empty string"
        (\_ -> Test.equal Nothing (String.toInt ""))
    , Test.test "toInt parses a negative integer"
        (\_ -> Test.equal (Just (-7)) (String.toInt "-7"))
    , Test.test "toFloat accepts a valid decimal"
        (\_ -> Test.equal (Just 3.14) (String.toFloat "3.14"))
    , Test.test "toFloat trims surrounding whitespace"
        (\_ -> Test.equal (Just 2.5) (String.toFloat "  2.5  "))
    , Test.test "toFloat rejects non-numeric junk"
        (\_ -> Test.equal Nothing (String.toFloat "abc"))

    -- replace — including the empty-pattern edge case
    , Test.test "replace substitutes ALL occurrences"
        (\_ -> Test.equal "b-b-b" (String.replace "a" "b" "a-a-a"))
    , Test.test "replace with an empty pattern inserts between every rune"
        (\_ -> Test.equal "XaXbX" (String.replace "" "X" "ab"))
    , Test.test "replace leaves an absent pattern untouched"
        (\_ -> Test.equal "hello" (String.replace "z" "Q" "hello"))

    -- words / lines edge inputs
    , Test.test "words collapses runs of whitespace"
        (\_ -> Test.equal [ "a", "b", "c" ] (String.words "  a  b   c "))
    , Test.test "words on whitespace-only input is empty"
        (\_ -> Test.equal emptyStrs (String.words "   "))
    , Test.test "lines splits on newline"
        (\_ -> Test.equal [ "a", "b", "c" ] (String.lines "a\nb\nc"))
    , Test.test "lines keeps a trailing empty segment after a final newline"
        (\_ -> Test.equal [ "a", "" ] (String.lines "a\n"))

    -- case mapping on unicode
    , Test.test "toUpper maps unicode letters"
        (\_ -> Test.equal "ΑΒ" (String.toUpper "αβ"))
    , Test.test "toLower maps unicode letters"
        (\_ -> Test.equal "αβ" (String.toLower "ΑΒ"))
    , Test.test "toUpper on ASCII"
        (\_ -> Test.equal "HELLO" (String.toUpper "hello"))
    ]


main =
    Test.runMain tests
