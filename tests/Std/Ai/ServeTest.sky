module Std.Ai.ServeTest exposing (tests)

-- Std.Ai.Serve, pure: vLLM's arguments, the Cloud Run service (Admin API v2
-- JSON), its Knative YAML, the tier's Dockerfile, and the defaults. The tier
-- itself runs against a fake vLLM in runtime-go/rt/ai_serve_test.go, and a
-- deployment against the Google Cloud emulator in the cargo flow
-- rust/crates/sky/tests/ai_serve_flow.rs.

import Sky.Core.Prelude exposing (..)
import Sky.Core.String as String
import Sky.Core.List as List
import Sky.Core.Maybe as Maybe exposing (Maybe(..))
import Sky.Core.Result as Result
import Sky.Core.Json.Decode as JsonD
import Sky.Test as Test exposing (Test)
import Std.Ai.Serve as Serve


tier : Serve.Tier
tier =
    Serve.tier Serve.Vllm Serve.devBase
        |> Serve.withAdapters [ "support-lora@prod", "support-lora@qa" ]
        |> Serve.withMaxAdapters 3


target : Serve.Target
target =
    Serve.cloudRun
        { project = "p", region = "us-central1", service = "support-tier" }
        |> Serve.withTierImage
               "us-central1-docker.pkg.dev/p/sky/tier@sha256:2222222222222222222222222222222222222222222222222222222222222222"
        |> Serve.withTokenSecret "support-tier-token"
        |> Serve.withRegistryUrl "gs://bkt/registry"
        |> Serve.withServiceAccount "tier@p.iam.gserviceaccount.com"


service : String
service =
    Serve.serviceJson target tier


at : List String -> JsonD.Decoder a -> Maybe a
at path d =
    Result.toMaybe (JsonD.decodeString (JsonD.at path d) service)


container : Int -> List String -> JsonD.Decoder a -> Maybe a
container i path d =
    Result.toMaybe
        (JsonD.decodeString
            (JsonD.at
                [ "template", "containers" ]
                (JsonD.index i (JsonD.at path d)))
            service)


tests : List Test
tests =
    [ Test.test
          "the base is served under the repository's name, adapters at least one per alias"
          (\_ ->
              let
                  s = Serve.settings tier
              in
                  Test.equal
                      ( s.baseName
                      , Serve.baseIdOf tier
                      , Serve.basePath "/models/home" tier
                      )
                      ( "qwen2.5-0.5b-instruct"
                      , "Qwen/Qwen2.5-0.5B-Instruct@7ae557604adf67be50417f59c2c2f167def9a775"
                      , "/models/home/bases/Qwen--Qwen2.5-0.5B-Instruct@7ae557604adf67be50417f59c2c2f167def9a775"
                      ))
    , Test.test
          "vLLM runs with LoRA on, the tier's adapter count and the base staged below the home"
          (\_ ->
              Test.equal
                  (Serve.vllmArgs "/models/home" tier)
                  [ "--model"
                  , "/models/home/bases/Qwen--Qwen2.5-0.5B-Instruct@7ae557604adf67be50417f59c2c2f167def9a775"
                  , "--served-model-name"
                  , "qwen2.5-0.5b-instruct"
                  , "--enable-lora"
                  , "--max-loras"
                  , "3"
                  , "--max-lora-rank"
                  , "64"
                  , "--max-cpu-loras"
                  , "6"
                  , "--max-model-len"
                  , "4096"
                  , "--gpu-memory-utilization"
                  , "0.85"
                  , "--host"
                  , "0.0.0.0"
                  , "--port"
                  , "8000"
                  , "--enforce-eager"
                  ])
    , Test.test
          "the service scales to zero on one L4, labelled, never public"
          (\_ ->
              Test.equal
                  ( ( at [ "template", "scaling", "minInstanceCount" ] JsonD.int
                    , at [ "template", "scaling", "maxInstanceCount" ] JsonD.int
                    , at
                          [ "template", "nodeSelector", "accelerator" ]
                          JsonD.string
                    )
                  , ( at [ "labels", "sky-managed" ] JsonD.string
                    , at [ "labels", "sky-deployment" ] JsonD.string
                    , at [ "invokerIamDisabled" ] JsonD.bool
                    )
                  , at [ "template", "gpuZonalRedundancyDisabled" ] JsonD.bool
                  )
                  ( ( Just 0, Just 1, Just "nvidia-l4" )
                  , ( Just "true", Just "support-tier", Just False )
                  , Just True
                  ))
    , Test.test
          "the tier is the ingress; vLLM has the GPU, starts after the tier, and loads adapters at run time"
          (\_ ->
              Test.equal
                  ( ( container 0 [ "name" ] JsonD.string
                    , container
                          0
                          [ "ports" ]
                          (JsonD.index 0 (JsonD.field "containerPort" JsonD.int))
                    )
                  , ( container 1 [ "name" ] JsonD.string
                    , container
                          1
                          [ "resources", "limits", "nvidia.com/gpu" ]
                          JsonD.string
                    , container 1 [ "dependsOn" ] (JsonD.index 0 JsonD.string)
                    )
                  , container
                        1
                        [ "env" ]
                        (JsonD.index 1 (JsonD.field "value" JsonD.string))
                  )
                  ( ( Just "tier", Just 8080 )
                  , ( Just "engine", Just "1", Just "tier" )
                  , Just "True"
                  ))
    , Test.test
          "the service token is a Secret Manager reference, never text"
          (\_ ->
              Test.equal
                  ( container
                        0
                        [ "env" ]
                        (JsonD.list (JsonD.field "name" JsonD.string))
                        |> Maybe.map (List.member "SKY_AI_SERVE_TOKEN")
                  , String.contains "support-tier-token" service
                  , String.contains "secretKeyRef" service
                  )
                  ( Just True, True, True ))
    , Test.test
          "every image is pinned by digest"
          (\_ ->
              Test.equal
                  ( container 0 [ "image" ] JsonD.string
                        |> Maybe.map (String.contains "@sha256:")
                  , container 1 [ "image" ] JsonD.string
                        |> Maybe.map (String.contains "@sha256:")
                  , String.contains "@sha256:" Serve.tierBaseImage
                  )
                  ( Just True, Just True, True ))
    , Test.test
          "the Knative YAML carries the same service"
          (\_ ->
              let
                  yaml = Serve.knativeYaml target tier
              in
                  Test.equal
                      ( String.contains "name: support-tier" yaml
                      , String.contains "nvidia.com/gpu: \"1\"" yaml
                      , String.contains
                            "autoscaling.knative.dev/minScale: \"0\""
                            yaml
                      , String.contains "secretKeyRef" yaml
                      )
                      ( True, True, True, True ))
    , Test.test
          "the tier's Dockerfile copies the static binary onto a pinned distroless base"
          (\_ ->
              Test.equal
                  ( String.contains
                        ("FROM " ++ Serve.tierBaseImage)
                        Serve.dockerfile
                  , String.contains "COPY app /app" Serve.dockerfile
                  , String.contains "USER nonroot" Serve.dockerfile
                  )
                  ( True, True, True ))
    , Test.test
          "a tier program starts with no verb; the sky ai CLI's tier image starts its serve verb"
          (\_ ->
              Test.equal
                  ( String.contains "ENTRYPOINT [\"/app\"]" Serve.dockerfile
                  , String.contains
                        "ENTRYPOINT [\"/app\", \"serve\"]"
                        (Serve.dockerfileWith [ "serve" ])
                  )
                  ( True, True ))
    , Test.test
          "a target's service name is its full resource name"
          (\_ ->
              Test.equal
                  (Serve.serviceName target)
                  "projects/p/locations/us-central1/services/support-tier")
    ]
