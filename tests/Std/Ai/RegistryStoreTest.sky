module Std.Ai.RegistryStoreTest exposing (tests)

-- The registry's pointer objects and the store's named objects, on a local
-- store: what a serving tier reads without the registry's database. The same
-- code against GCS runs in the cloud flows (rust/crates/sky/tests/
-- ai_cloud_train_flow.rs) against the runtime's Google Cloud emulator.

import Sky.Core.Prelude exposing (..)
import Sky.Core.Task as Task
import Sky.Core.Error as Error exposing (Error)
import Sky.Core.String as String
import Sky.Core.List as List
import Sky.Core.Maybe as Maybe exposing (Maybe(..))
import Sky.Core.Result as Result
import Sky.Core.Crypto as Crypto
import Sky.Core.Encoding as Encoding
import Sky.Core.File as File
import Sky.Test as Test exposing (Test)
import Std.Db as Db exposing (Db)
import Std.Ai.Local as Local
import Std.Ai.Store as Store exposing (Store)
import Std.Ai.Failure as Failure exposing (Failure(..))
import Std.Ai.Registry as Registry exposing (Format(..), Method(..))


-- A minimal safetensors file (an 8-byte header length, then a JSON header).
safetensors : String -> String
safetensors tag =
    let
        header = "{\"__metadata__\":{\"tag\":\"" ++ tag ++ "\"}}"
        n = String.length header
        digit d = String.slice d (d + 1) "0123456789abcdef"
        hex = digit (n // 16) ++ digit (modBy 16 n)
    in
        (Encoding.hexDecode (hex ++ "00000000000000") |> Result.withDefault "")
            ++ header


lineage : Registry.Lineage
lineage =
    { base = Local.devModel
    , dataset = "support@1"
    , datasetDigest = Crypto.sha256 "support"
    , metadata =
        [ ( "baseId", "Qwen/Qwen2.5-0.5B-Instruct@7ae557604adf67be50417f59c2c2f167def9a775" ) ]
    }

type alias World =
    { reg : Registry.Registry
    , store : Store
    , dir : String
    }


world : Task Error World
world =
    File.tempDir "sky-registry-store-test"
        |> Task.andThen
               (\dir ->
                   Db.open "sqlite" (dir ++ "/registry.db")
                       |> Task.andThen
                              (\db ->
                                  let
                                      st = Store.local (dir ++ "/store")
                                  in
                                      Registry.open db st
                                          |> Task.map (\reg -> { reg = reg, store = st, dir = dir })))


-- Register a safetensors adapter `tag` with a GGUF export and its
-- adapter_config.json as companions.
registerTag : World -> String -> Task Error Registry.Version
registerTag w tag =
    let
        weights = w.dir ++ "/" ++ tag ++ ".safetensors"
        gguf = w.dir ++ "/" ++ tag ++ ".gguf"
        config = w.dir ++ "/" ++ tag ++ "-adapter_config.json"
    in
        File.writeFile weights (safetensors tag)
            |> Task.andThen (\_ -> File.writeFile gguf ("GGUF export of " ++ tag))
            |> Task.andThen (\_ -> File.writeFile config "{\"peft_type\":\"LORA\",\"r\":8}")
            |> Task.andThen
                   (\_ ->
                       Registry.registerWith
                           w.reg
                           "support-lora"
                           { path = weights, format = Safetensors, method = Lora }
                           lineage
                           [ { role = "gguf", path = gguf }
                           , { role = "peft.config", path = config }
                           ])


promoted : Result Error ( Maybe Registry.VersionManifest, Maybe Registry.Pointer, Maybe Registry.Pointer )
promoted =
    world
        |> Task.andThen
               (\w ->
                   registerTag w "one"
                       |> Task.andThen
                              (\v1 ->
                                  Registry.forcePromote w.reg "prod" v1 "first"
                                      |> Task.andThen (\_ -> Registry.readPointer w.store "support-lora" "prod")
                                      |> Task.andThen
                                             (\first ->
                                                 registerTag w "two"
                                                     |> Task.andThen
                                                            (\v2 -> Registry.forcePromote w.reg "prod" v2 "second")
                                                     |> Task.andThen
                                                            (\_ ->
                                                                Task.map2
                                                                    (\m second -> ( m, first, second ))
                                                                    (Registry.readManifest w.store "support-lora" 2)
                                                                    (Registry.readPointer w.store "support-lora" "prod")))))
        |> Task.run


-- A pointer that a later generation already replaced is never moved back:
-- the store holds generation 9; a promotion that commits generation 2 in the
-- database leaves it, and publishing again writes nothing.
stale : Result Error ( Maybe Registry.Pointer, Int )
stale =
    world
        |> Task.andThen
               (\w ->
                   registerTag w "one"
                       |> Task.andThen
                              (\v1 ->
                                  Store.putAt
                                      w.store
                                      "aliases/support-lora/prod.json"
                                      "{\"alias\":\"prod\",\"digest\":\"x\",\"generation\":9,\"name\":\"support-lora\",\"number\":7,\"servedName\":\"support-lora-v7\",\"v\":1}"
                                      |> Task.andThen (\_ -> Registry.forcePromote w.reg "prod" v1 "late")
                                      |> Task.andThen (\_ -> Registry.publishPointers w.reg "support-lora")
                                      |> Task.andThen
                                             (\n ->
                                                 Registry.readPointer w.store "support-lora" "prod"
                                                     |> Task.map (\p -> ( p, n )))))
        |> Task.run


resolved : Result Error ( ( String, String ), ( String, String ), String )
resolved =
    world
        |> Task.andThen
               (\w ->
                   registerTag w "one"
                       |> Task.andThen (\v -> Registry.forcePromote w.reg "qa" v "serve")
                       |> Task.andThen
                              (\_ ->
                                  let
                                      r = Registry.storeResolver w.store
                                      db = Registry.resolver (Task.succeed w.reg)
                                  in
                                      Task.map3
                                          (\remote local fromDb ->
                                              ( ( remote.servedName, remote.format )
                                              , ( local.format, String.right 5 local.path )
                                              , fromDb.format
                                              ))
                                          (r.resolve "registry:support-lora@qa" False)
                                          (r.resolve "support-lora@qa" True)
                                          (db.resolve "registry:support-lora@qa" True)))
        |> Task.run


-- The local store's named objects: create-once, a conditional replace, a
-- listing from an offset, a fetch checked against its digest, and a delete
-- below a prefix.
writes : Store -> Task Error ( Bool, Bool, Bool )
writes st =
    Store.putIf st "runs/a/x.json" "" "{\"n\":1}"
        |> Task.andThen
               (\first ->
                   Store.putIf st "runs/a/x.json" "" "{\"n\":2}"
                       |> Task.andThen
                              (\second ->
                                  Store.getObject st "runs/a/x.json"
                                      |> Task.map (Maybe.map .generation)
                                      |> Task.andThen
                                             (\gen ->
                                                 Store.putIf st "runs/a/x.json" (Maybe.withDefault "" gen) "{\"n\":3}")
                                      |> Task.map (\third -> ( first, second, third ))))


reads : Store -> Task Error ( List String, Int, String )
reads st =
    Task.sequence
        (List.map
            (\k -> Store.putAt st ("runs/a/events/" ++ k) "line\n")
            [ "00000000.jsonl", "00000001.jsonl", "00000002.jsonl" ])
        |> Task.andThen (\_ -> Store.list st "runs/a/events/" "runs/a/events/00000000.jsonl")
        |> Task.andThen
               (\listed ->
                   Store.fetchAt st "runs/a/x.json" (Crypto.sha256 "{\"n\":3}")
                       |> Task.andThen File.readFile
                       |> Task.andThen
                              (\body ->
                                  Store.deletePrefix st "runs/a/"
                                      |> Task.map (\n -> ( listed, n, body ))))


named : Result Error ( ( Bool, Bool, Bool ), ( List String, Int, String ) )
named =
    File.tempDir "sky-store-named"
        |> Task.map Store.local
        |> Task.andThen (\st -> writes st |> Task.andThen (\w -> reads st |> Task.map (\r -> ( w, r ))))
        |> Task.run


mismatch : Result Error String
mismatch =
    File.tempDir "sky-store-mismatch"
        |> Task.andThen
               (\dir ->
                   let
                       st = Store.local dir
                   in
                       Store.putAt st "a.json" "{}"
                           |> Task.andThen (\_ -> Store.fetchAt st "a.json" (Crypto.sha256 "other")))
        |> Task.run


codeOf : Result Error a -> String
codeOf r =
    case r of

        Err e ->
            Maybe.withDefault "?" (Maybe.map Failure.code (Failure.fromError e))

        Ok _ ->
            "Ok"


tests : List Test
tests =
    [ Test.test
          "register writes the version's manifest; each promotion moves the alias's pointer"
          (\_ ->
              case promoted of

                  Ok ( Just m, Just first, Just second ) ->
                      Test.equal
                          ( ( m.label, m.servedName, m.format )
                          , ( m.baseId, String.length m.gguf, String.length m.peftConfig, m.peft == m.digest )
                          , ( ( first.number, first.generation ), ( second.number, second.generation ) )
                          )
                          ( ( "support-lora@v2", "support-lora-v2", "safetensors" )
                          , ( "Qwen/Qwen2.5-0.5B-Instruct@7ae557604adf67be50417f59c2c2f167def9a775", 64, 64, True )
                          , ( ( 1, 1 ), ( 2, 2 ) )
                          )

                  Ok other ->
                      Test.fail "a manifest or a pointer is missing"

                  Err e ->
                      Test.fail (Error.toString e))
    , Test.test
          "a newer pointer in the store is never moved back by an older generation"
          (\_ ->
              case stale of

                  Ok ( Just p, n ) ->
                      Test.equal ( p.number, p.generation, n ) ( 7, 9, 0 )

                  Ok ( Nothing, _ ) ->
                      Test.fail "the pointer is gone"

                  Err e ->
                      Test.fail (Error.toString e))
    , Test.test
          "the store resolver serves the served name remotely and the GGUF companion locally"
          (\_ ->
              Test.equal
                  (Ok ( ( "support-lora-v1", "safetensors" ), ( "gguf", "gguf" ), "gguf" ))
                  (Result.map
                      (\( remote, ( fmt, _ ), dbFormat ) -> ( remote, ( fmt, "gguf" ), dbFormat ))
                      resolved))
    , Test.test
          "named objects: create once, replace by generation, list from an offset, fetch, delete"
          (\_ ->
              Test.equal
                  (Ok
                      ( ( True, False, True )
                      , ( [ "runs/a/events/00000001.jsonl", "runs/a/events/00000002.jsonl" ], 4, "{\"n\":3}" )
                      ))
                  named)
    , Test.test
          "a named object fetched against the wrong digest is ChecksumMismatch"
          (\_ -> Test.equal "ChecksumMismatch" (codeOf mismatch))
    ]
