module Std.UiPseudoClassTest exposing (tests)

-- Sky-side fixtures for the Std.Ui pseudo-class primitive
-- (`Background.hoverColor` / `Font.focusColor` / `Border.activeColor`
-- / `Ui.onPseudo`, issue #377).
--
-- Covers the pure parts of the API surface — the `PseudoClass` ADT,
-- the wire-format `pseudoClassTag` (h/f/v/a/d), the CSS-selector
-- mapping `pseudoClassSelector`, and the `encodePseudoRules` /
-- `collectPseudoRules` round-trip. The runtime injection / scoping
-- side is covered by `runtime-go/rt/live_pseudo_class_test.go`; the
-- compile-pipeline side by `test/Sky/Build/UiPseudoClassSpec.hs`.
-- This file is the pure-Sky regression fence against accidental
-- tag-drift / encoding drift.
import Sky.Core.Prelude exposing (..)
import Sky.Core.List as List
import Sky.Core.String as String
import Std.Ui as Ui
import Std.Ui.Background as Background
import Std.Ui.Font as Font
import Std.Ui.Border as Border
import Sky.Test as Test exposing (Test)


tests : List Test
tests =
    [Test.suite
        "Std.Ui pseudo-class primitive (#377)"
        [ Test.test
              "Hover → wire tag h"
              (\_ -> Test.equal "h" (Ui.pseudoClassTag Ui.hover))
        , Test.test
              "Focus → wire tag f (sticky :focus)"
              (\_ -> Test.equal "f" (Ui.pseudoClassTag Ui.focus))
        , Test.test
              "FocusVisible → wire tag v (the safer default)"
              (\_ -> Test.equal "v" (Ui.pseudoClassTag Ui.focusVisible))
        , Test.test
              "Active → wire tag a"
              (\_ -> Test.equal "a" (Ui.pseudoClassTag Ui.active))
        , Test.test
              "Disabled → wire tag d"
              (\_ -> Test.equal "d" (Ui.pseudoClassTag Ui.disabled))
        , Test.test
              "Hover → :hover selector"
              (\_ -> Test.equal ":hover" (Ui.pseudoClassSelector Ui.hover))
        , Test.test
              "Focus → :focus selector (sticky variant)"
              (\_ -> Test.equal ":focus" (Ui.pseudoClassSelector Ui.focus))
        , Test.test
              "FocusVisible → :focus-visible selector (keyboard-nav only)"
              (\_ ->
                  Test.equal
                      ":focus-visible"
                      (Ui.pseudoClassSelector Ui.focusVisible))
        , Test.test
              "Active → :active selector"
              (\_ -> Test.equal ":active" (Ui.pseudoClassSelector Ui.active))
        , Test.test
              "Disabled → :disabled selector"
              (\_ -> Test.equal ":disabled" (Ui.pseudoClassSelector Ui.disabled))
        , Test.test
              "encodePseudoRules empty list → empty string"
              (\_ -> Test.equal "" (Ui.encodePseudoRules []))
        , Test.test
              "encodePseudoRules single entry → tag|rules"
              (\_ ->
                  Test.equal
                      "h| color: red;"
                      (Ui.encodePseudoRules [( "h", " color: red;" )]))
        , Test.test
              "encodePseudoRules two entries → tag1|r1||tag2|r2"
              (\_ ->
                  Test.equal
                      "h| color: red;||v| border-color: blue;"
                      (Ui.encodePseudoRules
                          [ ( "h", " color: red;" )
                          , ( "v", " border-color: blue;" )
                          ]))
        , Test.test
              "collectPseudoRules drops AttrPseudoRule with empty CSS"
              (\_ ->
                  Test.equal
                      []
                      (Ui.collectPseudoRules [Ui.onPseudo Ui.hover []]))
        , Test.test
              "Background.hoverColor → one Hover rule (tag h)"
              (\_ ->
                  let
                      attrs = [Background.hoverColor (Ui.rgb 30 90 170)]
                      entries = Ui.collectPseudoRules attrs
                      firstTag =
                          case List.head entries of

                              Just t ->
                                  case t of

                                      ( tag, _ ) ->
                                          tag

                              Nothing ->
                                  "(none)"
                  in
                      Test.equal "h" firstTag)
        , Test.test
              "Font.focusColor → focus-visible (safer default)"
              (\_ ->
                  let
                      attrs = [Font.focusColor (Ui.rgb 0 122 255)]
                      entries = Ui.collectPseudoRules attrs
                      firstTag =
                          case List.head entries of

                              Just t ->
                                  case t of

                                      ( tag, _ ) ->
                                          tag

                              Nothing ->
                                  "(none)"
                  in
                      Test.equal "v" firstTag)
        , Test.test
              "Background.activeColor → tag a"
              (\_ ->
                  let
                      attrs = [Background.activeColor (Ui.rgb 0 62 175)]
                      entries = Ui.collectPseudoRules attrs
                      firstTag =
                          case List.head entries of

                              Just t ->
                                  case t of

                                      ( tag, _ ) ->
                                          tag

                              Nothing ->
                                  "(none)"
                  in
                      Test.equal "a" firstTag)
        , Test.test
              "Background.disabledColor → tag d"
              (\_ ->
                  let
                      attrs =
                          [Background.disabledColor (Ui.rgb 200 200 200)]
                      entries = Ui.collectPseudoRules attrs
                      firstTag =
                          case List.head entries of

                              Just t ->
                                  case t of

                                      ( tag, _ ) ->
                                          tag

                              Nothing ->
                                  "(none)"
                  in
                      Test.equal "d" firstTag)
        , Test.test
              "Border.hoverWidth → produces border-width CSS rule"
              (\_ ->
                  let
                      attrs = [Border.hoverWidth 3]
                      entries = Ui.collectPseudoRules attrs
                      firstCss =
                          case List.head entries of

                              Just t ->
                                  case t of

                                      ( _, css ) ->
                                          css

                              Nothing ->
                                  ""
                  in
                      Test.equal True (String.contains "border-width" firstCss))
        , Test.test
              "stacked hover + focus + active → three entries"
              (\_ ->
                  let
                      attrs =
                          [ Background.hoverColor (Ui.rgb 0 92 215)
                          , Font.focusColor (Ui.rgb 255 102 0)
                          , Background.activeColor (Ui.rgb 0 62 175)
                          ]
                      entries = Ui.collectPseudoRules attrs
                  in
                      Test.equal 3 (List.length entries))
        , Test.test
              "Ui.onPseudo with empty attrs is filtered out"
              (\_ ->
                  let
                      attrs = [Ui.onPseudo Ui.hover []]
                      entries = Ui.collectPseudoRules attrs
                  in
                      Test.equal 0 (List.length entries))
        ]]
