module Main exposing (main)

-- Perf gate program 5: cons n units onto a List (). The elements are
-- zero-size in Go, so this pins the zero-size path of the cons blocks.

import Sky.Core.Prelude exposing (..)
import Sky.Core.List as List
import Sky.Core.Maybe as Maybe
import Sky.Core.String as String
import Sky.Core.Task as Task
import System
import Std.Log exposing (println)


build : Int -> List () -> List ()
build n acc =
    if n <= 0 then
        acc

    else
        build (n - 1) (() :: acc)


work : Int -> String
work n =
    String.fromInt (List.length (build n []))


main =
    let
        _ =
            System.getArg 1
                |> Task.map
                       (\m ->
                           m |> Maybe.andThen String.toInt
                               |> Maybe.withDefault 1000)
                |> Task.andThen (\n -> println (work n))
                |> Task.run
    in
        ()
