module Main exposing (main)

-- Perf gate program 3: String.toList then String.fromList over n code
-- points of mixed ASCII and multibyte text (4 MB at 4n).

import Sky.Core.Prelude exposing (..)
import Sky.Core.List as List
import Sky.Core.Maybe as Maybe
import Sky.Core.String as String
import Sky.Core.Task as Task
import System
import Std.Log exposing (println)


-- 16 code points: ASCII, Latin-1, CJK, a symbol and spaces.
sample : String
sample =
    "abc déf 漢字 xyz€ü"


work : Int -> String
work n =
    let
        text = String.repeat (n // 16) sample
        back = String.fromList (String.toList text)
    in
        String.fromInt (String.length back) ++ " "
            ++ (if back == text then
                   "same"

               else
                   "DIFFERENT")


main =
    let
        _ =
            System.getArg 1
                |> Task.map
                       (\m ->
                           m |> Maybe.andThen String.toInt
                               |> Maybe.withDefault 1000)
                |> Task.andThen (\n -> println (work n))
                |> Task.run
    in
        ()
