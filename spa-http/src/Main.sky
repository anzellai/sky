module Main exposing (main)

import Sky.Core.Prelude exposing (..)
import Sky.Core.String as String
import Sky.Core.Error exposing (Error)
import Std.Spa as Spa
import Std.Sub as Sub
import Std.Html as Html exposing (Html)
import Std.Html.Attributes as Attr
import Std.Html.Events as Events
import Sky.Core.Http as Http exposing (HttpResponse)


-- P3 async-perform / Http acceptance app. Clicking "Load" returns
-- `Cmd.perform (Http.get "/api") GotResp`. On the client, Http.get is the
-- fetch-based kernel: it returns a Promise the interpreter resolves via
-- .then/.catch, then dispatches `GotResp (Ok resp)` on success or
-- `GotResp (Err _)` when the fetch rejects — the error branch is dispatched,
-- never dropped. The harness stubs `globalThis.fetch`.


type alias Model =
    { state : String
    , status : Int
    , body : String
    }


type Msg
    = Load
    | GotResp (Result Error HttpResponse)


init : a -> ( Model, Cmd Msg )
init _ =
    ( { state = "init", status = 0, body = "" }, Cmd.none )


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of
        Load ->
            ( model, Cmd.perform (Http.get "/api") GotResp )

        GotResp (Ok resp) ->
            ( { model | state = "ok", status = resp.status, body = resp.body }
            , Cmd.none
            )

        GotResp (Err _) ->
            ( { model | state = "err", status = -1, body = "" }, Cmd.none )


view : Model -> Html Msg
view model =
    Html.div []
        [ Html.h1 [] [ Html.text "Sky.Spa http" ]
        , Html.p [ Attr.id "state" ] [ Html.text model.state ]
        , Html.p [ Attr.id "status" ] [ Html.text (String.fromInt model.status) ]
        , Html.p [ Attr.id "body" ] [ Html.text model.body ]
        , Html.button [ Attr.id "load", Events.onClick Load ]
            [ Html.text "Load" ]
        ]


subscriptions : Model -> Sub Msg
subscriptions _ =
    Sub.none


main : Task Error ()
main =
    Spa.app
        (Spa.config
            { init = init
            , update = update
            , view = view
            , subscriptions = subscriptions
            }
        )
