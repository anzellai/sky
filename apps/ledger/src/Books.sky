module Books exposing (..)

-- Books — the persistence layer for Ledger.
--
-- ONE codec per row type drives (a) the dialect-correct DDL that
-- `sky db migrate --gen` derives, (b) every write, and (c) every read.
-- Nothing here is dialect-specific: the connection is opened from the
-- environment (`Db.connect ()` → SKY_DB_PATH / DATABASE_URL) and the driver
-- is inferred from the DSN shape by the runtime, so this exact source runs
-- on SQLite and on Postgres.

import Sky.Core.Prelude exposing (..)
import Sky.Core.Task as Task
import Sky.Core.Error as Error exposing (Error)
import Sky.Core.System as System
import Std.Log exposing (println)
import Std.Codec as Codec exposing (Codec)
import Std.Db as Db
import Std.Db.Store as Store exposing (Store)


-- ─── Connection ──────────────────────────────────────────────────
-- Memoised CAF: ONE pool per process. `Db.connect ()` takes NO DSN — it
-- reads SKY_DB_PATH, falling back to DATABASE_URL
-- (runtime-go/rt/db_auth.go:212-218), then `detectDriver` (db_auth.go:337)
-- routes `postgres://…` to pgx and everything else to sqlite. That is the
-- whole "identical source, driver from env" mechanism.
conn =
    case Task.run (Db.connect ()) of

        Ok c ->
            c

        Err e ->
            let
                _ =
                    println
                        ("ledger: FATAL cannot open database: "
                            ++ Error.toString e)
            in
                System.exit 1

-- ─── Row types ───────────────────────────────────────────────────
-- Every tenant-scoped row carries `orgId`. Money is stored as signed MINOR
-- units (Int) — never a Float — and lifted to `Std.Money.Money` at the
-- domain boundary (see Amounts.sky).
type alias Org =
    { id : Int
    , name : String
    , createdAt : String
    }

type alias User =
    { id : Int
    , orgId : Int
    , email : String
    , passwordHash : String
    , role : String
    , createdAt : String
    }

type alias Account =
    { id : Int
    , orgId : Int
    , code : String
    , name : String
    , kind : String
    , createdAt : String
    }

type alias Entry =
    { id : Int
    , orgId : Int
    , entryDate : String
    , memo : String
    , createdAt : String
    }

type alias Line =
    { id : Int
    , orgId : Int
    , entryId : Int
    , accountId : Int
    , amountMinor : Int
    }

type alias Close =
    { id : Int
    , orgId : Int
    , period : String
    , netMinor : Int
    , closedAt : String
    }


-- ─── Blank values (the shape `Codec.auto` reflects) ──────────────
blankOrg : Org
blankOrg =
    { id = 0, name = "", createdAt = "" }


blankUser : User
blankUser =
    { id = 0
    , orgId = 0
    , email = ""
    , passwordHash = ""
    , role = ""
    , createdAt = ""
    }


blankAccount : Account
blankAccount =
    { id = 0, orgId = 0, code = "", name = "", kind = "", createdAt = "" }


blankEntry : Entry
blankEntry =
    { id = 0, orgId = 0, entryDate = "", memo = "", createdAt = "" }


blankLine : Line
blankLine =
    { id = 0, orgId = 0, entryId = 0, accountId = 0, amountMinor = 0 }


blankClose : Close
blankClose =
    { id = 0, orgId = 0, period = "", netMinor = 0, closedAt = "" }


-- ─── Stores ──────────────────────────────────────────────────────
orgs : Store Org
orgs =
    Store.fromCodec "orgs" (Codec.auto blankOrg) |> Store.serial "id"
        |> Store.unique "name"
        |> Store.defaultNow "createdAt"


users : Store User
users =
    Store.fromCodec "users" (Codec.auto blankUser) |> Store.serial "id"
        |> Store.unique "email"
        |> Store.defaultText "role" "member"
        |> Store.defaultNow "createdAt"


accounts : Store Account
accounts =
    Store.fromCodec "accounts" (Codec.auto blankAccount) |> Store.serial "id"
        |> Store.defaultText "kind" "asset"
        |> Store.defaultNow "createdAt"


journalEntries : Store Entry
journalEntries =
    Store.fromCodec "journal_entries" (Codec.auto blankEntry)
        |> Store.serial "id"
        |> Store.defaultText "memo" ""
        |> Store.defaultNow "createdAt"


journalLines : Store Line
journalLines =
    Store.fromCodec "journal_lines" (Codec.auto blankLine) |> Store.serial "id"
        |> Store.defaultInt "amountMinor" 0


closes : Store Close
closes =
    Store.fromCodec "period_closes" (Codec.auto blankClose) |> Store.serial "id"
        |> Store.defaultInt "netMinor" 0
        |> Store.defaultNow "closedAt"


-- | The project declaration `sky db migrate --gen` reads to derive the
-- committed, dialect-neutral migration files in `db/migrations/`.
-- Re-exported from Main as `db : Store.Project`.
project : Store.Project
project =
    Store.project
        [ Store.toTable orgs
        , Store.toTable users
        , Store.toTable accounts
        , Store.toTable journalEntries
        , Store.toTable journalLines
        , Store.toTable closes
        ]

-- ─── Aggregate projection (raw SQL, dialect-portable) ────────────
-- `?` placeholders are rebound to `$N` for pgx by the runtime
-- (runtime-go/rt/db_auth.go:73-95), and `SUM(...)` + `GROUP BY` are ANSI —
-- so this one raw query is correct on both backends. Column aliases are
-- snake_case because `Codec.auto` reflects record fields that way.
type alias BalanceRow =
    { accountId : Int
    , totalMinor : Int
    }


balanceRowCodec : Codec BalanceRow
balanceRowCodec =
    Codec.auto { accountId = 0, totalMinor = 0 }
