module Main exposing (main)

-- Reproduction, now a fence, for the Std.Ui.Events.onInput signature.
--
-- WAS: `sky-stdlib/Std/Ui/Events.sky:30` declared
--     onInput : msg -> Ui.Attribute msg
-- while its body forwarded to `sky-stdlib/Std/Ui.sky:816`
--     onInput : (String -> msg) -> Attribute msg
--
-- So the re-export's annotation said "give me a Msg" while the only
-- value its body can accept is a `String -> Msg` callback. The bare-Msg
-- form below type-checked because `Attribute`'s event arm holds an
-- `any`, which makes `msg` phantom on that constructor — the annotation
-- was never forced to agree with the payload.
--
-- It was wrong at runtime: the Sky.Live dispatcher only applies the
-- typed input value to a handler that is a FUNCTION (`applyMsgArgs`,
-- runtime-go/rt/live.go). A bare Msg is not, so every keystroke
-- dispatched the same static message and the typed String the user
-- typed was silently dropped.
--
-- FIXED by converging the re-export on `(String -> msg) -> Attribute msg`,
-- matching Std.Ui.onInput and docs/skyui/overview.md. The bare-Msg form
-- is now a TYPE ERROR:
--
--     probe = Events.onInput Bare
--     -- [E2001] type mismatch: String -> _ vs Msg
--
-- so the runtime-wrong shape can no longer compile. This module keeps
-- the CORRECT shape compiling, so the fence stays honest in both
-- directions.

import Sky.Core.Prelude exposing (..)
import Std.Log exposing (println)
import Std.Ui as Ui
import Std.Ui.Events as Events


type Msg
    = Typed String
    | Bare


-- The shape the re-export now requires: a Msg constructor that takes
-- the input's String value.
probe : Ui.Attribute Msg
probe =
    Events.onInput Typed


-- `Bare` still has a use that does NOT go through onInput, so the
-- constructor is not dead weight in this fixture.
clickProbe : Ui.Attribute Msg
clickProbe =
    Events.onClick Bare


main =
    let
        _ = probe
        _ = clickProbe
    in
        println "probe"
