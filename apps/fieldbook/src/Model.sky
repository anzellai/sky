module Model exposing (..)

-- Fieldbook — pure domain model.
--
-- Deliberately free of any `Std.Ui` import: the heavy Std.Ui
-- unification load lives in View.sky, and keeping the domain module
-- Ui-free keeps the per-module HM heap small (same discipline as
-- examples/38-composite-ui-multibackend/src/State.sky).
--
-- Every value here is DETERMINISTIC — no clock, no uuid, no random.
-- That is load-bearing: `--dump-view` has to produce byte-identical
-- output on every run so a CI harness can diff two invocations.

import Sky.Core.Prelude exposing (..)
import Sky.Core.List as List
import Sky.Core.String as String

-- A single field note. `readingC` is decidegrees Celsius (92 → 9.2 °C)
-- so the whole model stays integral — no Float rounding drift between
-- the Live dump and the Tui dump.
type alias Note =
    { id : Int
    , title : String
    , body : String
    , site : String
    , tags : List String
    , readingC : Int
    , day : Int
    }

type alias Viewport =
    { width : Int
    , height : Int
    }

type alias Model =
    { notes : List Note
    , query : String
    , selected : Maybe Int
    , draftTitle : String
    , draftBody : String
    , editing : Bool
    , nextId : Int
    , viewport : Viewport
    , status : String
    }

type Msg
    = SetQuery String
    | ClearQuery
    | RunSearch
    | SelectNote Int
    | CloseNote
    | StartEdit
    | SetDraftTitle String
    | SetDraftBody String
    | SaveEdit
    | CancelEdit
    | NewNote
    | DeleteNote Int
    | QuitApp
    | NoOp


