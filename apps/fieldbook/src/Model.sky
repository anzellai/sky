-- Fixed initial model. Written as a `()`-function rather than a CAF so
-- that intent is explicit at every call site; the body is pure so
-- either form would be correct here.
initialModel : () -> Model
initialModel _ =
    { notes = seedNotes
    , query = ""
    , selected = Just 1
    , draftTitle = ""
    , draftBody = ""
    , editing = False
    , nextId = 8
    , viewport = { width = 1280, height = 800 }
    , status = "ready"
    }


-- ─── Search ─────────────────────────────────────────────────────────
-- Case-insensitive substring match across title, body, site and tags.
matchesQuery : String -> Note -> Bool
matchesQuery raw note =
    let
        q = String.toLower (String.trim raw)
        hay =
            String.toLower
                (note.title ++ " " ++ note.body ++ " " ++ note.site ++ " "
                    ++ String.join " " note.tags)
    in
        if String.isEmpty q then
            True

        else
            String.contains q hay


visibleNotes : Model -> List Note
visibleNotes model =
    List.filter (matchesQuery model.query) model.notes


noteById : Int -> List Note -> Maybe Note
noteById wanted notes =
    List.find (\n -> n.id == wanted) notes


selectedNote : Model -> Maybe Note
selectedNote model =
    case model.selected of

        Nothing ->
            Nothing

        Just wanted ->
            noteById wanted model.notes


-- ─── Derived numbers ────────────────────────────────────────────────
-- Chart series: temperature readings in day order, as (x, y) floats.
readingPoints : List Note -> List ( Float, Float )
readingPoints notes =
    List.map (\n -> ( intToFloat n.day, intToFloat n.readingC / 10.0 )) notes


-- Per-site note counts, in first-seen order. Feeds the bar chart and
-- the summary tiles.
siteCounts : List Note -> List ( String, Int )
siteCounts notes =
    List.foldl addSite [] notes


addSite : Note -> List ( String, Int ) -> List ( String, Int )
addSite note acc =
    if List.any (\pair -> fst pair == note.site) acc then
        List.map
            (\pair ->
                if fst pair == note.site then
                    ( fst pair, snd pair + 1 )

                else
                    pair)
            acc

    else
        acc ++ [ ( note.site, 1 ) ]


-- Distinct tags across the corpus, in first-seen order.
allTags : List Note -> List String
allTags notes =
    List.foldl addTags [] notes


addTags : Note -> List String -> List String
addTags note acc =
    List.foldl addOneTag acc note.tags


addOneTag : String -> List String -> List String
addOneTag tag acc =
    if List.member tag acc then
        acc

    else
        acc ++ [ tag ]


averageReading : List Note -> Int
averageReading notes =
    let
        n = List.length notes
        total = List.foldl (\note acc -> acc + note.readingC) 0 notes
    in
        if n == 0 then
            0

        else
            total // n


-- ─── Formatting ─────────────────────────────────────────────────────
formatReading : Int -> String
formatReading deci =
    let
        whole = deci // 10
        frac = deci - (whole * 10)
    in
        String.fromInt whole ++ "." ++ String.fromInt frac ++ " C"


tagLine : Note -> String
tagLine note =
    String.join " / " note.tags


dayLabel : Int -> String
dayLabel day =
    "day " ++ pad2 day


pad2 : Int -> String
pad2 n =
    let
        s = String.fromInt n
    in
        if String.length s >= 2 then
            s

        else
            String.repeat (2 - String.length s) "0" ++ s


intToFloat : Int -> Float
intToFloat n =
    case String.toFloat (String.fromInt n) of

        Just f ->
            f

        Nothing ->
            0.0


-- ─── CSV export (the Sky.Cli one-shot) ──────────────────────────────
exportCsv : List Note -> String
exportCsv notes =
    String.join
        "\n"
        ("id,day,site,reading_c,tags,title" :: List.map exportRow notes)


exportRow : Note -> String
exportRow note =
    String.join
        ","
        [ String.fromInt note.id
        , String.fromInt note.day
        , csvField note.site
        , formatReading note.readingC
        , csvField (String.join ";" note.tags)
        , csvField note.title
        ]


-- Quote a field when it could contain a comma or a quote. Kept simple
-- and total — no partial functions, no panics.
csvField : String -> String
csvField s =
    if String.contains "," s || String.contains "\"" s then
        "\"" ++ String.replace "\"" "\"\"" s ++ "\""

    else
        s
