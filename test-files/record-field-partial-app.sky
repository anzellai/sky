-- Surface 2 regression test (closed 2026-05-24).
--
-- Pre-fix: Sky.Live wire dispatcher panicked at runtime when invoking
--   a callback stored in a parametric record alias field — Go's
--   nominal function types refuse `func(Form_R) Msg` ≠ `func(any) Msg`.
--
-- Post-fix: struct emission erases TVar fields to `any` AND the
--   runtime func-target Coerce path (rt.Coerce → makeFuncAdapter)
--   widens nominally-different func signatures at the call boundary.
--
-- This test mirrors the skydeploy/sky-editor pattern: a widget module
-- exposing a Cfg alias + a `view`-style consumer that field-accesses
-- the callback without an explicit signature.
module Main exposing (main)

import Sky.Core.Prelude exposing (..)
import Std.Log exposing (println)


type alias Form =
    { name : String, action : String }


type Msg
    = SaveFile Int String Form


type alias Cfg msg =
    { onSubmit : Form -> msg
    , label : String
    }


-- Widget consumer — no explicit type signature on its parameter.
-- HM infers the structural row, NOT the Cfg alias (works around
-- Surface 1).  Field access on cfg.onSubmit returns the partial-
-- applied ctor.
runWidget cfg form =
    cfg.onSubmit form


-- Consumer constructs the Cfg with a partial-applied Msg ctor —
-- the exact pattern that lowered to `rt.Coerce[func(any) Msg](
-- func(Form_R) Msg{...})` and panicked at runtime pre-fix.
main =
    let
        cfg = { onSubmit = SaveFile 42 "Main.sky"
              , label = "Save Main.sky"
              }
        form = { name = "Main.sky", action = "save" }
        result = runWidget cfg form
    in
    case result of
        SaveFile aid fn frm ->
            println
                ("SaveFile " ++ String.fromInt aid ++ " " ++ fn
                    ++ " {" ++ frm.name ++ "," ++ frm.action ++ "}")
