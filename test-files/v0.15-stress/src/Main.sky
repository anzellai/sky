-- v0.15 stress test — every parametric-record-alias surface exercised.
--
-- Sections labelled S1A, S1B, S2, S3a, S3b, S4 (lambda), S5 (readback),
-- S6 (same-module poly), then recursive / phantom / Maybe-List / update.
--
-- Each section's expected output is asserted in `main`.  A non-zero
-- exit code means an assertion failed.  Run with the v0.15 compiler;
-- pre-v0.15 hits Surface 1 at type-check.
module Main exposing (main)

import Sky.Core.Prelude exposing (..)
import Std.Log exposing (println)
import Widget.Editor as Editor
import Widget.Editor exposing (Cfg, Form)
import Inner.Polymorphic as Poly


-- ═══════════════════════════════════════════════════════════
-- ADT used by every Msg-style test
-- ═══════════════════════════════════════════════════════════

type Msg
    = Tag String
    | SaveFile Int String Form
    | NoOp


type IntMsg
    = II Int


type BoolMsg
    = BB Bool


-- ═══════════════════════════════════════════════════════════
-- S3a — structurally-identical concrete record alias
-- (cross-alias passing requires alias chain post-v0.15)
-- ═══════════════════════════════════════════════════════════

type alias FileForm =
    Editor.Form


mkFile : String -> String -> FileForm
mkFile c a =
    { content = c, action = a }


-- ═══════════════════════════════════════════════════════════
-- S1A — field access through parametric-alias-typed param
-- WITH explicit signature
-- ═══════════════════════════════════════════════════════════

fireCfg : Cfg Msg -> String -> Msg
fireCfg cfg s =
    cfg.onSubmit s


-- ═══════════════════════════════════════════════════════════
-- S2 — partial-applied ADT ctor in record-literal slot
-- ═══════════════════════════════════════════════════════════

mkCfgPartial : Int -> String -> Cfg Msg
mkCfgPartial appId fileName =
    { onSubmit = SaveFile appId fileName << mkFile fileName
    , label = "save " ++ fileName
    , busy = False
    }


-- A simpler form: partial-applied 1-arg ctor.
mkCfgTag : Cfg Msg
mkCfgTag =
    { onSubmit = Tag
    , label = "tag"
    , busy = False
    }


-- ═══════════════════════════════════════════════════════════
-- S4 — inline lambda in parametric-alias slot (v0.15 Stage C)
-- ═══════════════════════════════════════════════════════════

mkCfgLambda : Cfg Msg
mkCfgLambda =
    { onSubmit = \s -> Tag ("L:" ++ s)
    , label = "lambda"
    , busy = True
    }


-- ═══════════════════════════════════════════════════════════
-- S6 — same-module polymorphic call via dep module (works)
-- ═══════════════════════════════════════════════════════════

intCfg : Cfg IntMsg
intCfg =
    { onSubmit = \s -> II (String.length s)
    , label = "int"
    , busy = False
    }


boolCfg : Cfg BoolMsg
boolCfg =
    { onSubmit = \s -> BB (String.startsWith "y" s)
    , label = "bool"
    , busy = False
    }


-- ═══════════════════════════════════════════════════════════
-- S7 — recursive parametric alias
-- ═══════════════════════════════════════════════════════════

type alias Tree a =
    { value : a
    , kids : List (Tree a)
    }


mkLeaf : Int -> Tree Int
mkLeaf n =
    { value = n, kids = [] }


mkBranch : Int -> List (Tree Int) -> Tree Int
mkBranch n cs =
    { value = n, kids = cs }


sumTree : Tree Int -> Int
sumTree t =
    -- Sky's foldl is (a -> acc -> acc), arg order is (elem, acc).
    t.value + List.foldl (\k acc -> acc + sumTree k) 0 t.kids


-- ═══════════════════════════════════════════════════════════
-- S8 — phantom type parameter
-- ═══════════════════════════════════════════════════════════

type alias Tagged a =
    { id : Int
    , label : String
    }


mkTagged : Int -> String -> Tagged String
mkTagged i l =
    { id = i, label = l }


-- ═══════════════════════════════════════════════════════════
-- S9 — multi-var parametric alias
-- ═══════════════════════════════════════════════════════════

type alias Pair a b =
    { first : a, second : b }


mkPairR : Int -> String -> Pair Int String
mkPairR i s =
    { first = i, second = s }


-- ═══════════════════════════════════════════════════════════
-- S10 — Maybe / List containing parametric alias
-- ═══════════════════════════════════════════════════════════

cfgList : List (Cfg Msg)
cfgList =
    [ mkCfgTag, mkCfgLambda ]


cfgMaybe : Maybe (Cfg Msg)
cfgMaybe =
    Just mkCfgTag


-- ═══════════════════════════════════════════════════════════
-- S11 — record update over parametric alias
-- ═══════════════════════════════════════════════════════════

busyOn : Cfg Msg -> Cfg Msg
busyOn cfg =
    { cfg | busy = True }


-- ═══════════════════════════════════════════════════════════
-- S12 — anonymous record literal at parametric-alias slot
-- ═══════════════════════════════════════════════════════════

useDirectLiteral : String
useDirectLiteral =
    -- The record literal here must unify with Cfg Msg.
    Editor.view
        { onSubmit = Tag, label = "anon", busy = False }


-- ═══════════════════════════════════════════════════════════
-- Helper that prints + asserts equality
-- ═══════════════════════════════════════════════════════════

check : String -> String -> String -> Result String String
check name actual expected =
    if actual == expected then
        Ok (name ++ ": OK")

    else
        Err (name ++ ": expected " ++ expected ++ ", got " ++ actual)


fmtMsg : Msg -> String
fmtMsg m =
    case m of
        Tag s ->
            "Tag " ++ s

        SaveFile aid fn f ->
            "SaveFile " ++ String.fromInt aid ++ " " ++ fn ++ " {" ++ f.content ++ "," ++ f.action ++ "}"

        NoOp ->
            "NoOp"


fmtIM : IntMsg -> String
fmtIM m =
    case m of
        II n ->
            "II " ++ String.fromInt n


fmtBM : BoolMsg -> String
fmtBM m =
    case m of
        BB b ->
            "BB " ++ (if b then "true" else "false")


-- ═══════════════════════════════════════════════════════════
-- Drive every section, accumulate results, print
-- ═══════════════════════════════════════════════════════════

main =
    let
        -- S1A: field access through Cfg Msg
        r_s1a = check "S1A" (fmtMsg (fireCfg mkCfgTag "hi")) "Tag hi"

        -- S1B: anonymous record literal at typed slot via Editor.view
        r_s1b = check "S1B" useDirectLiteral "label=anon/busy=n"

        -- S2: partial-applied ctor in record field
        cfg_p = mkCfgPartial 42 "Main.sky"
        r_s2 = check "S2" (fmtMsg (fireCfg cfg_p "data")) "SaveFile 42 Main.sky {Main.sky,data}"

        -- S4: inline lambda in record field
        r_s4 = check "S4" (fmtMsg (fireCfg mkCfgLambda "hi")) "Tag L:hi"

        -- S6: same-module poly via dep
        r_s6a = check "S6a" (fmtIM (Poly.applyHandler intCfg "hi")) "II 2"
        r_s6b = check "S6b" (fmtBM (Poly.applyHandler boolCfg "yes")) "BB true"

        -- S7: recursive
        leaf = mkLeaf 1
        branch = mkBranch 10 [ mkLeaf 2, mkLeaf 3, mkBranch 4 [ mkLeaf 5 ] ]
        r_s7 = check "S7" (String.fromInt (sumTree branch)) "24"

        -- S8: phantom
        t = mkTagged 1 "x"
        r_s8 = check "S8" (String.fromInt t.id ++ "/" ++ t.label) "1/x"

        -- S9: multi-var
        p = mkPairR 7 "hi"
        r_s9 = check "S9" (String.fromInt p.first ++ "/" ++ p.second) "7/hi"

        -- S10: list / Maybe
        firstFromList = List.head cfgList
        r_s10a = check "S10a" (Maybe.withDefault "none" (Maybe.map .label firstFromList)) "tag"
        r_s10b = check "S10b" (Maybe.withDefault "none" (Maybe.map .label cfgMaybe)) "tag"

        -- S11: record update
        busy = busyOn mkCfgTag
        r_s11 = check "S11" (if busy.busy then "ON" else "OFF") "ON"

        -- S12: anonymous-literal-at-typed-slot tested via useDirectLiteral above (S1B)

        -- S3a: FileForm passed where Form expected (alias chain works)
        ff = mkFile "C" "A"
        r_s3a = check "S3a" (Editor.render ff) "C|A"

        -- S6c: cross-module polymorphic identity at multiple types
        idResult = String.fromInt (Poly.identityM 5) ++ "|" ++ Poly.identityM "x"
        r_s6c = check "S6c" idResult "5|x"

        results =
            [ r_s1a, r_s1b, r_s2, r_s4
            , r_s6a, r_s6b, r_s6c
            , r_s7, r_s8, r_s9
            , r_s10a, r_s10b, r_s11
            , r_s3a
            ]

        report = case Result.combine results of
            Ok oks ->
                "ALL " ++ String.fromInt (List.length oks) ++ " PASS\n"
                    ++ String.join "\n" oks

            Err first ->
                "FAIL: " ++ first
    in
    println report
