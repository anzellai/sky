module Main exposing (main)

import Sky.Core.Prelude exposing (..)
import Std.Log exposing (println)


type Msg
    = Increment
    | Decrement


update : Msg -> Int -> Int
update msg count =
    case msg of
        Increment -> count + 1
        Decrement -> count - 1


main =
    println (String.fromInt (update Increment 0))
