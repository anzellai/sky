module Main exposing (main)

import Sky.Core.Prelude exposing (..)
import Std.Log exposing (println)


-- User-defined polymorphic ADT (Cause E surface) — exercises the
-- _vars propagation path in generateUnionForDep + caller-side TVar
-- routing through ctor functions.
type Box a
    = Box a
    | EmptyBox


unwrap : a -> Box a -> a
unwrap fallback box =
    case box of
        Box v -> v
        EmptyBox -> fallback


main =
    println (unwrap "default" (Box "wrapped"))
