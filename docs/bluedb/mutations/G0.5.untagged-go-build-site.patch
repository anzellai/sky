+/// MUTATION (G0.5/untagged-go-build-site): a fourth compiler `go build`, added
+/// the way the third one really was — a small helper next to the verb that needs
+/// it, with no `-tags` on the argv because the author did not know there was a
+/// tag to carry.
+///
+/// It is in `sky/src/main.rs` rather than `project/src/build.rs` deliberately:
+/// the pre-widening scan read `rust/crates/project/src` ONLY, so a site here is
+/// one the old gate could not have seen at all. The mutation therefore falsifies
+/// the WIDENING as well as the tag invariant.
+#[allow(dead_code)]
+fn mutation_untagged_go_build(runtime_go: &Path, out_bin: &Path) -> Command {
+    let mut cmd = Command::new("go");
+    cmd.arg("build")
+        .arg("-o")
+        .arg(out_bin)
+        .arg("./cmd/sky-hub")
+        .current_dir(runtime_go);
+    cmd
+}
