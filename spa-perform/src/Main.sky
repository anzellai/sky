module Main exposing (main)

import Sky.Core.Prelude exposing (..)
import Sky.Core.String as String
import Std.Spa as Spa
import Std.Sub as Sub
import Std.Html as Html exposing (Html)
import Std.Html.Attributes as Attr
import Std.Html.Events as Events
import Sky.Core.Time as Time


-- P3 perform acceptance app. Clicking "Fetch" returns
-- `Cmd.perform (Time.now ()) GotTime` from update; the client effect
-- interpreter must RUN the (synchronous) Time.now task and dispatch the
-- resulting `GotTime (Ok millis)` Msg, which the model records and the view
-- re-renders. Proves the perform → toMsg(result) → dispatch loop.


type alias Model =
    { time : Int }


type Msg
    = Fetch
    | GotTime (Result Error Int)


init : a -> ( Model, Cmd Msg )
init _ =
    ( { time = 0 }, Cmd.none )


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of
        Fetch ->
            ( model, Cmd.perform (Time.now ()) GotTime )

        GotTime (Ok millis) ->
            ( { model | time = millis }, Cmd.none )

        GotTime (Err _) ->
            ( { model | time = -1 }, Cmd.none )


view : Model -> Html Msg
view model =
    Html.div []
        [ Html.h1 [] [ Html.text "Sky.Spa perform" ]
        , Html.p [ Attr.id "time" ] [ Html.text (String.fromInt model.time) ]
        , Html.button [ Attr.id "fetch", Events.onClick Fetch ]
            [ Html.text "Fetch" ]
        ]


subscriptions : Model -> Sub Msg
subscriptions _ =
    Sub.none


main : Task Error ()
main =
    Spa.app
        (Spa.config
            { init = init
            , update = update
            , view = view
            , subscriptions = subscriptions
            }
        )
