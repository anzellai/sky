# OS
.DS_Store

# Build artifacts
bin/
dist/
sky-out/

# Dependencies
# Both forms: the bare name catches a SYMLINK named node_modules, which the
# trailing-slash pattern (a directory match) lets straight through — that is how
# a symlink to one developer's absolute path reached the published repo.
node_modules
node_modules/

# Sky compiler cache and deps (all projects including examples)
.skycache/
.skydeps/
# Std.App per-target derived build trees (`sky build/run --target` on a
# dispatched Std.App entry stages `main = App.run<Backend> …` here).
.skyapp/
# Sky.Spa auto-split output (`sky build` on a `Spa.app`/spa-target entry writes
# the derived frontend-wasm + backend projects here). A generated artifact —
# never committed. See rust/crates/xtask/src/build_run_gate.rs (manual-split gate).
.split/

# Environment and secrets
.env
.env.*
!.env.example
firebaseadminsdk*.json

# AI agent config. Use `.claude/*` (contents), NOT `.claude/` (the dir), so the
# negation below can re-include a file — git cannot re-include a path whose
# PARENT DIRECTORY is excluded.
.claude/*
# Exception: AUTONOMOUS_GOAL.md is tracked so live autonomous mandates
# survive clones / new sessions per CLAUDE.md non-negotiable #0.
!.claude/AUTONOMOUS_GOAL.md

# Databases
*.db
*.db-shm
*.db-wal

# Logs
*.log

# Session data (repo-root only — don't shadow src/Sky/Data/)
/data/

# Test files
test-*.js
test-*.ts

# Uploads and assets (user-generated)
uploads/
examples/13-skyshop/assets/

# Temporary files
*.tmp

# Editor / merge-tool / ad-hoc backups (never commit)
*.bak
*.orig
*.rej
*.swp
*~

# Bootstrap build artifact (source is kept, binary is not)
bootstrap/app
sky-lang.org
dist-newstyle/
.cabal-sandbox/
cabal.sandbox.config
*.hi
*.o
*.dyn_hi
*.dyn_o
.ghc.environment.*
dist-newstyle/
.cabal-sandbox/
cabal.sandbox.config
*.hi
*.o
*.dyn_hi
*.dyn_o
.ghc.environment.*

# Haskell compiler build
dist-newstyle/

# Legacy compilers
legacy-sky-compiler/bin/
legacy-sky-compiler/dist/
legacy-sky-compiler/sky-out/
legacy-sky-compiler/.skycache/
legacy-ts-compiler/node_modules/

# Runtime database files (from running examples at repo root)
*.db
*.db-shm
*.db-wal

# Stray SQLite files named literally "{}" when a test's connection
# string was the unsubstituted placeholder. Never source; never commit.
**/\{\}

# macOS
.DS_Store

# Legacy dist output (kept under legacy-ts-compiler/ if needed)
/dist/

# Embedded Sky stdlib materialised next to project src by the LSP
# (Sky.Build.Compile.writeStdlibTo) so goto-definition has a stable
# jump target — regenerated on each LSP build, not source code.
**/src/.sky-stdlib/

# Claude Code loop-pause marker (never commit; local-only pause signal)
.claude/allow-stop

# Nix build outputs
/result
/result-*

# direnv / nix-direnv cache
/.direnv/
/.envrc.local
sky.zip

# Local-only example verification — playwright recordings,
# screenshots, traces. Not source; per-developer; regenerated
# whenever scripts/verify-examples.sh is run.
_verify/

# v0.16.0 PR 3 — auto-generated dev-mode console token persisted
# next to the app for stable URLs across rebuilds. Per-machine,
# never source.
.sky/

# Rust-compiler M4 build outputs (xtask build-run)
examples/*/sky-out-rust/

# Generated Go-FFI surface — a build artifact (kernel.json + .skyi + go bindings),
# regenerated from the sky.toml [go.dependencies] declaration via `sky install`
# (out of band; never in the build path). Not committed: rebuilding is from a
# clean slate, and version drift can't produce a committed-surface clash.
sky-ffi/
tests/conformance/sky-out*

# Isolated cargo target dirs used by agents/worktrees. NEVER commit these:
# 1928 files of one leaked into 2aac9db5 via `git add -A` in a worktree where
# the build dir sits at the repo root. Both spellings, same reasoning as the
# node_modules symlink above.
isolated-target
isolated-target/
*-target/

# The cargo workspace lives at rust/target (ignored by rust/.gitignore), but the
# `xtask erasure-fuzz` fuzzer writes its per-case scratch (a Go build + binary
# per generated program, several GB) to repo-root `target/erasure-fuzz`. That
# path is NOT under rust/, so ignore the repo-root target dir explicitly —
# otherwise a `git add -A` would stage multiple GB of ephemeral build output.
/target/

# Sky.Spa spike build artifacts
docs/skyspa/spike/main.wasm
docs/skyspa/spike/wasm_exec.js
