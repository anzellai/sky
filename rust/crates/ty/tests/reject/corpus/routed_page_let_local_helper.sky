-- gate: reject
-- defect: a routing helper bound in a let hid the routed page type
-- rust: reject [E2001] at the helper's use, naming the model's `page` field
--
-- Found 2026-11-19 (v0.29.14). The let-bound `withPages` is generalised, so
-- each use is a fresh instance of its type. The tie between the route pages
-- and the model's `page` field was made once in its generic body and never
-- copied to the instances, so it was dropped unchecked. The program passed
-- `sky check` and stopped at run time on every request.
module Main exposing (main)

import Sky.Core.Prelude exposing (..)
import Std.App as App
import Std.Ui as Ui exposing (Element)

type Route
    = Dashboard
    | Detail String
    | Missing

type alias Model =
    { page : Route
    , title : String
    }

type Msg
    = Inc


init : () -> ( Model, Cmd Msg )
init () =
    ( { page = Dashboard, title = "t" }, Cmd.none )


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of

        Inc ->
            ( model, Cmd.none )


view : Model -> Element Msg
view model =
    Ui.text model.title


app =
    let
        withPages routes missing a =
            a |> App.withRoutes routes |> App.withNotFound missing
    in
        App.app
            { init = init
            , update = update
            , view = view
            , subscriptions = \_ -> Sub.none
            }
            |> withPages [ App.route "/" "home" ] "missing"


main =
    App.run app
