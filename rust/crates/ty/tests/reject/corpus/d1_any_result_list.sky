-- defect: `f : Int -> List any` with body `f x = [x]` returns `List Int`; feeding
--         it to `List.map String.toUpper` (needs `List String`) clashes. The D1
--         result pin (monomorphic body) closes the wildcard-List absorb. oracle:
--         reject [E2001].
module Main exposing (main)
import Sky.Core.Prelude exposing (..)
import Std.Log exposing (println)
f : Int -> List any
f x =
    [ x ]
main =
    always (println "z") (List.map String.toUpper (f 5))
