-- gate: reject
-- defect: a raw `Live.withOnNavigate` function takes a page of another type than the model's `page` field
-- rust: reject [E2001] at Live.withOnNavigate, naming the model's `page` field
--
-- Found 2026-11-19 (v0.29.14). `AppConfig model msg` has no page type, so
-- the `withOnNavigate` page was not tied. Sky.Live gave the `Route` in
-- `page` to a function of `{ count : Int }`: HTTP 500.
module Main exposing (main)

import Sky.Core.Prelude exposing (..)
import Std.Live as Live
import Std.Html as Html exposing (Html)

type Route
    = Dashboard
    | Missing
    | Detail String

type alias Model =
    { page : Route
    , title : String
    }

type Msg
    = Go Int


init : () -> ( Model, Cmd Msg )
init () =
    ( { page = Detail "abc", title = "t" }, Cmd.none )


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of

        Go n ->
            ( { model | title = String.fromInt (n + 1) }, Cmd.none )


view : Model -> Html Msg
view m =
    Html.text m.title


main =
    Live.app
        (Live.config
            { init = init
            , update = update
            , view = view
            , subscriptions = \_ -> Sub.none
            , routes = [ Live.route "/" Dashboard ]
            , notFound = Missing
            }
            |> Live.withOnNavigate (\r -> Go r.count))
