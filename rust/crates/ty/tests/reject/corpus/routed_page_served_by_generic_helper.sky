-- gate: reject
-- defect: a helper that builds and serves the app hid the routed page type
-- rust: reject [E2001] at `App.run` in the helper: the model type is not known there
--
-- Found 2026-11-19 (v0.29.14). `serve` takes the routes, the NotFound page
-- and the app's functions, builds the app and runs it. Its type holds no
-- `App`, so no use of it was tied to the model's `page` field, and the tie
-- in its generic body was dropped. The program passed `sky check` and
-- stopped at run time on every request. A runner (`App.run` and the target
-- runners) must now see the model type of the app it serves.
module Main exposing (main)

import Sky.Core.Prelude exposing (..)
import Std.App as App
import Std.Ui as Ui exposing (Element)

type Route
    = Dashboard
    | Detail String
    | Missing

type alias Model =
    { page : Route
    , title : String
    }

type Msg
    = Inc


init : () -> ( Model, Cmd Msg )
init () =
    ( { page = Dashboard, title = "t" }, Cmd.none )


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of

        Inc ->
            ( model, Cmd.none )


view : Model -> Element Msg
view model =
    Ui.text model.title


serve routes missing parts =
    App.app parts |> App.withRoutes routes |> App.withNotFound missing
        |> App.run


main =
    serve
        [ App.route "/" "home" ]
        "missing"
        { init = init
        , update = update
        , view = view
        , subscriptions = \_ -> Sub.none
        }
