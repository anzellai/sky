-- defect: `/` is Float-only (`Float -> Float -> Float`); integer division uses
--         `//`. With concrete-Int literals, `5 / 2` clashes (Int vs Float).
--         Write `5.0 / 2.0`, or `5 // 2` for integer division. oracle: reject.
module Main exposing (main)
import Sky.Core.Prelude exposing (..)
import Std.Log exposing (println)
main =
    println (String.fromFloat (5 / 2))
