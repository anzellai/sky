-- defect: record literal missing a required field — `{ name = ... }` lacks `age`
-- oracle: reject [E2001] (caught at the call site against the closed `Person`)
module Main exposing (main)

import Sky.Core.Prelude exposing (..)
import Std.Log exposing (println)

type alias Person = { name : String, age : Int }

greet : Person -> String
greet p =
    p.name

main =
    println (greet { name = "Ann" })
