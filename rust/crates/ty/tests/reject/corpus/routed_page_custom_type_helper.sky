-- gate: reject
-- defect: a routing helper hidden in a custom type hid the routed page type
-- rust: reject [E2001] where the app is served, naming the model's `page` field
--
-- Found 2026-11-19 (v0.30.0). The routes are set inside a function that a
-- user custom type (`Router`) holds. The type of `router` shows no `App`
-- node, so no use of it was tied to the model's `page` field, and the tie in
-- its generic body was dropped. The program passed `sky check` and stopped
-- at run time on every request. The check now runs where the app is served.
module Main exposing (main)

import Sky.Core.Prelude exposing (..)
import Std.App as App
import Std.Ui as Ui exposing (Element)

type Route
    = Dashboard
    | Detail String
    | Missing

type alias Model =
    { page : Route
    , title : String
    }

type Msg
    = Inc


init : () -> ( Model, Cmd Msg )
init () =
    ( { page = Dashboard, title = "t" }, Cmd.none )


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of

        Inc ->
            ( model, Cmd.none )


view : Model -> Element Msg
view model =
    Ui.text model.title

type Router f s p m msg k
    = Router (App.App f s p m msg k -> App.App f s p m msg k)


router : Router f s String m msg k
router =
    Router (\a -> App.withRoutes [ App.route "/" "home" ] a)


runRouter : Router f s p m msg k -> App.App f s p m msg k -> App.App f s p m msg k
runRouter (Router f) a =
    f a


app =
    App.app
        { init = init
        , update = update
        , view = view
        , subscriptions = \_ -> Sub.none
        }
        |> runRouter router
        |> App.withNotFound "missing"


main =
    App.run app
