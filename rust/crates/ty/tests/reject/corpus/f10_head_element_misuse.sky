-- defect: unannotated polymorphic `first xs = List.head xs` (scheme
--         `List a -> Maybe a`) result fed to `String.join`, which needs a
--         `List String`. gap2 admits the poly scheme so the element/shape
--         mismatch is caught at the call site. oracle: reject [E2001].
module Main exposing (main)
import Sky.Core.Prelude exposing (..)
import Std.Log exposing (println)
first xs = List.head xs
main =
    println (String.join "," (first [ [ 1 ], [ 2 ] ]))
