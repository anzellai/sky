-- gate: reject
-- defect: a raw Sky.Spa NotFound page is not of the model's `page` field type
-- rust: reject [E2001] at Spa.withNotFound, naming the model's `page` field
--
-- Found 2026-11-19 (v0.29.14). The routes give `Route` pages, but the
-- NotFound page is a `String`. An unknown path wrote the `String` into
-- `page`.
module Main exposing (main)

import Sky.Core.Prelude exposing (..)
import Std.Html as Html exposing (Html)
import Std.Spa as Spa

type Route
    = Dashboard
    | Detail String
    | Missing

type alias Model =
    { page : Route
    , title : String
    }

type Msg
    = Inc


init : () -> ( Model, Cmd Msg )
init () =
    ( { page = Dashboard, title = "t" }, Cmd.none )


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of

        Inc ->
            ( model, Cmd.none )


view : Model -> Html Msg
view model =
    Html.text model.title


main =
    Spa.app
        (Spa.config
            { init = init
            , update = update
            , view = view
            , subscriptions = \_ -> Sub.none
            }
            |> Spa.withRoutes [ Spa.route "/" Dashboard ]
            |> Spa.withNotFound "missing")
