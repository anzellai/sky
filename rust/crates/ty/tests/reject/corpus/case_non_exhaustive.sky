-- defect: non-exhaustive `case` — missing constructor `Blue`
-- oracle: reject [E3001] (Sky exhaustiveness is a hard error — R1-D3)
module Main exposing (main)

import Sky.Core.Prelude exposing (..)
import Std.Log exposing (println)

type Color = Red | Green | Blue

name : Color -> String
name c =
    case c of
        Red -> "red"
        Green -> "green"

main =
    println (name Red)
