-- defect: List.reverse result element mismatches a downstream param — `List.reverse
--         [1,2,3]` is `List Int`, fed to `String.join`'s `List String` param. The
--         unannotated-combinator wildcard used to accept this; the F8 check-only
--         precise `List.reverse : List a -> List a` sig now pins the element and
--         rejects. oracle: reject [E2001].
module Main exposing (main)
import Sky.Core.Prelude exposing (..)
import Sky.Core.String as String
import Sky.Core.List as List
import Std.Log exposing (println)
main =
    println (String.join "," (List.reverse [ 1, 2, 3 ]))
