module Main exposing (main)

import Sky.Core.Prelude exposing (..)
import Sky.Core.Error as Error exposing (Error)
import Sky.Core.File as File
import Sky.Core.String as String
import Sky.Core.Task as Task
import Std.App as App
import Std.Codec as Codec exposing (Codec)
import Std.Ui as Ui exposing (Element)
import Codecs exposing (..)

type alias Badge =
    { label : String
    , score : Int
    , status : Status
    }


badgeCodec : Codec Badge
badgeCodec =
    Codec.object Badge |> Codec.field "label" .label labelCodec
        |> Codec.field
               "score"
               .score
               (Codec.map identity trimmedLength Codec.int)
        |> Codec.field
               "status"
               .status
               (Codec.map statusOf statusText Codec.string)
        |> Codec.buildObject


statusText : Status -> String
statusText s =
    case s of

        Matched ->
            "matched"

        Open ->
            "open"


statusOf : String -> Status
statusOf t =
    if t == "matched" then
        Matched

    else
        Open


trimmedLength : Int -> Int
trimmedLength n =
    String.length (trimmed (String.fromInt n))

type alias Model =
    { badge : Badge }

type Msg
    = Load


init : () -> ( Model, Cmd Msg )
init () =
    ( { badge = { label = "", score = 0, status = Open } }, Cmd.none )


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of

        Load ->
            let
                t =
                    Task.run (File.readFile "x.txt")
                        |> Result.withDefault "none"
            in
                ( { model | badge = { label = t, score = 3, status = Matched } }
                , Cmd.none
                )


view : Model -> Element Msg
view model =
    Ui.column
        []
        [ Ui.text ("BADGE=" ++ model.badge.label)
        , Ui.button [] { onPress = Just Load, label = Ui.text "load" }
        ]


app =
    App.app
        { init = init
        , update = update
        , view = view
        , subscriptions = \_ -> Sub.none
        }
        |> App.withNotFound (\_ -> Ui.text "not found")


main : Task Error ()
main =
    App.run app
