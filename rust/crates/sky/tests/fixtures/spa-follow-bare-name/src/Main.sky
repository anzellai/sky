module Main exposing (main)

-- The app declares its own `Pending`, and a Msg carries the stdlib's
-- `Cpace.Pending` (device key material under `App.withClientCrypto`). `Fetch`
-- is a server arm whose command the split cannot read (a helper picks the
-- Msg), so every Msg may be its follow-up and gets a wire codec if it can.
-- The split resolves each payload type by its module: `Started` (the key)
-- does not cross, `Queued` (the app's own `Pending`) does.

import Sky.Core.Prelude exposing (..)
import Sky.Core.Secret as Secret
import Sky.Core.Time as Time
import Std.App as App
import Std.Crypto.Cpace as Cpace
import Std.Ui as Ui

type alias Pending =
    { id : Int }

type alias Model =
    { waiting : List Pending
    , cpace : Maybe Cpace.Pending
    , out : String
    }

type Msg
    = Start
    | Started (Result Error ( Cpace.Pending, String ))
    | Fetch
    | Fetched (Result Error ())
    | Queued (Result Error Pending)


init : () -> ( Model, Cmd Msg )
init _ =
    ( { waiting = [], cpace = Nothing, out = "" }, Cmd.none )


after : Result Error () -> Msg
after r =
    Fetched r


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of

        Start ->
            ( model
            , Cmd.perform
                  (Cpace.start (Secret.fromString "pw") "ch" "" "a")
                  Started
            )

        Started (Ok ( p, _ )) ->
            ( { model | cpace = Just p, out = "started" }, Cmd.none )

        Started (Err _) ->
            ( { model | out = "failed" }, Cmd.none )

        Fetch ->
            ( model, Cmd.perform (Time.sleep 10) after )

        Fetched _ ->
            ( { model | out = "fetched", waiting = [ { id = 1 } ] }, Cmd.none )

        Queued (Ok p) ->
            ( { model | waiting = p :: model.waiting }, Cmd.none )

        Queued (Err _) ->
            ( model, Cmd.none )


main =
    App.run
        (App.app
            { init = init
            , update = update
            , view =
                \m ->
                    Ui.column
                        []
                        [ Ui.text
                              ("OUT=" ++ m.out ++ " WAITING="
                                  ++ String.fromInt (List.length m.waiting))
                        , Ui.button
                              []
                              { onPress = Just Start, label = Ui.text "start" }
                        , Ui.button
                              []
                              { onPress = Just Fetch, label = Ui.text "fetch" }
                        ]
            , subscriptions = \_ -> Sub.none
            }
            |> App.withNotFound ()
            |> App.withClientCrypto)
