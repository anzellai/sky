module Main exposing (main)

-- Std.Nav: `update` moves the address bar without a page reload, on every
-- web target (Sky.Live `--target web`, Sky.Spa `--target web:app`).
--
--   go       a client arm pushes `/about?x=1`: the route and onNavigate run
--   home     a client arm replaces the entry with `/`
--   frag     a client arm pushes `#sec`: no page moves, Sub.onFragment sees it
--   clear    `Nav.clearFragment`: the fragment leaves the address bar
--   save     a SERVER arm (a timer read) returns a navigation too: the client
--            runs it when it sends the request, as Sky.Live runs it
--   evil     a URL off the site is refused; the address bar does not move
--   plain    `/plain` has no Sub.onFragment: a page opened at `/plain#x`
--            keeps its first paint (the load-time fragment report is a no-op)

import Sky.Core.Prelude exposing (..)
import Sky.Core.Task as Task
import Sky.Core.Time as Time
import Sky.Core.File as File
import Std.Html as Html
import Std.Html.Attributes as HA
import Std.Html.Events as HE
import Std.App as App
import Std.Nav as Nav
import Std.Ui as Ui exposing (Element)

type alias Model =
    { page : String
    , navs : Int
    , frag : String
    , part : Int
    , moved : Bool
    , selected : String
    , saved : Int
    }

type Msg
    = Navigated String
    | GotFragment String
    | Go
    | Home
    | Frag
    | Clear
    | Save
    | Saved (Result Error Int)
    | Evil
    | NextPart
    | ServerPart
    | ScrollRpc
    | MoveTarget
    | Current
    | Needed
    | Missing
    | Hidden
    | Top
    | Selected String


init : () -> ( Model, Cmd Msg )
init _ =
    ( { page = "home"
      , navs = 0
      , frag = ""
      , saved = 0
      , part = 0
      , moved = False
      , selected = "a"
      }
    , Cmd.none
    )


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of

        Navigated p ->
            ( { model | page = p, navs = model.navs + 1 }, Cmd.none )

        GotFragment f ->
            ( { model | frag = f }, Cmd.none )

        Go ->
            ( model, Nav.pushUrl "/about?x=1" )

        Home ->
            ( model, Nav.replaceUrl "/" )

        Frag ->
            ( model, Nav.pushUrl "#sec" )

        Clear ->
            ( model, Nav.clearFragment )

        Save ->
            ( model
            , Cmd.batch
                  [ Cmd.perform (Time.sleep 10 |> Task.map (\_ -> 7)) Saved
                  , Nav.pushUrl "/about"
                  ]
            )

        Saved (Ok n) ->
            ( { model | saved = n }, Cmd.none )

        Saved (Err _) ->
            ( model, Cmd.none )

        Evil ->
            ( model, Nav.pushUrl "https://example.com/" )

        NextPart ->
            ( { model | part = model.part + 1 }
            , Nav.scrollIntoView ("part-" ++ String.fromInt (model.part + 1))
            )

        ServerPart ->
            case Task.run
                     (Time.sleep 150
                         |> Task.andThen
                                (\_ -> File.readFile "nav-scroll-target.txt")) of

                Ok prefix ->
                    ( { model | part = model.part + 1 }
                    , Nav.scrollIntoView
                          (prefix ++ String.fromInt (model.part + 1))
                    )

                Err _ ->
                    ( model, Nav.scrollIntoView "server-file-error" )

        ScrollRpc ->
            case Task.run
                     (Time.sleep 150
                         |> Task.andThen
                                (\_ -> File.readFile "nav-scroll-rpc.txt")) of

                Ok target ->
                    ( model, Nav.scrollIntoView target )

                Err _ ->
                    ( model, Nav.scrollIntoView "server-file-error" )

        MoveTarget ->
            ( { model | moved = True }, Cmd.none )

        Current ->
            ( model, Nav.scrollIntoView ("part-" ++ String.fromInt model.part) )

        Needed ->
            ( model
            , Nav.scrollIntoViewIfNeeded ("part-" ++ String.fromInt model.part)
            )

        Missing ->
            ( model, Nav.scrollIntoView "absent-target" )

        Hidden ->
            ( model, Nav.scrollIntoView "hidden-target" )

        Top ->
            ( model, Nav.scrollToTop )

        Selected value ->
            ( { model | selected = value }, Cmd.none )


button : String -> Msg -> Element Msg
button id msg =
    Ui.button
        [ Ui.htmlAttribute "id" id ]
        { onPress = Just msg, label = Ui.text id }


view : Model -> Element Msg
view model =
    Ui.column
        []
        [ Ui.el
              [ Ui.htmlAttribute "id" "state" ]
              (Ui.text
                  ("PAGE=" ++ model.page ++ " NAVS=" ++ String.fromInt model.navs
                      ++ " FRAG="
                      ++ model.frag
                      ++ " SAVED="
                      ++ String.fromInt model.saved
                      ++ " PART="
                      ++ String.fromInt model.part
                      ++ " MOVED="
                      ++ (if model.moved then
                             "1"

                         else
                             "0")))
        , button "go" Go
        , button "home" Home
        , button "frag" Frag
        , button "clear" Clear
        , button "save" Save
        , button "evil" Evil
        , button "next-part" NextPart
        , button "server-part" ServerPart
        , button "scroll-rpc" ScrollRpc
        , button "move-target" MoveTarget
        , button "current" Current
        , button "needed" Needed
        , button "missing" Missing
        , button "hidden" Hidden
        , button "top" Top
        , Ui.el
              [ Ui.style "flex-shrink" "0", Ui.style "height" "120px" ]
              (Ui.text "before outer")
        , Ui.el
              [ Ui.htmlAttribute "id" "outer"
              , Ui.style "flex-shrink" "0"
              , Ui.style "height" "380px"
              , Ui.style "width" "340px"
              , Ui.style "overflow" "auto"
              , Ui.style "overflow-anchor" "none"
              ]
              (Ui.column
                  [ Ui.style "width" "700px" ]
                  [ Ui.el
                        [ Ui.style "flex-shrink" "0"
                        , Ui.style "height" "100px"
                        ]
                        (Ui.text "outer spacer")
                  , Ui.column
                        [ Ui.htmlAttribute "id" "sheet"
                        , Ui.style "flex-shrink" "0"
                        , Ui.style "height" "260px"
                        , Ui.style "width" "300px"
                        , Ui.style "overflow" "auto"
                        , Ui.style "overflow-anchor" "none"
                        , Ui.style "scroll-behavior" "smooth"
                        , Ui.style "scroll-padding-top" "calc(10% + 5px)"
                        , Ui.style
                              "border-top-width"
                              (if modBy 2 model.part == 0 then
                                  "2px"

                              else
                                  "3px")
                        , Ui.style "border-top-style" "solid"
                        ]
                        [ Ui.html
                              (Html.select
                                  [ HA.id "held-select"
                                  , HA.value model.selected
                                  , HE.onChange Selected
                                  ]
                                  [ Html.option
                                        [ HA.value "a" ]
                                        [ Html.text "A" ]
                                  , Html.option
                                        [ HA.value "b" ]
                                        [ Html.text "B" ]
                                  ])
                        , Ui.el
                              [ Ui.style "flex-shrink" "0"
                              , Ui.style "height" "700px"
                              , Ui.style "width" "650px"
                              ]
                              (Ui.text "long form")
                        , if model.part > 0 then
                              Ui.el
                                  [ Ui.htmlAttribute
                                        "id"
                                        ("part-" ++ String.fromInt model.part)
                                  , Ui.style "scroll-margin-top" "18px"
                                  ]
                                  (Ui.text "new question")

                          else
                              Ui.text "no question yet"
                        , Ui.el
                              [ Ui.style "flex-shrink" "0"
                              , Ui.style
                                    "height"
                                    (if model.moved then
                                        "500px"

                                    else
                                        "80px")
                              ]
                              (Ui.text "movable gap")
                        , Ui.el
                              [ Ui.htmlAttribute "id" "rpc-target"
                              , Ui.style "scroll-margin-top" "18px"
                              ]
                              (Ui.text "RPC target")
                        , Ui.el
                              [ Ui.htmlAttribute "id" "hidden-target"
                              , Ui.style "display" "none"
                              ]
                              (Ui.text "hidden")
                        , Ui.el
                              [ Ui.style "flex-shrink" "0"
                              , Ui.style "height" "900px"
                              ]
                              (Ui.text "trailing form")
                        ]
                  , Ui.el
                        [ Ui.style "flex-shrink" "0"
                        , Ui.style "height" "900px"
                        ]
                        (Ui.text "outer tail")
                  ])
        , Ui.el
              [ Ui.style "flex-shrink" "0"
              , Ui.style "width" "1400px"
              , Ui.style "height" "1200px"
              ]
              (Ui.text "window tail")
        ]


subscriptions : Model -> Sub Msg
subscriptions model =
    if model.page == "plain" then
        Sub.none

    else
        Sub.onFragment GotFragment


app =
    App.app
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        }
        |> App.withRoutes
               [ App.route "/" "home"
               , App.route "/about" "about"
               , App.route "/plain" "plain"
               ]
        |> App.withNotFound "home"
        |> App.withOnNavigate Navigated


main =
    App.run app
