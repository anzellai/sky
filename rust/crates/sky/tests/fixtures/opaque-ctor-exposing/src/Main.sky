module Main exposing (main)

import Sky.Core.Prelude exposing (..)
import Sky.Core.Task as Task
import Std.Log exposing (println)
import Std.Ui as Ui exposing (..)
import Std.Ai.Provider as Provider exposing (Provider(..))

brain : Provider
brain =
    Provider.custom
        (\_ ->
            Task.succeed
                { content = "hi"
                , usage =
                    { promptTokens = 0
                    , completionTokens = 0
                    , totalTokens = 0
                    }
                }
        )

describe : Provider -> String
describe p =
    case p of
        Custom _ -> "custom"
        _ -> "other"

main =
    println (describe brain)
