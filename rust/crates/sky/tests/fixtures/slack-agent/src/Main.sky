module Main exposing (main)

{-| Fixture: one Slack @mention driven through the durable reply workflow, fully
offline. Under test mode the LLM call is answered by `tests/mocks/00-chat.json`
("MOCKED-REPLY", usage 1000+1000 tokens) and the Slack `chat.postMessage` by
`tests/mocks/01-slack.json` (ts "1700000000.000100"). No network, no credentials.

This is the same workflow the `examples/66-slack-agent` server runs; here it is
driven synchronously so the result is assertable. It proves:
  * the model call and the Slack post each ran as a journalled durable step,
  * the outbound post went through the `Std.Ai.Policy` firewall (Low -> ran),
  * the token + cost trace was captured (1000/1000 tokens at 0.00015/0.00060 per
    1k = 0.00075).

Expected stdout (asserted by `slack_agent_flow.rs`):

    slack reply=MOCKED-REPLY posted=1700000000.000100 cost=0.00075 status=done
-}

import Sky.Core.Prelude exposing (..)
import Sky.Core.Task as Task
import Sky.Core.String as String
import Sky.Core.List as List
import Sky.Core.Dict as Dict
import Sky.Core.Result exposing (Result(..))
import Sky.Core.Error as Error exposing (Error)
import Sky.Core.Secret as Secret exposing (Secret)
import Sky.Core.Http as Http
import Std.Log exposing (println)
import Std.Db as Db exposing (Db, SqlValue(..))
import Std.Codec as Codec exposing (Codec)
import Std.Money as Money
import Std.Durable as Durable exposing (Ctx)
import Std.Ai.Provider as Provider exposing (Provider)
import Std.Ai.Policy as Policy
import Std.Ai.Trace as Trace


modelName : String
modelName =
    "gpt-4o-mini"


provider : Provider
provider =
    Provider.openai (Secret.fromEnv "OPENAI_API_KEY") modelName


slackToken : Secret
slackToken =
    Secret.fromEnv "SLACK_BOT_TOKEN"


priceBook : Provider.PriceBook
priceBook =
    case Provider.priceBook Money.USD "0.00015" "0.00060" of
        Ok b ->
            b

        Err _ ->
            Provider.freePriceBook Money.USD


firewall : Policy.Action -> Policy.Decision
firewall act =
    Policy.requireApprovalAbove Policy.Low act


-- ─── The durable reply workflow (mirrors examples/66-slack-agent) ─


type alias Mention =
    { text : String, channel : String, threadTs : String }


type alias Reply =
    { reply : String, posted : String }


mentionCodec : Codec Mention
mentionCodec =
    Codec.auto { text = "", channel = "", threadTs = "" }


replyCodec : Codec Reply
replyCodec =
    Codec.auto { reply = "", posted = "" }


chatCodec : Codec Provider.ChatResponse
chatCodec =
    Codec.auto
        { content = ""
        , usage = { promptTokens = 0, completionTokens = 0, totalTokens = 0 }
        }


botDef : Durable.WorkflowDef Mention Reply
botDef =
    Durable.register "slack-reply" mentionCodec replyCodec botBody


botBody : Ctx -> Mention -> Task Error Reply
botBody ctx mention =
    Durable.step ctx
        chatCodec
        "llm"
        (Provider.chat provider [ Provider.system "You are terse.", Provider.user mention.text ])
        |> Task.andThen
            (\resp ->
                let
                    answer =
                        resp.content

                    postAction =
                        Policy.action "slack.post" mention.channel Policy.Low
                in
                Durable.step ctx
                    Codec.string
                    "reply"
                    (Policy.gate firewall postAction (postMessage mention.channel mention.threadTs answer)
                        |> Task.map outcomeSummary
                    )
                    |> Task.andThen
                        (\posted ->
                            Durable.step ctx
                                Codec.string
                                "trace"
                                (Trace.record (Durable.conn ctx)
                                    (Trace.forResponse (Durable.runId ctx) modelName priceBook resp)
                                    |> Task.map (\_ -> "ok")
                                )
                                |> Task.map (\_ -> { reply = answer, posted = posted })
                        )
            )


outcomeSummary : Policy.Outcome String -> String
outcomeSummary outcome =
    case outcome of
        Policy.Ran ts ->
            ts

        Policy.Denied reason ->
            "denied:" ++ reason

        Policy.Pending reason ->
            "pending:" ++ reason


-- ─── Slack client ────────────────────────────────────────────────


type alias PostRequest =
    { channel : String, thread_ts : String, text : String }


postReqCodec : Codec PostRequest
postReqCodec =
    Codec.auto { channel = "", thread_ts = "", text = "" }


postMessage : String -> String -> String -> Task Error String
postMessage channel threadTs text =
    let
        payload =
            Codec.toJson postReqCodec { channel = channel, thread_ts = threadTs, text = text }

        req =
            Http.defaultRequest "https://slack.com/api/chat.postMessage"
    in
    { req | method = "POST" }
        |> Http.withBearer slackToken
        |> Http.withHeader "Content-Type" "application/json"
        |> Http.withBody payload
        |> Http.request
        |> Task.andThen
            (\resp ->
                if resp.status >= 200 && resp.status < 300 then
                    Task.succeed (readTs resp.body)

                else
                    Task.fail (Error.unexpected ("slack post failed: HTTP " ++ String.fromInt resp.status))
            )


type alias PostResult =
    { ok : Bool, ts : String }


postResultCodec : Codec PostResult
postResultCodec =
    Codec.auto { ok = False, ts = "" }


readTs : String -> String
readTs body =
    case Codec.fromJson postResultCodec body of
        Ok r ->
            r.ts

        Err _ ->
            ""


-- ─── Drive one mention + read the result back ────────────────────


readRun : Db -> String -> Task Error ( Reply, String )
readRun db id =
    Db.query db "SELECT output, status FROM _sky_durable_runs WHERE id = ?" [ SqlString id ]
        |> Task.map
            (\rows ->
                case List.head rows of
                    Just row ->
                        ( decodeReply (dictGet "output" row), dictGet "status" row )

                    Nothing ->
                        ( { reply = "", posted = "" }, "?" )
            )


decodeReply : String -> Reply
decodeReply json =
    case Codec.fromJson replyCodec json of
        Ok r ->
            r

        Err _ ->
            { reply = "", posted = "" }


dictGet : String -> Dict String String -> String
dictGet key row =
    case Dict.get key row of
        Just v ->
            v

        Nothing ->
            ""


runKey : String
runKey =
    "slack:C123:1700000000.000001"


main : Task Error ()
main =
    Db.connect ()
        |> Task.andThen
            (\db ->
                Durable.setup db
                    |> Task.andThen (\_ -> Trace.setup db)
                    |> Task.andThen
                        (\_ ->
                            Durable.start db
                                botDef
                                runKey
                                { text = "hello there", channel = "C123", threadTs = "1700000000.000001" }
                        )
                    |> Task.andThen (\_ -> Durable.poll db [ Durable.erase botDef ])
                    |> Task.andThen (\_ -> readRun db runKey)
                    |> Task.andThen
                        (\( reply, status ) ->
                            Trace.totalCost db runKey
                                |> Task.andThen
                                    (\cost ->
                                        println
                                            ("slack reply="
                                                ++ reply.reply
                                                ++ " posted="
                                                ++ reply.posted
                                                ++ " cost="
                                                ++ cost
                                                ++ " status="
                                                ++ status
                                            )
                                    )
                        )
            )
