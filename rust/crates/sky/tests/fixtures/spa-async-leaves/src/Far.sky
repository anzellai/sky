module Far exposing (farPick)

-- A cross-module helper whose module has NO frontend subset (the client
-- reads nothing else from it). Its arm holds, with a build note.

import Sky.Core.Prelude exposing (..)
import Sky.Core.System as System
import Sky.Core.Task as Task
import Std.Cmd as Cmd
import Types exposing (Model, Msg(..))


fetchFar : Task Error String
fetchFar =
    Task.succeed (System.getenvOr "SPA_ASYNC_P" "far")


farPick : Model -> ( Model, Cmd Msg )
farPick m =
    if m.flag then
        ( { m | busy = True }, Cmd.perform fetchFar Got )

    else
        ( m, Cmd.none )
