module Conn exposing (db)

-- One memoised connection (CAF) reaching `Db.open`, so the split routes THIS
-- whole module to the BACKEND ONLY; it is absent from the wasm frontend. The
-- sibling `update`'s `Save` arm reaches it through `persist` (GAP-1).

import Sky.Core.Prelude exposing (..)
import Sky.Core.Task as Task
import Sky.Core.System as System
import Std.Db as Db


db : Db.Db
db =
    case Task.run (Db.open "sqlite" (System.getenvOr "SIBLING_DB_PATH" "app.db")) of

        Ok c ->
            c

        Err _ ->
            System.exit 1
