module Main exposing (main)

-- Auto-split INPUT: an AI call runs on the server (a model slot holds server
-- settings and secrets), and its typed failure crosses the RPC wire as an
-- `Error` with a `Domain` failure. The client reads it with
-- `Std.Ai.Failure.fromError`, which is pure, so that branch stays on the client.

import Sky.Core.Prelude exposing (..)
import Sky.Core.Task as Task
import Sky.Core.Error as Error exposing (Error)
import Sky.Core.String as String
import Sky.Core.Maybe as Maybe
import Std.Spa as Spa
import Std.Cmd as Cmd
import Std.Sub as Sub
import Std.Ui as Ui
import Std.Html exposing (Html)
import Std.Ai.Provider as Provider exposing (Provider)
import Std.Ai.Endpoint as Endpoint
import Std.Ai.Failure as Failure exposing (Failure(..))

type alias Model =
    { status : String }

type Msg
    = Ask
    | Answered (Result Error String)


chat : Provider
chat =
    Endpoint.provider (Endpoint.endpoint "chat")


init : () -> ( Model, Cmd Msg )
init _ =
    ( { status = "" }, Cmd.none )


explain : Error -> String
explain e =
    case Failure.fromError e of

        Just (Overloaded o) ->
            "busy, retry in "
                ++ String.fromInt (Maybe.withDefault 1000 o.retryAfterMs)
                ++ " ms"

        Just (NotConfigured c) ->
            "set " ++ c.setting

        Just f ->
            Failure.code f

        Nothing ->
            Error.toString e


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of

        Ask ->
            -- SERVER: the model call.
            ( model
            , Cmd.perform
                  (Provider.chat chat [ Provider.user "hi" ] |> Task.map .content)
                  Answered
            )

        Answered (Ok text) ->
            ( { model | status = text }, Cmd.none )

        Answered (Err e) ->
            -- CLIENT: the typed view of the failure is pure.
            ( { model | status = explain e }, Cmd.none )


view : Model -> Html Msg
view model =
    Ui.layout
        []
        (Ui.column [ Ui.spacing 8 ] [ Ui.text ("status: " ++ model.status) ])


subscriptions : Model -> Sub Msg
subscriptions _ =
    Sub.none


main : Task Error ()
main =
    Spa.app
        (Spa.config
            { init = init
            , update = update
            , view = view
            , subscriptions = subscriptions
            })
