module Main exposing (main)

{-| Fixture: two Std.Ai.Endpoint slots with nothing but code defaults.

The code names the development model and nothing else. With no environment
this runs the real managed llama-server and the pinned Qwen model (the live
test `ai_local_live.rs`). The fake-engine flow test (`ai_endpoint_flow.rs`)
runs the same binary with `SKY_AI_LLAMA_BIN` and `SKY_AI_<SLOT>_MODEL`
overriding the engine and the model, which is the operator path.

It prints one line per check:

    chat=<answer>
    embed=<count> dims=<length>
    describe chat mode=local source(model)=<code or env>
    ghost=<the NotConfigured error>
    ghostTyped=<the typed Std.Ai.Failure view of it>
    busy=<the typed view of a remote 429, when SKY_AI_BUSY_URL is set>
-}

import Sky.Core.Prelude exposing (..)
import Sky.Core.Task as Task
import Sky.Core.Error as Error exposing (Error)
import Sky.Core.List as List
import Sky.Core.String as String
import Sky.Core.Maybe as Maybe
import Std.Log exposing (println)
import Std.Ai.Provider as Provider exposing (Provider)
import Std.Ai.Endpoint as Endpoint exposing (Endpoint)
import Std.Ai.Local as Local
import Std.Ai.Failure as Failure exposing (Failure(..))


chatSlot : Endpoint
chatSlot =
    Endpoint.endpoint "chat"
        |> Endpoint.withLocal
               (Local.model Local.devModel |> Local.withContext 2048)


embedSlot : Endpoint
embedSlot =
    Endpoint.endpoint "embed"
        |> Endpoint.withLocal
               (Local.model Local.devModel |> Local.withContext 2048
                   |> Local.withEmbeddings)


ghostSlot : Endpoint
ghostSlot =
    Endpoint.endpoint "ghost"


busySlot : Endpoint
busySlot =
    Endpoint.endpoint "busy" |> Endpoint.withRetry 0


chat : Provider
chat =
    Endpoint.provider chatSlot


deterministic : Provider.Options
deterministic =
    { temperature = Just 0.0
    , seed = Just 7
    , maxTokens = Just 16
    , adapter = Nothing
    }


askChat : Task Error ()
askChat =
    Provider.chatWith
        deterministic
        chat
        [ Provider.system "Answer with one word."
        , Provider.user "What colour is the sky on a clear day?"
        ]
        |> Task.andThen (\r -> println ("chat=" ++ String.trim r.content))


askEmbed : Task Error ()
askEmbed =
    Provider.embed (Endpoint.provider embedSlot) [ "hello", "world" ]
        |> Task.andThen
               (\vs ->
                   println
                       ("embed=" ++ String.fromInt (List.length vs) ++ " dims="
                           ++ String.fromInt
                                  (List.length
                                      (Maybe.withDefault [] (List.head vs)))))


showDescription : Endpoint.Description -> Task Error ()
showDescription d =
    let
        modelSource =
            d.settings |> List.filter (\s -> s.key == "MODEL")
                |> List.map .source
                |> List.head
                |> Maybe.withDefault "none"
    in
        println
            ("describe " ++ d.slot ++ " mode=" ++ d.mode ++ " source(model)="
                ++ modelSource)


askGhost : Task Error ()
askGhost =
    Provider.chat (Endpoint.provider ghostSlot) [ Provider.user "x" ]
        |> Task.map (\_ -> "answered")
        |> Task.onError (\e -> Task.succeed (Error.toString e))
        |> Task.andThen (\s -> println ("ghost=" ++ s))


-- The typed view of a failure, as one line.
typed : Error -> String
typed e =
    let
        retry =
            " retryable="
                ++ (if Error.isRetryable e then
                       "True"

                   else
                       "False")
        dom = " domain=" ++ Maybe.withDefault "none" (Error.domain e)
    in
        case Failure.fromError e of

            Just (Overloaded o) ->
                "Overloaded retryAfterMs="
                    ++ Maybe.withDefault
                           "none"
                           (Maybe.map String.fromInt o.retryAfterMs)
                    ++ " status="
                    ++ Maybe.withDefault
                           "none"
                           (Maybe.map String.fromInt o.status)
                    ++ dom
                    ++ retry

            Just (NotConfigured r) ->
                "NotConfigured setting=" ++ r.setting ++ dom ++ retry

            Just f ->
                Failure.code f ++ dom ++ retry

            Nothing ->
                "untyped " ++ Error.toString e


askGhostTyped : Task Error ()
askGhostTyped =
    Provider.chat (Endpoint.provider ghostSlot) [ Provider.user "x" ]
        |> Task.map (\_ -> "answered")
        |> Task.onError (\e -> Task.succeed (typed e))
        |> Task.andThen (\s -> println ("ghostTyped=" ++ s))


askBusy : Task Error ()
askBusy =
    Provider.chat (Endpoint.provider busySlot) [ Provider.user "x" ]
        |> Task.map (\_ -> "answered")
        |> Task.onError (\e -> Task.succeed (typed e))
        |> Task.andThen (\s -> println ("busy=" ++ s))


main : Task Error ()
main =
    askChat |> Task.andThen (\_ -> askEmbed)
        |> Task.andThen (\_ -> Endpoint.describe chatSlot)
        |> Task.andThen showDescription
        |> Task.andThen (\_ -> askGhost)
        |> Task.andThen (\_ -> askGhostTyped)
        |> Task.andThen (\_ -> askBusy)
