module Main exposing (main)

import Sky.Core.Task as Task
import Sky.Core.Set as Set
import Std.Codec as Codec exposing (Codec)
import Std.Db as Db
import Std.Db.Store as Store
import Std.Log exposing (println)

type alias Store =
    { zz : Int }

type alias Db =
    { yy : Int }

type alias Codec =
    { cc : Int }

type alias Query =
    { qq : Int }

type alias Set =
    { ss : Int }

type alias Todo =
    { id : Int
    , title : String
    , done : Int
    }


todos =
    Store.fromCodec "todos" (Codec.auto { id = 0, title = "", done = 0 })
        |> Store.serial "id"


mine : Store
mine =
    { zz = 1 }


run conn =
    let
        _ <- Store.create conn todos
        _ <- Store.insert conn todos { id = 0, title = "a", done = 0 }
        _ <- Store.insert conn todos { id = 0, title = "b", done = 1 }
        q = Store.query todos |> Store.orderAsc "id"
        rows <- Store.toList conn q
        titles = Set.fromList (List.map .title rows)
    in
        Task.succeed
            (String.fromInt (List.length rows) ++ " "
                ++ String.fromInt (Set.size titles)
                ++ " "
                ++ String.fromInt mine.zz)


main =
    Task.run
        (Db.open "sqlite" ":memory:" |> Task.andThen run |> Task.andThen println)
