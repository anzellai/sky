module Main exposing (main)

-- Acceptance fixture for `sky spa-partition`. A single Sky.Spa project that
-- type-checks clean and exercises every partition class:
--
--   * `bootId` — a top-level EFFECTFUL-ORIGIN CAF (SEED 2a): its initialiser
--     forces a server Task (`System.getenv`) via `Task.run`, so it is
--     server-tainted and must be excluded from the client build.
--   * `mode`   — a PURE-TYPED env read (SEED 2b): `System.getenvOr` is typed
--     `String -> String -> String` (NOT `Task`), so it is caught ONLY by kernel
--     identity, never by a Task-type check. Also server-tainted.
--   * update branches: `Inc` / `AddN` are pure → CLIENT; `UseBoot` references
--     the CAF and `UseMode` references the env value → both SERVER.

import Sky.Core.Prelude exposing (..)
import Sky.Core.String as String
import Sky.Core.System as System
import Sky.Core.Task as Task
import Sky.Core.Result as Result
import Std.Spa as Spa
import Std.Sub as Sub
import Std.Ui as Ui exposing (Element)
import Std.Ui.Events as Ev


bootId : String
bootId =
    Result.withDefault "boot" (Task.run (System.getenv "BOOT_ID"))


mode : String
mode =
    System.getenvOr "MODE" "dev"


type alias Model =
    { count : Int, note : String }


type Msg
    = Inc
    | AddN Int
    | UseBoot
    | UseMode


init : a -> ( Model, Cmd Msg )
init _ =
    ( { count = 0, note = "" }, Cmd.none )


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of
        Inc ->
            ( { model | count = model.count + 1 }, Cmd.none )

        AddN n ->
            ( { model | count = model.count + n }, Cmd.none )

        UseBoot ->
            ( { model | note = bootId }, Cmd.none )

        UseMode ->
            ( { model | note = mode }, Cmd.none )


view : Model -> any
view model =
    Ui.layout []
        (Ui.column [ Ui.spacing 8, Ui.padding 12 ]
            [ Ui.el [ Ev.onClick Inc ] (Ui.text ("count " ++ String.fromInt model.count))
            , Ui.el [ Ev.onClick (AddN 5) ] (Ui.text "add 5")
            , Ui.el [ Ev.onClick UseBoot ] (Ui.text "use boot")
            , Ui.el [ Ev.onClick UseMode ] (Ui.text "use mode")
            , Ui.el [] (Ui.text model.note)
            ]
        )


subscriptions : Model -> Sub Msg
subscriptions _ =
    Sub.none


main : Task Error ()
main =
    Spa.app
        (Spa.config
            { init = init
            , update = update
            , view = view
            , subscriptions = subscriptions
            }
        )
