module Main exposing (main)

{-| Std.Ui.Terminal e2e fixture, driven by scripts/ui-canvas-terminal-verify.mjs
(see scripts/ui-canvas-terminal-e2e.sh) under a strict Content-Security-Policy,
as a Sky.Live app. The page shows a terminal bound to `sh` on a PTY. The
"new shell" button spawns a fresh `sh` and attaches it to the mounted widget
(the attach path the terminal-race case repeats: the first screen read and
the resize to the widget's size run at once); the old shell is closed. The
same program built for Sky.Spa (--target web:app) must be refused with a
clear error: the PTY lives on the server.
-}

import Sky.Core.Prelude exposing (..)
import Sky.Core.Error exposing (Error)
import Sky.Core.Process as Process exposing (Process)
import Std.Cmd as Cmd exposing (Cmd)
import Std.Sub as Sub exposing (Sub)
import Std.App as App
import Std.Ui as Ui exposing (Element)
import Std.Ui.Terminal as Terminal exposing (Terminal)

type alias Model =
    { term : Terminal
    , status : String
    , shells : Int
    }

type Msg
    = Spawned (Result Error Process)
    | NewShell
    | Closed (Result Error ())
    | Term Terminal.Msg


init : () -> ( Model, Cmd Msg )
init _ =
    ( { term = Terminal.init "shell", status = "starting", shells = 0 }
    , spawnShell
    )


spawnShell : Cmd Msg
spawnShell =
    Cmd.perform
        (Process.command "sh"
            |> Process.withEnv [ ( "PS1", "$ " ), ( "TERM", "xterm-256color" ) ]
            |> Process.withPty { cols = 80, rows = 24 }
            |> Process.spawn)
        Spawned


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of

        Spawned (Ok p) ->
            let
                ( term, cmd ) = Terminal.attach Term p model.term
                shells = model.shells + 1
                closeOld =
                    case Terminal.process model.term of

                        Just old ->
                            Cmd.perform (Process.close old) Closed

                        Nothing ->
                            Cmd.none
            in
                ( { model
                      | term = term
                      , status = "running " ++ String.fromInt shells
                      , shells = shells
                  }
                , Cmd.batch [ cmd, closeOld ]
                )

        NewShell ->
            ( model, spawnShell )

        Closed _ ->
            ( model, Cmd.none )

        Spawned (Err _) ->
            ( { model | status = "spawn failed" }, Cmd.none )

        Term m ->
            let
                ( term, cmd ) = Terminal.update Term m model.term
            in
                ( { model | term = term }, cmd )


view : Model -> Element Msg
view model =
    Ui.column
        [ Ui.spacing 8, Ui.padding 8, Ui.width Ui.fill ]
        [ Ui.el
              [ Ui.htmlAttribute "id" "status" ]
              (Ui.text ("status=" ++ model.status))
        , Ui.button
              [ Ui.htmlAttribute "id" "new-shell" ]
              { onPress = Just NewShell, label = Ui.text "new shell" }
        , Ui.el
              [ Ui.htmlAttribute "id" "term-box", Ui.width Ui.fill ]
              (Terminal.view Term model.term [ Ui.height (Ui.px 300) ])
        ]


subscriptions : Model -> Sub Msg
subscriptions _ =
    Sub.none


app =
    App.app
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        }
        |> App.withNotFound ()


main =
    App.run app
