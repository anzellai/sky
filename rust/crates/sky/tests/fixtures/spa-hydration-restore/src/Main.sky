module Main exposing (main)

-- Sky.Spa SSR hydration RESTORE e2e regression (for the first-paint
-- localStorage-restore bug fixed by live_wasm.go's two-step first paint).
--
-- Shape (mirrors spa-ssr-db, the sky-lang.org shape that triggers the client
-- decoder + persistence):
--   * `db` CAF reaches Db.open, so the split routes it BACKEND-ONLY.
--   * init's command is a GET-safe Db.query → the split STRIPS it on the client
--     and wires Spa.withModelDecoder/Encoder. That is what makes the client boot
--     from the SSR seed AND persist the model to localStorage — without it there
--     is nothing to restore. This is exactly the report's "data loads" scenario.
--   * `Bump` is a PURE client update, so clicking increment persists the model.
--   * The view is HYDRATABLE (one text child per element, each Ui.text in its own
--     Ui.row), so hydration is NOT skipped — an adjacent-text view would fall
--     back to a full rebuild and MASK the bug.
--
-- e2e: scripts/spa-hydration-verify.mjs --click 'button:has-text("increment")'
-- --clicks 3 --expect "count=3" — SSR paints count=0, three clicks persist n=3,
-- reload restores n=3 on the first SSR paint with hydration still used.

import Sky.Core.Prelude exposing (..)
import Sky.Core.List as List
import Sky.Core.Dict as Dict
import Sky.Core.Maybe as Maybe
import Sky.Core.Task as Task
import Sky.Core.System as System
import Sky.Core.String as String
import Std.Db as Db
import Std.App as App
import Std.Ui as Ui exposing (Element)


db : Db.Db
db =
    case Task.run (Db.open "sqlite" (System.getenvOr "SSR_DB_PATH" "app.db")) of
        Ok c ->
            c

        Err _ ->
            System.exit 1


type alias Model =
    { n : Int
    , items : List String
    }


type Msg
    = GotItems (Result Error (List (Dict String String)))
    | Bump


init : () -> ( Model, Cmd Msg )
init () =
    ( { n = 0, items = [] }
    , Cmd.perform (Db.query db "SELECT name FROM items ORDER BY name" []) GotItems
    )


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of
        GotItems (Ok rows) ->
            ( { model | items = List.map (\r -> Maybe.withDefault "" (Dict.get "name" r)) rows }, Cmd.none )

        GotItems (Err _) ->
            ( { model | items = [] }, Cmd.none )

        Bump ->
            ( { model | n = model.n + 1 }, Cmd.none )


view : Model -> Element Msg
view model =
    Ui.column [ Ui.spacing 8 ]
        [ Ui.row [] [ Ui.text ("count=" ++ String.fromInt model.n) ]
        , Ui.row [] [ Ui.text ("items=" ++ String.fromInt (List.length model.items)) ]
        , Ui.button [] { onPress = Just Bump, label = Ui.text "increment" }
        ]


subscriptions : Model -> Sub Msg
subscriptions _ =
    Sub.none


app =
    App.app
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        }
        |> App.withNotFound ()


main =
    App.run app
