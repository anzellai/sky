module Main exposing (main)

-- Sky.Spa auto-split INPUT exercising the two remaining App→Spa synthesis gaps:
--
--   * GAP-1: `withRoutes` MIXES page routes (from the sibling `Routes`) with
--     server `App.api` endpoints (`apiRoutes`, below — its handlers reach server
--     effects, so the whole binding is server-tainted). The synthesised client
--     `spaRoutes_` must carry ONLY the page routes; the api endpoints must be
--     mounted on the BACKEND as real `Server` handlers. Before the fix the
--     client `spaRoutes_` referenced the dropped `apiRoutes` → `E1001`.
--   * GAP-2: `init` lives in the sibling `Boot` and reads through the
--     backend-only `db` CAF; the frontend strip must resolve it through the
--     import graph and rewrite its command to `Cmd.none`.

import Sky.Core.Prelude exposing (..)
import Sky.Core.List as List
import Sky.Core.Dict as Dict
import Sky.Core.Maybe as Maybe
import Sky.Core.Task as Task
import Sky.Http.Server as Server exposing (Request, Response, Handler)
import Std.App as App
import Std.Cmd as Cmd
import Std.Sub as Sub
import Std.Db as Db
import Std.Ui as Ui exposing (Element)
import State exposing (..)
import Boot exposing (init)
import Conn exposing (db)
import Routes


-- Purely navigational + the deferred read result: NO server branch, so the app
-- is on the SSR path only because `init`'s command is a GET-safe read.
update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of

        Navigate page ->
            ( { model | page = page }, Cmd.none )

        GotItems (Ok rows) ->
            ( { model | items = List.map (\r -> Maybe.withDefault "" (Dict.get "name" r)) rows }, Cmd.none )

        GotItems (Err _) ->
            ( { model | items = [] }, Cmd.none )


view : Model -> Element Msg
view model =
    case model.page of

        HomePage ->
            Ui.column []
                [ Ui.text "Welcome home"
                , Ui.link [] { url = "/items", label = Ui.text "See items" }
                ]

        ItemsPage ->
            Ui.column []
                (Ui.text "Item list:" :: List.map (\i -> Ui.text i) model.items)


subscriptions : Model -> Sub Msg
subscriptions _ =
    Sub.none


-- SERVER api endpoint: reaches the backend-only `db` CAF (a real read), so
-- `apiRoutes` is server-tainted and must be mounted BACKEND-ONLY (GAP-1).
handleItemsApi : Request -> Task Error Response
handleItemsApi _req =
    Task.andThen (\_ -> Task.succeed (Server.text "ok")) (Db.query db "SELECT 1" [])


-- A pure api endpoint (no server effect) alongside the tainted one.
handleHealthz : Request -> Task Error Response
handleHealthz _req =
    Task.succeed (Server.text "ok")


apiRoutes : List any
apiRoutes =
    -- Comments interspersed between elements (the sky-lang.org shape): the
    -- synthesis' api-binding detection must strip them per-line, not truncate
    -- the whole list at the first `--`.
    [ App.api "GET /items.json" handleItemsApi
    -- a server endpoint reaching the db
    , App.api "GET /healthz" handleHealthz
    ]


app =
    App.app
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        }
        |> App.withRoutes (Routes.routes ++ apiRoutes)
        |> App.withNotFound Routes.notFound


main =
    App.run app
