module Main exposing (main)

-- SIGN-OUT REVOCATION proof for the Sky.Spa auto-split's signed session.
--
--   * `session : Maybe Session` is the signed-session field: the `LogIn` server
--     branch writes it, so the backend signs it into the `sky_sid` cookie.
--
--   * `SaveAdmin content` is a server branch that gates on `model.session.role`.
--     It runs the admin effect (writes `admin.txt`) only for a signed-in admin,
--     and the backend takes `session` from the VERIFIED cookie.
--
--   * Two ways to sign out:
--       - `SignOutHere` is a CLIENT branch that clears the session. The wasm
--         client then calls the framework endpoint `POST /_rpc/__spaSignOut`.
--       - `LogOut` is a SERVER branch that clears the session. Its response
--         re-issues `sky_sid` from the signed-out model.
--
-- The property under test: a copy of the `sky_sid` cookie taken BEFORE sign-out
-- must not act as the signed-in user AFTER sign-out, by either path.

import Sky.Core.Prelude exposing (..)
import Sky.Core.Task as Task
import Sky.Core.String as String
import Sky.Core.File as File
import Std.Spa as Spa
import Std.Cmd as Cmd
import Std.Sub as Sub
import Std.Ui as Ui
import Std.Html exposing (Html)

type alias Session =
    { userId : String
    , role : String
    }

type alias Model =
    { session : Maybe Session
    , note : String
    }

type Msg
    = LogIn
    | LogOut
    | SignOutHere
    | SaveAdmin String


init : () -> ( Model, Cmd Msg )
init _ =
    ( { session = Nothing, note = "" }, Cmd.none )


-- A SERVER effect (File): forcing it makes a branch a server branch.
persist : String -> String -> Task Error String
persist name s =
    File.writeFile name s |> Task.map (\_ -> "ok")


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of

        LogIn ->
            let
                _ = Task.run (persist "login.txt" "in")
            in
                ( { model | session = Just { userId = "u1", role = "admin" } }
                , Cmd.none
                )

        LogOut ->
            let
                _ = Task.run (persist "logout.txt" "out")
            in
                ( { model | session = Nothing, note = "" }, Cmd.none )

        SignOutHere ->
            ( { model | session = Nothing, note = "" }, Cmd.none )

        SaveAdmin content ->
            case model.session of

                Just s ->
                    if s.role == "admin" then
                        let
                            _ = Task.run (persist "admin.txt" content)
                        in
                            ( { model | note = content }, Cmd.none )

                    else
                        ( model, Cmd.none )

                Nothing ->
                    ( model, Cmd.none )


status : Model -> String
status model =
    case model.session of

        Just s ->
            "signed in as " ++ s.userId

        Nothing ->
            "signed out"


button : String -> String -> Msg -> Ui.Element Msg
button id label msg =
    Ui.button
        [ Ui.htmlAttribute "id" id ]
        { onPress = Just msg, label = Ui.text label }


view : Model -> Html Msg
view model =
    Ui.layout
        []
        (Ui.column
            [ Ui.spacing 8 ]
            [ Ui.el
                  [ Ui.htmlAttribute "id" "state" ]
                  (Ui.text (status model ++ " | note: " ++ model.note))
            , button "signin" "Sign in" LogIn
            , button "save" "Save" (SaveAdmin "saved")
            , button "signout" "Sign out" SignOutHere
            , button "serversignout" "Server sign out" LogOut
            ])


subscriptions : Model -> Sub Msg
subscriptions _ =
    Sub.none


main : Task Error ()
main =
    Spa.app
        (Spa.config
            { init = init
            , update = update
            , view = view
            , subscriptions = subscriptions
            })
