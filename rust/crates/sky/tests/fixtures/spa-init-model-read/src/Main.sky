module Main exposing (main)

-- G5 INPUT: `init`'s returned MODEL embeds a SERVER read (`loadAll` -> `Db`),
-- not just its command. The auto-split cannot reproduce that value in the wasm
-- client, so it must REFUSE with precise guidance (defer the read to a command +
-- a `Got<Field>` update arm) rather than emit a frontend referencing `loadAll`.

import Sky.Core.Prelude exposing (..)
import Sky.Core.Task as Task
import Sky.Core.Result as Result
import Sky.Core.List as List
import Sky.Core.String as String
import Sky.Core.System as System
import Std.Spa as Spa
import Std.Cmd as Cmd
import Std.Sub as Sub
import Std.Ui as Ui
import Std.Html exposing (Html)
import Std.Db as Db


type alias Model =
    { items : List String
    , draft : String
    }


type Msg
    = DraftChanged String
    | Save


db : Db.Db
db =
    case Task.run (Db.open "sqlite" (System.getenvOr "X_DB" "app.db")) of

        Ok c ->
            c

        Err _ ->
            System.exit 1


loadAll : () -> Task Error (List String)
loadAll _ =
    Db.query db "SELECT name FROM items ORDER BY name" []
        |> Task.map (\_ -> [])


init : () -> ( Model, Cmd Msg )
init _ =
    -- G5: the server read is baked into the MODEL (not the command).
    ( { items = Result.withDefault [] (Task.run (loadAll ())), draft = "" }
    , Cmd.none
    )


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of

        DraftChanged s ->
            ( { model | draft = s }, Cmd.none )

        Save ->
            ( { model | items = Result.withDefault [] (Task.run (loadAll ())), draft = "" }
            , Cmd.none
            )


view : Model -> Html Msg
view model =
    Ui.layout
        []
        (Ui.column [] [ Ui.text (String.fromInt (List.length model.items)) ])


subscriptions : Model -> Sub Msg
subscriptions _ =
    Sub.none


main : Task Error ()
main =
    Spa.app
        (Spa.config
            { init = init
            , update = update
            , view = view
            , subscriptions = subscriptions
            })
