module Main exposing (main)

import Sky.Core.Prelude exposing (..)
import Sky.Core.Task as Task
import Sky.Core.String as String
import Sky.Core.Error as Error exposing (Error)
import Std.Ui as Ui exposing (Element)
import Std.App as App
import Std.Cmd as Cmd
import Std.Sub as Sub
import Std.Db as Db exposing (Db)
import Std.Codec as Codec exposing (Codec)
import Std.Durable as Durable

type alias Model =
    { count : Int }


modelCodec : Codec Model
modelCodec =
    Codec.auto { count = 0 }

type Msg
    = Increment
    | Durable (Durable.SnapshotEvent Model)


runId : String
runId =
    "counter-session"


init : Db -> () -> ( Model, Cmd Msg )
init db _ =
    ( { count = 0 }, Durable.restoreCmd db runId modelCodec Durable )


update : Db -> Msg -> Model -> ( Model, Cmd Msg )
update db msg model =
    case msg of

        Increment ->
            let
                m2 = { model | count = model.count + 1 }
            in
                ( m2, Durable.snapshotCmd db runId modelCodec Durable m2 )

        Durable ev ->
            ( Durable.applyRestore ev model, Cmd.none )


-- Every SnapshotEvent constructor, matched exhaustively: the compile guard
-- proves an app can surface a failed restore or a failed write (v0.25.17 added
-- RestoreFailed and PersistFailed; before, both were silently swallowed).
eventLabel : Durable.SnapshotEvent Model -> String
eventLabel ev =
    case ev of

        Durable.Restored (Just _) ->
            "restored"

        Durable.Restored Nothing ->
            "fresh"

        Durable.RestoreFailed e ->
            "restore failed: " ++ Error.toString e

        Durable.Persisted ->
            "saved"

        Durable.PersistFailed e ->
            "save failed: " ++ Error.toString e


view : Model -> Element Msg
view model =
    Ui.column [] [ Ui.text ("count: " ++ String.fromInt model.count) ]


subscriptions : Model -> Sub Msg
subscriptions _ =
    Sub.none


mkApp db =
    App.app
        { init = init db
        , update = update db
        , view = view
        , subscriptions = subscriptions
        }
        |> App.withNotFound (view { count = 0 })


main : Task Error ()
main =
    Db.connect ()
        |> Task.andThen
               (\db ->
                   Durable.setup db |> Task.andThen (\_ -> App.run (mkApp db)))
