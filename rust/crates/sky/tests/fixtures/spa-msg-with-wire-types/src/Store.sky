module Store exposing (..)

-- A server-tainted sibling that imports the co-located `Types` module via
-- `exposing (..)` and references the wire record `Item` + `itemCodec` from it.
-- This is the darraghstudio shape: nearly every sibling reads `Types` through
-- `exposing (..)`, so the split must keep `Item` resolvable from `Types` after
-- it moves ownership of `Item` into `Shared`.

import Sky.Core.Prelude exposing (..)
import Sky.Core.Task as Task
import Sky.Core.Result as Result
import Sky.Core.File as File
import Std.Codec as Codec
import Types exposing (..)


storePath : String
storePath =
    "items.json"


loadItems : () -> Task Error (List Item)
loadItems _ =
    File.readFile storePath
        |> Task.map (\s -> Result.withDefault [] (Codec.fromJson (Codec.list itemCodec) s))
        |> Task.onError (\_ -> Task.succeed [])


saveItems : List Item -> Task Error ()
saveItems items =
    File.writeFile storePath (Codec.toJson (Codec.list itemCodec) items)
