module Main exposing (main)

-- Auto-split INPUT: the `Msg` union, the wire record `Item` and the `Model` all
-- live TOGETHER in `Types`. The `Save` server branch writes `items : List Item`,
-- so the RPC response rides `Item` and the generated `Shared` needs it. Because
-- `Applied<Msg>` is injected into `Types`, `Types` must import `Shared` — so
-- `Shared` may NOT import `Types` back. The split resolves this by giving
-- `Shared` its own copy of `Item` + `itemCodec` and never importing `Types`.

import Sky.Core.Prelude exposing (..)
import Sky.Core.Task as Task
import Sky.Core.Result as Result
import Sky.Core.String as String
import Sky.Core.List as List
import Std.Spa as Spa
import Std.Cmd as Cmd
import Std.Sub as Sub
import Std.Ui as Ui
import Std.Html exposing (Html)
import Types exposing (..)
import Store exposing (loadItems, saveItems)


init : () -> ( Model, Cmd Msg )
init _ =
    ( { items = [], draft = "" }, Cmd.none )


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of

        DraftChanged s ->
            -- PURE -> client
            ( { model | draft = s }, Cmd.none )

        Save ->
            -- SERVER: reaches Store.loadItems / Store.saveItems (File effects),
            -- write-set {items, draft}. The response rides `List Item`.
            let
                current = Result.withDefault [] (Task.run (loadItems ()))
                next =
                    current ++ [ { name = model.draft, qty = 1 } ]
                _ = Task.run (saveItems next)
            in
                ( { model | items = next, draft = "" }, Cmd.none )


view : Model -> Html Msg
view model =
    Ui.layout
        []
        (Ui.column
            [ Ui.spacing 8 ]
            [ Ui.text ("items: " ++ String.fromInt (List.length model.items)) ])


subscriptions : Model -> Sub Msg
subscriptions _ =
    Sub.none


main : Task Error ()
main =
    Spa.app
        (Spa.config
            { init = init
            , update = update
            , view = view
            , subscriptions = subscriptions
            })
