module View exposing (view, head)

-- A PURE view + head factored into a sibling module, mirroring the real-app
-- (`App.web { view = View.view } |> App.withHead View.head`) shape. Neither
-- reaches a server effect, so the App->Spa synthesis's `spaView_`/`spaHead_`
-- wrappers stay client-safe and MUST be carried into the frontend entry.

import Sky.Core.Prelude exposing (..)
import Sky.Core.String as String
import Std.Ui as Ui exposing (Element)
import Std.Html as H
import Std.Live.Head as Head
import Types exposing (..)


view : Model -> any
view model =
    Ui.layout
        []
        (Ui.column
            []
            [ Ui.text ("count: " ++ String.fromInt model.count)
            , Ui.el [ Ui.onClick Increment ] (Ui.text "+")
            , Ui.el [ Ui.onClick Decrement ] (Ui.text "-")
            ])


head : Model -> List (H.Html Msg)
head model =
    [ Head.title (titleFor model.page)
    , Head.meta "description" "A pure withHead fixture"
    ]


titleFor : Page -> String
titleFor page =
    case page of

        HomePage ->
            "Home"

        AboutPage ->
            "About"

        NotFoundPage ->
            "Not found"
