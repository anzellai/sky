module Main exposing (main)

{-| Fixture: the Std.Ai action-firewall (Policy) and the multi-provider router.
Expected stdout (asserted by ai_policy_router_flow.rs):

    policy-allow: ran:ok
    policy-high: pending
    router: MOCKED-ANSWER
-}

import Sky.Core.Prelude exposing (..)
import Sky.Core.Task as Task
import Sky.Core.Error exposing (Error)
import Sky.Core.Secret as Secret
import Std.Log exposing (println)
import Std.Ai.Provider as Provider
import Std.Ai.Policy as Policy exposing (Outcome(..))


outcomeStr : Outcome String -> String
outcomeStr o =
    case o of
        Ran v ->
            "ran:" ++ v

        Denied _ ->
            "denied"

        Pending _ ->
            "pending"


routed : Provider.Provider
routed =
    Provider.router (\_ -> Provider.openai (Secret.fromString "k") "gpt-4o-mini")


main : Task Error ()
main =
    Policy.gate Policy.allowAll (Policy.action "read" "x" Policy.Low) (Task.succeed "ok")
        |> Task.andThen (\o1 -> println ("policy-allow: " ++ outcomeStr o1))
        |> Task.andThen (\_ -> Policy.gate (Policy.requireApprovalAbove Policy.Low) (Policy.action "refund" "y" Policy.High) (Task.succeed "ran"))
        |> Task.andThen (\o2 -> println ("policy-high: " ++ outcomeStr o2))
        |> Task.andThen (\_ -> Provider.chat routed [ Provider.user "hi" ])
        |> Task.andThen (\r -> println ("router: " ++ r.content))
