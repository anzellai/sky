module Main exposing (main)

-- Sky.Spa BOOT-SETUP fixture. A real app runs boot-time server setup in its
-- entry point BEFORE it starts the app: a let-prefix of side-effect forcings
-- that create the data directory and the schema, then hands off to the app.
--
-- The App -> Spa synthesis used to DROP that let-prefix, so the generated
-- backend entry was a bare listen call that never created the schema — every
-- request then read an empty / missing table. The fix captures the boot-setup
-- bindings, runs them in the BACKEND entry before it starts listening (they
-- reach server-only effects), and keeps them OUT of the wasm frontend.
--
-- The let-prefix here also has one NAMED binding used by a LATER boot binding
-- (not by the app config), so the whole block must move to the backend
-- together, in order. The comment deliberately names no code identifier, so the
-- test greps see only real code, never this prose.

import Sky.Core.Prelude exposing (..)
import Sky.Core.List as List
import Sky.Core.Dict as Dict
import Sky.Core.Maybe as Maybe
import Sky.Core.Task as Task
import Sky.Core.System as System
import Sky.Core.File as File
import Std.Db as Db
import Std.App as App
import Std.Ui as Ui exposing (Element)


-- One memoised connection (CAF) — reaches a server effect, so the split routes
-- this binding to the BACKEND ONLY; it is absent from the wasm frontend.
db : Db.Db
db =
    case Task.run (Db.open "sqlite" (System.getenvOr "BOOT_DB_PATH" "app.db")) of
        Ok c ->
            c

        Err _ ->
            System.exit 1


-- Server boot setup — creates the schema. Reaches a server effect, so it is
-- server-tainted and never reaches the wasm client.
setupThing : () -> Task Error ()
setupThing () =
    Task.map (\_ -> ()) (Db.query db "CREATE TABLE IF NOT EXISTS items (name TEXT)" [])


type Page
    = Home
    | ItemsPage


type alias Model =
    { page : Page
    , items : List String
    }


type Msg
    = GotItems (Result Error (List (Dict String String)))


init : () -> ( Model, Cmd Msg )
init () =
    ( { page = Home, items = [] }
    , Cmd.perform (Db.query db "SELECT name FROM items ORDER BY name" []) GotItems
    )


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of
        GotItems (Ok rows) ->
            ( { model | items = List.map (\r -> Maybe.withDefault "" (Dict.get "name" r)) rows }, Cmd.none )

        GotItems (Err _) ->
            ( { model | items = [] }, Cmd.none )


view : Model -> Element Msg
view model =
    case model.page of
        Home ->
            Ui.column []
                [ Ui.text "Welcome home"
                , Ui.link [] { url = "/items", label = Ui.text "See items" }
                ]

        ItemsPage ->
            Ui.column []
                (Ui.text "Item list:"
                    :: List.map (\i -> Ui.text i) model.items
                )


subscriptions : Model -> Sub Msg
subscriptions _ =
    Sub.none


app =
    App.app
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        }
        |> App.withRoutes [ App.route "/" Home, App.route "/items" ItemsPage ]
        |> App.withNotFound Home


main =
    let
        dir = "data"
        _ = Task.run (File.mkdirAll dir)
        _ = Task.run (setupThing ())
    in
        App.run app
