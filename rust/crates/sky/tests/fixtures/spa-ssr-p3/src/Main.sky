module Main exposing (main)

-- Sky.Spa SSR P3 fixture: a routed `Std.App` app whose `init` reads real data via
-- a GET-safe kernel (`File.readFile`) into the model. Two routes (`/` and
-- `/items`) render DIFFERENT content, and the `/items` view lists the data the
-- server resolves. Built with `sky build --target web:app`:
--
--   * Per-route SSR (design §4.1): the backend registers `GET /{$}` + `GET /items`
--     and resolves the request path to the route's page (Spa_ssrResolveModel), so
--     each route server-renders its OWN content.
--   * Data-resolved SSR (design §4.2): `init`'s command is `Cmd.perform
--     (File.readFile …) GotItems` — a curated GET-safe read — so the synthesis
--     emits `Spa_ssrSettle`, which runs the read to a data-bearing model
--     server-side. `/items` therefore carries the REAL item list a crawler sees,
--     not a loading state.
--
-- The `File.readFile` in `update`'s `LoadItems` branch makes the branch SERVER
-- (any effect ⇒ server), which is what puts the app on the P1/P3 SSR path.

import Sky.Core.Prelude exposing (..)
import Sky.Core.List as List
import Sky.Core.String as String
import Sky.Core.Task as Task
import Sky.Core.File as File
import Std.App as App
import Std.Ui as Ui exposing (Element)


type Page
    = Home
    | Items


type alias Model =
    { page : Page
    , items : List String
    }


type Msg
    = LoadItems
    | GotItems (Result Error String)


init : () -> ( Model, Cmd Msg )
init () =
    ( { page = Home, items = [] }
    , Cmd.perform (File.readFile "data/items.json") GotItems
    )


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of
        LoadItems ->
            ( model, Cmd.perform (File.readFile "data/items.json") GotItems )

        GotItems (Ok raw) ->
            ( { model | items = String.lines (String.trim raw) }, Cmd.none )

        GotItems (Err _) ->
            ( { model | items = [] }, Cmd.none )


view : Model -> Element Msg
view model =
    case model.page of
        Home ->
            Ui.column []
                [ Ui.text "Welcome home"
                , Ui.link [] { url = "/items", label = Ui.text "See items" }
                ]

        Items ->
            Ui.column []
                (Ui.text "Item list:"
                    :: List.map (\i -> Ui.text i) model.items
                )


subscriptions : Model -> Sub Msg
subscriptions _ =
    Sub.none


app =
    App.app
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        }
        |> App.withRoutes [ App.route "/" Home, App.route "/items" Items ]
        |> App.withNotFound Home


main =
    App.run app
