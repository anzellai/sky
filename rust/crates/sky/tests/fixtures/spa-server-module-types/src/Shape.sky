module Shape exposing (Batch, fetch)

import Sky.Core.Http as Http
import Sky.Core.Prelude exposing (..)

type alias Batch =
    { ready : Bool
    , next : Int
    }


{-| Server-only (Http). The client still needs the module's `Batch` type.
-}
fetch : Int -> Task Error Batch
fetch n =
    Http.get ("http://127.0.0.1:1/" ++ String.fromInt n)
        |> Task.map (\r -> { ready = r.status == 200, next = n + 1 })
        |> Task.onError (\_ -> Task.succeed { ready = False, next = n + 1 })
