module Main exposing (main)

-- Sky.Spa: the signed-session identity (`session : Maybe Session`, written by
-- a server branch) comes from the signed cookie on the server, never from the
-- client's model. An arm that branches on it or writes it HOLDS: the client
-- cannot know the trusted value, so it cannot make the same write the server
-- makes. `Plain` (no identity) runs async.
--
--   * `LogIn`         — writes the identity (a direct tuple)
--   * `IdentityCond`  — a `case` over the identity
--   * `IdentityWrite` — writes the identity under an `if`
--   * `Plain`         — no identity: async

import Sky.Core.Prelude exposing (..)
import Sky.Core.System as System
import Sky.Core.Task as Task
import Std.Spa as Spa
import Std.Cmd as Cmd
import Std.Sub as Sub
import Std.Ui as Ui
import Std.Html exposing (Html)


type alias Session =
    { userId : String
    , role : String
    }


type alias Model =
    { session : Maybe Session
    , flag : Bool
    , busy : Bool
    , note : String
    }


type Msg
    = LogIn
    | IdentityCond
    | IdentityWrite
    | Plain
    | Saved (Result Error String)


init : () -> ( Model, Cmd Msg )
init _ =
    ( { session = Nothing, flag = False, busy = False, note = "" }, Cmd.none )


persist : String -> Task Error String
persist s =
    Task.succeed (System.getenvOr "SPA_ASYNC_IDENTITY" s)


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of

        LogIn ->
            ( { model | session = Just { userId = "u1", role = "admin" } }
            , Cmd.perform (persist "in") Saved
            )

        IdentityCond ->
            case model.session of

                Just s ->
                    ( { model | busy = True }, Cmd.perform (persist s.userId) Saved )

                Nothing ->
                    ( model, Cmd.none )

        IdentityWrite ->
            if model.flag then
                ( { model | session = Nothing, busy = True }, Cmd.perform (persist "out") Saved )

            else
                ( model, Cmd.none )

        Plain ->
            if model.flag then
                ( { model | busy = True }, Cmd.perform (persist "plain") Saved )

            else
                ( { model | note = "off" }, Cmd.none )

        Saved r ->
            case r of

                Ok s ->
                    ( { model | note = s, busy = False }, Cmd.none )

                Err _ ->
                    ( { model | note = "error", busy = False }, Cmd.none )


view : Model -> Html Msg
view model =
    Ui.layout [] (Ui.column [] [ Ui.text model.note ])


subscriptions : Model -> Sub Msg
subscriptions _ =
    Sub.none


main : Task Error ()
main =
    Spa.app
        (Spa.config
            { init = init
            , update = update
            , view = view
            , subscriptions = subscriptions
            })
