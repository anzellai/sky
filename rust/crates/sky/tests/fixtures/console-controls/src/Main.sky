module Main exposing (main)

{-| Sky Console controls fixture, driven by scripts/console-controls-e2e.mjs.

The app gives the console live data of every kind: a press on "Work" logs one
line at each level (debug, info, warn, error) and tracks an identified
analytics event, and every page view is an access-log line and a span. The
e2e adds older, time-spread data through the observability ingest endpoint
and the analytics store, so each range of the console shows a different set.
-}

import Sky.Core.Prelude exposing (..)
import Sky.Core.Task as Task
import Std.Cmd as Cmd exposing (Cmd)
import Std.Sub as Sub exposing (Sub)
import Std.App as App
import Std.Ui as Ui exposing (Element)
import Std.Log as Log
import Std.Analytics as Analytics

type Page
    = Home

type alias Model =
    { worked : Int }

type Msg
    = Work
    | Worked (Result Error ())


init : a -> ( Model, Cmd Msg )
init _ =
    ( { worked = 0 }, Cmd.none )


work : Task Error ()
work =
    Task.sequence
        [ Log.debug "fixture-live debug line"
        , Log.info "fixture-live info line"
        , Log.warn "fixture-live warn line"
        , Log.error "fixture-live error line"
        ]
        |> Task.andThen (\_ -> Analytics.setConsent Analytics.Granted)
        |> Task.andThen (\_ -> Analytics.identify "fixture-live-user" [])
        |> Task.andThen
               (\_ -> Analytics.track (Analytics.event "fixture_live_work" []))


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of

        Work ->
            ( model, Cmd.perform work Worked )

        Worked (Ok _) ->
            ( { model | worked = model.worked + 1 }, Cmd.none )

        Worked (Err _) ->
            ( model, Cmd.none )


view : Model -> Element Msg
view model =
    Ui.column
        [ Ui.padding 20, Ui.spacing 12 ]
        [ Ui.text "console controls fixture"
        , Ui.button [] { onPress = Just Work, label = Ui.text "Work" }
        , Ui.text ("worked " ++ String.fromInt model.worked)
        ]


subscriptions : Model -> Sub Msg
subscriptions _ =
    Sub.none


main =
    App.run
        (App.app
            { init = init
            , update = update
            , view = view
            , subscriptions = subscriptions
            }
            |> App.withRoutes [ App.route "/" Home ]
            |> App.withNotFound Home
            |> App.withConfig
                   (App.WebConfig
                       { App.webDefaults
                           | analytics = Just { pageViews = True }
                       }))
