module Logic exposing (update)

-- `update` in a SIBLING module of a `Std.App` app, laid out with two-space
-- indentation (the arms sit at column 4, their bodies at column 6, left of
-- the column the split writes patterns at). `Pick` reaches the server only
-- through a helper's command, and `Toggle` through a `case`: both run async
-- under `--target web:app`.

import Sky.Core.Prelude exposing (..)
import Sky.Core.System as System
import Sky.Core.Task as Task
import Std.Cmd as Cmd
import Types exposing (Model, Msg(..))


draft : Int -> Task Error String
draft n =
    Task.succeed (System.getenvOr "SPA_ASYNC_APP_DRAFT" "drafted")


pick : Int -> Model -> ( Model, Cmd Msg )
pick n model =
    if n == model.picked then
        ( { model | note = "same" }, Cmd.none )

    else
        ( { model | picked = n, busy = True, note = "" }
        , Cmd.perform (draft n) Drafted
        )


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of

        Pick n ->
            pick n model

        Toggle ->
            case model.saved of

                "" ->
                    ( { model | busy = True }, Cmd.perform (draft 0) Drafted )

                _ ->
                    ( { model | saved = "" }, Cmd.none )

        Drafted (Ok s) ->
            ( { model | busy = False, saved = s }, Cmd.none )

        Drafted (Err _) ->
            ( { model | busy = False, note = "error" }, Cmd.none )
