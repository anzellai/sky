module Cards exposing (..)

import Sky.Core.Prelude exposing (..)
import Sky.Core.Error as Error exposing (Error)
import Sky.Core.File as File
import Sky.Core.Task as Task
import Std.Codec as Codec exposing (Codec)

type alias CardView =
    { title : String }


loadCard : () -> Task Error CardView
loadCard _ =
    File.readFile "card.txt" |> Task.map (\t -> { title = t })


cardViewCodec : Codec CardView
cardViewCodec =
    Codec.object CardView |> Codec.field "title" .title Codec.string
        |> Codec.buildObject
