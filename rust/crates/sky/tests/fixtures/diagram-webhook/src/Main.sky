module Main exposing (main)

-- Fixture for `sky doc --diagram` over a `Std.App` (`App.app`) app that
-- registers a raw `App.api` endpoint (an inbound webhook) BESIDE its page
-- routes. Under `--target web:app` the diagram stages the synthesised Sky.Spa
-- project and charts:
--   * `wire`: the `/_rpc` contract + an `HTTP endpoints` section listing the
--     raw `App.api` webhook (`POST /webhooks/stripe`), CSRF-exempt.
--   * `journey`: the page state machine + the Effectful / Pure action split.
--   * `components`: the Database container listing the real table name.

import Sky.Core.Prelude exposing (..)
import Sky.Core.String as String
import Sky.Core.System as System
import Sky.Core.Task as Task
import Sky.Core.Result as Result
import Std.App as App
import Std.Codec as Codec
import Std.Db.Store as Store exposing (Store)
import Sky.Http.Server as Server
import Std.Sub as Sub
import Std.Ui as Ui exposing (Element)
import Std.Ui.Events as Ev


type Page
    = HomePage
    | AboutPage


type alias Model =
    { page : Page, count : Int, note : String }


type Msg
    = Inc
    | Save
    | GoAbout


type alias Widget =
    { id : Int, label : String }


widgets : Store Widget
widgets =
    Store.fromCodec "widgets" (Codec.auto { id = 0, label = "" })


bootId : String
bootId =
    Result.withDefault "boot" (Task.run (System.getenv "BOOT_ID"))


handleWebhook : Server.Request -> Task Error Server.Response
handleWebhook req =
    Task.succeed (Server.text ("ok:" ++ req.body))


init : a -> ( Model, Cmd Msg )
init _ =
    ( { page = HomePage, count = 0, note = "" }, Cmd.none )


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of
        Inc ->
            ( { model | count = model.count + 1 }, Cmd.none )

        Save ->
            ( { model | note = bootId }, Cmd.none )

        GoAbout ->
            ( { model | page = AboutPage }, Cmd.none )


view : Model -> Element Msg
view model =
    Ui.column [ Ui.spacing 8, Ui.padding 12 ]
        [ Ui.el [ Ev.onClick Inc ] (Ui.text ("count " ++ String.fromInt model.count))
        , Ui.el [ Ev.onClick Save ] (Ui.text "save")
        , Ui.el [ Ev.onClick GoAbout ] (Ui.text "about")
        , Ui.el [] (Ui.text model.note)
        ]


subscriptions : Model -> Sub Msg
subscriptions _ =
    Sub.none


app =
    App.app
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        }
        |> App.withRoutes
            [ App.route "/" HomePage
            , App.route "/about" AboutPage
            , App.api "POST /webhooks/stripe" handleWebhook
            ]
        |> App.withNotFound HomePage


main : Task Error ()
main =
    App.run app
