module Main exposing (main)

{-| Generated typed Codec.auto codecs (v0.29.9). Every shape of the closed
set: Bool, Int, Float, String, an enum, records (nested), Maybe (nested),
List (nested), Dict String and Dict Int. `Mixed` holds a tuple, so it keeps
the reflective path. `Keyed` keeps the reflective path too, and holds a Dict Int
at every depth (a field, in a List, in a Maybe, in a custom type's payload):
a key-generic helper must read each key back as an Int after a round trip,
from the plain form and from the stored form v0.29.8 wrote. gotest/auto_codec_test.go compares the generated codecs
with the reflective walker on this program's own Go types.
-}

import Sky.Core.Prelude exposing (..)
import Sky.Core.Dict as Dict exposing (Dict)
import Std.Codec as Codec
import Std.Log exposing (println)

type Color
    = Red
    | Green
    | Blue

type alias Item =
    { title : String
    , done : Bool
    , count : Int
    , score : Float
    , color : Color
    , note : Maybe String
    , tags : List String
    , priceMinor : Int
    }

type alias Model =
    { items : List Item
    , byId : Dict String Item
    , byNum : Dict Int String
    , userName : String
    , nested : Maybe (Maybe Int)
    , colors : List Color
    , scores : Dict String Float
    , grid : List (List Int)
    , pinned : Maybe Item
    }

type Shape
    = Circle (Dict Int String)
    | Empty

type alias Keyed =
    { pair : ( Int, String )
    , byNum : Dict Int String
    , lists : List (Dict Int Int)
    , maybeNum : Maybe (Dict Int String)
    , shape : Shape
    }

type alias Mixed =
    { pair : ( Int, String )
    , count : Int
    }


blankItem : Item
blankItem =
    { title = ""
    , done = False
    , count = 0
    , score = 0.0
    , color = Red
    , note = Nothing
    , tags = []
    , priceMinor = 0
    }


blankMixed : Mixed
blankMixed =
    { pair = ( 0, "" ), count = 0 }


oneMixed : Mixed
oneMixed =
    { pair = ( 1, "one" ), count = 2 }


blank : Model
blank =
    { items = []
    , byId = Dict.empty
    , byNum = Dict.empty
    , userName = ""
    , nested = Nothing
    , colors = []
    , scores = Dict.empty
    , grid = []
    , pinned = Nothing
    }


blankKeyed : Keyed
blankKeyed =
    { pair = ( 0, "" )
    , byNum = Dict.empty
    , lists = []
    , maybeNum = Nothing
    , shape = Empty
    }


oneKeyed : Keyed
oneKeyed =
    { pair = ( 1, "one" )
    , byNum = Dict.fromList [ ( 2, "two" ), ( 10, "ten" ) ]
    , lists = [ Dict.fromList [ ( 30, 1 ) ], Dict.fromList [ ( 40, 2 ) ] ]
    , maybeNum = Just (Dict.fromList [ ( 7, "seven" ) ])
    , shape = Circle (Dict.fromList [ ( 5, "five" ) ])
    }


{-| Key-generic: the compiler does not know `k` here. -}
keysOf : Dict k v -> List k
keysOf d =
    List.map Tuple.first (Dict.toList d)


sumKeys : Keyed -> Int
sumKeys k =
    let
        shapeKeys =
            case k.shape of

                Circle d ->
                    keysOf d

                Empty ->
                    []
        maybeKeys =
            case k.maybeNum of

                Just d ->
                    keysOf d

                Nothing ->
                    []
    in
        List.foldl
            (\a b -> a + b)
            0
            (keysOf k.byNum ++ List.concatMap keysOf k.lists ++ maybeKeys
                ++ shapeKeys)


{-| The JSON v0.29.8 wrote: each Int key in the runtime's stored form. -}
storedForm : String -> String
storedForm text =
    List.foldl
        (\n t ->
            String.replace
                ("\"" ++ n ++ "\":")
                ("\"" ++ """\u0001i""" ++ n ++ "\":")
                t)
        text
        [ "2", "10", "30", "40", "7", "5" ]


keyedLine : Codec.Codec Keyed -> String -> String
keyedLine codec text =
    case Codec.fromJson codec text of

        Ok k ->
            "keys " ++ String.fromInt (sumKeys k)
                ++ (if k == oneKeyed then
                       " equal"

                   else
                       " DIFFER")

        Err _ ->
            "keys FAILED"


sample : Model
sample =
    { blank
        | items =
            [ { blankItem | title = "a <b>", note = Just "n", tags = [ "x" ] } ]
        , byId =
            Dict.fromList [ ( "k", { blankItem | color = Blue, score = 1.5 } ) ]
        , byNum = Dict.fromList [ ( 2, "two" ), ( 10, "ten" ) ]
        , userName = "Ada"
        , nested = Just (Just 3)
        , colors = [ Green, Red ]
        , scores = Dict.fromList [ ( "z", 2.5 ), ( "a", -0.5 ) ]
        , grid = [ [ 1, 2 ], [] ]
        , pinned = Just blankItem
    }


main =
    let
        snake = Codec.auto blank
        camel = Codec.autoCamel blank
        mixed = Codec.auto blankMixed
        keyed = Codec.auto blankKeyed
        keyedText = Codec.toJson keyed oneKeyed
        text = Codec.toJson snake sample
        back =
            case Codec.fromJson snake text of

                Ok m ->
                    if m == sample then
                        "round trip ok"

                    else
                        "round trip DIFFERS"

                Err _ ->
                    "round trip FAILED"
    in
        println
            (String.join
                "\n"
                [ text
                , Codec.toJson camel sample
                , Codec.toJson mixed oneMixed
                , keyedText
                , keyedLine keyed keyedText
                , storedForm keyedText
                , keyedLine keyed (storedForm keyedText)
                , back
                ])
