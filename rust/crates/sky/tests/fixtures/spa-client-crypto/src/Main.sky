module Main exposing (main)

-- Auto-split INPUT for the client-held crypto opt-in (`Spa.withClientCrypto`).
-- The device creates its own X25519 key and runs the initiator side of a
-- Noise IK (BLAKE2s) handshake in the wasm client; only the handshake message
-- (public bytes, hex) crosses to the server. `Refresh` is an ordinary server
-- branch (a file read) that touches no key.
--
-- The tests (rust/crates/project/tests/spa_client_crypto.rs and
-- rust/crates/sky/tests/spa_split_flow.rs) build it as written, and with the
-- `--VARIANT…--` comment lines replaced to prove each refusal.

import Sky.Core.Prelude exposing (..)
import Sky.Core.Encoding as Encoding
import Sky.Core.Error exposing (Error)
import Sky.Core.File as File
import Sky.Core.Result as Result
import Sky.Core.Task as Task
import Std.Cmd as Cmd
import Std.Crypto.Kx as Kx
import Std.Crypto.Noise as Noise
import Std.Html exposing (Html)
import Std.Spa as Spa
import Std.Sub as Sub
import Std.Ui as Ui

type alias Model =
    { status : String
    , outgoing : String
    , handshake : Maybe Noise.Handshake
    , note : String
    }

type Msg
    = Connect
    | GotHandshake (Result Error Noise.Handshake)
    | Refresh
    | Refreshed (Result Error String)


-- The server's static public key, pinned in the client.
serverPublicHex : String
serverPublicHex =
    "8f40c5adb68f25624ae5b214ea767a6ec94d829d3d7b5e1ad1ba6f3e2138285f"


-- Runs on the DEVICE: a fresh static key and the initiator side.
connect : Task Error Noise.Handshake
connect =
    Kx.generate
        |> Task.andThen
               (\key ->
                   Encoding.hexDecode serverPublicHex
                       |> Result.andThen Kx.publicKeyFromBytes
                       |> Task.fromResult
                       |> Task.andThen
                              (\pub ->
                                  Noise.initiatorWith
                                      Noise.Blake2s
                                      key
                                      pub
                                      "app v1"))


init : () -> ( Model, Cmd Msg )
init _ =
    ( { status = "ready", outgoing = "", handshake = Nothing, note = "" }
    , Cmd.none
    )


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of

        Connect ->
            ( { model | status = "connecting" }
            , Cmd.perform connect GotHandshake
            )

        GotHandshake (Ok hs) ->
            case Noise.writeMessage "hello" hs of

                Ok ( next, message ) ->
                    ( { model | status = "sent"
                      , outgoing = Encoding.hexEncode message
                      , handshake = Just next
                      }
                    , Cmd.none
                    )

                Err _ ->
                    ( { model | status = "failed" }, Cmd.none )

        GotHandshake (Err _) ->
            ( { model | status = "failed" }, Cmd.none )

        Refresh ->
            --VARIANT-REFRESH--
            ( model, Cmd.perform (File.readFile "data/note.txt") Refreshed )

        Refreshed (Ok text) ->
            ( { model | note = text }, Cmd.none )

        Refreshed (Err _) ->
            ( model, Cmd.none )


view : Model -> Html Msg
view model =
    Ui.layout
        []
        (Ui.column
            [ Ui.spacing 8 ]
            [ Ui.text ("status: " ++ model.status)
            , Ui.text ("outgoing: " ++ model.outgoing)
            , Ui.button [] { onPress = Just Connect, label = Ui.text "Connect" }
            , Ui.button [] { onPress = Just Refresh, label = Ui.text "Refresh" }
            ])


subscriptions : Model -> Sub Msg
subscriptions _ =
    Sub.none


main : Task Error ()
main =
    Spa.app
        (Spa.config
            { init = init
            , update = update
            , view = view
            , subscriptions = subscriptions
            }
            |> Spa.withClientCrypto)
