module Main exposing (main)

-- Sky.Spa SSR CLIENT-LEG fixture — the HYDRATION-LOSS regression shape (the
-- sky-lang.org blog bug). Unlike `spa-ssr-db` (whose model is `items : List
-- String`, and a `String` element round-trips through `[]any` unharmed), this
-- model carries `posts : List Post` where `Post` is a NESTED RECORD.
--
-- The client model decoder is `Codec.fromJson (Codec.auto blank)`, where `blank`
-- is `init`'s pure model. If that blank is emitted as an INLINE literal
-- (`Codec.auto ({ page = Home, posts = [] })`), the heavily-constrained
-- split-frontend module type-checks it to a STRUCTURAL row and lowers the empty
-- `posts = []` with its element type ERASED to `[]any`. `Codec.auto` then
-- reflects `kind interface`, `Codec.fromJson` returns `Err`, and the boot path
-- SILENTLY falls back to `init` (stripped to `Cmd.none`, `posts = []`) — so every
-- `Post` the server embedded in `#sky-model` is dropped on hydration, with no
-- error. The fix hoists the blank to a top-level ANNOTATED binding
-- (`spaModelBlank_ : Model`) so codegen pins the nominal `List Post` element type
-- and the decoder's `Codec.auto` matches the encoder's byte-for-byte.

import Sky.Core.Prelude exposing (..)
import Sky.Core.List as List
import Sky.Core.Dict as Dict
import Sky.Core.Maybe as Maybe
import Sky.Core.String as String
import Sky.Core.Task as Task
import Sky.Core.System as System
import Std.Db as Db
import Std.App as App
import Std.Ui as Ui exposing (Element)


-- One memoised connection (CAF) — reaches `Db.open`, so the split routes this
-- binding to the BACKEND ONLY; it is absent from the wasm frontend.
db : Db.Db
db =
    case Task.run (Db.open "sqlite" (System.getenvOr "SSR_DB_PATH" "app.db")) of
        Ok c ->
            c

        Err _ ->
            System.exit 1


type Page
    = Home
    | BlogIndex


-- The nested record whose element type must survive the client decoder blank.
type alias Post =
    { id : Int
    , title : String
    , bodyHtml : String
    }


type alias Model =
    { page : Page
    , posts : List Post
    }


type Msg
    = GotPosts (Result Error (List (Dict String String)))


rowToPost : Dict String String -> Post
rowToPost r =
    { id = Maybe.withDefault 0 (String.toInt (Maybe.withDefault "0" (Dict.get "id" r)))
    , title = Maybe.withDefault "" (Dict.get "title" r)
    , bodyHtml = Maybe.withDefault "" (Dict.get "body_html" r)
    }


init : () -> ( Model, Cmd Msg )
init () =
    ( { page = Home, posts = [] }
    , Cmd.perform (Db.query db "SELECT id, title, body_html FROM posts ORDER BY id" []) GotPosts
    )


-- Purely navigational (a `Go` page switch by route) — NO server branch. SSR is
-- emitted because `init`'s command is a GET-safe read to settle.
update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of
        GotPosts (Ok rows) ->
            ( { model | posts = List.map rowToPost rows }, Cmd.none )

        GotPosts (Err _) ->
            ( { model | posts = [] }, Cmd.none )


view : Model -> Element Msg
view model =
    case model.page of
        Home ->
            Ui.column []
                [ Ui.text "Welcome home"
                , Ui.link [] { url = "/blog", label = Ui.text "Read the blog" }
                ]

        BlogIndex ->
            Ui.column []
                (Ui.text "Posts:"
                    :: List.map (\p -> Ui.text (p.title ++ " — " ++ p.bodyHtml)) model.posts
                )


subscriptions : Model -> Sub Msg
subscriptions _ =
    Sub.none


app =
    App.app
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        }
        |> App.withRoutes [ App.route "/" Home, App.route "/blog" BlogIndex ]
        |> App.withNotFound Home


main =
    App.run app
