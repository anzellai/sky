module Area exposing (..)

import Sky.Core.Prelude exposing (..)
import Sky.Core.Error as Error exposing (Error)
import Sky.Core.File as File
import Sky.Core.Task as Task
import Types exposing (..)

type AreaMsg
    = Refresh
    | Clear


fetchText : () -> Task Error String
fetchText _ =
    File.readFile "area.txt"


update : AreaMsg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of

        Refresh ->
            ( model, Cmd.perform (fetchText ()) Got )

        Clear ->
            ( { model | text = "" }, Cmd.none )
