module Main exposing (main)

import Sky.Core.Http as Http
import Sky.Core.Prelude exposing (..)
import Std.App as App
import Std.Native as Native
import Std.Ui as Ui

type alias Model =
    { out : String }

type Msg
    = Go
    | Fetch (Result Error String)
    | Got String (Result Error Http.HttpResponse)
    | Buzzed (Result Error ())


init : () -> ( Model, Cmd Msg )
init _ =
    ( { out = "" }, Cmd.none )


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of

        Go ->
            ( model, Cmd.perform (Task.succeed "http://127.0.0.1:1/") Fetch )

        Fetch (Ok url) ->
            ( model, Cmd.perform (Http.get url) (Got url) )

        Fetch (Err _) ->
            ( model, Cmd.none )

        Got url (Ok r) ->
            ( { model | out = url ++ " " ++ String.fromInt r.status }
            , Cmd.perform (Native.vibrate 10) Buzzed
            )

        Got url (Err _) ->
            ( { model | out = url ++ " failed" }
            , Cmd.perform (Native.vibrate 10) Buzzed
            )

        Buzzed _ ->
            ( model, Cmd.none )


main =
    App.run
        (App.app
            { init = init
            , update = update
            , view =
                \m ->
                    Ui.column
                        []
                        [ Ui.text ("OUT=" ++ m.out)
                        , Ui.button
                              []
                              { onPress = Just Go, label = Ui.text "go" }
                        ]
            , subscriptions = \_ -> Sub.none
            }
            |> App.withNotFound ())
