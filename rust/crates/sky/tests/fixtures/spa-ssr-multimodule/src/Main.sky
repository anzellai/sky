module Main exposing (main)

-- Sky.Spa auto-split INPUT (the sky-lang.org SPA-SSR shape): the TEA core is
-- factored into SHARED modules — `Msg`/`Model`/`Page` in `State`, `init` in
-- `Data`, the route table in `Routes` — and only `update`/`view` sit in the
-- entry. `sky build --target web:app` must:
--   * inject `Applied<Msg>` into `State`'s Msg union so the wasm frontend
--     compiles (GAP-A);
--   * resolve `init`'s module (`Data`) to settle the SSR model (GAP-B);
--   * SSR the `/items` route from `Routes` (GAP-C).

import Sky.Core.Prelude exposing (..)
import Sky.Core.List as List
import Sky.Core.String as String
import Sky.Core.Task as Task
import Std.App as App
import Std.Cmd as Cmd
import Std.Sub as Sub
import Std.Ui as Ui exposing (Element)
import Std.Html exposing (Html)
import Std.Live.Head as Head
import State exposing (..)
import Data exposing (init)
import Store
import Routes


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of

        Navigate page ->
            ( { model | page = page }, Cmd.none )

        GotItems (Ok raw) ->
            ( { model | items = String.lines (String.trim raw) }, Cmd.none )

        GotItems (Err _) ->
            ( { model | items = [] }, Cmd.none )

        DraftChanged s ->
            ( { model | draft = s }, Cmd.none )

        -- SERVER branch: reaches Store.saveItems (File.writeFile). The split
        -- rewrites this to an RPC on the wasm client and reuses it verbatim
        -- server-side; it also generates the `AppliedSaveItem` variant.
        SaveItem ->
            let
                next = model.draft :: model.items
                _ = Task.run (Store.saveItems next)
            in
                ( { model | items = next, draft = "" }, Cmd.none )


view : Model -> Element Msg
view model =
    case model.page of

        HomePage ->
            Ui.column
                []
                [ Ui.text "Welcome home"
                , Ui.link [] { url = "/items", label = Ui.text "See items" }
                ]

        ItemsPage ->
            Ui.column
                []
                (Ui.text "Item list:" :: List.map (\i -> Ui.text i) model.items)


subscriptions : Model -> Sub Msg
subscriptions _ =
    Sub.none


headFor : Model -> List (Html Msg)
headFor _ =
    [ Head.title "Multi-module SSR" ]


app =
    App.app
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        }
        |> App.withRoutes Routes.routes
        |> App.withNotFound Routes.notFound
        |> App.withHead headFor


main =
    App.run app
