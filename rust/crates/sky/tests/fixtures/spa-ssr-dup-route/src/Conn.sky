module Conn exposing (db)

-- One memoised connection (CAF) — reaches `Db.open`, so the split routes THIS
-- whole module to the BACKEND ONLY. The sibling `init` reads through it, which
-- puts the app on the SSR path (so the per-route SSR GET mounts are emitted —
-- the mounts FINDING A dedupes against the api endpoints).

import Sky.Core.Prelude exposing (..)
import Sky.Core.Task as Task
import Sky.Core.System as System
import Std.Db as Db


db : Db.Db
db =
    case Task.run (Db.open "sqlite" (System.getenvOr "DUP_DB_PATH" "app.db")) of

        Ok c ->
            c

        Err _ ->
            System.exit 1
