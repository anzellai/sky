module Main exposing (main)

-- Sky.Spa auto-split INPUT reproducing FINDING A: a path that is BOTH an
-- `App.route` PAGE route (`/admin/login`, in the sibling `Routes`) AND an
-- `App.api "GET /admin/login"` server endpoint (`apiRoutes`, below). The App→Spa
-- synthesis mounts the page route as `Server.api "GET /admin/login" ssrHandler`
-- (a per-route SSR GET) and the api endpoint via `App.apiServerRoute
-- spaApiRoutes_` — both register `GET /admin/login` on Go's mux, which PANICS at
-- boot on the duplicate pattern. The api endpoint (a deliberate server handler,
-- e.g. an OAuth entry) must WIN; the SSR page mount for the same method+path is
-- suppressed, so the backend boots.

import Sky.Core.Prelude exposing (..)
import Sky.Core.List as List
import Sky.Core.Dict as Dict
import Sky.Core.Maybe as Maybe
import Sky.Core.Task as Task
import Sky.Http.Server as Server exposing (Request, Response, Handler)
import Std.App as App
import Std.Cmd as Cmd
import Std.Sub as Sub
import Std.Ui as Ui exposing (Element)
import State exposing (..)
import Boot exposing (init)
import Routes


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of

        Navigate page ->
            ( { model | page = page }, Cmd.none )

        GotItems (Ok rows) ->
            ( { model | items = List.map (\r -> Maybe.withDefault "" (Dict.get "name" r)) rows }, Cmd.none )

        GotItems (Err _) ->
            ( { model | items = [] }, Cmd.none )


view : Model -> Element Msg
view model =
    case model.page of

        HomePage ->
            Ui.column []
                [ Ui.text "Welcome home"
                , Ui.link [] { url = "/items", label = Ui.text "See items" }
                ]

        ItemsPage ->
            Ui.column []
                (Ui.text "Item list:" :: List.map (\i -> Ui.text i) model.items)

        LoginPage ->
            Ui.text "Login"


subscriptions : Model -> Sub Msg
subscriptions _ =
    Sub.none


-- A GET api endpoint on the SAME path as the `/admin/login` PAGE route (the
-- sky-lang.org OAuth-entry shape). Pure here — the collision is structural, it
-- does not need a server effect to trigger the duplicate mux registration.
handleLogin : Request -> Task Error Response
handleLogin _req =
    Task.succeed (Server.text "login")


handleHealthz : Request -> Task Error Response
handleHealthz _req =
    Task.succeed (Server.text "ok")


apiRoutes : List any
apiRoutes =
    [ App.api "GET /admin/login" handleLogin
    , App.api "GET /healthz" handleHealthz
    ]


app =
    App.app
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        }
        |> App.withRoutes (Routes.routes ++ apiRoutes)
        |> App.withNotFound Routes.notFound


main =
    App.run app
